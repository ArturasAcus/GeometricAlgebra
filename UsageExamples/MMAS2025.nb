      RowBox[{"a", "[", "7", "]"}], "\[Rule]", 
      RowBox[{"-", "1"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exampleMV", "[", "testAlgebra", "]"}], "=", 
