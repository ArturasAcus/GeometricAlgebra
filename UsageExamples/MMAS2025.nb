Cell[BoxData[
 RowBox[{
  RowBox[{"testIfDiagonal", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"solval", "=", 
      RowBox[{"SolveValues", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gaMinimalPolynomial", "[", 
          RowBox[{"expr", ",", "x"}], "]"}], "==", "0"}], ",", "x"}], "]"}]}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"Union", "[", "solval", "]"}], "]"}], "=!=", 
     RowBox[{"Length", "[", "solval", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.942122715816928*^9, 3.942122740178013*^9}, {
