Cell["\<\
Currently function to generate nondiagonalizable MV don\[CloseCurlyQuote]t \
work with quaternion coefficients. Attempt to generate random MV and compute \
minimal polynomial and test if it has repeated root\
\>", "Text",
 CellChangeTimes->{{3.94212191456348*^9, 
  3.942121990789588*^9}},ExpressionUUID->"15f7f9ac-1aab-419a-8ea3-\
99381ddc2114"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateNew", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rndMV", ",", "solval", ",", "x"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"rndMV", "=", 
     RowBox[{"gaRandomMultivector", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"\"\<CoefficientFunction\>\"", "\[Rule]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}], "&"}], ")"}]}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.942122374153113*^9, 3.942122381628283*^9}, {
   3.9421224310631866`*^9, 3.942122485704077*^9}, 3.9421245008229437`*^9, {
