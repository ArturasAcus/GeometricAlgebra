Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sl(n)\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"x_", "?", "MatrixQ"}], ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Tr", "[", "x", "]"}], "===", "0"}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sl(n,R)\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"x_", "?", "MatrixQ"}], ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sl(n)\>\"", "]"}], "[", 
     RowBox[{"x", ",", "opts"}], "]"}], ")"}], "&&", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"x", ",", "_Complex"}], "]"}], "&&", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"x", ",", "\"\<Quaternion\>\""}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sl(n,C)\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"x_", "?", "MatrixQ"}], ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sl(n)\>\"", "]"}], "[", 
     RowBox[{"x", ",", "opts"}], "]"}], ")"}], "&&", 
   RowBox[{"FreeQ", "[", 
    RowBox[{"x", ",", "\"\<Quaternion\>\""}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.702186196093251*^9, 3.702186238951591*^9}, {
