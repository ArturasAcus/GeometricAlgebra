         RowBox[{"theProduct", "=", "Dot"}], ",", " ", 
         RowBox[{"theProduct", "=", "gaGeometricMatrixProduct"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"commutator", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{"sk", "*", "sj"}], ")"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"theProduct", "[", 
            RowBox[{
             RowBox[{"k", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"j", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "-", 
           RowBox[{"theProduct", "[", 
            RowBox[{
             RowBox[{"j", "[", 
