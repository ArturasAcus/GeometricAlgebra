Cell[BoxData[{
 RowBox[{
  RowBox[{"bivectorBase", "[", "evenAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"gaGetMV", "[", 
     RowBox[{
      RowBox[{"gaOrthonormalBasis", "[", "evenAlgebra", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
