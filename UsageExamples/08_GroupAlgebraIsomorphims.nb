      RowBox[{"r1", ",", "r2", ",", "r3"}], "}"}]}], " ", "-", 
    RowBox[{"rotation3DReal", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1", ",", "r2", ",", "r3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Omega]", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], 
     "]"}]}], ")"}], "//", "Simplify"}]], "Input",
