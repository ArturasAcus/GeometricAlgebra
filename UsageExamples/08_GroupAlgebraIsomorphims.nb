Cell["\<\
Now find isomorphisms between geometric algebras (with respect to geometric \
product, not commutator product)\
\>", "Text",
 CellChangeTimes->{{3.700801669261407*^9, 3.700801734699354*^9}, {
  3.701743356307444*^9, 3.701743357925431*^9}, {3.70175313918302*^9, 
