Cell["Make SU(2) matrix of fundamental representation", "Text",
 CellChangeTimes->{{3.695093750536844*^9, 
  3.695093794077685*^9}},ExpressionUUID->"a539ce4b-0680-422f-9401-\
86b71e62c221"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"WD", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", "/", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", "2"}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"al_", ",", "be_", ",", "ga_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{"al", "/", "2"}]}], "]"}], "*", 
    RowBox[{"Cos", "[", 
     RowBox[{"be", "/", "2"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{"ga", "/", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"WD", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", "/", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{
         RowBox[{"-", "1"}], "/", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"al_", ",", "be_", ",", "ga_"}], "}"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], "*", 
        RowBox[{"al", "/", "2"}]}], "]"}]}], "*", 
     RowBox[{"Sin", "[", 
      RowBox[{"be", "/", "2"}], "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", 
       RowBox[{"ga", "/", "2"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"WD", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", "/", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "1"}], "/", "2"}], ",", 
       RowBox[{"1", "/", "2"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"al_", ",", "be_", ",", "ga_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", 
      RowBox[{"al", "/", "2"}]}], "]"}], "*", 
    RowBox[{"Sin", "[", 
     RowBox[{"be", "/", "2"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", 
      RowBox[{"ga", "/", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"WD", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", "/", "2"}], "}"}], ",", 
