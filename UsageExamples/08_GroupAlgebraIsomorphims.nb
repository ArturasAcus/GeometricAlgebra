Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], 
             ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
              "\"\<Pauli[1,2]\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], 
       ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.77977435074818*^9, 3.779774381864224*^9}, 
   3.931596831656242*^9, {3.9410062254357967`*^9, 3.941006233029467*^9}},
 CellLabel->
  "In[453]:=",ExpressionUUID->"5c9a3db2-a362-4aa7-bbf4-6d9a7dc89259"],

