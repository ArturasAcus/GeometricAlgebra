Cell[BoxData[
 TemplateBox[{
  "gaDefineMatrixRepresentation", "smaller", 
   "\"Tensor product decomposition \
\\!\\(\\*TemplateBox[List[TemplateBox[List[\\\"1\\\", \\\"0\\\", \\\"0\\\"], \
\\\"Cl\\\", Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[0.`, 0.`, 1.`]]]], RowBox[List[Slot[1], \\\",\\\
\", Slot[2]]]]]], Rule[Tooltip, None]], TemplateBox[List[\\\"0\\\", \
\\\"2\\\", \\\"0\\\"], \\\"Cl\\\", Rule[DisplayFunction, \
Function[SubscriptBox[StyleBox[\\\"Cl\\\", List[Rule[FontColor, RGBColor[0.`, \
0.5019607843137255`, 0.`]]]], RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], \
Rule[Tooltip, None]]], \\\"gaTensorProduct\\\", RuleDelayed[DisplayFunction, \
Function[RowBox[List[Slot[1], StyleBox[\\\"\\\\[CircleTimes]\\\", \
Rule[FontSize, Medium], List[Rule[FontColor, RGBColor[0.7788342394833914`, \
0.45237196684702763`, 0.03776081351204996`]]]], Slot[2]]]]], \
RuleDelayed[InterpretationFunction, \
Function[RowBox[List[\\\"gaTensorProduct\\\", \\\"[\\\", Slot[1], \\\",\\\", \
Slot[2], \\\"]\\\"]]]], Rule[SyntaxForm, \\\"fish\\\"], Rule[Tooltip, \
None]]\\) contains Cl[1,0] algebra. Smaller (complex) representation matrices \
can be obtained using Method ->{\\\"TensorProduct\\\",\\\"BaseVectorAlgebra\\\
\"\[Rule]\\!\\(\\*TemplateBox[List[\\\"3\\\", \\\"0\\\", \\\"0\\\"], \\\"Cl\\\
\", Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[0.827450980392157`, 0.827450980392157`, \
0.827450980392157`]]]], RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], \
Rule[Tooltip, None]]\\),\\\"TargetMatrices\\\"\[Rule]Reals}. The smaller \
matrices realizes HOMOMORPHISM of the algebra (not an isomorphism).\"", 2, 
   476, 7, 17255916605895310586, "Local", 
   "GeometricAlgebra`gaDefineMatrixRepresentation"},
  "MessageTemplate2"]], "Message", "MSG",
