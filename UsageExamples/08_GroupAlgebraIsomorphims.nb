 CellLabel->"In[19]:=",ExpressionUUID->"63b47acd-b4d7-4c2f-89d2-c50ee611326b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaBlockDiagonalParts", "::", "block"}], "=", 
    "\"\<Matrix `1` is not block diagonal.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaBlockDiagonalParts", "[", 
   RowBox[{
    RowBox[{"x_", "?", "MatrixQ"}], ",", 
    RowBox[{"{", 
     RowBox[{"d1_Integer", ",", "d2_Integer"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"Dimensions", "[", "x", "]"}]}], ",", "block11", ",", 
      "block12", ",", "block21", ",", "block22"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"block11", ",", "block12", ",", "block21", ",", "block22"}], 
       "}"}], "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"d1", ";;", "d2"}], ",", 
           RowBox[{"d1", ";;", "d2"}]}], "]"}], "]"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"d1", ";;", "d2"}], ",", 
           RowBox[{
            RowBox[{"1", "+", "d2"}], ";;", 
            RowBox[{"dim", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "+", "d2"}], ";;", 
            RowBox[{"dim", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"d1", ";;", "d2"}]}], "]"}], "]"}], ",", 
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "+", "d2"}], ";;", 
            RowBox[{"dim", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"1", "+", "d2"}], ";;", 
            RowBox[{"dim", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}]}], "}"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"And", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{"Flatten", "[", "block12", "]"}], "]"}], "===", 
          RowBox[{"{", "0", "}"}]}], ",", 
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{"Flatten", "[", "block21", "]"}], "]"}], "===", 
          RowBox[{"{", "0", "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"block11", ",", "block22"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{"gaBlockDiagonalParts", "::", "block"}], ",", 
         RowBox[{"MatrixForm", "[", "x", "]"}]}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.702348770146801*^9, 3.702348906093028*^9}, {
  3.702348946392437*^9, 3.70234902605802*^9}, {3.702349073873665*^9, 
