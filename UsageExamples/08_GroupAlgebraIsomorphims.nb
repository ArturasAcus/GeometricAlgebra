Cell["\<\
There are complications when testing if set of matrices are in sp(n), due to \
rearrangement into block diagonal form with specific block structure: Somehow \
we need to avoid this rearrangement if possible. This also means that we have \
to test entire set simultaneously. Current implementation of element \
rearrangement is bad, do not use it.\
\>", "Text",ExpressionUUID->"29adc5a4-fba5-4212-8e4c-507ad5670935"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gaGeneratorMatrixQ", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"gaGeneratorPattern", "\[Rule]", "\"\<Automatic\>\""}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneratorPattern", "::", "badOptionValue"}], "=", 
   "\"\<Do not use this option. It give wrong answer!!!.\nOption \
gaGeneratorPattern value `1` is not a list of of the form \
{...,\[PlusMinus]1,...} with equal number of 1 and -1, the number each being \
equal to half of tested matrix dimension. Resetting to \\\"Automatic\\\", \
which is equivalet to {1,1,...,-1,-1,...}.\>\""}], ";"}]}], "Input",
 CellChangeTimes->{{3.70158555996334*^9, 3.70158557095032*^9}, {
   3.701586394983157*^9, 3.701586569196934*^9}, {3.70158660350186*^9, 
   3.701586660794155*^9}, 3.701586768952686*^9, {3.702187637708614*^9, 
   3.702187680898831*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"5ccd3d8f-51ab-4952-a464-249b36c58224"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaGeneratorMatrixQ", "[", 
      RowBox[{"\"\<sp\>\"", ",", 
       RowBox[{"transformation", ":", 
        RowBox[{"(", 
         RowBox[{"_Symbol", "|", "_Function"}], ")"}]}]}], "]"}], "[", 
     RowBox[{
      RowBox[{"x_", "?", "MatrixQ"}], ",", 
      RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dim", "=", 
         RowBox[{"Dimensions", "[", "x", "]"}]}], ",", "block11", ",", 
        "block12", ",", "block21", ",", "block22", ",", "standardSkew", ",", 
        RowBox[{"skewnessPattern", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gaGeneratorPattern", "/.", 
            RowBox[{"{", "opts", "}"}]}], "/.", 
           RowBox[{"Options", "[", 
            RowBox[{"gaGeneratorMatrixQ", ",", "gaGeneratorPattern"}], 
            "]"}]}], ")"}]}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "[", 
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{"EvenQ", "/@", "dim"}], ")"}]}], "]"}], ",", 
        "\[IndentingNewLine]", "False", ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "block11", ",", "block12", ",", "block21", ",", "block22"}], "}"}],
           "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", 
                RowBox[{
                 RowBox[{"dim", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], ",", 
               RowBox[{"1", ";;", 
                RowBox[{
                 RowBox[{"dim", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "/", "2"}]}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"1", ";;", 
                RowBox[{
                 RowBox[{"dim", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], ",", 
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"dim", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "/", "2"}]}], ";;", 
                RowBox[{"dim", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"dim", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], ";;", 
                RowBox[{"dim", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"1", ";;", 
                RowBox[{
                 RowBox[{"dim", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "/", "2"}]}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"dim", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], ";;", 
                RowBox[{"dim", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{
                  RowBox[{"dim", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "/", "2"}]}], ";;", 
                RowBox[{"dim", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}], "]"}]}], "}"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"skewnessPattern", "===", "\"\<Automatic\>\""}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"standardSkew", "=", 
            RowBox[{"ArrayFlatten", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ConstantArray", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"dim", "/", "2"}]}], "]"}], ",", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{
                   RowBox[{"dim", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "/", "2"}], "]"}]}], 
                "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"IdentityMatrix", "[", 
                   RowBox[{
                    RowBox[{"dim", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "/", "2"}], "]"}]}], ",", 
                 
                 RowBox[{"ConstantArray", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"dim", "/", "2"}]}], "]"}]}], "}"}]}], "}"}], 
             "]"}]}], ",", 
           RowBox[{
            RowBox[{"Print", "[", "\"\<Not yet implemented\>\"", "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"standardSkew", ".", "x"}], "+", 
             RowBox[{
              RowBox[{"transformation", "[", "x", "]"}], ".", 
              "standardSkew"}]}], "]"}], "]"}], "===", 
          RowBox[{"{", "0", "}"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sp(n,R)\>\"", "]"}], "[", 
     RowBox[{
      RowBox[{"x_", "?", "MatrixQ"}], ",", 
      RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{"x", ",", "_Complex"}], "]"}], "&&", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"x", ",", "\"\<Quaternion\>\""}], "]"}], "&&", 
      RowBox[{
       RowBox[{"gaGeneratorMatrixQ", "[", 
        RowBox[{"\"\<sp\>\"", ",", "Transpose"}], "]"}], "[", 
       RowBox[{"x", ",", "opts"}], "]"}]}], ")"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"to", " ", "check"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"may", " ", "be", " ", "Transpose"}], " ", "\[Rule]", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"gaExplictitConjugate", "[", "#", "]"}], "]"}]}], "&"}]}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sp(n,C)\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"x_", "?", "MatrixQ"}], ",", 
     RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FreeQ", "[", 
      RowBox[{"x", ",", "\"\<Quaternion\>\""}], "]"}], "&&", 
     RowBox[{
      RowBox[{"gaGeneratorMatrixQ", "[", 
       RowBox[{"\"\<sp\>\"", ",", "Transpose"}], "]"}], "[", 
      RowBox[{"x", ",", "opts"}], "]"}]}], ")"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.701487428472684*^9, 3.701487492590794*^9}, {
