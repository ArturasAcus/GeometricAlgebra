       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"nonEmptyPositions", ",", "1"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"projectedBaseMatrices", "=", 
           RowBox[{"Pick", "[", 
            RowBox[{
             RowBox[{"{", "allBaseMatrices", "}"}], ",", "nonEmptyPositions", 
             ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"projectedMatricesNorms", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "/", "dim"}], ")"}], "*", 
               RowBox[{"Tr", "[", 
                RowBox[{"theProduct", "[", 
                 RowBox[{"#", ",", "#"}], "]"}], "]"}]}], "&"}], "/@", 
             "projectedBaseMatrices"}], ")"}]}], ";", 
          RowBox[{"Plus", "@@", 
           RowBox[{"(", 
            RowBox[{"projectedMatricesNorms", "*", 
             RowBox[{"Pick", "[", 
              RowBox[{"projRe", ",", "nonEmptyPositions", ",", "1"}], "]"}], 
             "*", 
             RowBox[{"Thread", "[", 
              RowBox[{"nameAndMatrix", "[", 
               RowBox[{
