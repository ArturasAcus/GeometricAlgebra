Cell[TextData[{
 "Now calculate generators and match them with the above bivectors. We  \
rotated about z axis by angle \[Alpha], therefore we should expect to get the \
bivector ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["\[Sigma]", "12"], "=", 
   SubscriptBox["J", "z"]}]],ExpressionUUID->
  "54a01d68-7a82-43f1-9a4b-a481f7406eb8"],
