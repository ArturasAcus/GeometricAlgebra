Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Complex\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "->", "\"\<Symmetric\>\""}], 
             ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
              "\"\<Pauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.779773071432559*^9, 3.779773076217208*^9}, 
