  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simpleCommutator", "[", 
     RowBox[{
      RowBox[{"sk_.", "*", "k_nameAndMatrix"}], ",", 
      RowBox[{"sj_.", "*", "j_nameAndMatrix"}], ",", "___"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "theProduct", "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"k", ",", "j"}], "}"}], ",", "\"\<Quaternion\>\""}], 
          "]"}], ",", " ", 
         RowBox[{"theProduct", "=", "Dot"}], ",", " ", 
         RowBox[{"theProduct", "=", "gaGeometricMatrixProduct"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"sk", "*", "sj"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"theProduct", "[", 
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"j", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "-", 
          RowBox[{"theProduct", "[", 
           RowBox[{
            RowBox[{"j", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"k", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ")"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"baseSymbol", "=", 
     RowBox[{
     "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"commutator", "[", 
