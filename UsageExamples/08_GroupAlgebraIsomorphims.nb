  FormBox[
   RowBox[{
    SubscriptBox["\[Sigma]", "12"], "=", 
    SubscriptBox["J", "z"]}], TraditionalForm]],ExpressionUUID->
  "cda36a93-e225-4139-9d28-83d1fcf8cd65"],
