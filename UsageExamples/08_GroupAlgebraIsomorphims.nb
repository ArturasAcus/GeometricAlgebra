Cell["Calculate bivector bases and signatures", "Text",
 CellChangeTimes->{{3.700801669261407*^9, 3.700801734699354*^9}, {
  3.701743356307444*^9, 3.701743357925431*^9}, {3.70175313918302*^9, 
  3.701753143734276*^9}, {3.70175442850438*^9, 3.701754500726277*^9}, {
  3.702097604631666*^9, 
  3.702097634319112*^9}},ExpressionUUID->"8597713d-806e-42bc-a10e-\
ddcc658f3664"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bivectorBase", "[", "evenAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"gaGetMV", "[", 
     RowBox[{
      RowBox[{"gaOrthonormalBasis", "[", "evenAlgebra", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
