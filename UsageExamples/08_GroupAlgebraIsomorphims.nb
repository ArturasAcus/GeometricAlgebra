Cell["\<\
Generators of su(n) are skew Hermitian matrices, i.\[DoubleStruckE]. they \
satisfy Conjugate[Transpose[X]]=-X \
\>", "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
  3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
  3.673770874134313*^9}, {3.673847424440953*^9, 3.673847454297884*^9}, {
  3.67384748908961*^9, 3.673847491281632*^9}, {3.67385142912274*^9, 
  3.673851598056488*^9}, {3.673853419907907*^9, 3.673853572892449*^9}, {
  3.673853707922314*^9, 3.673853752046113*^9}, {3.674805666743201*^9, 
  3.674805687128266*^9}, {3.675050029277056*^9, 3.675050184674764*^9}, {
  3.701078628670984*^9, 3.701078662815364*^9}, {3.701485885026347*^9, 
  3.701486024042437*^9}},ExpressionUUID->"66629fc3-6cee-4f17-bf89-\
558faf3c14e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gaSkewHermitianQ", "[", 
   RowBox[{"x_", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Union", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Transpose", "[", "x", "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Complex", "[", 
            RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
           RowBox[{"Complex", "[", 
            RowBox[{"a", ",", 
             RowBox[{"-", "b"}]}], "]"}]}], "}"}]}], ")"}], "+", "x"}], "]"}],
      "]"}], "===", 
    RowBox[{"{", "0", "}"}]}], "/;", 
   RowBox[{"And", "@@", 
    RowBox[{"(", 
     RowBox[{"ExactNumberQ", "/@", 
      RowBox[{"Flatten", "[", "x", "]"}]}], ")"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneratorMatrixQ", "[", "\"\<su(n)\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"x_", "?", "MatrixQ"}], ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"AntihermitianMatrixQ", "[", 
    RowBox[{"x", ",", "opts"}], "]"}], "&&", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Tr", "[", "x", "]"}], "===", "0"}], ")"}]}]}]}], "Input",
 CellChangeTimes->{{3.701484957397874*^9, 3.701484980449448*^9}, {
   3.70148501406197*^9, 3.70148514433473*^9}, {3.701485292913259*^9, 
