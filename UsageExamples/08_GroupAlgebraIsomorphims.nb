Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"allIsomorphisms", "[", 
   RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "=", 
  RowBox[{"FindGraphIsomorphism", "[", 
   RowBox[{
    RowBox[{"firstAlgebraGraph", "[", "firstAlgebra", "]"}], ",", 
    RowBox[{"secondAlgebraGraph", "[", "secondAlgebra", "]"}], ",", "All"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"isomorphismRules", "[", 
      RowBox[{
       RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], ",", "n"}], 
      "]"}], "=", 
     RowBox[{
      RowBox[{"allIsomorphisms", "[", 
       RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "[", 
      RowBox[{"[", "n", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"allIsomorphisms", "[", 
        RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "]"}]}], 
     "}"}]}], "]"}], ";", 
  RowBox[{"isomorphismRules", "[", 
   RowBox[{
    RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], ",", "1"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.696154270284544*^9, 3.696154270943889*^9}, {
