Cell[BoxData[
 RowBox[{
  RowBox[{"swapRij", "[", 
   RowBox[{"mat_", ",", 
    RowBox[{"{", 
     RowBox[{"i_", ",", "j_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"mat1", "=", "mat"}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"mat1", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}], "=", 
      RowBox[{"mat", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"j", ",", "i"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "mat1"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.702273192137979*^9, 3.702273192139215*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"8dcb2a93-e854-446e-8c09-6102eb5eb9f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"swapCij", "[", 
   RowBox[{"mat_", ",", 
    RowBox[{"{", 
     RowBox[{"i_", ",", "j_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"matT", "=", 
      RowBox[{"Transpose", "@", "mat"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"matT", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}], "=", 
      RowBox[{"matT", "[", 
       RowBox[{"[", 
        RowBox[{"{", 
         RowBox[{"j", ",", "i"}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Transpose", "@", "matT"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.702273208827397*^9, 3.702273208828448*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"35e15fe1-085c-4ac2-879f-87d61a68fa2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"swapRowAndColumn", "[", 
   RowBox[{
    RowBox[{"mat_", "?", "MatrixQ"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"r1_Integer", ",", "r2_Integer"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"c1_Integer", ",", "c2_Integer"}], "}"}]}], "}"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"swapCij", "[", 
    RowBox[{
     RowBox[{"swapRij", "[", 
      RowBox[{"mat", ",", 
       RowBox[{"{", 
        RowBox[{"r1", ",", "r2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"c1", ",", "c2"}], "}"}]}], "]"}], "/;", 
   RowBox[{"And", "@@", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Thread", "[", 
        RowBox[{"LessEqual", "[", "##", "]"}], "]"}], "&"}], "@@@", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"r1", ",", "r2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"c1", ",", "c2"}], "}"}]}], "}"}], ",", 
         RowBox[{"Dimensions", "[", "mat", "]"}]}], "}"}], "]"}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.702361127162027*^9, 3.702361157754504*^9}, {
