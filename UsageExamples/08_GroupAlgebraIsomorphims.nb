       "\[IndentingNewLine]", 
       RowBox[{"projRe", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Re", "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "dim"}], "*", 
                 RowBox[{"Tr", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"theProduct", "[", 
                  RowBox[{"commutator", ",", "#"}], "]"}], "&"}], "/@", 
                RowBox[{"{", "allBaseMatrices", "}"}]}], ")"}]}], ")"}]}], 
           ")"}], "/.", 
