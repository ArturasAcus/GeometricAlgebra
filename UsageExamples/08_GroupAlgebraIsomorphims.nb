   3.701485552386553*^9, 3.701485553585069*^9}, {3.701485631351809*^9, 
   3.701485633503052*^9}, {3.701485673364781*^9, 3.701485678529787*^9}, 
   3.701486170823715*^9, 3.701486647555491*^9, {3.701486970702998*^9, 
