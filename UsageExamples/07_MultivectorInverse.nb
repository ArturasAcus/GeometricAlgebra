Cell["\<\
Let\[CloseCurlyQuote]s calculate matrix representation of general \
multivector. To convert multivector to matrix, first calculate matrix \
representations of all base elements. For low dimensional or elementary \
algebras we take the following matrices: 
Cl[0,1]->\[CloseCurlyDoubleQuote]Antisymmetric\[CloseCurlyDoubleQuote],Cl[1,0]\
\[Rule]\[CloseCurlyDoubleQuote]Diagonal\[CloseCurlyDoubleQuote],Cl[1,1]\[Rule]\
\[CloseCurlyDoubleQuote]Antisymmetric\[CloseCurlyDoubleQuote],Cl[2,0]->\
\[CloseCurlyDoubleQuote]Symmetric\[CloseCurlyDoubleQuote],Cl[0,2]\[Rule]\
\[CloseCurlyDoubleQuote]Pauli[1,2]\[CloseCurlyDoubleQuote] 
(for explanations see the notebook on matrix representations). To make the \
calculations faster all matrices are converted to sparse matrix form.\
\>", "Text",ExpressionUUID->"1f043f47-1720-4d8b-9dc1-21d95980d304"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"SparseArray", ",", 
   RowBox[{"gaDefineMatrixRepresentation", "[", 
    RowBox[{"testAlgebra", ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<TensorProduct\>\"", ",", 
        RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Antisymmetric\>\""}], 
           ",", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"1", ",", "0"}], "]"}], "\[Rule]", "\"\<Diagonal\>\""}], 
           ",", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
            "\"\<Antisymmetric\>\""}], ",", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"2", ",", "0"}], "]"}], "->", "\"\<Symmetric\>\""}], ",", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
            "\"\<Pauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"8068b06a-80d1-4cb4-8b60-0ad090ddd349"],

