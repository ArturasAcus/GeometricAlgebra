Cell[BoxData[
 RowBox[{
  RowBox[{"versorGoodNoMatrixInverse", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"gaReverse", "[", 
     RowBox[{"versorGood", "[", "testAlgebra", "]"}], "]"}], "/", 
