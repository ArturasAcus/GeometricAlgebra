 RowBox[{
  RowBox[{"gaI", "=", 
   RowBox[{"First", "[", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"gaGetMV", "[", 
       RowBox[{
        RowBox[{"gaOrthonormalBasis", "[", "testAlgebra", "]"}], ",", 
