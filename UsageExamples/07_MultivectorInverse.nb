Cell[CellGroupData[{

Cell["Versor case (easy to test)", "Subitem",
 CellChangeTimes->{{3.685166374808083*^9, 3.685166427915975*^9}, {
   3.685166485052012*^9, 3.685166542294676*^9}, {3.686889334231881*^9, 
