Cell[BoxData[
 RowBox[{
  RowBox[{"differentResults", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a2", "=", 
           RowBox[{"A2", "[", "r", "]"}]}], ",", "gradeA2"}], "}"}], ",", 
        RowBox[{
         RowBox[{"gradeA2", "=", 
          RowBox[{"First", "[", 
           RowBox[{"gaGradeList", "[", "a2", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"gaPE", "[", 
             RowBox[{
              RowBox[{"a1", "\[OuterProduct]", 
               RowBox[{"(", 
                RowBox[{"a2", "\[GeometricProduct]", "B1"}], ")"}]}], "-", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"a1", "\[InnerProduct]", "a2"}], 
                 "\[GeometricProduct]", "B1"}], "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", "gradeA2"}], " ", "a2"}], 
                 "\[GeometricProduct]", 
                 RowBox[{"(", 
                  RowBox[{"a1", "\[OuterProduct]", "B1"}], ")"}]}]}], ")"}]}],
              "]"}], "]"}], ",", 
           RowBox[{"{", "gradeA2", "}"}], ",", 
           RowBox[{"{", "a2", "}"}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"Plus", "@@", "testAlgebra"}], ")"}]}]}], "}"}]}], "]"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "___"}], "}"}]}], "]"}]}]], "Input",
