Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"nonVersorInverse", "[", "testAlgebra", "]"}], 
      "\[GeometricProduct]", 
      RowBox[{"gaPE", "[", 
       RowBox[{"nonVersor", "[", "testAlgebra", "]"}], "]"}]}], ")"}], "//", 
    "gaPE"}], ",", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"gaPE", "[", 
       RowBox[{"nonVersor", "[", "testAlgebra", "]"}], "]"}], 
      "\[GeometricProduct]", 
      RowBox[{"nonVersorInverse", "[", "testAlgebra", "]"}]}], ")"}], "//", 
    "gaPE"}]}], "}"}]], "Input",
 CellLabel->
  "In[145]:=",ExpressionUUID->"25e2dba5-367d-4576-a3bb-9f58e9d2c159"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1"}], "}"}]], "Output",
 CellLabel->
  "Out[145]=",ExpressionUUID->"3478da6b-62ec-4575-be9c-72247f659f33"]
}, Open  ]],

Cell[TextData[{
 "Therefore, the obtained multivector is indeed the inverse.  The procedure \
presented above was automated by the command ",
 StyleBox["gaInverse[ ]",
  FontWeight->"Bold"],
 ", Below it is demonstrated how to use it. A method  how to compute \
determinant norm of MV for algebras of n\[GreaterEqual]7 are given by \
\[OpenCurlyDoubleQuote]On determinant, other characteristic polynomial \
coefficients, and inverses in Clifford algebras of arbitrary dimension (May \
2020), Dmitry Shirokov and (with wrong sign) in Helmstetter,Characteristic \
polynomials in Clifford algebras and in more general algebras, Adv. Appl. \
Clifford Algebras29, 30 (2019)."
}], "Text",ExpressionUUID->"ff5b74b8-850a-4553-816c-fab33faa42ce"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
4.12 Expression of main Clifford involutions in terms of grade negation \
\>", "Subsection",ExpressionUUID->"bc82fc8e-9fc5-459e-b900-8356f233c40e"],

Cell[CellGroupData[{

Cell["Reverse rewrite using general involution ", "Subsubsection",ExpressionUUID->"1d9d40e9-e40f-4b22-ab64-282108581177"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"6", ",", "9"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[146]:=",ExpressionUUID->"43b60ac6-d8f3-4dde-ad46-c069f2076e02"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"gaReverse", "[", "A1", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[148]:=",ExpressionUUID->"52f57441-df17-42bf-80fa-33474ea0260d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rhs1", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"gaGradeNegate", "[", 
    RowBox[{"A1", ",", 
     RowBox[{"{", 
      RowBox[{
      "2", ",", "3", ",", "6", ",", "7", ",", "10", ",", "11", ",", "14", ",",
        "15"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"47d48611-bf59-4bdc-93ee-7f30697fb9df"],

