Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<PseudosphereSurfaceIn3D\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "*", "r", "*", 
          RowBox[{
           RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "/", 
           RowBox[{"Cosh", "[", "\[Theta]", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "*", "r", "*", 
          RowBox[{
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "/", 
           RowBox[{"Cosh", "[", "\[Theta]", "]"}]}]}], "+", 
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "3", "]"}], "*", "r", "*", 
          RowBox[{"(", 
           RowBox[{"\[Theta]", "-", 
            RowBox[{"Tanh", "[", "\[Theta]", "]"}]}], ")"}]}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]", "<", 
           RowBox[{"2", "Pi"}]}], ")"}], "&&", 
         RowBox[{"NonNegative", "[", "\[Theta]", "]"}]}]}], "}"}], "}"}], ",",
      "False"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", "\[CurlyPhi]"}], "}"}], ",", 
   RowBox[{"{", "r", "}"}], ",", 
   RowBox[{"\"\<ParameterRangeAssumptions\>\"", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"r", ">", "0"}], "}"}]}], ",", 
   RowBox[{"Simplify", "->", "FullSimplify"}], ",", 
   RowBox[{"Quiet", "->", "True"}]}], "]"}]], "Input",
 CellChangeTimes->{3.895625224228252*^9},
 CellLabel->"In[44]:=",ExpressionUUID->"713dfda7-e048-4339-8e9d-a535a9ec750b"],

