Cell[BoxData[
 RowBox[{
  RowBox[{"makeDefinePositionVectorInput", "[", 
   RowBox[{"Entity", "[", 
    RowBox[{"\"\<Surface\>\"", ",", "name_String"}], "]"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"parametricRepFunc", "=", 
       RowBox[{
        RowBox[{"Entity", "[", 
         RowBox[{"\"\<Surface\>\"", ",", "name"}], "]"}], "[", 
        RowBox[{"EntityProperty", "[", 
         RowBox[{"\"\<Surface\>\"", ",", "\"\<ParametricEquations\>\""}], 
         "]"}], "]"}]}], ",", "parametersExtracted", ",", "paramNames", ",", 
      "varsExtracted", ",", "varNames", ",", "paramRanges", ",", 
      "coordinateRanges"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "extract", " ", "parameters", " ", "and", " ", "vars", " ", "from", " ", 
      "parametric", " ", "representation"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Count", "[", 
         RowBox[{"parametricRepFunc", ",", "Function", ",", "Infinity", ",", 
          RowBox[{"Heads", "->", "True"}]}], "]"}], "===", "2"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"parametersExtracted", "=", 
         RowBox[{"parametricRepFunc", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"varsExtracted", "=", 
         RowBox[{
          RowBox[{"parametricRepFunc", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Print", "[", 
         "\"\<ParametricEquation data for the surface is unavailable or not \
typical. Aborting\>\"", "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"If", " ", "succeded"}], ",", " ", 
       RowBox[{"rename", " ", "vars", " ", "and", " ", "parameters"}], ",", 
       " ", 
       RowBox[{
       "add", " ", "parameter", " ", "range", " ", "assumption", " ", "and", 
        " ", "construct", " ", "our", " ", "gaDefinePositionVector"}]}], 
      "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"varNames", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<x\>\"", "<>", 
          RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "varsExtracted", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"paramNames", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<p\>\"", "<>", 
          RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "parametersExtracted", "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"Entity", "[", 
           RowBox[{"\"\<Surface\>\"", ",", "name"}], "]"}], "[", 
          RowBox[{"EntityProperty", "[", 
           RowBox[{"\"\<Surface\>\"", ",", "\"\<Variables\>\""}], "]"}], 
          "]"}], "]"}], "===", 
        RowBox[{"Sort", "[", "parametersExtracted", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"paramRanges", "=", 
        RowBox[{"(", 
         RowBox[{"\"\<ParameterRangeAssumptions\>\"", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Entity", "[", 
               RowBox[{"\"\<Surface\>\"", ",", "name"}], "]"}], "[", 
              RowBox[{"EntityProperty", "[", 
               RowBox[{
               "\"\<Surface\>\"", ",", "\"\<VariableConstraints\>\""}], "]"}],
               "]"}], ")"}], "@@", "paramNames"}], ")"}]}], ")"}]}]}], "]"}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sort", "[", 
         RowBox[{
          RowBox[{"Entity", "[", 
           RowBox[{"\"\<Surface\>\"", ",", "name"}], "]"}], "[", 
          RowBox[{"EntityProperty", "[", 
           RowBox[{"\"\<Surface\>\"", ",", "\"\<Parameters\>\""}], "]"}], 
          "]"}], "]"}], "===", 
        RowBox[{"Sort", "[", "varsExtracted", "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"coordinateRanges", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Entity", "[", 
               RowBox[{"\"\<Surface\>\"", ",", "name"}], "]"}], "[", 
              RowBox[{"EntityProperty", "[", 
               RowBox[{"\"\<Surface\>\"", ",", "\"\<ParameterRange\>\""}], 
               "]"}], "]"}], "@@", "paramNames"}], ")"}], "@@", "varNames"}], 
          ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"HoldPattern", "[", 
            RowBox[{"{", 
             RowBox[{"ss_Symbol", ",", 
              RowBox[{"range1_", "?", "NumericQ"}], ",", 
              RowBox[{"range2_", "?", "NumericQ"}]}], "}"}], "]"}], ":>", 
           RowBox[{"Inequality", "[", 
            RowBox[{
            "range1", ",", "LessEqual", ",", "ss", ",", "Less", ",", 
             "range2"}], "]"}]}], "}"}]}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Hold", "[", "gaDefinePositionVector", "]"}], "[", 
      RowBox[{"name", ",", 
       RowBox[{"Piecewise", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Plus", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"parametricRepFunc", "@@", "paramNames"}], ")"}], "@@",
                  "varNames"}], ")"}], "*", 
               RowBox[{"gaOrthonormalBasis", "[", 
                RowBox[{"gaRunningAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
                 RowBox[{"{", "1", "}"}]}], "]"}]}], ")"}]}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"Flatten", "[", 
              RowBox[{"{", "coordinateRanges", "}"}], "]"}]}]}], "}"}], "}"}],
          ",", "False"}], "]"}], ",", "varNames", ",", "paramNames", ",", 
       "paramRanges", ",", 
       RowBox[{"Simplify", "->", "FullSimplify"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}]], "Input",
