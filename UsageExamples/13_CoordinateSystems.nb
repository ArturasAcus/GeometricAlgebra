    RowBox[{"gaOrthonormalBasis", "[", 
     RowBox[{"testAlgebra", ",", "gaRunningOrdering", ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cosList", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Rest", "[", 
