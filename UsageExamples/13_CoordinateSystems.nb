     RowBox[{
      RowBox[{
       RowBox[{"Times", "[", 
        RowBox[{"#1", ",", 
         RowBox[{"Cos", "[", "#2", "]"}]}], "]"}], "&"}], ",", "1", ",", 
      RowBox[{"Reverse", "[", 
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"varsNames", "[", "testAlgebra", "]"}], ",", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"middleTerms", "[", "testAlgebra", "]"}], "=", 
   RowBox[{
    RowBox[{"Most", "[", 
     RowBox[{"cosList", "[", "testAlgebra", "]"}], "]"}], "*", 
    RowBox[{"Sin", "/@", 
     RowBox[{"Reverse", "[", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"varsNames", "[", "testAlgebra", "]"}], ",", 
        RowBox[{"-", "2"}]}], "]"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
