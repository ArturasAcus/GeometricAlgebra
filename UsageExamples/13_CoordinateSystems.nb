Cell["\<\
Seems that we indented to make a number of changes in the future for better \
compatibility with Mma surface database.\
\>", "Text",
 CellChangeTimes->{{3.9035833047357483`*^9, 
  3.903583406218688*^9}},ExpressionUUID->"791e1b41-d368-4dbf-8c13-\
525e30bcffcb"],

Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<TorusSurfaceIn3D\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rR", "+", 
            RowBox[{"a", "*", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], 
          "\[GeometricProduct]", 
          RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
          RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rR", "+", 
            RowBox[{"a", "*", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}]}], ")"}], 
          "\[GeometricProduct]", 
          RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
          RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
         RowBox[{"a", "\[GeometricProduct]", 
