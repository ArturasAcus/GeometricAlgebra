Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<CircularCone3D\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Cos", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"u", ">", "0"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"0", "<=", "\[Alpha]", "<", "Pi"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"0", "<=", "\[CurlyPhi]", "<", 
            RowBox[{"2", "*", "Pi"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
          RowBox[{"u", "\[GeometricProduct]", 
           RowBox[{"Cos", "[", "\[Alpha]", "]"}], "\[GeometricProduct]", 
           RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ",", 
         RowBox[{
