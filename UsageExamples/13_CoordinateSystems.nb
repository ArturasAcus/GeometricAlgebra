   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"r", "^", "2"}], "-", 
     RowBox[{"(", 
      RowBox[{"Plus", "@@", 
       RowBox[{"(", 
        RowBox[{
