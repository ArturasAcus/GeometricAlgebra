           RowBox[{"\[Theta]", "/", "2"}]}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[Theta]", "<", 
           RowBox[{"2", "*", "Pi"}]}], ")"}], "&&", 
