Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<Ball3D\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "3", "]"}], "\[GeometricProduct]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "+", 
           RowBox[{
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "\[GeometricProduct]", 
            RowBox[{"\[DoubleStruckE]", "[", "3", "]"}], 
            "\[GeometricProduct]", 
            RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], 
            "\[GeometricProduct]", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"\[DoubleStruckE]", "[", 
               RowBox[{"1", ",", "2"}], "]"}], "\[GeometricProduct]", 
              "\[CurlyPhi]"}], "]"}]}]}], ")"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", ">=", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[Theta]", "<", "Pi"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]", "<", 
           RowBox[{"2", "*", "Pi"}]}], ")"}]}]}], "}"}], "}"}], ",", 
     "False"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}], ",", 
   RowBox[{"{", "}"}], ",", 
   RowBox[{"gaExpandFunctions", "->", 
    RowBox[{"{", "\"\<Exp\>\"", "}"}]}], ",", 
   RowBox[{"Simplify", "->", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"b94cb97b-f295-4c68-b93a-96fb6e41ed74"],

