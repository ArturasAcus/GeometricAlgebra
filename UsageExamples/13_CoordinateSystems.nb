      RowBox[{
       RowBox[{"gaGeneralMultivector", "[", 
        RowBox[{"u", ",", "testAlgebra", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"u", "[", "in_", "]"}], ":>", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"\"\<u\>\"", "<>", 
          RowBox[{"ToString", "[", "in", "]"}]}], "]"}]}]}], "]"}], ",", 
     "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
