Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"StandardName\"\>", "\[Rule]", "\<\"Toroidal\"\>"}], ",", 
   RowBox[{"\<\"Dimension\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"CoordinateRangeAssumptions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Rho]", "\[GreaterEqual]", "0"}], "&&", 
      RowBox[{"0", "\[LessEqual]", "\[Theta]", "<", "\[Pi]"}], "&&", 
      RowBox[{"0", "\[LessEqual]", "\[CurlyPhi]", "<", 
       RowBox[{"2", " ", "\[Pi]"}]}], "&&", 
      RowBox[{"R", ">", "0"}]}], "}"}]}], ",", 
   RowBox[{"\<\"ParameterRangeAssumptions\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Parameters\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"StandardCoordinateNames\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\[Rho]", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], ",", 
   RowBox[{"\<\"PointVector\"\>", "\[Rule]", 
    RowBox[{
     RowBox[{"\[Rho]", " ", 
      RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], " ", 
      TemplateBox[{
