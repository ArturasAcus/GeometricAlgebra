Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<Helicoid\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "\[GeometricProduct]", "u", "\[GeometricProduct]", 
          RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}], "+", 
         RowBox[{"a", "\[GeometricProduct]", 
          RowBox[{"Sinh", "[", "v", "]"}], "\[GeometricProduct]", 
          RowBox[{"Sin", "[", "u", "]"}], "\[GeometricProduct]", 
          RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
         RowBox[{"a", "\[GeometricProduct]", 
          RowBox[{"Sinh", "[", "v", "]"}], "\[GeometricProduct]", 
          RowBox[{"Cos", "[", "u", "]"}], "\[GeometricProduct]", 
          RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"0", "<=", "u", "<", 
           RowBox[{"2", "*", "Pi"}]}], ")"}], "&&", 
         RowBox[{"Element", "[", 
          RowBox[{"v", ",", "Reals"}], "]"}]}]}], "}"}], "}"}], ",", 
     "False"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"u", ",", "v"}], "}"}], ",", 
   RowBox[{"{", "a", "}"}], ",", 
   RowBox[{"\"\<ParameterRangeAssumptions\>\"", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", ">=", "0"}], "}"}]}], ",", 
   RowBox[{"Simplify", "->", "FullSimplify"}]}], "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"9423d551-6d4f-4aee-8516-d0eb1a452447"],

