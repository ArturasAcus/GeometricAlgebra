Cell["\<\
The defined chart can be referred by name as  gaCoordinateChart[\
\[OpenCurlyDoubleQuote]PolarCS\[CloseCurlyDoubleQuote]]. Here we added \
\[OpenCurlyDoubleQuote]CS\[CloseCurlyDoubleQuote] to remind us  that we are \
dealing with \[OpenCurlyDoubleQuote]coordinate\[CloseCurlyDoubleQuote] \
system. An alternative could be \[OpenCurlyDoubleQuote]non-coordinate\
\[CloseCurlyDoubleQuote] system on the same manifold. Now define the same \
coordinate chart using unexpanded Joot position vector\
\>", "Text",ExpressionUUID->"cc96e91f-8f35-419c-9cd0-6cfbe7a8c2d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<PolarCSUnexpanded\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]", "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "\[GeometricProduct]", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"\[DoubleStruckE]", "[", 
            RowBox[{"1", ",", "2"}], "]"}], "\[GeometricProduct]", 
           "\[CurlyPhi]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", ">=", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]", "<", 
           RowBox[{"2", "*", "Pi"}]}], ")"}]}]}], "}"}], "}"}], ",", 
     "False"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Rho]", ",", "\[CurlyPhi]"}], "}"}], ",", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"7b8a1bd6-5747-4e11-a407-a75ac07fc16a"],

