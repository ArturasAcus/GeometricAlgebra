Cell[BoxData[
 RowBox[{"RuleDelayed", "@@@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"First", "[", "#", "]"}], ",", 
       RowBox[{"Simplify", "[", 
        RowBox[{"gaPE", "[", 
         RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
    
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{
