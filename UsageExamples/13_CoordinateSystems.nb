           RowBox[{"2", "*", "Pi"}]}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"R", ">", "0"}], ")"}]}]}], "}"}], "}"}], ",", "False"}], 
    "]"}], ",", 
