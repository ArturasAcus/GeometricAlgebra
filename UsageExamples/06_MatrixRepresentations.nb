Cell[TextData[{
 "Nice property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         SubscriptBox["\[DoubleStruckE]", "i"], "2"]}], 
       SuperscriptBox[
        SubscriptBox["x", "i"], "2"]}], ")"}], 
     RowBox[{"n", "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "0e1cdbe1-1dbf-45bd-9f56-19ee0c357003"],
 " =det (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    RowBox[{
     SubscriptBox["\[DoubleStruckE]", "i"], 
     SubscriptBox["x", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "fbe5f4fd-c67c-41aa-a445-81c5f7169d2a"],
 ") of Clifford algebra vectors ant their representation matrix determinants \
(see Cl[0,3] -> \[DoubleStruckCapitalH]\[CirclePlus]\[DoubleStruckCapitalH] \
subsection for more detailed explanation)"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
  3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
