  RowBox[{"MatrixForm", ",", 
   RowBox[{"gaDefineMatrixRepresentation", "[", 
    RowBox[{"testAlgebra", ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<IdealBasis\>\"", ",", 
        RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
