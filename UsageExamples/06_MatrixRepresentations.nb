Cell[BoxData[
 RowBox[{"symbolicBaseToMatrixBaseRules", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"{", "#", "}"}], ",", 
       RowBox[{"#", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Rule", "[", 
           RowBox[{"a_", ",", "b_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"Rule", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "b"}]}], "]"}]}], "}"}]}]}], "]"}], "&"}], "/@", 
    RowBox[{"fullMatrixBase", "[", 
     RowBox[{"Cl", "[", 
      RowBox[{"3", ",", "0"}], "]"}], "]"}]}], "]"}]}]], "Input",
