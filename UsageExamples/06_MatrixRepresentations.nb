Cell[TextData[{
 "Then using these substitution rules we replace elements in ",
 StyleBox["symbolicTable",
  FontWeight->"Bold"],
 " by matrices and subtract table explicitly obtained from ",
 StyleBox["fullMatrixBase[Cl[3,0]]",
  FontWeight->"Bold"]
}], "Text",
