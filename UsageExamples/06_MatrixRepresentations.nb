Cell[TextData[{
 "using well known Clifford algebra isomorphisms ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Cl", 
      RowBox[{"1", ",", "1"}]], "\[CircleTimes]", 
     SubscriptBox["Cl", 
      RowBox[{"p", ",", "q"}]]}], "=", 
    SubscriptBox["Cl", 
     RowBox[{
      RowBox[{"p", "+", "1"}], ",", 
      RowBox[{"q", "+", "1"}]}]]}], TraditionalForm]],ExpressionUUID->
  "d89784cb-f022-4d22-822b-a8d3ff8e7669"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["Cl", 
      RowBox[{"0", ",", "2"}]], "\[CircleTimes]", 
     SubscriptBox["Cl", 
      RowBox[{"p", ",", "q"}]]}], "=", 
