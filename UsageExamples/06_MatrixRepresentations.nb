Cell[TextData[{
 "However in order to show more commands we explicitly obtain Pauli spin \
matrices from ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "d9d7c790-9cb6-4093-893e-14366fea73fa"],
 " representation. In order to write representation of  ",
