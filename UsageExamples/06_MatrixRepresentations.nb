Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixPlot", "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "3"}], "]"}], "=", 
     RowBox[{"Last", "/@", 
      RowBox[{"gaDefineMatrixRepresentation", "[", 
       RowBox[{"testAlgebra", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<TensorProduct\>\"", ",", 
           RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], 
              ",", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
               "\"\<Antisymmetric\>\""}], ",", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
               RowBox[{"{", "\"\<Q[1,2]\>\"", "}"}]}]}], "}"}]}], ",", 
           RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", 
            RowBox[{"{", "\"\<QToRealMatrix\>\"", "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<Grades\>\"", "\[Rule]", 
         RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.778828557489764*^9, 3.7788285759136744`*^9}, {
   3.822052813087737*^9, 3.822052815109927*^9}, 3.931596032203558*^9, 
   3.940301786877717*^9, 3.940301835913517*^9},
