Cell[BoxData[
 RowBox[{
  RowBox[{"nameAndMatrix", "[", "alg_Cl", "]"}], ":=", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gaListDefined", 
         RowBox[{"\"\<ElementaryRepresentations\>\"", "[", "alg", "]"}]}], 
        ",", 
        RowBox[{"(", 
         RowBox[{"Row", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"MapAt", "[", 
               RowBox[{"MatrixForm", ",", 
                RowBox[{"gaDefineMatrixRepresentation", "[", 
                 RowBox[{"alg", ",", 
                  RowBox[{"Method", "\[Rule]", 
                   RowBox[{"{", 
                    RowBox[{"\"\<TensorProduct\>\"", ",", 
                    RowBox[{"\"\<ElementaryRepresentations\>\"", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"alg", "->", "#"}], "}"}]}]}], "}"}]}]}], "]"}], 
                ",", 
                RowBox[{"{", 
                 RowBox[{"All", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", 
             "gaListDefined"}], 
            RowBox[{"\"\<ElementaryRepresentations\>\"", "[", "alg", "]"}]}], 
           ")"}]}], ")"}]}], "}"}], "]"}], ",", 
     RowBox[{"TableHeadings", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Representation name\>\"", ",", "Bold"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Representation matrices\>\"", ",", "Bold"}], "]"}]}], 
         "}"}]}], "}"}]}], ",", 
     RowBox[{"TableDirections", "\[Rule]", "Column"}]}], "]"}], "/;", 
   RowBox[{"MemberQ", "[", 
    RowBox[{"GeometricAlgebra`p`elementaryTPAlgebras", ",", "alg"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.682135771276529*^9, 3.682135884032953*^9}, {
  3.748071111198929*^9, 3.748071112319165*^9}, {3.769936102685503*^9, 
