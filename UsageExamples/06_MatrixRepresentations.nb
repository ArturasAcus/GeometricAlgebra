Cell[TextData[{
 " First three are pairs of Pauli matrices, then follow representations of \
symbolic 2\[Cross]2 matrices, the real 4\[Cross]4 representation and three \
quaternionic representations. For convenience we provide default elementary \
representations for all Clifford algebras up to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"8", ",", "8"}]], TraditionalForm]],ExpressionUUID->
  "ed77e4b9-cb19-457e-88d0-cff6b50205ee"],
