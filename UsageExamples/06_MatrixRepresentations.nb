Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixPlot", "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
     RowBox[{"Last", "/@", 
      RowBox[{"gaDefineMatrixRepresentation", "[", 
       RowBox[{"testAlgebra", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<TensorProduct\>\"", ",", 
           RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], 
              ",", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
               "\"\<Antisymmetric\>\""}], ",", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
               RowBox[{"{", "\"\<Q[1,2]\>\"", "}"}]}]}], "}"}]}], ",", 
           RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"\"\<HH2R4\>\"", ",", "\"\<QToRealMatrix\>\""}], 
             "}"}]}]}], "}"}]}], ",", 
        RowBox[{"\"\<Grades\>\"", "\[Rule]", 
         RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.778828453983171*^9, 3.778828479530342*^9}, {
   3.822052807964963*^9, 3.82205280978076*^9}, 3.931596032192635*^9, 
