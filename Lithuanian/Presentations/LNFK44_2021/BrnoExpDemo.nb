  3.819945852302104*^9}, {3.819946315931587*^9, 3.819946384676532*^9}, {
  3.819946419250764*^9, 3.8199464250203733`*^9}, {3.819946458814234*^9, 
  3.819946487901266*^9}},ExpressionUUID->"3dbf7781-eef2-4f15-9685-\
1c84298e9eac"],

