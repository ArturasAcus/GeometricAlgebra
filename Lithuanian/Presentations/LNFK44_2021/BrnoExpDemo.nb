Cell[BoxData[
 RowBox[{
  RowBox[{"rules2aSaI", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", 
      RowBox[{"-", "aI"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", "aI"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"a", "[", "1", "]"}], "2"]}], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", 
      RowBox[{"-", "aS"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"a", "[", "1", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", "aS"}]}], 
    "}"}]}], ";", 
  RowBox[{"rules2aPaR", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["aI", 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}]]}]], "\[Rule]", "aPP"}], ",", 
     RowBox[{
      FractionBox[
       SuperscriptBox["aI", "2"], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}], ")"}]}]], "\[Rule]", 
      RowBox[{"aPP", "^", "2"}]}], ",", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}]], 
       SqrtBox["2"]], "\[Rule]", "aRR"}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}], ")"}]}], "\[Rule]", 
      RowBox[{"aRR", "^", "2"}]}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.819944819580481*^9, 3.81994488348989*^9}, {
   3.8199504835006866`*^9, 3.819950493179893*^9}, 3.819950526327394*^9, {
   3.819950768820848*^9, 3.819950800670128*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"1994d01f-eb65-4ee7-8f6a-a15f342c42a6"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}]]}], "-", 
   RowBox[{
    FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "x"}]]}]}]], "Output",
  CellChangeTimes->{3.8199505636180143`*^9},ExpressionUUID->
  "d9c754e0-2d96-457d-af97-422ea1f0cb76"],
 " and replace imaginary i by pseudoscalar"
}], "Text",
 CellChangeTimes->{{3.819371128707596*^9, 3.819371135708658*^9}, {
