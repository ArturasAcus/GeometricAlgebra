Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaSinOfMVSimplified", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaPE", "[", 
        RowBox[{
         RowBox[{"gaI", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"gaExponentOfMV", "[", 
                RowBox[{"gaPE", "[", 
                 RowBox[{"testMV", "\[GeometricProduct]", 
                  RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], 
               "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"gaExponentOfMV", "[", 
               RowBox[{"gaPE", "[", 
                RowBox[{
                 RowBox[{"-", "testMV"}], "\[GeometricProduct]", 
                 RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], 
              "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
           "2"}], ")"}]}], "]"}], "//.", "rules2aSaI"}], ")"}], "//.", 
     "rules2aPaR"}], ",", "_\[DoubleStruckE]", ",", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ExpToTrig", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"TrigToExp", "[", "#", "]"}], "]"}], "]"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8199506068108788`*^9, 3.819950644194929*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"b3ff06db-d072-48c7-beda-8144bdb20d62"],

