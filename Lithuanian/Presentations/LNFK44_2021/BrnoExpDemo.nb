Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gaExponentOfMV", "[", 
        RowBox[{"-", "testMV"}], "]"}], "[", 
       RowBox[{"[", 
