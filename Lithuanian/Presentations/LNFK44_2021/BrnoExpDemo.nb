Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"gpSeriesTanhAnswerNC6", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"testMV", "/", "maxCoeff"}], ")"}], "/.", 
           "rndReplRules"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "6"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
