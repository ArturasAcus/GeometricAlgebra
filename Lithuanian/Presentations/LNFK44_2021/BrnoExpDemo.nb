Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"expFormExactRezultSeriesNC", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"expFormExactRezult", "/.", 
              RowBox[{
               RowBox[{"a", "[", "x_", "]"}], ":>", 
               RowBox[{
                RowBox[{"a", "[", "x", "]"}], "/", "maxCoeff"}]}]}], ")"}], "/.",
             "rndReplRules"}], ")"}], "//.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"f_", "[", "x_", "]"}], "\[RuleDelayed]", 
             RowBox[{
              RowBox[{"Series", "[", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"x", "*", "\[Alpha]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"\[Alpha]", ",", "0", ",", "20"}], "}"}]}], "]"}], "/;", 
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "Exp", ",", "Sin", ",", "Cos", ",", "Sinh", ",", "Cosh"}], 
                 "}"}], ",", "f"}], "]"}]}]}], ",", 
            RowBox[{
             RowBox[{"E", "^", "p_."}], "\[RuleDelayed]", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{"p", "*", "\[Alpha]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Alpha]", ",", "0", ",", "20"}], "}"}]}], "]"}]}]}],
            "}"}]}], ")"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]", "\[Rule]", "1"}], "}"}]}], "]"}]}], ")"}], "//", 
   "N"}], "//", "Chop"}]], "Input",
