       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"testMV", "/", "maxCoeff"}], ")"}], "/.", 
           "rndReplRules"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "40"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
