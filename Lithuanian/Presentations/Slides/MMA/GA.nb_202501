Cell["\<\
Sobczyk\[CloseCurlyQuote]s formulas for null basis can be inverted. There we \
implemented that inverted formula. Note that the Sobczyk\[CloseCurlyQuote]s \
null vector anticommutator for different null vectors yields 1/2 and 0 for \
the same MV (algebras Cl[1,q] and Cl[p,1]) and probably \
can\[CloseCurlyQuote]t be named as de Witt basis. On the other hand null \
basis for Cl[p,p] do make de Witt basis, since their anticommutator yields 1 \
(for the same) or 0 (for different vectors). Therefore at the moment \
implemented null basis are different and for algebras Cl[p,q] with q>p>1 in \
the end we realized a mix of these two different null basis (not useful). \
Further investigation is needed. At the moment we intentionally not \
implemented p>q>1 case (mix case q>p>1 was implemented)\
\>", "Text",ExpressionUUID->"2a96f2ca-f55e-48c3-af11-c258ce3624cc"],

Cell["For Cl[1,q] we use the inverted formula.", "Text",ExpressionUUID->"751390ba-9c09-4003-bd26-75f99925a823"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaDefineNullBasisVectors", "[", 
   RowBox[{"Cl", "[", 
    RowBox[{"1", ",", 
     RowBox[{"qInd_Integer", "?", "Positive"}]}], "]"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dimVectSpace", "=", 
        RowBox[{"gaDimensionOfVectorSpace", "[", 
         RowBox[{"Cl", "[", 
          RowBox[{"1", ",", "qInd"}], "]"}], "]"}]}], ",", 
       RowBox[{"orthogonalVectors", "=", 
        RowBox[{"gaSort", "[", 
         RowBox[{
          RowBox[{"gaOrthonormalBasis", "[", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"1", ",", "qInd"}], "]"}], ",", "gaRunningOrdering", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], ",", "\"\<InvDeg[Lex]\>\""}], 
         "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gaNullBasisVectors", "[", 
       RowBox[{"Cl", "[", 
        RowBox[{"1", ",", "qInd"}], "]"}], "]"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"orthogonalVectors", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "+", 
              RowBox[{"orthogonalVectors", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"orthogonalVectors", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "-", 
              RowBox[{"orthogonalVectors", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "/", "2"}]}], "}"}], 
         ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orthogonalVectors", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", 
                   RowBox[{"(", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"iSob", "-", "2"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"iSob", "-", "1"}], ")"}]}], "]"}], ")"}]}], "*", 
                  
                  RowBox[{"orthogonalVectors", "[", 
                   RowBox[{"[", "iSob", "]"}], "]"}]}], ",", 
                 RowBox[{"{", 
                  RowBox[{"iSob", ",", "3", ",", 
                   RowBox[{"kSob", "-", "1"}]}], "}"}]}], "]"}], "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], 
                  RowBox[{"(", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"kSob", "-", "1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"kSob", "-", "2"}], ")"}]}], "]"}], ")"}]}], 
                 ")"}], "*", 
                RowBox[{"orthogonalVectors", "[", 
                 RowBox[{"[", "kSob", "]"}], "]"}]}]}], ")"}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"kSob", ",", "3", ",", "dimVectSpace"}], "}"}]}], "]"}]}],
         "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "[", 
     RowBox[{"gaOrthonormalBasis", "[", 
      RowBox[{"Cl", "[", 
       RowBox[{"1", ",", "qInd"}], "]"}], "]"}], "]"}], "===", 
    "List"}]}]}]], "Input",
 CellLabel->
  "In[864]:=",ExpressionUUID->"6428c900-c943-42ab-a102-c308ea2e7b93"],

Cell["\<\
For Cl[p,1] we use the same approach, except that first vector is replaced by \
last and ranges (+ numerical factors) are corrected.\
\>", "Text",ExpressionUUID->"a10ab066-66f9-45fd-950a-0c7235eaa02d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaDefineNullBasisVectors", "[", 
   RowBox[{"Cl", "[", 
    RowBox[{
     RowBox[{"pInd_Integer", "?", "Positive"}], ",", "1"}], "]"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dimVectSpace", "=", 
        RowBox[{"gaDimensionOfVectorSpace", "[", 
         RowBox[{"Cl", "[", 
          RowBox[{"pInd", ",", "1"}], "]"}], "]"}]}], ",", 
       RowBox[{"orthogonalVectors", "=", 
        RowBox[{"gaSort", "[", 
         RowBox[{
          RowBox[{"gaOrthonormalBasis", "[", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"pInd", ",", "1"}], "]"}], ",", "gaRunningOrdering", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], ",", "\"\<InvDeg[Lex]\>\""}], 
         "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orthogonalVectors", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "+", 
             RowBox[{"orthogonalVectors", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"orthogonalVectors", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "-", 
             RowBox[{"orthogonalVectors", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "/", "2"}]}], "}"}], 
        ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"orthogonalVectors", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "+", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], "*", 
                    RowBox[{"(", "i", ")"}]}], "]"}], ")"}]}], "*", 
                 RowBox[{"orthogonalVectors", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "2", ",", 
                  RowBox[{"k", "-", "1"}]}], "}"}]}], "]"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "/", 
                   RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], 
                 RowBox[{"(", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{
                    RowBox[{"(", "k", ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}]}], "]"}], ")"}]}], ")"}], 
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}]}], ")"}]}], ")"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "2", ",", 
            RowBox[{"dimVectSpace", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], 
      "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "[", 
     RowBox[{"gaOrthonormalBasis", "[", 
      RowBox[{"Cl", "[", 
       RowBox[{"pInd", ",", "1"}], "]"}], "]"}], "]"}], "===", 
    "List"}]}]}]], "Input",
 CellLabel->
  "In[865]:=",ExpressionUUID->"87c05d69-1524-4c41-85fe-e38914f46e1f"],

Cell["\<\

  Implementations for Cl[p,p] are trivial and well known and this yield true \
de Witt vector basis\
\>", "Text",ExpressionUUID->"f3591db7-8c0f-4068-8170-92ca289c1327"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaDefineNullBasisVectors", "[", 
   RowBox[{"Cl", "[", 
    RowBox[{
     RowBox[{"pInd_Integer", "?", "Positive"}], ",", 
     RowBox[{"pInd_Integer", "?", "Positive"}]}], "]"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dimVectSpace", "=", 
        RowBox[{"gaDimensionOfVectorSpace", "[", 
         RowBox[{"Cl", "[", 
          RowBox[{"pInd", ",", "pInd"}], "]"}], "]"}]}], ",", 
       RowBox[{"theVectors", "=", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{
          RowBox[{"Cl", "[", 
           RowBox[{"pInd", ",", "pInd"}], "]"}], ",", "gaRunningOrdering", 
          ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gaNullBasisVectors", "[", 
       RowBox[{"Cl", "[", 
        RowBox[{"pInd", ",", "pInd"}], "]"}], "]"}], "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"theVectors", "[", 
               RowBox[{"[", "iSob", "]"}], "]"}], "-", 
              RowBox[{"theVectors", "[", 
               RowBox[{"[", 
                RowBox[{"-", "iSob"}], "]"}], "]"}]}], ")"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", "2"}], ")"}], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"theVectors", "[", 
               RowBox[{"[", "iSob", "]"}], "]"}], "+", 
              RowBox[{"theVectors", "[", 
               RowBox[{"[", 
                RowBox[{"-", "iSob"}], "]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"iSob", ",", "1", ",", "dimVectSpace"}], "}"}]}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "[", 
     RowBox[{"gaOrthonormalBasis", "[", 
      RowBox[{"Cl", "[", 
       RowBox[{"pInd", ",", "pInd"}], "]"}], "]"}], "]"}], "===", 
    "List"}]}]}]], "Input",
 CellLabel->
  "In[866]:=",ExpressionUUID->"f2d8d0f7-909d-4e05-8f1d-9730a1282b90"],

Cell["\<\
Function below yields a mix of Sobczyks and de Witt basis. In principle for \
arbitray Cl[p,q] we now can easily construct mix null basis (the code in the \
case q>p>1 is commented in the end of subsection until matter is clarified)\
\>", "Text",ExpressionUUID->"30326bb6-5d49-45b0-8cb2-52c3b662419e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaDefineNullBasisVectors", "[", 
   RowBox[{"Cl", "[", 
    RowBox[{
     RowBox[{"pInd_Integer", "?", "Positive"}], ",", 
     RowBox[{"qInd_Integer", "?", "Positive"}]}], "]"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"orthogonalVectors", "=", 
        RowBox[{"gaSort", "[", 
         RowBox[{
          RowBox[{"gaOrthonormalBasis", "[", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"pInd", ",", "qInd"}], "]"}], ",", "gaRunningOrdering", 
            ",", 
            RowBox[{"{", "1", "}"}]}], "]"}], ",", "\"\<InvDeg[Lex]\>\""}], 
         "]"}]}], ",", "trivialNullVectors", ",", "offSet"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"for", " ", "any", " ", "p"}], ">", 
       RowBox[{
        RowBox[{"q", " ", "we", " ", "compute", " ", "p"}], "-", 
        RowBox[{"1", " ", "trivial", " ", "null", " ", "vectors"}]}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "Print", "[", 
       "\"\<Warning! computed null basis is a mix of de Witt and Sobczyk's \
null basis. Check anticommutators!!!\>\"", "]"}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"offSet", "=", 
       RowBox[{"qInd", "-", "pInd"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"trivialNullVectors", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", "iSob", "]"}], "]"}], "-", 
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", 
                 RowBox[{"iSob", "+", "pInd", "+", "qInd", "-", "offSet"}], 
                 "]"}], "]"}]}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", "iSob", "]"}], "]"}], "+", 
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", 
                 RowBox[{"iSob", "+", "pInd", "+", "qInd", "-", "offSet"}], 
                 "]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"iSob", ",", "1", ",", "offSet"}], "}"}]}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "After", " ", "removing", " ", "these", " ", "vectors", " ", "case", 
         " ", 
         RowBox[{"Cl", "[", 
          RowBox[{"1", ",", "q"}], "]"}], " ", "remains"}], ",", " ", 
        RowBox[{
        "so", " ", "we", " ", "reduced", " ", "it", " ", "to", " ", "known", 
         " ", "case"}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gaNullBasisVectors", "[", 
        RowBox[{"Cl", "[", 
         RowBox[{"pInd", ",", "qInd"}], "]"}], "]"}], "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"{", 
         RowBox[{"trivialNullVectors", ",", " ", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", "pInd", "]"}], "]"}], "+", 
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", 
                 RowBox[{"pInd", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
             "2"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", "pInd", "]"}], "]"}], "-", 
               RowBox[{"orthogonalVectors", "[", 
                RowBox[{"[", 
                 RowBox[{"pInd", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
             "2"}]}], "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"orthogonalVectors", "[", 
               RowBox[{"[", "pInd", "]"}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"iSob", "-", "2", "-", "offSet"}], ")"}], "*", 
                    RowBox[{"(", 
                    RowBox[{"iSob", "-", "1", "-", "offSet"}], ")"}]}], "]"}],
                     ")"}]}], "*", 
                   RowBox[{"orthogonalVectors", "[", 
                    RowBox[{"[", "iSob", "]"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"iSob", ",", 
                    RowBox[{"pInd", "+", "2"}], ",", 
                    RowBox[{"kSob", "-", "1"}]}], "}"}]}], "]"}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "/", 
                    RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], 
                   RowBox[{"(", 
                    RowBox[{"Sqrt", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"kSob", "-", "offSet", "-", "1"}], ")"}], "/", 
                    RowBox[{"(", 
                    RowBox[{"kSob", "-", "offSet", "-", "2"}], ")"}]}], "]"}],
                     ")"}]}], ")"}], "*", 
                 RowBox[{"orthogonalVectors", "[", 
                  RowBox[{"[", "kSob", "]"}], "]"}]}]}], ")"}]}], ")"}], ",", 
            
            RowBox[{"{", 
             RowBox[{"kSob", ",", 
              RowBox[{"pInd", "+", "2"}], ",", 
              RowBox[{"pInd", "+", "qInd", "-", "offSet"}]}], "}"}]}], 
           "]"}]}], "}"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Head", "[", 
       RowBox[{"gaOrthonormalBasis", "[", 
        RowBox[{"Cl", "[", 
         RowBox[{"pInd", ",", "qInd"}], "]"}], "]"}], "]"}], "===", "List"}], 
     ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{"pInd", "<", "qInd"}], ")"}], "&&", 
    RowBox[{"(", 
     RowBox[{"pInd", ">", "1"}], ")"}]}]}]}]], "Input",
 CellLabel->
  "In[867]:=",ExpressionUUID->"ca108a98-91b2-479e-94d9-5f59f832274b"]
}, Closed]]
}, Closed]],

Cell[BoxData[
 RowBox[{
  RowBox[{"EndPrivate", "[", "]"}], ";"}]], "Input",
 CellLabel->
  "In[868]:=",ExpressionUUID->"96bf7a12-2465-47ed-a4c0-1ee77155c9c0"]
}, Closed]],

