Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sameTestForUnion", "[", "Reals", "]"}], "=", 
   RowBox[{"Hold", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"#1", "+", "#2"}], "]"}], "===", "0"}], ")"}], "||", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"#1", "-", "#2"}], "]"}], "===", "0"}], ")"}]}], "&"}], 
     ")"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sameTestForUnion", "[", "Complexes", "]"}], "=", 
   RowBox[{"Hold", "[", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"#1", "+", "#2"}], "]"}], "===", "0"}], ")"}], "||", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"#1", "-", "#2"}], "]"}], "===", "0"}], ")"}], "||", 
       RowBox[{"(", 
