       RowBox[{"{", "}"}]}], "]"}], ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{"SubscriptBox", "[", 
    RowBox[{"\"\<\[NegativeThickSpace]\>\"", ",", 
     RowBox[{"RowBox", "[", 
