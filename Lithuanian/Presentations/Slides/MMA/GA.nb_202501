                    RowBox[{"al", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
                    RowBox[{
                    RowBox[{"al", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", 
                    RowBox[{"al", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "]"}], "&"}],
                  "/@", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"(", 
