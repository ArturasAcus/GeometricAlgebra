Cell[TextData[{
 "The general dimension solver is implemented by forward nesting. In the \
article D.Shirokov, \[CloseCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox[
    RowBox[{
     RowBox[{"Basis", "-", "free"}], " ", 
     RowBox[{" ", "Solution"}], " ", "to", " ", "Sylvester", " ", "Equation", 
     " ", "in", " ", "Clifford", " ", "Algebra", " ", 
     RowBox[{"of", " ", "Arbitrary", " ", "Dimension"}], " ", "of", " ", 
     "Arbitrary", " ", "Dimension"}], "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Articles", "Shirokov_2021_Basis-freeSolutionOfSylvesterEq.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,ExpressionUUID->
  "9fd76d0f-682a-4cef-8ac0-dc0276696e37"],
 "\[CloseCurlyDoubleQuote],  it was given by recursive algorithm.  Explicit \
formulas can be used for N\[LessEqual]5. "
}], "Text",ExpressionUUID->"9a565e42-1531-417c-a796-88935052ed37"],

