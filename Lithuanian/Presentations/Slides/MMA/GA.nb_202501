               RowBox[{
                RowBox[{"Collect", "[", 
                 RowBox[{
                  RowBox[{"mergeOperation", "[", "#", "]"}], ",", 
                  "gaNonCommutativeFieldElementPattern"}], "]"}], "&"}]}], 
              "]"}], ",", "al", ",", "any"}], "]"}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], "/;", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ass1", ",", "ass2"}], "}"}], ",", 
         RowBox[{"KeyValuePattern", "[", 
          RowBox[{"_", "->", 
           RowBox[{"bs", "[", 
            RowBox[{"_Association", ",", "__"}], "]"}]}], "]"}]}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Only", " ", "option", " ", "procession", " ", "part"}], ",", 
       " ", 
       RowBox[{"when", " ", 
        RowBox[{"gaProductPairExpand", "[", " ", "]"}], " ", "is", " ", 
