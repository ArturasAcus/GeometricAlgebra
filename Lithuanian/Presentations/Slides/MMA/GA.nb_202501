            RowBox[{"\"\<Grades\>\"", "->", "All"}], ",", 
            RowBox[{"\"\<DefineInput\>\"", "\[Rule]", "False"}], ",", 
            RowBox[{"\"\<MakeAlias\>\"", "\[Rule]", "False"}]}], "]"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"basisAlg", "=", 
          RowBox[{"gaOrthonormalBasis", "[", 
           RowBox[{"alg", ",", "\"\<InvDeg[Lex]\>\"", ",", "All"}], "]"}]}]}],
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "the", " ", "only", " ", "indices", " ", "that", " ", "needs", " ", 
          "replacements", " ", "are", " ", "last", " ", "four", " ", 
