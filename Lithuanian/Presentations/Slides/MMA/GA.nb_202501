Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaInnerMatrixProduct", "::", "usage"}], "=", 
   "\"\<gaInnerMatrixProduct[A,B,...] computes  product of matrices A and B, \
elements of which are multivectors. Matrix elements are multiplied using \
Inner product.\>\""}], ";"}]], "Input",
 CellLabel->
