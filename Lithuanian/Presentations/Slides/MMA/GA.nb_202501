Cell[TextData[{
 "Quaternion tensor product H\[CircleTimes]H ->R(4) isomorphism rules, taken \
from \[CloseCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Explicit Isomorphisms of Real Clifford Algebras\"\>", 
    "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Degirmenci_2006_IsomorphismaGA_078613_p.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "4393b3aa-64a0-4166-ada1-21a554e4eb7e"],
 "\[CloseCurlyDoubleQuote]. And simple C\[CircleTimes]H->C(2) rules, using \
Pauli 1,2 matrix representation  "
}], "Text",ExpressionUUID->"9962236f-dfbf-487d-aa34-55b0ca8cecff"],

