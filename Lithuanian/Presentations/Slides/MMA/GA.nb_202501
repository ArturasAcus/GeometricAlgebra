         RowBox[{"h", ":", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "GeometricProduct", "|", "OuterProduct", "|", "LeftContract", "|",
              "RightContract"}], ")"}], "[", 
           RowBox[{
            RowBox[{"argg1", ":", 
             RowBox[{"(", 
