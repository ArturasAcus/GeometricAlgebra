          RowBox[{"mvDownUp", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", "_", ",", "_"}], "]"}], "[", 
        RowBox[{"mvPoint", "[", "_", "]"}], "]"}], "]"}], "=", "1"}], ";", 
     " ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"addition", " ", "to", " ", "curvilinear", " ", "coords"}], 
       ",", " ", 
       RowBox[{"comment", " ", "for", " ", "investigation"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
