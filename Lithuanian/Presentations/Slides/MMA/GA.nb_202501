Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaComponentCoefficientAndBasisList", "[", 
      RowBox[{
       RowBox[{"bs", "[", 
        RowBox[{"expr_Association", ",", "theAlgebra_Cl", ",", "other___"}], 
        "]"}], ",", 
       RowBox[{"op", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "theOption", ",", "keyIntersectionFunction", ",", "indices", ",", 
         "theBasis", ",", "sortedBasis"}], "}"}], ",", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{"option", " ", "handling"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"gaSetNamedOptionValue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "gaComponentCoefficientAndBasisList", ",", "#", ",", 
              "theOption"}], "}"}], ",", 
            RowBox[{
             RowBox[{
             "gaOptionCheck", "[", 
              "testOptionComponentCoefficientAndBasisList", "]"}], "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
                "}"}]}], ")"}], "]"}], ",", 
            RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
           "]"}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{"First", "/@", 
           RowBox[{"{", "op", "}"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "set", " ", "method", " ", "value", " ", "if", " ", "it", " ", "was",
           " ", "not", " ", "set"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
           "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
           RowBox[{"(", 
            RowBox[{"Quiet", "/.", 
             RowBox[{
             "Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
            ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], "]"}], "===",
            "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], "=", 
           RowBox[{"(", 
            RowBox[{"\"\<FullBasis\>\"", "/.", 
             RowBox[{
             "Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
            ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{
            "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}], 
            "]"}], "===", "theOption"}], ",", 
          RowBox[{
           RowBox[{
           "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}], 
           "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<gaNonCommutativeMonomialOrder\>\"", "/.", 
               RowBox[{
               "Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
              ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{
              "\"\<gaNonCommutativeMonomialOrder\>\"", "->", 
               "gaRunningOrdering"}], "}"}]}], ")"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Warn", " ", "if", " ", "requested", " ", "ordering", " ", "differs",
           " ", "from", " ", "gaRunningOrdering"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
             "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}],
              "=!=", "gaRunningOrdering"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Message", "[", 
             RowBox[{
              RowBox[{
              "gaComponentCoefficientAndBasisList", "::", "ordering"}], ",", 
              RowBox[{
              "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", 
               "]"}], ",", "gaRunningOrdering"}], "]"}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], ",", 
          RowBox[{"keyIntersectionFunction", "=", "Identity"}], ",", 
          RowBox[{"keyIntersectionFunction", "=", "KeyIntersection"}]}], 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"construct", " ", "full", " ", 
           RowBox[{"InvDeg", "[", "Lex", "]"}], " ", "basis"}], ",", " ", 
          RowBox[{"then", " ", "sort"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"indices", "=", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", "}"}]}], "]"}], "&"}], "/@", 
            RowBox[{"mvInvDegLexSortedIndexList", "[", "theAlgebra", "]"}]}], 
           ",", 
           RowBox[{"mvDownUp", "[", 
            RowBox[{
             RowBox[{"{", "}"}], ",", 
             RowBox[{"{", "}"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"theBasis", "=", 
         RowBox[{"KeySort", "[", 
          RowBox[{
           RowBox[{"AssociationThread", "[", 
            RowBox[{"indices", "->", "0"}], "]"}], ",", 
           RowBox[{
            RowBox[{"orderedQNonCommutative", "[", 
             RowBox[{
              RowBox[{
              "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", 
               "]"}], ",", 
              RowBox[{
              "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
              ",", 
              RowBox[{
              "#2", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
             "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sortedBasis", "=", 
         RowBox[{"Merge", "[", 
          RowBox[{
           RowBox[{"keyIntersectionFunction", "[", 
            RowBox[{"{", 
             RowBox[{"theBasis", ",", "expr"}], "}"}], "]"}], ",", "Total"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"MapAt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{"#", ",", "theAlgebra", ",", "other"}], "]"}], "&"}], ",", 
          RowBox[{"RotateLeft", "[", 
           RowBox[{"Transpose", "[", 
            RowBox[{"List", "@@@", 
             RowBox[{"Normal", "[", "sortedBasis", "]"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "All"}], "}"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellLabel->
  "In[309]:=",ExpressionUUID->"7d739e81-6484-4acd-80cb-e8e6efc5c930"],

Cell["\<\
Component taking in PlainRepresentation is based on converting to \
AssociationRepresentation and then taking the components.\
\>", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"317acad4-582f-43d1-a76e-97b5f48290dd"],

Cell["\<\
Taking components for complicated symbolic MV is time consuming task and is \
not reliable, especially in the case of  noncommutative field. Better to \
convert to Association representation, then it can be done much faster.  No \
reciprocal or mixed basis is allowed in current implementation.\
\>", "Text",ExpressionUUID->"25a828de-1a35-44ab-b6d3-a5093884bcdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaComponentCoefficientAndBasisList", "[", 
    RowBox[{"expr_", ",", "basis_List", ",", 
     RowBox[{"op", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "theOption", ",", "exprAssociation", ",", "keyIntersectionFunction", 
        ",", "indices", ",", "theBasisAssoc", ",", "fullConstruction", ",", 
        "finalFormFunction"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"option", " ", "handling"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gaSetNamedOptionValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "gaComponentCoefficientAndBasisList", ",", "#", ",", 
             "theOption"}], "}"}], ",", 
           RowBox[{
            RowBox[{
            "gaOptionCheck", "[", 
             "testOptionComponentCoefficientAndBasisList", "]"}], "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
               "}"}]}], ")"}], "]"}], ",", 
           RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
          "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"{", "op", "}"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "set", " ", "method", " ", "value", " ", "if", " ", "it", " ", "was", 
         " ", "not", " ", "set"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
          "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
          RowBox[{"(", 
           RowBox[{"Quiet", "/.", 
            RowBox[{
            "Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
           ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], "]"}], "===",
           "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], "=", 
          RowBox[{"(", 
           RowBox[{"\"\<FullBasis\>\"", "/.", 
            RowBox[{
            "Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
           ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "When", " ", "explicit", " ", "basis", " ", "is", " ", "provided", 
         " ", "we", " ", 
         RowBox[{"don", "'"}], "t", " ", "need", " ", "sorting", " ", 
         "option"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", "_Association"}], "]"}], ",", 
         RowBox[{
          RowBox[{"exprAssociation", "=", 
           RowBox[{"gaPE", "[", 
            RowBox[{"gaAssociationRepresentation", "[", "expr", "]"}], 
            "]"}]}], ";", 
          RowBox[{"finalFormFunction", "=", "gaPlainRepresentation"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"finalFormFunction", "=", "Identity"}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"gaExpandedQ", "[", "expr", "]"}], ",", 
            RowBox[{"exprAssociation", "=", "expr"}], ",", 
            RowBox[{"exprAssociation", "=", 
             RowBox[{"gaPE", "[", "expr", "]"}]}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<FullBasis\>\"", "]"}], ",", 
         RowBox[{"keyIntersectionFunction", "=", "Identity"}], ",", 
         RowBox[{"keyIntersectionFunction", "=", "KeyIntersection"}]}], "]"}],
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"indices", "=", 
        RowBox[{"First", "/@", 
         RowBox[{"Replace", "[", 
          RowBox[{"basis", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"any1___", ",", "1", ",", "any2___"}], "}"}], ":>", 
             RowBox[{"{", 
              RowBox[{"any1", ",", 
               RowBox[{"{", 
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], "}"}], ",", "any2"}], "}"}]}], 
            "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"theBasisAssoc", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"indices", "->", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"fullConstruction", "=", 
        RowBox[{"Merge", "[", 
         RowBox[{
          RowBox[{"keyIntersectionFunction", "[", 
           RowBox[{"{", 
            RowBox[{"theBasisAssoc", ",", 
             RowBox[{"exprAssociation", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], ",", "Total"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"final", " ", "assembly"}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"finalFormFunction", "[", 
        RowBox[{"MapAt", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{"exprAssociation", ",", "1"}], "]"}], ",", "#"}], "]"}],
            "&"}], ",", 
          RowBox[{"RotateLeft", "[", 
           RowBox[{"Transpose", "[", 
            RowBox[{"List", "@@@", 
             RowBox[{"Normal", "[", "fullConstruction", "]"}]}], "]"}], "]"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "All"}], "}"}]}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{
     RowBox[{"gaMVFunctionFreeQ", "[", "expr", "]"}], "&&", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"expr", ",", "basis"}], "}"}], ",", 
       RowBox[{"mvDownUp", "[", 
        RowBox[{
         RowBox[{"{", "___", "}"}], ",", 
         RowBox[{"{", "__", "}"}]}], "]"}]}], "]"}]}]}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellLabel->
  "In[310]:=",ExpressionUUID->"b65a578f-d79f-4dfb-88f7-7cbada9e7596"],

Cell["\<\
When no basis is given, just convert to Association form and call previous \
function.\
\>", "Text",ExpressionUUID->"44a2f2c4-1180-4fb2-b818-76cc1757231c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaComponentCoefficientAndBasisList", "[", 
   RowBox[{"expr_", ",", 
    RowBox[{"op", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"al", "=", 
        RowBox[{"gaGetAlgebra", "[", "expr", "]"}]}], ",", "exprAssociation", 
       ",", "finalFormFunction"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"expr", ",", "_Association"}], "]"}], ",", 
        RowBox[{
         RowBox[{"finalFormFunction", "=", "gaPlainRepresentation"}], ";", 
         RowBox[{"exprAssociation", "=", 
          RowBox[{"gaPE", "[", 
           RowBox[{"gaAssociationRepresentation", "[", "expr", "]"}], 
           "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"finalFormFunction", "=", "Identity"}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"gaExpandedQ", "[", "expr", "]"}], ",", 
           RowBox[{"exprAssociation", "=", "expr"}], ",", 
           RowBox[{"exprAssociation", "=", 
            RowBox[{"gaPE", "[", "expr", "]"}]}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"finalFormFunction", "[", 
       RowBox[{"gaComponentCoefficientAndBasisList", "[", 
        RowBox[{"exprAssociation", ",", "op"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"gaMVFunctionFreeQ", "[", "expr", "]"}]}]}]], "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"441ee639-2194-4946-bd59-f31b12d548c3"],

Cell["\<\
Often we need either full components or component coefficients only\
\>", "Text",ExpressionUUID->"14e022eb-419f-4509-9d8a-745b2bae8553"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gaComponentList", "]"}], "=", 
   RowBox[{"Options", "[", "gaComponentCoefficientAndBasisList", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaComponentList", "[", 
    RowBox[{"expr_", ",", "basis___", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", 
       RowBox[{"{", 
        RowBox[{
        "gaComponentCoefficientAndBasisList", ",", "gaComponentList"}], "}"}],
        "]"}]}]}], "]"}], ":=", 
   RowBox[{"Thread", "[", 
    RowBox[{"GeometricProduct", "@@", 
     RowBox[{"gaComponentCoefficientAndBasisList", "[", 
      RowBox[{"expr", ",", "basis", ",", "opts"}], "]"}]}], "]"}]}], 
