 CounterBox["Subsubsection"],
 ". Definition of noncommutative field"
}], "Subsubsection",ExpressionUUID->"c2a79937-21b7-4e4b-9001-075893d0fcaf"],

Cell[TextData[{
 "Below we define gaNonCommutativeFieldElementQ[ ] predicate.  Also Set \
package option gaIncludeRulesForNonCommutativeField->True to work with \
noncommutative fields ( not recommended as of 2024-09, may cause a lot of \
problems). ",
 StyleBox["Note",
  FontColor->RGBColor[1, 0, 1]],
 ". ",
 StyleBox["gaNonCommutativeFieldElementQ[]",
  FontWeight->"Bold"],
 " checks that noncommutative field elements presents in the unexpanded \
expression. After expanding geometric product of field elements we can obtain \
a scalar, i.e. commutative field element. "
}], "Text",ExpressionUUID->"b75203bb-c739-4421-a1da-4a2fdf5e9630"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "gaNonCommutativeFieldElementPattern", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"gaNonCommutativeFieldElementQ", "[", "_", "]"}], "]"}], ":=", 
    "False"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Set", " ", "quaternion", " ", "field"}], "  ", "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaDefineNonCommutativeField", "[", "\"\<Quaternion\>\"", "]"}], ":=",
     "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bs", "=", 
        RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ClearAll", "[", 
        RowBox[{
        "gaNonCommutativeFieldElementQ", ",", 
         "gaNonCommutativeFieldElementPattern", ",", "gaRunningField"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"gaNonCommutativeFieldElementQ", "[", "expr_", "]"}], "]"}], 
        ":=", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", "\"\<Quaternion\>\""}], "]"}]}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Except", "[", 
            RowBox[{
             RowBox[{"Cl", "[", 
              RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", "_Cl"}], "]"}]}],
           "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"Alternatives", "[", 
            RowBox[{
             RowBox[{"bs", "[", 
              RowBox[{"_", ",", 
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2", ",", "0"}], "]"}]}], "]"}], ",", 
             RowBox[{"bs", "[", 
              RowBox[{"_", ",", 
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", 
               RowBox[{"Except", "[", 
                RowBox[{"\"\<Quaternion\>\"", ",", "_String"}], "]"}], ",", 
               "___"}], "]"}]}], "]"}], ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", 
           RowBox[{
           "OuterProduct", "|", "InnerProduct", "|", "LeftContract", "|", 
            "RightContract", "|", "MV"}], ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gaNonCommutativeFieldElementPattern", "=", 
        RowBox[{"bs", "[", 
         RowBox[{"_", ",", 
          RowBox[{"Cl", "[", 
           RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", 
          "\"\<Quaternion\>\"", ",", "___"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gaRunningField", "=", "\"\<Quaternion\>\""}]}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Set", " ", "general", " ", "noncommutative", " ", 
    RowBox[{"Cl", "[", 
     RowBox[{"p", ",", "q"}], "]"}], " ", "field"}], "  ", "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaDefineNonCommutativeField", "[", "field_Cl", "]"}], ":=", 
    "\[IndentingNewLine]", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bs", "=", 
        RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ClearAll", "[", 
        RowBox[{
        "gaNonCommutativeFieldElementQ", ",", 
         "gaNonCommutativeFieldElementPattern", ",", "gaRunningField"}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"gaNonCommutativeFieldElementQ", "[", "expr_", "]"}], "]"}], 
        ":=", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", "field"}], "]"}]}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"_", ",", 
             RowBox[{"Except", "[", 
              RowBox[{"field", ",", "_Cl"}], "]"}], ",", "___"}], "]"}], ",", 
           
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", 
           RowBox[{
           "OuterProduct", "|", "InnerProduct", "|", "LeftContract", "|", 
            "RightContract", "|", "MV"}], ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"gaNonCommutativeFieldElementPattern", "=", 
        RowBox[{"HoldPattern", "[", 
         RowBox[{"bs", "[", 
          RowBox[{"_", ",", "field", ",", 
           RowBox[{"___", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"FreeQ", "[", 
               RowBox[{
                RowBox[{"{", "##", "}"}], ",", "\"\<Quaternion\>\""}], "]"}], 
              "&"}], ")"}]}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"gaDefineOrthonormalBasis", "[", 
        RowBox[{"field", ",", 
         RowBox[{"\"\<MakeAlias\>\"", "->", "False"}], ",", 
         RowBox[{"\"\<DefineInput\>\"", "->", "False"}], ",", 
         RowBox[{"Quiet", "->", "True"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"gaRunningField", "=", "field"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Clear", " ", "noncommutative", " ", "field", " ", "definitions"}],
    " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaDefineNonCommutativeField", "[", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"ClearAll", "[", 
      RowBox[{
      "gaNonCommutativeFieldElementQ", ",", 
       "gaNonCommutativeFieldElementPattern", ",", "gaRunningField"}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "_", "]"}], "]"}], ":=", 
      "False"}], ";", "\[IndentingNewLine]", 
     RowBox[{"gaRunningField", "=", 
      RowBox[{"Cl", "[", 
       RowBox[{"0", ",", "0", ",", "0"}], "]"}]}]}], ")"}]}], ";"}]}], "Input",\

 CellLabel->
  "In[259]:=",ExpressionUUID->"1b6a16c3-c455-4ce7-8482-40041f48b56c"],

Cell[TextData[{
 "Commutative field detection. An alternative would be ",
 StyleBox["gaCommutativeFieldElementQ[expr_]:=gaCommutativeAllQ[expr];",
  FontWeight->"Bold"],
 " ",
 StyleBox["Note",
  FontColor->RGBColor[1, 0, 1]],
 ". Iff GeometricProduct is present we assume, that element is not \
commutative (despite that after expansion it may yield a scalar). The check \
is based on syntax."
}], "Text",ExpressionUUID->"1a54c088-f6e4-4a72-a2fa-ca7dcd391957"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaCommutativeFieldElementQ", "[", "expr_", "]"}], "]"}], ":=", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"expr", ",", 
        RowBox[{
        "bs", "|", "MV", "|", "GeometricProduct", "|", "OuterProduct", "|", 
         "InnerProduct", "|", "LeftContract", "|", "RightContract"}], ",", 
        RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaFieldElementQ", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"gaCommutativeFieldElementQ", "[", "expr", "]"}], "||", 
    RowBox[{"gaNonCommutativeFieldElementQ", "[", "expr", "]"}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"7f00508e-7163-47ec-99a0-45f5ad4a2d9c"],

Cell["\<\
By default noncommutative field is set to \[OpenCurlyDoubleQuote]Quaternion\
\[CloseCurlyDoubleQuote], since this setting (even if we are working with \
real or complex Clifford algebras) enables easy input of quaternion elements \
(which, for example, appears in matrix representations of some real Clifford \
algebras). \
\>", "Text",ExpressionUUID->"3dd16e25-6909-43a3-9cbd-0b8367881651"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"gaRunningField", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"0", ",", "0", ",", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineNonCommutativeField", "[", "\"\<Quaternion\>\"", "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[266]:=",ExpressionUUID->"de515b31-196e-419f-87a5-b3ff7c94adec"],

Cell["Field detection function", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"e1657736-db3b-4bf1-9f57-b09866476c13"],

Cell["\<\
Often we need to decide from given expression which coefficient field is \
involved. \
\>", "Text",ExpressionUUID->"b2e8fdcb-e9f5-46af-8ce8-146730f70171"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaGetField", "::", "noRunningField"}], "=", 
   "\"\<Expression '1' don't contain any MV and gaRunningField is not \
defined. Will return empty list. Expect unexpected behaviour.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGetField", "::", "empty"}], "=", 
   "\"\<No noncommutative field element found. Returned value is \
gaRunninField.\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[268]:=",ExpressionUUID->"1ed62abc-cd98-44e5-801d-3412806eb55c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaGetField", "[", "expr_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "noncommutativeElement", "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"noncommutativeElement", "=", 
       RowBox[{"FirstCase", "[", 
        RowBox[{
         RowBox[{"{", "expr", "}"}], ",", 
         "gaNonCommutativeFieldElementPattern", ",", 
         RowBox[{"{", "}"}], ",", "Infinity", ",", 
         RowBox[{"Heads", "->", "False"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "If", " ", "noncommutative", " ", "element", " ", "list", " ", "is", 
         " ", "empty"}], ",", " ", 
        RowBox[{"return", " ", "gaRunningField", " ", 
         RowBox[{"(", 
          RowBox[{"if", " ", "it", " ", "was", " ", "defined"}], ")"}]}], ",",
         " ", 
        RowBox[{"else", " ", "warn"}]}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", " ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "noncommutativeElement", "]"}], ">", "0"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"noncommutativeElement", ",", "\"\<Quaternion\>\""}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FirstCase", "[", 
           RowBox[{
            RowBox[{"{", "noncommutativeElement", "}"}], ",", "_Cl", ",", 
            RowBox[{"{", "}"}], ",", "Infinity", ",", 
            RowBox[{"Heads", "->", "False"}]}], "]"}], ",", 
          "\[IndentingNewLine]", "\"\<Quaternion\>\""}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ToString", "[", "gaRunningField", "]"}], "===", 
           "\"\<gaRunningField\>\""}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"gaGetField", "::", "noRunningField"}], ",", "expr"}], 
            "]"}], ";", 
           RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"gaGetField", "::", "empty"}], ",", "expr"}], "]"}], ";",
            "gaRunningField"}]}], "\[IndentingNewLine]", "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[270]:=",ExpressionUUID->"eae3507d-5186-438f-9df3-ca0cd07e1f7a"]
}, Closed]],

