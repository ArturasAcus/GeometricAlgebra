Cell[TextData[{
 "When both type of indices present, then we have to find set symmetric \
difference of common index set. In addition we have to remember which indices \
are down and what are up. Note that ",
 StyleBox["Union[ ]",
  FontWeight->"Bold"],
 " automatically sorts integers."
}], "Text",
 CellGroupingRules->{
  GroupTogetherGrouping, 
   10001.},ExpressionUUID->"c445d15b-00b3-41f5-8443-ca5c4567a6cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"productIndex", "[", 
    RowBox[{
     RowBox[{"mvDownUp", "[", 
      RowBox[{"i1_List", ",", "j1_List"}], "]"}], ",", 
     RowBox[{"mvDownUp", "[", 
      RowBox[{"i2_List", ",", "j2_List"}], "]"}], ",", "GeometricProduct"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"productIndex", "[", 
     RowBox[{
      RowBox[{"mvDownUp", "[", 
       RowBox[{"i1", ",", "j1"}], "]"}], ",", 
      RowBox[{"mvDownUp", "[", 
       RowBox[{"i2", ",", "j2"}], "]"}], ",", "GeometricProduct"}], "]"}], 
    "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ssd", "=", 
        RowBox[{"mvSetSymmetricDifference", "[", 
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{"i1", ",", "j1"}], "]"}], ",", 
          RowBox[{"Union", "[", 
           RowBox[{"i2", ",", "j2"}], "]"}]}], "]"}]}], "}"}], ",", 
      RowBox[{"mvDownUp", "[", 
       RowBox[{
        RowBox[{"Intersection", "[", 
         RowBox[{"ssd", ",", 
          RowBox[{"Join", "[", 
           RowBox[{"i1", ",", "i2"}], "]"}]}], "]"}], ",", 
        RowBox[{"Intersection", "[", 
         RowBox[{"ssd", ",", 
          RowBox[{"Join", "[", 
           RowBox[{"j1", ",", "j2"}], "]"}]}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[397]:=",ExpressionUUID->"45c72040-5346-4b64-b018-29c845039c75"],

