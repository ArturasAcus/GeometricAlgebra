Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaAssociationRepresentation", "::", "usage"}], "=", 
   "\"\<\!\(\*StyleBox[\"gaAssociationRepresentation\",FontWeight->\"Bold\"]\)\
\!\(\*StyleBox[\"[\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"expr_\",\
FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"]\",FontWeight->\"Bold\"]\) converts \
multivectors in the expression expr to Mathematica's Associations. The \
association (associative array) representation, (denoted as e[<| keys -> \
values|>, algebra, ___]) is extremely convenient (and fast) in manipulating \
multivector structure. Option \\\"FieldToAssociation\\\"->False (default)| \
True| Automatic can be used to convert noncommutative coefficient to \
Association form as well (coefficient expression should be expanded). The \
option \\\"gaNonCommutativeMonomialOrder\\\"->ordering name (deflaut \
\\\"InvDeg[Lex]\\\" sorts key order in Association. The option \
\\\"Check\\\"->True (default)|False attempt to check if conversion succeded \
(it looks for forbidden forms indicating incomplete conversion). You can \
convert back with gaPlainRepresentation[ ] (if noncommutative coefficients \
were converted to Associations as well, then one needs to use the command \
twice).\>\""}], ";"}]], "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"d13c1d7a-f43c-4b53-80b8-a8d5f11ece9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaPlainRepresentation", "::", "usage"}], "=", 
    "\"\<\!\(\*StyleBox[\"gaPlainRepresentation\",FontWeight->\"Bold\"]\)\!\(\
\*StyleBox[\"[\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"expr_\",FontWeight->\
\"Bold\"]\)\!\(\*StyleBox[\"]\",FontWeight->\"Bold\"]\) converts from \
internal Association format to simple additive format, which is much more \
convenient to read and input.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaAssociationTogether", "::", "usage"}], "=", 
   "\"\<gaAssociationTogether[expr] rewrites sum of MVs, which are in \
Association representations as a single MV. In normal circumstances a user \
should never need this function, unless make sum of MVs in Associations form \
by hand.\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[223]:=",ExpressionUUID->"f8c87548-a7e8-450e-8550-38af95f59cd4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaGeneralMultivector", "::", "usage"}], "=", 
   "\"\<gaGeneralMultivector[coef_,al_Cl|cs_coordinateSystemQ,grade_:{}] \
generates multivector of the alggebra al with symbolic coefficients named as \
coef[_integer] of specified grade. If grade list is empty {} or All all \
grades are generated.\>\""}], ";"}]], "Input",
 CellLabel->
  "In[225]:=",ExpressionUUID->"ade821c9-0118-4c3f-b1b5-900b916ca986"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaRandomMultivector", "::", "usage"}], "=", 
   "\"\<gaRandomMultivector[al_Cl,grade_:{},Range->{min,max}] generates \
random multivector of the algebra al with random integer coefficients in the \
range Specified by option Range->{-10,10} (default). If grade list is empty \
{} or All all grades of MV are generated.\>\""}], ";"}]], "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"641c5424-2cf6-4635-8177-76013c468bbe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaComponentCoefficientAndBasisList", "::", "usage"}], "=", 
   "\"\<gaComponentCoefficientAndBasisList[expandedExpr,OptionsPattern[{\\\"\
gaNonCommutativeMonomialOrder\\\"\[Rule]\\\"InvDeg[Lex]\\\"}]] or \
gaComponentCoefficientAndBasisList[expandedExpr, basisElems_List]] output \
{components_List, basis_List}, where the list components are components of MV \
with respect to basis, which is listed in requested ordering (except in the \
case with explicit basis syntax, which then remain unchanged).\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaComponentList", "::", "usage"}], "=", 
   "\"\<Returns Times product of both list given by \
gaComponentCoefficientAndBasisList[ ].\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaComponentCoefficientList", "::", "usage"}], "=", 
   "\"\<Returns first list given by gaComponentCoefficientAndBasisList[ \
]\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"b27850dd-40d0-404c-b013-d330db6787df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaDefineNonCommutativeField", "::", "usage"}], "=", 
   "\"\<gaDefineNonCommutativeField[\\\"Quaternion\\\"] enables quaternion \
coefficients at basis elements of Clifford algebra. \
gaDefineNonCommutativeField[Cl[p,q]] enables coefficients of different \
Clifford algebra to be used as coefficients at basis elements of defined \
Clifford algebra. It is assumed, Clifford coefficients commute with  basis \
elements of space (main) Clifford algebra. IMPORTANT. For Clifford \
coefficients the only defined product is a geometric product (no outer/inner \
or contractions operations for a coeffients). Requires package option \
gaIncludeRulesForNonCommutativeField->True to be set by edditing package \
options.  Early stage, expect surprises\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaNonCommutativeFieldElementQ", "::", "usage"}], "=", 
   "\"\<Predicator to test if expression contains noncommutative field \
element, i.e \\\"Quaternion\\\"  coefficients or Clifford algebra \
coefficients. Coefficients should belong to different Clifford algebra. \
Multiplication of coefficients is ALWAYS assumed to be GeometricProducts \
(usage of inner and outer products for coefficients at basis elements \
probably is inconsistent, not investigated).\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaCommutativeFieldElementQ", "::", "usage"}], "=", 
   "\"\<Predicator to test if expression contains commutative field element, \
i.e no \\\"Quaternion\\\"  coefficients or Clifford algebra \
coefficients.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaFieldElementQ", "::", "usage"}], "=", 
   "\"\<Predicator to test if expression contains field element (either \
commutative or not)\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaNonCommutativeFieldElementPattern", "::", "usage"}], "=", 
   "\"\<A reserved symbol which can be used to match noncommutative field \
basis element.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaFieldMap", "::", "usage"}], "=", 
   "\"\<gaFieldMap[expr,function] maps function on field elements that are \
values of bs[as_Association,al_,___] that present inside expr. If \
bs[as_Association,al_,___] is not present in expr, it does nothing.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaFieldExpand", "::", "usage"}], "=", 
   "\"\<gaFieldExpand[expr] is a shortcut to gaFieldMap[expr,gaPE].\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaGetField", "::", "usage"}], "=", 
   "\"\<gaFieldField[expr] returns name of field in expr \
(string\\\"Quaternion\\\" or Cl[p,q]). \>\""}], ";"}]}], "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"013bc1fd-ff8f-4093-b99e-496afb855149"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaMVFunctionFreeQ", "::", "usage"}], "=", 
   "\"\<gaMVFunctionFreeQ[expr] test if functions of MV (for example \
Sin[e[1]+e[2]]) are explicitly present. When function is explicitly present \
it prevents taking a grades or components of expression. Only formal syntax \
(without expansion) is checked by trying to detect heads (which ane not \
inside exclusion list) with arguments that contain basis elements. It also \
checks for presence of unspecified generic MV head.\>\""}], ";"}]], "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"9dc825e5-2701-47e7-a5c4-7c60bf4f1a6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaGradeList", "::", "usage"}], "=", 
   "\"\<gaGradeList[expr] returns grade list of multivector.\>\""}], 
  ";"}]], "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"c6492878-05ab-4836-9178-3d3b8c83534f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaVectorQ", "::", "usage"}], "=", 
   "\"\<gaVectorQ[expr] return True if expression is GA vector (either \
reciprocal or of direct space). It simply extract grade and test if it is \
equal to 1.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaVectorOrZeroQ", "::", "usage"}], "=", 
   "\"\<gaVectorOrZeroQ[expr] return True if expression is either GA vector \
(either reciprocal, direct space or zero vector). It simply extract grade and \
test if it is equal to 1, if not then test if expression is zero.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaPrimaryVectorQ", "::", "usage"}], "=", 
   "\"\<gaPrimaryVectorQ[expr] return True if expression formally is GA \
primary space vector (matches mvDownUp[{_},{}]). This is a formal \
test.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaRecipocalVectorQ", "::", "usage"}], "=", 
   "\"\<gaRecipocalVectorQ[expr] return True if expression is formally \
reciprocal vector (matches mvDownUp[{},{_}]). This is a formal test.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaZeroGradeFreeQ", "::", "usage"}], "=", 
   "\"\<gaZeroGradeFreeQ[expr] return True if MV don't have a scalar \
part.\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[240]:=",ExpressionUUID->"a3466567-27dd-4318-8ec2-d5c7fed5e695"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BeginPrivate", "[", "]"}], ";"}]], "Input",
