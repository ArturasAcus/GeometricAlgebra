Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaToCliffordMatrixRepresentation", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"gaToCliffordMatrixRepresentation", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", "expr", "}"}], "}"}], ",", "opts"}], "]"}], "/;", 
    RowBox[{
     RowBox[{"Head", "[", "expr", "]"}], "=!=", "List"}]}]}], ";", 
  RowBox[{
   RowBox[{"gaToCliffordMatrixRepresentation", "[", 
    RowBox[{"expr_List", ",", 
     RowBox[{"opts", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theOption", ",", "theReductionSequence", ",", 
        RowBox[{"alg", "=", 
         RowBox[{"gaGetAlgebra", "[", "expr", "]"}]}], ",", 
        "sequenceOfAlgebras"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gaSetNamedOptionValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "gaToCliffordMatrixRepresentation", ",", "#", ",", "theOption"}], 
            "}"}], ",", 
           RowBox[{
            RowBox[{
            "gaOptionCheck", "[", "testOptionToCliffordMatrixRepresentation", 
             "]"}], "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
               "}"}]}], ")"}], "]"}], ",", 
           RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
          "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"Flatten", "[", 
          RowBox[{"First", "/@", 
           RowBox[{"FilterRules", "[", 
            RowBox[{
             RowBox[{"{", "opts", "}"}], ",", 
             RowBox[{
             "Options", "[", "gaToCliffordMatrixRepresentation", "]"}]}], 
            "]"}]}], "]"}], ")"}]}], ";", "\n", 
       RowBox[{"(*", " ", 
        RowBox[{
        "check", " ", "if", " ", "main", " ", "options", " ", "obtained", " ",
          "values"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<ReductionSequence\>\"", "]"}], 
           "]"}], "===", "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<ReductionSequence\>\"", "]"}], "=", 
          RowBox[{"\"\<ReductionSequence\>\"", "/.", 
           RowBox[{
           "Options", "[", "gaToCliffordMatrixRepresentation", "]"}]}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
          "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
          RowBox[{"Quiet", "/.", 
           RowBox[{
           "Options", "[", "gaToCliffordMatrixRepresentation", "]"}]}]}]}], 
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"compute", "/", "check"}], " ", "explicit", " ", "reduction",
          " ", "sequence"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<ReductionSequence\>\"", "]"}], ",", 
         RowBox[{"Automatic", "|", "\"\<Automatic\>\""}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "make", " ", "reduction", " ", "sequence", " ", "automatically"}], 
          " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"theReductionSequence", "=", 
          RowBox[{"autoreductionlist", "[", "alg", "]"}]}], 
         "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"user", " ", "defined", " ", "reduction", " ", "sequence"}],
           " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"{", "__List", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Most", "[", 
               RowBox[{"List", "@@", "alg"}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{"Plus", "@@", 
                RowBox[{
                "theOption", "[", "\"\<ReductionSequence\>\"", "]"}]}], 
               ")"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"_Integer", "?", "NonNegative"}], ",", 
               RowBox[{"_Integer", "?", "NonNegative"}]}], "}"}]}], "]"}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"apply", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", 
               RowBox[{"-", "1"}]}], "}"}], " ", "transformations", "  ", 
             "last"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{"theReductionSequence", "=", 
            RowBox[{"Sort", "[", 
             RowBox[{
              RowBox[{"theOption", "[", "\"\<ReductionSequence\>\"", "]"}], 
              ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{"#1", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], ">", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}], "&"}]}], 
             "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
         "\[IndentingNewLine]", "_", ",", "\[IndentingNewLine]", 
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{
           "gaToCliffordMatrixRepresentation", "::", "reductionSequence"}], 
           ",", 
           RowBox[{"theOption", "[", "\"\<ReductionSequence\>\"", "]"}]}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"printDetails", "[", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
           "\"\<Reduction sequence is : \>\"", ",", "theReductionSequence"}], 
           "}"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sequenceOfAlgebras", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}]}], "}"}], "&"}], 
         "/@", 
         RowBox[{"Cl", "@@@", 
          RowBox[{"FoldList", "[", 
           RowBox[{"Plus", ",", 
            RowBox[{"List", "@@", "alg"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Append", "[", 
               RowBox[{"#", ",", "0"}], "]"}], "&"}], "/@", 
             "theReductionSequence"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "call", " ", "all", " ", "partial", " ", "reduction", " ", 
         "procedures"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"Fold", "[", 
        RowBox[{"toCliffordMatrix", ",", "expr", ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"theReductionSequence", ",", 
            RowBox[{"Most", "[", "sequenceOfAlgebras", "]"}]}], "}"}], 
          "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{
     RowBox[{"Dimensions", "[", "expr", "]"}], "===", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}]}]}]}]], "Input",
