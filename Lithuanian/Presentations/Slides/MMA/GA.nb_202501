Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bs", "=", 
     RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toCliffordMatrix", "[", 
     RowBox[{"expr_List", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"alg_Cl", ",", "quietOpt_"}], "}"}]}], "}"}]}], "]"}], ":=", 
    
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "basisAlg", ",", "algLess", ",", "basisLessAlg", ",", "replaceHead", 
         ",", "scalarRule", ",", "basisAlgVectors", ",", 
         "basisReplacementRulesVectors", ",", "basisReplacementRulesAll"}], 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "for", " ", "original", " ", "algebra", " ", "we", " ", "need", " ", 
         "full", " ", "basis"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"gaOrthonormalBasis", "[", 
             RowBox[{"alg", ",", "\"\<InvDeg[Lex]\>\""}], "]"}], "]"}], "===",
            "gaOrthonormalBasis"}], ",", 
          RowBox[{"basisAlg", "=", 
           RowBox[{"gaDefineOrthonormalBasis", "[", 
            RowBox[{"alg", ",", 
             RowBox[{
             "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
              "\"\<InvDeg[Lex]\>\""}], ",", 
             RowBox[{"\"\<Grades\>\"", "->", "All"}], ",", 
             RowBox[{"\"\<DefineInput\>\"", "\[Rule]", "False"}], ",", 
             RowBox[{"\"\<MakeAlias\>\"", "\[Rule]", "False"}]}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"basisAlg", "=", 
           RowBox[{"gaOrthonormalBasis", "[", 
            RowBox[{"alg", ",", "\"\<InvDeg[Lex]\>\""}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"basisAlgVectors", "=", 
         RowBox[{"Take", "[", 
          RowBox[{"basisAlg", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", 
             RowBox[{
              RowBox[{"gaDimensionOfVectorSpace", "[", "alg", "]"}], "+", 
              "1"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "for", " ", "less", " ", "algebra", " ", "only", " ", "vectors", " ",
           "are", " ", "enough"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
        RowBox[{"algLess", "=", 
         RowBox[{"Cl", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@", "alg"}], ")"}], "-", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"gaOrthonormalBasis", "[", 
             RowBox[{"algLess", ",", "\"\<InvDeg[Lex]\>\"", ",", 
              RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "===", 
           "gaOrthonormalBasis"}], ",", 
          RowBox[{"basisLessAlg", "=", 
           RowBox[{"gaDefineOrthonormalBasis", "[", 
            RowBox[{"algLess", ",", 
             RowBox[{
             "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
              "\"\<InvDeg[Lex]\>\""}], ",", 
             RowBox[{"\"\<Grades\>\"", "->", 
              RowBox[{"{", "1", "}"}]}], ",", 
             RowBox[{"\"\<DefineInput\>\"", "\[Rule]", "False"}], ",", 
             RowBox[{"\"\<MakeAlias\>\"", "\[Rule]", "False"}]}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{"basisLessAlg", "=", 
           RowBox[{"gaDefineOrthonormalBasis", "[", 
            RowBox[{"algLess", ",", "\"\<InvDeg[Lex]\>\"", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"scalarRule", "=", 
         RowBox[{"{", 
          RowBox[{"1", "->", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"basisReplacementRulesVectors", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"#", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"-", "#"}]}], "}"}]}], "}"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"alg", "->", "algLess"}], "}"}]}], ")"}]}], ")"}],
                 "&"}], ",", 
               RowBox[{"Take", "[", 
                RowBox[{"basisAlgVectors", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{
                    RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "}"}]}], 
                "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"basisAlgVectors", "[", 
                RowBox[{"[", 
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", "1"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}], ",", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"#", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"#", ",", "0"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", 
                    RowBox[{"-", "#"}]}], "}"}]}], "}"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "in_", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ":>", 
                    RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"in", "-", "1"}], "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}]}], ",", 
                    RowBox[{"alg", "->", "algLess"}]}], "}"}]}], ")"}]}], 
                 ")"}], "&"}], ",", 
               RowBox[{"Take", "[", 
                RowBox[{"basisAlgVectors", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
                   RowBox[{
                    RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", 
                    RowBox[{"alg", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "}"}]}], 
                "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"basisAlgVectors", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", 
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "->", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", 
                   RowBox[{"-", "1"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], 
            "\[IndentingNewLine]", "}"}], ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"printDetails", "[", 
         RowBox[{"quietOpt", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<Isomorphism transformation: \>\"", ",", 
              RowBox[{"alg", "->", "algLess"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Replacement rules for vectors:\>\"", ",", 
              "basisReplacementRulesVectors"}], "}"}]}], 
           "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"basisReplacementRulesAll", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"scalarRule", ",", 
           RowBox[{"gaDefineMatrixRepresentation", "[", 
            RowBox[{"basisReplacementRulesVectors", ",", "alg"}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Plus", "@@", 
               RowBox[{"(", 
                RowBox[{"gaGeometricMatrixProduct", "@@@", 
                 RowBox[{"Transpose", "[", 
                  RowBox[{"(", 
                   RowBox[{"MapAt", "[", 
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"var", ",", 
                    RowBox[{"Replace", "[", 
                    RowBox[{
                    "var", ",", "basisReplacementRulesAll", ",", "1"}], 
                    "]"}]}], "]"}], ",", 
                    RowBox[{"gaComponentCoefficientAndBasisList", "[", 
                    RowBox[{"#", ",", "basisAlg"}], "]"}], ",", "2"}], "]"}], 
                   ")"}], "]"}]}], ")"}]}], ")"}], "&"}], ",", "expr", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}], "\[IndentingNewLine]", "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"gaGeometricMatrixProduct", "->", "GeometricProduct"}], 
          "}"}]}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
     RowBox[{"MatrixQ", "[", "expr", "]"}]}]}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
 CellLabel->
  "In[1027]:=",ExpressionUUID->"5914c446-96ab-48d8-9330-aa197dbc0b74"],

