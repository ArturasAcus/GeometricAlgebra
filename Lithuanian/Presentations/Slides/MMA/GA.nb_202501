                    RowBox[{
                    "\"\<case: \>\"", ",", 
                    "\"\<mvNorm1>0,mvNorm>0,a0>0\>\""}], "}"}], "}"}]}], 
                 "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", "2"}], ")"}], "*", " ", 
                  RowBox[{"Log", "[", "mvNorm", "]"}]}], "+", 
