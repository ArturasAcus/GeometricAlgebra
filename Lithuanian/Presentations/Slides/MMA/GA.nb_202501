Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "If", " ", "expression", " ", "is", " ", "neither", " ", "basis", " ", 
     "element", " ", "nor", " ", "one", " ", "of", " ", "product"}], ",", " ", 
