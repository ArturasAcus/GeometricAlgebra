Cell[TextData[{
 "Differentiation of vector.\nDifferent  definitions for flat and curved \
spaces! Coordinate system is flat when ",
 StyleBox["gaFlatSpaceQ[name]",
  FontWeight->"Bold"],
 "=True. This flag is set  if all ChristoffelSymbols in the coordinate system \
are zero.\n1) directional derivative of down vector with respect to down \
vector (only index can differ) \
DD[\[DoubleStruckE]_i,\[DoubleStruckE]_j]->Sum[\[CapitalGamma]^k_{i,j}\
\[DoubleStruckE]_k]. \n2) DD[e_{i,j,k..},e_s]->DD[e_i\[OuterProduct]e_j\
\[OuterProduct]e_k\[OuterProduct]..,e_s]->DD[e_i,e_s]\[OuterProduct]e_j\
\[OuterProduct]e_k\[OuterProduct]...+e_i\[OuterProduct]DD[e_j,e_s]\
\[OuterProduct]e_k\[OuterProduct]...+e_i\[OuterProduct]e_j\[OuterProduct]DD[e_\
k,e_s]\[OuterProduct]...+...\nAt the moment how to differentiate basis \
element along vector argument is included (in curved space). We need a \
theory"
}], "Text",ExpressionUUID->"7baa0486-00d4-4bf7-8191-347fd860103a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"deVectorRules", "=", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bs", "=", 
        RowBox[{
        "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", 
         "]"}]}], "}"}], ",", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "rules", " ", "depend", " ", "on", " ", "directional", " ", 
         "derivative", " ", 
         RowBox[{"model", ".", " ", 
          StyleBox["Point",
           FontColor->RGBColor[1, 0.5, 0]]}], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox["function",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox["model",
          FontColor->RGBColor[1, 0.5, 0]]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"flat", " ", "space", " ", "rule", " ", "first"}], ",", " ", 
         
         RowBox[{
         "zero", " ", "when", " ", "differentiate", " ", "any", " ", "basis", 
          " ", "element", " ", "along", " ", "direction", " ", "of", " ", 
          "any", " ", 
          RowBox[{"(", "nonscalar", ")"}], " ", "basis", " ", "element"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{
            RowBox[{"gaDirectionalDerivative", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                "mvIndExpr_mvDownUp", ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                "mvIndDirection_mvDownUp", ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], 
            ",", 
            RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
         RowBox[{"0", "/;", 
          RowBox[{
           RowBox[{"gaFlatSpaceQ", "[", "coordSysName", "]"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Join", "@@", "mvIndDirection"}], "]"}], "]"}], ">", 
             "0"}], ")"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "curved", " ", "space", " ", "rules", " ", "are", " ", "much", " ", 
           "more", " ", "complex"}], ",", " ", 
          RowBox[{"therefore", " ", "the", " ", "separation"}]}], " ", "*)"}],
         " ", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"basis", " ", "vector", " ", "differentiation"}], "*)"}], 
        " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{
            RowBox[{"gaDirectionalDerivative", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "whatToD_Integer", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "alongDirection_Integer", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], 
            ",", 
            RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"Sum", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"gaChristoffelSymbol", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "}"}], ",", 
                  RowBox[{"{", "dummyInd", "}"}]}], "]"}], ",", 
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "whatToD", "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", 
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "alongDirection", "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "coordSysName"}], "]"}], 
              "[", 
              RowBox[{"mvPoint", "[", "vars", "]"}], "]"}], "*", 
             RowBox[{
              RowBox[{"bs", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "dummyInd", "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "al", ",", 
                "coordSysName"}], "]"}], "[", 
              RowBox[{"mvPoint", "[", "vars", "]"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"dummyInd", ",", 
              RowBox[{"Length", "[", "vars", "]"}]}], "}"}]}], "]"}], "/;", 
          RowBox[{"Not", "[", 
           RowBox[{"gaFlatSpaceQ", "[", "coordSysName", "]"}], "]"}]}]}], ",",
         "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"any", " ", 
          RowBox[{"(", "down", ")"}], " ", "basis", " ", "element", " ", 
          "differentiation"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{
            RowBox[{"gaDirectionalDerivative", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "whatToD__Integer", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "alongDirection_Integer", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], 
            ",", 
            RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"expr", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "#", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "al", ",", 
                   "coordSysName"}], "]"}], "[", 
                 RowBox[{"mvPoint", "[", "vars", "]"}], "]"}], "&"}], "/@", 
               RowBox[{"{", "whatToD", "}"}]}], ")"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Plus", "@@", 
             RowBox[{"(", 
              RowBox[{"OuterProduct", "@@@", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"ReplacePart", "[", 
                  RowBox[{"expr", ",", "\[IndentingNewLine]", 
                   RowBox[{"i", "->", 
                    RowBox[{"derivativeExpandHelp", "[", 
                    RowBox[{
                    RowBox[{"gaDirectionalDerivative", "[", 
                    RowBox[{
                    RowBox[{"expr", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"bs", "[", 
                    RowBox[{
                    RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "alongDirection", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "al", ",", 
                    "coordSysName"}], "]"}], "[", 
                    RowBox[{"mvPoint", "[", "vars", "]"}], "]"}]}], "]"}], 
                    ",", 
                    RowBox[{"{", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "1", ",", 
                   RowBox[{"Length", "[", "expr", "]"}]}], "}"}]}], "]"}]}], 
              ")"}]}], "/;", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"{", "whatToD", "}"}], "]"}], ">", "1"}]}]}], 
          "\[IndentingNewLine]", "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         StyleBox[
          RowBox[{"independent", " ", "variable", " ", "model"}],
          FontColor->RGBColor[1, 0.5, 0]], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "convert", " ", "to", " ", "mvD", " ", "only", " ", "when", " ", 
          "differentiate", " ", "along", " ", "the", " ", "same", " ", 
          "basis", " ", "element"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"HoldPattern", "[", 
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{
            RowBox[{"gaDirectionalDerivative", "[", 
             RowBox[{
              RowBox[{"Times", "[", 
               RowBox[{"c_", ",", 
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{"upInd_List", ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                   "coordSysName_String"}], "]"}], "[", 
                 RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], 
              ",", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{"upInd_List", ",", 
                   RowBox[{"{", "}"}]}], "]"}], ",", "al_Cl", ",", 
                 "coordSysName_String"}], "]"}], "[", 
               RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], 
            ",", 
            RowBox[{"{", "varRules__", "}"}]}], "]"}], "]"}], ":>", 
         RowBox[{
          RowBox[{"Times", "[", 
           RowBox[{
            RowBox[{"mvD", "[", 
             RowBox[{"c", ",", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{"upInd", ",", 
                 RowBox[{"{", "}"}]}], "]"}], "/.", 
               RowBox[{"{", "varRules", "}"}]}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"bs", "[", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{"upInd", ",", 
                 RowBox[{"{", "}"}]}], "]"}], ",", "al", ",", 
               "coordSysName"}], "]"}], "[", 
             RowBox[{"mvPoint", "[", "vars", "]"}], "]"}]}], "]"}], "/;", 
          RowBox[{
           RowBox[{"gaFlatSpaceQ", "[", "coordSysName", "]"}], "&&", 
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "c", "}"}], ",", 
             RowBox[{"Alternatives", "@@", 
              RowBox[{"{", 
               RowBox[{"MV", ",", "bs"}], "}"}]}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}]}]}]}]}], 
       "\[IndentingNewLine]", "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellLabel->
  "In[1551]:=",ExpressionUUID->"fe8429c0-a156-43db-972f-f9c61434630d"],

Cell["\<\
If after application of all these rules derivativeExpandHelp[] function \
appears in the answer, it will mean that rule set is not complete and we have \
to add more rules. \
\>", "Text",ExpressionUUID->"1591ae89-a36e-4083-b39f-647161a153b9"],

Cell["\<\
Now merge above rules, which will be applied matching depth first until \
result will not change. First, define a rules, when directional derivatives \
are functions of manifold point.\
\>", "Text",ExpressionUUID->"cc032bda-1fa5-4bed-9172-4c1bf760c896"],

