Cell[TextData[{
 "Only numerical rank values are allowed. Grade of empty base element is \
zero, grade of base element multiplied by factor is grade of base element. \
Warning. Replacement of c in expression c_*bs_basisSymbol by c_. would result \
in infinite loop. ",
 StyleBox["getGradeHelp[ ]",
  FontWeight->"Bold"],
 " is used for algebra independent memoization. "
}], "Text",
 CellGroupingRules->{
  GroupTogetherGrouping, 
   10001.},ExpressionUUID->"5647c695-e310-4afc-b287-bedd7e8cb38c"],

