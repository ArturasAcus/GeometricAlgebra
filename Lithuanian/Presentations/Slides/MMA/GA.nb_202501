 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". Commands that can be extended trivially (just by replacing \
\[DoubleStruckE][] to \[DoubleStruckE][][])"
}], "Subsubsection",ExpressionUUID->"36ea19e5-1feb-4195-9688-e8e6c5fdc4a3"],

