         RowBox[{"printDetails", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Function of scalar detected. Calling ordinary function\>\"",
               ",", "\"\<\>\""}], "}"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"thefunction", "[", "exprExpanded", "]"}]}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[1362]:=",ExpressionUUID->"a64ba7f4-1fd9-4131-8801-685b54b99736"],

Cell["\<\
The functionOfMVMatrix[ ] uses Mathematica internal implementation \
MatrixFunction[ ]\
\>", "Text",ExpressionUUID->"dd07f6a7-1b64-4514-aba7-6cd403d9bd23"],

Cell[BoxData[
 RowBox[{
  RowBox[{"functionOfMVMatrix", "[", 
   RowBox[{"thefunction_", ",", "expr_", ",", 
    RowBox[{"{", 
     RowBox[{"quiet_", ",", "expandFunction_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"theAlg", "=", 
       RowBox[{"gaGetAlgebra", "[", "expr", "]"}]}], ",", "answer"}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
     "compute", " ", "matrix", " ", "representation", " ", "of", " ", "the", 
      " ", "algebra", " ", "without", " ", "quaternions"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"theAlg", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "->", 
              "\"\<Antisymmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], 
             ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], "->", 
              "\"\<Antisymmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "\[Rule]", 
              RowBox[{"{", "\"\<IPauli[3,1]\>\"", "}"}]}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
              RowBox[{"{", "\"\<Pauli[3,1]\>\"", "}"}]}]}], "}"}]}]}], 
         "}"}]}], ",", 
       RowBox[{"Quiet", "\[Rule]", "quiet"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"answer", "=", 
      RowBox[{"gaFromMatrixRepresentation", "[", 
       RowBox[{
        RowBox[{"MatrixFunction", "[", 
         RowBox[{"thefunction", ",", 
          RowBox[{"gaToMatrixRepresentation", "[", 
           RowBox[{"expr", ",", "theAlg", ",", 
            RowBox[{"Quiet", "->", "quiet"}]}], "]"}]}], "]"}], ",", "theAlg",
         ",", 
        RowBox[{"Quiet", "->", "quiet"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"expandFunction", "===", "False"}], ",", "answer", ",", 
       RowBox[{"expandFunction", "[", "answer", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1367]:=",ExpressionUUID->"0f7e8994-e153-43cf-ad07-c877ce824c8b"],

Cell["\<\
makeSSum[ ] is a help functions for qTable[ ]. The pair of this functions \
implements implements recursive partial function decomposition of \
1/minimalPolynomial. \
\>", "Text",ExpressionUUID->"3516107c-ec24-4d14-8fa9-50a76bd106e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeSSum", "[", 
     RowBox[{
     "sDTable_List", ",", "muDTable_List", ",", "multiplicity_Integer", ",", 
      "previousQs_List", ",", "term_Integer"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sDTable", "[", 
        RowBox[{"[", 
         RowBox[{"1", "+", "term"}], "]"}], "]"}], "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"previousQs", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "*", 
          RowBox[{"muDTable", "[", 
           RowBox[{"[", 
            RowBox[{"multiplicity", "+", "k"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "term"}], "}"}]}], "]"}]}], ")"}], "/", 
     RowBox[{"muDTable", "[", 
      RowBox[{"[", "multiplicity", "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qTable", "[", 
    RowBox[{"sDTable_List", ",", "muDTable_List", ",", 
     RowBox[{"{", 
      RowBox[{"root_", ",", "multiplicity_Integer"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"makeSSum", "[", 
          RowBox[{
          "sDTable", ",", "muDTable", ",", "multiplicity", ",", "#1", ",", 
           "#2"}], "]"}], ",", "#1"}], "}"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sDTable", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"muDTable", "[", 
        RowBox[{"[", "multiplicity", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", 
       RowBox[{"multiplicity", "-", "1"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[1368]:=",ExpressionUUID->"62e94b20-7868-4ea2-81da-55e67770d300"],

Cell["\<\
recursivePartialFractionDecompose[ ] uses qTable[] to output partial fraction \
decomposition for each of roots of minimal polynomial. \
\>", "Text",ExpressionUUID->"e1c13d23-8ec3-41c3-877c-2a123442e523"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"recursivePartialFractionDecompose", "[", 
    RowBox[{
    "numerator_", ",", "minPoly_", ",", "rootsWithMultiplicities_List", ",", 
     "maxRootMultiplicity_Integer", ",", "c1Repls_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sDTable", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"Factorial", "[", "i", "]"}]}], ")"}], "*", 
           RowBox[{"D", "[", 
            RowBox[{"numerator", ",", 
             RowBox[{"{", 
              RowBox[{"\[FormalLambda]", ",", "i"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{"maxRootMultiplicity", "-", "1"}]}], "}"}]}], "]"}]}], 
       ",", 
       RowBox[{"muDTable", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "/", 
             RowBox[{"Factorial", "[", "i", "]"}]}], ")"}], 
           RowBox[{"D", "[", 
            RowBox[{"minPoly", ",", 
             RowBox[{"{", 
              RowBox[{"\[FormalLambda]", ",", "i"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{
             RowBox[{"2", "maxRootMultiplicity"}], "-", "1"}]}], "}"}]}], 
         "]"}]}], ",", "allrootTableGeneral", ",", "rootsToInsert"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"allrootTableGeneral", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"qTable", "[", 
               RowBox[{"sDTable", ",", "muDTable", ",", "#"}], "]"}]}], "}"}],
             "&"}], "/@", "rootsWithMultiplicities"}], ")"}], "/.", 
         "c1Repls"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"ReplaceAll", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", 
           RowBox[{"\[FormalLambda]", "->", 
            RowBox[{"First", "[", "#", "]"}]}], "}"}]}], "]"}], "&"}], "/@", 
       "allrootTableGeneral"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1370]:=",ExpressionUUID->"f03851fa-69dd-492f-afa1-5b19345ae8e2"],

Cell["\<\
The function allPowersOfMV[] compute all powers of MV up to power  pow+1. So, \
you need to specify one power less than you need. It uses \
AssociationRepresentation  for expansion. This function can be used in many \
functions. At the moment, however we use in functionOfMV*[ ] only. Warning. \
We include pure function\[CloseCurlyQuote]s argument in local vars, since it \
is fragile and can yield very unexpected computations if this variable will \
coincide with some external variable (in mult coefficients). Of course, when \
defined  in a package this is prevented by static Context, but we want \
insurance if used directly in Global context.\
\>", "Text",ExpressionUUID->"f2dbf4c7-68c3-4493-8af2-5595c628e097"],

Cell[BoxData[
 RowBox[{
  RowBox[{"allPowersOfMV", "[", 
   RowBox[{
    RowBox[{"var_", "->", "mult_"}], ",", "pow_Integer", ",", 
    RowBox[{"theRepresentation", ":", 
     RowBox[{"(", 
      RowBox[{
      "\"\<AssociationRepresentation\>\"", "|", 
       "\"\<PlainRepresentation\>\""}], ")"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pfv", ",", 
      RowBox[{"formalPowers", "=", 
       RowBox[{"var", "^", 
        RowBox[{"(", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", 
            RowBox[{"pow", "+", "1"}]}], "]"}], "]"}], ")"}]}]}], ",", 
      RowBox[{"repTransform", "=", 
       RowBox[{"ToExpression", "[", 
        RowBox[{"\"\<ga\>\"", "<>", "theRepresentation"}], "]"}]}]}], "}"}], 
    ",", 
    RowBox[{"MapThread", "[", 
     RowBox[{"Rule", ",", 
      RowBox[{"{", 
       RowBox[{"formalPowers", ",", 
        RowBox[{"gaPlainRepresentation", "[", 
         RowBox[{"Nest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Function", "[", 
                  RowBox[{
                   RowBox[{"{", "pfv", "}"}], ",", 
                   RowBox[{"gaPE", "[", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "#", "]"}], ",", "pfv"}], "]"}], 
                    "]"}]}], "]"}], "/@", "#"}], ")"}], ",", 
               RowBox[{"Last", "[", "#", "]"}]}], "}"}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"repTransform", "[", "mult", "]"}], "}"}], ",", "pow"}], 
          "]"}], "]"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[1371]:=",ExpressionUUID->"7cc61678-5b63-4018-90f0-ce19220a4d39"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". Implementation of gaFunctionOfMV[] \
\[OpenCurlyDoubleQuote]MinimalPolynomial\[CloseCurlyDoubleQuote] method using \
Sobczyk\[CloseCurlyQuote]s  generalized spectral decomposition. "
}], "Subsubsection",ExpressionUUID->"20e36559-6861-4885-a9f8-24ef8a0043de"],

Cell[TextData[{
 "This implementation directly follows invaluable article of Garret \
Sobczyk,",
 Cell[BoxData[
  ButtonBox[
   StyleBox[
    RowBox[{
    "The", " ", "Generalized", " ", "Spectral", " ", "Decomposition", " ", 
     "of", " ", "Linear", " ", "Operator"}], "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Articles", "Sobczyk_1996_Spectral-decomposition.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",
  GeneratedCell->False,
  CellAutoOverwrite->False,ExpressionUUID->
  "7998f8ea-fa92-49f6-bfee-60c6ec0513e3"],
 ".  "
}], "Text",ExpressionUUID->"e1337511-142e-45b3-9ffb-a98cb083ee6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaMinimalPolynomialPartialFractionDecompose", "[", 
   RowBox[{"minPoly_", ",", " ", "var_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"roots", "=", 
       RowBox[{"SolveValues", "[", 
        RowBox[{
         RowBox[{"minPoly", "==", "0"}], ",", "var"}], "]"}]}], ",", 
      "rootCounts", ",", "rootsWithMultiplicities", ",", 
      "rootAndMultiplicityAndPartialDenominator"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rootCounts", "=", 
      RowBox[{"Tally", "[", "roots", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootsWithMultiplicities", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"var", "-", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "&"}], "/@", 
        "rootCounts"}], ")"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootAndMultiplicityAndPartialDenominator", "=", 
      RowBox[{"Flatten", "/@", 
       RowBox[{"Thread", "[", 
        RowBox[{"List", "[", 
         RowBox[{"rootCounts", ",", 
          RowBox[{"Times", "@@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{"rootsWithMultiplicities", ",", 
               RowBox[{"{", "i", "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "rootsWithMultiplicities", "]"}]}], 
              "}"}]}], "]"}]}]}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"answer", " ", "is", " ", "of", " ", "the", " ", "form", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p_i", ",", "q_i", ",", 
           RowBox[{
            RowBox[{"q", "^", "2"}], "_i"}], ",", 
           RowBox[{
            RowBox[{"q", "^", "3"}], "_i"}], ",", "..."}], "}"}], "..."}], 
        " ", "}"}], " ", "according", " ", "to", " ", 
       RowBox[{"Sobczyk", "'"}], "s", " ", 
       "\"\<Generalized spectral decomposition of linear operator\>\""}], " ",
       "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"var", ",", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], "-", 
                  RowBox[{"(", 
                   RowBox[{"1", "+", "k"}], ")"}]}]}], "}"}]}], "]"}], "]"}], 
            "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"var", "-", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "k"}], "*", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "-", "1"}]}], "}"}]}], "]"}]}],
         "}"}], "&"}], "/@", "rootAndMultiplicityAndPartialDenominator"}]}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
