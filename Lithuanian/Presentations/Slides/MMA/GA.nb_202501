          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Replace", "[", 
              RowBox[{"#", ",", "theTogetherRules", ",", "All"}], "]"}], 
             ")"}], "&"}], ",", 
           RowBox[{"togetherHelp", "[", 
            RowBox[{"al", ",", "expr"}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
