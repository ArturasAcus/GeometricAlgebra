             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "-", "3"}], ",", 
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "-", "2"}], ",", 
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
