          "\[IndentingNewLine]", 
          RowBox[{"Cl", "[", 
           RowBox[{"1", ",", "1", ",", "0"}], "]"}], ",", " ", 
          RowBox[{"(*", " ", 
           RowBox[{"definitions", " ", "for", " ", 
