         RowBox[{"{", "ind", "}"}]}], "]"}], "&&", 
       RowBox[{"MatrixQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"gaCoordinateChart", "[", "chartName", "]"}], "[", 
          "patchName", "]"}], "[", "\"\<Metric\>\"", "]"}], "]"}]}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Non", "-", 
       RowBox[{
       "diagonal", " ", "metric", " ", "case", " ", "requires", " ", 
        "summation"}]}], ",", " ", 
      RowBox[{
      "many", " ", "indices", " ", "unclear", " ", "how", " ", "to", " ", 
       "proceed", "  ", 
       RowBox[{"WORK", "!"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaIndexUp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"bs", "[", 
         RowBox[{
          RowBox[{"mvDownUp", "[", 
           RowBox[{
            RowBox[{"{", "amd__Integer", "}"}], ",", 
            RowBox[{"{", "amu___Integer", "}"}]}], "]"}], ",", "alg_", ",", 
          "chartName_String"}], "]"}], "[", 
        RowBox[{"mvPoint", "[", "bm_", "]"}], "]"}], ",", 
       RowBox[{"{", "ind__Integer", "}"}], ",", "patchName_String"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"theMetric", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"gaCoordinateChart", "[", "chartName", "]"}], "[", 
            "patchName", "]"}], "[", "\"\<Metric\>\"", "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"don", "'"}], "t", " ", "yet", " ", "know", " ", "how", " ",
           "to", " ", "do"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Index rising for general basis element is not \
implemented.\>\"", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bs", "[", 
           RowBox[{
            RowBox[{"mvDownUp", "[", 
             RowBox[{
              RowBox[{"{", "amd", "}"}], ",", 
              RowBox[{"{", "amu", "}"}]}], "]"}], ",", "alg", ",", 
            "chartName"}], "]"}], "[", 
          RowBox[{"mvPoint", "[", "bm", "]"}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}], "/;", 
      RowBox[{"MatrixQ", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gaCoordinateChart", "[", "chartName", "]"}], "[", 
         "patchName", "]"}], "[", "\"\<Metric\>\"", "]"}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Once", " ", "we", " ", "know", " ", "how", " ", "to", " ", "operate", 
       " ", "on", " ", "basis", " ", "element"}], ",", " ", 
      RowBox[{"extend", " ", "this", " ", "to", " ", "any", " ", 
       RowBox[{"expression", ".", " ", "Similarly"}], " ", "as", " ", "in", 
       " ", "flat", " ", "space", " ", "rise", " ", "all", " ", "down", " ", 
       "indices", " ", "by", " ", "default"}]}], " ", "*)"}], " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaIndexUp", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"orthogonalBasisElements", "=", 
          RowBox[{"Union", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"{", "expr", "}"}], ",", 
             RowBox[{"_bs", "[", "_", "]"}], ",", "Infinity"}], "]"}], 
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"expr", "/.", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "->", 
              RowBox[{"gaIndexUp", "[", 
               RowBox[{"#", ",", 
                RowBox[{
                 RowBox[{"Head", "[", "#", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
                "gaRunningPatch"}], "]"}]}], ")"}], "&"}], "/@", 
           "orthogonalBasisElements"}], ")"}]}]}], "\[IndentingNewLine]", 
       "]"}], "/;", 
      RowBox[{"Not", "[", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"_bs", "[", "_", "]"}]}], "]"}], "]"}]}]}], ";", " ", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "If", " ", "only", " ", "specific", " ", "indices", " ", "by", " ", 
       "default", " ", "needs", " ", "to", " ", "be", " ", "rised"}], ",", 
      " ", 
      RowBox[{"specify", " ", "them", " ", "in", " ", "the", " ", "list"}]}], 
     "*)"}], " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaIndexUp", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"{", 
        RowBox[{"indicesToRise___Integer", "?", "Positive"}], "}"}], ",", 
       RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"orthogonalBasisElements", "=", 
          RowBox[{"Union", "[", 
           RowBox[{"Cases", "[", 
            RowBox[{
             RowBox[{"{", "expr", "}"}], ",", 
             RowBox[{"_bs", "[", "_", "]"}], ",", "Infinity"}], "]"}], 
           "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"expr", "/.", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"#", "->", 
              RowBox[{"gaIndexUp", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", "indicesToRise", "}"}], ",", "gaRunningPatch"}], 
               "]"}]}], ")"}], "&"}], "/@", "orthogonalBasisElements"}], 
          ")"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
      RowBox[{"Not", "[", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"expr", ",", 
         RowBox[{"_bs", "[", "_", "]"}]}], "]"}], "]"}]}]}]}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellLabel->
  "In[1471]:=",ExpressionUUID->"75526575-bc17-4735-8695-e71c719761c7"],

Cell[TextData[{
 "Construct full reciprocal basis from reciprocal vectors for given \
coordinate system. Only general algorithm is needed since ",
 StyleBox["gaPrimaryVectors[ ]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["gaReciprocalVectors[ ]",
  FontWeight->"Bold"],
 " are defined by ",
 StyleBox["gaDefineCoordinateChart[ ]",
  FontWeight->"Bold"],
 ".",
 "\nWe often need reciprocal vectors, therefore make a special command. The \
output of it will be stored in ",
 StyleBox["gaReciprocalVectorRules[gaRunningCoordinateChart]",
  FontWeight->"Bold"],
 " container. The code below is very similar to similar function for algebra. \
At the moment we keep them separate, since computation of a surface probably \
will start to differ and will need modification. "
}], "Text",ExpressionUUID->"bd9e71e9-ce31-4ce9-a817-cef66ffcd490"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaDefineReciprocalVectors", "::", "NotABase"}], "=", 
   "\"\<There are not enought linearly independent vectors in `1` in order to \
compute reciprocal basis for `2`.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gaDefineReciprocalVectors", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<ZeroTolerance\>\"", "->", 
      RowBox[{"10.", "^", 
       RowBox[{"(", 
        RowBox[{"-", "10"}], ")"}]}]}], ",", 
     RowBox[{"Quiet", "->", "True"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{
      "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaDefineReciprocalVectors", "[", 
      RowBox[{"vectorBase_List", ",", 
       RowBox[{"op", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"theOption", ",", 
          RowBox[{"theAssociationFunction", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"vectorBase", ",", "_Association"}], "]"}], ",", 
             "Identity", ",", "gaAssociationTogether"}], "]"}]}], ",", 
          RowBox[{"theResultFunction", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"vectorBase", ",", "_Association"}], "]"}], ",", 
             "Identity", ",", "gaPlainRepresentation"}], "]"}]}], ",", 
          RowBox[{"pseudoscalar", "=", 
           RowBox[{"gaPE", "[", 
            RowBox[{"OuterProduct", "@@", "vectorBase"}], "]"}]}], ",", 
          "pseudoscalarMagnitude", ",", "inversePseudoscalar", ",", 
          "dimensionOfVectorSpace", ",", "theChart"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"gaSetNamedOptionValue", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "gaDefineReciprocalVectors", ",", "#", ",", "theOption"}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{
              "gaOptionCheck", "[", "testOptionDefineReciprocalVectors", 
               "]"}], "[", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
                 "}"}]}], ")"}], "]"}], ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"Flatten", "[", 
            RowBox[{"First", "/@", 
             RowBox[{"{", "op", "}"}]}], "]"}], ")"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
            "theOption"}], ",", 
           RowBox[{
            RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
            RowBox[{"(", 
             RowBox[{"Quiet", "/.", 
              RowBox[{"Options", "[", "gaDefineReciprocalVectors", "]"}]}], 
             ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"theOption", "[", "\"\<ZeroTolerance\>\"", "]"}], "]"}], 
            "===", "theOption"}], ",", 
           RowBox[{
            RowBox[{"theOption", "[", "\"\<ZeroTolerance\>\"", "]"}], "=", 
            RowBox[{"(", 
             RowBox[{"\"\<ZeroTolerance\>\"", "/.", 
              RowBox[{"Options", "[", "gaDefineReciprocalVectors", "]"}]}], 
             ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "extract", " ", "dimension", " ", "and", " ", "chart", " ", "name", 
           " ", "from", " ", "given", " ", "vectors"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dimensionOfVectorSpace", ",", "theChart"}], "}"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"#", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"bs", "[", "__", "]"}], "[", 
                   RowBox[{"mvPoint", "[", "varlist_", "]"}], "]"}], ":>", 
                  "varlist"}], "}"}]}], "]"}], ",", 
              RowBox[{"#", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"bs", "[", 
                   RowBox[{"_", ",", "_", ",", "chartName_String"}], "]"}], 
                  "[", "_", "]"}], ":>", "chartName"}], "}"}]}]}], "}"}], 
            "&"}], "[", 
           RowBox[{"FirstCase", "[", 
            RowBox[{"vectorBase", ",", 
             RowBox[{
              RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}], ",", "0", ",", 
             "Infinity"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "check", " ", "if", " ", "we", " ", "have", " ", "enough", " ", 
           "vectors"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"dimensionOfVectorSpace", "=!=", 
            RowBox[{"Length", "[", "vectorBase", "]"}]}], ",", 
           RowBox[{
            RowBox[{"Message", "[", 
             RowBox[{
              RowBox[{"gaDefineReciprocalVectors", "::", "NotABase"}], ",", 
              "vectorBase", ",", "theChart"}], "]"}], ";", 
            RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "compute", " ", "the", " ", "pseudoscalar", " ", "and", " ", "the", 
           " ", "inverse", " ", "pseudoscalar"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{"pseudoscalarMagnitude", "=", 
          RowBox[{"theAssociationFunction", "[", 
           RowBox[{"gaPE", "[", 
            RowBox[{"pseudoscalar", "\[GeometricProduct]", 
             RowBox[{"gaReverse", "[", "pseudoscalar", "]"}]}], "]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"printDetails", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Pseudoscalar magnitude:\>\"", ",", 
              "pseudoscalarMagnitude"}], "}"}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Catch", "[", 
          RowBox[{"allZeroTest", "[", 
           RowBox[{
            RowBox[{"{", "pseudoscalarMagnitude", "}"}], ",", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"OuterProduct", "@@", "vectorBase"}], ")"}], 
               "\[GeometricProduct]", 
               RowBox[{"gaReverse", "[", 
                RowBox[{"OuterProduct", "@@", "vectorBase"}], "]"}]}], "]"}], 
             "]"}], ",", "theResultFunction", ",", 
            RowBox[{"theOption", "[", "\"\<ZeroTolerance\>\"", "]"}], ",", 
            "\"\<gaDefineReciprocalVectors[ ]\>\""}], "]"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"inversePseudoscalar", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"-", "1"}], ")"}], "^", 
              RowBox[{"(", 
               RowBox[{"dimensionOfVectorSpace", "*", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"dimensionOfVectorSpace", "-", "1"}], ")"}], "/", 
                 "2"}]}], ")"}]}], "/", "pseudoscalarMagnitude"}], ")"}], 
           "\[GeometricProduct]", "pseudoscalar"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"printDetails", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\"\<Inverse pseudoscalar:\>\"", ",", "inversePseudoscalar"}], 
             "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Outer", " ", "multiply", " ", "all", " ", "combinations", " ", 
           "of", " ", "basis", " ", "vectors"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"gaReciprocalVectorRules", "[", "theChart", "]"}], "=", 
          RowBox[{"Thread", "[", 
           RowBox[{"Rule", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"gaReciprocal", "/@", "vectorBase"}], ")"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"gaPE", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}]}], "\[GeometricProduct]", 
                   RowBox[{"(", 
                    RowBox[{"OuterProduct", "@@", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{"vectorBase", ",", 
                    RowBox[{"i", "->", "Nothing"}]}], "]"}]}], ")"}]}], ")"}],
                  "\[LeftContract]", "inversePseudoscalar"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "dimensionOfVectorSpace"}], "}"}]}], 
              "]"}]}], "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
      RowBox[{"!", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"vectorBase", ",", 
         RowBox[{
          RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}]}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[1473]:=",ExpressionUUID->"4ddb953b-a859-471d-a98f-13756b301e03"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{
      "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaDefineReciprocalBasis", "[", 
      RowBox[{"chartBase_List", ",", 
       RowBox[{"op", ":", 
        RowBox[{"OptionsPattern", "[", 
         RowBox[{"{", "gaDefineReciprocalVectors", "}"}], "]"}]}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"vectors", "=", 
           RowBox[{"DeleteCases", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"gaGetMV", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"{", "1", "}"}]}], "]"}], "&"}], "/@", "chartBase"}],
              ",", "0"}], "]"}]}], ",", 
          RowBox[{"quiet", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Quiet", "/.", 
               RowBox[{"FilterRules", "[", 
                RowBox[{
                 RowBox[{"{", "op", "}"}], ",", 
                 RowBox[{"Options", "[", "gaDefineReciprocalVectors", "]"}]}],
                 "]"}]}], ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{"Quiet", "->", "False"}], "}"}]}], ")"}]}], ",", 
          "reciprocVec", ",", "fullReciprBasis", ",", "formalElements", ",", 
          "dimensionOfVectorSpace", ",", "theChart"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "extract", " ", "dimension", " ", "and", " ", "chart", " ", "name", 
          " ", "from", " ", "given", " ", "vectors"}], " ", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"dimensionOfVectorSpace", ",", "theChart"}], "}"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"#", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"bs", "[", "__", "]"}], "[", 
                   RowBox[{"mvPoint", "[", "varlist_", "]"}], "]"}], ":>", 
                  "varlist"}], "}"}]}], "]"}], ",", 
              RowBox[{"#", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"bs", "[", 
                   RowBox[{"_", ",", "_", ",", "chartName_String"}], "]"}], 
                  "[", "_", "]"}], ":>", "chartName"}], "}"}]}]}], "}"}], 
            "&"}], "[", 
           RowBox[{"FirstCase", "[", 
            RowBox[{"chartBase", ",", 
             RowBox[{
              RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}], ",", "0", ",", 
             "Infinity"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"printDetails", "[", 
          RowBox[{"quiet", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
             "\"\<General algorithm for full reciprocal basis for \>\"", ",", 
              "theChart"}], "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "check", " ", "if", " ", "we", " ", "have", " ", "enough", " ", 
           "provided", " ", "vectors", " ", "to", " ", "continue"}], "*)"}], 
         " ", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", "vectors", "]"}], "===", 
             "dimensionOfVectorSpace"}], ")"}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "compute", " ", "reciprocal", " ", "vectors", " ", "first"}], " ",
             "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"printDetails", "[", 
             RowBox[{"quiet", ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Info. Attempt to compute reciprocal vectors from \
provided vectors\>\"", ",", "vectors"}], "}"}], "}"}]}], "]"}], ";", 
            RowBox[{"reciprocVec", "=", 
             RowBox[{"Last", "/@", 
              RowBox[{"gaDefineReciprocalVectors", "[", 
               RowBox[{"vectors", ",", 
                RowBox[{"Sequence", "@@", 
                 RowBox[{"FilterRules", "[", 
                  RowBox[{
                   RowBox[{"{", "op", "}"}], ",", 
                   RowBox[{
                   "Options", "[", "gaDefineReciprocalVectors", "]"}]}], 
                  "]"}]}]}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", 
                RowBox[{"gaReciprocalVectorRules", "[", "theChart", "]"}], 
                "]"}], "===", "List"}], ",", 
              RowBox[{
               RowBox[{"reciprocVec", "=", 
                RowBox[{"Last", "/@", 
                 RowBox[{
                 "gaReciprocalVectorRules", "[", "theChart", "]"}]}]}], ";", 
               RowBox[{"Message", "[", 
                RowBox[{
                 RowBox[{"gaDefineReciprocalVectors", "::", "NotABase"}], ",",
                  "vectors", ",", "theChart"}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"printDetails", "[", 
                RowBox[{"False", ",", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{
                   "\"\<Info. Will ignore provided vectors and use already \
computed reciprocal vectors. Check if this is what you want.\>\"", ",", 
                    "reciprocVec"}], "}"}], "}"}]}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"Message", "[", 
                RowBox[{
                 RowBox[{"gaDefineReciprocalVectors", "::", "NotABase"}], ",",
                  "vectors", ",", "theChart"}], "]"}], ";", 
               RowBox[{"Abort", "[", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
            ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "compute", " ", "full", " ", "reciprocal", " ", "basis", " ", 
           RowBox[{"(", 
            RowBox[{"expressed", " ", "in", " ", "index", " ", "down", " ", 
             RowBox[{"elements", "!"}]}], ")"}], " ", "from", " ", 
           "reciprocal", " ", "vectors"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{"fullReciprBasis", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"gaPE", "[", 
             RowBox[{"gaReverse", "[", 
              RowBox[{"OuterProduct", "[", "##", "]"}], "]"}], "]"}], "&"}], "@@@", 
           RowBox[{"Rest", "[", 
            RowBox[{"Subsets", "[", "reciprocVec", "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"output", " ", "rules", " ", 
             RowBox[{"gaReciprocal", "[", "downInd", "]"}]}], "->", 
            "downInd"}], ",", " ", 
           RowBox[{
           "which", " ", "indicates", " ", "which", " ", "reciprocal", " ", 
            "element", " ", "corresponds", " ", "to", " ", "the", " ", 
            "computed", " ", "element"}]}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "chartBase", "]"}], "===", 
            RowBox[{"2", "^", 
             RowBox[{"gaDimensionOfVectorSpace", "[", "theChart", "]"}]}]}], 
           ",", "\[IndentingNewLine]", 
           RowBox[{"formalElements", "=", 
            RowBox[{"DeleteCases", "[", 
             RowBox[{"chartBase", ",", "1"}], "]"}]}], ",", 
           RowBox[{"formalElements", "=", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"OuterProduct", "[", "##", "]"}], "&"}], "@@@", 
              RowBox[{"Rest", "[", 
               RowBox[{"Subsets", "[", "vectors", "]"}], "]"}]}], ")"}]}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "\"\<InvDeg[Lex]\>\"", ",", "\"\<InvDeg[InvLex]\>\"", ",", 
               "\"\<InvDeg[RevLex]\>\"", ",", "\"\<InvDeg[InvRevLex]\>\"", 
               ",", "\"\<RevLex\>\"", ",", "\"\<InvRevLex\>\""}], "}"}], ",", 
             "gaRunningOrdering"}], "]"}], ",", 
           RowBox[{
            RowBox[{"gaReciprocalBasisRules", "[", "theChart", "]"}], "=", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{"Rule", "[", 
                RowBox[{
                 RowBox[{"gaReciprocal", "/@", "formalElements"}], ",", 
                 "fullReciprBasis"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"gaReciprocal", "[", "1", "]"}], "->", 
               RowBox[{
                RowBox[{"bs", "[", 
                 RowBox[{
                  RowBox[{"mvDownUp", "[", 
                   RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "gaRunningAlgebra", ",",
                   "gaRunningCoordinateChart"}], "]"}], "[", 
                RowBox[{"mvPoint", "[", 
                 RowBox[{
                 "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", 
                  "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"gaReciprocalBasisRules", "[", "theChart", "]"}], "=", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{"Rule", "[", 
                RowBox[{
                 RowBox[{"gaReciprocal", "/@", "formalElements"}], ",", 
                 "fullReciprBasis"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"gaReciprocal", "[", "1", "]"}], "->", 
               RowBox[{
                RowBox[{"bs", "[", 
                 RowBox[{
                  RowBox[{"mvDownUp", "[", 
                   RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "gaRunningAlgebra", ",",
                   "gaRunningCoordinateChart"}], "]"}], "[", 
                RowBox[{"mvPoint", "[", 
                 RowBox[{
                 "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", 
                  "]"}], "]"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
          "]"}]}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], "/;", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"FreeQ", "[", 
         RowBox[{"chartBase", ",", 
          RowBox[{
           RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}]}], "]"}]}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"chartBase", ",", 
         RowBox[{"mvDownUp", "[", 
          RowBox[{"_", ",", 
           RowBox[{"{", "__", "}"}]}], "]"}]}], "]"}]}]}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
