              RowBox[{"\"\<Optimize\>\"", "->", "True"}], "}"}]}]}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"theOption", "[", "\"\<Check\>\"", "]"}], "]"}], "===", 
            "theOption"}], ",", 
           RowBox[{
            RowBox[{"theOption", "[", "\"\<Check\>\"", "]"}], "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<Check\>\"", "/.", 
               RowBox[{"Options", "[", "gaAssociationRepresentation", "]"}]}],
               ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{"\"\<Check\>\"", "->", "True"}], "}"}]}]}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"theOption", "[", "\"\<FieldToAssociation\>\"", "]"}], 
             "]"}], "===", "theOption"}], ",", 
           RowBox[{
            RowBox[{"theOption", "[", "\"\<FieldToAssociation\>\"", "]"}], 
            "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<FieldToAssociation\>\"", "/.", 
               RowBox[{"Options", "[", "gaAssociationRepresentation", "]"}]}],
               ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{
              "\"\<FieldToAssociation\>\"", "->", "\"\<Automatic\>\""}], 
              "}"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{
             "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}],
              "]"}], "===", "theOption"}], ",", 
           RowBox[{
            RowBox[{
            "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}], 
            "=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<gaNonCommutativeMonomialOrder\>\"", "/.", 
               RowBox[{"Options", "[", "gaAssociationRepresentation", "]"}]}],
               ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{
              "\"\<gaNonCommutativeMonomialOrder\>\"", "->", 
               "\"\<InvDeg[Lex]\>\""}], "}"}]}]}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Optimize\>\"", "]"}], ",", 
           RowBox[{"optimizeFunction", "=", "gaAssociationOptimize"}], ",", 
           RowBox[{"optimizeFunction", "=", "Identity"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "specify", " ", "Automatic", " ", "behaviour", " ", "for", " ", 
           "coefficient", " ", "field"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{"theOption", "[", "\"\<FieldToAssociation\>\"", "]"}], 
             "]"}], "===", "\"\<Automatic\>\""}], ",", "\[IndentingNewLine]", 
           
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"expr", ",", "gaNonCommutativeFieldElementPattern"}], 
              "]"}], ",", 
             RowBox[{"autoField", "=", "False"}], ",", 
             RowBox[{"autoField", "=", "True"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"autoField", "=", 
            RowBox[{"theOption", "[", "\"\<FieldToAssociation\>\"", "]"}]}]}],
           "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "different", " ", "check", " ", "functions", " ", "when", " ", 
           "field", " ", "is", " ", "in", " ", "Association", " ", 
           "representation", "  ", "and", " ", "when", " ", "in", " ", 
           "plain", " ", "representation"}], " ", "*)"}], " ", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Check\>\"", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{"autoField", ",", 
             RowBox[{"checkFunction", "=", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"checkAssociationRepresentationAssociationField", "[", 
                 RowBox[{"#", ",", "al"}], "]"}], "&"}], ")"}]}], ",", 
             RowBox[{"checkFunction", "=", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"checkAssociationRepresentationPlainField", "[", 
                 RowBox[{"#", ",", "al"}], "]"}], "&"}], ")"}]}]}], "]"}], 
           ",", 
           RowBox[{"checkFunction", "=", "Identity"}]}], "]"}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "convert", " ", "algebra", " ", "elements", " ", "to", " ", 
           "Association"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"gaFieldElementQ", "[", "expr", "]"}], ",", 
           RowBox[{"(*", " ", 
            RowBox[{"fast", " ", "case"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{"answer", "=", 
            RowBox[{
             RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}], "[", 
             
             RowBox[{
              RowBox[{"Association", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{
                  RowBox[{"{", "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], "\[Rule]", "expr"}], "]"}], 
              ",", "al"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"general", " ", "case"}], " ", "*)"}], " ", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{"expr", ",", "_Association"}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
               "if", " ", "expression", " ", "is", " ", "not", " ", "in", " ",
                 "Association", " ", "form"}], ",", " ", 
               RowBox[{"then", " ", "convert"}]}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"answer", "=", 
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"theToAsRules", "=", "toAssociationRulesAlgebra"}], 
                 "}"}], ",", "\[IndentingNewLine]", 
                RowBox[{"checkFunction", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"optimizeFunction", "[", "\[IndentingNewLine]", 
                   RowBox[{"FixedPoint", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Replace", "[", 
                    RowBox[{"#", ",", "theToAsRules", ",", "All"}], "]"}], 
                    ")"}], "&"}], ",", 
                    RowBox[{"toAssociationHelp", "[", 
                    RowBox[{"al", ",", "expr"}], "]"}]}], "]"}], 
                   "\[IndentingNewLine]", "]"}], "/.", 
                  RowBox[{"associationKeySortRules", "[", 
                   RowBox[{
                   "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", 
                    "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
               "\[IndentingNewLine]", "]"}]}], ",", 
             RowBox[{"(*", " ", 
              RowBox[{"end", " ", "With"}], " ", "*)"}], " ", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
               "if", " ", "expression", " ", "is", " ", "already", " ", "in", 
                " ", "Association", " ", "form"}], ",", " ", 
               RowBox[{
               "only", " ", "apply", " ", "proper", " ", "ordering", " ", 
                "option"}]}], " ", "*)"}], "\[IndentingNewLine]", 
             RowBox[{"answer", "=", 
              RowBox[{"expr", "/.", 
               RowBox[{"associationKeySortRules", "[", 
                RowBox[{
                "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", 
                 "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
          "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"convert", " ", "field", " ", "elemens", " ", "to", " ", 
           RowBox[{"Association", ":", " ", 
            RowBox[{
            "map", " ", "fieldToAssociationFunction", " ", "at", " ", "each", 
             " ", "value"}]}]}], " ", "*)"}], "  ", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"autoField", ",", "\[IndentingNewLine]", 
           RowBox[{"answer", "/.", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"bs", "=", 
                RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"bs", "[", 
                 RowBox[{"as_Association", ",", "other__"}], "]"}], ":>", 
                RowBox[{"bs", "[", 
                 RowBox[{
                  RowBox[{"MapAt", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Map", "[", 
                    RowBox[{
                    RowBox[{"ReplaceAll", "[", 
                    RowBox[{"associationKeySortRules", "[", 
                    RowBox[{
                    "theOption", "[", "\"\<gaNonCommutativeMonomialOrder\>\"",
                     "]"}], "]"}], "]"}], ",", "#"}], "]"}], "&"}], ",", 
                    RowBox[{"fieldToAssociation", "[", "as", "]"}], ",", 
                    RowBox[{"{", "1", "}"}]}], "]"}], ",", "other"}], "]"}]}],
                "}"}]}], "]"}]}], ",", "\[IndentingNewLine]", "answer"}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
      "\[IndentingNewLine]", "\"\<UnfinishedAssociation\>\""}], "]"}], "/;", 
    RowBox[{"FreeQ", "[", 
     RowBox[{
      RowBox[{"{", "expr", "}"}], ",", "MV", ",", 
      RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[427]:=",ExpressionUUID->"2d461a89-f9d4-4576-92a2-2f5b22a2eeae"],

Cell["\<\
After conversion we can use some optimization rules and perform check if \
conversion was successful, which  are defined below.\
\>", "Text",ExpressionUUID->"e4d7d376-5d4e-4fe8-ade6-3ec59428e5ac"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". Association form optimization, check and  cleaning.   \
gaAssociationTogether[ ] function"
}], "Subsubsection",ExpressionUUID->"e895f3b7-b6b8-4f2e-b64d-fe69fb3b966a"],

Cell[TextData[{
 "After conversion we can make some optimization, for example, rewrite \
product of scalar Associations as a single Association of product of scalars. \
Optimization and cleaning functions are deliberately not exported, whereas ",
 StyleBox["gaAssociationTogether[ ]",
  FontWeight->"Bold"],
 " is exported (might be useful in some cases)."
}], "Text",ExpressionUUID->"eaf3344f-6c9d-48b7-965d-17c58d5e72e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaAssociationOptimize", "[", "expr_", "]"}], ":=", 
  RowBox[{"FixedPoint", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Replace", "[", 
       RowBox[{"#", ",", "optimizationRules", ",", "All"}], "]"}], ")"}], 
     "&"}], ",", "expr"}], "]"}]}]], "Input",
 CellLabel->
  "In[428]:=",ExpressionUUID->"3d26fe63-2757-4950-bf94-5a3eb9849450"],

Cell[BoxData[
 RowBox[{
  RowBox[{"optimizationRules", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "products", " ", "of", " ", "field", " ", "Associations", " ", "into", 
        " ", "single", " ", "Association", " ", "of", " ", "product", " ", 
        "of", " ", "field", " ", "elements"}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"h", ":", 
            RowBox[{"(", 
             RowBox[{
             "GeometricProduct", "|", "OuterProduct", "|", "RightContract", 
              "|", "LeftContract"}], ")"}]}], ")"}], "[", 
          RowBox[{
           RowBox[{"arg", ":", 
            RowBox[{"(", 
             RowBox[{"Repeated", "[", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{
                 RowBox[{"Association", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], "->", "_"}], "]"}], ",", 
                 "alg__"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "Infinity"}], "}"}]}], "]"}], ")"}]}], ",", 
           "other___"}], "]"}], "]"}], ":>", 
        RowBox[{"h", "[", 
         RowBox[{
          RowBox[{"bs", "[", 
           RowBox[{
            RowBox[{"Merge", "[", 
             RowBox[{
              RowBox[{"First", "/@", 
               RowBox[{"{", "arg", "}"}]}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"GeometricProduct", "@@", "#"}], ")"}], "&"}]}], 
             "]"}], ",", "alg"}], "]"}], ",", "other"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "multiply", " ", "MV", " ", "Association", " ", "by", " ", "the", 
          " ", "same", " ", "field", " ", "Association", " ", "value"}], ",", 
         "  ", 
         RowBox[{"both", " ", "sides"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"h", ":", 
            RowBox[{"(", 
             RowBox[{
             "GeometricProduct", "|", "OuterProduct", "|", "RightContract", 
              "|", "LeftContract"}], ")"}]}], ")"}], "[", 
          RowBox[{"other1___", ",", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{
                 RowBox[{"{", "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}], "->", "field_"}], "]"}], ",", 
             "__"}], "]"}], ",", 
           RowBox[{"bs", "[", 
            RowBox[{"assocNonScalar_Association", ",", "alg__"}], "]"}], ",", 
           "other2___"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"other1", ",", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Association", "@@", 
              RowBox[{"(", 
               RowBox[{"KeyValueMap", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"#1", "->", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"field", ",", "#2"}], "]"}]}], ")"}], "&"}], ",", 
                 "assocNonScalar"}], "]"}], ")"}]}], ",", "alg"}], "]"}], ",",
            "other2"}], "]"}], "/;", 
         RowBox[{"gaFieldElementQ", "[", 
          RowBox[{"{", "field", "}"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
       
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"h", ":", 
            RowBox[{"(", 
             RowBox[{
             "GeometricProduct", "|", "OuterProduct", "|", "RightContract", 
              "|", "LeftContract"}], ")"}]}], ")"}], "[", 
          RowBox[{"other1___", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"assocNonScalar_Association", ",", "alg__"}], "]"}], ",", 
           
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{
                 RowBox[{"{", "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}], "->", "field_"}], "]"}], ",", 
             "__"}], "]"}], ",", "other2___"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"h", "[", 
          RowBox[{"other1", ",", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Association", "@@", 
              RowBox[{"(", 
               RowBox[{"KeyValueMap", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"#1", "->", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"#2", ",", "field"}], "]"}]}], ")"}], "&"}], ",", 
                 "assocNonScalar"}], "]"}], ")"}]}], ",", "alg"}], "]"}], ",",
            "other2"}], "]"}], "/;", 
         RowBox[{"gaFieldElementQ", "[", 
          RowBox[{"{", "field", "}"}], "]"}]}]}]}], "\[IndentingNewLine]", 
      "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[429]:=",ExpressionUUID->"2d370cff-8362-4902-8409-4b5fa9172957"],

Cell["\<\
In the end we make an attempt if conversion was successful by testing if some \
invalid parts are not present. If we catch them, it means that conversion \
wasn\[CloseCurlyQuote]t completed.  Define check rules. Note the rules are \
not optimized and sometimes can be very slow.  Hope to rewrite them in the \
form as provided by noSumWithFieldElementQ[]\
\>", "Text",ExpressionUUID->"1eb8673d-2a03-4b40-af60-91c261e60f56"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"no", " ", "Times", " ", "with", " ", "Association"}], " ", 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"noTimesBSAssociationQ", "[", "expr_", "]"}], ":=", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"HoldPattern", "[", 
         RowBox[{"Times", "[", 
          RowBox[{"_", ",", "___", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"_Association", ",", "__"}], "]"}], ",", "___"}], "]"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "no", " ", "noncommutative", " ", "product", " ", "with", " ", 
       "Association"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"noFieldProductWithAssociationQ", "[", "expr_", "]"}], ":=", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"HoldPattern", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
           "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
            "RightContract", "|", "LeftContract"}], ")"}], "[", 
          RowBox[{
           RowBox[{"_", "?", "gaFieldElementQ"}], ",", "___", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"_Association", ",", "__"}], "]"}], ",", "___"}], "]"}], 
         "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Only", " ", "geometric", " ", "product", " ", "can", " ", "appear", 
       " ", "in", " ", "product", " ", "of", " ", "noncommutative", " ", 
       "field", " ", "elements"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
      "noFieldTimesNonCommutativeProductExceptGPQ", "[", "expr_", "]"}], ":=",
       "\[IndentingNewLine]", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"_Times", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"(", 
                RowBox[{
                "_OuterProduct", "|", "_InnerProduct", "|", "_LeftContract", 
                 "|", "_RightContract"}], ")"}], ",", 
               RowBox[{"{", "1", "}"}], ",", 
               RowBox[{"Heads", "->", "False"}]}], "]"}], "]"}], "&&", 
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"_", "?", "gaFieldElementQ"}], ",", 
               RowBox[{"{", "1", "}"}], ",", 
               RowBox[{"Heads", "->", "False"}]}], "]"}], "]"}]}], "&"}], 
          ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"older", " ", "version"}], ",", " ", 
       RowBox[{
       "on", " ", "some", " ", "input", " ", "very", " ", "very", " ", 
        "slow"}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "expr", "}"}], ",", 
         RowBox[{"HoldPattern", "[", 
          RowBox[{"Times", "[", 
           RowBox[{"___", ",", 
            RowBox[{"_", "?", "gaFieldElementQ"}], ",", "___", ",", 
            RowBox[{"(", 
             RowBox[{
             "_OuterProduct", "|", "_InnerProduct", "|", "_LeftContract", "|",
               "_RightContract"}], ")"}], ",", "___"}], "]"}], "]"}]}], "]"}],
        ";"}], "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Geometric", " ", "product", " ", "of", " ", "basis", " ", "elements", 
        " ", "is", " ", "forbidden"}], ",", " ", 
       RowBox[{
       "for", " ", "field", " ", "elements", " ", "it", " ", "can", " ", 
        "appear"}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"noFieldTimesGeometricProductWithAlgebraElementsQ", "[", 
       RowBox[{"expr_", ",", "al_Cl"}], "]"}], ":=", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"HoldPattern", "[", 
         RowBox[{"Times", "[", 
          RowBox[{"___", ",", 
           RowBox[{"_", "?", "gaFieldElementQ"}], ",", "___", ",", 
           RowBox[{"GeometricProduct", "[", 
            RowBox[{"__", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"FreeQ", "[", 
                 RowBox[{
                  RowBox[{"{", "##", "}"}], ",", 
                  RowBox[{"gaBasisElementPattern", "[", "al", "]"}]}], 
                 "]"}]}], "&"}], ")"}]}], "]"}], ",", "___"}], "]"}], "]"}]}],
        "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"no", " ", "sum", " ", "with", " ", "anything", " ", "else"}], 
      " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"noSumWithFieldElementQ", "[", "expr_", "]"}], ":=", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "expr", "}"}], ",", 
        RowBox[{"_Plus", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"(", 
                RowBox[{
                "_GeometricProduct", "|", "_OuterProduct", "|", 
                 "_InnerProduct", "|", "_LeftContract", "|", 
                 "_RightContract"}], ")"}], ",", 
               RowBox[{"{", "1", "}"}], ",", 
               RowBox[{"Heads", "->", "False"}]}], "]"}], "]"}], "&&", 
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"_", "?", "gaFieldElementQ"}], ",", 
