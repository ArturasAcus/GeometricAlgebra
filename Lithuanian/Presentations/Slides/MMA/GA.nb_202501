Cell[TextData[{
 StyleBox["gaPlainRepresentation[ ]",
  FontWeight->"Bold"],
 " is simple and straightforward.  The implementation uses Times property, \
which  multiply two lists element by element {a,b}*{1,2}->{a+2b}, so you can\
\[CloseCurlyQuote]t replace it by general head. "
}], "Text",ExpressionUUID->"a044b1e6-deea-4fd6-99f9-2f10e26ab3cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"toPlainRepresentationHelp", "[", "expr_", "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"expr", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{"arg_Association", ",", "other__"}], "]"}], 
           "\[RuleDelayed]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Plus", "@@", 
              RowBox[{"(", 
               RowBox[{"Times", "@@", 
                RowBox[{"(", 
                 RowBox[{"MapAt", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"x", ",", 
                    RowBox[{"bs", "[", 
                    RowBox[{"x", ",", "other"}], "]"}]}], "]"}], "/@", "#"}], 
                    "&"}], ",", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "&"}], 
                    "[", 
                    RowBox[{"Normal", "[", "arg", "]"}], "]"}], ")"}], ",", 
                   "1"}], "]"}], ")"}]}], ")"}]}], ")"}], "/;", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"arg", ",", "_GeometricProduct"}], "]"}]}]}], "}"}]}], 
        ")"}], "/;", 
       RowBox[{"(", 
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"expr", ",", "_Association"}], "]"}]}], ")"}]}]}]}], 
    "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"main", " ", "action"}], ",", " ", 
    RowBox[{"if", " ", "values", " ", "contains", " ", "Association"}], ",", 
    " ", 
    RowBox[{"we", " ", "apply", " ", "the", " ", "rules", " ", "twice"}]}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaPlainRepresentation", "[", "expr_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tempAnswer", "=", 
        RowBox[{"toPlainRepresentationHelp", "[", 
         RowBox[{"gaFieldExpand", "[", "expr", "]"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"tempAnswer", ",", "_Association"}], "]"}], ",", 
        "tempAnswer", ",", 
        RowBox[{"toPlainRepresentationHelp", "[", "tempAnswer", "]"}]}], 
       "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"trivial", " ", "action"}], " ", "*)"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaPlainRepresentation", "[", "expr_", "]"}], ":=", 
   RowBox[{"expr", "/;", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"expr", ",", "_Association"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellLabel->
  "In[443]:=",ExpressionUUID->"f6e98364-1add-4c3f-9b33-83a2f11906e2"]
}, Closed]]
