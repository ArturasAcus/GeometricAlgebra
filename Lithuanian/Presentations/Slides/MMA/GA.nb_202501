               RowBox[{"denom", "=", 
                RowBox[{"gaGetMV", "[", 
                 RowBox[{"denom", ",", 
                  RowBox[{"{", "0", "}"}]}], "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"allZeroTest", "[", 
              RowBox[{
               RowBox[{"{", "denom", "}"}], ",", 
