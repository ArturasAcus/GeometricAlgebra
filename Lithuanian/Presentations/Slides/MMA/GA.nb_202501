Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"gaGetMV", "[", 
     RowBox[{
      RowBox[{"{", "expr___", "}"}], ",", "what_"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"gaGetMV", "[", 
       RowBox[{"#", ",", "what"}], "]"}], "&"}], "/@", 
     RowBox[{"{", "expr", "}"}]}], "/;", 
    RowBox[{"FreeQ", "[", 
     RowBox[{
      RowBox[{"{", "expr", "}"}], ",", "gaGetMV", ",", 
