             RowBox[{"{", 
              RowBox[{"gaNormDeterminant", ",", "#", ",", "theOption"}], 
              "}"}], ",", 
             RowBox[{
              RowBox[{
              "gaOptionCheck", "[", "testOptionNormDeterminant", "]"}], "[", 
