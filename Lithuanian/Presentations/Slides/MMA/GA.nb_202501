Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"working", " ", "with", " ", "grades"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{
         RowBox[{"bs", "[", 
          RowBox[{"arg_Association", ",", "other__"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n__Integer", "?", "NonNegative"}], "}"}]}], "]"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"resTest", "=", 
          RowBox[{"KeySelect", "[", 
           RowBox[{"arg", ",", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", "n", "}"}], ",", 
               RowBox[{"(", 
                RowBox[{"Length", "[", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{"List", "@@", "#"}], "]"}], "]"}], ")"}]}], "]"}], 
             "&"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"resTest", "===", 
           RowBox[{"Association", "[", "]"}]}], ",", "0", ",", 
          RowBox[{"bs", "[", 
           RowBox[{"resTest", ",", "other"}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "fast", " ", "rule", " ", "to", " ", "multiply", " ", "Association", 
       " ", "representation", " ", "by", " ", "field", " ", "element", " ", 
       "in", " ", 
       RowBox[{"gaGetMV", "[", "]"}]}], " ", "*)"}], " ", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{
         RowBox[{"c_", "*", 
          RowBox[{"bs", "[", 
           RowBox[{"arg_Association", ",", "other__"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n__Integer", "?", "NonNegative"}], "}"}]}], "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"resTest", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"arg", ",", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", "n", "}"}], ",", 
                RowBox[{"(", 
                 RowBox[{"Length", "[", 
                  RowBox[{"Flatten", "[", 
                   RowBox[{"List", "@@", "#"}], "]"}], "]"}], ")"}]}], "]"}], 
              "&"}]}], "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"resTest", "===", 
            RowBox[{"Association", "[", "]"}]}], ",", "0", ",", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Times", "[", 
                 RowBox[{"c", ",", "#"}], "]"}], "&"}], ",", "resTest"}], 
              "]"}], ",", "other"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
        "]"}], "/;", 
       RowBox[{"gaCommutativeFieldElementQ", "[", 
        RowBox[{"{", "c", "}"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"working", " ", "with", " ", "indices"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{
         RowBox[{"bs", "[", 
          RowBox[{"arg_Association", ",", "other__"}], "]"}], ",", 
         RowBox[{"{", "ind__mvDownUp", "}"}]}], "]"}], "]"}], ":=", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"resTest", "=", 
          RowBox[{"KeyTake", "[", 
           RowBox[{"arg", ",", 
            RowBox[{"{", "ind", "}"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"resTest", "===", 
           RowBox[{"Association", "[", "]"}]}], ",", "0", ",", 
          RowBox[{"bs", "[", 
           RowBox[{"resTest", ",", "other"}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",
 CellLabel->
  "In[289]:=",ExpressionUUID->"d85816dd-3d3a-4cf1-b21b-b92016e63bad"],

