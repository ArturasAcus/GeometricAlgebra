                    RowBox[{"Sqrt", "[", "mvNorm12", "]"}]}], "]"}], ",", 
                    "1"}], "]"}], "/", 
                    RowBox[{"Sqrt", "[", "mvNorm12", "]"}]}], ")"}], "*", 
                  "aVB"}]}]}], ",", "\[IndentingNewLine]", 
               RowBox[{"(", 
                RowBox[{"!", 
                 RowBox[{"zeroQ", "[", "mvNorm12", "]"}]}], ")"}]}], 
              "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
