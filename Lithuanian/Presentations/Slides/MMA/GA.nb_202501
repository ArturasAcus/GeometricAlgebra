               RowBox[{"{", 
                RowBox[{"alg", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"-", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "3"}], ",", 
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "2"}], ",", 
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "}"}], ",", 
                
                RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}]}]}], 
         "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "now", " ", "replace", " ", "only", " ", "nontrivial", " ", "basis", 
          " ", "elements", " ", "by", " ", "lists", " ", "of", " ", 
