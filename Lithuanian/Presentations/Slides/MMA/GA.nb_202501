                    RowBox[{"[", "ipart", "]"}], "]"}]}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", " ", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"theVars", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pbasis", "[", 
                    RowBox[{"[", "ipart", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"0", ",", "1", ",", "1"}], "]"}], "]"}], "]"}], 
                    "]"}], " ", "below", " ", "from", " ", "all", " ", "vars",
                     " ", "select", " ", "those"}], ",", " ", 
                   RowBox[{
                   "which", " ", "match", " ", "index", " ", "di_List", " ", 
                    "of", " ", "basis", " ", "element", " ", 
                    RowBox[{"pbasis", "[", 
                    RowBox[{"[", "ipart", "]"}], "]"}]}]}], "  ", "*)"}], 
                 "\[IndentingNewLine]", 
                 RowBox[{"(*", " ", 
                  RowBox[{"this", " ", 
                   StyleBox["will",
                    FontColor->RGBColor[1, 0.5, 0]], 
                   StyleBox[" ",
                    FontColor->RGBColor[1, 0.5, 0]], 
                   StyleBox["cause",
                    FontColor->RGBColor[1, 0.5, 0]], 
                   StyleBox[" ",
                    FontColor->RGBColor[1, 0.5, 0]], 
                   StyleBox["problems",
                    FontColor->RGBColor[1, 0.5, 0]], " ", "when", " ", 
                   "basis", " ", "element", " ", "will", " ", "be", " ", 
                   "linear", " ", 
                   RowBox[{"combination", "!"}]}], " ", "*)"}], " ", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                   "]"}], ":>", 
                  RowBox[{"mvDOp", "@@", 
                   RowBox[{"Sort", "[", 
                    RowBox[{"theVars", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pbasis", "[", 
                    RowBox[{"[", "ipart", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"0", ",", "1", ",", "1"}], "]"}], "]"}], "]"}], 
                    "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
              "\[IndentingNewLine]", ")"}], ",", "args5"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ipart", ",", "1", ",", "theBasisLength"}], "}"}]}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"args1", ",", "args3", ",", "args5"}], "}"}], ",", "id", 
          ",", 
          RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
           "partWithDerivativeArgument", ",", "id", ",", "Infinity", ",", 
            RowBox[{"Heads", "->", "True"}]}], "]"}], "===", "1"}], 
         ")"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"second", " ", "rule"}], ",", " ", 
       RowBox[{
       "when", " ", "gaDerivative", " ", "argument", " ", "term", " ", 
        "stands", " ", "in", " ", "the", " ", "left", " ", "side", " ", 
        "with", " ", "respect", " ", "to", " ", "gaMultivectorDerivative"}]}],
       " ", "*)"}], "  ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", ":", 
         RowBox[{"(", 
          RowBox[{
          "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
           "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
       RowBox[{"args1___", ",", 
        RowBox[{"partWithDerivativeArgument_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"{", "#", "}"}], ",", 
              RowBox[{
               RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", "___", 
               "]"}]}], "]"}], "]"}], "&"}], ")"}]}], ",", "args3___", ",", 
        RowBox[{
         RowBox[{"gaMultivectorDerivative", "[", "id_", "]"}], "[", 
         RowBox[{"rbasis_", ",", "pbasis_"}], "]"}], ",", "args5___"}], "]"}],
       ":>", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"theBasisLength", "=", 
            RowBox[{"Length", "[", "rbasis", "]"}]}], ",", 
           RowBox[{"theVars", "=", 
            RowBox[{
             RowBox[{"FirstCase", "[", 
              RowBox[{"rbasis", ",", "_mvPoint", ",", 
               RowBox[{
                RowBox[{
                "Echo", "[", 
                 "\"\<Error in \
rulesInsideAllProductsAssociatedWithMultivectorDerivative 2\>\"", "]"}], ";", 
                
                RowBox[{"Abort", "[", "]"}]}], ",", "Infinity"}], "]"}], "[", 
             
             RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"args1", ",", 
             RowBox[{"(", 
              RowBox[{"partWithDerivativeArgument", "/.", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                   "theDArg_", "]"}], ":>", 
                  RowBox[{"gaDirectionalDerivative", "[", 
                   RowBox[{"theDArg", ",", 
                    RowBox[{"pbasis", "[", 
                    RowBox[{"[", "ipart", "]"}], "]"}]}], "]"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                   "]"}], ":>", 
                  RowBox[{"mvDOp", "@@", 
                   RowBox[{"Sort", "[", 
                    RowBox[{"theVars", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pbasis", "[", 
                    RowBox[{"[", "ipart", "]"}], "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"0", ",", "1", ",", "1"}], "]"}], "]"}], "]"}], 
                    "]"}], "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
              "\[IndentingNewLine]", ")"}], ",", "args3", ",", 
             RowBox[{"rbasis", "[", 
              RowBox[{"[", "ipart", "]"}], "]"}], ",", "args5"}], "]"}], ",", 
           
           RowBox[{"{", 
            RowBox[{"ipart", ",", "1", ",", "theBasisLength"}], "}"}]}], 
          "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"args1", ",", "args3", ",", "args5"}], "}"}], ",", "id", 
           ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{
            "partWithDerivativeArgument", ",", "id", ",", "Infinity", ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}], "===", "1"}], ")"}]}], 
        ")"}]}]}]}], "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
