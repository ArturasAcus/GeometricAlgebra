    RowBox[{
     RowBox[{"AllTrue", "[", 
      RowBox[{
       RowBox[{"Cases", "[", 
        RowBox[{"reciprocalVector", ",", "_mvDownUp", ",", "Infinity", ",", 
         RowBox[{"Heads", "->", "True"}]}], "]"}], ",", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{"#", ",", 
          RowBox[{"mvDownUp", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"{", "_", "}"}]}], "]"}]}], "]"}], "&"}]}], "]"}], "&&", 
     RowBox[{"Head", "[", 
      RowBox[{
       RowBox[{"gaPrimaryVectors", "[", "gaRunningCoordinateChart", "]"}], "===",
        "List"}], "]"}]}]}]}], ";"}]}], "Input",
