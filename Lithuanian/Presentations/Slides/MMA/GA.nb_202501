                    RowBox[{"transform", "/@", 
                    RowBox[{"(", 
                    RowBox[{"op", "@@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"bs", "[", 
                    RowBox[{
                    RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "#", "}"}], ",", "du"}], "]"}], ",", "al", 
                    ",", "other"}], "]"}], "&"}], "/@", "di"}], ")"}]}], 
                    ")"}]}], "/.", 
                    RowBox[{"op", "\[Rule]", "OuterProduct"}]}], ")"}], "/;", 
                    
                    RowBox[{
                    RowBox[{"Length", "[", "di", "]"}], ">=", "1"}]}]}], 
                  "}"}]}], ")"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
