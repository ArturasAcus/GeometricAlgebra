            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Arrow", "[", 
                RowBox[{"{", 
                 RowBox[{"thePointComponents", ",", 
                  RowBox[{"gaComponentCoefficientList", "[", 
                   RowBox[{"#", ",", "basisVectorsCartes"}], "]"}]}], "}"}], 
                "]"}], "&"}], "/@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"List", "@@", 
                 RowBox[{"(", 
                  RowBox[{"Plus", "@@", 
                   RowBox[{"{", 
                    RowBox[{"thePoint", ",", "normalVector"}], "}"}]}], 
                  ")"}]}], "/.", "varToNumbersRules"}], ")"}]}], ",", 
             RowBox[{"{", "\"\<N\>\"", "}"}]}], "]"}], "]"}]}], 
         "\[IndentingNewLine]", "}"}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
