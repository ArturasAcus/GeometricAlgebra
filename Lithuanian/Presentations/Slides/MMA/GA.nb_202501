Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ". Expansion of products "
}], "Subsection",ExpressionUUID->"9842db4f-7771-4a2c-a368-bdec5ed23ca8"],

Cell[TextData[{
 StyleBox["Warning",
  FontColor->RGBColor[1, 0.5, 0]],
 ". Think twice and always make old copies of code before any attempt to \
modify expansion commands. The code is closely interrelated. In particular \
expansion in Association form (when field is represented in plain form) calls \
expansion in a plain representation form. Also calls for algebras with \
noncommutative coefficients calls itself to expand coefficients. Any \
modification (even very slight) may result into huge slowdown of code.  \
CoefficientFunction choice is very important in the case of non-commuting \
coefficients and can yield huge slowdown \
(\[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->\
\[CloseCurlyDoubleQuote]Automatic\[CloseCurlyDoubleQuote] is safe choice). "
}], "Text",ExpressionUUID->"fd628116-6925-4687-b2b9-68dc8a80e53c"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". gaProductPairExpand[ ]  in internal \
\[OpenCurlyDoubleQuote]AssociationRepresentation\[CloseCurlyDoubleQuote] \
form"
}], "Subsubsection",ExpressionUUID->"7de73374-6b0e-4e13-8ec8-67af26590139"],

Cell["\<\
The expansion of product (geometric and outer) of MV  given in Association \
form is the much faster that expansion of MV given in \
\[OpenCurlyDoubleQuote]PlainRepresentation\[CloseCurlyDoubleQuote] form. This \
subsection deals only  with expansion of  \
\[OpenCurlyDoubleQuote]AssociationRepresentation\[CloseCurlyDoubleQuote] form.\
\>", "Text",ExpressionUUID->"eb022f9b-2a73-471a-9dce-3e348671d79a"],

Cell["\<\
Only GeometricProduct and OuterProduct currently are implemented in \
Association representation. There is a little room to speed up an expansion \
in association using memorization (not implemented). \
\>", "Text",ExpressionUUID->"59a7ab7d-5468-47f1-b4f0-aa2dd2f02609"],

Cell["\<\
Realization with ListConvolve is faster than with Outer, thanks to \
Stackexchange!!!,  \
https://mathematica.stackexchange.com/questions/148230/speeding-the-\
calculation-of-a-complex-polynomial-from-its-roots/148240#148240 and Carl \
Woll in particular. \
\>", "Text",ExpressionUUID->"8b45b7fb-0dff-4562-b64e-ff16627455e0"],

Cell["\<\
The pair expansion must contain only two MV in Association form. Below we try \
to put expression in that form.  In the case of InnerProduct we have to \
remove the scalar keys of Associations ! , therefore we separate that \
function (since it is supposed to be rarely used)\
\>", "Text",ExpressionUUID->"1f21934a-fc66-47cf-8a5c-b051ab6e2a6c"],

Cell["\<\
Case 1: Both algebra elements and noncommutative field elements (coefficients \
at basis elements of algebra) are represented in the Association form. \
\>", "Text",ExpressionUUID->"d4cfd1eb-0004-4c29-a21d-b02e7ece1292"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"only", " ", "one", " ", "bracket", " ", 
      RowBox[{"h", ":", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
         "GeometricProduct", "|", "OuterProduct", "|", "LeftContract", "|", 
          "RightContract", "|", "InnerProduct"}], ")"}], " ", "is", " ", 
        RowBox[{"needed", ".", " ", "The"}], " ", "syntax", "  ", 
        RowBox[{"(", 
         RowBox[{"h", ":", 
          RowBox[{"(", 
           RowBox[{
           "GeometricProduct", "|", "OuterProduct", "|", "LeftContract", "|", 
            "RightContract", "|", "InnerProduct"}], ")"}]}], ")"}], " ", 
        "will", " ", "not", " ", "work"}]}]}], " ", "*)"}], " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaProductPairExpand", "[", 
        RowBox[{
         RowBox[{"h", ":", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "GeometricProduct", "|", "OuterProduct", "|", "LeftContract", "|",
              "RightContract", "|", "InnerProduct"}], ")"}], "[", 
           RowBox[{
            RowBox[{"argg1", ":", 
             RowBox[{"(", 
              RowBox[{"bs", "[", 
               RowBox[{"ass1_Association", ",", "al_", ",", "any___"}], "]"}],
               ")"}]}], ",", 
            RowBox[{"argg2", ":", 
             RowBox[{"(", 
              RowBox[{"bs", "[", 
               RowBox[{"ass2_Association", ",", "al_", ",", "any___"}], "]"}],
               ")"}]}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"_", ",", "quiet_", ",", "_"}], "}"}]}], "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"hd", "=", 
            RowBox[{"Head", "[", "h", "]"}]}], ",", 
           RowBox[{"(*", " ", 
            RowBox[{
            "for", " ", "Inner", " ", "product", " ", "we", " ", "remove", 
             " ", "scalar", " ", "keys"}], "*)"}], "  ", 
           "\[IndentingNewLine]", 
           RowBox[{"as1", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "h", "]"}], "===", "InnerProduct"}], ",", 
              
              RowBox[{"KeyDrop", "[", 
               RowBox[{"ass1", ",", 
                RowBox[{"{", 
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], "}"}]}], "]"}], ",", "ass1"}],
              "]"}]}], ",", 
           RowBox[{"as2", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Head", "[", "h", "]"}], "===", "InnerProduct"}], ",", 
              
              RowBox[{"KeyDrop", "[", 
               RowBox[{"ass2", ",", 
                RowBox[{"{", 
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], "}"}]}], "]"}], ",", "ass2"}],
              "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "for", " ", "non", " ", "commutative", " ", "field", " ", 
             "presented", " ", "in", " ", "an", " ", "Association", " ", 
             "form"}], "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{"coefficientOperation", "=", 
            RowBox[{
             RowBox[{"First", "[", 
              RowBox[{"gaProductPairExpand", "[", 
               RowBox[{"##", ",", 
                RowBox[{"{", 
                 RowBox[{"Expand", ",", "quiet", ",", "Infinity"}], "}"}]}], 
               "]"}], "]"}], "&"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "for", " ", "sumation", " ", "use", " ", "use", " ", "Total", " ",
              "and"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{"mergeOperation", "=", 
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"theField", "=", 
                RowBox[{"gaGetField", "[", "h", "]"}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"theField", "===", "\"\<Quaternion\>\""}], ",", 
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"Merge", "[", 
                    RowBox[{"#", ",", "Total"}], "]"}], ",", 
                   RowBox[{"Cl", "[", 
                    RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", 
                   "\"\<Quaternion\>\""}], "]"}], "&"}], ",", 
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"Merge", "[", 
                    RowBox[{"#", ",", "Total"}], "]"}], ",", "theField"}], 
                  "]"}], "&"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
          "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"Show", " ", "what", " ", "is", " ", "going"}], " ", "*)"}],
          "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"printDetails", "[", 
           RowBox[{"quiet", ",", 
            RowBox[{"{", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "\"\<MVs and their coefficients are presented in Association \
form. User's coefficient function is ignored.\>\"", ",", "\"\<\>\""}], "}"}], 
              ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
               "\"\<Coefficient product operation is \>\"", ",", 
                "coefficientOperation"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
               "\"\<Association Merge operation is \>\"", ",", 
                "mergeOperation"}], "}"}], ",", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{"\"\<The product pair is\>\"", ",", "h"}], "}"}]}], 
             "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Geometric", " ", "product", " ", "expansion", " ", 
            "realization"}], " ", "*)"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"gaAssociationRepresentationClean", "[", 
           RowBox[{"bs", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Merge", "[", 
              RowBox[{
               RowBox[{"ListConvolve", "[", 
                RowBox[{
                 RowBox[{"Keys", "[", "as1", "]"}], ",", 
                 RowBox[{"Keys", "[", "as2", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"-", "1"}]}], "}"}], ",", "0", ",", 
                 RowBox[{
                  RowBox[{"Rule", "[", 
                   RowBox[{
                    RowBox[{"productIndex", "[", 
                    RowBox[{"#1", ",", "#2", ",", "hd"}], "]"}], ",", 
                    RowBox[{"Times", "[", 
                    RowBox[{
                    RowBox[{"productSignatureMap", "[", 
                    RowBox[{"#1", ",", "#2", ",", "hd", ",", "al"}], "]"}], 
                    ",", 
                    RowBox[{"coefficientOperation", "[", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{
                    RowBox[{"as1", "[", "#1", "]"}], ",", 
                    RowBox[{"as2", "[", "#2", "]"}]}], "]"}], "]"}]}], 
                    "]"}]}], "]"}], "&"}], ",", 
                 RowBox[{
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{
                    RowBox[{"List", "[", "##", "]"}], ",", "0"}], "]"}], 
                  "&"}]}], "]"}], ",", "mergeOperation"}], "]"}], ",", "al", 
             ",", "any"}], "]"}], "\[IndentingNewLine]", "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], "/;", 
       RowBox[{
        RowBox[{"Not", "[", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"ass1", ",", 
           RowBox[{"KeyValuePattern", "[", 
            RowBox[{"_", "->", 
             RowBox[{"bs", "[", 
              RowBox[{"_Association", ",", "__"}], "]"}]}], "]"}]}], "]"}], 
         "]"}], "&&", 
        RowBox[{"Not", "[", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"ass2", ",", 
           RowBox[{"KeyValuePattern", "[", 
            RowBox[{"_", "->", 
             RowBox[{"bs", "[", 
              RowBox[{"_Association", ",", "__"}], "]"}]}], "]"}]}], "]"}], 
         "]"}]}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellLabel->
  "In[446]:=",ExpressionUUID->"ad44de9f-2bcc-4263-808a-dc9dfecfa039"],

Cell[TextData[{
 "Case2: Only algebra elements are in Association form. We introduced ",
 StyleBox["coefficientOperation=If[FreeQ[{as1,as2},\
gaNonCommutativeFieldElementPattern], Times,GeometricProduct]",
  FontWeight->"Bold"],
 ", which defines operation between coefficients and ",
 StyleBox["mergeOperation=Total",
  FontWeight->"Bold"],
 ".  "
}], "Text",ExpressionUUID->"d398a7eb-2998-48f0-8dda-092808dc5ead"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"only", " ", "one", " ", "bracket", " ", 
      RowBox[{"h", ":", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
         "GeometricProduct", "|", "OuterProduct", "|", "LeftContract", "|", 
          "RightContract", "|", "InnerProduct"}], ")"}], " ", "here", " ", 
        "is", " ", 
        RowBox[{"needed", ".", " ", "The"}], "  ", 
        RowBox[{"(", 
