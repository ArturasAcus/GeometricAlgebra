Cell["Computation of reduction sequence.", "Text",ExpressionUUID->"64764998-00d3-45aa-a7eb-7e46c79b9a88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"autoreductionlist", "[", "alg_Cl", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "sol", ",", "pVal", ",", "qVal", ",", "rVal", ",", "xVar", ",", "zVar"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pVal", ",", "qVal", ",", "rVal"}], "}"}], "=", 
      RowBox[{"List", "@@", "alg"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"Last", "[", 
       RowBox[{"Minimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"pVal", "-", 
               RowBox[{"4", "xVar"}], "-", "zVar"}], ")"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"qVal", "+", 
               RowBox[{"4", "xVar"}], "-", "zVar"}], ")"}], "^", "2"}]}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"pVal", "-", 
              RowBox[{"4", "xVar"}], "-", "zVar"}], ")"}], ">=", "0"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"qVal", "+", 
              RowBox[{"4", "xVar"}], "-", "zVar"}], ")"}], ">=", "0"}], ",", 
           RowBox[{"zVar", ">=", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xVar", ",", "zVar"}], "}"}], ",", "Integers"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xVar", "/.", "sol"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", 
           RowBox[{"-", "4"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "xVar"}], "/.", "sol"}], "}"}]}], "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"zVar", "/.", "sol"}], "}"}]}], "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1031]:=",ExpressionUUID->"1068a11b-0faa-405a-bf41-8daf6ad6c501"],

