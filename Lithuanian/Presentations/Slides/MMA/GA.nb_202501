Cell[TextData[{
 StyleBox["gaAssociationTogether[ ]",
  FontWeight->"Bold"],
 " is an important function which attempts to collect sum of Associations \
into single Association.  The sum can always appear when expanding parts of \
expression. "
}], "Text",ExpressionUUID->"8525b81c-2b50-4923-8ad3-71e4fe759a3e"],

