Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Coordinate", " ", "specific", " ", "rules", " ", "for", " ", "basis", " ",
     "elements"}], " ", "*)"}], "\[IndentingNewLine]", 
