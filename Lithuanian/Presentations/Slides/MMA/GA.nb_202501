Cell["\<\
GA characteristic polynomials. Method the same as for gaDeterminant[ ], \
except that this time we use projection instead of sum of MV and its all \
grade (except 0) inverse (see the same Shirokov article as for determinant).\
\>", "Text",ExpressionUUID->"202e01bd-2fa0-4f6d-b33d-e9b14af551df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "gaCharacteristicPolynomial", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Method", "\[Rule]", "\"\<Automatic\>\""}], ",", 
      RowBox[{"\"\<Expand\>\"", "\[Rule]", "\"\<Automatic\>\""}], ",", 
      RowBox[{
      "\"\<InternalRepresentation\>\"", "->", 
       "\"\<AssociationRepresentation\>\""}], ",", 
      RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"case", " ", "of", " ", "simple", " ", "option"}], "  ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", "\"\<Expand\>\"", "]"}],
    "=", 
   RowBox[{
   "\"\<\\\"Automatic\\\"\>\"", "|", "Automatic", "|", "Expand", "|", 
    "Identity", "|", 
    "\"\<any transformation (i.e with head Function[]) of expression\>\""}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", "\"\<Quiet\>\"", "]"}], 
   "=", 
   RowBox[{"\"\<True\>\"", "|", "\"\<False\>\""}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", "\"\<Method\>\"", "]"}],
    "=", 
   RowBox[{"Alternatives", "[", 
    RowBox[{
    "Automatic", ",", "\"\<\\\"Automatic\\\"\>\"", ",", 
     "\"\<\\\"Involutions\\\"\>\"", ",", "\"\<\\\"Matrix\\\"\>\"", ",", 
     "\"\<\\\"FaddeevLieVerrierSouriau\\\"\>\"", ",", 
     "\"\<\\\"FaddeevLieVerrierSouriauBell\\\"\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
    "testOptionCharacteristicPolynomial", "[", 
     "\"\<InternalRepresentation\>\"", "]"}], "=", 
    RowBox[{"Alternatives", "[", 
     RowBox[{
     "\"\<PlainRepresentation\>\"", ",", 
      "\"\<AssociationRepresentation\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "argument", " ", "cal", " ", "is", " ", "used", " ", "for", 
    " ", "actual", " ", "check"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", 
    RowBox[{"\"\<Expand\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{
     "\"\<Automatic\>\"", "|", "Automatic", "|", "Expand", "|", "Identity", 
      "|", "_Function"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", 
    RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionCharacteristicPolynomial", "[", 
    RowBox[{"\"\<Method\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{"Alternatives", "[", 
      RowBox[{
      "\"\<Automatic\>\"", ",", "Automatic", ",", "\"\<Involutions\>\"", ",", 
       "\"\<FaddeevLieVerrierSouriau\>\"", ",", 
       "\"\<FaddeevLieVerrierSouriauBell\>\"", ",", "\"\<Matrix\>\""}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionCharacteristicPolynomial", "[", 
     RowBox[{"\"\<InternalRepresentation\>\"", ",", "val_"}], "]"}], ":=", 
    RowBox[{"MatchQ", "[", 
     RowBox[{"val", ",", 
      RowBox[{
      "\"\<PlainRepresentation\>\"", "|", 
       "\"\<AssociationRepresentation\>\""}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "Messages", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaCharacteristicPolynomial", "::", "degree"}], "=", 
   "\"\<Characteristic polynomial degree `1` (or elements of degree list) is \
in not in the range [1, `2`]. Will replace by All.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaCharacteristicPolynomial", "::", "Method"}], "=", 
   "\"\<Explicit formulas are known for dimension n\[LessEqual]6. The algebra \
has dimension `1`. Switching to \\\"Method\\\"->\\\"Matrix\\\".\>\""}], 
  ";"}]}], "Input",ExpressionUUID->"960250dc-3b38-4187-8264-8f19b71e035c"],

Cell["\<\
gaCharacteristicPolynomial[ ] called with poly variable will return \
polynomial. When called with specific number returns corresponding \
coefficient of char poly. When called with variable All returns list of all \
coefficients. The call with variable is forwarded to call with key All.\
\>", "Text",ExpressionUUID->"4ded36e1-84b7-4b24-8a79-e82eb36df5f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaCharacteristicPolynomial", "[", 
   RowBox[{"exprInput_", ",", "x_Symbol", ",", 
    RowBox[{"op", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "charCoefficients", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"charCoefficients", "=", 
       RowBox[{"gaCharacteristicPolynomial", "[", 
        RowBox[{"exprInput", ",", "All", ",", "op"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"charCoefficients", ".", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"x", "^", "i"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{
            RowBox[{"Length", "[", "charCoefficients", "]"}], "-", "1"}]}], 
          "}"}]}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"x", "=!=", "All"}]}]}]], "Input",
 CellLabel->
  "In[1122]:=",ExpressionUUID->"275be8ee-6988-4291-bdcf-b638a7a8e118"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaCharacteristicPolynomial", "[", 
   RowBox[{"exprInput_", ",", 
    RowBox[{"op", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "charCoefficients", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"charCoefficients", "=", 
      RowBox[{"gaPlainRepresentation", "[", 
       RowBox[{"gaCharacteristicPolynomial", "[", 
        RowBox[{"exprInput", ",", "All", ",", "op"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "\[FormalX]", "}"}], ",", "#"}], "]"}], "&"}], "@@", 
      RowBox[{"{", 
       RowBox[{"charCoefficients", ".", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\[FormalX]", "^", "i"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", 
            RowBox[{
             RowBox[{"Length", "[", "charCoefficients", "]"}], "-", "1"}]}], 
           "}"}]}], "]"}]}], "}"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[1123]:=",ExpressionUUID->"cc7429d3-720d-42a7-aabb-529270aba51e"],

Cell["When we need only one coefficient call specific method. ", "Text",ExpressionUUID->"a02501fb-e7dc-4615-b15f-4517d5cb52cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaCharacteristicPolynomial", "[", 
   RowBox[{"exprInput_", ",", 
    RowBox[{"n_Integer", "?", "NonNegative"}], ",", "___"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"theAlgebra", "=", 
       RowBox[{"gaGetAlgebra", "[", "exprInput", "]"}]}], ",", "dim", ",", 
      "xPower"}], "}"}], ",", 
    RowBox[{
     RowBox[{"dim", "=", 
      RowBox[{"(", 
       RowBox[{"2", "^", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"gaDimensionOfVectorSpace", "[", "theAlgebra", "]"}], "/", 
          "2"}], "]"}]}], ")"}]}], ";", 
     RowBox[{"xPower", "=", 
      RowBox[{"dim", "-", "n"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"n", ",", "dim", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "<", "dim"}], "&"}], ")"}]}], ",", 
       RowBox[{"gaPlainRepresentation", "[", 
        RowBox[{"characteristicPolynomialFormulaByLeftNest", "[", 
         RowBox[{"exprInput", ",", "theAlgebra", ",", "xPower"}], "]"}], 
        "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1124]:=",ExpressionUUID->"34cc6caf-5ad7-4a3d-a736-004704b54ec3"],

Cell["\<\
When called with All  returns list of  coefficient of char poly.\
\>", "Text",ExpressionUUID->"34e09aa2-8641-4317-9ca3-d760ab0f9384"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaCharacteristicPolynomial", "[", 
      RowBox[{"exprInput_", ",", "All", ",", 
       RowBox[{"op", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"theOption", ",", 
         RowBox[{"theAlgebra", "=", 
          RowBox[{"gaGetAlgebra", "[", "exprInput", "]"}]}], ",", "theResult",
          ",", "dim", ",", "theMatrix", ",", "maxPolyDegree", ",", "nRange", 
         ",", "oldMatrixRep", ",", "theRepresentationFunction", ",", 
         "theBackRepresentationFunction"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"option", " ", 
          RowBox[{"handling", ":", " ", 
           RowBox[{
           "when", " ", "option", " ", "has", " ", "value", " ", 
            "Automatic"}]}]}], ",", " ", 
         RowBox[{
         "replace", " ", "it", " ", "by", " ", "string", " ", 
          "\"\<Automatic\>\""}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"gaSetNamedOptionValue", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
             "gaCharacteristicPolynomial", ",", "#", ",", "theOption"}], 
             "}"}], ",", 
            RowBox[{
             RowBox[{
             "gaOptionCheck", "[", "testOptionCharacteristicPolynomial", 
              "]"}], "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
                 ",", 
                 RowBox[{"Automatic", "\[Rule]", "\"\<Automatic\>\""}]}], 
                "}"}]}], ")"}], "]"}], ",", 
            RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
           "]"}], "&"}], "/@", 
         RowBox[{"(", 
          RowBox[{"Flatten", "[", 
           RowBox[{"First", "/@", 
            RowBox[{"{", "op", "}"}]}], "]"}], ")"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "check", " ", "if", " ", "main", " ", "options", " ", "obtained", 
          " ", "values"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "]"}], "===", 
           "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "=", 
           "\"\<Automatic\>\""}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "]"}], "===", 
           "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "=", 
           RowBox[{"(", 
            RowBox[{"\"\<Expand\>\"", "/.", 
             RowBox[{"Options", "[", "gaCharacteristicPolynomial", "]"}]}], 
            ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
           "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
           RowBox[{"(", 
            RowBox[{"Quiet", "/.", 
             RowBox[{"Options", "[", "gaCharacteristicPolynomial", "]"}]}], 
            ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"theOption", "[", "\"\<InternalRepresentation\>\"", "]"}],
             "]"}], "===", "theOption"}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<InternalRepresentation\>\"", "]"}], 
           "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\"\<InternalRepresentation\>\"", "/.", 
              RowBox[{"Options", "[", "gaCharacteristicPolynomial", "]"}]}], 
             ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{
             "\"\<InternalRepresentation\>\"", "->", 
              "\"\<PlainRepresentation\>\""}], "}"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "theAlgebra", "]"}], "=!=", "Cl"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<Algebra was not set.\>\"", " ", "]"}], 
           ";", 
           RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"true", " ", "MV", " ", "case", " ", "starts", " ", "here"}],
          " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"maxPolyDegree", "=", 
         RowBox[{"gaDimensionOfRepresentation", "[", "theAlgebra", "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"dim", "=", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "theAlgebra", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nRange", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"1", ",", "maxPolyDegree"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "===", 
           "\"\<Automatic\>\""}], ",", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"gaPE", "[", "#", "]"}], "&"}], ")"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<InternalRepresentation\>\"", "]"}], 
          ",", "\[IndentingNewLine]", "\"\<PlainRepresentation\>\"", ",", 
          RowBox[{
           RowBox[{"theRepresentationFunction", "=", "Identity"}], ";", 
           RowBox[{"theBackRepresentationFunction", "=", "Identity"}]}], ",", 
          "\[IndentingNewLine]", "\"\<AssociationRepresentation\>\"", ",", 
          RowBox[{
           RowBox[{
           "theRepresentationFunction", "=", "gaAssociationRepresentation"}], 
           ";", 
           RowBox[{
           "theBackRepresentationFunction", "=", 
            "gaPlainRepresentation"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"when", " ", "method", " ", "is", " ", "Automatic"}], ",", 
          " ", 
          RowBox[{
          "decide", " ", "which", " ", "one", " ", "of", " ", "methods", " ", 
           "to", " ", "use"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "===", 
           "\"\<Automatic\>\""}], ",", "\[IndentingNewLine]", 
          RowBox[{"Which", "[", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"for", " ", "algebras", " ", "p"}], "+", 
             RowBox[{"q", " ", "use", " ", "specific", " ", "formulas"}]}], 
            "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"dim", "\[LessEqual]", "6"}], ",", 
            RowBox[{
             RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "=", 
             "\"\<Involutions\>\""}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "in", " ", "all", " ", "other", " ", "cases", " ", "just", " ", 
               "use", " ", "matrix", " ", "representations"}], ",", " ", 
              RowBox[{
              "since", " ", "it", " ", "is", " ", "much", " ", "faster"}]}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"dim", ">", "6"}], ",", 
            RowBox[{
             RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "=", 
             "\"\<Matrix\>\""}]}], "\[IndentingNewLine]", "]"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"call", " ", "actual", " ", "method"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "Use", " ", "explicit", " ", "formulas", " ", "for", " ", 
             "determinant"}], ",", " ", 
            RowBox[{
             RowBox[{
             "which", " ", "are", " ", "known", " ", "up", " ", "to", " ", 
              "n"}], "=", "6"}]}], " ", "*)"}], "\[IndentingNewLine]", 
          "\"\<Involutions\>\"", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "warn", " ", "and", " ", "change", " ", "method", " ", "if", " ", 
            "not", " ", "possible"}], " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"dim", "<", "6"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"printDetails", "[", 
              RowBox[{
               RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<The characteristic polynomial is computed using \>\"", 
                   ",", 
                   RowBox[{"Method", "\[Rule]", 
                    RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}]}], 
                  "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<InternalRepresentation representation is \>\"", ",", 
                   RowBox[{
                   "theOption", "[", "\"\<InternalRepresentation\>\"", 
                    "]"}]}], "}"}]}], "\[IndentingNewLine]", "}"}]}], "]"}], 
             ";", "\[IndentingNewLine]", 
             RowBox[{"theResult", "=", 
              RowBox[{"CoefficientList", "[", 
               RowBox[{
                RowBox[{"involutionDet", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "[", 
                   RowBox[{"theRepresentationFunction", "[", 
                    RowBox[{"exprInput", "-", "\[FormalLambda]"}], "]"}], 
                   "]"}], ",", "dim", ",", 
                  RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}]}], "]"}], 
                ",", "\[FormalLambda]"}], "]"}]}]}], ",", 
            "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Message", "[", 
              RowBox[{
               RowBox[{"gaCharacteristicPolynomial", "::", "Method"}], ",", 
               "dim"}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Faddeev", " ", "LieVerier", " ", "Souriau", " ", "implementation",
             "  ", "using", " ", "NestList"}], " ", "*)"}], " ", 
          "\[IndentingNewLine]", "\"\<FaddeevLieVerrierSouriau\>\"", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"printDetails", "[", 
            RowBox[{
             RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"{", 
               RowBox[{
               "\"\<The characteristic polynomial is computed using \>\"", 
                ",", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}]}], "}"}],
               "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"theResult", "=", 
            RowBox[{"Reverse", "[", 
             RowBox[{"-", 
              RowBox[{"gaFaddeevLieVerrierSouriauCoefficients", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "[", 
                 RowBox[{"theRepresentationFunction", "[", "exprInput", "]"}],
                  "]"}], ",", "maxPolyDegree"}], "]"}]}], "]"}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Faddeev", " ", "LieVerier", " ", "Souriau", " ", "implementation",
             " ", "using", " ", "explicit", " ", "memoized", " ", "recursion",
             " ", "with", " ", "complete", " ", "Bell", " ", "polynomials"}], 
           " ", "*)"}], " ", "\[IndentingNewLine]", 
          "\"\<FaddeevLieVerrierSouriauBell\>\"", ",", "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"printDetails", "[", 
            RowBox[{
             RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "\"\<The characteristic polynomial is computed using \>\"", 
                 ",", 
                 RowBox[{"Method", "\[Rule]", 
                  RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}]}], 
                "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                "\"\<Internal representation changed to PlainRepresentation \
\>\"", ",", "\"\<\>\""}], "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"detU", "[", 
             RowBox[{"1", ",", "mv_"}], "]"}], ":=", "mv"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"detU", "[", 
             RowBox[{
              RowBox[{"k_Integer", "?", "Positive"}], ",", "mv_"}], "]"}], ":=", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"detU", "[", 
                RowBox[{"k", ",", "mv"}], "]"}], "=", 
               RowBox[{
                RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "[", 
                RowBox[{
                 RowBox[{"detU", "[", 
                  RowBox[{
                   RowBox[{"k", "-", "1"}], ",", "mv"}], "]"}], 
                 "\[GeometricProduct]", "mv"}], "]"}]}], ")"}], "/;", 
             RowBox[{"k", ">", "1"}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"theResult", "=", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"Reverse", "[", 
               RowBox[{"-", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"detCExpl", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"gaPlainRepresentation", "[", 
                    RowBox[{
                    RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "[", 
                    "exprInput", "]"}], "]"}], ",", "theAlgebra"}], "]"}], 
                   "&"}], "/@", "nRange"}], ")"}]}], "]"}], ",", "1"}], 
             "]"}]}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "matrix", " ", "method", " ", "for", " ", "large", " ", 
            "dimensions", " ", "is", " ", "still", " ", "fastest"}], " ", 
           "*)"}], "\[IndentingNewLine]", "\"\<Matrix\>\"", ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"oldMatrixRep", "=", 
            RowBox[{"gaMatrixRepresentation", "[", "theAlgebra", "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "===", 
              "\"\<Automatic\>\""}], ",", 
             RowBox[{
              RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "=", 
              "Expand"}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Head", "[", 
                 RowBox[{"gaMatrixRepresentation", "[", "theAlgebra", "]"}], 
                 "]"}], "===", "gaMatrixRepresentation"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{"!", 
                RowBox[{"FreeQ", "[", 
                 RowBox[{
                  RowBox[{"gaMatrixRepresentation", "[", "theAlgebra", "]"}], 
                  ",", "\"\<Quaternion\>\""}], "]"}]}], ")"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Off", "[", 
               RowBox[{"gaDefineMatrixRepresentation", "::", "smaller"}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"gaDefineMatrixRepresentation", "[", 
               RowBox[{"theAlgebra", ",", 
                RowBox[{"Method", " ", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"\"\<TensorProduct\>\"", ",", 
                   RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Cl", "[", 
                    RowBox[{"0", ",", "1"}], "]"}], "->", 
                    "\"\<Antisymmetric\>\""}], ",", 
                    RowBox[{
                    RowBox[{"Cl", "[", 
                    RowBox[{"1", ",", "0"}], "]"}], "\[Rule]", 
                    "\"\<Diagonal\>\""}], ",", 
                    RowBox[{
                    RowBox[{"Cl", "[", 
                    RowBox[{"1", ",", "1"}], "]"}], "\[Rule]", 
                    "\"\<Antisymmetric\>\""}], ",", 
                    RowBox[{
                    RowBox[{"Cl", "[", 
                    RowBox[{"2", ",", "0"}], "]"}], "->", 
                    "\"\<IPauli[3,1]\>\""}], ",", 
                    RowBox[{
                    RowBox[{"Cl", "[", 
                    RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
                    "\"\<Pauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}]}], "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"On", "[", 
               RowBox[{"gaDefineMatrixRepresentation", "::", "smaller"}], 
               "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"printDetails", "[", 
            RowBox[{
             RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
             RowBox[{"{", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "\"\<The characteristic is computed using matrix \
representations:\>\"", ",", 
                 RowBox[{"Method", "\[Rule]", 
                  RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}]}], 
                "}"}], ",", "\[IndentingNewLine]", 
               RowBox[{"{", 
                RowBox[{"\"\<Matrix representations are \>\"", ",", 
                 RowBox[{"gaMatrixRepresentation", "[", "theAlgebra", "]"}]}],
                 "}"}]}], "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"theMatrix", "=", 
            RowBox[{"gaToMatrixRepresentation", "[", 
             RowBox[{
              RowBox[{"gaPlainRepresentation", "[", 
               RowBox[{
                RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "[", 
                "exprInput", "]"}], "]"}], ",", "theAlgebra"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"theResult", "=", 
            RowBox[{"CoefficientList", "[", 
             RowBox[{
              RowBox[{"CharacteristicPolynomial", "[", 
               RowBox[{"theMatrix", ",", "\[FormalA]"}], "]"}], ",", 
              "\[FormalA]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{"restore", " ", "matrix", " ", "representation"}], "*)"}],
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"gaMatrixRepresentation", "[", "theAlgebra", "]"}], "=", 
            "oldMatrixRep"}], ";"}], "\[IndentingNewLine]", ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "any", " ", "othern", " ", "method", " ", "is", " ", "explicitly", 
            " ", "refused"}], " ", "*)"}], " ", "\[IndentingNewLine]", "_", 
          ",", " ", "$Failed"}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "remove", " ", "possible", " ", "memoized", " ", "values", " ", 
          "and", " ", "return", " ", "answer"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ClearAll", "[", "detU", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"theBackRepresentationFunction", "[", "theResult", "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]], "Input",ExpressionUUID->"64ce9dac-c0c2-47bd-912c-4e07e73bee0f"]
