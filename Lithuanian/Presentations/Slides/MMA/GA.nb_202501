           RowBox[{"{", 
            RowBox[{"4", ",", 
             RowBox[{"-", "4"}], ",", "0"}], "}"}]}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"in", " ", "fact", " ", "we", " ", 
         RowBox[{"don", "'"}], "t", " ", "need", " ", "to", " ", "genarate", 
         " ", "full", " ", "basis", " ", "of", " ", "new", " ", "algebra"}], 
