        RowBox[{"{", "}"}], ",", "j1"}], "]"}], ",", 
      RowBox[{"mvDownUp", "[", 
       RowBox[{
        RowBox[{"{", "}"}], ",", "j2"}], "]"}], ",", "GeometricProduct"}], 
