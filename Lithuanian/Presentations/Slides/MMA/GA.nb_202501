          "elements"}], ",", " ", 
         RowBox[{"just", " ", "replace", " ", "algebra", " ", "marker"}]}], 
        " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"nonTrivial", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Rest", "[", "basisAlg", "]"}], ",", 
