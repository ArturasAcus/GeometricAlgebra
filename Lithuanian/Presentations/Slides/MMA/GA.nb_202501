Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ". Derivatives of MV"
}], "Subsection",ExpressionUUID->"442e6594-bb0f-4563-808f-1cfe5f2e85b9"],

Cell[TextData[{
 StyleBox["mvD[]",
  FontWeight->"Bold"],
 " (replacement of ",
 StyleBox["D[]",
  FontWeight->"Bold"],
 ") is used by gaDirectionalDerivative[], which in turn is used in \
gaMultivectorDderivative[]. So, generally computation procedure goes as: the \
input ",
 StyleBox["gaMultivectorDderivative[]",
  FontWeight->"Bold"],
 " (then using  rules of ",
 StyleBox["gaToDirectionalDerivative[ ]",
  FontWeight->"Bold"],
 ") -> ",
 StyleBox["gaDirectionalDerivative[]",
  FontWeight->"Bold"],
 " (then using rules of ",
 StyleBox["gaDerivativeExpand[]",
  FontSlant->"Italic"],
 " ) ->  ",
 StyleBox["mvD[ ]",
  FontWeight->"Bold"],
 " -> the answer. To summarise:\n1) ",
 StyleBox["mvD[ ]",
  FontWeight->"Bold"],
 " differentiate scalars only. \n2) ",
 StyleBox["gaDirectionalDerivative[ ] ",
  FontWeight->"Bold"],
 "differentiate scalars and basis elements with respect to given basis vector \
of DIRECT SPACE . \n3) ",
 StyleBox["gaMultivectorDerivative[]",
  FontWeight->"Bold"],
 " differentiate expressions and multiply them by RECIPROCAL BASIS (vectors \
at the moment)."
}], "Text",ExpressionUUID->"7e9a9d62-3f09-40ce-a4a1-dbcebb7abb9d"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". mvD[expr_, var_Symbol] (automatic computation, like D[])"
}], "Subsubsection",ExpressionUUID->"0096699d-d5bf-4563-acb1-3f07cfd61799"],

Cell["\<\
Implementation of derivative with respect to variable. It is used by almost \
in all other kind of derivatives. mvD[arg, var_Symbol] is a replacement of \
usual D[arg,var], except that 1) it cheks if var is indeed a coordinate \
system variable 2) It adds to the usual rule mvD[x,x]->1 unconventional rule  \
mvD[x[t],x]->1 (which allows coordinate to be parametrized) 3) It ignores \
differentiation of basis vectors. 4) Special behaviour when heads MV,bs and \
mvDOp (reserved for pure differential operator, without action target) are \
detected.
Holding of all arguments causes many problems, in particular even in the step \
of construction form TemplateBox, therefore we try to avoid it.\
\>", "Text",ExpressionUUID->"df828b95-4edf-4b2c-9da5-1286e0e6619d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mvD", "::", "arg"}], "=", 
   "\"\<mvD failed for expression `1` and differentiation variable \
`2`.\>\""}], ";"}]], "Input",
 CellLabel->
  "In[1526]:=",ExpressionUUID->"d0469727-46a8-4ade-95ec-917462bc7f35"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"try", " ", "to", " ", "catch", " ", "when", " ", "both", " ", 
    RowBox[{"var", "[", "t", "]"}], " ", "and", " ", "var", " ", "are", " ", 
    "present", " ", "and", " ", "warn", " ", "when", "  ", "var", " ", "is", 
    " ", "not", " ", "coordinate", " ", "system", " ", "variable"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"mvD", "[", 
      RowBox[{"expr_", ",", "var_Symbol"}], "]"}], ":=", 
     RowBox[{"0", "/;", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"var", "|", "mvDOp"}], ",", 
        RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"test", " ", "if", " ", 
     RowBox[{"mvD", "[", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", "x"}], "]"}], " ", "is", " ", 
     RowBox[{"present", ".", " ", "If"}], " ", "present", " ", 
     RowBox[{"don", "'"}], "t", " ", "use", " ", "this", " ", "rule"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mvD", "[", 
      RowBox[{"var_Symbol", ",", "var_Symbol"}], "]"}], ":=", "1"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "if", " ", "there", " ", "are", " ", "differentiation", " ", "over", " ",
       "multiple", " ", "variables"}], ",", " ", 
     RowBox[{"make", " ", "differentiation", " ", "step", " ", "by", " ", 
      RowBox[{"step", ".", " ", "Avoid"}], " ", "empty", " ", "list"}]}], " ",
     "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mvD", "[", 
      RowBox[{"expr_", ",", 
       RowBox[{"{", "varsOfList__", "}"}]}], "]"}], ":=", 
     RowBox[{"Fold", "[", 
      RowBox[{"mvD", ",", "expr", ",", 
       RowBox[{"{", "varsOfList", "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "if", " ", "differentiation", " ", "var", " ", "is", " ", "mvDownUpIndex",
      " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "directional", " ", "derivative", " ", "independent", " ", "model", 
        " ", "case"}], ",", " ", 
       RowBox[{
       "when", " ", "no", " ", "vars", " ", "specified", " ", "for", " ", 
        "that", " ", "element"}]}], ")"}], " ", "is", " ", "zero"}], " ", 
    "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"mvD", "[", 
      RowBox[{"expr_", ",", "_mvDownUp"}], "]"}], ":=", "0"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bs", "=", 
        RowBox[{
        "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", 
         "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "if", " ", "var", " ", "is", " ", "not", " ", "coordinate", " ", 
         "variables"}], ",", " ", 
        RowBox[{"simply", " ", "differentiate"}]}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"mvD", "[", 
         RowBox[{"expr_", ",", "var_Symbol"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", "var"}], "]"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], "=!=", 
            RowBox[{"{", "}"}]}], ")"}], "&&", 
          RowBox[{"Not", "[", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{
             "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], 
             ",", "var"}], "]"}], "]"}], "&&", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", 
            RowBox[{"MV", "|", "bs", "|", "mvDOp"}], ",", 
            RowBox[{"Heads", "->", "True"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "a", " ", "specific", " ", "form", " ", "used", " ", "in", " ", 
          "independent", " ", "multivector", " ", "derivative"}], ",", " ", 
         RowBox[{
         "when", " ", "differentiation", " ", "variable", " ", "is", " ", 
          "numbered", " ", "symbol"}]}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mvD", "[", 
         RowBox[{"expr_", ",", 
          RowBox[{"s_Symbol", "[", "n_Integer", "]"}]}], "]"}], ":=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"replSymb", "=", 
             RowBox[{
              RowBox[{"ToString", "[", "s", "]"}], "<>", 
              RowBox[{"ToString", "[", "n", "]"}]}]}], ",", 
            RowBox[{"uni", "=", 
             RowBox[{"ToString", "[", 
              RowBox[{"Unique", "[", "mvDH", "]"}], "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"replUnique", "=", 
              RowBox[{"ToExpression", "[", 
               RowBox[{"replSymb", "<>", "uni"}], "]"}]}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"mvD", "[", 
              RowBox[{
               RowBox[{"expr", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"s", "[", "n", "]"}], ":>", "replUnique"}], "}"}]}],
                ",", "replUnique"}], "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{"replUnique", "->", 
               RowBox[{"s", "[", "n", "]"}]}], "}"}]}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"when", " ", "var", " ", "is", " ", "a", " ", "coordinate"}],
          ",", " ", 
         RowBox[{"use", " ", "additional", " ", "specific", " ", "rules"}]}], 
        " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mvD", "[", 
         RowBox[{"expr_", ",", "var_Symbol"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", "var"}], "]"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], "=!=", 
            RowBox[{"{", "}"}]}], ")"}], "&&", 
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{
            "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], 
            ",", "var"}], "]"}], "&&", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", 
            RowBox[{"MV", "|", "bs", "|", "mvDOp"}], ",", 
            RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
          RowBox[{"(", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"expr", ",", 
             RowBox[{"var", "[", "__", "]"}]}], "]"}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"mvD", "[", 
         RowBox[{"expr_", ",", "var_Symbol"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"alldvars", "=", 
              RowBox[{"DeleteDuplicates", "[", 
               RowBox[{"Cases", "[", 
                RowBox[{
                 RowBox[{"{", "expr", "}"}], ",", "_var", ",", "Infinity"}], 
                "]"}], "]"}]}], ",", "dvar"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
            RowBox[{
            "always", " ", "warn", " ", "when", " ", "we", " ", "use", " ", 
             "rule"}], " ", "*)"}], "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "alldvars", "]"}], "===", "1"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"dvar", "=", 
                RowBox[{"alldvars", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ";", 
               RowBox[{"printDetails", "[", 
                RowBox[{"False", ",", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{"{", 
                   RowBox[{
                   "\"\<Unconventional rule of type mvD[x[t],x]->1 was used: \
\>\"", ",", 
                    RowBox[{"\"\<mvD\>\"", "[", 
                    RowBox[{"expr", ",", "dvar"}], "]"}]}], "}"}], 
                  "\[IndentingNewLine]", "}"}]}], "]"}], ";"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Message", "[", 
                RowBox[{
                 RowBox[{"mvD", "::", "arg"}], ",", "expr", ",", "var"}], 
                "]"}], ";", 
               RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"D", "[", 
             RowBox[{"expr", ",", "dvar"}], "]"}]}]}], "\[IndentingNewLine]", 
          "]"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
            "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], "=!=", 
            RowBox[{"{", "}"}]}], ")"}], "&&", 
          RowBox[{"MemberQ", "[", 
           RowBox[{
            RowBox[{
            "gaCoordinateChartVars", "[", "gaRunningCoordinateChart", "]"}], 
            ",", "var"}], "]"}], "&&", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", 
            RowBox[{"MV", "|", "bs", "|", "mvDOp"}], ",", 
            RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
          RowBox[{"(", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"expr", ",", "var", ",", 
             RowBox[{"Heads", "->", "False"}]}], "]"}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{"!", 
            RowBox[{"FreeQ", "[", 
             RowBox[{"expr", ",", "var", ",", 
              RowBox[{"Heads", "->", "True"}]}], "]"}]}], ")"}]}]}]}], 
       ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}]}]], "Input",
 CellLabel->
  "In[1527]:=",ExpressionUUID->"442fb855-1f7e-4bdc-9459-d801ba264e33"],

Cell[TextData[{
 "To deal with operators, we introduced new head mvDOp, which is forbidden to \
differentiate. Above rules are tricky, since tries to account both \
mvD[x,x]->1 and mvD[x[t],x]->1. The last syntax allow coordinate be a \
function of scalar parameter t. ",
 StyleBox["Unintended behaviour can occur if expression mixes x and x[t]",
  FontColor->RGBColor[1, 0.5, 0]],
 "!  We  attempted to warn (see printDetails[False,...]) when the case \
mvD[x[t],x] is encountered . Differentiate x[t] with respect to x is useful \
for scalar function of vector \\vector{v(t)}={x[t],y[t],z[t]}. "
}], "Text",ExpressionUUID->"44bb557f-48c6-4c32-875b-6fd72794ecca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Map", " ", "over", " ", "Plus", " ", "keeping", " ", "arguments", " ", 
