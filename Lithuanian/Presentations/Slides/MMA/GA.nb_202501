 RowBox[{
  RowBox[{"TheContextSymbolList", "=", 
   RowBox[{"{", 
    RowBox[{
    "gaRunningAlgebra", ",", "gaRunningField", ",", "gaRunningOrdering", ",", 
     
     RowBox[{
