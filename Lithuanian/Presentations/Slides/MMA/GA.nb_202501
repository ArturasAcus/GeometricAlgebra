Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getGradeHelp", "[", "i1_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"getGradeHelp", "[", "i1", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"Length", "[", "i1", "]"}], "}"}]}]}], ";"}]], "Input",
 CellLabel->
