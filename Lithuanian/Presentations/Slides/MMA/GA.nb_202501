Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ". Representation of MV  in ",
 StyleBox["Mathematica\[CloseCurlyQuote]",
  FontSlant->"Italic"],
 "s Association form and related functions"
}], "Subsection",ExpressionUUID->"984b76d1-9eae-4bd3-a4ac-496579236fed"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". gaAssociationRepresentation[] function and their help functions "
}], "Subsubsection",ExpressionUUID->"0466cac7-5eab-48f3-bacd-ed54566a67ea"],

Cell[TextData[{
 "This section adds new internal representation of multivector (in \
orthonormal base) as an Association object (associative array) <| keys \
->values|>. This representation is  preferable when manipulating structure of \
multivector (taking components, etc...). Association representation is \
extremely convenient for fast expansion of multivector products (only down \
indices are supported). \n\nCommands ",
 StyleBox["gaAssociationRepresentation[ ]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["gaPlainRepresentation[ ]",
  FontWeight->"Bold"],
 " converts between plain and association representations (from mathematical \
point of view both of them are \[OpenCurlyDoubleQuote]additive\
\[CloseCurlyDoubleQuote] representations). \n\nImplementation notes about ",
 StyleBox["gaAssociationRepresentation[ ]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["gaPlainRepresentation[ ]",
  FontWeight->"Bold"],
 ". Conversion to Association representation is only possible when there are \
no unspecified ",
 StyleBox["MV[ ]",
  FontWeight->"Bold"],
 " multivectors.  ",
 StyleBox["gaPlainRepresentation[ ]",
  FontWeight->"Bold"],
 " realization is straight forward.  In  ",
 StyleBox["gaAssociationRepresentation[ ]",
  FontWeight->"Bold"],
 "  replacements are implemented \[OpenCurlyDoubleQuote]upside down\
\[CloseCurlyDoubleQuote], i.e. instead of ReplaceRepeated, which works from \
up level to down level (with increasing depth) to use Replace[exp,{All}], \
which goes from down to up.  When dealing with linear sum of basis elements \
(no terms with noncommutative products) we use Collect[] twice trick. First \
we collect terms at basis elements of algebra and wrap coefficients with \
formal  head ",
 StyleBox["toAssociationHelpCoefficients[]",
  FontWeight->"Bold"],
 ". Then Collect with respect to the ",
 StyleBox["toAssociationHelpCoefficients",
  FontWeight->"Bold"],
 " head, which helps to isolate scalar term, which requires special \
attention.   "
}], "Text",ExpressionUUID->"8a582aa6-5921-4051-aa26-2bf1fcf999d9"],

Cell["Complete rewrite of  commutative case 2024-10-18. ", "Text",ExpressionUUID->"eaf9010a-5a5e-4663-821f-4654dfd25b83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"toAssociationHelp", "[", 
      RowBox[{"toAssociationHelpCoefficients", "[", "field_", "]"}], "]"}], 
     "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{"Association", "@@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"mvDownUp", "[", 
         RowBox[{
          RowBox[{"{", "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], "->", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"Plus", "@@", "field"}], ",", 
          "gaNonCommutativeFieldElementPattern"}], "]"}]}], "}"}]}], ")"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"HoldPattern", "[", 
        RowBox[{"toAssociationHelp", "[", 
         RowBox[{
          RowBox[{"toAssociationHelpCoefficients", "[", "field_", "]"}], "*", 
          
          RowBox[{"bs", "[", 
           RowBox[{"keyMV_mvDownUp", ",", "other__"}], "]"}]}], "]"}], "]"}], 
       ":=", 
       RowBox[{"Association", "[", 
        RowBox[{"keyMV", "\[Rule]", "field"}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", "}"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[408]:=",ExpressionUUID->"4781a786-727a-4e83-af86-c5ec8d190ff8"],

Cell["Define conversion rules for algebra elements.", "Text",ExpressionUUID->"2bdebe0d-4a24-46e3-ac1e-7a7aa6d07cf4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"toAssociationRulesAlgebra", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "map", " ", "toAssociationHelp", " ", "on", " ", "noncommutative", " ",
         "product", " ", "terms"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"h", ":", 
              RowBox[{"(", 
               RowBox[{
               "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", 
                "|", "RightContract", "|", "LeftContract"}], ")"}]}], ")"}], 
            "[", "expr__", "]"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"toAssociationHelp", "[", 
               RowBox[{"alg", ",", "#"}], "]"}], "&"}], "/@", 
             RowBox[{"{", "expr", "}"}]}], ")"}]}], ")"}], "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{
           "toAssociationHelp", "|", "gaAssociationRepresentation"}]}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"action", " ", "on", " ", "Plus", " ", 
          RowBox[{"head", ":", " ", 
           RowBox[{
           "first", " ", "separate", " ", "field", " ", "elements"}]}]}], ",",
          " ", 
         RowBox[{
         "next", " ", "separate", " ", "pure", " ", "basis", " ", "elements", 
          " ", "from", " ", "elements", " ", "which", " ", "are", " ", 
          RowBox[{"products", ".", " ", "Transform"}], " ", "accordingly"}]}],
         " ", "*)"}], "  ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", "expr_Plus"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"allElems", "=", 
             RowBox[{"Expand", "[", 
              RowBox[{"List", "@@", "expr"}], "]"}]}], "}"}], ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"field", "=", 
               RowBox[{"Select", "[", 
                RowBox[{"allElems", ",", "gaFieldElementQ"}], "]"}]}], "}"}], 
             ",", "\[IndentingNewLine]", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"nonfield", "=", 
                 RowBox[{"Complement", "[", 
                  RowBox[{"allElems", ",", "field"}], "]"}]}], "}"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"pureElems", "=", 
                   RowBox[{"DeleteCases", "[", 
                    RowBox[{"nonfield", ",", 
                    RowBox[{"_", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Not", "[", 
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"(", 
                    RowBox[{
                    "_GeometricProduct", "|", "_OuterProduct", "|", 
                    "_InnerProduct", "|", "_RightContract", "|", 
                    "_LeftContract"}], ")"}]}], "]"}], "]"}], "&"}], 
                    ")"}]}]}], "]"}]}], "}"}], ",", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"productElems", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{"nonfield", ",", "pureElems"}], "]"}]}], "}"}], 
                   ",", "\[IndentingNewLine]", 
                   RowBox[{"Plus", "@@", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"bs", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Merge", "[", 
                    RowBox[{
                    RowBox[{"Flatten", "[", 
                    RowBox[{"{", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "field", "]"}], ">", "0"}], ",", 
                    RowBox[{"(", 
                    RowBox[{"Association", "@@", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], "->", 
                    RowBox[{"Collect", "[", 
                    RowBox[{
                    RowBox[{"Plus", "@@", "field"}], ",", 
                    "gaNonCommutativeFieldElementPattern"}], "]"}]}], "}"}]}],
                     ")"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "pureElems", "]"}], ">", "0"}], 
                    ",", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Collect", "[", 
                    RowBox[{
                    "#", ",", "toAssociationHelpCoefficients", ",", 
                    "toAssociationHelp"}], "]"}], "&"}], "/@", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Collect", "[", 
                    RowBox[{"pureElems", ",", 
                    RowBox[{"gaBasisElementPattern", "[", "alg", "]"}], ",", 
                    RowBox[{
                    RowBox[{"toAssociationHelpCoefficients", "[", "#", "]"}], 
                    "&"}]}], "]"}], "/.", 
                    RowBox[{"{", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"Plus", "[", 
                    RowBox[{"any1___", ",", 
                    RowBox[{"theBESum", ":", 
                    RowBox[{"Repeated", "[", 
                    RowBox[{
                    RowBox[{"_.", "*", 
                    RowBox[{"bs", "[", 
                    RowBox[{"keyMV_mvDownUp", ",", "alg", ",", "___"}], 
                    "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "Infinity"}], "}"}]}], "]"}]}], ",", 
                    "any2___"}], "]"}], "]"}], ":>", 
                    RowBox[{"(", 
                    RowBox[{"{", 
                    RowBox[{"any1", ",", "theBESum", ",", "any2"}], "}"}], 
                    ")"}]}], "}"}]}], ")"}]}], ")"}], "/.", 
                    RowBox[{"{", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"toAssociationHelp", "[", 
                    RowBox[{
                    RowBox[{
                    "toAssociationHelpCoefficients", "[", "field_", "]"}], 
                    "*", 
                    RowBox[{"bs", "[", 
                    RowBox[{"keyMV_Association", ",", "other__"}], "]"}]}], 
                    "]"}], "]"}], ":>", 
                    RowBox[{"Association", "@@", 
                    RowBox[{"(", 
                    RowBox[{"KeyValueMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"#1", "->", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"field", ",", "#2"}], "]"}]}], ")"}], "&"}], ",", 
                    "keyMV"}], "]"}], ")"}]}]}], "}"}]}], ")"}], 
                    "\[IndentingNewLine]", ",", 
                    RowBox[{"{", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
                    "}"}], "]"}], ",", "Total"}], "]"}], ",", 
                    "\[IndentingNewLine]", "alg"}], "]"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", "productElems", "]"}], ">", "0"}], 
                    ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"toAssociationHelp", "[", 
                    RowBox[{"alg", ",", "#"}], "]"}], "&"}], "/@", 
                    RowBox[{"(", 
                    RowBox[{"(", 
                    RowBox[{"productElems", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"a__", ",", "b_", ",", "other___"}], "]"}], "]"}],
                     ":>", 
                    RowBox[{"RuleCondition", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{
                    RowBox[{"toAssociationHelp", "[", 
                    RowBox[{"alg", ",", 
                    RowBox[{"GeometricProduct", "[", "a", "]"}]}], "]"}], ",", 
                    RowBox[{"(", 
                    RowBox[{"toAssociationHelp", "[", 
                    RowBox[{"alg", ",", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"b", ",", "other"}], "]"}]}], "]"}], ")"}]}], 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"gaNonCommutativeFieldElementQ", "[", 
                    RowBox[{"{", "a", "}"}], "]"}], "&&", 
                    RowBox[{"Not", "[", 
                    RowBox[{"gaFieldElementQ", "[", 
                    RowBox[{"{", "b", "}"}], "]"}], "]"}]}]}], "]"}]}], 
                    "}"}]}], ")"}], ")"}]}], ",", "Nothing"}], "]"}]}], 
                    "\[IndentingNewLine]", "}"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"bs", "[", 
                    RowBox[{
                    RowBox[{"Association", "[", "]"}], ",", "___"}], "]"}], ":>",
                     "Nothing"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
                  "]"}]}], "\[IndentingNewLine]", "]"}]}], 
              "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
          "\[IndentingNewLine]", "]"}], "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{
           "toAssociationHelp", "|", "gaAssociationRepresentation"}]}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "algebra", " ", "elements", " ", "to", " ", "Association", " ", 
         "representation"}], " ", "*)"}], "  ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"keyMV_mvDownUp", ",", "alg_", ",", "other___"}], "]"}]}],
           "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"bs", "[", 
          RowBox[{
           RowBox[{"Association", "[", 
            RowBox[{"keyMV", "\[Rule]", "1"}], "]"}], ",", "alg", ",", 
           "other"}], "]"}], "/;", 
         RowBox[{"Not", "[", 
          RowBox[{"gaFieldElementQ", "[", 
           RowBox[{"bs", "[", 
            RowBox[{"keyMV", ",", "alg", ",", "other"}], "]"}], "]"}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{"Times", "[", 
            RowBox[{"fieldElem_", ",", 
             RowBox[{"bs", "[", 
              RowBox[{"keyMV_mvDownUp", ",", "alg_", ",", "other___"}], 
              "]"}]}], "]"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"bs", "[", 
          RowBox[{
           RowBox[{"Association", "[", 
            RowBox[{"keyMV", "\[Rule]", "fieldElem"}], "]"}], ",", "alg", ",",
            "other"}], "]"}], "/;", 
         RowBox[{
          RowBox[{"gaFieldElementQ", "[", "fieldElem", "]"}], "&&", 
          RowBox[{"Not", "[", 
           RowBox[{"gaFieldElementQ", "[", 
            RowBox[{"bs", "[", 
             RowBox[{"keyMV", ",", "alg", ",", "other"}], "]"}], "]"}], 
           "]"}]}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "field", " ", "elements", " ", "to", " ", "Association", " ", 
         "representation"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", "fieldElem_bs"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"bs", "[", 
          RowBox[{
           RowBox[{"Association", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], "\[Rule]", "fieldElem"}], "]"}], 
           ",", "alg"}], "]"}], "/;", 
         RowBox[{"gaNonCommutativeFieldElementQ", "[", "fieldElem", "]"}]}]}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "since", " ", "in", " ", "Plus", " ", "rules", " ", "we", " ", 
          "nest", " ", "toAssociationHelp", " ", "header"}], ",", " ", 
         RowBox[{
         "further", " ", "evaluation", " ", "will", " ", "stop", " ", 
          "unless", " ", "we", " ", "define", " ", "unnesting", " ", 
          "rule"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{"bs", "[", 
            RowBox[{"keyMV_Association", ",", "other___"}], "]"}]}], "]"}], 
         "]"}], ":>", 
        RowBox[{"bs", "[", 
         RowBox[{"keyMV", ",", "other"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "rule", " ", "to", " ", "move", " ", "commutative", " ", "factor", 
         " ", "in", " ", "Times", " ", "into", " ", "closest", " ", 
         "noncommutative", " ", "Association"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{"Times", "[", 
            RowBox[{"anyfactor_", ",", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"h", ":", 
                RowBox[{"(", 
                 RowBox[{
                 "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct",
                   "|", "RightContract", "|", "LeftContract"}], ")"}]}], 
               ")"}], "[", 
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{"keyMV_Association", ",", "other___"}], "]"}], ",", 
               "restArg__"}], "]"}]}], "]"}]}], "]"}], "]"}], ":>", 
        RowBox[{"h", "[", 
         RowBox[{
          RowBox[{"bs", "[", 
           RowBox[{
            RowBox[{"anyfactor", "*", "keyMV"}], ",", "other"}], "]"}], ",", 
          "restArg"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "if", " ", "move", " ", "commutative", " ", "factor", " ", "in", " ",
           "Times", " ", "into", " ", "closest", " ", "noncommutative", " ", 
          "Association", " ", "is", " ", "not", " ", "possible"}], ",", " ", 
         RowBox[{"convert", " ", "it", " ", "to", " ", "Association"}]}], " ",
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"toAssociationHelp", "[", 
          RowBox[{"alg_", ",", 
           RowBox[{"Times", "[", 
            RowBox[{"fieldElem_", ",", 
             RowBox[{"h", ":", 
              RowBox[{"(", 
               RowBox[{
               "_Plus", "|", "_GeometricProduct", "|", "_OuterProduct", "|", 
                "_InnerProduct", "|", "_LeftContract", "|", 
                "_RightContract"}], ")"}]}]}], "]"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"GeometricProduct", "[", 
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"Association", "[", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{
                 RowBox[{"{", "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}], "\[Rule]", 
               RowBox[{"Times", "[", "fieldElem", "]"}]}], "]"}], ",", 
             "alg"}], "]"}], ",", 
           RowBox[{"toAssociationHelp", "[", 
            RowBox[{"alg", ",", "h"}], "]"}]}], "]"}], "/;", 
         RowBox[{"gaFieldElementQ", "[", "fieldElem", "]"}]}]}]}], 
      "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[410]:=",ExpressionUUID->"518ad1bc-7c15-4f37-9730-c9b4d0bd16b4"],

Cell["Define conversion rules and function for field elements.", "Text",ExpressionUUID->"a08f7623-97ad-4ec1-a07e-c9d6abf0525f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"toAssociationRulesField", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
     ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "map", " ", "toAssociationHelp", " ", "on", " ", "noncommutative", " ",
         "product", " ", "terms"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"fieldToAssociationHelp", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"h", ":", 
             RowBox[{"(", "GeometricProduct", ")"}]}], ")"}], "[", "expr__", 
           "]"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", "@@", 
           RowBox[{"(", 
            RowBox[{
