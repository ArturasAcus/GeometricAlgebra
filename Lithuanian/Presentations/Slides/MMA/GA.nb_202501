Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"basisSymbol", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Don", "'"}], "t", " ", "count", " ", "grade", " ", "of", " ", 
      "noncommutative", " ", "field", " ", "elements"}], " ", "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGradeList", "[", 
       RowBox[{"HoldPattern", "[", 
        RowBox[{"basisSymbol", "[", 
         RowBox[{
          RowBox[{"mvDownUp", "[", 
           RowBox[{
            RowBox[{"{", "i1___Integer", "}"}], ",", 
            RowBox[{"{", "j1___Integer", "}"}]}], "]"}], ",", "al_", ",", 
          "any___"}], "]"}], "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"getGradeHelp", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"{", 
          RowBox[{"i1", ",", "j1"}], "}"}], "]"}], "]"}], "/;", 
       RowBox[{"MatchQ", "[", 
        RowBox[{
         RowBox[{"basisSymbol", "[", 
          RowBox[{
           RowBox[{"mvDownUp", "[", 
            RowBox[{
             RowBox[{"{", "i1", "}"}], ",", 
             RowBox[{"{", "j1", "}"}]}], "]"}], ",", "al", ",", "any"}], 
          "]"}], ",", 
         RowBox[{"gaBasisElementPattern", "[", "al", "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "manifold", " ", "MVs", " ", "have", " ", "the", " ", "same", " ", 
       "grades", " ", "as", " ", "plain", " ", "MV"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gaGradeList", "[", 
       RowBox[{"HoldPattern", "[", 
        RowBox[{
         RowBox[{"basisSymbol", "[", "args__", "]"}], "[", "coord_mvPoint", 
         "]"}], "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"gaGradeList", "[", 
        RowBox[{"basisSymbol", "[", "args", "]"}], "]"}], "/;", 
       RowBox[{"Not", "[", 
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"basisSymbol", "[", "args", "]"}], ",", 
          "gaNonCommutativeFieldElementPattern"}], "]"}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "slightly", " ", "extend", " ", "the", " ", "definition", " ", "to", 
       " ", "basis", " ", "elements", " ", "multiplied", " ", "by", " ", 
       "field", " ", "element"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaGradeList", "[", 
        RowBox[{"c_", "*", 
         RowBox[{"basisSymbol", "[", "ar__", "]"}]}], "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"gaGradeList", "[", 
        RowBox[{"basisSymbol", "[", "ar", "]"}], "]"}], "/;", 
       RowBox[{"gaFieldElementQ", "[", "c", "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"the", " ", "Association", " ", "case"}], " ", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"gaGradeList", "[", 
        RowBox[{"basisSymbol", "[", 
         RowBox[{"mv_Association", ",", "__"}], "]"}], "]"}], "]"}], ":=", 
      RowBox[{"Union", "[", 
       RowBox[{"Length", "/@", 
        RowBox[{"Flatten", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Keys", "[", 
            RowBox[{"gaAssociationRepresentationClean", "[", "mv", "]"}], 
            "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{"mvDownUp", "\[Rule]", "List"}], "}"}]}], ")"}]}]}], 
       "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellLabel->
  "In[274]:=",ExpressionUUID->"a9324bd4-cf17-4377-8267-91d6b66ce402"],

Cell["\<\
Now extend computation of grade to general expressions, which are not in \
Association form\
\>", "Text",ExpressionUUID->"a0e0ac53-c9c0-456b-92a1-71c0f5fb30f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"gaGradeList", "[", 
      RowBox[{"_", "?", "NumericQ"}], "]"}], "]"}], ":=", 
    RowBox[{"{", "0", "}"}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"first", " ", "simple", " ", "rule", " ", "for", " ", "speed"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"gaGradeList", "[", "expr_", "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"{", "0", "}"}], "/;", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaFieldElementQ", "[", "expr", "]"}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "expr", "}"}], ",", 
         RowBox[{"MV", "|", "Association"}]}], "]"}]}], ")"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "only", " ", "multivectors", " ", "are", " ", "graded", " ", "elements"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"gaGradeList", "[", 
      RowBox[{"Times", "[", 
       RowBox[{"c_", ",", "d__"}], "]"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"gaGradeList", "[", 
      RowBox[{"Times", "[", "d", "]"}], "]"}], "/;", 
     RowBox[{"gaFieldElementQ", "[", "c", "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"If", " ", "expression", " ", "is", " ", "expanded"}], ",", " ", 
    RowBox[{"then", " ", 
     RowBox[{"(", 
      RowBox[{
      "unless", " ", "expr", " ", "contains", " ", "GA", " ", "products"}], 
      ")"}], " ", "Plus", " ", "means", " ", "that", " ", "in", " ", 
     "general", " ", "we", " ", "have", " ", "a", " ", "non", " ", 
     "homogeneus", " ", "multivector"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"gaGradeList", "[", 
      RowBox[{"Plus", "[", "x__", "]"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"gaGradeList", "/@", 
        RowBox[{"{", "x", "}"}]}], "]"}], "]"}], "/;", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", 
       RowBox[{"(", 
        RowBox[{
        "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
         "LeftContract", "|", "RightContract", "|", "MV"}], ")"}], ",", 
       RowBox[{"Heads", "->", "True"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "for", " ", "general", " ", "expression", " ", "convert", " ", "to", " ", 
     "Association", " ", "and", " ", "expand"}], ",", " ", 
    RowBox[{
    "when", " ", "there", " ", "are", " ", "no", " ", "general", " ", 
     RowBox[{"MV", "[", "]"}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Abort", "[", " ", "]"}], " ", "if", " ", "catch", " ", 
    RowBox[{"gaUnfinished", "[", " ", "]"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"basisSymbol", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaGradeList", "[", "expr_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"converted", "=", 
           RowBox[{"gaAssociationRepresentation", "[", "expr", "]"}]}], ",", 
          "expandedAssoc"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "if", " ", "head", " ", "is", " ", "not", " ", "gaUnfinished"}], 
          ",", " ", 
          RowBox[{"we", " ", "compute", " ", "further"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", "converted", "]"}], "===", "gaUnfinished"}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{
             RowBox[{"gaGradeList", "::", "Association"}], ",", 
             RowBox[{"Hold", "[", "expr", "]"}]}], "]"}], ";", 
           RowBox[{"Hold", "[", "expr", "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "expand", " ", "answer", " ", "and", " ", "check", " ", "if", " ", 
            "it", " ", "is", " ", "of", " ", "Association", " ", "form"}], 
           " ", "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"expandedAssoc", "=", 
            RowBox[{"gaPE", "[", "converted", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MatchQ", "[", 
              RowBox[{"expandedAssoc", ",", 
               RowBox[{"basisSymbol", "[", 
                RowBox[{"mv_Association", ",", "__"}], "]"}]}], "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "call", " ", "the", " ", "function", " ", "once", " ", "more", 
               " ", "on", " ", "specialized", " ", "input"}], " ", "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{"gaGradeList", "[", "expandedAssoc", "]"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{"else", " ", "hold", " ", "computations"}], " ", "*)"}],
              "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Message", "[", 
               RowBox[{
                RowBox[{"gaGradeList", "::", "ProductExpand"}], ",", 
                "converted"}], "]"}], ";", 
              RowBox[{"Hold", "[", 
               RowBox[{"gaGradeList", "[", "expandedAssoc", "]"}], "]"}], 
              ";"}]}], "\[IndentingNewLine]", "]"}]}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"expr", ",", 
        RowBox[{"MV", "|", "Association"}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]}], "Input",
 CellLabel->
  "In[275]:=",ExpressionUUID->"31099284-9089-4878-b327-9dc5d024f9b7"],

