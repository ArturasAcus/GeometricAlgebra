              "]"}], ":>", 
             RowBox[{"gaTensorProduct", "[", 
              RowBox[{"a", ",", "b", ",", "c"}], "]"}]}], "}"}]}]}], ",", 
         RowBox[{"alreadyCalculatedProducts", "=", 
          RowBox[{"(", 
           RowBox[{
