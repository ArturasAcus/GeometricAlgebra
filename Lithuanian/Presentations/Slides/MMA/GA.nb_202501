       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"#1", "-", 
           RowBox[{"I", "*", "#2"}]}], "]"}], "===", "0"}], ")"}]}], "&"}], 
     ")"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
