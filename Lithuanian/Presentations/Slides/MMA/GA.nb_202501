  "In[1372]:=",ExpressionUUID->"002f96ed-a34e-4352-9d56-67892d989d8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"functionOfMVMinimalPolynomial", "[", 
   RowBox[{"thefunction_", ",", "exprExpanded_", ",", 
    RowBox[{"{", 
     RowBox[{"quiet_", ",", "expandFunction_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"theAlg", "=", 
       RowBox[{"gaGetAlgebra", "[", "exprExpanded", "]"}]}], ",", "var", ",", 
      "minPoly", ",", "minPolyPFD", ",", "maxDerivative", ",", 
      "derivativeTable", ",", "rpqList", ",", "answer"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Using Method->\>\"", ",", "\"\<MinimalPolynomial\>\""}], "}"}],
          ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Using Expand function->\>\"", ",", "expandFunction"}], 
          "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minPoly", "=", 
      RowBox[{"gaMinimalPolynomial", "[", 
       RowBox[{"exprExpanded", ",", "var", ",", 
        RowBox[{"Method", "->", "\"\<GA\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<MinimalPolynomial is\>\"", ",", "minPoly"}], "}"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minPolyPFD", "=", 
      RowBox[{"gaMinimalPolynomialPartialFractionDecompose", "[", 
       RowBox[{
        RowBox[{"Factor", "[", "minPoly", "]"}], ",", " ", "var"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"maxDerivative", "=", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}], "/@", 
         "minPolyPFD"}], "]"}], "-", "1"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Maximal root multiplicity-1 is \>\"", ",", "maxDerivative"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Partial fraction decomposition {{root_i, \
{p_i,q_i,q^2_i,q^3_i,...}}...} yields\>\"", ",", "minPolyPFD"}], "}"}]}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"thefunction", "===", "Identity"}], ",", "\[IndentingNewLine]", 
       RowBox[{"derivativeTable", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"maxDerivative", "-", "1"}]}], "}"}]}], "]"}]}], "}"}],
          "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"derivativeTable", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"Factorial", "[", "k", "]"}]}], ")"}], "*", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"thefunction", "[", 
               RowBox[{"\[FormalLambda]", "+", "var"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"var", ",", "k"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "maxDerivative"}], "}"}]}], "]"}], "/.", 
         RowBox[{"var", "->", "0"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rpqList", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"minPolyPFD", "/.", 
            RowBox[{"{", 
             RowBox[{"var", "->", 
              RowBox[{"MV", "[", "var", "]"}]}], "}"}]}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{"Times", "->", "GeometricProduct"}], "}"}]}], ")"}], "/.", 
        
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Power", "[", 
           RowBox[{"any_", ",", 
            RowBox[{"k_Integer", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">", "0"}], "&"}], ")"}]}]}], "]"}], ":>", 
          RowBox[{"GeometricProduct", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{"any", ",", 
             RowBox[{"{", "k", "}"}]}], "]"}]}]}], "}"}]}], ")"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "once", " ", "all", " ", "above", " ", "data", " ", "computed", " ", 
       "we", " ", "are", " ", "ready", " ", "to", " ", "produce", " ", 
       "final", " ", "result", " ", "according", " ", "to", " ", "options"}], 
      " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"answer", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"thefunction", "[", 
             RowBox[{
              RowBox[{"rpqList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "\[GeometricProduct]", 
            RowBox[{
             RowBox[{
              RowBox[{"rpqList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"derivativeTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"q", "-", "1"}], "]"}], "]"}], "/.", 
                RowBox[{"{", 
                 RowBox[{"\[FormalLambda]", "->", 
                  RowBox[{
                   RowBox[{"rpqList", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ")"}], 
              "\[GeometricProduct]", 
              RowBox[{
               RowBox[{
                RowBox[{"rpqList", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "[", 
               RowBox[{"[", "q", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"q", ",", "2", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                 RowBox[{"rpqList", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
          ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "rpqList", "]"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"MV", "[", "var", "]"}], "->", "exprExpanded"}], "}"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"expandFunction", "===", "False"}], ",", "answer", ",", 
       RowBox[{"expandFunction", "[", "answer", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1373]:=",ExpressionUUID->"365dd8e8-4c47-47ea-a929-cfba2081ffde"]
}, Closed]],

