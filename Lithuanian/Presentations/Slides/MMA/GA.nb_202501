                    RowBox[{"{", 
                    RowBox[{"singleton", "->", "Identity"}], "}"}]}], ")"}], 
                    "]"}], "]"}], "&"}], ")"}]}], "]"}], ",", 
                    RowBox[{"(", 
                    RowBox[{"argh", "===", 
                    RowBox[{"Head", "[", "h", "]"}]}], ")"}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"argh_", "[", 
                    RowBox[{"arg1_Plus", ",", "arg2_"}], "]"}], 
                    "\[RuleDelayed]", 
                    RowBox[{"RuleCondition", "[", 
                    RowBox[{
                    RowBox[{"Collect", "[", 
                    RowBox[{
                    RowBox[{"Distribute", "[", 
                    RowBox[{"argh", "[", 
                    RowBox[{
                    RowBox[{"Expand", "[", "arg1", "]"}], ",", "arg2"}], 
                    "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"_bs", ",", 
                    RowBox[{"_bs", "[", "_", "]"}]}], "}"}], ",", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"singleton", "[", 
                    RowBox[{"sftrue", "[", 
                    RowBox[{"(", 
                    RowBox[{"#", "/.", 
                    RowBox[{"{", 
                    RowBox[{"singleton", "->", "Identity"}], "}"}]}], ")"}], 
                    "]"}], "]"}], "&"}], ")"}]}], "]"}], ",", 
                    RowBox[{"(", 
