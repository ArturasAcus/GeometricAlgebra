          " ", "constants"}], ",", " ", 
         RowBox[{"we", " ", "differently", " ", "define", " ", "function"}], 
         ",", " ", 
         RowBox[{"which", " ", "handle", " ", "periodic", " ", "argument"}]}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "includeFree"}], ",", "\[IndentingNewLine]", 
