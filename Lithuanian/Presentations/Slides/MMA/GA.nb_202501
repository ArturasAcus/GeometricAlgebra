                "using", " ", "chosen", " ", "method"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"Switch", "[", 
               RowBox[{
                RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], ",", 
                "\[IndentingNewLine]", 
