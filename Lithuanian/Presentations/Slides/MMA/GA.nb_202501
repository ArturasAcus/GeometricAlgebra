 RowBox[{
  RowBox[{"wrapBraces", "[", 
   RowBox[{"x_", ",", "wrapHeads_List", ",", 
    RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{"wrapHeads", ",", 
      RowBox[{"Head", "[", "x", "]"}]}], "]"}], ",", 
    RowBox[{"RowBox", "[", 
     RowBox[{"{", 
      RowBox[{"\"\<(\>\"", ",", 
       RowBox[{"MakeBoxes", "[", 
        RowBox[{"x", ",", "sf"}], "]"}], ",", "\"\<)\>\""}], "}"}], "]"}], 
    ",", 
    RowBox[{"RowBox", "[", 
     RowBox[{"{", 
      RowBox[{"MakeBoxes", "[", 
       RowBox[{"x", ",", "sf"}], "]"}], "}"}], "]"}]}], "]"}]}]], "Input",
 CellLabel->
