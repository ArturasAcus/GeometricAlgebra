             "\[IndentingNewLine]", 
             RowBox[{"FixedPoint", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ReplaceAll", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"{", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"argh_", "[", 
                    RowBox[{"arg1_", ",", "arg2_Plus"}], "]"}], 
                    "\[RuleDelayed]", 
                    RowBox[{"RuleCondition", "[", 
                    RowBox[{
                    RowBox[{"Collect", "[", 
                    RowBox[{
                    RowBox[{"Distribute", "[", 
                    RowBox[{"argh", "[", 
                    RowBox[{"arg1", ",", 
                    RowBox[{"Expand", "[", "arg2", "]"}]}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"_bs", ",", 
                    RowBox[{"_bs", "[", "_", "]"}]}], "}"}], ",", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"singleton", "[", 
