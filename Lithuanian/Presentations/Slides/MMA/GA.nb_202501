  "In[1573]:=",ExpressionUUID->"e1311ddb-a829-4d65-8c05-0838827d0e25"],

Cell["\<\
In order the above rules take into account pure differential operators (with \
empty argument: gaDerivativeArgument[id_][]) we temporally provide them with \
argument mvDOp[MV[]], which will be turned back to \
gaDerivativeArgument[id_][] after all \
gaMultivectorDerivative[theId][reciprocalVectors,primaryVectors] and \
gaDerivativeArgument[id_][___] were paired. Note that after pairing part of \
gaDerivativeArgument[id_][] were replaced by mvDOp[MV[]] (so, it became \
scalar differential operators). \
\>", "Text",ExpressionUUID->"c291bb37-44b3-414c-a1e2-e8dd281f0027"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"emptyDerivativeArgumentRulesBeforePairing", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", "]"}], ":>", 
      RowBox[{
       RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
       RowBox[{"mvDOp", "[", 
        RowBox[{"MV", "[", "]"}], "]"}], "]"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"below", " ", "HoldPattern", " ", "is", " ", "mandatory"}], ",", 
    " ", 
    RowBox[{"otherwise", " ", 
     RowBox[{"mvDOp", "[", 
      RowBox[{"MV", "[", "]"}], "]"}], " ", "will", " ", "immediatelly", " ", 
     "will", " ", "be", " ", "replaced", " ", "by", " ", "1", " ", "and", " ",
      "we", " ", "get", " ", "pure", " ", 
     RowBox[{"operator", "!"}]}], ",", " ", 
    RowBox[{"which", " ", "is", " ", "error"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"emptyDerivativeArgumentRulesAfterPairing", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{
       RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", 
       RowBox[{"mvDOp", "[", 
        RowBox[{"MV", "[", "]"}], "]"}], "]"}], "]"}], ":>", 
     RowBox[{
      RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", "]"}]}], "}"}]}],
   ";"}]}], "Input",
 CellLabel->
  "In[1574]:=",ExpressionUUID->"4355f957-65f6-4f30-9f4c-493be86f7fcf"],

Cell["\<\
These are rather complicated rules, which deserves some explanation. 
1) Rules are started to apply from most outer level (as indicated by  \
Replace[, All], see above )
2) Computation can be associated either with head of gaMultivectorDerivative \
or of gaDerivativeArgument, depending which head is detected in the outer \
level (this is explicitly indicated by rule list name) 
3) When gaMultivectorDerivative is detected in the outer level (somehow a bit \
simpler case) we replace gaMultivectorDerivative by sum over basis elements. \
In particular gaMultivectorDerivative is replaced by the basis vector and the \
gaDerivativeArgument by gaDirectionalDerivative[] along that basis vector \
(for scalar this is just partial derivative with respect to corresponding \
coordinate).\
\>", "Text",ExpressionUUID->"5421def1-31ca-4931-ad09-1df8b2c9b76b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "rulesInsideAllProductsAssociatedWithMultivectorDerivative", "=", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"(*", " ", 
     RowBox[{"vector", " ", "derivative", " ", "case"}], "*)"}], " ", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", ":", 
         RowBox[{"(", 
          RowBox[{
          "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
           "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
       RowBox[{"args1___", ",", 
        RowBox[{
         RowBox[{"gaMultivectorDerivative", "[", "id_", "]"}], "[", 
         RowBox[{"rbasis_", ",", "pbasis_"}], "]"}], ",", "args3___", ",", 
        RowBox[{"partWithDerivativeArgument_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"{", "#", "}"}], ",", 
              RowBox[{
               RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", "___", 
               "]"}]}], "]"}], "]"}], "&"}], ")"}]}], ",", "args5___"}], 
       "]"}], ":>", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"theBasisLength", "=", 
            RowBox[{"Length", "[", "rbasis", "]"}]}], ",", 
           RowBox[{"theVars", "=", 
            RowBox[{
             RowBox[{"FirstCase", "[", 
              RowBox[{"rbasis", ",", "_mvPoint", ",", 
               RowBox[{
                RowBox[{
                "Echo", "[", 
                 "\"\<Error in \
rulesInsideAllProductsAssociatedWithMultivectorDerivative 1\>\"", "]"}], ";", 
                
                RowBox[{"Abort", "[", "]"}]}], ",", "Infinity"}], "]"}], "[", 
             
             RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"h", "[", 
            RowBox[{"args1", ",", 
             RowBox[{"rbasis", "[", 
              RowBox[{"[", "ipart", "]"}], "]"}], ",", "args3", ",", 
             RowBox[{"(", 
              RowBox[{"partWithDerivativeArgument", "/.", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{"(*", " ", 
                 RowBox[{
                  RowBox[{
                  "if", " ", "argument", " ", "is", " ", "not", " ", "empty", 
                   " ", 
                   RowBox[{"(", 
                    RowBox[{"not", " ", "operator"}], ")"}]}], ",", " ", 
                  RowBox[{
                  "we", " ", "use", " ", "directional", " ", "derivative", 
                   " ", "with", " ", "down", " ", "vector"}]}], " ", "*)"}], 
                "\[IndentingNewLine]", 
                RowBox[{"(*", " ", 
                 RowBox[{
                 "if", " ", "derivative", " ", "argument", " ", "is", " ", 
                  "empty", " ", 
                  RowBox[{"(", 
                   RowBox[{"operator", " ", "case"}], ")"}], " ", "replace", 
                  " ", "by", " ", "symbolic", " ", 
                  RowBox[{"mvDOp", "[", "symbols__", "]"}]}], " ", "*)"}], 
                "   ", "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                   "theDArg_", "]"}], ":>", 
                  RowBox[{"gaDirectionalDerivative", "[", 
                   RowBox[{"theDArg", ",", 
