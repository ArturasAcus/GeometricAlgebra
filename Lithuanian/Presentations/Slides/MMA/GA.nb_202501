                RowBox[{"Sinh", "[", 
                 RowBox[{"Sqrt", "[", "q2", "]"}], "]"}]}]}], ")"}]}]}], ",", 
           
           RowBox[{"positiveQ", "[", "q2", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "}"}], "]"}]}]}], "\[IndentingNewLine]", "]"}],
    "/;", 
