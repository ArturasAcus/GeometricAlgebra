                    RowBox[{"{", "opts", "}"}], ",", 
                    RowBox[{"Options", "[", "gaHermitianConjugate", "]"}]}], 
                   "]"}]}], ")"}]}], "]"}], "]"}], "\[GeometricProduct]", 
             "expr"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
