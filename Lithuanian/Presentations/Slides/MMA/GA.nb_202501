              "\[GeometricProduct]", 
              RowBox[{"gaI", "[", "alg", "]"}]}]}], "]"}], "=!=", "0"}], 
          ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"testTrigonometric", "::", "notpossible"}], ",", "alg"}], 
         "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
