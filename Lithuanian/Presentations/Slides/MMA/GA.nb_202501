Cell[TextData[{
 "The ",
 StyleBox[" InnerProduct[ ] ",
  FontWeight->"Bold"],
 "treats scalars differently! If singlet appears in ",
 StyleBox["InnerProduct[ ]",
  FontWeight->"Bold"],
 ", this means we had multiplication with scalar. Then result should be set \
to zero."
}], "Text",ExpressionUUID->"0f74d4ad-5b8d-498a-a244-85d3981dcd46"],

