Cell["\<\
Rules that are associated with gaDerivativeArgument[], when it appears first \
at the outer level.  When gaDerivativeArgument has no argument we assume it \
is a pure differential operator and replace it with mvDOp[] \
\>", "Text",ExpressionUUID->"9a12deff-0b83-4374-b6a8-3ed5da874452"],

Cell[BoxData[
 RowBox[{
  RowBox[{
  "rulesInsideAllProductsAssociatedWithDerivativeArgument", "=", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", ":", 
         RowBox[{"(", 
          RowBox[{
          "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
           "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
       RowBox[{"args1___", ",", 
        RowBox[{
         RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", 
         "theDerivArg_", "]"}], ",", "args3___", ",", 
        RowBox[{"partWithMultivectorDerivative_", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"{", "#", "}"}], ",", 
              RowBox[{
               RowBox[{"gaMultivectorDerivative", "[", "id_", "]"}], "[", 
               RowBox[{"_", ",", "_"}], "]"}]}], "]"}], "]"}], "&"}], ")"}]}],
         ",", "args5___"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"basis", "=", 
           RowBox[{"FirstCase", "[", 
            RowBox[{
             RowBox[{"{", "partWithMultivectorDerivative", "}"}], ",", 
             RowBox[{
              RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
              RowBox[{"_", ",", "_"}], "]"}], ",", 
             RowBox[{
              RowBox[{
              "Echo", "[", 
               "\"\<Error in \
rulesInsideAllProductsAssociatedWithDerivativeArgument 1\>\"", "]"}], ";", 
              RowBox[{"Abort", "[", "]"}]}], ",", "Infinity"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"(", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"args1", ",", 
              RowBox[{"gaDirectionalDerivative", "[", 
               RowBox[{"theDerivArg", ",", 
                RowBox[{
                 RowBox[{"basis", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "[", 
                 RowBox[{"[", "ipart", "]"}], "]"}]}], "]"}], ",", "args3", 
              ",", 
              RowBox[{"(", 
               RowBox[{"partWithMultivectorDerivative", "/.", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
                   RowBox[{"_", ",", "_"}], "]"}], ":>", 
                  RowBox[{
                   RowBox[{"basis", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", 
                   RowBox[{"[", "ipart", "]"}], "]"}]}], "}"}]}], 
               "\[IndentingNewLine]", ")"}], ",", "args5"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"ipart", ",", "1", ",", 
              RowBox[{"Length", "[", 
               RowBox[{"basis", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
          ")"}]}], "]"}], "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"args1", ",", "args3", ",", "args5"}], "}"}], ",", "id", 
           ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{
            "partWithMultivectorDerivative", ",", "id", ",", "Infinity", ",", 
             
             RowBox[{"Heads", "->", "True"}]}], "]"}], "===", "1"}], ")"}]}], 
        ")"}]}]}], ",", "\[IndentingNewLine]", 
