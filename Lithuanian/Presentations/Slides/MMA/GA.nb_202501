       RowBox[{"{", 
        RowBox[{"var1", ",", "var2"}], "}"}], "]"}], "]"}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[1578]:=",ExpressionUUID->"29514d27-750c-4272-bd24-4f2ce0127750"],

