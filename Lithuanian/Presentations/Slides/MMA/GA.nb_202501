Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bs", "=", 
     RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toCliffordMatrix", "[", 
     RowBox[{"expr_", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"alg_Cl", ",", "quietOpt_"}], "}"}]}], "}"}]}], "]"}], ":=", 
    
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "basisAlg", ",", "indicesThatChanges", ",", "algNew", ",", 
        "basisAlgNew", ",", "isomorphismRulesVectors", ",", "nonTrivial", ",",
         "fullReplacementRules"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "for", " ", "original", " ", "algebra", " ", "we", " ", "need", " ", 
        "full", " ", "basis"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"gaOrthonormalBasis", "[", 
             RowBox[{"alg", ",", "\"\<InvDeg[Lex]\>\""}], "]"}], "]"}], "===",
            "gaOrthonormalBasis"}], ")"}], ",", 
         RowBox[{"basisAlg", "=", 
