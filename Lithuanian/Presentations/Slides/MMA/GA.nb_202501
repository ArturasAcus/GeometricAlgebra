Cell["\<\
We introduce a number of new symbols here and since we don\[CloseCurlyQuote]t \
want to forward all these symbols, we chose to define notations for them here \
and not in special notation section 4.1 above. \
\>", "Text",ExpressionUUID->"171a8f65-ebe7-4733-b24e-d1a4780e36b5"],

Cell["\<\
Single mvGenDownUp is intended to make index boxes without any other purpose \
(used in mvDOp[] )\
\>", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"31411fe8-6b7a-4575-bc03-358113593542"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"mvGenDownUp", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"indown", ":", 
         RowBox[{"(", 
          RowBox[{"___Integer", "|", "___Symbol"}], ")"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"inup", ":", 
         RowBox[{"(", 
          RowBox[{"___Integer", "|", "___Symbol"}], ")"}]}], "}"}]}], "]"}], 
     ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"argsa", "=", 
       RowBox[{"Riffle", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"Rest", "/@", 
           RowBox[{"Sort", "[", "\[IndentingNewLine]", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"indown", ",", "inup"}], "}"}], ",", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"AdjustmentBox", "[", 
                    RowBox[{
                    RowBox[{"Slot", "[", "i", "]"}], ",", 
                    RowBox[{"BoxBaselineShift", "\[Rule]", "1"}]}], "]"}], 
                   ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "indown", "}"}], "]"}]}], "}"}]}], "]"}], 
                 ",", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"AdjustmentBox", "[", 
                    RowBox[{
                    RowBox[{"Slot", "[", "i", "]"}], ",", 
                    RowBox[{"BoxBaselineShift", "\[Rule]", 
                    RowBox[{"-", "1"}]}]}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "indown", "}"}], "]"}], "+", "1"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", 
                    RowBox[{"indown", ",", "inup"}], "}"}], "]"}]}], "}"}]}], 
                  "]"}]}], "]"}]}], "}"}], "]"}], "\[IndentingNewLine]", 
            "]"}]}], "]"}], ",", "\"\<,\>\""}], "]"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pfd", "=", "\[IndentingNewLine]", 
          RowBox[{"Function", "[", 
           RowBox[{"StyleBox", "[", 
            RowBox[{
             RowBox[{"RowBox", "[", "argsa", "]"}], ",", 
             RowBox[{"FontSize", "\[Rule]", "Small"}], ",", 
             RowBox[{"FontTracking", "->", "\"\<Condensed\>\""}], ",", 
             RowBox[{"AutoSpacing", "\[Rule]", "False"}]}], "]"}], "]"}]}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{"pfi", "=", 
          RowBox[{
           RowBox[{"ReleaseHold", "[", 
            RowBox[{"RowBox", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<mvGenDownUp\>\"", ",", "\"\<@@\>\"", ",", 
               RowBox[{"MakeExpression", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"{", "##", "}"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "indown", "}"}], "]"}]}], "]"}], ",", 
                   RowBox[{"Take", "[", 
                    RowBox[{
                    RowBox[{"{", "##", "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "indown", "}"}], "]"}], "+", "1"}], ",", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", 
                    RowBox[{"indown", ",", "inup"}], "}"}], "]"}]}], "}"}]}], 
                    "]"}]}], "}"}], ",", "sf"}], "]"}]}], "}"}], "]"}], "]"}],
            "&"}]}]}], "\[IndentingNewLine]", "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"MakeBoxes", "[", 
               RowBox[{"#", ",", "sf"}], "]"}], "&"}], "/@", 
             RowBox[{"{", "indown", "}"}]}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"MakeBoxes", "[", 
               RowBox[{"#", ",", "sf"}], "]"}], "&"}], "/@", 
             RowBox[{"{", "inup", "}"}]}]}], "}"}], "]"}], ",", 
         "\"\<mvGenDownUp\>\"", ",", 
         RowBox[{"DisplayFunction", ":>", "pfd"}], ",", 
         RowBox[{"InterpretationFunction", ":>", "pfi"}], ",", 
         RowBox[{"SyntaxForm", "\[Rule]", "\"\<fish\>\""}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CodeAssistOptions->{
 "CodeToolsOptions"-><|
  "CodeInspect" -> <|
    "Tags" -> <|"UnscopedObjectError" -> <|Enabled -> False|>|>|>|>},
 CellLabel->
  "In[1449]:=",ExpressionUUID->"84984c57-3aeb-4787-838f-d20ce0eb65f5"],

Cell["\<\
mvDOp[] will represent abstract scalar differentiation operator for which no \
argument what to differentiate was provided (like partial_var ). Sometimes we \
temporary use this name for intermediate steps with other meaning as well \
(then the other syntax this should not be present in final answer)\
\>", "Text",ExpressionUUID->"e25be838-d19e-4ff8-a8a7-77a8a4898966"],

Cell["\<\
Single mvDOp operator derivative  make boxes. The operator has an argument \
identification string, but after all manipulations the  id should become \
empty (in the end a pure differential operator should lost any connection \
with the initial non-commuting operator,  from which is originates) \
\>", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"4d9eeb08-8ef3-419f-bc68-008fe3cd311c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mvDOp", "::", "syntax"}], "=", 
   "\"\<Warning! mvDOp[ `1` ][scalarVars__] with id string should never \
appear in the end result. Computations were not properly completed.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"mvDOp", "[", "id_String", "]"}], "[", "scalarVars__", "]"}], 
     ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Message", "[", 
      RowBox[{
       RowBox[{"mvDOp", "::", "syntax"}], ",", "id"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"theColor", "=", 
          RowBox[{
           RowBox[{"gaNotation", "[", "id", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", 
         RowBox[{"theVarsNotation", "=", 
          RowBox[{"MakeBoxes", "[", 
           RowBox[{"mvGenDownUp", "[", 
            RowBox[{
             RowBox[{"{", "scalarVars", "}"}], ",", 
             RowBox[{"{", "}"}]}], "]"}], "]"}]}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"MakeBoxes", "[", 
            RowBox[{
             RowBox[{"{", "scalarVars", "}"}], ",", "sf"}], "]"}], ",", 
           RowBox[{"MakeBoxes", "[", 
            RowBox[{"id", ",", "sf"}], "]"}]}], "}"}], ",", "\"\<mvDOp\>\"", 
         ",", 
         RowBox[{"DisplayFunction", ":>", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RowBox", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"SubscriptBox", "[", 
                RowBox[{
                 RowBox[{"StyleBox", "[", 
                  RowBox[{"\"\<\[PartialD]\>\"", ",", "theColor"}], "]"}], 
                 ",", "theVarsNotation"}], "]"}], ",", 
               RowBox[{"StyleBox", "[", 
                RowBox[{"\"\<(\>\"", ",", "theColor"}], "]"}], ",", 
               RowBox[{"StyleBox", "[", 
                RowBox[{"\"\<)\>\"", ",", "theColor"}], "]"}]}], "}"}], "]"}],
             "&"}], ")"}]}], ",", 
         RowBox[{"SyntaxForm", "\[Rule]", "\"\<fish\>\""}], ",", 
         RowBox[{"Tooltip", "\[Rule]", "None"}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}], ")"}]}], ";"}]}], "Input",
 CellLabel->
  "In[1450]:=",ExpressionUUID->"3e5467d9-c39f-4c48-b0cd-291aaf42e6fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"mvDOp", "[", "scalarVars__", "]"}], ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"theVarsNotation", "=", 
       RowBox[{"MakeBoxes", "[", 
        RowBox[{"mvGenDownUp", "[", 
         RowBox[{
          RowBox[{"{", "scalarVars", "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"TemplateBox", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"MakeBoxes", "[", 
         RowBox[{
          RowBox[{"{", "scalarVars", "}"}], ",", "sf"}], "]"}], "}"}], ",", 
       "\"\<mvDOp\>\"", ",", 
       RowBox[{"DisplayFunction", ":>", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"RowBox", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"SubscriptBox", "[", 
              RowBox[{
               RowBox[{"StyleBox", "[", 
                RowBox[{"\"\<\[PartialD]\>\"", ",", "Bold"}], "]"}], ",", 
               "theVarsNotation"}], "]"}], ",", 
             RowBox[{"StyleBox", "[", 
              RowBox[{"\"\<(\>\"", ",", "Bold"}], "]"}], ",", 
             RowBox[{"StyleBox", "[", 
              RowBox[{"\"\<)\>\"", ",", "Bold"}], "]"}]}], "}"}], "]"}], 
          "&"}], ")"}]}], ",", 
       RowBox[{"SyntaxForm", "\[Rule]", "\"\<fish\>\""}], ",", 
       RowBox[{"Tooltip", "\[Rule]", "None"}]}], "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[1452]:=",ExpressionUUID->"c43f24f1-dabf-4940-8d2f-c231bd85e85f"],

Cell["Directional derivative  make boxes. ", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"1d2d3748-442a-4c53-9205-7c3544281c90"],

Cell["\<\
Note, that if vector space dimension do not match vector argument, we issue \
warning and use different to help catching usage errors. \
\>", "Text",
 CellGroupingRules->{
  GroupTogetherGrouping, 
   10001.},ExpressionUUID->"d0859635-64e5-4934-9830-6e998c588649"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dfsN", "=", "directionalDerivativeSymbolName"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"MakeBoxes", "[", 
       RowBox[{
        RowBox[{"gaDirectionalDerivative", "[", 
         RowBox[{"expr_", ",", "vector_"}], "]"}], ",", 
        RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{"TemplateBox", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"MakeBoxes", "[", 
            RowBox[{"expr", ",", "sf"}], "]"}], ",", 
           RowBox[{"MakeBoxes", "[", 
            RowBox[{"vector", ",", "sf"}], "]"}]}], "}"}], ",", "dfsN", ",", 
         RowBox[{"DisplayFunction", ":>", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"RowBox", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"SubscriptBox", "[", 
                RowBox[{"dfsN", ",", "#2"}], "]"}], ",", "\"\<[\>\"", ",", 
               "#1", ",", "\"\<]\>\""}], "}"}], "]"}], "&"}], ")"}]}], ",", 
         RowBox[{"SyntaxForm", "\[Rule]", "\"\<fish\>\""}], ",", 
         RowBox[{"Tooltip", "\[Rule]", "None"}]}], "]"}], "/;", 
       RowBox[{"FreeQ", "[", 
        RowBox[{"vector", ",", 
         RowBox[{"mvDownUp", "[", 
          RowBox[{
           RowBox[{"{", "___", "}"}], ",", 
           RowBox[{"{", "__", "}"}]}], "]"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gaDirectionalDerivative", "::", "syntax"}], "=", 
      "\"\<Warning! Direction `1` in gaDirectionalDerivative[expr,vector] \
typically is primary space vector (not reciprocal) or multivector. You know \
what you are doing.\>\""}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MakeBoxes", "[", 
       RowBox[{
        RowBox[{"gaDirectionalDerivative", "[", 
         RowBox[{"expr_", ",", "vector_"}], "]"}], ",", 
        RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "::", "syntax"}], ",", 
           "vector"}], "]"}], ";", 
         RowBox[{"TemplateBox", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"MakeBoxes", "[", 
              RowBox[{"expr", ",", "sf"}], "]"}], ",", 
             RowBox[{"MakeBoxes", "[", 
              RowBox[{"vector", ",", "sf"}], "]"}]}], "}"}], ",", "dfsN", ",", 
           RowBox[{"DisplayFunction", ":>", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"RowBox", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"SubscriptBox", "[", 
                  RowBox[{"dfsN", ",", 
                   RowBox[{"StyleBox", "[", 
                    RowBox[{"#2", ",", 
                    RowBox[{"FontWeight", "->", "Bold"}], ",", 
                    RowBox[{"FontColor", "->", 
                    RowBox[{"RGBColor", "[", 
                    RowBox[{"1", ",", "0", ",", "0"}], "]"}]}]}], "]"}]}], 
                  "]"}], ",", "\"\<[\>\"", ",", "#1", ",", "\"\<]\>\""}], 
                "}"}], "]"}], "&"}], ")"}]}], ",", 
           RowBox[{"SyntaxForm", "\[Rule]", "\"\<fish\>\""}], ",", 
           RowBox[{"Tooltip", "\[Rule]", "None"}]}], "]"}]}], ")"}], "/;", 
       RowBox[{"AnyTrue", "[", 
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"vector", ",", "_mvDownUp", ",", "Infinity", ",", 
           RowBox[{"Heads", "->", "True"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"MatchQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{"(", 
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", "___", "}"}], ",", 
               RowBox[{"{", "__", "}"}]}], "]"}], ")"}]}], "]"}], "&"}]}], 
        "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Set", "@@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ToExpression", "[", 
      RowBox[{"Symbol", "[", "directionalDerivativeSymbolName", "]"}], "]"}], 
     ",", "gaDirectionalDerivative"}], "}"}]}], ";"}]}], "Input",
 CellLabel->
