Cell["\<\
When expanding in Association form we expand only with respect to  algebra \
elements (in PlainRepresentation both algebra  and noncommutative field \
elements are expanded). NoncommutativeField elements remains unexpanded. To \
dealt with them (expand, etc..) them we define separate function \
\>", "Text",ExpressionUUID->"e7ba46f2-41a6-45d6-82ec-a9cb0ff25f2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "expand", " ", "only", " ", "values", " ", "in", " ", "the", " ", 
    "Association"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"bs", "=", 
        RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
      ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"gaFieldMap", "[", 
          RowBox[{"expr_", ",", "f_"}], "]"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"expr", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bs", "[", 
              RowBox[{"as_Association", ",", "al_", ",", "any___"}], "]"}], ":>", 
             RowBox[{"bs", "[", 
              RowBox[{
               RowBox[{"Association", "[", 
                RowBox[{"KeyValueMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"#1", "->", 
                    RowBox[{"f", "[", "#2", "]"}]}], ")"}], "&"}], ",", 
                  "as"}], "]"}], "]"}], ",", "al", ",", "any"}], "]"}]}], 
            "}"}]}], ")"}], "/;", 
         RowBox[{"Not", "[", 
          RowBox[{"FreeQ", "[", 
           RowBox[{"expr", ",", "Association"}], "]"}], "]"}]}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "if", " ", "there", " ", "are", " ", "no", " ", "Association", " ", "do", 
     " ", "nothing", " ", 
     RowBox[{"(", 
      RowBox[{
      "may", " ", "be", " ", "added", " ", "rules", " ", "if", " ", "we", " ",
        "need", " ", "later"}], " "}]}], "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"gaFieldMap", "[", 
       RowBox[{"expr_", ",", "_"}], "]"}], "]"}], ":=", 
     RowBox[{"expr", "/;", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"expr", ",", "Association"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "give", " ", "a", " ", "separate", " ", "name", " ", "for", " ", 
     "noncommutative", " ", "field", " ", "expansion"}], "  ", "*)"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"gaFieldExpand", "[", "expr_", "]"}], "]"}], ":=", 
     RowBox[{"gaFieldMap", "[", 
      RowBox[{"expr", ",", "gaPE"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[449]:=",ExpressionUUID->"077042bc-1a8c-4681-8f26-06225558e846"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". gaProductPairExpand[ ] expansions for MV given in standard \
\[OpenCurlyDoubleQuote]PlainRepresentation\[CloseCurlyDoubleQuote] form"
}], "Subsubsection",ExpressionUUID->"0ab3eab8-1d3d-4100-ab71-593cb6967f53"],

Cell[TextData[{
 "After distribution over sum we perform collection of terms. Note, that when \
expanding pair we modify singleton behaviour with \
\[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->\
pureFunction, depending on our needs. Two most useful choices are   \
\[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->Identity, \
and  \[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->\
Automatic (the default). The \[OpenCurlyDoubleQuote]CoefficientFunction\
\[CloseCurlyDoubleQuote]->Identity choice do not perform any operation on \
collected coefficients. This is useful when dealing with numerical \
coefficients (except if numeric coefficients are expressions like \
Sqrt[2]+1/Sqrt[3], ... etc. When working with symbolic coefficients   \
\[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->Expand is \
safe choice. Other possibilities like \
\[OpenCurlyDoubleQuote]CoefficientFunction\[CloseCurlyDoubleQuote]->Simplify[\
Together[#]]& are possible, though most probably will considerably slowdown \
computation. Option MaxIterations is only useful for testing purpose. It \
stops expansion after given number of operations. The default is MaxIteration \
-> Infinity, i.e. full expansion. May be it is worth to consider to use ",
 Cell[BoxData[
  RowBox[{"System`Private`SetNoEntry", "[", "]"}]], "Input",ExpressionUUID->
  "d4f0dcd4-0b1b-43d9-a03e-47587619bb2c"],
 " in order to make some functions Atomic-like (there is subtlety, however, \
that we have to apply this function to every instance of an created \
expression, which is probably is not what we want)."
}], "Text",ExpressionUUID->"138424f0-bd1d-4c98-9a21-b3b210d0eb48"],

Cell["\<\
General options: Quiet\[Rule]True,\[CloseCurlyDoubleQuote]CoefficientFunction\
\[CloseCurlyDoubleQuote]\[Rule](Collect[#,gaBasisElementPattern[]]&). We \
removed a expansion methods into obsolete.nb. \
(Collect[#,gaBasisElementPattern[]]&)\
\>", "Text",ExpressionUUID->"55b4e479-795d-41f7-be66-9d4f48376c44"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gaProductPairExpand", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<CoefficientFunction\>\"", "\[Rule]", "Automatic"}], ",", 
     RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
     RowBox[{"MaxIterations", "->", "Infinity"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "testOptionProductPairExpand", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"simple", " ", "option", " ", "case"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionProductPairExpand", "[", "\"\<MaxIterations\>\"", "]"}],
    "=", "\"\<Integer or Infinity\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "testOptionProductPairExpand", "[", "\"\<CoefficientFunction\>\"", "]"}], 
   "=", 
   RowBox[{
   "Automatic", "|", "\"\<Automatic\>\"", "|", "Expand", "|", 
    "gaProductExpand", "|", "Identity", "|", 
    "\"\<any transformation (i.e with head Function[]) of expression\>\""}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionProductPairExpand", "[", "\"\<Quiet\>\"", "]"}], "=", 
    RowBox[{"\"\<True\>\"", "|", "\"\<False\>\""}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "argument", " ", "cal", " ", "is", " ", "used", " ", "for", 
    " ", "actual", " ", "check"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionProductPairExpand", "[", 
    RowBox[{"\"\<MaxIterations\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"MatchQ", "[", 
     RowBox[{"val", ",", "Infinity"}], "]"}], "||", 
    RowBox[{"IntegerQ", "[", "val", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionProductPairExpand", "[", 
    RowBox[{"\"\<CoefficientFunction\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{
     "Automatic", "|", "\"\<Automatic\>\"", "|", "Expand", "|", 
      "gaProductExpand", "|", "Identity", "|", "_Function"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionProductPairExpand", "[", 
    RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[452]:=",ExpressionUUID->"f9085a54-4b3d-492b-881d-9890607272e1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
