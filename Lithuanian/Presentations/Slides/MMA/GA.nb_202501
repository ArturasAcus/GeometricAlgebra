           RowBox[{"{", "0", "}"}]}], "]"}]}], ",", 
        RowBox[{"aVB", "=", 
         RowBox[{"gaGetMV", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}], "]"}]}], ",", "mvNorm", ",", 
        "mvNorm12", ",", "cleanEvenPiInPlus", ",", "ansRaw", ",", "freeM"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mvNorm12", "=", 
        RowBox[{"gaPE", "[", 
         RowBox[{"GeometricProduct", "[", 
          RowBox[{
           RowBox[{"gaCliffordConjugate", "[", "aVB", "]"}], ",", "aVB"}], 
          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"mvNorm", "=", 
        RowBox[{"mvNorm12", "+", 
         RowBox[{"a0", "^", "2"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"printDetails", "[", 
        RowBox[{"quiet", ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "\"\<mvNorm=gaNorm2CliffordConjugateSigned[expr] \>\"", ",", 
            "mvNorm"}], "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
