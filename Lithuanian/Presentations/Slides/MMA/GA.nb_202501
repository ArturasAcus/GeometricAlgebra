Cell["For inverse transformation we use ", "Text",ExpressionUUID->"4bb2aaac-e72e-4467-b138-41a28e13010e"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bs", "=", 
     RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"toCliffordMatrix", "[", 
     RowBox[{"expr_List", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"alg_Cl", ",", "quietOpt_"}], "}"}]}], "}"}]}], "]"}], ":=", 
    
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"algLarger", ",", "exprIndexReplaced", ",", 
         RowBox[{"matrixDim", "=", 
          RowBox[{"First", "[", 
           RowBox[{"Dimensions", "[", "expr", "]"}], "]"}]}], ",", "block11", 
         ",", "block12", ",", "block21", ",", "block22", ",", "m1", ",", "m2",
          ",", "m3", ",", "m4", ",", 
         RowBox[{"threshold", "=", 
          RowBox[{"alg", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "answer"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"algLarger", "=", 
         RowBox[{"Cl", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"List", "@@", "alg"}], ")"}], "+", 
            RowBox[{"{", 
             RowBox[{"1", ",", "1", ",", "0"}], "}"}]}], ")"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"show", " ", "transformation"}], " ", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"printDetails", "[", 
         RowBox[{"quietOpt", ",", 
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{"\"\<Isomorphism transformation: \>\"", ",", 
             RowBox[{"alg", "->", "algLarger"}]}], "}"}], 
           "\[IndentingNewLine]", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"(*", " ", 
         RowBox[{
         "define", " ", "basis", " ", "for", " ", "nice", " ", "output", " ", 
          "and", " ", "possible", " ", "further", " ", "manipulations"}], " ",
          "*)"}], "  ", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"gaOrthonormalBasis", "[", 
             RowBox[{"algLarger", ",", "\"\<InvDeg[Lex]\>\""}], "]"}], "]"}], 
           "===", "gaOrthonormalBasis"}], ",", 
          RowBox[{"gaDefineOrthonormalBasis", "[", 
           RowBox[{"algLarger", ",", 
            RowBox[{
            "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
             "\"\<InvDeg[Lex]\>\""}], ",", 
            RowBox[{"\"\<DefineInput\>\"", "\[Rule]", "False"}], ",", 
            RowBox[{"\"\<MakeAlias\>\"", "\[Rule]", "False"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "determine", " ", "which", " ", "indices", " ", "have", " ", "to", 
          " ", "be", " ", "shifted"}], " ", "*)"}], " ", 
        "\[IndentingNewLine]", 
        RowBox[{"exprIndexReplaced", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "/", "2"}], ")"}], "expr"}], "/.", 
               RowBox[{"{", 
                RowBox[{"al_Cl", ":>", "algLarger"}], "}"}]}], "]"}], "//.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"mvDownUp", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"any1___", ",", 
                   RowBox[{"r_Integer", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", ">", "threshold"}], "&"}], ")"}]}], ",", 
                   "any2___"}], "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}], ":>", 
               RowBox[{"mvDownUp", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"any1", ",", 
                   RowBox[{"\[FormalR]", "[", "r", "]"}], ",", "any2"}], 
                  "}"}], ",", 
                 RowBox[{"{", "}"}]}], "]"}]}], "}"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[FormalR]", "[", "r_", "]"}], ":>", 
             RowBox[{"r", "+", "1"}]}], "}"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"m1", ",", "m2", ",", "m3", ",", 
          RowBox[{"m4", " ", "are", " ", "from", " ", 
           RowBox[{"E", ".", " ", "Hitzer"}]}], ",", " ", 
          RowBox[{"S", ".", " ", "Sangwine"}], ",", " ", 
          "\"\<Multivector and multivector matrix inverses in real Clifford \
algebras\>\"", ",", " ", 
          RowBox[{"Technical", " ", "report", " ", 
           RowBox[{"ISSN", ":", " ", 
            RowBox[{"1744", "-", "8050"}]}]}], ",", " ", "2016"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"block11", "=", 
         RowBox[{"exprIndexReplaced", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{";;", "matrixDim", ";;", "2"}], ",", 
            RowBox[{";;", "matrixDim", ";;", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"block12", "=", 
         RowBox[{"exprIndexReplaced", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{";;", "matrixDim", ";;", "2"}], ",", 
            RowBox[{"2", ";;", "matrixDim", ";;", "2"}]}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"block21", "=", 
         RowBox[{"exprIndexReplaced", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;", "matrixDim", ";;", "2"}], ",", 
            RowBox[{";;", "matrixDim", ";;", "2"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"block22", "=", 
         RowBox[{"exprIndexReplaced", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"2", ";;", "matrixDim", ";;", "2"}], ",", 
            RowBox[{"2", ";;", "matrixDim", ";;", "2"}]}], "]"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"m1", "=", 
         RowBox[{"(", 
          RowBox[{"block11", "+", 
           RowBox[{"Map", "[", 
            RowBox[{"gaGradeInverse", ",", "block22", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m2", "=", 
         RowBox[{"(", 
          RowBox[{"block12", "+", 
           RowBox[{"Map", "[", 
            RowBox[{"gaGradeInverse", ",", "block21", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m3", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "block12"}], "+", 
           RowBox[{"Map", "[", 
            RowBox[{"gaGradeInverse", ",", "block21", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"m4", "=", 
         RowBox[{"(", 
          RowBox[{"block11", "-", 
           RowBox[{"Map", "[", 
            RowBox[{"gaGradeInverse", ",", "block22", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"answer", "=", 
         RowBox[{"m1", "+", 
          RowBox[{"gaGeometricMatrixProduct", "[", 
           RowBox[{"m2", ",", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"algLarger", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", 
                RowBox[{"{", "}"}]}], "]"}], ",", "algLarger"}], "]"}]}], 
           "]"}], "\[IndentingNewLine]", "+", 
          RowBox[{"gaGeometricMatrixProduct", "[", 
           RowBox[{"m3", ",", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"algLarger", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", 
                  RowBox[{"algLarger", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", "}"}]}], "]"}], ",", "algLarger"}], "]"}]}], 
           "]"}], "\[IndentingNewLine]", "+", 
          RowBox[{"gaGeometricMatrixProduct", "[", 
           RowBox[{"m4", ",", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"algLarger", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"algLarger", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", 
                   RowBox[{"algLarger", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
                RowBox[{"{", "}"}]}], "]"}], ",", "algLarger"}], "]"}]}], 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"gaPE", "[", "answer", "]"}]}]}], "\[IndentingNewLine]", 
      "]"}], "/;", 
     RowBox[{
      RowBox[{"MatrixQ", "[", "expr", "]"}], "&&", 
