          "products"}]}], " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"indicesThatChanges", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"First", "/@", 
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{
              RowBox[{"Rest", "[", "basisAlg", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "3"}], ",", 
                RowBox[{"alg", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"mvDownUp", "[", 
             RowBox[{"_", ",", 
              RowBox[{"{", "}"}]}], "]"}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"isomorphic", " ", "algebra"}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"algNew", "=", 
        RowBox[{"Cl", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"List", "@@", "alg"}], ")"}], "+", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "4"}], ",", "4", ",", "0"}], "}"}]}], ")"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"in", " ", "fact", " ", "we", " ", 
         RowBox[{"don", "'"}], "t", " ", "need", " ", "to", " ", "genarate", 
         " ", "full", " ", "basis", " ", "of", " ", "new", " ", "algebra"}], 
        " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"gaOrthonormalBasis", "[", 
            RowBox[{"algNew", ",", "\"\<InvDeg[Lex]\>\"", ",", 
             RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "===", 
          "gaOrthonormalBasis"}], ",", 
         RowBox[{"basisAlgNew", "=", 
          RowBox[{"gaDefineOrthonormalBasis", "[", 
           RowBox[{"algNew", ",", 
            RowBox[{
            "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
             "\"\<InvDeg[Lex]\>\""}], ",", 
            RowBox[{"\"\<Grades\>\"", "->", 
             RowBox[{"{", "1", "}"}]}], ",", 
            RowBox[{"\"\<DefineInput\>\"", "\[Rule]", "False"}], ",", 
            RowBox[{"\"\<MakeAlias\>\"", "\[Rule]", "False"}]}], "]"}]}], ",",
          "\[IndentingNewLine]", 
         RowBox[{"basisAlgNew", "=", 
          RowBox[{"gaDefineOrthonormalBasis", "[", 
           RowBox[{"algNew", ",", "\"\<InvDeg[Lex]\>\"", ",", 
            RowBox[{"{", "1", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"isomorphismRulesVectors", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "3"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "-", "2"}], ",", 
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "2"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"-", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "3"}], ",", 
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", 
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}]}], ",", 
          "\[IndentingNewLine]", 
