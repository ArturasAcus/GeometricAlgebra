  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
    "testOptionToCliffordMatrixRepresentation", "[", "\"\<Quiet\>\"", "]"}], 
    "=", "\"\<True|False\>\""}], ";"}], "\[IndentingNewLine]", 
