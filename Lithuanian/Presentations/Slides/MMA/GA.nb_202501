   RowBox[{"testIndexUnion", "[", 
    RowBox[{
     RowBox[{"mvDownUp", "[", 
      RowBox[{"du1_List", ",", "du2_List"}], "]"}], ",", "___"}], "]"}], ":=", 
   RowBox[{"Union", "[", 
