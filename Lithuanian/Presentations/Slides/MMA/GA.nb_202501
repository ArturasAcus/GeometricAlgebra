Cell[TextData[{
 "When computing directional derivatives we have to test if the second \
argument is vector. Note that ?gaVectorQ test helps to eliminate part with \
zero grade term. If we need to test that we have zero vector, it is better to \
add test ",
 StyleBox["PossibleZeroQ[ ]",
  FontWeight->"Bold"],
 " along with ",
 StyleBox["gaVectorQ[ ]",
  FontWeight->"Bold"],
 ", than to add option testing stuff."
}], "Text",
 CellGroupingRules->{
  GroupTogetherGrouping, 
   10001.},ExpressionUUID->"4c898f74-0efd-484d-a8f0-4d0bb03ac6bf"],

