         RowBox[{"{", 
          RowBox[{"theOption", ",", 
           RowBox[{"vectors", "=", 
            RowBox[{"List", "@@", "expr"}]}], ",", "resul", ",", 
           "allNonTrivialPairs"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
