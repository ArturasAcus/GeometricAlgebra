Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"baseSymbol", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
