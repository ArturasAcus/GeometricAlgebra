     RowBox[{
     "testOptionSpinor", "[", "\"\<gaNonCommutativeMonomialOrder\>\"", "]"}], 
     "=", "\"\<Should be one of possible GA orderings: \
(\\\"Lex\\\"|\\\"InvLex\\\"|\\\"RevLex\\\"|\\\"InvRevLex\\\"|\\\"Deg[Lex]\\\"|\
