Cell["Usage messages", "Text",ExpressionUUID->"7c389cbc-04be-44b6-b532-be981c4a0f38"],

Cell[TextData[{
 "Do not use ** (",
 StyleBox["NonCommutativeMultiply[ ]",
  FontWeight->"Bold"],
 ") for geometric product!"
}], "Text",ExpressionUUID->"079f0941-ea2f-40ea-84ea-5d0e245b88d7"],

Cell[TextData[{
 "There is one more important product, called the \
\[OpenCurlyDoubleQuote]Shuffle product\[CloseCurlyDoubleQuote], defined by \
Perti Lounesto article in \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Lectures on Clifford (Geometric) Algebras and Applications\"\
\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "AblamowiczSobczyk_2004_LecturesOnClifford.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "049d1b0e-de01-46a8-ab55-3786b9f22ff9"],
 "\[CloseCurlyDoubleQuote], p. 26, which has geometrical meaning for \
\[OpenCurlyDoubleQuote]meet\[CloseCurlyDoubleQuote] (and related to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Vee]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\vee", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e05492a-622d-4c68-98f4-47da7c9944ee"],
 " or \[OpenCurlyDoubleQuote]join\[CloseCurlyDoubleQuote]), and denoted as \
\[Wedge].  It is not implemented at the moment. "
}], "Text",ExpressionUUID->"fa4f22a7-e1ec-460a-be5c-68894c0fef32"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaCommutativeQ", "::", "usage"}], "=", 
