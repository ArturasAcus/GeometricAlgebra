     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "x", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "differentiated", " ", "argument", " ", "into", " ", "first", " ", 
