              RowBox[{"KeyDrop", "[", 
               RowBox[{"ass2", ",", 
                RowBox[{"{", 
                 RowBox[{"mvDownUp", "[", 
                  RowBox[{
                   RowBox[{"{", "}"}], ",", 
                   RowBox[{"{", "}"}]}], "]"}], "}"}]}], "]"}], ",", "ass2"}],
              "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
