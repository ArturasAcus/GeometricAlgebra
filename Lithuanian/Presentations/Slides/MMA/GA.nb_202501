          RowBox[{"gaTransformation", "[", "any", "]"}], "[", 
          RowBox[{"z", ",", "op"}], "]"}]}], "]"}], ",", "y"}], "]"}]}], 
    ";"}], "*)"}], "\[IndentingNewLine]", "]"}]], "Input",
