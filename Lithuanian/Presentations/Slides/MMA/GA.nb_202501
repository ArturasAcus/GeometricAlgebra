  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "When", " ", "converting", " ", "from", " ", "MV", " ", "with", " ", 
    "quaternionic", " ", "coefficients", " ", "to", " ", "matrix", " ", "we", 
    " ", "need", " ", "to", " ", "multiply", " ", "the", " ", "quaternion", 
