Cell[TextData[{
 "Procedure to multiply matrices of multivectors. Implementation follows \
\[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Operator calculus and invertible Clifford Appel systems: \
theory and applications to n-particle fermion algebra\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Staples_2011_0c960527d4b2564cbe000000.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "c54b9243-39f9-4ee3-a0bd-240d327dc675"],
 "\[CloseCurlyDoubleQuote]. \nAttempt to merge GeometricMatrixProduct and Dot \
into single operation like: \
gaGeometricMatrixProduct[a_?MatrixQ,b_?MatrixQ]:=Dot[a,b]/;FreeQ[{a,b},Cl|MV];\
  Results of inserts Times in multiplication of matrix elements. Not clear \
why. "
}], "Text",ExpressionUUID->"4a350b32-9138-4aa9-84a0-a5b38f27dec1"],

