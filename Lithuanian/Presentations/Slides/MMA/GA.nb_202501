Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"gaNormHermitian", "[", 
       RowBox[{"expr_", ",", 
