         RowBox[{"expr", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ",", "q2"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q2", "=", 
       RowBox[{"-", 
        RowBox[{"gaPE", "[", 
         RowBox[{"aVB", "\[GeometricProduct]", 
          RowBox[{"gaCliffordConjugate", "[", "aVB", "]"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Piecewise", "[", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"printDetails", "[", 
             RowBox[{"quiet", ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"\"\<Piecewise: \>\"", ",", "\"\<q2=0\>\""}], "}"}], 
               "}"}]}], "]"}], ";", 
            RowBox[{
             RowBox[{"Exp", "[", "a0", "]"}], "*", 
             RowBox[{"(", 
              RowBox[{"1", "+", "aVB"}], ")"}]}]}], ",", 
           RowBox[{"(", 
            RowBox[{"zeroQ", "[", "q2", "]"}], ")"}]}], "}"}], ",", 
