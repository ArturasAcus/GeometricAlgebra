Cell[BoxData[
 RowBox[{
  RowBox[{"functionOfMVMinimalPolynomialImplicit", "[", 
   RowBox[{"thefunction_", ",", "exprExpanded_", ",", 
    RowBox[{"{", 
     RowBox[{"quiet_", ",", "expandFunction_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"theAlg", "=", 
       RowBox[{"gaGetAlgebra", "[", "exprExpanded", "]"}]}], ",", 
      "theInternalRepresentation", ",", "minPoly", ",", 
      "rootsWithMultiplicities", ",", "numberOfRoots", ",", "maxMultiplicity",
       ",", "c1Rules", ",", "skaitiklisS", ",", "minPolyPFD", ",", "var", ",",
       "derivativeTable", ",", "rpqList", ",", "allpowerRules", ",", 
      "answer"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<Using Method->\>\"", ",", "\"\<CoordinateFree\>\""}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<ExpandFunction is->\>\"", ",", "expandFunction"}], 
          "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "restriction", " ", "since", " ", "AssociationRepresentation", " ", 
       "at", " ", "the", " ", "moment", " ", 
       RowBox[{"don", "'"}], "t", " ", "support", " ", "other", " ", 
       "orderings", " ", "and", " ", "curvilinear", " ", "basis", " ", 
       "elements"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"bs", "=", 
         RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"gaRunningOrdering", "===", "\"\<InvDev[Lex]\>\""}], ")"}],
           "&&", 
          RowBox[{"(", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"exprExpanded", ",", 
             RowBox[{"_bs", "[", "_", "]"}]}], "]"}], ")"}]}], ",", 
         RowBox[{
         "theInternalRepresentation", "=", 
          "\"\<AssociationRepresentation\>\""}], ",", 
         RowBox[{
         "theInternalRepresentation", "=", "\"\<PlainRepresentation\>\""}]}], 
        "]"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"minPoly", "=", 
      RowBox[{"gaMinimalPolynomial", "[", 
       RowBox[{"exprExpanded", ",", "\[FormalLambda]", ",", 
        RowBox[{"Method", "->", "\"\<GA\>\""}], ",", 
        RowBox[{
        "\"\<InternalRepresentation\>\"", "->", 
         "theInternalRepresentation"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<MinimalPolynomial is\>\"", ",", "minPoly"}], "}"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"rootsWithMultiplicities", "=", 
      RowBox[{"Tally", "[", 
       RowBox[{"SolveValues", "[", 
        RowBox[{
         RowBox[{"minPoly", "==", "0"}], ",", "\[FormalLambda]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"numberOfRoots", ",", "maxMultiplicity"}], "}"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Plus", "@@", "#"}], ",", 
          RowBox[{"Max", "[", "#", "]"}]}], "}"}], "&"}], "[", 
       RowBox[{"Last", "/@", "rootsWithMultiplicities"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "\"\<Roots with multiplicities {root,multiplicity}.. :\>\"", ",", 
           "rootsWithMultiplicities"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "\"\<Maximal root multiplicity is \>\"", ",", "maxMultiplicity"}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<Defective case?\>\"", ",", 
           RowBox[{"maxMultiplicity", ">", "1"}]}], "}"}]}], "}"}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"c1Rules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{
         RowBox[{"\[FormalC]", "/@", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "numberOfRoots"}], "]"}], "]"}]}], ",", 
         RowBox[{"CoefficientList", "[", 
          RowBox[{"minPoly", ",", "\[FormalLambda]"}], "]"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Coefficients of minimal polynomial are: \>\"", ",", "c1Rules"}],
          "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"skaitiklisS", "=", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[FormalLambda]", "^", "k"}], "*", 
            RowBox[{"\[FormalC]", "[", 
             RowBox[{"numberOfRoots", "-", "1", "-", "m", "-", "k"}], "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"numberOfRoots", "-", "1", "-", "m"}]}], "}"}]}], "]"}], 
         "*", 
         RowBox[{"\[FormalX]", "^", "m"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "0", ",", 
          RowBox[{"numberOfRoots", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<Formal numerator S: \>\"", ",", "skaitiklisS"}], "}"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"minPolyPFD", "=", 
      RowBox[{"recursivePartialFractionDecompose", "[", 
       RowBox[{
       "skaitiklisS", ",", "minPoly", ",", "rootsWithMultiplicities", ",", 
        "maxMultiplicity", ",", "c1Rules"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Partial fraction decomposition {{root_i, \
{p_i===q_i^0,q_i,q^2_i,q^3_i,...}}...} yields\>\"", ",", 
          RowBox[{"Collect", "[", 
           RowBox[{"minPolyPFD", ",", "\[FormalX]", ",", "Together"}], 
           "]"}]}], "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"thefunction", "===", "Identity"}], ",", "\[IndentingNewLine]", 
       RowBox[{"derivativeTable", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"maxMultiplicity", "-", "2"}]}], "}"}]}], "]"}]}], 
          "}"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"derivativeTable", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "/", 
              RowBox[{"Factorial", "[", "k", "]"}]}], ")"}], "*", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"thefunction", "[", 
               RowBox[{"\[FormalLambda]", "+", "var"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"var", ",", "k"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"maxMultiplicity", "-", "1"}]}], "}"}]}], "]"}], "/.", 
         RowBox[{"var", "->", "0"}]}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<Derivative table\>\"", ",", "derivativeTable"}], "}"}], 
        "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"rpqList", "=", 
      RowBox[{"MapAt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Collect", "[", 
           RowBox[{
            RowBox[{"Together", "[", "#", "]"}], ",", "\[FormalX]"}], "]"}], 
          ")"}], "&"}], ",", "minPolyPFD", ",", 
        RowBox[{"{", 
         RowBox[{"All", ",", "2"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<rpqList is \>\"", ",", "rpqList"}], "}"}], "}"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
         "\"\<Starting computation of MV powers...\>\"", ",", "\"\<\>\""}], 
         "}"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"allpowerRules", "=", 
      RowBox[{"allPowersOfMV", "[", 
       RowBox[{
        RowBox[{"\[FormalX]", "->", "exprExpanded"}], ",", 
        RowBox[{"numberOfRoots", "-", "1"}], ",", 
        "theInternalRepresentation"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"printDetails", "[", 
      RowBox[{"quiet", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\"\<Finished.\>\"", ",", "\"\<\>\""}], "}"}], "}"}]}], 
      "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "modification", " ", "of", " ", "answer", " ", "can", " ", "be", " ", 
       "very", " ", "time", " ", "consuming", " ", "in", " ", "some", " ", 
       RowBox[{"cases", ".", " ", "Warn"}], " ", "when", " ", "it", " ", "is",
        " ", "attempted"}], "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"Not", "[", 
        RowBox[{"MatchQ", "[", 
         RowBox[{"expandFunction", ",", 
          RowBox[{"False", "|", "Identity"}]}], "]"}], "]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", "quiet"}], ",", 
         RowBox[{"Message", "[", 
          RowBox[{"gaFunctionOfMV", "::", "Expand"}], "]"}]}], "]"}]}], "]"}],
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
      "once", " ", "all", " ", "above", " ", "data", " ", "computed", " ", 
       "we", " ", "are", " ", "ready", " ", "to", " ", "produce", " ", 
       "final", " ", "result", " ", "according", " ", "to", " ", "options"}], 
      " ", "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"answer", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"thefunction", "[", 
             RowBox[{
              RowBox[{"rpqList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{
              RowBox[{"rpqList", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "+", 
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"derivativeTable", "[", 
                 RowBox[{"[", 
                  RowBox[{"q", "-", "1"}], "]"}], "]"}], "/.", 
                RowBox[{"{", 
                 RowBox[{"\[FormalLambda]", "->", 
                  RowBox[{
                   RowBox[{"rpqList", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], ")"}], "*", 
              RowBox[{
               RowBox[{
                RowBox[{"rpqList", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "[", 
               RowBox[{"[", "q", "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"q", ",", "2", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                 RowBox[{"rpqList", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
          ")"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "rpqList", "]"}]}], "}"}]}], "]"}], "/.", 
       "allpowerRules"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"expandFunction", "===", "False"}], ",", "answer", ",", 
       RowBox[{"expandFunction", "[", "answer", "]"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1374]:=",ExpressionUUID->"15de0966-5012-4c81-9064-1813c030efe7"]
}, Closed]],

