Cell["\<\
If coordinate system was already defined we can set to previously defined \
system by changing all running variables\
\>", "Text",ExpressionUUID->"9689e91a-87b8-4238-8794-1ecfac74be6c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaSetCoordinateChart", "[", "name_String", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"gaRunningCoordinateChart", "=", "name"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gaRunningPatch", "=", 
       RowBox[{
        RowBox[{"gaCoordinateChart", "[", "name", "]"}], "[", 
        "\"\<gaRunningPatch\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gaCoordinateChartVars", "[", "name", "]"}], "=", 
       RowBox[{
        RowBox[{"gaCoordinateChart", "[", "name", "]"}], "[", 
        "\"\<StandardCoordinateNames\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gaRunningAlgebra", "=", 
       RowBox[{"gaGetAlgebra", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
           "gaCoordinateChart", "[", "gaRunningCoordinateChart", "]"}], "[", 
           "gaRunningPatch", "]"}], "[", "\"\<PrimaryVectors\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gaCoordinateChart", "[", "gaRunningCoordinateChart", "]"}], 
       "[", "gaRunningPatch", "]"}]}], "\[IndentingNewLine]", ")"}], "/;", 
    RowBox[{"MemberQ", "[", 
     RowBox[{"gaDefinedCoordinateCharts", ",", "name"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1525]:=",ExpressionUUID->"da3054bf-133b-4040-9bef-686ac4576073"]
