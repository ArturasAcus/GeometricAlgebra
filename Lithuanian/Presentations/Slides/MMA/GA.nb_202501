                  RowBox[{"{", 
                   RowBox[{"1", ",", "2"}], "}"}], ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "theAlg"}], "]"}]}]}], 
            "\[IndentingNewLine]", ")"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"ansRaw", "=", 
        RowBox[{"(", 
