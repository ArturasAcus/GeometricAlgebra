Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Inside", " ", "products", " ", "differentiate", " ", "each", " ", "of", 
     " ", "terms"}], ",", " ", 
    RowBox[{"then", " ", "add", " ", "the", " ", "result"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"mvD", "[", 
    RowBox[{
     RowBox[{"h", ":", 
      RowBox[{"(", 
       RowBox[{
       "_Times", "|", "_GeometricProduct", "|", "_OuterProduct", "|", 
        "_InnerProduct", "|", "_LeftContract", "|", "_RightContract"}], 
       ")"}]}], ",", "var_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
