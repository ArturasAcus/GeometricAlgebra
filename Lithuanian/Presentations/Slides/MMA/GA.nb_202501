Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"RightContract", "[", "y__", "]"}], ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RowBox", "[", 
     RowBox[{"Riffle", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"wrapBraces", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{
            "LeftContract", ",", "InnerProduct", ",", "DorstProduct", ",", 
             "OuterProduct", ",", "GeometricProduct", ",", "Plus"}], "}"}], 
           ",", "sf"}], "]"}], "&"}], "/@", 
        RowBox[{"{", "y", "}"}]}], ",", "\"\<\[RightContract]\>\""}], "]"}], 
     "]"}], "/;", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ">=", "2"}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"LeftContract", "[", "y__", "]"}], ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RowBox", "[", 
     RowBox[{"Riffle", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"wrapBraces", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            RowBox[{
            "InnerProduct", ",", "DorstProduct", ",", "OuterProduct", ",", 
             "GeometricProduct", ",", "Plus"}], "}"}], ",", "sf"}], "]"}], 
         "&"}], "/@", 
        RowBox[{"{", "y", "}"}]}], ",", "\"\<\[LeftContract]\>\""}], "]"}], 
     "]"}], "/;", 
    RowBox[{
     RowBox[{"Length", "[", 
      RowBox[{"{", "y", "}"}], "]"}], ">=", "2"}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MakeBoxes", "[", 
    RowBox[{
     RowBox[{"InnerProduct", "[", "y__", "]"}], ",", 
     RowBox[{"sf", ":", "StandardForm"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"RowBox", "[", 
