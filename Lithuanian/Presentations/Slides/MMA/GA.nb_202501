          "function", " ", "is", " ", "moved", " ", "to", " ", "end"}]}], " ",
          "*)"}], "\[IndentingNewLine]", 
        RowBox[{"GeometricProduct", "[", 
         RowBox[{
          RowBox[{"mvD", "[", 
           RowBox[{
            RowBox[{"argg1", "\[GeometricProduct]", 
             RowBox[{"Log", "[", "argnomv", "]"}]}], ",", "var"}], "]"}], ",", 
          RowBox[{"Power", "[", 
