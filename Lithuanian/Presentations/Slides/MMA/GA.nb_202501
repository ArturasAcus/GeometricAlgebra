            RowBox[{"gaProductPairExpand", ",", "Quiet"}], "]"}]}], ",", 
          RowBox[{"hd", "=", 
           RowBox[{"Head", "[", "h", "]"}]}]}], "\[IndentingNewLine]", "}"}], 
        ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Map", "[", 
