             RowBox[{
             "inc", ",", "alc", ",", "uniqueMaskForArbitraryAlgebra"}], 
             "]"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"vectorsOfSpecialAlgebra", "=", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{
            RowBox[{"gaOrthonormalBasis", "[", 
             RowBox[{"specAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "2"}], "}"}]}], "]"}], ",", 
