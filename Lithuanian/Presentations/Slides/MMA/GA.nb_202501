Cell["\<\
Extended definition to all reciprocal elements, i.e. true multivector \
derivative. Programming note: one can\[CloseCurlyQuote]t add \
gaMultivectorDerivative[expr_,coordName_String:gaRunningCoordinateChart], \
because gaMultivectorDerivative[theId] would fall into infinite recursion, \
due to optional second argument.\
\>", "Text",ExpressionUUID->"a3faf0e8-0958-46a5-9519-67742e75ef97"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaMultivectorDerivative", "[", 
    RowBox[{
    "expr_", ",", "reciprocalElement_List", ",", "primaryVector_List"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theId", "=", 
        RowBox[{"ToString", "[", 
         RowBox[{"Unique", "[", "\"\<D\>\"", "]"}], "]"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"GeometricProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"gaMultivectorDerivative", "[", "theId", "]"}], "[", 
         RowBox[{"reciprocalElement", ",", "primaryVector"}], "]"}], ",", 
        RowBox[{
         RowBox[{"gaDerivativeArgument", "[", "theId", "]"}], "[", "expr", 
         "]"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{"AllTrue", "[", 
     RowBox[{
      RowBox[{"Cases", "[", 
       RowBox[{"reciprocalElement", ",", "_mvDownUp", ",", "Infinity", ",", 
        RowBox[{"Heads", "->", "True"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"MatchQ", "[", 
        RowBox[{"#", ",", 
         RowBox[{"mvDownUp", "[", 
          RowBox[{
           RowBox[{"{", "}"}], ",", 
           RowBox[{"{", "__", "}"}]}], "]"}]}], "]"}], "&"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1559]:=",ExpressionUUID->"bd42e3b6-a256-4253-81a5-495aeff29384"],

Cell[TextData[{
 "Above are simple rules applies when nabla is inside inner, outer or \
geometric product. This are represented by simplified syntax, which is \
converted into universal form. Also to make things simple we define default \
primary vector basis and reciprocal vector basis, when ",
 StyleBox["gaMultivectorDerivative[id_String][]",
  FontWeight->"Bold"],
 " is called without specified basis\[CloseCurlyDoubleQuote].  \n\nIn the \
case of multivector derivative we have to insert here full reciprocal basis \
and full primary basis. Computation of he multivector derivative, therefore, \
will differ from vector derivative, because (even in orthonormal basis) inner \
product of full reciprocal basis multiplied by full primary basis will not \
result into unit matrix (inner product of reciprocal vectors multiplied by \
primary vectors do yield unit matrix!).  It means computations of full \
multivector derivative will  require additional summation, while for vector \
derivative we can avoid it (since e^i e_j =delta_i,j and this allow to avoid \
summation. On the contrary full reciprocal basis is not diagonal. In the \
definition of multivector derivative, however, instead of inner product we \
have scalar product ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    RowBox[{"X", "\[GeometricProduct]", "X"}], 
    SubscriptBox[">", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "976801bc-3cd3-49e1-84c5-cd097c384e56"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    RowBox[{"X", "\[InnerProduct]", "X"}], 
    SubscriptBox[">", "0"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a5bfaccc-8ad5-4234-9b6b-6d03a2cf8c25"],
 ". In the computing directional derivative (i.e. modify \
computation/definition of gaDirectionalDerivative[ ]), therefore, we use a \
trick: the summation is effectively achieved by replacing a scalar product \
with inner product. ",
 StyleBox["Don\[CloseCurlyQuote]t know if this is always valid.",
  FontColor->RGBColor[1, 0, 0]],
 "\n\nIt is completely unclear how this will work in curved space. "
}], "Text",ExpressionUUID->"85057e8c-b403-4b3d-9b3e-54c01dbd00d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaMultivectorDerivative", "[", "id_String", "]"}], "[", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
    RowBox[{
     RowBox[{"gaReciprocalVectors", "[", "gaRunningCoordinateChart", "]"}], 
     ",", 
     RowBox[{"gaPrimaryVectors", "[", "gaRunningCoordinateChart", "]"}]}], 
    "]"}], "/;", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"gaPrimaryVectors", "[", "gaRunningCoordinateChart", "]"}], 
       ",", 
       RowBox[{
       "gaReciprocalVectors", "[", "gaRunningCoordinateChart", "]"}]}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Head", "[", "#", "]"}], "===", "List"}], ")"}], "&"}]}], 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[1560]:=",ExpressionUUID->"638b4eca-1827-40dd-8dec-5a5ee0c00886"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaMultivectorDerivative", "[", "id_String", "]"}], "[", 
    "reciprocalBasis_List", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
     "Echo", "[", 
      "\"\<Not intended syntax with one basis provided. Assume it is a \
reciprocal VECTOR basis and will compute primary vector basis.\>\"", "]"}], 
     ";", 
     RowBox[{
      RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
      RowBox[{"reciprocalBasis", ",", 
       RowBox[{"Last", "/@", 
        RowBox[{
        "gaDefineReciprocalVectors", "[", "reciprocalBasis", "]"}]}]}], 
      "]"}]}], ")"}]}], ";"}]], "Input",
 CellLabel->
  "In[1561]:=",ExpressionUUID->"f3b59b7d-5a3b-42c8-963e-ff79d920bbd7"],

Cell["\<\
In general  gaMultivectorDerivative[ ] can occur or to be combined with \
gaDerivativeArgument (in fact multiple arguments!) in various products. This \
makes application of differentiation rules rather complicated.  These rules \
are utilized  by  gaMultivectorDerivativeExpand[ ] function, which rewrites \
multivector derivative in terms of directional derivatives.  Note, that we \
toDirectionalDerivativeRules are applied from bottom to up (deepest \
subexpressions matches first!). \
\>", "Text",ExpressionUUID->"555219f5-1fb8-404b-ae80-159a87f62738"],

Cell["\<\
toDerivativeAndArgumentPair[ ] help function prepare expression by splitting \
it into single derivative-argument pairs, which then are converted to \
directional derivatives.\
\>", "Text",ExpressionUUID->"9dd2e70a-f2a6-46c1-8e4c-50c27357c5a0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toDerivativeAndArgumentPairs", "[", 
    RowBox[{"expr_Plus", ",", "iter_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"toDerivativeAndArgumentPairs", "[", 
      RowBox[{"#", ",", "iter"}], "]"}], "&"}], "/@", "expr"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toDerivativeAndArgumentPairs", "[", 
   RowBox[{"expr_", ",", "iter_Integer"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"countertoDerivativeAndArgumentPairs", "=", "0"}], ",", 
       "answer"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"answer", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FixedPoint", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"countertoDerivativeAndArgumentPairs", "++"}], ";", 
              RowBox[{"ReplaceAll", "[", 
               RowBox[{"#", ",", "multipleDerivativeArgumentRules"}], "]"}]}],
              ")"}], "&"}], ",", 
           RowBox[{"(", 
            RowBox[{
            "expr", "/.", "emptyDerivativeArgumentRulesBeforePairing"}], 
            ")"}], ",", "iter"}], "]"}], "/.", 
         "emptyDerivativeArgumentRulesAfterPairing"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"countertoDerivativeAndArgumentPairs", ">=", "iter"}], ",", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"gaIteration", " ", "::", "maxlimit"}], ",", 
          "\"\<toDerivativeAndArgumentPairs[expr]\>\""}], "]"}]}], "]"}], ";",
       "\[IndentingNewLine]", "answer"}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"Not", "[", 
    RowBox[{
     RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], "]"}]}]}]}], "Input",\

 CellLabel->
  "In[1562]:=",ExpressionUUID->"fa4503a6-f637-4d32-a146-0eddc7d2ce66"],

Cell["\<\
The help functions which converts each pair to gaDirectionalDerivative[ ]\
\>", "Text",ExpressionUUID->"c79161f3-43e2-4e85-b860-0d21a11fe067"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toDirectionalDerivativeHelp", "[", 
     RowBox[{"expr_Plus", ",", "iter_Integer"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"toDirectionalDerivativeHelp", "[", 
       RowBox[{"#", ",", "iter"}], "]"}], "&"}], "/@", "expr"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"toDirectionalDerivativeHelp", "[", 
   RowBox[{"expr_", ",", "iter_Integer"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"counterToDirectionalDerivativeHelp", "=", "0"}], ",", 
       "answer"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"answer", "=", 
       RowBox[{"FixedPoint", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"counterToDirectionalDerivativeHelp", "++"}], ";", 
            RowBox[{"Replace", "[", 
             RowBox[{"#", ",", "toDirectionalDerivativeRules", ",", "All"}], 
             "]"}]}], ")"}], "&"}], ",", "expr", ",", "iter"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"counterToDirectionalDerivativeHelp", ">=", "iter"}], ",", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"gaIteration", " ", "::", "maxlimit"}], ",", 
          "\"\<toDirectionalDerivativeHelp[expr]\>\""}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "answer"}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"Not", "[", 
    RowBox[{
     RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}], "]"}]}]}]}], "Input",\

 CellLabel->
  "In[1564]:=",ExpressionUUID->"c2445f4d-38e0-49c7-a2e0-b3a3df096daf"],

Cell[TextData[{
 "Lastly the final function which assembles all steps. All used rules are \
given below function. ",
 StyleBox["Latter one probably wants to add a warning when iteration limit is \
exceeded!",
  FontColor->RGBColor[1, 0.5, 0]]
}], "Text",ExpressionUUID->"ae1c2248-5a08-4f52-89ac-70a5dce87b52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
   "testOptionToDirectionalDerivative", "[", "\"\<MaxIterations\>\"", "]"}], 
   "=", "\"\<Positive integer\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionToDirectionalDerivative", "[", "\"\<Quiet\>\"", "]"}], 
    ":=", "\"\<True|False\>\""}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "argument", " ", "cal", " ", "is", " ", "used", " ", "for", 
    " ", "actual", " ", "check"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionToDirectionalDerivative", "[", 
    RowBox[{"\"\<MaxIterations\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Positive", "[", "val", "]"}], "&&", 
    RowBox[{"IntegerQ", "[", "val", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionToDirectionalDerivative", "[", 
     RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
    RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "gaToDirectionalDerivative", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MaxIterations", "->", "10"}], ",", 
     RowBox[{"Quiet", "->", "False"}]}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[1566]:=",ExpressionUUID->"13d28d21-d5a8-41bb-8247-8897b46619a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaToDirectionalDerivative", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"op", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theOption", ",", "expandedExpr", ",", 
        RowBox[{"counterExpansion", "=", "0"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"set", " ", "options"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gaSetNamedOptionValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"gaToDirectionalDerivative", ",", "#", ",", "theOption"}],
             "}"}], ",", 
           RowBox[{
            RowBox[{
            "gaOptionCheck", "[", "testOptionToDirectionalDerivative", "]"}], 
            "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
               "}"}]}], ")"}], "]"}], ",", 
           RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
          "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"{", "op", "}"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}], "]"}], "===",
           "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"MaxIterations", "/.", 
             RowBox[{"Options", "[", "gaToDirectionalDerivative", "]"}]}], 
            ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"MaxIterations", "->", "10"}], "}"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
          "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Quiet", "/.", 
             RowBox[{"Options", "[", "gaToDirectionalDerivative", "]"}]}], 
            ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"Quiet", "->", "False"}], "}"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"distribute", " ", "over", " ", "Plus"}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"expandedExpr", "=", 
        RowBox[{"FixedPoint", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"counterExpansion", "++"}], ";", 
             RowBox[{"Replace", "[", 
              RowBox[{"#", ",", "expansionArgumentRules", ",", "All"}], 
              "]"}]}], ")"}], "&"}], ",", "expr", ",", 
          RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"counterExpansion", ">=", 
          RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], ",", 
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"gaIteration", " ", "::", "maxlimit"}], ",", 
           "\"\<gaToDirectionalDerivative[expandedExpr]\>\""}], "]"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"work", " ", "only", " ", "on", " ", "expanded", " ", 
         RowBox[{"expression", " ", "!"}]}], " ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"toDirectionalDerivativeHelp", "[", 
        RowBox[{
         RowBox[{"toDerivativeAndArgumentPairs", "[", 
          RowBox[{"expandedExpr", ",", 
           RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], "]"}], 
         ",", 
         RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"expr", ",", "gaToDirectionalDerivative"}], "]"}]}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1571]:=",ExpressionUUID->"c4a36c67-916f-40ba-8d54-d365298f9520"],

Cell["\<\
First, to ensure more effective rule application we must make pairs  \
gaMultivectorDerivative[] and gaDerivativeArgument[], since in general syntax \
the same derivative can act on multiple argument (say to the left and to the \
right simultaneously).  However before making pairs we have to implement few \
additional steps 
1) expand terms which contains either gaMultivectorDerivative[_] or \
gaDerivativeArgument[_] (this will ensure that we have pure products). This \
is implemented with expansionArgumentRules (sum is expanded if it contains \
gaDerivativeArgument or gaMultivectorDerivative  (this gives considerable \
speedup)
2) properly dealt with pure operators () This is implemented with \
emptyDerivativeArgumentRulesBeforePairing and \
emptyDerivativeArgumentRulesAfterPairing\
\>", "Text",ExpressionUUID->"737133cd-5cd8-4d3b-b5f9-d8d0debcb2eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expansionArgumentRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"h", ":", 
        RowBox[{"(", 
         RowBox[{
         "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
          "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
      RowBox[{"args1___", ",", 
       RowBox[{"termWithDerivativeArg_", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Or", "[", 
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"{", "#", "}"}], ",", 
               RowBox[{"gaDerivativeArgument", "[", "_", "]"}], ",", 
               RowBox[{"Heads", "->", "True"}]}], "]"}], "]"}], ",", 
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"{", "#", "}"}], ",", 
               RowBox[{"gaMultivectorDerivative", "[", "_", "]"}], ",", 
               RowBox[{"Heads", "->", "True"}]}], "]"}], "]"}]}], "]"}], 
          "&"}], ")"}]}], ",", "args3___", ",", 
       RowBox[{"termPlus_Plus", "?", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Or", "[", 
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"{", "#", "}"}], ",", 
               RowBox[{"gaDerivativeArgument", "[", "_", "]"}], ",", 
               RowBox[{"Heads", "->", "True"}]}], "]"}], "]"}], ",", 
            RowBox[{"Not", "[", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"{", "#", "}"}], ",", 
               RowBox[{"gaMultivectorDerivative", "[", "_", "]"}], ",", 
               RowBox[{"Heads", "->", "True"}]}], "]"}], "]"}]}], "]"}], 
          "&"}], ")"}]}], ",", "args4___"}], "]"}], ":>", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{
         "args1", ",", "termWithDerivativeArg", ",", "args3", ",", "#", ",", 
          "args4"}], "]"}], "&"}], ",", "termPlus"}], "]"}]}], "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1572]:=",ExpressionUUID->"955494eb-a601-47cd-8322-172706b14f3a"],

Cell["\<\
In multipleDerivativeArgumentRules below we are forced to include \
gaMultivectorDerivative[id_] (or gaDerivativeArgument[id_] ), since the \
pattern with name id_ should be explicitly accessible to the pattern matcher \
(otherwise one can't be recognized  in RHS of the rule!)\
\>", "Text",ExpressionUUID->"01113ed5-cb3f-4643-8ca7-d56b75810ce3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"multipleDerivativeArgumentRules", "=", 
   RowBox[{"{", " ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "First", " ", "rule", " ", "applies", " ", "when", " ", 
      "DerivativeArguments", " ", "are", " ", "in", " ", "same", " ", "or", 
      " ", "deeper", " ", "levels", " ", "inside", " ", "h", " ", "product"}],
      "  ", "*)"}], " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", ":", 
         RowBox[{"(", 
          RowBox[{
          "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
           "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
       RowBox[{"args1___", ",", 
        RowBox[{
         RowBox[{"gaMultivectorDerivative", "[", "id_", "]"}], "[", 
         RowBox[{"rbasis_", ",", "pbasis_"}], "]"}], ",", "args3___"}], "]"}],
       ":>", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"replaceAtPositions", "=", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "args1", ",", "\"\<PlaceHolderForDerivativeID\>\"", ",", 
               "args3"}], "}"}], ",", "id"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "correctedPositions", "}"}], ",", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"replaceAtPositions", ",", 
                 RowBox[{
                  RowBox[{"MatchQ", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"___", ",", "0", ",", "1"}], "}"}]}], "]"}], 
                  "&"}]}], "]"}]}], ",", 
              RowBox[{
              "Echo", "[", 
               "\"\<Internal matching error in \
multipleDerivativeArgumentRules of gaToDirectionalDerivative[] (first \
rule)!!!\>\"", "]"}], ",", 
              RowBox[{"correctedPositions", "=", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Drop", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"-", "2"}]}], "]"}], "&"}], "/@", 
                 "replaceAtPositions"}], ")"}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "keep", " ", "only", " ", "one", " ", "position", " ", "per", 
               " ", "term"}], ",", " ", 
              RowBox[{
              "therefore", " ", "make", " ", "subsets", " ", "of", " ", "one",
                " ", "less", " ", "terms"}]}], " ", "*)"}], " ", 
            "\[IndentingNewLine]", 
            RowBox[{"Plus", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ReplaceAt", "[", 
                 RowBox[{
                  RowBox[{"h", "[", 
                   RowBox[{"args1", ",", 
                    RowBox[{
                    RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
                    
                    RowBox[{"rbasis", ",", "pbasis"}], "]"}], ",", "args3"}], 
                   "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                    "arg_", "]"}], ":>", "arg"}], "}"}], ",", "#"}], "]"}], 
                "&"}], "/@", 
               RowBox[{"Subsets", "[", 
                RowBox[{"correctedPositions", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Length", "[", "replaceAtPositions", "]"}], "-", 
                   "1"}], "}"}]}], "]"}]}], ")"}]}]}]}], 
          "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
       
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"args1", ",", "args3"}], "}"}], ",", "id", ",", 
            "Infinity", ",", 
            RowBox[{"Heads", "->", "True"}]}], "]"}], ">=", "2"}], ")"}], "&&", 
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"args1", ",", "args3"}], "}"}], ",", 
          RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], ",", 
          RowBox[{"Heads", "->", "True"}]}], "]"}]}]}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "when", " ", "gaDerivativeArgument", " ", "is", " ", "in", " ", "the", 
        " ", "outmost", " ", "level", " ", "in", " ", "h", " ", "product"}], 
       ",", " ", 
       RowBox[{
       "we", " ", "relate", " ", "the", " ", "transformation", " ", "with", 
        " ", 
        RowBox[{"DerivativeArgument", "[", "id", "]"}]}]}], " ", "*)"}], " ", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", ":", 
         RowBox[{"(", 
          RowBox[{
          "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|", 
           "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
       RowBox[{"args1___", ",", 
        RowBox[{
         RowBox[{"gaDerivativeArgument", "[", "id_", "]"}], "[", "expr_", 
         "]"}], ",", "args3___"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"replaceAtPositions", "=", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"args1", ",", 
                 RowBox[{
                  RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                  "expr", "]"}], ",", "args3"}], "}"}], "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
                  RowBox[{"_", ",", "_"}], "]"}], ":>", 
                 RowBox[{
                  RowBox[{
                  "gaMultivectorDerivative", "[", 
                   "\"\<PlaceHolderForDerivativeID\>\"", "]"}], "[", 
                  RowBox[{
                   RowBox[{"{", "\"\<PlaceHolderForDerivativeID\>\"", "}"}], 
                   ",", 
                   RowBox[{"{", "\"\<PlaceHolderForDerivativeID\>\"", "}"}]}],
                   "]"}]}], "}"}]}], ")"}], ",", "id"}], "]"}]}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "correctedPositions", "}"}], ",", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"replaceAtPositions", ",", 
                 RowBox[{
                  RowBox[{"MatchQ", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"{", 
                    RowBox[{"___", ",", "0", ",", "1"}], "}"}]}], "]"}], 
                  "&"}]}], "]"}]}], ",", 
              RowBox[{
              "Echo", "[", 
               "\"\<Internal matching error in \
multipleDerivativeArgumentRules of gaToDirectionalDerivative[] (second \
rule)!!!\>\"", "]"}], ",", 
              RowBox[{"correctedPositions", "=", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Drop", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"-", "2"}]}], "]"}], "&"}], "/@", 
                 "replaceAtPositions"}], ")"}]}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "keep", " ", "only", " ", "one", " ", "position", " ", "per", 
               " ", "term"}], ",", " ", 
              RowBox[{
              "therefore", " ", "make", " ", "subsets", " ", "of", " ", "one",
                " ", "less", " ", "terms"}]}], " ", "*)"}], " ", 
            "\[IndentingNewLine]", 
            RowBox[{"Plus", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"ReplaceAt", "[", 
                 RowBox[{
                  RowBox[{"h", "[", 
                   RowBox[{"args1", ",", 
                    RowBox[{
                    RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                    "expr", "]"}], ",", "args3"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"gaDerivativeArgument", "[", "id", "]"}], "[", 
                    "arg_", "]"}], ":>", "arg"}], "}"}], ",", "#"}], "]"}], 
                "&"}], "/@", 
               RowBox[{"Subsets", "[", 
                RowBox[{"correctedPositions", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Length", "[", "replaceAtPositions", "]"}], "-", 
                   "1"}], "}"}]}], "]"}]}], ")"}]}]}]}], 
          "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], "/;", 
       
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"args1", ",", "args3"}], "}"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"gaMultivectorDerivative", "[", "id", "]"}], "[", 
                RowBox[{"_", ",", "_"}], "]"}], ":>", 
