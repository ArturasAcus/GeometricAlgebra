       "thePointComponents", ",", "varToNumbersRules"}], "}"}], ",", 
     RowBox[{
      RowBox[{"varToNumbersRules", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"Rule", "[", 
           RowBox[{"theVarNames", ",", 
            RowBox[{"N", "[", 
