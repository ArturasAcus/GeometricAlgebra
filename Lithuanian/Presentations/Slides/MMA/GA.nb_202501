Cell[BoxData[
 RowBox[{
  RowBox[{"expOfMV", "[", 
   RowBox[{
   "expr_", ",", "\"\<CoordinateFree\>\"", ",", "\"\<LowDimension\>\"", ",", 
    "quiet_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
