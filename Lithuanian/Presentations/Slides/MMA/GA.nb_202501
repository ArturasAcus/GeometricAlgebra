  "In[1476]:=",ExpressionUUID->"dd0bc48f-0ea5-4196-8bd2-58b8bd6035ca"],

Cell["See also gaIndexUp[]/gaDindexDown[]. ", "Text",ExpressionUUID->"80391d3f-cf32-4378-ae88-ac0cc17949eb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{
      "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaDefinePrimaryBasis", "[", "primaryBasisVectors_List", "]"}], ":=", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"theChart", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"FirstCase", "[", 
             RowBox[{"primaryBasisVectors", ",", 
              RowBox[{
               RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}], ",", "0", ",",
               "Infinity"}], "]"}], "/.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"bs", "[", 
                RowBox[{"_", ",", "_", ",", "chartName_String"}], "]"}], "[", 
               "_", "]"}], ":>", "chartName"}], "}"}]}], ")"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"gaPrimaryBasisRules", "[", "theChart", "]"}], "=", 
         RowBox[{"Prepend", "[", 
          RowBox[{
           RowBox[{"MapAt", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Rule", "[", 
               RowBox[{"#", ",", 
                RowBox[{"gaPE", "[", "#", "]"}]}], "]"}], "&"}], ",", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"OuterProduct", "[", "##", "]"}], "&"}], "@@@", 
               RowBox[{"Rest", "[", 
                RowBox[{"Subsets", "[", "primaryBasisVectors", "]"}], "]"}]}],
               ")"}], ",", 
             RowBox[{"{", "All", "}"}]}], "]"}], ",", 
           RowBox[{"1", "->", "1"}]}], "]"}]}]}], "]"}], "/;", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"primaryBasisVectors", ",", 
           RowBox[{
            RowBox[{"bs", "[", "__", "]"}], "[", "_", "]"}]}], "]"}]}], "&&", 
        
        RowBox[{"FreeQ", "[", 
         RowBox[{"primaryBasisVectors", ",", 
          RowBox[{"mvDownUp", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"_", ",", "__"}], "}"}], ",", "_"}], "]"}]}], "]"}]}], 
       ")"}]}]}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
