Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"positiveQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "False", ",", 
     RowBox[{"Positive", "[", "x", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"negativeQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "False", ",", 
     RowBox[{"Negative", "[", "x", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeroQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "True", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gaVariables", "[", "x", "]"}], "===", 
        RowBox[{"{", "}"}]}], ",", "False", ",", 
       RowBox[{"x", "\[Equal]", "0"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonNegativeQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "True", ",", 
     RowBox[{
      RowBox[{"Positive", "[", "x", "]"}], "||", 
      RowBox[{"x", "\[Equal]", "0"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonzeroQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"Not", "[", 
      RowBox[{"PossibleZeroQ", "[", "x", "]"}], "]"}], ",", "True", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gaVariables", "[", "x", "]"}], "===", 
        RowBox[{"{", "}"}]}], ",", "False", ",", 
       RowBox[{"Not", "[", 
        RowBox[{"x", "\[Equal]", "0"}], "]"}]}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonPositiveQ", "[", "x_", "]"}], ":=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"PossibleZeroQ", "[", "x", "]"}], ",", "True", ",", 
     RowBox[{
      RowBox[{"Negative", "[", "x", "]"}], "||", 
      RowBox[{"x", "\[Equal]", "0"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
