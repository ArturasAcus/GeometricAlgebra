}], "Text",ExpressionUUID->"4abaca1c-120d-4802-affb-6d86dcc4f8c3"],

Cell["\<\
Algorithm based on characteristic polynomials formally outputs complex \
coefficients, though in fact they are always numerically real. At the moment \
the only value of \[OpenCurlyDoubleQuote]CoefficientDomain\
\[CloseCurlyDoubleQuote] is complex numbers, though we plan attempts to \
detect if it can be made reals (this is in general not possible). \
\>", "Text",ExpressionUUID->"81ca2e9a-c596-4793-903f-6bd6fb1a298d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "gaFunctionOfMV", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Expand", "\[Rule]", "Automatic"}], ",", 
      RowBox[{"Quiet", "\[Rule]", "False"}], ",", " ", 
      RowBox[{"Method", "->", "\"\<CoordinateFree\>\""}], ",", 
      RowBox[{"\"\<CoefficientDomain\>\"", "->", "Complexes"}]}], "}"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "single", " ", "argument", " ", "call", " ", "is", " ", "used", " ", "to", 
    " ", "print", " ", "valid", " ", "option", " ", "pattern", " ", "for", 
    " ", "user"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", "\"\<Expand\>\"", "]"}], "=", 
   RowBox[{
   "True", "|", "False", "|", "\"\<Automatic\>\"", "|", "Automatic", "|", 
    "gaProductExpand", "|", "gaPE", "|", "Identity", "|", 
    "\"\<any transformation (i.e with head Function[]) of expression\>\""}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", "\"\<Method\>\"", "]"}], "=", 
   "\"\<\\\"CoordinateFree\\\" | \\\"MinimalPolynomial\\\" | \\\"Matrix\\\" \
\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", "\"\<Quiet\>\"", "]"}], "=", 
   RowBox[{"\"\<True\>\"", "|", "\"\<False\>\""}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionFunctionOfMV", "[", "\"\<CoefficientDomain\>\"", "]"}],
     "=", 
    RowBox[{"Reals", "|", "Complexes"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "argument", " ", "cal", " ", "is", " ", "used", " ", "for", 
    " ", "actual", " ", "check"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", 
    RowBox[{"\"\<Expand\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{
     "True", "|", "False", "|", "\"\<Automatic\>\"", "|", "Automatic", "|", 
      "gaProductExpand", "|", "gaPE", "|", "Identity", "|", "_Function"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", 
    RowBox[{"\"\<Method\>\"", ",", "val_String"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{
     "\"\<CoordinateFree\>\"", "|", "\"\<MinimalPolynomial\>\"", "|", 
      "\"\<Matrix\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", 
    RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionFunctionOfMV", "[", 
    RowBox[{"\"\<CoefficientDomain\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{"Alternatives", "[", 
      RowBox[{"Reals", ",", "Complexes"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionFunctionOfMV", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"_", ",", "_"}], "}"}], ",", "_"}], "]"}], ":=", "False"}], 
   ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "refuse", " ", "to", " ", "accept", " ", "any", " ", "not", " ", 
    "explicitly", " ", "listed", " ", "suboptions"}], " ", 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellLabel->
  "In[1352]:=",ExpressionUUID->"4445011d-e7af-493a-9dfa-7c506fbdd622"],

Cell[TextData[{
 "Separate coordinate and coordinate free implementations and option \
handling. ",
 StyleBox["gaFunctionOfMV[ ]",
  FontWeight->"Bold"],
 " calls  ",
 StyleBox["functionOfMVCoordinate",
  FontWeight->"Bold"],
 " or ",
 StyleBox["functionOfMVCoordinateFree",
  FontWeight->"Bold"],
 "."
}], "Text",ExpressionUUID->"4606e918-5999-4e50-af68-ad00bfcc7310"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gaFunctionOfMV", "::", "method"}], "=", 
   "\"\<Invalid Method `1` specified. Choosing \\\"CoordinateFree\\\".\>\""}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaFunctionOfMV", "::", "CoefficientDomain"}], "=", 
    "\"\<The function `1` seems cannot be made real. \
\\\"CoefficientDomain\\\" is set to \\\"Complexes\\\".\>\""}], ";"}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaFunctionOfMV", "::", "MV"}], "=", 
    "\"\<The input expression `1` contains MV[] object. Explicit computation \
is not possible.\>\""}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaFunctionOfMV", "::", "Expand"}], "=", 
    "\"\<You are using nontrivial Expand function. In some cases it can take \
enormous time. If you will not obtain answer in reasonable time, set it to \
False and include Quiet\[Rule]False option to see which step is \
problematic.\>\""}], ";"}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaFunctionOfMV", "[", 
    RowBox[{
     RowBox[{"thefunction", ":", 
      RowBox[{"(", 
       RowBox[{"_Function", "|", "_Symbol"}], ")"}]}], ",", "expr_", ",", 
     RowBox[{"op", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"theOption", ",", 
       RowBox[{"exprExpanded", "=", 
        RowBox[{"gaPE", "[", "expr", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"set", " ", "and", " ", "test", " ", "option", " ", "values"}], 
      " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gaSetNamedOptionValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gaFunctionOfMV", ",", "#", ",", "theOption"}], "}"}], ",", 
          RowBox[{
           RowBox[{"gaOptionCheck", "[", "testOptionFunctionOfMV", "]"}], "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
              "}"}]}], ")"}], "]"}], ",", 
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
         "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"Flatten", "[", 
         RowBox[{"First", "/@", 
          RowBox[{"{", "op", "}"}]}], "]"}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "]"}], "===", 
         "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{"Method", "/.", 
           RowBox[{"Options", "[", "gaFunctionOfMV", "]"}]}], ")"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "]"}], "===", 
         "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{"Expand", "/.", 
           RowBox[{"Options", "[", "gaFunctionOfMV", "]"}]}], ")"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
         "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{"Quiet", "/.", 
           RowBox[{"Options", "[", "gaFunctionOfMV", "]"}]}], ")"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<CoefficientDomain\>\"", "]"}], "]"}],
          "===", "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<CoefficientDomain\>\"", "]"}], "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\"\<CoefficientDomain\>\"", "/.", 
            RowBox[{"Options", "[", "gaFunctionOfMV", "]"}]}], ")"}], "/.", 
          RowBox[{"{", 
           RowBox[{"\"\<CoefficientDomain\>\"", "->", "Complexes"}], 
           "}"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"theOption", "[", "\"\<CoefficientDomain\>\"", "]"}], "===", 
         "Reals"}], ",", 
        RowBox[{"printDetails", "[", 
         RowBox[{"False", ",", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
            "\"\<\\\"CoefficientDomain\\\" option in new function version is \
not yet implemented.\>\"", ",", "\"\<\>\""}], "}"}], "}"}]}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MatchQ", "[", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], ",", 
          RowBox[{"True", "|", "\"\<Automatic\>\"", "|", "Automatic"}]}], 
         "]"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Expand", "[", 
            RowBox[{"gaPE", "[", "#", "]"}], "]"}], "&"}], ")"}]}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"imposible", " ", "to", " ", "continue"}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"FreeQ", "[", 
          RowBox[{"exprExpanded", ",", "_MV"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"gaFunctionOfMV", "::", "MV"}], ",", "exprExpanded"}], 
          "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "separate", " ", "scalar", " ", "case", " ", "from", " ", 
        "multivector", " ", "case", " ", "and", " ", "switch", " ", "to", " ",
         "required", " ", "method"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"bs", "=", 
            RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], 
           "}"}], ",", 
          RowBox[{"!", 
           RowBox[{"FreeQ", "[", 
            RowBox[{"exprExpanded", ",", "_bs"}], "]"}]}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"printDetails", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<Using Method->\>\"", ",", 
               RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"\"\<ExpandFunction is->\>\"", ",", 
               RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}]}], "}"}]}], 
            "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"don", "'"}], "t", " ", "call", " ", "a", " ", "MV", " ", 
           "function", " ", "if", " ", "expression", " ", 
           RowBox[{"don", "'"}], "t", " ", "contain", " ", "any", " ", 
           "basis", " ", "element", " ", "of", " ", "MV", " ", "head"}], " ", 
          "*)"}], " ", "\[IndentingNewLine]", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}], ",", 
           "\[IndentingNewLine]", "\"\<CoordinateFree\>\"", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"functionOfMVMinimalPolynomialImplicit", "[", 
            RowBox[{"thefunction", ",", "exprExpanded", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
               RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}]}], "}"}]}], 
            "]"}], ",", "\[IndentingNewLine]", "\"\<MinimalPolynomial\>\"", 
           ",", "\[IndentingNewLine]", 
           RowBox[{"functionOfMVMinimalPolynomial", "[", 
            RowBox[{"thefunction", ",", "exprExpanded", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
               RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}]}], "}"}]}], 
            "]"}], ",", "\[IndentingNewLine]", "\"\<Matrix\>\"", ",", 
           "\[IndentingNewLine]", 
           RowBox[{"functionOfMVMatrix", "[", 
            RowBox[{"thefunction", ",", "exprExpanded", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
               RowBox[{"theOption", "[", "\"\<Expand\>\"", "]"}]}], "}"}]}], 
            "]"}], ",", "\[IndentingNewLine]", "_", ",", 
           RowBox[{
            RowBox[{"Message", "[", 
             RowBox[{
              RowBox[{"gaFunctionOfMV", "::", "method"}], ",", 
              RowBox[{"theOption", "[", "\"\<Method\>\"", "]"}]}], "]"}], ";", 
            RowBox[{"functionOfMVMinimalPolynomialImplicit", "[", 
             RowBox[{"thefunction", ",", "exprExpanded", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
