     RowBox[{"{", 
      RowBox[{"Cl", "[", 
       RowBox[{"1", ",", "0", ",", "0"}], "]"}], "}"}], ",", 
     RowBox[{"gaGetAlgebra", "[", "expr", "]"}]}], "]"}]}]}]], "Input",
