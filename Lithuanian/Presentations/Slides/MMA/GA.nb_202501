Cell[BoxData[
 RowBox[{
  RowBox[{"gaGeneralMultivector", "[", 
   RowBox[{"coefName_Symbol", ",", "coordChart_String", ",", 
    RowBox[{"gr", ":", "notOption", ":", "All"}], ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"grade", "=", "gr"}], ",", 
       RowBox[{"dimensionVectorSpace", "=", 
        RowBox[{"Length", "[", 
         RowBox[{"gaPrimaryVectors", "[", "coordChart", "]"}], "]"}]}], ",", 
       "nonzeroGradeMV"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"grade", ",", " ", 
           RowBox[{"(", 
            RowBox[{"All", "|", "\"\<All\>\"", "|", " ", 
             RowBox[{"{", 
              RowBox[{"__Integer", "?", "NonNegative"}], "}"}]}], ")"}]}], 
          "]"}]}], ",", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"gaGeneralMultivector", "::", "grade"}], ",", "grade"}], 
         "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "If", " ", "grade", " ", "unspecified", " ", "or", " ", "All"}], ",", 
        " ", 
        RowBox[{"generate", " ", "full", " ", "list"}]}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"grade", "===", 
           RowBox[{"{", "}"}]}], ")"}], "||", 
         RowBox[{"grade", "===", "All"}]}], ",", " ", 
        RowBox[{"grade", "=", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "dimensionVectorSpace"}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "compute", " ", "parts", " ", "of", " ", "all", " ", "required", "  ",
          "grades"}], " ", ",", " ", 
        RowBox[{"except", " ", "zero", " ", 
         RowBox[{"(", "scalar", ")"}]}]}], " ", "*)"}], "  ", 
      "\[IndentingNewLine]", 
      RowBox[{"nonzeroGradeMV", "=", 
       RowBox[{"(", 
        RowBox[{"Plus", "@@", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "y", "}"}], ",", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"Through", "[", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"coefName", "[", "i", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", 
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{"Binomial", "[", 
                    RowBox[{"dimensionVectorSpace", ",", "k"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "0", ",", 
                    RowBox[{"y", "-", "1"}]}], "}"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Sum", "[", 
                    RowBox[{
                    RowBox[{"Binomial", "[", 
                    RowBox[{"dimensionVectorSpace", ",", "k"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "0", ",", 
                    RowBox[{"y", "-", "1"}]}], "}"}]}], "]"}], "+", 
                    RowBox[{"Binomial", "[", 
                    RowBox[{"dimensionVectorSpace", ",", "y"}], "]"}], "-", 
                    "1"}]}], "}"}]}], "]"}], "[", "##", "]"}], "]"}], "&"}], "@@", 
                RowBox[{"gaCoordinateChartVars", "[", "coordChart", "]"}]}], 
               ")"}], ".", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{"(", 
                  RowBox[{"OuterProduct", "@@", 
                   RowBox[{"(", 
                    RowBox[{"{", "##", "}"}], ")"}]}], ")"}], "]"}], "@@@", 
                RowBox[{"(", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{
                    RowBox[{"{", "x", "}"}], ",", 
                    RowBox[{"Subsets", "[", 
                    RowBox[{
                    RowBox[{"gaPrimaryVectors", "[", "coordChart", "]"}], ",", 
                    RowBox[{"{", "x", "}"}]}], "]"}]}], "]"}], "/@", 
                    RowBox[{"{", "y", "}"}]}], ",", "1"}], "]"}], ")"}]}], 
               ")"}]}], ")"}]}], "]"}], "/@", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"grade", ",", "0"}], "]"}]}]}], ")"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"add", " ", "zero", " ", "grade", " ", "if", " ", "required"}],
        " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{"grade", ",", "0"}], "]"}], ",", 
        RowBox[{"nonzeroGradeMV", "+", 
         RowBox[{
          RowBox[{"coefName", "[", "0", "]"}], "@@", 
          RowBox[{"gaCoordinateChartVars", "[", "coordChart", "]"}]}]}], ",", 
        "nonzeroGradeMV"}], "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"MemberQ", "[", 
    RowBox[{"gaDefinedCoordinateCharts", ",", "coordChart"}], " ", 
    "]"}]}]}]], "Input",
 CellLabel->
  "In[1478]:=",ExpressionUUID->"6bc06d7c-9c8b-4f9a-b068-4a790d2b1ca3"],

Cell["Similarly for random MV", "Text",ExpressionUUID->"2b8642f1-8690-484b-860e-4ffa7aae99ac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaRandomMultivector", "[", 
   RowBox[{"coordChart_String", ",", 
    RowBox[{"gr", ":", "notOption", ":", "All"}], ",", 
    RowBox[{"op", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", "theOption"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gaSetNamedOptionValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gaRandomMultivector", ",", "#", ",", "theOption"}], "}"}],
           ",", 
          RowBox[{
           RowBox[{"gaOptionCheck", "[", "testOptionRandomMultivector", "]"}],
            "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
              "}"}]}], ")"}], "]"}], ",", 
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
         "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"First", "/@", 
         RowBox[{"{", "op", "}"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<CoefficientFunction\>\"", "]"}], 
          "]"}], "===", "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<CoefficientFunction\>\"", "]"}], "=", 
         
         RowBox[{"(", 
          RowBox[{"\"\<CoefficientFunction\>\"", "/.", 
           RowBox[{"Options", "[", "gaRandomMultivector", "]"}]}], ")"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"gaGeneralMultivector", "[", 
        RowBox[{"name", ",", "coordChart", ",", "gr"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"name", "[", "_", "]"}], "[", "__", "]"}], "\[RuleDelayed]", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<CoefficientFunction\>\"", "]"}], "[",
           "]"}]}], "}"}]}]}]}], "]"}], "/;", 
   RowBox[{"MemberQ", "[", 
    RowBox[{"gaDefinedCoordinateCharts", ",", "coordChart"}], " ", 
    "]"}]}]}]], "Input",
