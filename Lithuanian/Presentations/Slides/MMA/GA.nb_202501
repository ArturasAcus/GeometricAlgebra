 RowBox[{
  RowBox[{"$gaPackageOptions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"CompileTo", "\[Rule]", "\"\<WVM\>\""}], ",", 
     RowBox[{
     "gaOrthonormalBasisSymbolName", "\[Rule]", "\"\<\[DoubleStruckE]\>\""}], 
     ",", 
     RowBox[{"gaOrthonormalBasisSymbolInputAlias", "\[Rule]", "\"\<e\>\""}], 
     ",", 
     RowBox[{"gaCheckIndexConsistencyOnInput", "\[Rule]", "True"}], ",", 
     RowBox[{"gaMemoizeBasisElementProduct", "\[Rule]", "True"}], ",", 
     RowBox[{
     "gaDirectionalDerivativeSymbolName", "\[Rule]", 
      "\"\<\[DoubleStruckCapitalD]\>\""}], ",", 
     RowBox[{"gaDirectionalDerivativeInputAlias", "\[Rule]", "\"\<gaDD\>\""}],
      ",", 
     RowBox[{
     "gaFieldBasisSymbolName", "\[Rule]", "\"\<\[DoubleStruckF]\>\""}], ",", 
     RowBox[{"gaFieldBasisSymbolInputAlias", "\[Rule]", "\"\<ee\>\""}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"362f1c82-2248-4ec9-894e-99f37161f8e8"],

