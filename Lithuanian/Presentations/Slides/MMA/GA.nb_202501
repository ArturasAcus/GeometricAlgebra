Cell["Special function to clean Associations from trivial Values. ", "Text",ExpressionUUID->"b12e8a45-b09e-4d22-a26a-ac43433b23fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaAssociationRepresentationClean", "[", "expr_", "]"}], ":=", 
    RowBox[{"(", 
     RowBox[{"expr", "/.", "associationCleanRule"}], ")"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "we", " ", "also", " ", "need", " ", "work", " ", "on", " ", "Values"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"bs", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"associationCleanRule", "=", 
      RowBox[{"{", 
       RowBox[{"as_Association", "\[RuleDelayed]", 
        RowBox[{
         RowBox[{"Association", "@", 
          RowBox[{"(", 
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"#2", "===", "0"}], ")"}], "||", 
                 RowBox[{"MatchQ", "[", 
                  RowBox[{"#2", ",", 
                   RowBox[{"bs", "[", 
                    RowBox[{
                    RowBox[{"Association", "[", "]"}], ",", "__"}], "]"}]}], 
                  "]"}]}], ",", "Nothing", ",", 
                RowBox[{"#1", "\[Rule]", "#2"}]}], "]"}], "&"}], ",", "as"}], 
            "]"}], ")"}]}], "/;", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"Values", "[", "as", "]"}], ",", 
           RowBox[{"0", "|", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"Association", "[", "]"}], ",", "__"}], "]"}]}]}], 
          "]"}]}]}], "}"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[441]:=",ExpressionUUID->"c87caecf-89e5-4541-a17a-a9366df52e2f"]
}, Closed]],

