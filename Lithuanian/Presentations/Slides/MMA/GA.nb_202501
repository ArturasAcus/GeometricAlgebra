Cell[TextData[{
 "According to Sobczyk\[CloseCurlyQuote]s \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"New foundations in Mathematics\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Sobczyk_2013_New_Foundations_in_Mathematics.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "da00db0c-2f84-4cc5-ac7d-8897589347b8"],
 "\[CloseCurlyDoubleQuote],  chapter 15, after formula (15.11) the following \
definition should work. (Schindler\[CloseCurlyQuote]s article don\
\[CloseCurlyQuote]t provide a way to compute the Lie brackets!)\nFirst, \
formula for arbitrary vectors"
}], "Text",ExpressionUUID->"c00d5800-b381-4762-b2a7-df12ff482d61"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaLieBracket", "[", 
    RowBox[{
     RowBox[{"vec1_", "?", "gaPrimaryVectorQ"}], ",", 
     RowBox[{"vec2_", "?", "gaPrimaryVectorQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"theCoordSystem", "=", 
       RowBox[{"gaGetCoordinateChartName", "[", "vec1", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"MemberQ", "[", 
        RowBox[{"gaDefinedCoordinateCharts", ",", "theCoordSystem"}], "]"}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"vec1", "\[InnerProduct]", 
         RowBox[{"gaVectorDerivative", "[", 
          RowBox[{"vec2", ",", 
           RowBox[{"gaReciprocalVectors", "[", "theCoordSystem", "]"}]}], 
          "]"}]}], "-", 
        RowBox[{"vec2", "\[InnerProduct]", 
         RowBox[{"gaVectorDerivative", "[", 
          RowBox[{"vec1", ",", 
           RowBox[{"gaReciprocalVectors", "[", "theCoordSystem", "]"}]}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"Message", "[", 
        RowBox[{
         RowBox[{
         "gaDefineCoordinateChart", " ", "::", "notInCoordinateChartData"}], 
         ",", "theCoordSystem"}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[1585]:=",ExpressionUUID->"ecb428ca-b1bf-4369-a8d6-9f1203d7921b"],

