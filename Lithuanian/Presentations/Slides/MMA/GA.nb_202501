Cell["\<\
Index ordering detection in the input and the result behaviour\
\>", "Text",
 FontColor->RGBColor[
  1, 0, 1],ExpressionUUID->"4de7e83f-1926-44aa-9587-82222c3bcda5"],

Cell[TextData[{
 "If  global option checkIndexConsistency was set to True, then try to detect \
not strictly ordered index sets. Repeated indices inside ",
 StyleBox["mvDownUp[ ]",
  FontWeight->"Bold"],
 " are also forbidden (the repeated index has the meaning of signature and \
can be replaced by basis element without repeating indices with proper sign, \
for example e[1,2,3,2]-> -e[1,3] for Cl(p,q) with p>=2. This can change in \
future, since in curved space presence of same up and down index is \
meaningful) . The detection of such indices will require definition of down \
values for basis element symbols and this is what we want to avoid due to \
possible slowdown. Input of indices with larger values that number of base \
vectors are allowed, thought they are meaningless in computations."
}], "Text",ExpressionUUID->"cf55662e-7e87-45ba-b87e-85232764dd15"],

Cell["\<\
The check is implemented also for  basis elements defined on manifold. \
Important! if we detect incorrect input we return only message what is wrong \
since further computation will not make sense anyway  and even can result \
into infinite recursion (especially on manifold).\
\>", "Text",ExpressionUUID->"98b8bce6-162c-408c-a832-517713d52368"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"checkIndexConsistency", "::", "UnorderedSet"}], "=", 
   "\"\<Error. Not properly ordered index set `1` in expression input/output \
was detected. Only ordered sets can appear in calculations.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkIndexConsistency", "::", "SameIndices"}], "=", 
   "\"\<Error. Index set `1` contains repeated indices. All indices in base \
element should be different.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"checkIndexConsistency", "::", "IndexTooLarge"}], "=", 
   "\"\<Error. Index value in `1` that exceeds either Clifford vector space \
or coordinate chart manifold dimension is detected.\>\""}], ";"}]}], "Input",
 CellLabel->
  "In[132]:=",ExpressionUUID->"66b24610-a2fc-4ad2-9487-c48051bd23f9"],

Cell["\<\
If we detect error in the input, we output the initial expression with \
products wrapped by myInactive (on input). If not, simply return initial \
expression for further procession. If index is not an integer, remove it from \
being tested.\
\>", "Text",ExpressionUUID->"2e852558-632f-45dc-b9e6-e2303aa78dd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"gaCheckIndexConsistencyOnInput", "/.", "$gaPackageOptions"}], 
     ")"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"checkIndexConsistency", "[", 
        RowBox[{
         RowBox[{"{", "indexList__List", "}"}], ",", "maxInteger_Integer"}], 
        "]"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"flattenedList", "=", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"{", "indexList", "}"}], "]"}], ",", "_Integer"}], 
             "]"}]}], ",", "theTests"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"theTests", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"DeleteDuplicates", "[", "flattenedList", "]"}], "]"}],
               "===", 
              RowBox[{"Length", "[", "flattenedList", "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"And", "@@", 
              RowBox[{"(", 
               RowBox[{"OrderedQ", "/@", 
                RowBox[{"{", "indexList", "}"}]}], ")"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Max", "[", "flattenedList", "]"}], "<=", 
              "maxInteger"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"And", "@@", "theTests"}], ",", "True", ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"ReleaseHold", "[", 
              RowBox[{"Pick", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Hold", "[", 
                   RowBox[{"Message", "[", 
                    RowBox[{
                    RowBox[{"checkIndexConsistency", "::", "SameIndices"}], 
                    ",", 
                    RowBox[{"{", "indexList", "}"}]}], "]"}], "]"}], ",", 
                  RowBox[{"Hold", "[", 
                   RowBox[{"Message", "[", 
                    RowBox[{
                    RowBox[{"checkIndexConsistency", "::", "UnorderedSet"}], 
                    ",", 
                    RowBox[{"{", "indexList", "}"}]}], "]"}], "]"}], ",", 
                  RowBox[{"Hold", "[", 
                   RowBox[{"Message", "[", 
                    RowBox[{
                    RowBox[{"checkIndexConsistency", "::", "IndexTooLarge"}], 
                    ",", 
                    RowBox[{"{", "indexList", "}"}]}], "]"}], "]"}]}], "}"}], 
                ",", "\[IndentingNewLine]", 
                RowBox[{"Not", "/@", "theTests"}]}], "]"}], "]"}], ";", 
             "\[IndentingNewLine]", "False"}]}], "\[IndentingNewLine]", 
           "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "indexList", "}"}], ",", 
         RowBox[{
         "_Pattern", "|", "_Blank", "|", "_BlankSequence", "|", 
          "_BlankNullSequence"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"checkIndexConsistency", "[", "__", "]"}], "=", "True"}]}], 
   "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"48967f8a-11a2-4230-8176-b435dc99c975"]
}, Closed]]
}, Open  ]],

