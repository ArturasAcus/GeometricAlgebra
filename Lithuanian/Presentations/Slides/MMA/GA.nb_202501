             RowBox[{
             "for", " ", "noncommutative", " ", "geometric", " ", 
              "product"}]}], "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{"coefficientOperation", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"FreeQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"ass1", ",", "ass2"}], "}"}], ",", 
                "gaNonCommutativeFieldElementPattern"}], "]"}], ",", "Times", 
              ",", "GeometricProduct"}], "]"}]}], ",", "\[IndentingNewLine]", 
           
           RowBox[{"(*", " ", 
            RowBox[{
            "use", " ", "Total", " ", "for", " ", "merge", " ", "for", " ", 
             "all", " ", "cases"}], "*)"}], " ", "\[IndentingNewLine]", 
           RowBox[{"mergeOperation", "=", "Total"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", " ", 
