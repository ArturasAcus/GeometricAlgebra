            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", "3"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", "2"}], ",", 
                 RowBox[{
                  RowBox[{"alg", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "+", "4"}]}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"bs", "[", 
            RowBox[{
             RowBox[{"mvDownUp", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"alg", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "+", "4"}], "}"}], ",", 
               RowBox[{"{", "}"}]}], "]"}], ",", "alg"}], "]"}], "->", 
           RowBox[{"-", 
            RowBox[{"bs", "[", 
             RowBox[{
              RowBox[{"mvDownUp", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "2"}], ",", 
                  RowBox[{
                   RowBox[{"alg", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "+", "3"}]}], "}"}], ",", 
                
                RowBox[{"{", "}"}]}], "]"}], ",", "algNew"}], "]"}]}]}]}], 
         "}"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "now", " ", "replace", " ", "only", " ", "nontrivial", " ", "basis", 
          " ", "elements", " ", "by", " ", "lists", " ", "of", " ", 
