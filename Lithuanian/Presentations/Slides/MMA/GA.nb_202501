                   "\[IndentingNewLine]", "}"}]}], "]"}], "&"}], ",", "h", 
               ",", "maxIter"}], "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{"noncommutative", " ", "field"}], " ", "*)"}], " ", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"printDetails", "[", 
              RowBox[{"quiet", ",", 
               RowBox[{"{", "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{
                 "\"\<The coefficient function is\>\"", ",", "sftrue"}], 
                 "}"}], "\[IndentingNewLine]", "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"sftruepassed", "=", "sftrue"}], "}"}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"FixedPoint", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Replace", "[", 
                    RowBox[{"#", ",", "\[IndentingNewLine]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"argh_", "[", 
                    RowBox[{"arg1_", ",", "arg2_"}], "]"}], "]"}], 
                    "\[RuleDelayed]", 
                    RowBox[{"RuleCondition", "[", 
                    RowBox[{
                    RowBox[{"Distribute", "[", "\[IndentingNewLine]", 
                    RowBox[{"argh", "[", 
                    RowBox[{
                    RowBox[{"Collect", "[", 
                    RowBox[{"arg1", ",", 
                    RowBox[{"gaBasisElementPattern", "[", "al", "]"}], ",", 
                    "singleton"}], "]"}], ",", 
                    RowBox[{"Collect", "[", 
                    RowBox[{"arg2", ",", 
                    RowBox[{"gaBasisElementPattern", "[", "al", "]"}], ",", 
                    "singleton"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"argh", "===", 
                    RowBox[{"Head", "[", "h", "]"}]}], ")"}], "&&", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Head", "[", "arg1", "]"}], "===", "Plus"}], 
                    ")"}], "||", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Head", "[", "arg2", "]"}], "===", "Plus"}], 
                    ")"}]}], ")"}]}]}], "]"}]}], "\[IndentingNewLine]", "}"}],
                     ",", "All"}], "]"}], "&"}], ",", "h", ",", "maxIter"}], 
                   "]"}], "/.", 
                  RowBox[{"{", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"a__", ",", "b_", ",", "other___"}], "]"}], "]"}],
                     ":>", 
                    RowBox[{"RuleCondition", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Times", "[", 
                    RowBox[{
                    RowBox[{"singleton", "[", 
                    RowBox[{"sftruepassed", "[", 
                    RowBox[{
                    RowBox[{"GeometricProduct", "[", "a", "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"singleton", "->", "Identity"}], "}"}]}], "]"}], 
                    "]"}], ",", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"b", ",", "other"}], "]"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"gaNonCommutativeFieldElementQ", "[", 
                    RowBox[{"{", "a", "}"}], "]"}], "&&", 
                    RowBox[{"Not", "[", 
                    RowBox[{"gaFieldElementQ", "[", 
                    RowBox[{"{", "b", "}"}], "]"}], "]"}]}]}], "]"}]}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"GeometricProduct", "[", "a__", "]"}], "]"}], ":>", 
                    RowBox[{"RuleCondition", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"singleton", "[", 
                    RowBox[{"sftruepassed", "[", 
                    RowBox[{
                    RowBox[{"GeometricProduct", "[", "a", "]"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{"singleton", "->", "Identity"}], "}"}]}], "]"}], 
                    "]"}], ",", 
                    RowBox[{"gaNonCommutativeFieldElementQ", "[", 
                    RowBox[{"{", "a", "}"}], "]"}]}], "]"}]}]}], 
                   "\[IndentingNewLine]", "}"}]}], ",", 
                 RowBox[{"gaBasisElementPattern", "[", "al", "]"}]}], "]"}]}],
               "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
           "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]",
      "]"}], ";"}]}]}]], "Input",
