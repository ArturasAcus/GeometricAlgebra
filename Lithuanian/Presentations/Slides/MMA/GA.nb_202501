Cell["\<\
In order to properly collect operators we have to add a \
\[OpenCurlyDoubleQuote]collection with argument sorting\
\[CloseCurlyDoubleQuote] definition. This collection can\[CloseCurlyQuote]t \
be implemented as replacement rules, since occurs only after gaPE and other \
manipulations (much later).\
\>", "Text",ExpressionUUID->"4f3fa513-dab6-4d60-a6be-f77b52fe3859"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mvDOp", "[", "args_List", "]"}], ":=", 
   RowBox[{"mvDOp", "@@", 
    RowBox[{"Flatten", "[", "args", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mvDOp", "/:", 
   RowBox[{"HoldPattern", "[", 
    RowBox[{"Times", "[", 
     RowBox[{"any1___", ",", 
      RowBox[{"mvDOp", "[", "var1__", "]"}], ",", "any2___", ",", 
      RowBox[{"mvDOp", "[", "var2__", "]"}], ",", "any3___"}], "]"}], "]"}], ":=", 
   RowBox[{"Times", "[", 
    RowBox[{"any1", ",", "any2", ",", 
     RowBox[{"(", 
      RowBox[{"mvDOp", "@@", 
       RowBox[{"(", 
        RowBox[{"Sort", "[", 
         RowBox[{"{", 
          RowBox[{"var1", ",", "var2"}], "}"}], "]"}], ")"}]}], ")"}], ",", 
     "any3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mvDOp", "/:", 
    RowBox[{"HoldPattern", "[", 
     RowBox[{"Power", "[", 
      RowBox[{
       RowBox[{"mvDOp", "[", "var1__", "]"}], ",", 
       RowBox[{"n_Integer", "?", "Positive"}]}], "]"}], "]"}], ":=", 
    RowBox[{"mvDOp", "@@", 
     RowBox[{"(", 
      RowBox[{"Sort", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", "var1", "}"}], ",", 
          RowBox[{"{", "n", "}"}]}], "]"}], "]"}], "]"}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"rule", " ", "to", " ", "work", " ", "with", " ", "operators"}], 
    ",", " ", 
    RowBox[{
    "when", " ", "differentiation", " ", "operator", " ", "argument", " ", 
     "is", " ", 
     RowBox[{"empty", ".", " ", "This"}], " ", "rule", " ", "should", " ", 
     "be", " ", "applied", " ", "last"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mvDOp", "/:", 
   RowBox[{"HoldPattern", "[", 
    RowBox[{"mvD", "[", 
     RowBox[{
      RowBox[{"mvDOp", "[", "var1__", "]"}], ",", "var2_"}], "]"}], "]"}], ":=", 
   RowBox[{"mvDOp", "@@", 
    RowBox[{"(", 
