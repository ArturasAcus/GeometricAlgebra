    " ", "user"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "testOptionToCliffordMatrixRepresentation", "[", 
    "\"\<ReductionSequence\>\"", "]"}], "=", 
