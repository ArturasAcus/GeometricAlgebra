}], "Subsubsection",ExpressionUUID->"4752c398-43a4-45e3-97b3-28112bde453f"],

Cell["\<\
Here we implement square root algorithm of general multivector for n\
\[LessEqual]3 case. \
\>", "Text",ExpressionUUID->"58de283e-5610-4dc9-8dc9-070c4976700d"],

