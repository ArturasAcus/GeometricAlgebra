Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Subsection"],
 ".",
 
 CounterBox["Subsubsection"],
 ". gaDirectionalDerivative[ expr, var_?VectorQ] and related \
gaDerivativeExpand[]"
}], "Subsubsection",ExpressionUUID->"202bc665-492a-4eb9-8d7c-6e09f9a9842a"],

Cell[TextData[{
 "Following  J. C Schindler, \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Geometric Manifolds Part I:The Directional Derivative of \
Scalar, Vector, Multivector, and Tensor Fields\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Articles", "Schindler_2018_1911.07145.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "8ab855d0-f7ed-4ab5-ad11-fd515b650fd8"],
 "\[CloseCurlyDoubleQuote], (arXiv:1911.07145)  we introduce ",
 StyleBox["DirectionalDerivative",
  FontWeight->"Bold"],
 " (as he names it for scalar field, page 13) or ",
 StyleBox["AffineDerivative",
  FontWeight->"Bold"],
 " (as he names it when acting on vectors, page 15 ). We use name ",
 StyleBox["DirectionalDerivative",
  FontWeight->"Bold"],
 " for both.  ",
 StyleBox["Important:",
  FontColor->RGBColor[1, 0, 0]],
 " var_?VectorQ yields true both  for PRIMARY SPACE BASIS VECTOR  and  \
RECIPROCAL basis vector simply checking number of indices (down or up). Note, \
that there is no strict  way to  distinguish primary and reciprocal vectors \
since one can be obtained from the other simply by index rising or lowering. \
Important: ",
 StyleBox["DirectionalDerivative[expr, primary space element]",
  FontWeight->"Bold"],
 " should not be confused with ",
 StyleBox["gaMultivectorDerivative[expr, reciprocal space element, primary \
space element]",
  FontWeight->"Bold"],
 ". ",
 StyleBox["DirectionalDerivative[]",
  FontWeight->"Bold"],
 " is a \[OpenCurlyDoubleQuote]scalar\[CloseCurlyDoubleQuote] operator, \
whereas ",
 StyleBox["gaMultivectorDerivative[]",
  FontWeight->"Bold"],
 " is a multivector operator. There second arguments belongs to different \
basis. This is intentional, since formally ",
 StyleBox["DirectionalDerivative[expr, primary space element]",
  FontWeight->"Bold"],
 "  means differentiation with respect to up coordinate ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["i", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\partial_i=\\frac{\\partial}{\\partial x^i}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea91b0ac-714f-447a-a1d7-5e4224273486"],
 " , which means we use primary space coordinate (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x=\\mathrm{e}_k x^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6cdd90a3-780d-46a7-b045-4264716381ca"],
 "). Whereas  ",
 StyleBox["gaMultivectorDerivative[expr, reciprocal space element, primary \
space element]",
  FontWeight->"Bold"],
 " is understood as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]], 
         SubscriptBox["\[PartialD]", 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}^k\\partial_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59159665-42cc-47c1-83c1-1d9de4118775"],
 ". \n\n Sobczyk\[CloseCurlyQuote]s \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"New foundations in Mathematics\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "ElectronicHandBook", "BibliographySources", 
       "Sobczyk_2013_New_Foundations_in_Mathematics.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",ExpressionUUID->
  "f26105a8-f7b3-45ca-9d3e-bf6c283e2f65"],
 "\[CloseCurlyDoubleQuote] (see formula 15.7) uses  ",
 StyleBox["VectorDerivative",
  FontWeight->"Bold"],
 ", where the direction is defined to be given by RECIPROCAL VECTOR! In fact \
our ",
 StyleBox["gaMultivectorDerivative[]",
  FontWeight->"Bold"],
 " (at the moment) is nothing else as Sobczyk\[CloseCurlyQuote]s ",
 StyleBox["VectorDerivative",
  FontWeight->"Bold"],
 " .  We give a more general name since we hope it can be extended to \
multivectors as well (though at the moment nobody knows how to do this). \n\
Implementation of directional derivative with respect to DIRECT BASIS VECTOR. \
The real computations starts after asking to expand the expression with ",
 StyleBox["gaDerivativeExpand[]",
  FontWeight->"Bold"],
 " (shortcut ",
 StyleBox["gaDE[ ]",
  FontWeight->"Bold"],
 "). Use FixedPoint+Replace[,All].  maxIter is set to 50 for development, \
since value 10 is exceeded for quite simple input. "
}], "Text",ExpressionUUID->"2308fa30-61c8-4e2d-b87e-cbecf01889bd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"testOptionDerivativeExpand", "[", "\"\<MaxIterations\>\"", "]"}], 
   "=", "\"\<Positive integer\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
   "testOptionDerivativeExpand", "[", 
    "\"\<DirectionalDerivativeVariables\>\"", "]"}], ":=", 
   "\"\<List of variables\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionDerivativeExpand", "[", "\"\<Quiet\>\"", "]"}], ":=", 
    "\"\<True|False\>\""}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "two", " ", "argument", " ", "cal", " ", "is", " ", "used", " ", "for", 
    " ", "actual", " ", "check"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionDerivativeExpand", "[", 
    RowBox[{"\"\<MaxIterations\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Positive", "[", "val", "]"}], "&&", 
    RowBox[{"IntegerQ", "[", "val", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testOptionDerivativeExpand", "[", 
    RowBox[{"\"\<DirectionalDerivativeVariables\>\"", ",", "val_"}], "]"}], ":=", 
   RowBox[{"MatchQ", "[", 
    RowBox[{"val", ",", 
     RowBox[{"{", "___Rule", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"testOptionDerivativeExpand", "[", 
     RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
    RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "gaDerivativeExpand", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MaxIterations", "->", "50"}], ",", 
      RowBox[{"Quiet", "->", "False"}], ",", 
      RowBox[{"\"\<DirectionalDerivativeVariables\>\"", "->", 
       RowBox[{"{", "}"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gaDerivativeExpand", " ", "::", "expandHelp"}], "=", 
   "\"\<derivativeExpandHelp[] function wrapper detected in final answer \
output (the function will be stripped). The calculations were not completed \
and will contain explicit directional derivatives.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"gaDerivativeExpand", " ", "::", "derivativeVariable"}], "=", 
   "\"\<gaDerivativeExpand[] function (independent variable model) detected \
that variables specified by option \
\\\"DirectionalDerivativeVariables\\\"->`1` are not all symbols. Example of \
valid syntax: \
\\\"DirectionalDerivativeVariables\\\"->{1->x,e[1]->y,e[2,3]->a[1]}. The LHS \
in the rule is primary basis element (or 1), the RHS is independent variable \
(symbol, for example  x, or symbol enumerated, fore example x[11].\>\""}], 
  ";"}]}], "Input",
 CellLabel->
  "In[1536]:=",ExpressionUUID->"048e0e57-f6d2-4545-8080-c3e606ead9d4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaDerivativeExpand", "[", 
    RowBox[{"expr_", ",", 
     RowBox[{"op", ":", 
      RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"theOption", ",", "answerTest", ",", "varRules", ",", 
        RowBox[{"counterDE", "=", "0"}]}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"gaSetNamedOptionValue", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"gaDerivativeExpand", ",", "#", ",", "theOption"}], "}"}],
            ",", 
           RowBox[{
            RowBox[{"gaOptionCheck", "[", "testOptionDerivativeExpand", "]"}],
             "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
               "}"}]}], ")"}], "]"}], ",", 
           RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
          "]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{"First", "/@", 
          RowBox[{"{", "op", "}"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}], "]"}], "===",
           "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"MaxIterations", "/.", 
             RowBox[{"Options", "[", "gaDerivativeExpand", "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"MaxIterations", "->", "50"}], "}"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
          "theOption"}], ",", 
         RowBox[{
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Quiet", "/.", 
             RowBox[{"Options", "[", "gaDerivativeExpand", "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"Quiet", "->", "False"}], "}"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{
           "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", "]"}], 
           "]"}], "===", "theOption"}], ",", 
         RowBox[{
          RowBox[{
          "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", "]"}], 
          "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<DirectionalDerivativeVariables\>\"", "/.", 
             RowBox[{"Options", "[", "gaDerivativeExpand", "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"\"\<DirectionalDerivativeVariables\>\"", "->", 
             RowBox[{"{", "}"}]}], "}"}]}]}]}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{
         "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", "]"}], 
         ",", 
         RowBox[{"{", "}"}], ",", 
         RowBox[{"varRules", "=", 
          RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"{", "__Rule", "}"}], ",", 
         RowBox[{"varRules", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"FirstCase", "[", 
                 RowBox[{
                  RowBox[{"First", "[", "#", "]"}], ",", "_mvDownUp", ",", 
                  RowBox[{"mvDownUp", "[", 
                   RowBox[{
                    RowBox[{"{", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", 
                  RowBox[{"{", "2", "}"}], ",", 
                  RowBox[{"Heads", "->", "True"}]}], "]"}], "->", 
                RowBox[{"Last", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
             RowBox[{
             "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", 
              "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", "bothInd_mvDownUp", "}"}], ":>", "bothInd"}], 
            "}"}]}]}], ",", "\[IndentingNewLine]", "_", ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"gaDerivativeExpand", " ", "::", "derivativeVariable"}], 
            ",", 
            RowBox[{
            "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", 
             "]"}]}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{
        "check", " ", "if", " ", "differentiation", " ", "variables", " ", 
         "are", " ", 
         RowBox[{"symbols", ".", " ", "Abort"}], " ", "if", " ", "not"}], " ",
         "*)"}], " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"Not", "[", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"varRules", ",", 
            RowBox[{
             RowBox[{"MatchQ", "[", 
              RowBox[{"#", ",", 
               RowBox[{"Alternatives", "[", 
                RowBox[{
                 RowBox[{"HoldPattern", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "___", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], "->", "_Symbol"}], "]"}], 
                 ",", 
                 RowBox[{"HoldPattern", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{
                    RowBox[{"{", "___", "}"}], ",", 
                    RowBox[{"{", "}"}]}], "]"}], "->", 
                   RowBox[{"_Symbol", "[", "_Integer", "]"}]}], "]"}]}], 
                "]"}]}], "]"}], "&"}]}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{
            RowBox[{"gaDerivativeExpand", " ", "::", "derivativeVariable"}], 
            ",", 
            RowBox[{
            "theOption", "[", "\"\<DirectionalDerivativeVariables\>\"", 
             "]"}]}], "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Since", " ", "two", " ", "models", " ", "are", " ", "present"}], 
         ",", " ", 
         RowBox[{
         "we", " ", "have", " ", "to", " ", "modify", " ", "some", " ", 
          RowBox[{"rules", ".", " ", "Therefore"}], " ", "we", " ", 
          "introduce", " ", "second", " ", "argument", " ", "vars", " ", "in",
           " ", 
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{",", 
            RowBox[{"{", "vars", "}"}]}], "]"}]}]}], "  ", "*)"}], " ", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Then", " ", "for", " ", "rules"}], ",", " ", 
         RowBox[{
         "for", " ", "which", " ", "variables", " ", "are", " ", "not", " ", 
          "important", " ", "we", " ", "check", " ", "as", " ", "any_"}], ",",
          "  ", 
         RowBox[{
         "and", " ", "when", " ", "important", " ", "it", " ", "will", " ", 
          "be", " ", "either", " ", 
          RowBox[{"{", "}"}], " ", "or", " ", 
          RowBox[{"{", "vars__", "}"}]}]}], "  ", "*)"}], " ", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"answerTest", "=", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"theDERules", "=", "deRules"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"avoid", " ", "gaToDirectionalDerivative"}], ",", " ", 
              RowBox[{"which", " ", "expands", " ", "expression"}]}], " ", 
             "*)"}], " ", 
            RowBox[{"exprNoMultivectorD", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"FreeQ", "[", 
                RowBox[{"expr", ",", 
                 RowBox[{
                 "gaMultivectorDerivative", "|", "gaVectorDerivative", "|", 
                  "gaExteriorDerivative"}], ",", " ", 
                 RowBox[{"Heads", "->", "True"}]}], "]"}], ",", "expr", ",", 
               RowBox[{"gaToDirectionalDerivative", "[", "expr", "]"}]}], 
              "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"FixedPoint", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"counterDE", "++"}], ";", 
               RowBox[{"Replace", "[", 
                RowBox[{"#", ",", "theDERules", ",", "All"}], "]"}]}], ")"}], 
             "&"}], ",", "\[IndentingNewLine]", 
            RowBox[{"derivativeExpandHelp", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Replace", "[", "\[IndentingNewLine]", 
               RowBox[{"exprNoMultivectorD", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"gaDirectionalDerivative", "[", 
                   RowBox[{"ex_", ",", "ar_"}], "]"}], ":>", 
                  RowBox[{"derivativeExpandHelp", "[", 
                   RowBox[{
                    RowBox[{"gaDirectionalDerivative", "[", 
                    RowBox[{"ex", ",", "ar"}], "]"}], ",", "varRules"}], 
                   "]"}]}], "}"}], ",", "All"}], "]"}], ",", "varRules"}], 
             "\[IndentingNewLine]", "]"}], ",", 
            RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], 
           "]"}]}], "\[IndentingNewLine]", "]"}]}], ";", 
       RowBox[{"(*", " ", 
        RowBox[{"end", " ", "With"}], "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "check", " ", "if", " ", "max", " ", "iterations", " ", "was", " ", 
         "not", " ", "exceeded"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"counterDE", ">=", 
          RowBox[{"theOption", "[", "\"\<MaxIterations\>\"", "]"}]}], ",", 
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"gaIteration", " ", "::", "maxlimit"}], ",", 
           "\"\<gaDerivativeExpand[expandedExpr]\>\""}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"test", " ", "if", " ", "all", " ", "was", " ", "done"}], " ",
         "*)"}], " ", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"answerTest", ",", "_derivativeExpandHelp"}], "]"}], ",", 
         "\[IndentingNewLine]", "answerTest", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Message", "[", 
           RowBox[{"gaDerivativeExpand", " ", "::", "expandHelp"}], "]"}], 
          ";", 
          RowBox[{"(", 
           RowBox[{"answerTest", "//.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"HoldPattern", "[", 
               RowBox[{"derivativeExpandHelp", "[", 
                RowBox[{"arg1_", ",", "_"}], "]"}], "]"}], ":>", "arg1"}], 
             "}"}]}], ")"}]}]}], "\[IndentingNewLine]", "]"}]}]}], 
     "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"expr", ",", "gaDerivativeExpand"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->
  "In[1545]:=",ExpressionUUID->"2e71f588-ff49-4bae-bc8d-26f3ee482fa1"],

Cell["\<\
Linearity with respect to the expression argument:
1)Nothing to do when there are no DirectionalDerivative (notation DD in \
formal explanation rules ). 
2) Map over Plus arguments: D[s_?Scalar A_?Multivector,a]->s*DD[A,a] and \
DD[A+B,a]->DD[A,a]+DD[B,a]
3) Linearity in the (multi)vector field argument: DD[A+B,a]=DD[A,a]+DD[B,a]\
\>", "Text",ExpressionUUID->"e266808c-af50-4f3b-b38d-1adaf8540a7b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deLinearityArgumentRules", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{
       "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{"expr_", ",", "_"}], "]"}], "]"}], ":>", 
        RowBox[{"expr", "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", "gaDirectionalDerivative"}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"Times", "[", 
            RowBox[{"c_", ",", "expr__"}], "]"}], ",", "any_"}], "]"}], "]"}],
         ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "*", 
           RowBox[{"derivativeExpandHelp", "[", 
            RowBox[{
             RowBox[{"Times", "[", "expr", "]"}], ",", "any"}], "]"}]}], 
          ")"}], "/;", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "c", "}"}], ",", 
             RowBox[{"Alternatives", "@@", 
              RowBox[{"{", 
               RowBox[{"MV", ",", "bs", ",", "any"}], "}"}]}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "expr", "}"}], ",", 
             RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
            "]"}]}], ")"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{"expr_Plus", ",", "any_"}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"derivativeExpandHelp", "[", 
             RowBox[{"#", ",", "any"}], "]"}], "&"}], "/@", "expr"}], ")"}], "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{"expr_Plus", ",", "arg_"}], "]"}], ",", "any_"}], "]"}], 
         "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"derivativeExpandHelp", "[", 
             RowBox[{
              RowBox[{"gaDirectionalDerivative", "[", 
               RowBox[{"#", ",", "arg"}], "]"}], ",", "any"}], "]"}], "&"}], "/@",
            "expr"}], ")"}], "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
          "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1546]:=",ExpressionUUID->"fed6cf06-6277-4460-ad25-2580d3240fe4"],

Cell["\<\
Linearity with respect to the direction:
1) Map over Plus arguments in direction argument DD[A,a+b]->DD[A,a]+DD[A,b]
 2) Factor out of derivative expression if direction don\[CloseCurlyQuote]t \
have MVs or vars DD[A,s_?Scalar*a]->s*DD[A,a]\
\>", "Text",ExpressionUUID->"469cecfe-781a-47d0-87e7-5422e47050bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deLinearityDirectionRules", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{
       "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{"expr_", ",", "arg_Plus"}], "]"}], ",", "any_"}], "]"}], 
         "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"derivativeExpandHelp", "[", 
             RowBox[{
              RowBox[{"gaDirectionalDerivative", "[", 
               RowBox[{"expr", ",", "#"}], "]"}], ",", "any"}], "]"}], "&"}], 
           "/@", "arg"}], ")"}], "/;", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
          "]"}]}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{"expr_", ",", 
             RowBox[{"Times", "[", 
              RowBox[{"c_", ",", "arg__"}], "]"}]}], "]"}], ",", "any_"}], 
          "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"c", "*", 
           RowBox[{"derivativeExpandHelp", "[", 
            RowBox[{
             RowBox[{"gaDirectionalDerivative", "[", 
              RowBox[{"expr", ",", 
               RowBox[{"Times", "[", "arg", "]"}]}], "]"}], ",", "any"}], 
            "]"}]}], ")"}], "/;", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "c", "}"}], ",", 
             RowBox[{"Alternatives", "@@", 
              RowBox[{"{", 
               RowBox[{"MV", ",", "bs", ",", "any"}], "}"}]}], ",", 
             RowBox[{"Heads", "->", "True"}]}], "]"}], "&&", 
           RowBox[{"FreeQ", "[", 
            RowBox[{
             RowBox[{"{", "expr", "}"}], ",", 
             RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
            "]"}]}], ")"}]}]}]}], "\[IndentingNewLine]", "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1547]:=",ExpressionUUID->"71a67902-ef44-42dd-a54f-a6ac3abae107"],

Cell["\<\
Argument product rules:
1) Go inside products (Note, the brackets around h are important. Otherwise \
procedure will go wrong). Help function goes inside product.
2) differentiate each product term and sum a result: \
DD[A\[GeometricProduct]B,a]->DD[A,a]\[GeometricProduct]B+A\[GeometricProduct]\
DD[A,a]\
\>", "Text",ExpressionUUID->"48ced844-91e8-451e-be35-4682225ec6f7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deArgumentProductRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"derivativeExpandHelp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"h", ":", 
           RowBox[{"(", 
            RowBox[{
            "GeometricProduct", "|", "OuterProduct", "|", "InnerProduct", "|",
              "LeftContract", "|", "RightContract"}], ")"}]}], ")"}], "[", 
         "arg1__", "]"}], ",", "any_"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"derivativeExpandHelp", "[", 
           RowBox[{"#", ",", "any"}], "]"}], "&"}], "/@", 
         RowBox[{"h", "[", "arg1", "]"}]}], ")"}], "/;", 
       RowBox[{
        RowBox[{"Not", "[", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "arg1", "}"}], ",", "gaDirectionalDerivative"}], 
          "]"}], "]"}], "&&", 
        RowBox[{"FreeQ", "[", 
         RowBox[{
          RowBox[{"{", "arg1", "}"}], ",", 
          RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
         "]"}]}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"HoldPattern", "[", 
       RowBox[{"derivativeExpandHelp", "[", 
        RowBox[{
         RowBox[{"gaDirectionalDerivative", "[", 
          RowBox[{
           RowBox[{"expr", ":", 
            RowBox[{"(", 
             RowBox[{
             "_GeometricProduct", "|", "_OuterProduct", "|", "_InnerProduct", 
              "|", "_LeftContract", "|", "_RightContract"}], ")"}]}], ",", 
           "arg_"}], "]"}], ",", "any_"}], "]"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Plus", "@@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"ReplacePart", "[", 
            RowBox[{"expr", ",", 
             RowBox[{"i", "->", 
              RowBox[{"derivativeExpandHelp", "[", 
               RowBox[{
                RowBox[{"gaDirectionalDerivative", "[", 
                 RowBox[{
                  RowBox[{"expr", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", "arg"}], "]"}], ",", 
                "any"}], "]"}]}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "expr", "]"}]}], "}"}]}], "]"}]}], ")"}], 
       "/;", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Length", "[", "expr", "]"}], ">", "1"}], ")"}], "&&", 
         RowBox[{"FreeQ", "[", 
          RowBox[{
           RowBox[{"{", "expr", "}"}], ",", 
           RowBox[{"derivativeExpandHelp", "|", "gaDerivativeExpand"}]}], 
          "]"}]}], ")"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[1548]:=",ExpressionUUID->"1006a229-b22b-4cf7-bbdc-44000428c8bc"],

Cell["\<\
Differentiation of scalar:
1) pass known case to mvD: gaDirectionalDerivative (DD) for scalar should \
return a scalar DD[s_?Scalar, a]->D[s]
2) If we have scalar multiplied by MV, differentiate the scalar with mvD (for \
short D in formal rules); DD[s_?Scalar * A,a]->D[s]*A+s*DD[A,a]
3) When direction is a bivector or higher grade basis element \
\>", "Text",ExpressionUUID->"6334fec6-4046-4161-a901-b7e0b94bb708"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deScalarRules", "=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bs", "=", 
       RowBox[{
       "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "rules", " ", "depend", " ", "on", " ", "directional", " ", 
         "derivative", " ", 
         RowBox[{"model", ".", " ", 
          StyleBox["Point",
           FontColor->RGBColor[1, 0.5, 0]]}], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox["function",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox[" ",
          FontColor->RGBColor[1, 0.5, 0]], 
         StyleBox[
          RowBox[{"model", ":", " ", 
           RowBox[{
            RowBox[{"don", "'"}], "t", " ", "know", " ", "how", " ", "to", 
            " ", "extend", " ", "to", " ", "multivector", " ", 
            "derivative"}]}],
          FontColor->RGBColor[1, 0.5, 0]]}], 
        StyleBox[",",
         FontColor->RGBColor[1, 0.5, 0]], 
        StyleBox[" ",
         FontColor->RGBColor[1, 0.5, 0]], 
        StyleBox[
         RowBox[{"problem", " ", "is", " ", "Leibnitz", " ", "rule"}],
         FontColor->RGBColor[1, 0.5, 0]]}], 
       StyleBox[" ",
        FontColor->RGBColor[1, 0.5, 0]], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"gaDerivativeArgument", "[", "ids_", "]"}], "[", "]"}], 
             ",", 
             RowBox[{
              RowBox[{"bs", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{"upInd_List", ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "__"}], "]"}], "[", 
              RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{
          RowBox[{"gaDerivativeArgument", "[", "ids", "]"}], "[", 
          RowBox[{"mvDOp", "@@", 
           RowBox[{"(", 
            RowBox[{"vars", "[", 
             RowBox[{"[", "upInd", "]"}], "]"}], ")"}]}], "]"}], "/;", 
         RowBox[{
          RowBox[{"Length", "[", "upInd", "]"}], "===", "1"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{"expr_", ",", 
             RowBox[{
              RowBox[{"bs", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{"upInd_List", ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "__"}], "]"}], "[", 
              RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"mvD", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"vars", "[", 
            RowBox[{"[", "upInd", "]"}], "]"}]}], "]"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gaGradeList", "[", "expr", "]"}], "===", 
            RowBox[{"{", "0", "}"}]}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "upInd", "]"}], "===", "1"}], ")"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"HoldPattern", "[", 
         RowBox[{"derivativeExpandHelp", "[", 
          RowBox[{
           RowBox[{"gaDirectionalDerivative", "[", 
            RowBox[{
             RowBox[{"Times", "[", 
              RowBox[{"c_", ",", "expr__"}], "]"}], ",", 
             RowBox[{
              RowBox[{"bs", "[", 
               RowBox[{
                RowBox[{"mvDownUp", "[", 
                 RowBox[{"upInd_List", ",", 
                  RowBox[{"{", "}"}]}], "]"}], ",", "args1__"}], "]"}], "[", 
              RowBox[{"mvPoint", "[", "vars_List", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], "]"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Times", "[", 
            RowBox[{
             RowBox[{"mvD", "[", 
              RowBox[{"c", ",", 
               RowBox[{"vars", "[", 
                RowBox[{"[", "upInd", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"Times", "[", "expr", "]"}]}], "]"}], "+", 
           RowBox[{"c", "*", 
            RowBox[{"derivativeExpandHelp", "[", 
             RowBox[{
              RowBox[{"gaDirectionalDerivative", "[", 
               RowBox[{
                RowBox[{"Times", "[", "expr", "]"}], ",", 
                RowBox[{
                 RowBox[{"bs", "[", 
                  RowBox[{
                   RowBox[{"mvDownUp", "[", 
                    RowBox[{"upInd", ",", 
                    RowBox[{"{", "}"}]}], "]"}], ",", "args1"}], "]"}], "[", 
                 RowBox[{"mvPoint", "[", "vars", "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}]}], ")"}], "/;", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gaGradeList", "[", "c", "]"}], "===", 
            RowBox[{"{", "0", "}"}]}], ")"}], "&&", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Length", "[", "upInd", "]"}], "===", "1"}], ")"}]}]}]}], 
       ",", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "\"\<differentiation\>\"", " ", "of", " ", "expr", " ", "along", " ", 
         "scalar", " ", "is", " ", 
         RowBox[{"zero", "?", " ", "or"}], " ", "expr", " ", 
