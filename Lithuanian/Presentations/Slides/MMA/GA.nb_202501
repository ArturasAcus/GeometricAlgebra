  "In[371]:=",ExpressionUUID->"9a64fc49-d22e-4a1c-a972-af4534f920c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaGeometricMatrixProduct", "[", 
     RowBox[{
      RowBox[{"a_", "?", "MatrixQ"}], ",", 
      RowBox[{"b_", "?", "MatrixQ"}]}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Inner", "[", 
