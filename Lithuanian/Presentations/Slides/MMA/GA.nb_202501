Cell[TextData[{
 "The inactivation of products at input time was introduced to avoid \
automatic evaluation of product of basis elements. For example, without \
inactivation  ",
 StyleBox["GeometricProduct[e[1],e[2]]",
  FontWeight->"Bold"],
 " would be immediately attempt to compute before checking if input basis \
elements were valid (for example they could contain index outside meaningful \
index range space). "
}], "Text",ExpressionUUID->"59e95ce5-6906-4083-8489-99a31c6132c7"],

