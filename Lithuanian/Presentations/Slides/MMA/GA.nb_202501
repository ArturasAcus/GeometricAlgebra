    RowBox[{"1", ",", 
     RowBox[{"range_", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "10"}], ",", "10"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"RandomInteger", "[", "range", "]"}]}], ";", 
