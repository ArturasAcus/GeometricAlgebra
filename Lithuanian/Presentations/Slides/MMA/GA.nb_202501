         RowBox[{"Not", "[", 
          RowBox[{"MatrixQ", "[", "#", "]"}], "]"}], "&"}], ")"}]}], ",", 
      RowBox[{"b_", "?", "MatrixQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
