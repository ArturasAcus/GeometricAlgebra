Cell["\<\
The gaFaddeevLieVerrierSouriauCoefficients[expr_,n_Integer] implements \
Faddeev LieVerrier Souriau algorithm. User can manually provide dimension of \
matrix representation n. \
\>", "Text",ExpressionUUID->"ceea6d6c-fc49-446a-973c-0dcd2d1be958"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaFaddeevLieVerrierSouriauCoefficients", "[", 
   RowBox[{"expr_", ",", "n_Integer"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"count", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(", 
      RowBox[{"Last", "/@", 
       RowBox[{"NestList", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"gaPE", "[", 
               RowBox[{"Subtract", "@@", "##"}], "]"}], ",", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", "x", "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"n", "/", 
                   RowBox[{"(", 
                    RowBox[{"count", "+=", "1"}], ")"}]}], ")"}], "*", 
                 RowBox[{"gaGetMV", "[", 
                  RowBox[{"x", ",", 
                   RowBox[{"{", "0", "}"}]}], "]"}]}]}], "}"}]}], "]"}], "[", 
            
            RowBox[{"gaPE", "[", 
             RowBox[{"expr", "\[GeometricProduct]", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "]"}], "&"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], ",", "n"}], "]"}]}], ")"}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"Not", "[", 
    RowBox[{"MatrixQ", "[", "expr", "]"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[1097]:=",ExpressionUUID->"07dcc7dc-d9ea-4ec6-8693-ed0ee0be2558"],

Cell["\<\
If dimension is not provided we attempt to compute it from algebra.  \
\>", "Text",ExpressionUUID->"abf0b8ee-3de7-4bfc-9960-5986aa4c00b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaFaddeevLieVerrierSouriauCoefficients", "[", "expr_", "]"}], ":=", 
  RowBox[{
   RowBox[{"gaPlainRepresentation", "[", 
    RowBox[{"gaFaddeevLieVerrierSouriauCoefficients", "[", 
     RowBox[{"expr", ",", 
      RowBox[{"gaDimensionOfRepresentation", "[", 
       RowBox[{"gaGetAlgebra", "[", "expr", "]"}], "]"}]}], "]"}], "]"}], "/;", 
   RowBox[{"Not", "[", 
    RowBox[{"MatrixQ", "[", "expr", "]"}], "]"}]}]}]], "Input",
 CellLabel->
  "In[1098]:=",ExpressionUUID->"853a6814-31dc-4da6-8e5b-e37e694c9f4f"],

Cell["\<\
When we need only one coefficient, seems \
characteristicPolynomialFormulaByLeftNest[ ] is best (for general MV)\
\>", "Text",ExpressionUUID->"8d968df0-1f2c-482e-97f3-7db08c6cf02f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"characteristicPolynomialFormulaByLeftNest", "[", 
   RowBox[{"expr_", ",", "theAlgebra_Cl", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"dim", "=", 
       RowBox[{"(", 
        RowBox[{"2", "^", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"gaDimensionOfVectorSpace", "[", "theAlgebra", "]"}], "/", 
           "2"}], "]"}]}], ")"}]}], ",", "tarp"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tarp", "=", 
      RowBox[{"Nest", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
           RowBox[{"gaPE", "[", 
            RowBox[{"GeometricProduct", "[", 
             RowBox[{"expr", ",", 
              RowBox[{"gaPE", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "-", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"dim", "/", 
                    RowBox[{"(", 
                    RowBox[{"(", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ")"}], ")"}]}], ")"}], 
                  "*", 
                  RowBox[{"(", 
                   RowBox[{"gaGetMV", "[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", 
                    RowBox[{"{", "0", "}"}]}], "]"}], ")"}]}], ")"}]}], 
               "]"}]}], "]"}], "]"}]}], "}"}], "&"}], ",", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{"1", ",", "expr"}], "}"}], ",", 
        RowBox[{"n", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"gaPE", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"dim", "/", 
            RowBox[{"First", "[", "#", "]"}]}], ")"}], "*", 
          RowBox[{"gaGetMV", "[", 
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], ",", 
            RowBox[{"{", "0", "}"}]}], "]"}]}], ")"}], "&"}], "[", "tarp", 
       "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[1099]:=",ExpressionUUID->"4859e573-91ea-4579-8cbd-45c7e0b955e3"],

Cell["\<\
Recursive implementation using Nest tend to be much faster. Still needs to \
decide how to handle expansion in this case (at the moment expanded version \
implemented)\
\>", "Text",ExpressionUUID->"e69f5364-a095-4719-b486-26c543943f1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"determinantFormulaByLeftNest", "[", 
    RowBox[{"expr_", ",", "theAlgebra_Cl"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "theNumberOfNestLevels", "}"}], ",", 
     RowBox[{
      RowBox[{"theNumberOfNestLevels", "=", 
       RowBox[{"(", 
        RowBox[{"2", "^", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"gaDimensionOfVectorSpace", "[", "theAlgebra", "]"}], "/", 
           "2"}], "]"}]}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Last", "[", 
       RowBox[{"Nest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "+", "1"}], ",", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{"GeometricProduct", "[", 
               RowBox[{"expr", ",", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "+", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "/", 
                    RowBox[{"(", 
                    RowBox[{"2", 
                    RowBox[{"(", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ")"}]}], ")"}]}], ")"}], 
                   "*", "theNumberOfNestLevels", "*", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "+", 
                    RowBox[{"gaNonZeroGradeInverse", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}]}], 
                  ")"}]}]}], "]"}], "]"}], "]"}]}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "expr"}], "}"}], ",", 
         RowBox[{"theNumberOfNestLevels", "-", "1"}]}], "]"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[1100]:=",ExpressionUUID->"f5e61b77-eeed-4dab-b50c-8696615498c0"],

Cell[TextData[{
 "Functions for determinant calculation using explicit formula to use with \
algebras of dimension n> 6 (see D. Shirokov, \[CloseCurlyDoubleQuote]",
 Cell[BoxData[
