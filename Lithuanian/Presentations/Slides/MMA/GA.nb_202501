Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"basisSymbol", "=", 
      RowBox[{"Symbol", "[", "orthonormalBasisSymbolName", "]"}]}], "}"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gaMVFunctionFreeQ", "[", "expr_", "]"}], ":=", 
     RowBox[{"FreeQ", "[", 
      RowBox[{"expr", ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Except", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
            "Times", "|", "Plus", "|", "basisSymbol", "|", "GeometricProduct",
              "|", "OuterProduct", "|", "InnerProduct", "|", "LeftContract", 
             "|", "RightContract", "|", "MV"}], ")"}], ",", "_"}], "]"}], 
         ")"}], "[", 
        RowBox[{"__", "?", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Not", "[", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"{", "#", "}"}], ",", 
              RowBox[{"basisSymbol", "|", "MV"}], ",", 
              RowBox[{"Heads", "->", "True"}]}], "]"}], "]"}], "&"}], ")"}]}],
         "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Input",
 CellLabel->
  "In[246]:=",ExpressionUUID->"3775fe21-6f65-4e21-9fc6-fbb3a39b755a"]
}, Closed]],

