         RowBox[{
           StyleBox["t", "TI"], "\[LongEqual]", "0"}], 
         RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], 
            StyleBox["i", "TI"]], "-", "1"}], LimitsPositioning -> True], 
        SubscriptBox[
         RowBox[{"(", 
           FractionBox[
            RowBox[{
