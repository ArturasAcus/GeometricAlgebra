Cell[TextData[{
 "Tokiu b\:016bdu matric\:0105 galima \:012fsivaizduoti kaip \
\[OpenCurlyDoubleQuote]vektori\:0173\[CloseCurlyDoubleQuote] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "c2f04950-ae91-4caf-b468-4551de0b4039"],
 " erdv\:0117je (tiesin\:0117 erdv\:0117: vektorius galim sud\:0117t ir \
daugint i\[SHacek] skai\[CHacek]iaus, bet ai\[SHacek]ku, dviej\:0173 vektori\
\:0173 sudaugint negalima). Tada Cayley-Hamilton teorema u\[ZHacek]deda rib\
\:0105 kiek \[OpenCurlyDoubleQuote]vektori\:0173\[CloseCurlyDoubleQuote] \
\[SHacek]ioje erdv\:0117je gali b\:016bti tiesi\[SHacek]kai nepriklausomi: b\
\:016btent, tik n. Analogas paprastoje, pavyzd\[ZHacek]iui, trimat\:0117je 3D \
erdv\:0117je gali b\:016bti tik 3 tiesi\[SHacek]kai nepriklausomi vektoriai, \
4-tasis bus b\:016btinai tiesi\[SHacek]kai priklausomas. Tod\:0117l matric\
\:0173 erdv\:0117 kiek keistoka, bet  Cayley-Hamilton teorema savo esme yra \
triviali. "
}], "Text",
 CellChangeTimes->{{3.944902188348929*^9, 3.9449022004076223`*^9}, {
  3.944902365533331*^9, 3.944902453778809*^9}, {3.944902503184885*^9, 
  3.944902944181287*^9}},ExpressionUUID->"54fc8da7-1fb8-48a1-94d4-\
2e8affdf5656"],

