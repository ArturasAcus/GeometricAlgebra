Cell[TextData[{
 "Alternuojanti varpo formos konvergencija . Pavaizduota kaip \
kei\[CHacek]iasi koeficiento   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["a", "TI"], "12"], TraditionalForm], "errors" -> {}, "input" -> 
     "a_{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5014bc1-b18d-49f6-823c-510fb39bbbb4"],
 " vert\:0117 nuo sumos nari\:0173 (iteracij\:0173)  skai\[CHacek]iaus. Po \
20-os iteracijos gauname ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], "12"], "\[LongEqual]", "0.902645", "\[Cross]", 
         
         SuperscriptBox["10", "6"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a_ {12} = 0.902645\\times 10^6 ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37a670c8-97a1-4def-b903-d682db61c27b"],
 " . Po 70-os turime beveik tiksli\:0105 vert\:0119 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], "12"], "\[LongEqual]", "-1.64146"}], 
       TraditionalForm], "errors" -> {}, "input" -> "a_ {12} = -1.64146", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a6dcf81-d51b-40b3-9d05-22ad5dd7d2d2"],
 ". Kada reik sustoti neai\[SHacek]ku. "
}], "Text",
