             RowBox[{"(", 
               RowBox[{
                 StyleBox["x", "TI"], "-", 
                 SubscriptBox["\[Lambda]", 
                  StyleBox["i", "TI"]]}], ")"}]]}], ")"}], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           SubscriptBox[
            StyleBox["h", "TI"], "1"], "(", 
           StyleBox["x", "TI"], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], "-", 
