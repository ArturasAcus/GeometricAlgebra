Cell["\<\
Faddeev LieVerrier Souriau algoritmo realizavimas (neai\[SHacek]kinama)\
\>", "Text",
 CellChangeTimes->{{3.945150574559298*^9, 3.945150649209783*^9}, 
   3.945507174807333*^9},ExpressionUUID->"4b603a02-9ea9-46f8-a458-\
c35f1ee1a9bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaFaddeevLieVerrierSouriauCoefficients", "[", 
   RowBox[{"expr_", ",", "n_Integer"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"count", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"Last", "/@", 
        RowBox[{"NestList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subtract", "@@", "##"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", "x", "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "/", 
                    RowBox[{"(", 
                    RowBox[{"count", "+=", "1"}], ")"}]}], ")"}], "*", 
                  RowBox[{"gaGetMV", "[", 
                   RowBox[{"x", ",", 
                    RowBox[{"{", "0", "}"}]}], "]"}]}]}], "}"}]}], "]"}], "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{"expr", "\[GeometricProduct]", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "]"}], "&"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", "n"}], "]"}]}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"Not", "[", 
    RowBox[{"MatrixQ", "[", "expr", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{
  3.9448995812573223`*^9, {3.944901823278618*^9, 3.944901828060754*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"b9c9b63c-1a55-48d7-846c-98bfbfc50ad5"],

