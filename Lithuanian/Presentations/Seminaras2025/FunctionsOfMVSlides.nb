 " , kur ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["J", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{
            SuperscriptBox["2", 
             StyleBox["n", "TI"]], "-", "1"}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["J", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["J", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}=\\sum_{J=0}^{2^n-1}a_J\\e{J}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61b14e00-32ab-454c-8fbc-32a1d85e716e"],
