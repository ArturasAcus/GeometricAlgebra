          StyleBox["A", "TI"], 
          StyleBox["d", "TI"]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", "0", ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "+", 
