          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["r", "TI"]]]], "\[LongEqual]", 
        FractionBox[
         RowBox[{
           SubscriptBox[
            StyleBox["h", "TI"], "1"], 
           RowBox[{"(", 
             StyleBox["x", "TI"], ")"}], 
           SubscriptBox["\[Psi]", "1"], 
