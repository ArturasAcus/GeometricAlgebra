  3.945507641367832*^9}},ExpressionUUID->"4f8dc150-26f1-409c-bb81-\
efd6a5556db5"],

Cell[TextData[{
 "\[CapitalCHacek]ia ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["s", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"]], "-", "1"}], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["s", "TI"]], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], "-", 
              SubscriptBox["\[Lambda]", 
               StyleBox["i", "TI"]]}], ")"}], 
          StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "h_i(x)=\\sum_{s=0}^{m_i-1} a_s (x-\\lambda_i)^s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "626645ea-2a10-4b0d-a178-7b25bad29229"],
 "  ir   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Product]", 
          RowBox[{
            StyleBox["j", "TI"], "\[NotEqual]", 
            StyleBox["i", "TI"]}], 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], "-", 
              SubscriptBox["\[Lambda]", 
               StyleBox["j", "TI"]]}], ")"}], 
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["j", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\psi_i(x)=\\prod_{j\\neq i}^r(x-\\lambda_j)^{m_j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c7401ff-366a-4cf2-af4b-223c582df5ae"],
 ".  K\:0105 padar\:0117me: suskaid\:0117me \:012f narius, kurie turi \
\[SHacek]akn\:012f ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Lambda]", "i"], TraditionalForm]],ExpressionUUID->
  "892d6806-d27d-4f55-a478-49e4cb07f86f"],
 ", ir kurie neturi. B\:016btent narys ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "h_i(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84bcd3c8-b3a8-45bc-ad83-75f94f6528c0"],
 " turi \[SHacek]akn\:012f ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84b21765-a211-43fe-a596-d665adaf5845"],
 " , o ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          StyleBox["i", "TI"]], "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi_i(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b642c959-5432-4bd8-8834-12c3c5da214a"],
 " neturi. Palygin\:0119 su pradine i\[SHacek]rai\[SHacek]ka matome, kad ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         SubscriptBox["\[Psi]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], "1"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         SubscriptBox["\[Psi]", "1"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "+", "\[CenterEllipsis]", "+", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         SubscriptBox["\[Psi]", 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{i=1}^r h_i(x)\\psi_i(x)= h_1(x)\\psi_1(x)+\\cdots + \
h_r(x)\\psi_r(x)=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52693c71-c3c4-460b-8932-890b414b4a6e"],
 ".  Tod\:0117l galime apibr\:0117\[ZHacek]ti polinomus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["h", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], 
         SubscriptBox["\[Psi]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_i(t)= h_i(t)\\psi_i(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "88411cf3-4401-4234-900e-0fcbba5e8c95"],
 ", kurie turi labai \:012fdomi\:0105 savyb\:0119:  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sum_{i=1}^r p_i=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8c93f02-7d21-4bb7-935c-c12273d324e7"],
 ".  Labai svarbu:  Kadangi ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Psi]", 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}], 
         SubscriptBox["\[Psi]", 
          StyleBox["j", "TI"]], 
         RowBox[{"(", 
           StyleBox["t", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\psi_i(t)\\psi_j(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b069862-f262-4bc2-a01a-9dc92698709f"],
 " dalinasi i\[SHacek]   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6266f435-0b7a-4d62-9f68-3439bd8f1ce3"],
 " (dalyba yra moduliu!, kas labai komplikuoja skai\[CHacek]iavim\:0105) \
turime savyb\:0119 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_i p_j=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a13ce833-07fa-4969-a429-5dba16c0160c"],
 ".  Taigi,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["p", "TI"], "1"], "+", "\[CenterEllipsis]", "+", 
             SubscriptBox[
              StyleBox["p", "TI"], 
              StyleBox["r", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1 ", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p_i^2=(p_1+\\cdots +p_r)p_i=1\\, p_i=p_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c917a539-2085-41a2-8db3-b89cc25ea5f8"],
 ". Sakoma, kad  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "p_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c220f33-44db-469a-891c-e01e61e53c12"],
 "  sudaro tarpusavyje anihiliuojan\[CHacek]i\:0105 idempotent\:0173 (ne \
impotent\:0173!) sistem\:0105 ir tuo pa\[CHacek]iu realizuoja vieneto skaidin\
\:012f.  "
}], "Text",
 CellChangeTimes->{{3.945233358076523*^9, 3.945233834665353*^9}, {
  3.945240877292574*^9, 3.9452410673423653`*^9}, {3.945241195941731*^9, 
  3.945241845020609*^9}, {3.945242635665237*^9, 3.945242659284822*^9}, {
  3.9455075866334677`*^9, 
  3.945507654587356*^9}},ExpressionUUID->"d01ed4ee-9170-4729-97fe-\
145d17927b0b"],

Cell[TextData[{
 "Kitas \[ZHacek]ingsnis. Kiekvienai pasikartojan\[CHacek]iai bent 2 kartus \
\[SHacek]akniai ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "\[LessEqual]", 
         StyleBox["i", "TI"], "\[LessEqual]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1\\le i\\le r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f735bfec-211d-4358-ada9-0840a3822af6"],
 " konstruosime polinomus ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], "-", 
             SubscriptBox["\[Lambda]", 
              StyleBox["i", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> "q_i=(x-\\lambda_i)p_i.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b4193af-cfbb-4555-880c-218f86b0e7fb"],
 "  (V\:0117l dalyba moduliu). Jei \[SHacek]aknis tik viena,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m_i=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "464f1f7e-98d5-437b-8181-a1c976916e51"],
 ", tai  nesunku matyti, kad  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "q_i=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57755af9-67cf-4e0b-8c3a-47612221527c"],
 " (nes vardiklis nenulis). \n\nKai kartotinumas  didesnis  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], ">", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "m_i>1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bbf4c4ec-3dc9-46f8-bd24-7fb280fac899"],
 ",  turime ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"], 
          RowBox[{
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"]], "-", "1"}]], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "q_i^{m_i-1}\\neq 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e082780-e4f2-4719-a71c-65f2a20fe827"],
 ", bet  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"], 
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["i", "TI"]]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "q_i^{m_i}= 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "04f4d9b5-bb85-455a-bfda-f07932f08e41"],
 ".  Rinkinys  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["q", "TI"], "2"], ",", "\[CenterEllipsis]", ",", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "q_1, q_2,\\cdots,q_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5335ab57-0aad-4842-8e99-f89b3ee3fa20"],
 "  yra nilponetai, kuri\:0173 \[OpenCurlyDoubleQuote]nilponenti\[SHacek]kumo \
indeksai\[CloseCurlyDoubleQuote] yra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["m", "TI"], "2"], ",", "\[CenterEllipsis]", ",", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m_1,m_2,\\cdots,m_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "932d6976-8c71-4aca-81da-edf183967cbe"],
 ". Kai ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[NotEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i\\neq j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47ba59de-99df-47fe-8d35-ed194eb1960c"],
 ",  turime savyb\:0119 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_j q_i=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bbb285be-548c-4100-9bd8-c948e75f7019"],
 ". Tod\:0117l ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["p", "TI"], "1"], "+", "\[CenterEllipsis]", "+", 
             SubscriptBox[
              StyleBox["p", "TI"], 
              StyleBox["r", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["i", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "p_iq_i=(p_1+\\cdots +p_r)q_i=1q_i=q_i,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "643be373-97e4-42f2-8278-c99bac042e77"],
 "  ir sakoma, kad nilpotentai ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["q", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["q", "TI"], "2"], ",", "\[CenterEllipsis]", ",", 
         SubscriptBox[
          StyleBox["q", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "q_1, q_2,\\cdots,q_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8af47c4-c9cd-4578-83ea-710474f42e6d"],
 "  yra projektyviai susieti su idempotais ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["p", "TI"], "2"], ",", "\[CenterEllipsis]", ",", 
         SubscriptBox[
          StyleBox["p", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p_1, p_2,\\cdots,p_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f40ff5e5-4c52-406c-9ec9-11a1552f130a"],
 " .  K\:0105 padar\:0117me: sukonstravome apibendrint\:0105 spektrin\:0119 \
baz\:0119 (kurioje begalin\:0117s sumos nutr\:016bksta): \n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             UnderscriptBox[
              UnderscriptBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["p", "TI"], "1"], ",", 
                 SubscriptBox[
                  StyleBox["q", "TI"], "1"], ",", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], "1", "2"], "\[CenterEllipsis]", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], "1", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["m", "TI"], "1"], "-", "1"}]]}], "\[UnderBrace]",
                LimitsPositioning -> False], 
              SubscriptBox[
               StyleBox["m", "TI"], "1"], LimitsPositioning -> False], 
             "\[CenterEllipsis]", 
             UnderscriptBox[
              UnderscriptBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["p", "TI"], 
                  StyleBox["i", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["i", "TI"]], ",", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["i", "TI"], "2"], "\[CenterEllipsis]", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["i", "TI"], 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["i", "TI"]], "-", "1"}]]}], "\[UnderBrace]", 
               LimitsPositioning -> False], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["i", "TI"]], LimitsPositioning -> False], ",", 
             "\[CenterEllipsis]", 
             UnderscriptBox[
              UnderscriptBox[
               RowBox[{
                 SubscriptBox[
                  StyleBox["p", "TI"], 
                  StyleBox["r", "TI"]], ",", 
                 SubscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["r", "TI"]], ",", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["r", "TI"], "2"], "\[CenterEllipsis]", 
                 SubsuperscriptBox[
                  StyleBox["q", "TI"], 
                  StyleBox["r", "TI"], 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["m", "TI"], 
                    StyleBox["r", "TI"]], "-", "1"}]]}], "\[UnderBrace]", 
               LimitsPositioning -> False], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["r", "TI"]], LimitsPositioning -> False]}], "}"}], 
         "."}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bigl\\{\n  \\underbrace{p_1,q_1,q_1^{2}\\cdots q_1^{m_1-1}}_{m_1}  \
\\cdots \\underbrace{p_i,q_i,q_i^{2}\\cdots q_i^{m_i-1}}_{m_i},\\cdots\n  \
\\underbrace{p_r,q_r,q_r^{2}\\cdots q_r^{m_r-1}}_{m_r}\n\\bigr\\}.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c008a72b-051e-4b12-99d7-f526fce03ec1"],
 "\n\nKai \[SHacek]aknis nesikartoja, turime tik  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "p_i", "state" -> "Boxes"|>,
