   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["d", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["k", "TI"]], 
