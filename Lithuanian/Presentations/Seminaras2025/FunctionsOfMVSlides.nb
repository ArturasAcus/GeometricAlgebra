12cf5035d662"],

Cell[TextData[{
 "\nPradedam nuo minimalaus polinimo, tarkim, kad jis jau faktorizuotas   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Product]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["x", "TI"], "-", 
              SubscriptBox["\[Lambda]", 
               StyleBox["i", "TI"]]}], ")"}], 
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["i", "TI"]]], " ", "."}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mu(x) =\\prod_{i=1}^r(x-\\lambda_i)^{m_i}\\,.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "443ac84a-a294-424d-a198-49002a1a1698"],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07b30cfd-7c17-4516-b054-c1acd124e481"],
 " \[ZHacek]ymi skirting\:0173 \[SHacek]akn\:0173 skai\[CHacek]iu. \
\[CapitalSHacek]aknis  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Lambda]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda_i ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e8443ef-b56f-4037-aa36-2c58346a35dd"],
 " kartojasi ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "m_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7957a3a3-4fea-4ee5-b83c-d17b6950602d"],
 " kart\:0173 (root multiplicity). Minimalaus daugianario ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39bab073-7254-4fa8-b154-f527d8cb201b"],
 " laipsnis yra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], "\[LessEqual]", 
         SuperscriptBox["2", 
          RowBox[{"\[LeftCeiling]", 
            FractionBox[
             StyleBox["n", "TI"], "2"], "\[RightCeiling]"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{i=1}^r m_i \\le 2^{\\lceil\\tfrac{n}{2}\\rceil}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "764210b8-e06c-4593-9682-1c6b15a33fe7"],
 ". \[CapitalSHacek]aknis rikiuojam did\:0117jan\[CHacek]io pasikartojamumo \
tvarka: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "\[LessEqual]", 
         SubscriptBox[
          StyleBox["m", "TI"], "1"], "\[LessEqual]", 
         SubscriptBox[
          StyleBox["m", "TI"], "2"], "\[LessEqual]", "\[CenterEllipsis]", 
         "\[LessEqual]", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1\\le m_1\\le m_2\\le\\cdots\\le m_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f606585d-6752-48ab-8759-04f3df335e8e"],
 ".  \nApibendrintos spektrin\:0117s baz\:0117s konstrukcija pradedama nuo ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "\[Mu]", 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/\\mu(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09e584d8-9fe0-4c31-9137-660c62d3e0d7"],
 " i\[SHacek]skaidymo dalin\:0117mis trupmenomis. Techni\[SHacek]kai tai toli \
gra\[ZHacek]u n\:0117ra paprasta, nes reikia mok\:0117ti dalinti polinomus. \
Kai turime reikal\:0173 us neredukuotiniais d>4 laipsnio polinomais, tai gali \
b\:016bt labai sud\:0117tinga u\[ZHacek]duotis. "
}], "Text",
 CellChangeTimes->{{3.945233358076523*^9, 3.945233834665353*^9}, {
  3.945240877292574*^9, 3.9452410673423653`*^9}, {3.945241195941731*^9, 
