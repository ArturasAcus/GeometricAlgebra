Cell[CellGroupData[{

Cell["Minimalus(is) polinomas (daugianaris)", "Section",
 CellChangeTimes->{{3.942977496884791*^9, 3.942977513662072*^9}, {
  3.943608548485271*^9, 
  3.9436085569697247`*^9}},ExpressionUUID->"0fe708d7-6ef8-4542-95ac-\
09d1067836e5"],

Cell["\<\
Pagrindin\:012f vaidmen\:012f matric\:0173 teorijoje vaidina ne \
charakteristinis, o minimalusis polinomas. Esm\:0117 ta, kad \
da\[ZHacek]niausiai mums norisi \[ZHacek]inoti ne apribojim\:0105 kiek \
maksimaliai, tarkim 3D erdv\:0117je gali b\:016bti nepriklausom\:0173 vektori\
\:0173 (nes atsakymas trivialus), o ar, pavyzd\[ZHacek]iui 3 atsitiktinai u\
\[ZHacek]ra\[SHacek]yti vektoriai 3D erdv\:0117je yra tiesi\[SHacek]kai \
neprikausomi. To charakteristinis polinomas pasakyti negali, ta\[CHacek]iau \
gali minimalusis polinomas. Jis ir skai\[CHacek]iuojamas tokiu b\:016bdu, kad \
atsakyt\:0173 \:012f \[SHacek]\:012f klausim\:0105. Formul\:0117s negalima u\
\[ZHacek]ra\[SHacek]yti, o algoritmas elementarus:\
\>", "Text",
 CellChangeTimes->{{3.9449021311288443`*^9, 3.944902175488599*^9}, {
