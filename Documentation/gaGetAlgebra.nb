Cell[BoxData[{
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{
    RowBox[{"Cl", "[", 
     RowBox[{"3", ",", "0"}], "]"}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{
