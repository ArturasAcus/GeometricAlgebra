      RowBox[{"a", ",", "c", ",", 
       RowBox[{"Times", "[", 
        RowBox[{"b1", ",", "b2"}], "]"}], ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", 
        RowBox[{"{", 
         RowBox[{"b1", ",", "b2"}], "}"}], "]"}], "]"}], "&&", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b1", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "to", " ", "in", " ", "front",
      " ", "of", " ", "other", " ", "elements", " ", "inside", " ", "right", " ",
      "contract"}], ",", " ", 
    RowBox[{
    "then", " ", "move", " ", "field", " ", "element", " ", "outside", " ", 
     "of", " ", "rigth", " ", "contract"}]}], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"RightContract", "[", 
      RowBox[{"a___", ",", "b_", ",", "c_", ",", "d___"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"RightContract", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "b", "]"}], "]"}], "&&", 
      
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"RightContract", "[", 
      RowBox[{"a_", ",", "d__"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"GeometricProduct", "[", 
      RowBox[{"a", ",", 
       RowBox[{"RightContract", "[", "d", "]"}]}], "]"}], "/;", 
     RowBox[{"gaNonCommutativeFieldElementQ", "[", "a", "]"}]}]}], ";"}], 
  " "}]}], "Input",
 Editable->False,
 Evaluatable->False,
 CellLabel->"In[352]:=",
 CellID->1036465232,ExpressionUUID->"3cd28a9c-e24d-4d7b-890d-a9e4cdcc52c3"],

Cell["\<\
Right contract of two orthonormal basis elements  is  simply grade \
comparison+geometric product. If the grade conditions is satisfied we return  \
geometric product of basis elements, else output is zero.\
\>", "Text",
 CellChangeTimes->{{3.959139219492103*^9, 3.959139265808468*^9}, {
  3.959140160637484*^9, 3.9591402616632967`*^9}, {3.959140527142654*^9, 
  3.959140541944807*^9}, {3.959140585202232*^9, 3.9591408452350388`*^9}, {
  3.9591409937735167`*^9, 3.9591410310770903`*^9}, {3.95914118934074*^9, 
  3.959141364568863*^9}, {3.959215818001975*^9, 3.9592160906403103`*^9}, {
  3.959216125691701*^9, 3.959216178543662*^9}, {3.959240253472004*^9, 
  3.959240343493401*^9}, {3.959240380992062*^9, 3.959240469532975*^9}, {
  3.960017385826062*^9, 3.96001749040718*^9}, {3.9600175383039293`*^9, 
  3.960017629630924*^9}, {3.960019540770391*^9, 3.960019546188387*^9}},
 CellID->1419704611,ExpressionUUID->"5a9dc4fe-d1fa-4e42-a5f0-eaf0cd6452f7"],

Cell["\<\
Upper and lower indices are assumed to be sorted without taking account of \
their position (imagine they form a single list). \
\>", "Text",
 CellChangeTimes->{{3.959141036180511*^9, 3.9591411742468653`*^9}, {
  3.960017507893235*^9, 3.960017521439085*^9}},
 CellID->193688083,ExpressionUUID->"707bb919-65f3-404b-89c3-2d0a37595b2b"]
}, Closed]]
}, Open  ]],

