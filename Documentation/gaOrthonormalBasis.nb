Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   TemplateBox[{
     TemplateBox[{"1"}, "mvDownUp", DisplayFunction :> (StyleBox[
        RowBox[{
          AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
        FontTracking -> "Condensed", AutoSpacing -> False]& ), 
      InterpretationFunction :> (ReleaseHold[
        RowBox[{"mvDownUp", "@@", 
          MakeExpression[{
            Take[{
              SlotSequence[1]}, 
             Length[{1}]], 
            Take[{
