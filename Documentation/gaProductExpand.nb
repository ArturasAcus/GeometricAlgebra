Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bs", "=", "\[DoubleStruckE]"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"testMVQ", "=", 
    RowBox[{"gaRandomMultivector", "[", 
     RowBox[{
      RowBox[{"Cl", "[", 
       RowBox[{"0", ",", "3"}], "]"}], ",", 
      RowBox[{"\"\<CoefficientFunction\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"gaRandomMultivector", "[", 
           RowBox[{"Cl", "[", 
            RowBox[{"0", ",", "2"}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bs", "[", 
             RowBox[{"s_mvDownUp", ",", "al_"}], "]"}], ":>", 
            RowBox[{"bs", "[", 
             RowBox[{"s", ",", "al", ",", "\"\<Quaternion\>\""}], "]"}]}], 
           "}"}]}], "&"}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
