Cell[TextData[{
 "Define noncommutative field, which is Cl",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Null]", 
        RowBox[{"0", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "{}_{0,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa5205ac-06fd-41c8-bf07-88e6b2b57540"],
 " (without \[OpenCurlyDoubleQuote]Quaternion\[CloseCurlyDoubleQuote] mark). \
Effectively this allows to implement geometric product in tensor product of \
two Clifford algebras: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["Cl", FontSlant -> "Plain"], 
          RowBox[{"0", ",", "2"}]], "\[CircleTimes]", 
         SubscriptBox[
          StyleBox["Cl", FontSlant -> "Plain"], 
          RowBox[{"3", ",", "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{Cl}_{0,2}\\otimes\\mathrm{Cl}_{3,2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc15e27c-e416-4937-93e2-d7cbc379a7a5"],
 "."
}], "Text",
