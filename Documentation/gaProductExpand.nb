    RowBox[{"gaRandomMultivector", "[", 
     RowBox[{
      RowBox[{"Cl", "[", 
       RowBox[{"0", ",", "3"}], "]"}], ",", 
      RowBox[{"\"\<CoefficientFunction\>\"", "->", 
