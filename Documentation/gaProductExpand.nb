Cell[TextData[{
 "If for field element multiplication we use \
\[OpenCurlyDoubleQuote]CommutativeProduct\[CloseCurlyDoubleQuote], we perform \
computation in  algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Cl", FontSlant -> "Plain"], 
        RowBox[{"3", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Cl}_{3,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10d61dd5-0cc1-4f56-8f5b-78ffb6afbc37"],
 " defined over complex field with two imaginary (commutative) units , i.e. \
in extended Clifford algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["K", FontSlant -> "Plain"], 
          RowBox[{"0", ",", "2"}]], "\[CircleTimes]", 
         SubscriptBox[
          StyleBox["Cl", FontSlant -> "Plain"], 
          RowBox[{"3", ",", "2"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{K}_{0,2}\\otimes\\mathrm{Cl}_{3,2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "761d1893-ff50-4188-a62c-c6879726ce0e"],
 "."
}], "Text",
 CellChangeTimes->{{3.958093462103792*^9, 3.958093561814543*^9}, {
