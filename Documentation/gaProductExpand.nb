 ButtonBox["gaProductExpand",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductExpand.nb", None},
  ButtonNote->"gaProductExpand"],
 " (alias",
 StyleBox["\[MediumSpace]", "InlineSeparator"],
 ButtonBox["gaPE",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductExpand.nb", None},
  ButtonNote->"gaPE"],
 ")  is a superfunction, which only splits expression into product pairs and \
then calls low level function ",
 ButtonBox["gaProductPairExpand",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductPairExpand.nb", None},
  ButtonNote->"gaProductPairExpand"],
 StyleBox[". Prepared for true expansion expression  can be obtained  by \
passing", "InlineSeparator"],
 " the option ",
 Cell[BoxData["\"\<InactivateProductPairExpand\>\""], "Input",ExpressionUUID->
  "bf42374e-6d56-44a4-a4db-ff532f60159b"],
 "\[Rule]True, which inactivate the low level function (the option is \
intended for investigation of expansion procedure)"
}], "Text",
