Cell["\<\
gaProductExpand is a high level function which expands products RightContract \
(\[RightContract]), LeftContract (\[LeftContract]), InnerProduct (\
\[InnerProduct]), CommutativeProduct (\[CommutativeProduct]), OuterProduct (\
\[OuterProduct]) or  GeometricProduct (\[GeometricProduct]).\
\>", "Notes",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.953651088346464*^9, 3.953651090908451*^9}, {
