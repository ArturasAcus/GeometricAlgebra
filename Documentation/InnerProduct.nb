   3.960016981299985*^9, 3.960016984172353*^9}, {3.960017184990738*^9, 
   3.960017227528331*^9}, {3.960017307200028*^9, 3.960017308995171*^9}, 
   3.960017371338216*^9, {3.960022785908155*^9, 3.960022787959848*^9}, {
   3.960022830805649*^9, 3.960022839172743*^9}},
 CellID->660196314,ExpressionUUID->"a5c277bb-4c06-42b0-b29e-f21bd0419c7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HoldPattern", "[", 
    RowBox[{"InnerProduct", "[", 
     RowBox[{"a___", ",", 
      RowBox[{"b_", "*", "c_"}], ",", "d___"}], "]"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Times", "[", 
     RowBox[{"b", ",", 
      RowBox[{"InnerProduct", "[", 
       RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "]"}], "/;", 
    RowBox[{"gaCommutativeAllQ", "[", "b", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a___", ",", "b_", ",", "c___"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Times", "[", 
      RowBox[{"b", ",", 
       RowBox[{"InnerProduct", "[", 
        RowBox[{"a", ",", "c"}], "]"}]}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaCommutativeAllQ", "[", "b", "]"}], "&&", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "c"}], "}"}], "]"}], ">", "0"}]}]}]}], " ", ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"[", 
      RowBox[{"DH", "-", 
       RowBox[{"CA2GC1", ".21", "b"}]}], "]"}], " ", "formula"}], ",", " ", 
    RowBox[{"singlet", " ", "rule"}], ",", " ", 
    RowBox[{
    "inner", " ", "product", " ", "of", " ", "multivector", " ", "and", " ", 
     "scalar", " ", "gives", " ", "0"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"InnerProduct", "[", "a_", "]"}], "]"}], ":=", "0"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2024", "-", "08", "-", 
     RowBox[{"27", " ", "attempt"}]}], ",", " ", 
    RowBox[{
    "Modification", " ", "for", " ", "noncommutative", " ", 
     "coefficients"}]}], "  ", "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "move", " ", "field", " ", "elements", " ", "outside", " ", "times", " ", 
    "in", " ", "inner", " ", "product"}], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a___", ",", 
       RowBox[{"Times", "[", 
        RowBox[{"b1___", ",", "c_", ",", "b2__"}], "]"}], ",", "d___"}], 
      "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a", ",", "c", ",", 
       RowBox[{"Times", "[", 
        RowBox[{"b1", ",", "b2"}], "]"}], ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", 
        RowBox[{"{", 
         RowBox[{"b1", ",", "b2"}], "}"}], "]"}], "]"}], "&&", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b1", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "to", " ", "in", " ", "front",
      " ", "of", " ", "other", " ", "elements", " ", "inside", " ", "inner", " ",
      "product"}], ",", " ", 
    RowBox[{
    "then", " ", "move", " ", "field", " ", "element", " ", "outside", " ", 
     "of", " ", "inner", " ", "product"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a___", ",", "b_", ",", "c_", ",", "d___"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "b", "]"}], "]"}], "&&", 
      
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"InnerProduct", "[", 
      RowBox[{"a_", ",", "d__"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"GeometricProduct", "[", 
      RowBox[{"a", ",", 
       RowBox[{"InnerProduct", "[", "d", "]"}]}], "]"}], "/;", 
     RowBox[{"gaNonCommutativeFieldElementQ", "[", "a", "]"}]}]}], ";"}], 
  " "}]}], "Input",
