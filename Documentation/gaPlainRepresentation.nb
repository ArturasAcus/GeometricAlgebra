Cell["\<\
The following orderings can be used: \[OpenCurlyDoubleQuote]Lex\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvLex\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]RevLex\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvRevLex\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]Deg[Lex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]Deg[InvLex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]Deg[RevLex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]Deg[InvRevLex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvDeg[Lex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvDeg[InvLex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvDeg[RevLex]\
\[CloseCurlyDoubleQuote]|\[CloseCurlyDoubleQuote]InvDeg[InvRevLex]\
\[CloseCurlyDoubleQuote]:\
\>", "Text",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.954859993807105*^9, 3.9548599965420427`*^9}, 
   3.958025750933001*^9, {3.958025812345962*^9, 3.9580258952951097`*^9}, {
   3.958025928175315*^9, 3.958025933218895*^9}, {3.958026098179884*^9, 
   3.958026099223936*^9}, {3.958093833134074*^9, 3.958093835693742*^9}},
 CellID->1855865433,ExpressionUUID->"cbf6cbe1-122e-4f99-979a-df43b41ad978"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"listOfDefinedOrderings", "=", 
  RowBox[{"{", 
   RowBox[{
   "\"\<Lex\>\"", ",", "\"\<InvLex\>\"", ",", "\"\<RevLex\>\"", ",", 
    "\"\<InvRevLex\>\"", ",", "\"\<Deg[Lex]\>\"", ",", "\"\<Deg[InvLex]\>\"", 
    ",", "\"\<Deg[RevLex]\>\"", ",", "\"\<Deg[InvRevLex]\>\"", ",", 
    "\"\<InvDeg[Lex]\>\"", ",", "\"\<InvDeg[InvLex]\>\"", ",", 
    "\"\<InvDeg[RevLex]\>\"", ",", "\"\<InvDeg[InvRevLex]\>\""}], 
   "}"}]}]], "Input",
 CellLabel->"In[12]:=",
