 CellTags->"TabNext",
 CellID->728537014,ExpressionUUID->"df1aa6ec-9fd5-4465-ba35-dc7ca61e886a"],

Cell[TextData[{
 "Defined orthonormal basis is saved in the containers ",
 Cell[BoxData[
  FormBox[
   RowBox[{"gaOrthonormalBasis", "[", "alg", "]"}], TraditionalForm]],
  ExpressionUUID->"df249c63-3528-4746-a72b-2d891049513f"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"alg", ",", 
     TemplateBox[{
       Cell[
        TextData["All"]], "paclet:ref/All"},
      "RefLink",
      BaseStyle->{"InlineFormula"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"172a6d16-884e-4235-a657-ced7e0c3b048"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"alg", ",", "ordering"}], "]"}], TraditionalForm]],ExpressionUUID->
  "ab6f91b6-6719-40e6-a25e-89c3d4d3cf34"],
 " and  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"alg", ",", "ordering", ",", 
     TemplateBox[{
       Cell[
        TextData["All"]], "paclet:ref/All"},
      "RefLink",
      BaseStyle->{"InlineFormula"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"c6ef9132-b41b-42cb-8c48-29cb2e74593c"],
 ". If user defined only partial basis, ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["All"]], "paclet:ref/All"},
   "RefLink",
   BaseStyle->{"InlineFormula"}]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "59cdae9f-8dbe-45f9-a03f-169d2998c6bf"],
 " have to be replaced by list of defined grades."
}], "Notes",
 Editable->True,
 TaggingRules->{},
