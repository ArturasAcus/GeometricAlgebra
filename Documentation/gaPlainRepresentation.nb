Cell[TextData[{
 Cell[BoxData["alg"], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "596ce52a-3392-4c71-a139-ba18a44fa5dd"],
 " must be specified as Cl[p,q],where p, q  are nonnegative integers or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"TensorProduct", "[", 
    RowBox[{
     RowBox[{"Cl", "[", " ", 
      RowBox[{
       SubscriptBox["p", "1"], ",", 
       SubscriptBox["q", "1"]}], "]"}], ",", 
     RowBox[{"Cl", "[", " ", 
      RowBox[{
       SubscriptBox["p", "2"], ",", 
       SubscriptBox["q", "2"]}], "]"}], ",", "\[Ellipsis]"}], "]"}], 
   TraditionalForm]],ExpressionUUID->"14be64a9-fba5-4a0c-85b9-18d820f5efee"],
 ", where ",
 Cell[BoxData[
  RowBox[{"Cl", "[", 
   RowBox[{
    SubscriptBox["p", "i"], ",", 
    SubscriptBox["q", "i"]}]}]],ExpressionUUID->
  "94e395d6-a545-4d37-b6ad-24b3f14489fc"],
 "] are elements from the list  {",
 Cell[BoxData[
  RowBox[{"Cl", "[", 
   RowBox[{"2", ",", "0"}]}]],ExpressionUUID->
  "ca57425e-aae5-4121-9e5e-dccd0587615a"],
 "],",
 Cell[BoxData[
  RowBox[{"Cl", "[", 
   RowBox[{"1", ",", "1"}]}]],ExpressionUUID->
  "0b43b849-7ed9-493b-a63d-ecea3403bd13"],
 "],",
 Cell[BoxData[
  RowBox[{"Cl", "[", 
   RowBox[{"0", ",", "2"}]}]],ExpressionUUID->
  "e4542e7d-68e6-40c9-a858-085e81ddde59"],
 "]}. Tensor product of other algebras is not supported. "
}], "Notes",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.953651088346464*^9, 3.953651090908451*^9}, {
   3.9536511807070236`*^9, 3.9536511818587666`*^9}, 3.954599875673976*^9, {
   3.95802243277992*^9, 3.958022680941246*^9}, {3.9580229436892033`*^9, 
