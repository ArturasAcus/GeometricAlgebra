   3.958026800980402*^9}},
 CellID->454315950,ExpressionUUID->"b7437e90-4853-440c-baed-9b1c88656c26"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\[OpenCurlyDoubleQuote]DefineInput\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]MakeAlias\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]gaDefineField\[CloseCurlyDoubleQuote] and FontColor", \
"Subsubsection",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.9533638996263866`*^9, 3.953363905248267*^9}, {
