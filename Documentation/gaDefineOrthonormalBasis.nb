Cell[TextData[{
 "Possible pure orderings are  \[CloseCurlyDoubleQuote]Lex\
\[CloseCurlyDoubleQuote], \[CloseCurlyDoubleQuote]InvLex\
\[CloseCurlyDoubleQuote], \[CloseCurlyDoubleQuote]RevLex\
\[CloseCurlyDoubleQuote], \[CloseCurlyDoubleQuote]InvRevLex\
\[CloseCurlyDoubleQuote]. The pure orderings can be proceeded with \
\[CloseCurlyDoubleQuote]Deg[]\[CloseCurlyDoubleQuote], and \
\[CloseCurlyDoubleQuote]InvDeg[]\[CloseCurlyDoubleQuote] modifiers, totally \
giving 4",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Cross]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\times", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "292313d0-5edb-43b8-9489-23ee6d474e2c"],
 "3 possible orderings. Orderings \[CloseCurlyDoubleQuote]RevLex\
\[CloseCurlyDoubleQuote], \[CloseCurlyDoubleQuote]InvRevLex\
\[CloseCurlyDoubleQuote] and the default ordering \
\[CloseCurlyDoubleQuote]InvDeg[Lex]\[CloseCurlyDoubleQuote] are not \
admissible  as monomial orderings for Grobner basis."
}], "Text",
 CellChangeTimes->{{3.958094877992853*^9, 3.958095065896426*^9}},
 CellID->414573103,ExpressionUUID->"fd8efc21-1282-476e-8f06-49b1debffa67"],

Cell["Sort basis according to each ordering and make a nice table", "Text",
 CellChangeTimes->{3.9580948828349752`*^9},
 CellID->917601301,ExpressionUUID->"e5749ae3-6d9d-4fdd-a888-de4465a20215"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"orderedTableOfBasis", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"gaSort", "[", 
      RowBox[{
       RowBox[{"gaOrthonormalBasis", "[", 
        RowBox[{
         RowBox[{"Cl", "[", 
          RowBox[{"4", ",", "0"}], "]"}], ",", "\"\<InvDeg[Lex]\>\"", ",", 
         "All"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
    "listOfDefinedOrderings"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{"orderedTableOfBasis", ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"listOfDefinedOrderings", ",", "None"}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9580261206728983`*^9, 3.958026175487166*^9}},
 CellLabel->"In[14]:=",
