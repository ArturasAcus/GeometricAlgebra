    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a___", ",", 
        RowBox[{"b_", "*", "c_"}], ",", "d___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"b", " ", "*", 
       RowBox[{"GeometricProduct", "[", 
        RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "/;", 
      RowBox[{"gaCommutativeAllQ", "[", "b", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a___", ",", "b_", ",", "c___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"b", "*", " ", 
       RowBox[{"GeometricProduct", "[", 
        RowBox[{"a", ",", "c"}], "]"}]}], "/;", 
      RowBox[{"gaCommutativeAllQ", "[", "b", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"GeometricProduct", "[", "a_", "]"}], "]"}], ":=", "a"}], ";"}],
    " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "singlet", " ", "rule", " ", "applies", " ", "after", " ", "moving", " ", 
     "scalar", " ", "from", " ", "GeometricProduct"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GeometricProduct", "[", "]"}], ":=", "1"}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"when", " ", "e_", "1", "*", "e_", "1"}], " ", "->", 
     RowBox[{"1", " ", "we", " ", "are", " ", "left", " ", "empty"}]}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"2024", "-", "08", "-", 
      RowBox[{"27", " ", "attempt"}]}], ",", " ", 
     RowBox[{
     "Modification", " ", "for", " ", "noncommutative", " ", 
      "coefficients"}]}], "  ", "*)"}], " ", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "outside", " ", "times", " ", 
     "in", " ", "geometric", " ", "product"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a___", ",", 
        RowBox[{"Times", "[", 
         RowBox[{"b1___", ",", "c_", ",", "b2__"}], "]"}], ",", "d___"}], 
       "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a", ",", "c", ",", 
        RowBox[{"Times", "[", 
         RowBox[{"b1", ",", "b2"}], "]"}], ",", "d"}], "]"}], "/;", 
      RowBox[{
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
       RowBox[{"Not", "[", 
        RowBox[{"gaNonCommutativeFieldElementQ", "[", 
         RowBox[{"{", 
          RowBox[{"b1", ",", "b2"}], "}"}], "]"}], "]"}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "b1", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "to", " ", "in", " ", "front",
      " ", "of", " ", "other", " ", "elements", " ", "inside", " ", 
     "geometric", " ", "product"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a___", ",", "b_", ",", "c_", ",", "d___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "/;", 
      RowBox[{
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
       RowBox[{"Not", "[", 
        RowBox[{"gaNonCommutativeFieldElementQ", "[", "b", "]"}], "]"}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "b", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
   " "}]}]], "Input",
 Editable->False,
 Evaluatable->False,
 CellChangeTimes->{{3.959140852989181*^9, 3.959140877033963*^9}},
 CellID->1527483880,ExpressionUUID->"ff96a815-ef2d-4f4f-aa10-5e700b98b10d"],

Cell[TextData[{
 "Multiplication of orthonormal basis elements  is implemented using ",
 Cell[BoxData["mvProductSignatureMapC"], "Input",
  CellGroupingRules->{GroupTogetherGrouping, 10000.},ExpressionUUID->
  "bfc558d2-6537-4547-ad1a-5eb3199f0ceb"],
 " signature map, which is defined as ",
 StyleBox[" (-1)^(mvMuS[iI,jJ]+mvMu[pp,intesectionIJ])",
  FontWeight->"Bold"],
 ", where  ",
 StyleBox["mvMu",
  FontWeight->"Bold"],
 " and ",
 StyleBox["mvMuS",
  FontWeight->"Bold"],
 "  contribute to product sign only. ",
 StyleBox["mvMu[i_Integer,j_List]",
  FontWeight->"Bold"],
 "=",
 Cell[BoxData[
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"j", "[", 
        RowBox[{"[", "k", "]"}], "]"}], ">", "i"}], ",", 
      RowBox[{"sum", "++"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "j", "]"}]}], "}"}]}], "]"}]], "Input",
  ExpressionUUID->"4381320a-5568-4594-acad-a289c56a5b0a"],
 " counts  number of indices that are greater that ",
 StyleBox["pp",
  FontWeight->"Bold"],
 ". Since the integer is  positive signature last index, the function counts \
contribution of negative signature vectors.  The function ",
 StyleBox["mvMuS[i_List,j_List]=Do[sum=sum+mvMu[j[[k]],i],{k,Length[j]}]",
  FontWeight->"Bold"],
 ", counts total number of permutations needed to form a sorted list. The \
signature map function then is multiplied by basis element which contains set \
symmetric difference of indices: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"mvSetSymmetricDifference", "[", 
     RowBox[{"iI_List", ",", "jJ_List"}], "]"}], ":=", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"iI", ",", "jJ"}], "]"}], ",", 
      RowBox[{"Intersection", "[", 
       RowBox[{"iI", ",", "jJ"}], "]"}]}], "]"}]}], ";"}]], "Input",
  ExpressionUUID->"96eecf24-b766-49e7-b552-311c4c80f550"],
 " "
}], "Text",
 CellChangeTimes->{{3.959139219492103*^9, 3.959139265808468*^9}, {
  3.959140160637484*^9, 3.9591402616632967`*^9}, {3.959140527142654*^9, 
  3.959140541944807*^9}, {3.959140585202232*^9, 3.9591408452350388`*^9}, {
  3.9591409937735167`*^9, 3.9591410310770903`*^9}, {3.95914118934074*^9, 
  3.959141364568863*^9}, {3.959215818001975*^9, 3.9592160906403103`*^9}, {
  3.959216125691701*^9, 3.959216178543662*^9}},
 CellID->1419704611,ExpressionUUID->"4498f2bb-6b04-436e-b590-fda4315f6c92"],

Cell["\<\
Upper and lower indices are assumed to be sorted without taking account of \
their position (assumed to form a single list). \
\>", "Text",
 CellChangeTimes->{{3.959141036180511*^9, 3.9591411742468653`*^9}},
 CellID->193688083,ExpressionUUID->"bd4efe79-98ea-47e8-be69-cdd263c91743"]
}, Closed]]
