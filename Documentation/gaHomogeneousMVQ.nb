Cell[TextData[{
 "It is known that all homogeneous MV in algebras of vector space dimension \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LessEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n\\le 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4de0abe0-ad1e-4ee5-af15-21b9974a0d68"],
 " are blades. Therefore, to show a nontrivial action, let\[CloseCurlyQuote]s \
define orthonormal basis of Cl(4,0) algebra: "
}], "Text",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.954599430847682*^9, 3.9545994368102837`*^9}, {
