Cell["Take quite  symbolic multivector", "Text",
 CellChangeTimes->{{3.960803251099586*^9, 3.9608032705432568`*^9}, {
  3.96080339615837*^9, 3.960803414836515*^9}, {3.9608830007232437`*^9, 
