Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rrtemp", "[", "4", "]"}], "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Rule", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gaComponentCoefficientAndBasisList", "[", 
         RowBox[{"testMVS", "[", "4", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"gaComponentCoefficientAndBasisList", "[", 
         RowBox[{"testMV", "[", "4", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"toQRules", "[", 
   RowBox[{"lhs_", "->", "rhs_"}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"lhs", "-", "rhs"}], ",", 
        "gaNonCommutativeFieldElementPattern", ",", "takeMe"}], "]"}], ",", 
      "_takeMe", ",", "Infinity"}], "]"}], "/.", 
    RowBox[{
     RowBox[{"takeMe", "[", "any_", "]"}], ":>", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"Equal", "[", 
        RowBox[{"any", ",", "0"}], "]"}], ",", 
       RowBox[{"Variables", "[", "any", "]"}]}], "]"}]}]}], "]"}]}], "\n", 
 RowBox[{"numericalCoefficientRules", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"toQRules", "/@", 
    RowBox[{"rrtemp", "[", "4", "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9616424563852882`*^9, 3.9616424689942617`*^9}, {
