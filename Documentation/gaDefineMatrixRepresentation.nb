Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "4"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"reducedAlgebra", "[", 
        RowBox[{"testAlgebra", ",", "2"}], "]"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Q[1,2]\>\""}], ",", 
             
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<Symmetric\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"\"\<Pauli[1,2]\>\"", ",", "\"\<IToRealMatrix\>\""}], 
            "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
