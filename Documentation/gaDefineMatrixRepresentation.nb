  "],
 CellID->1549180466,ExpressionUUID->"47fe3d10-5492-4b68-a047-5102c17ae676"],

Cell[TextData[{
 "We see that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "e14ab360-73c1-48e7-84cb-fecf5a77edb1"],
 " can be written as a direct product of algebras ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"0", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "81df2674-b992-4f7d-b476-d94de671ff83"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"2", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "f585dd23-c668-4c03-8446-05fcd6af6e46"],
 ". Then in order to get representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "7b701288-ae16-4182-bb3f-0446ec3b1899"],
 " we can use any combination of representations of these elementary \
algebras"
}], "Text",
