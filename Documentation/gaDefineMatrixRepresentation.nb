0.5647058823529411`]]]], RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], \
Rule[Tooltip, None]], TemplateBox[List[\\\"0\\\", \\\"2\\\", \\\"0\\\"], \
\\\"Cl\\\", Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[0.`, 0.`, 1.`]]]], RowBox[List[Slot[1], \\\",\\\
\", Slot[2]]]]]], Rule[Tooltip, None]]], \\\"gaTensorProduct\\\", \
RuleDelayed[DisplayFunction, Function[RowBox[List[Slot[1], \
