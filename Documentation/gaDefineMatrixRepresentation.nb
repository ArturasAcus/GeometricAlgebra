Cell[CellGroupData[{

Cell[TextData[{
 "Matrix representations of Clifford algebras ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"p", ",", "q"}]], TraditionalForm]],ExpressionUUID->
  "d4f4da3f-2c35-4bdd-8036-0d4355ddbc5f"],
 ", p+q>2 && p,q\[LessEqual]7"
}], "Subsection",
 CellChangeTimes->{{3.673769332785334*^9, 3.673769392504071*^9}, {
  3.67376947173848*^9, 3.673769497846831*^9}, {3.673769548025817*^9, 
  3.673769569312313*^9}, {3.673857865702308*^9, 3.673857886324916*^9}, {
