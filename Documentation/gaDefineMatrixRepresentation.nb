Cell[TextData[{
 "We are warned that factorized algebra Cl[2,1]->Cl[1,0]\[CircleTimes]Cl[1,2] \
contains Cl[1,0] algebra. In these cases we can reduce dimension of \
representation if complex matrices are allowed.  To find smaller \
representations of initial algebra Cl[2,1]  instead we use Cl[1,2] algebra \
(option ",
 StyleBox["BaseVectorAlgebra\[Rule]\[NoBreak]Cl[1,2,0]",
  FontWeight->"Bold"],
 "\[NoBreak]) and multiply all obtained base vectors representations by \
imaginary unit. This will give representation of original Cl[2,1]. Indeed"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
   3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
   3.673770874134313*^9}, {3.673847424440953*^9, 3.673847454297884*^9}, {
   3.67384748908961*^9, 3.673847491281632*^9}, {3.67385142912274*^9, 
   3.673851598056488*^9}, {3.673853198231991*^9, 3.673853276480684*^9}, {
   3.673853330115768*^9, 3.673853357100738*^9}, {3.673853613532576*^9, 
   3.673853650616628*^9}, {3.673932571048672*^9, 3.673932870007566*^9}, {
   3.673933020665118*^9, 3.673933121360579*^9}, {3.673954643605199*^9, 
   3.673954896081281*^9}, {3.673955211748288*^9, 3.673955219561568*^9}, {
   3.673956177662593*^9, 3.673956281675917*^9}, {3.682140829308854*^9, 
   3.682140884910186*^9}, {3.682141147084053*^9, 3.682141148133281*^9}, {
   3.682325213372634*^9, 3.682325325811146*^9}, {3.682325558727341*^9, 
   3.682325560499444*^9}, {3.682325721201125*^9, 3.682325741421896*^9}, 
   3.682325778151936*^9, {3.682394391213267*^9, 3.682394451550122*^9}, {
   3.682394543814809*^9, 3.682394798233298*^9}, 3.7788250470880737`*^9},
 CellID->886892585,ExpressionUUID->"36769464-2d28-4e0b-afad-826ce6975a7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Complex\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], 
              "\[Rule]", "\"\<Antisymmetric\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<BaseVectorAlgebra\>\"", "\[Rule]", "\[NoBreak]", 
           RowBox[{"Cl", "[", 
            RowBox[{"1", ",", "2", ",", "0"}], "]"}]}], "\[NoBreak]", ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
