Cell[TextData[{
 "Nice property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         SubscriptBox["\[DoubleStruckE]", "i"], "2"]}], 
       SuperscriptBox[
        SubscriptBox["x", "i"], "2"]}], ")"}], 
     RowBox[{"n", "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "c6c62fd2-08fb-406c-a42f-0d61973d8b50"],
 " =det (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    RowBox[{
     SubscriptBox["\[DoubleStruckE]", "i"], 
     SubscriptBox["x", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "7edad859-056c-4cb7-8434-855618129337"],
 ") of Clifford algebra vectors ant their representation matrix determinants \
(see Cl[0,3] -> \[DoubleStruckCapitalH]\[CirclePlus]\[DoubleStruckCapitalH] \
subsection for more detailed explanation)"
}], "Text",
