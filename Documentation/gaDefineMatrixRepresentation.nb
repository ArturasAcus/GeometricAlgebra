Cell[TextData[{
 "The smaller matrices generates not universal Clifford algebra, i.e. \
algebra, which has less that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["2", "n"], TraditionalForm]],ExpressionUUID->
  "c6da1440-6c2d-4abf-8a8c-40b3fc28ed6c"],
 " base elements. See below"
}], "Text",
