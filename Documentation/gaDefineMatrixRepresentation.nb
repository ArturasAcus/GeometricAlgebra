Cell[BoxData[{
 RowBox[{
  RowBox[{"conjugateExplicit", "[", "expr_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"expr", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Complex", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
      RowBox[{"Complex", "[", 
       RowBox[{"x", ",", 
        RowBox[{"-", "y"}]}], "]"}]}], "}"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conjugateHermiteConjugate", "[", 
   RowBox[{"expr_", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Transpose", "[", "expr", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Complex", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
      RowBox[{"Complex", "[", 
       RowBox[{"x", ",", 
        RowBox[{"-", "y"}]}], "]"}]}], "}"}]}], ")"}]}]}], "Input",
 CellChangeTimes->{
  3.677574547246463*^9, {3.682406307818047*^9, 3.682406332724255*^9}},
 CellLabel->"In[62]:=",
 CellID->2064815654,ExpressionUUID->"e835cfda-44e8-46ea-886d-9f5d4e1b2ff5"],

