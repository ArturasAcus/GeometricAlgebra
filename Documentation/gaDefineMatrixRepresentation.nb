Cell[TextData[{
 "Usage of isomorphism rules \[OpenCurlyDoubleQuote]IToRealMatrix\
\[CloseCurlyDoubleQuote] is ",
 StyleBox["strongly",
  FontColor->RGBColor[1, 0, 0]],
 " unrecommended. It might give false and unexpected results. Use on you own \
risk and always check. "
}], "Text",
 CellChangeTimes->{{3.722668600071466*^9, 3.722668688006146*^9}, {
  3.722669319767189*^9, 3.722669347692465*^9}, {3.8629754132040653`*^9, 
