Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"mrep1", "=", 
    RowBox[{"gaDefineMatrixRepresentation", "[", 
     RowBox[{"testAlgebra", ",", " ", 
      RowBox[{"Method", " ", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<TensorProduct\>\"", ",", 
         RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"Cl", "[", 
              RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Pauli[1,2]\>\""}], ",", 
            RowBox[{
             RowBox[{"Cl", "[", 
              RowBox[{"2", ",", "0"}], "]"}], "\[Rule]", 
             " ", "\"\<IPauli[1,2]\>\""}], ",", 
            RowBox[{
             RowBox[{"Cl", "[", 
              RowBox[{"1", ",", "1"}], "]"}], 
             "\[Rule]", "\"\<Antisymmetric\>\""}], ",", 
            RowBox[{
             RowBox[{"Cl", "[", 
              RowBox[{"0", ",", "1"}], "]"}], 
             "\[Rule]", "\"\<Complex\>\""}]}], "}"}]}], ",", 
