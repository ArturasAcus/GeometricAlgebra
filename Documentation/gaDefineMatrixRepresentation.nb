Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], 
              "\[Rule]", "\"\<Antisymmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<IPauli[2,3]\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<ReductionOrder\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"\"\<MatrixOuterProductOrder\>\"", "->", "Reverse"}], ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "->", "Reals"}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsMultipliers\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsReordering\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
