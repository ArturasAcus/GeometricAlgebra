Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"gaDefineMatrixRepresentation", "[", 
    RowBox[{"testAlgebra", ",", " ", 
     RowBox[{"Method", " ", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<TensorProduct\>\"", ",", 
        RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Pauli[1,2]\>\""}], ",", 
