Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "cliffordVectorsDeterminant", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"onlyClifford", "\[Rule]", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cliffordVectorsDeterminant", "[", 
   RowBox[{"vec_List", ",", 
    RowBox[{"algebra", ":", 
     RowBox[{"(", 
      RowBox[{"_Cl", "|", "_gaTensorProduct"}], ")"}]}], ",", 
    RowBox[{"onlyDifference", ":", 
     RowBox[{"(", 
      RowBox[{"True", "|", "False"}], ")"}]}], ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cliffordNoMatrixRezult", ",", "matrixDetRezult", ",", " ", 
       RowBox[{"ortBase", "=", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"algebra", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ",", 
       RowBox[{"theOp", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"onlyClifford", "/.", 
           RowBox[{"{", "opts", "}"}]}], ")"}], "/.", 
         RowBox[{"Options", "[", "cliffordVectorsDeterminant", "]"}]}]}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "ortBase", "]"}], "===", "gaOrthonormalBasis"}],
         ",", " ", 
        RowBox[{"ortBase", "=", 
         RowBox[{"gaDefineOrthonormalBasis", "[", 
          RowBox[{"algebra", ",", 
           RowBox[{"\"\<Grades\>\"", "\[Rule]", 
            RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], "]"}], ";", 
      RowBox[{"cliffordNoMatrixRezult", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"GeometricProduct", "[", 
              RowBox[{"#", ",", "#"}], "]"}]}], "&"}], "/@", "ortBase"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[FormalX]", "[", "#", "]"}], "^", "2"}], "&"}], "/@", 
            
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "vec", "]"}], "]"}]}], ")"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", "2"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "[", "theOp", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"matrixDetRezult", "=", 
          RowBox[{"gaDeterminantOfMV", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{"Plus", "@@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"vec", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "*", 
                RowBox[{"\[FormalX]", "[", "i", "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "vec", "]"}]}], "}"}]}], "]"}]}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"onlyDifference", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"cliffordNoMatrixRezult", "-", "matrixDetRezult"}], 
             ")"}], "//", "Expand"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cliffordNoMatrixRezult", "//", "Factor"}], ",", 
             RowBox[{"matrixDetRezult", "//", "Factor"}]}], "}"}]}], "]"}]}], 
        ",", "\[IndentingNewLine]", "cliffordNoMatrixRezult"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", "vec", "]"}], ">", "0"}]}]}]}], "Input",
 CellChangeTimes->{{3.682147828152545*^9, 3.682147907140343*^9}, {
