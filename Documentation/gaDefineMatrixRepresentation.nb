Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"reducedAlgebra", "[", 
        RowBox[{"testAlgebra", ",", "2"}], "]"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Q[1,2]\>\""}], ",", 
             
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<Symmetric\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", 
           RowBox[{"{", "\"\<HH2R4\>\"", "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.77882873151787*^9, 3.7788287544209757`*^9}, 
