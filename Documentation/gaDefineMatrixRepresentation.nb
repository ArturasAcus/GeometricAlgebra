Cell[BoxData[
 TemplateBox[{
  "gaDefineMatrixRepresentation", "smaller", 
   "\"Tensor product decomposition \
\\!\\(\\*TemplateBox[List[TemplateBox[List[\\\"1\\\", \\\"0\\\", \\\"0\\\"], \
\\\"Cl\\\", Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[1.`, 0.`, 0.`]]]], RowBox[List[Slot[1], \\\",\\\
\", Slot[2]]]]]], Rule[Tooltip, None]], TemplateBox[List[\\\"1\\\", \
\\\"1\\\", \\\"0\\\"], \\\"Cl\\\", Rule[DisplayFunction, \
Function[SubscriptBox[StyleBox[\\\"Cl\\\", List[Rule[FontColor, \
RGBColor[0.5019607843137255`, 0.`, 0.5019607843137255`]]]], \
RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], Rule[Tooltip, None]], \
TemplateBox[List[\\\"1\\\", \\\"1\\\", \\\"0\\\"], \\\"Cl\\\", \
Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[0.5019607843137255`, 0.`, \
0.5019607843137255`]]]], RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], \
Rule[Tooltip, None]]], \\\"gaTensorProduct\\\", RuleDelayed[DisplayFunction, \
Function[RowBox[List[Slot[1], StyleBox[\\\"\\\\[CircleTimes]\\\", \
Rule[FontSize, Medium], List[Rule[FontColor, RGBColor[0.0016597967080356213`, \
0.9422259959767234`, 0.836781628263602`]]]], Slot[2], \
StyleBox[\\\"\\\\[CircleTimes]\\\", Rule[FontSize, Medium], \
List[Rule[FontColor, RGBColor[0.0016597967080356213`, 0.9422259959767234`, \
0.836781628263602`]]]], Slot[3]]]]], RuleDelayed[InterpretationFunction, \
Function[RowBox[List[\\\"gaTensorProduct\\\", \\\"[\\\", Slot[1], \\\",\\\", \
Slot[2], \\\",\\\", Slot[3], \\\"]\\\"]]]], Rule[SyntaxForm, \\\"fish\\\"], \
Rule[Tooltip, None]]\\) contains Cl[1,0] algebra. Smaller (complex) \
representation matrices can be obtained using Method \
->{\\\"TensorProduct\\\",\\\"BaseVectorAlgebra\\\"\[Rule]\\!\\(\\*TemplateBox[\
List[\\\"2\\\", \\\"3\\\", \\\"0\\\"], \\\"Cl\\\", Rule[DisplayFunction, \
Function[SubscriptBox[StyleBox[\\\"Cl\\\", List[Rule[FontColor, \
RGBColor[0.3708066200170794`, 0.28244952102967`, 0.13190940924492134`]]]], \
RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], Rule[Tooltip, \
None]]\\),\\\"TargetMatrices\\\"\[Rule]Reals}. The smaller matrices realizes \
HOMOMORPHISM of the algebra (not an isomorphism).\"", 2, 211, 12, 
   32577599486613818140, "Local", 
   "GeometricAlgebra`gaDefineMatrixRepresentation"},
