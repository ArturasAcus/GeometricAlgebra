Cell[TextData[{
 "Though down and up indices looks like independent  lists, they should be \
considered as ",
 StyleBox["single",
  FontWeight->"Bold"],
 " sorted list divided into two lists for nice presentation only. Indeed \
after lowering/rising indices we have single ordered index lists, with proper \
signs, which agrees with algebra signature (2,1):"
}], "Text",
 Editable->True,
 TaggingRules->{},
