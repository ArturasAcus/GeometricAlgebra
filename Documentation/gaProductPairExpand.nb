Cell[TextData[{
 "We see that high level function ",
 ButtonBox["gaPE",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductExpand.nb", None},
  ButtonNote->"gaPE"],
 " construct pairs of multivectors and then calls gaProductPairExpand with \
two argument syntax. The second argument is contains values of  explicit \
default option (which where determined by high level function ",
 ButtonBox["gaPE",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductExpand.nb", None},
  ButtonNote->"gaPE"],
 ") . In particular ",
 Cell[BoxData["\"\<CoefficientFunction\>\""], "Input",ExpressionUUID->
  "e276ff86-795e-41af-9d2a-e111239ff0c3"],
 "\[Rule]\[CloseCurlyDoubleQuote]Automatic\[CloseCurlyDoubleQuote], Quiet\
\[Rule]True and ",
 Cell[BoxData["\"\<MaxIterations\>\""], "Input",ExpressionUUID->
  "bacb1c4e-5237-4076-b70f-c8120716a3b6"],
 "\[Rule]\[Infinity]. After activation of low level function \
gaProductPairExpand we obtain actual expansion (with coefficients at basis \
elements wrapped by auxiliary head gaSingleton, which is used to make \
symbolic multiplication faster, and whish should be removed manually)"
}], "Text",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.954599763647778*^9, 3.9545997702428703`*^9}, {
  3.9580249314074163`*^9, 3.95802496582027*^9}, {3.9580401154561653`*^9, 
  3.958040183713418*^9}, {3.960534058379361*^9, 3.960534159535844*^9}, {
  3.960534196260655*^9, 3.960534211666936*^9}, {3.9605556626601963`*^9, 
