Cell[TextData[{
 "After comparing with Hestenes ",
 ButtonBox["InnerProduct",
  BaseStyle->"Hyperlink",
  ButtonData->{"InnerProduct.nb", None},
  ButtonNote->"InnerProduct"],
 "  we see that terms with a[0] and b[0] are present in left contraction \
output, whereas they are absent in the inner product"
}], "Text",
 Editable->True,
 TaggingRules->{},
