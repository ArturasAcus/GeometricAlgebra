  3.959141364568863*^9}, {3.959215818001975*^9, 3.9592160906403103`*^9}, {
  3.959216125691701*^9, 3.959216178543662*^9}, {3.959240253472004*^9, 
  3.959240343493401*^9}, {3.959240380992062*^9, 3.959240469532975*^9}, {
  3.960017385826062*^9, 3.96001749040718*^9}, {3.9600175383039293`*^9, 
  3.960017629630924*^9}, {3.960019576664316*^9, 3.960019580373721*^9}},
 CellID->1419704611,ExpressionUUID->"5a9dc4fe-d1fa-4e42-a5f0-eaf0cd6452f7"],

Cell["\<\
Upper and lower indices are assumed to be sorted without taking account of \
their position (imagine they form a single list). \
\>", "Text",
