Cell["\<\
The StandardForm notation \[LeftContract] (unicode char  :0x23A6 ) is defined \
my modifying  UnicodeSymbols.tr file. Here we also determine  the operation \
precedence, which is 461. 
The following properties defined for arbitrary elements:\
\>", "Text",
 CellChangeTimes->{{3.9591383449524612`*^9, 3.959138458426982*^9}, {
   3.9591389519626913`*^9, 3.959138984645249*^9}, {3.959139168270685*^9, 
   3.9591392093666553`*^9}, {3.959215741055722*^9, 3.959215757324501*^9}, {
   3.959239898910493*^9, 3.959239901830504*^9}, {3.9592399535345583`*^9, 
   3.959239973619852*^9}, {3.9592400210897627`*^9, 3.95924002171262*^9}, {
   3.960016981299985*^9, 3.960016984172353*^9}, {3.960017184990738*^9, 
   3.960017227528331*^9}, {3.960017307200028*^9, 3.960017308995171*^9}, 
   3.960017371338216*^9},
 CellID->660196314,ExpressionUUID->"2d7b62e7-235d-496d-9900-b95912c4b8a8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"a___", ",", 
       RowBox[{"b_", "*", "c_"}], ",", "d___"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"b", "*", 
      RowBox[{"LeftContract", "[", 
       RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "/;", 
     RowBox[{
      RowBox[{"gaCommutativeAllQ", "[", "b", "]"}], "&&", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"{", 
         RowBox[{"a", ",", "d"}], "}"}], "]"}], ">", "0"}]}]}]}], " ", ";"}], 
  
  RowBox[{"(*", 
   RowBox[{"commuting", " ", "quantities", " ", "out"}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"c_", ",", "d_"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"c", "*", "d"}], "/;", 
     RowBox[{"gaCommutativeAllQ", "[", "c", "]"}]}]}], " ", ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "LeftContract", " ", "with", " ", "left", " ", "scalar", " ", "is", " ", 
    "simply", " ", "Times"}], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"a_", ",", "b_"}], "]"}], "]"}], ":=", 
    RowBox[{"0", "/;", 
     RowBox[{
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{
        "_GeometricProduct", "|", "_OuterProduct", "|", "_InnerProduct", "|", 
         "_RightContract", "|", "_LeftContract", "|", "_MV"}]}], "]"}], "&&", 
      
      RowBox[{"(", 
       RowBox[{"And", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Greater", "[", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"gaGradeList", "[", "a", "]"}], "]"}], ",", "#"}], 
            "]"}], "&"}], "/@", 
          RowBox[{"gaGradeList", "[", "b", "]"}]}], ")"}]}], ")"}]}]}]}], " ",
    ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "If", " ", "all", " ", "grades", " ", "of", " ", "a_", " ", "greater", " ",
      "than", " ", "any", " ", "of", " ", "b_"}], ",", " ", 
    RowBox[{"then", " ", "zero"}]}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", "a_", "]"}], "]"}], ":=", "$Failed"}], 
   ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "singlet", " ", "should", " ", "never", " ", "appear", " ", "in", " ", 
    "contraction"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2024", "-", "08", "-", 
     RowBox[{"27", " ", "attempt"}]}], ",", " ", 
    RowBox[{
    "Modification", " ", "for", " ", "noncommutative", " ", 
     "coefficients"}]}], "  ", "*)"}], " ", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "move", " ", "field", " ", "elements", " ", "outside", " ", "times", " ", 
    "in", " ", "left", " ", "contract"}], " ", "*)"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"a___", ",", 
       RowBox[{"Times", "[", 
        RowBox[{"b1___", ",", "c_", ",", "b2__"}], "]"}], ",", "d___"}], 
      "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"LeftContract", "[", 
      RowBox[{"a", ",", "c", ",", 
       RowBox[{"Times", "[", 
        RowBox[{"b1", ",", "b2"}], "]"}], ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", 
        RowBox[{"{", 
         RowBox[{"b1", ",", "b2"}], "}"}], "]"}], "]"}], "&&", 
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b1", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "to", " ", "in", " ", "front",
      " ", "of", " ", "other", " ", "elements", " ", "inside", " ", "left", " ",
      "contract"}], ",", " ", 
    RowBox[{
    "then", " ", "move", " ", "field", " ", "element", " ", "outside", " ", 
     "of", " ", "left", " ", "contract"}]}], " ", "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"a___", ",", "b_", ",", "c_", ",", "d___"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"LeftContract", "[", 
      RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "/;", 
     RowBox[{
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
      RowBox[{"Not", "[", 
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "b", "]"}], "]"}], "&&", 
      
      RowBox[{"FreeQ", "[", 
       RowBox[{
        RowBox[{"{", "b", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HoldPattern", "[", 
     RowBox[{"LeftContract", "[", 
      RowBox[{"a_", ",", "d__"}], "]"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"GeometricProduct", "[", 
      RowBox[{"a", ",", 
       RowBox[{"LeftContract", "[", "d", "]"}]}], "]"}], "/;", 
     RowBox[{"gaNonCommutativeFieldElementQ", "[", "a", "]"}]}]}], ";"}], 
  " "}]}], "Input",
 Editable->False,
 Evaluatable->False,
 CellLabel->"In[359]:=",
 CellID->1262873681,ExpressionUUID->"426e0412-f0b5-4a02-bacf-c81c1e7c84d3"],

Cell["\<\
Left contract of two orthonormal basis elements  is  simply grade \
comparison+geometric product. If the grade conditions is satisfied we return  \
geometric product of basis elements, else output is zero.\
\>", "Text",
 CellChangeTimes->{{3.959139219492103*^9, 3.959139265808468*^9}, {
  3.959140160637484*^9, 3.9591402616632967`*^9}, {3.959140527142654*^9, 
