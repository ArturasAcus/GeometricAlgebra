 CellLabel->"In[1]:=",
 CellID->904125756,ExpressionUUID->"8ad9d452-2e30-4456-a46b-e0afaf4735f7"],

Cell["\<\
Orthonormal basis of Cl(3,0) algebra: \
\[OpenCurlyDoubleQuote]gaCharacteristicPolynomial[MV,opts], \
gaCharacteristicPolynomial[MV,x_Symbol,opts], \
gaCharacteristicPolynomial[MV,All,opts], \
gaCharacteristicPolynomial[MV,n_Integer,opts] computes coefficients of \
characteristic polynomial MV.  \
gaCoefficientsOfCharacteristicPolynomial[MV,n_Integer, opts] returns the \
coefficient at x^n (x^0 is  -Det, x^(n-1) is Tr). \
gaCharacteristicPolynomial[MV,All,opts] yields list of all coefficients \
{1,... -det}. gaCharacteristicPolynomial[MV,x_Symbol,opts] returns a true \
polynomial, while gaCharacteristicPolynomial[MV,opts] returns a pure function. 
Options to describe, ... \[OpenCurlyDoubleQuote];\
\>", "Text",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.954599430847682*^9, 3.9545994368102837`*^9}, {
   3.954599627098667*^9, 3.9545996310900583`*^9}, {3.9580235943695173`*^9, 
