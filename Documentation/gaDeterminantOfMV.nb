Cell[TextData[{
 "Computation of symbolic expressions for algebras of vector space dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[GreaterEqual]", "5"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n\\ge 5", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "395d461a-f13d-46df-a173-72b0fe2aa179"],
 " is  time consuming and they are  large"
}], "Text",
