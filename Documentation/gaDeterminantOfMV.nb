Cell[TextData[{
 "Methods \[OpenCurlyDoubleQuote]Involutions\[CloseCurlyDoubleQuote], \
\[CloseCurlyDoubleQuote]Matrix\[CloseCurlyDoubleQuote] and \
\[CloseCurlyDoubleQuote]FaddeevLieVerrierSouriau\[CloseCurlyDoubleQuote]  are \
available. For vector space dimensions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LessEqual]", "6"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n\\le 6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c4074ae-8368-4a53-a274-7bc728545584"],
 " the default method is ",
 Cell[BoxData["\"\<Involutions\>\""], "Input",ExpressionUUID->
  "d50ca7db-fccf-47d8-bbe6-f4cbc0899734"],
 ", which computes the determinant of MV without any reference to matrix \
representation. "
}], "Text",
