  RowBox[{"gaAssociationRepresentation", "[", 
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"a", ",", 
     RowBox[{"Cl", "[", 
      RowBox[{"3", ",", "2"}], "]"}]}], "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"detSymbolic", "=", 
     RowBox[{"gaDeterminantOfMV", "[", 
      RowBox[{"theMV", ",", 
       RowBox[{"Method", "->", "\"\<Involutions\>\""}], ",", 
       RowBox[{"Expand", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Expand", "[", 
           RowBox[{"gaPE", "[", "#", "]"}], "]"}], "&"}], ")"}]}]}], "]"}]}], 
    ")"}], "//", "LeafCount"}], "//", "AbsoluteTiming"}]}], "Input",
