Cell[BoxData[
 RowBox[{
  RowBox[{"symbolicMV", "=", 
   RowBox[{
    FractionBox[
     RowBox[{"3", " ", "r"}], "4"], "-", 
    RowBox[{
     FractionBox["1", "8"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["r", "2"], "+", 
       SuperscriptBox["y", "2"]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox["r", "4"], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["y", "2"]}], "+", 
       SuperscriptBox["y", "4"], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["r", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "7"}], "+", 
          SuperscriptBox["y", "2"]}], ")"}]}]}], ")"}], " ", 
     TemplateBox[{
       TemplateBox[{"1"}, "mvDownUp", DisplayFunction :> (StyleBox[
          RowBox[{
            AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
          FontTracking -> "Condensed", AutoSpacing -> False]& ), 
        InterpretationFunction :> (ReleaseHold[
          RowBox[{"mvDownUp", "@@", 
            MakeExpression[{
              Take[{
                SlotSequence[1]}, 
               Length[{1}]], 
              Take[{
                SlotSequence[1]}, {Length[{1}] + 1, 
