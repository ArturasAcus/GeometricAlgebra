Cell[TextData[{
 "Outer product (as well as all other products) is not expanded \
automatically. We can expand the product with ",
 StyleBox["\[MediumSpace]", "InlineSeparator"],
 ButtonBox["gaProductExpand",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaProductExpand.nb", None},
  ButtonNote->"gaProductExpand"],
 StyleBox["\[MediumSpace]", "InlineSeparator"]
}], "Text",
