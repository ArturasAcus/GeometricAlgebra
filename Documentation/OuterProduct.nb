Cell[TextData[{
 "Multiplication of orthonormal basis elements  is implemented using ",
 Cell[BoxData["mvAntisymmetricProductSignatureMapC"], "Input",
  CellGroupingRules->{GroupTogetherGrouping, 10000.},ExpressionUUID->
  "b2619394-475d-4817-957d-198c2bb3b0bf"],
 " signature map, which is defined as ",
 StyleBox[" (-1)^(mvMuS[iI,jJ])",
  FontWeight->"Bold"],
 ", when intersection of lists ",
 StyleBox["iI",
  FontWeight->"Bold"],
 " and ",
 StyleBox["jJ",
  FontWeight->"Bold"],
 " is zero and zero otherwise. ",
 " The function ",
 StyleBox["mvMuS[i_List,j_List]=Do[sum=sum+mvMu[j[[k]],i],{k,Length[j]}]",
  FontWeight->"Bold"],
 ", counts total number of permutations needed to form a sorted list.  \
Definition of  ",
 StyleBox["mvMu",
  FontWeight->"Bold"],
 " is provided in implementation details for geometric product",
 ". The signature map function then is multiplied by basis element which \
contains set symmetric difference of indices: ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{"mvSetSymmetricDifference", "[", 
     RowBox[{"iI_List", ",", "jJ_List"}], "]"}], ":=", 
    RowBox[{"Complement", "[", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{"iI", ",", "jJ"}], "]"}], ",", 
      RowBox[{"Intersection", "[", 
       RowBox[{"iI", ",", "jJ"}], "]"}]}], "]"}]}], ";"}]], "Input",
  ExpressionUUID->"e2f635dd-730b-4e6c-a47a-950f7cc7fca5"],
 " "
}], "Text",
 CellChangeTimes->{{3.959139219492103*^9, 3.959139265808468*^9}, {
  3.959140160637484*^9, 3.9591402616632967`*^9}, {3.959140527142654*^9, 
  3.959140541944807*^9}, {3.959140585202232*^9, 3.9591408452350388`*^9}, {
  3.9591409937735167`*^9, 3.9591410310770903`*^9}, {3.95914118934074*^9, 
