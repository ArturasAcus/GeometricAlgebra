     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a_", ",", "d__"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"GeometricProduct", "[", 
       RowBox[{"a", ",", 
        RowBox[{"OuterProduct", "[", "d", "]"}]}], "]"}], "/;", 
      RowBox[{"gaNonCommutativeFieldElementQ", "[", "a", "]"}]}]}], ";"}], 
