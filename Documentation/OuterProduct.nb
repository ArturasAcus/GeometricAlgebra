Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "asociativity", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a___", ",", 
        RowBox[{"OuterProduct", "[", "b__", "]"}], ",", "c___"}], "]"}], 
      "]"}], ":=", 
     RowBox[{"OuterProduct", "[", 
      RowBox[{"a", ",", "b", ",", "c"}], "]"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"[", 
       RowBox[{"DH", "-", 
        RowBox[{"CA2GC1", ".22", "b"}]}], "]"}], " ", "formula"}], ",", " ", 
     RowBox[{"singlet", " ", "rule"}], ",", " ", 
     RowBox[{
     "outer", " ", "product", " ", "of", " ", "multivector", " ", "and", " ", 
      "scalar", " ", "behaves", " ", "like", " ", "geometric", " ", 
      "product"}]}], "  ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", "a_", "]"}], "]"}], ":=", "a"}], " ", 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"commuting", " ", "quantities", " ", "out"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a___", ",", 
        RowBox[{"b_", "*", "c_"}], ",", "d___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"b", " ", "*", 
       RowBox[{"OuterProduct", "[", 
        RowBox[{"a", ",", "c", ",", "d"}], "]"}]}], "/;", 
      RowBox[{
       RowBox[{"gaCommutativeAllQ", "[", "b", "]"}], "||", 
       RowBox[{"mvZeroGradeQ", "[", "b", "]"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a___", ",", "b_", ",", "c___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"b", " ", "*", 
       RowBox[{"OuterProduct", "[", 
        RowBox[{"a", ",", "c"}], "]"}]}], "/;", 
      RowBox[{
       RowBox[{"gaCommutativeAllQ", "[", "b", "]"}], "||", 
       RowBox[{"mvZeroGradeQ", "[", "b", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"OuterProduct", "[", "]"}], ":=", "$Failed"}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
    "empty", " ", "outer", " ", "product", " ", "should", " ", "never", " ", 
     "appear"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"2024", "-", "08", "-", 
      RowBox[{"27", " ", "attempt"}]}], ",", " ", 
     RowBox[{
     "Modification", " ", "for", " ", "noncommutative", " ", 
      "coefficients"}]}], "  ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "move", " ", "field", " ", "elements", " ", "outside", " ", "times", " ", 
     "in", " ", "outer", " ", "product"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a___", ",", 
        RowBox[{"Times", "[", 
         RowBox[{"b1___", ",", "c_", ",", "b2__"}], "]"}], ",", "d___"}], 
       "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a", ",", "c", ",", 
        RowBox[{"Times", "[", 
         RowBox[{"b1", ",", "b2"}], "]"}], ",", "d"}], "]"}], "/;", 
      RowBox[{
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
       RowBox[{"Not", "[", 
        RowBox[{"gaNonCommutativeFieldElementQ", "[", 
         RowBox[{"{", 
          RowBox[{"b1", ",", "b2"}], "}"}], "]"}], "]"}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "b1", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "move", " ", "field", " ", "elements", " ", "to", " ", "in", " ", 
      "front", " ", "of", " ", "other", " ", "elements", " ", "inside", " ", 
      "outer", " ", "product"}], ",", " ", 
     RowBox[{
     "then", " ", "move", " ", "field", " ", "element", " ", "outside", " ", 
      "of", " ", "outer", " ", "product"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"HoldPattern", "[", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a___", ",", "b_", ",", "c_", ",", "d___"}], "]"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"OuterProduct", "[", 
       RowBox[{"a", ",", "c", ",", "b", ",", "d"}], "]"}], "/;", 
      RowBox[{
       RowBox[{"gaNonCommutativeFieldElementQ", "[", "c", "]"}], "&&", 
       RowBox[{"Not", "[", 
        RowBox[{"gaNonCommutativeFieldElementQ", "[", "b", "]"}], "]"}], "&&", 
       RowBox[{"FreeQ", "[", 
        RowBox[{
         RowBox[{"{", "b", "}"}], ",", "MV"}], "]"}]}]}]}], ";"}], " ", "\[IndentingNewLine]", 
   RowBox[{
