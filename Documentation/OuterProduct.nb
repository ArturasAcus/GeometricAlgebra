Cell["\<\
The outer product has greater precedence than geometric product, but lower \
precedence than any of inner products. Operation list in decreasing  \
precedence order: NonCommutativeMultiply (**, highest), Times (*, Space), \
RightContract (\[RightContract]), LeftContract (\[LeftContract]), \
InnerProduct (\[InnerProduct]), CommutativeProduct (\[CommutativeProduct]), \
OuterProduct (\[OuterProduct]), GeometricProduct(\[GeometricProduct]), Plus \
(lowest).\
\>", "Notes",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.958023748420257*^9, 3.958023859771125*^9}, {
  3.958024221282074*^9, 3.958024280839714*^9}, {3.958024404378868*^9, 
  3.958024410132145*^9}, {3.958093300922853*^9, 3.958093336005582*^9}, {
  3.959239170686625*^9, 3.959239243115706*^9}},
 CellID->1861879662,ExpressionUUID->"401b4cf6-32b0-414a-a0a4-165a5350a585"]
}, Open  ]]
}, Open  ]],

