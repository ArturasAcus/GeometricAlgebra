Cell[TextData[{
 "The option \[OpenCurlyDoubleQuote]Expand\[CloseCurlyDoubleQuote]\[Rule]",
 Cell[BoxData[
  RowBox[{"Automatic", "|", "Expand", "|", "Identity", "|", "_Function"}]], 
  "Input",ExpressionUUID->"6989f804-462e-4b1c-8a9e-83bde3f2557d"],
 " applies the function after each logical step of computation. Default \
setting is gaPE, which expands products of multivectors. The option can help \
to reduce computation time (when used along with PlainRepresentation and some \
of methods) in some cases. It is considered as outdated now."
}], "Text",
 Editable->True,
