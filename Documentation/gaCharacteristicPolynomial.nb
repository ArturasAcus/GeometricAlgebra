\[CloseCurlyDoubleQuote]Matrix\[CloseCurlyDoubleQuote] and \
\[CloseCurlyDoubleQuote]FaddeevLieVerrierSouriau\[CloseCurlyDoubleQuote]  are \
available. For vector space dimensions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LessEqual]", "6"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n\\le 6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
