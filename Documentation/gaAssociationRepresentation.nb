}, Open  ]],

Cell[CellGroupData[{

Cell["Possible Issues", "Subsection",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.95492955401782*^9, 3.954929556674014*^9}},
 CellLabel->"In[5]:=",
 CellID->767103639,ExpressionUUID->"cbec14ba-a284-4503-ad9e-271772a36ffc"],

Cell["\<\
Association representation operations, for example product expansion, \
supports  down indices only.  Double (algebra and coefficient)  Association \
form is highly experimental and is neither finished nor well tested. It only \
makes sense to use with noncommutative field. \
\>", "Text",
 CellChangeTimes->{{3.962441254723729*^9, 3.962441417681252*^9}, {
   3.9626178391421633`*^9, 3.962618079744953*^9}, 3.962618118918529*^9, {
   3.968719565099732*^9, 3.9687195715504303`*^9}},
 CellID->1843269725,ExpressionUUID->"ff204bca-4fe3-4618-aadc-68ebc7dfb8d6"]
}, Open  ]]
}, Open  ]],

