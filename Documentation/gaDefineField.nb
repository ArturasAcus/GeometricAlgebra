  RowBox[{"GeometricProduct", "[", 
   RowBox[{
    RowBox[{"gaProductPairExpand", "[", 
     RowBox[{
      RowBox[{"CommutativeProduct", "[", 
       RowBox[{"a_", ",", "b_"}], "]"}], ",", "___"}], "]"}], ",", "c__"}], 
   "]"}], ":=", 
  RowBox[{
   RowBox[{"GeometricProduct", "[", 
    RowBox[{
     RowBox[{"CommutativeProduct", "[", 
      RowBox[{"a", ",", "b"}], "]"}], ",", "c"}], "]"}], "/;", 
