Cell[TextData[{
 "By default ",
 ButtonBox["gaOrthonormalBasis",
  BaseStyle->"Hyperlink",
  ButtonData->{"gaOrthonormalBasis.nb", None},
  ButtonNote->"gaOrthonormalBasis"],
 StyleBox["\[MediumSpace]", "InlineSeparator"],
 " sets coefficient field value to \[OpenCurlyDoubleQuote]Quaternion\
\[CloseCurlyDoubleQuote]. The setting enables easy input of quaternions (even \
if they are not used as coefficients of MV):"
}], "Text",
