     RowBox[{
      RowBox[{"\[DoubleStruckF]", "[", "1", "]"}], "*", 
      RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}]}], ",", 
    RowBox[{"\"\<InactivateProductPairExpand\>\"", "->", "True"}]}], "]"}], "//",
   "InputForm"}]], "Input",
