  BaseStyle->"Hyperlink",
  ButtonData->{"gaOrthonormalBasis.nb", None},
  ButtonNote->"gaOrthonormalBasis"],
 StyleBox["\[MediumSpace]", "InlineSeparator"],
 " command. This setting allows easy input of quaternion elements. "
}], "Notes",
