Cell[TextData[{
 "By default the noncommutative field elements are multiplied using \
GeometricProduct. The option \[OpenCurlyDoubleQuote]FieldProduct\
\[CloseCurlyDoubleQuote]\[Rule]\[CloseCurlyDoubleQuote]CommutativeProduct\
\[CloseCurlyDoubleQuote] change the product to CommutativeProduct, which \
effectively turns noncommutative field basis vectors to commutative algebra \
with  multiple complex units (with squares ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|
     "boxes" -> FormBox["\[PlusMinus]", TraditionalForm], "errors" -> {}, 
      "input" -> "\\pm", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "1"}], TraditionalForm]],ExpressionUUID->
  "25253962-61cf-415b-91ed-7a41d36f3f2d"],
 ", defined by field algebra signature)."
}], "Text",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.837695507334992*^9, 3.837695543208137*^9}, 
