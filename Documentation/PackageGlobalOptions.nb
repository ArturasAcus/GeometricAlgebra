Cell[CellGroupData[{

Cell["gaCompileTo", "Section",
 Deletable->True,
 TaggingRules->{"TemplateGroupName" -> "Documentation"},
 CellChangeTimes->{{3.958952079019672*^9, 3.958952084589727*^9}, 
   3.9589521205380898`*^9, {3.959046795676128*^9, 3.959046795956205*^9}},
 CellTags->{"Documentation", "TemplateSection"},
 CellID->109475398,ExpressionUUID->"8d22b28e-3e80-468e-ac31-3e21187e4eb9"],

Cell[TextData[{
 "Setting  gaCompileTo\[Rule]\[OpenCurlyDoubleQuote]WVM\
\[CloseCurlyDoubleQuote]|\[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote]  \
determines compilation of some signature functions. Value  \
\[OpenCurlyDoubleQuote]WVM\[CloseCurlyDoubleQuote] (default) compiles to  \
Wolfram virtual machine code (bytecode) , the value \[CloseCurlyDoubleQuote]C\
\[CloseCurlyDoubleQuote] to the binary code. Compilation to binary code takes \
package far longer to load and the speed gain is minimal.  This option may be \
removed in future to save some space.  In particular, the following internal \
functions are compiled: ",
 Cell[BoxData[
 "mvIndexToBinaryLikeRepresentationC"], "Input",ExpressionUUID->
  "613e7375-9d39-4464-bcdb-01bc8bac2e05"],
 " (convert index set to binary like representations by inserting zeroes in \
proper places), ",
 Cell[BoxData[
 "mvMu"], "Input",ExpressionUUID->"52fa38c3-c428-4db1-af60-4b4582649e9a"],
 " (Counts  elements of subset j that are greater than nonnegative integer i. \
j is subset of natural numbers),  ",
 Cell[BoxData["mvMuS"], "Input",
  CellGroupingRules->{GroupTogetherGrouping, 10001.},ExpressionUUID->
  "f7f3f9ce-b003-49e0-8024-e997dfcb79ec"],
 " (Counts total number of  elements of subset j that are greater of  each of \
integers, listed in the list i), ",
 Cell[BoxData["mvProductSignatureMapC"], "Input",
  CellGroupingRules->{GroupTogetherGrouping, 10000.},ExpressionUUID->
  "d8ad0a95-4d4d-4020-ae47-f9fe018e6910"],
 " (GeometricProduct signature map), ",
 Cell[BoxData["mvAltProductSignatureMapC"], "Input",
  Evaluatable->False,
  CellGroupingRules->{GroupTogetherGrouping, 10002.},ExpressionUUID->
  "a3d80c51-dcfc-4113-a46f-32a8680f56b3"],
 " (alternating product signature map, unused at the moment), ",
 Cell[BoxData["mvAntisymmetricProductSignatureMapC"], "Input",
  CellGroupingRules->{GroupTogetherGrouping, 10003.},ExpressionUUID->
  "bf13115c-5538-4746-9963-63518c3b7f2e"],
 " (OuterProduct signature map), ",
 Cell[BoxData["commProductSignatureMapC"], "Input",
  CellGroupingRules->{"GroupTogetherGrouping", 10002.},ExpressionUUID->
  "b9842e01-2d2c-433b-bf62-8eaef9f33ee4"],
 " (commutative geometric product signature map)"
}], "Text",
 CellChangeTimes->{{3.958952145561288*^9, 3.958952190266382*^9}, {
  3.9589527806087837`*^9, 3.9589528806061373`*^9}, {3.958952980032202*^9, 
  3.958953038595187*^9}, {3.9589530736992893`*^9, 3.9589533015926037`*^9}, {
  3.9589533324531593`*^9, 3.9589533513763227`*^9}, {3.9590472826474733`*^9, 
  3.959047282699853*^9}},
 CellID->251727735,ExpressionUUID->"05837727-ef00-4e43-99de-d479d554949e"],

Cell["\<\
In order to use \[OpenCurlyDoubleQuote]C\[CloseCurlyDoubleQuote] compilation \
target C compiler should be installed. \
\>", "Text",
 CellChangeTimes->{{3.958953517023939*^9, 3.958953577966333*^9}},
 CellID->844253449,ExpressionUUID->"c8bd7bed-46df-4553-aec0-239450ae5836"],

Cell[CellGroupData[{

Cell["How to test whether compilation to C works properly", "Subsubsection",
 CellID->878142032,ExpressionUUID->"480c6f21-09a7-487f-8b7f-fba6645027df"],

Cell["\<\
The speed of base elements products slightly depends on compilation type.  In \
order to make decision make cells below evaluatable. First, test what C \
compilers are available in your system. By default on Windows external \
compilers are absent.\
\>", "Text",
 CellID->582826928,ExpressionUUID->"102f643c-ae4e-47b9-b834-66fc353186c4"],

Cell[CellGroupData[{

