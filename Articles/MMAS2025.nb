Cell["\<\
Now for each root, compute Q polynomials. Start with largest multiplicity \
root r=3, m=4\
\>", "Text",
 CellChangeTimes->{{3.9416965161404943`*^9, 
  3.941696568365509*^9}},ExpressionUUID->"bc31b866-a0b5-454d-9059-\
24be60ba99fb"],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["Q", "TI"], 
          RowBox[{
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"]], "-", "1"}]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], ",", "\[Lambda]"}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["S", "TI"], 
             RowBox[{"(", "0", ")"}]], "(", 
            RowBox[{
              StyleBox["A", "TI"], ",", "\[Lambda]"}], ")"}], 
          RowBox[{
            SuperscriptBox["\[Mu]", 
             RowBox[{"(", 
               SubscriptBox[
                StyleBox["m", "TI"], 
                StyleBox["i", "TI"]], ")"}]], "(", "\[Lambda]", ")"}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "Q^{m_i-1}(\\m{A},\\lambda)=&\\frac{S^{(0)}(\\m{A},\\lambda)}{\\mu^{(m_i)\
}(\\lambda)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1266e87-7ef8-4ca8-a5a5-04a87a11c0bb"]
}], "Text",
 CellChangeTimes->{{3.941689846439931*^9, 
  3.9416898948956223`*^9}},ExpressionUUID->"127bd089-730a-4b19-8cce-\
3fc88cf5bac7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"qGen", "[", 
   RowBox[{"3", ",", 
    RowBox[{"{", 
     RowBox[{"5", ",", "4"}], "}"}]}], "]"}], "=", 
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"sS", "[", "0", "]"}], "/", 
        RowBox[{"dMinPoly", "[", "4", "]"}]}], ")"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[FormalLambda]", "->", "5"}], ",", 
        RowBox[{"\[FormalX]", "->", "x"}]}], "}"}]}], ",", "x"}], "]"}], "//",
    "Factor"}]}]], "Input",
 CellChangeTimes->{{3.941594829316625*^9, 3.94159483007551*^9}, {
   3.941594872688425*^9, 3.941594924095681*^9}, {3.941688514982917*^9, 
