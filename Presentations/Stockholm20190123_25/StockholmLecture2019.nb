 ExpressionUUID -> "e47f46a5-38c4-4580-80af-832a35656cc5"],

Cell[BoxData[
 RowBox[{"gaOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", 
   RowBox[{"{", "3", "}"}]}], "]"}]], "Input",
 ExpressionUUID -> "ba3225db-cfac-4e68-9ff4-5b583ec6c052"],

Cell["\<\
Here \[OpenCurlyDoubleQuote]AdditiveRepresentation\[CloseCurlyDoubleQuote] \
indicates the type of internal representation of base elements.
Then, on the right hand side we play with coefficients. Note, that central \
dot here means Dot, not InnerProduct.\
\>", "Text",
 CellChangeTimes->{{3.67489330530502*^9, 3.674893483264448*^9}, {
  3.714972641004849*^9, 3.714972818895594*^9}},
 ExpressionUUID -> "c1a6b5fd-ad92-4965-ab91-91210ad45ad2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"gaOrthonormalBasis", "[", 
       RowBox[{"testAlgebra", ",", 
        RowBox[{"{", "3", "}"}]}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "\[GeometricProduct]", 
     RowBox[{"a1", "\[InnerProduct]", 
      RowBox[{"(", 
       RowBox[{"Dot", "[", 
        RowBox[{
         RowBox[{"Cross", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"b1", ",", 
             RowBox[{"gaOrthonormalBasis", "[", 
              RowBox[{"testAlgebra", ",", 
               RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"Coefficient", "[", 
            RowBox[{"c1", ",", 
             RowBox[{"gaOrthonormalBasis", "[", 
              RowBox[{"testAlgebra", ",", 
               RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"gaOrthonormalBasis", "[", 
          RowBox[{"testAlgebra", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ")"}]}]}], ")"}], "//", 
   "gaPE"}]}]], "Input",
 ExpressionUUID -> "3ce187c5-0359-491a-8bfd-55fc18cd097f"],

Cell[BoxData[
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"lhs", "[", "testAlgebra", "]"}], "-", 
   RowBox[{"rhs", "[", "testAlgebra", "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.685087765190694*^9, 3.685087768389708*^9}},
 ExpressionUUID -> "07d73731-b3bd-40e5-acd3-577b865bcf87"]
}, Closed]],

