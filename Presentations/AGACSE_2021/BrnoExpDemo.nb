      RowBox[{"aP", "^", "2"}]}], ",", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{"aS", "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
