Cell[BoxData[
 RowBox[{"expFormExactRezultSeries", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"expFormExactRezult", "/.", 
             RowBox[{
              RowBox[{"a", "[", "x_", "]"}], ":>", 
              RowBox[{
               RowBox[{"a", "[", "x", "]"}], "/", "maxCoeff"}]}]}], ")"}], "/.",
            "rndReplRules"}], ")"}], "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"f_", "[", "x_", "]"}], "\[RuleDelayed]", 
            RowBox[{
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"x", "*", "\[Alpha]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\[Alpha]", ",", "0", ",", "10"}], "}"}]}], "]"}], "/;", 
