Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"gpSeriesTanhAnswerNC6", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"testMV", "/", "maxCoeff"}], ")"}], "/.", 
           "rndReplRules"}], ",", 
