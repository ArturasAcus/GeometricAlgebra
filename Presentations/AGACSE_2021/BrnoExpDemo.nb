        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "-", 
