Cell[BoxData[{
 RowBox[{
  RowBox[{"rndReplRulesIndep", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "[", "#", "]"}], "\[Rule]", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "7"}], "]"}]}], ")"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"4", "|", "5", "|", "6"}], "]"}], "\[Rule]", "_"}], ")"}], 
       "\[Rule]", "Nothing"}], "}"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"rndReplRules", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"{", 
