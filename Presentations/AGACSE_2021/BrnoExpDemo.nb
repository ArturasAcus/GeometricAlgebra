 RowBox[{
  RowBox[{"(", 
   RowBox[{"gpSeriesTanhAnswerNC40", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
