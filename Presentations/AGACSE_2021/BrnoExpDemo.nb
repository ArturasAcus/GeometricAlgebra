 RowBox[{
  RowBox[{"rules2aSaI", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
