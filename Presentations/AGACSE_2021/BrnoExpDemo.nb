          "gaCoshOfMVSimplified", "\[GeometricProduct]", "gaCoshOfMVInv"}], 
          ")"}], "]"}], "/.", 
        RowBox[{"(", 
         RowBox[{"Reverse", "/@", "rules2aPaR"}], ")"}]}], ")"}], "/.", 
      RowBox[{"(", 
