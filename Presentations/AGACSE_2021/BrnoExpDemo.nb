  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gaPE", "[", 
         RowBox[{"(", 
          RowBox[{
          "gaCosOfMVSimplified", "\[GeometricProduct]", "gaCosOfMVInv"}], 
          ")"}], "]"}], "//.", 
        RowBox[{"(", 
         RowBox[{"Reverse", "/@", "rules2aPaR"}], ")"}]}], ")"}], "//.", 
      RowBox[{"(", 
       RowBox[{"Reverse", "/@", "rules2aSaI"}], ")"}]}], ")"}], "/.", 
    RowBox[{"(", 
     RowBox[{"MapAt", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "/", "maxCoeff"}], ")"}], "&"}], ",", "rndReplRules", 
       ",", 
       RowBox[{"{", 
        RowBox[{"All", ",", "2"}], "}"}]}], "]"}], ")"}]}], "//", "N"}], "//",
   "Expand"}]], "Input",
