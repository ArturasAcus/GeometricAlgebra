          RowBox[{"a", "[", "2", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"a", "[", "6", "]"}], "\[Rule]", 
         RowBox[{"a", "[", "1", "]"}]}]}], "}"}], "/.", "rndReplRulesIndep"}],
