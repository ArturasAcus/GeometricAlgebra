Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cos", "[", "aPP", "]"}], " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
   RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
   RowBox[{"Cosh", "[", 
    RowBox[{"a", "[", "7", "]"}], "]"}]}], "-", 
  RowBox[{
   RowBox[{"Sin", "[", "aPP", "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
   RowBox[{"Sinh", "[", "aRR", "]"}], " ", 
   RowBox[{"Sinh", "[", 
    RowBox[{"a", "[", "7", "]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["aI", "2"], "+", 
      SuperscriptBox["aS", "2"]}]]], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Cosh", "[", 
         RowBox[{"a", "[", "7", "]"}], "]"}]}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "1", "]"}]}], "+", 
            RowBox[{"aRR", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
          RowBox[{"Sin", "[", "aPP", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aRR", " ", 
             RowBox[{"a", "[", "1", "]"}]}], "-", 
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cos", "[", "aPP", "]"}], " ", 
          RowBox[{"Sinh", "[", "aRR", "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "aRR"}], " ", 
             RowBox[{"a", "[", "1", "]"}]}], "+", 
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
          RowBox[{"Sin", "[", "aPP", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "1", "]"}]}], "+", 
            RowBox[{"aRR", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cos", "[", "aPP", "]"}], " ", 
