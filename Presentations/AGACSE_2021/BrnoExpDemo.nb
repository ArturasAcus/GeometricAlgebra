         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", "aS"}]}], 
    "}"}]}], ";", 
  RowBox[{"rules2aPaR", "=", 
   RowBox[{"{", 
    RowBox[{
