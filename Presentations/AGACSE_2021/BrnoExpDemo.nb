Cell[BoxData[
 RowBox[{"gaCosOfMVSimplified", "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"gaPE", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"gaExponentOfMV", "[", 
              RowBox[{"gaPE", "[", 
               RowBox[{"testMV", "\[GeometricProduct]", 
                RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"gaExponentOfMV", "[", 
              RowBox[{"gaPE", "[", 
               RowBox[{
                RowBox[{"-", "testMV"}], "\[GeometricProduct]", 
                RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
          "2"}], ")"}], "//.", "rules2aSaI"}], ")"}], "//.", "rules2aPaR"}], 
     "]"}], ",", "_\[DoubleStruckE]", ",", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ExpToTrig", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"TrigToExp", "[", "#", "]"}], "]"}], "]"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
