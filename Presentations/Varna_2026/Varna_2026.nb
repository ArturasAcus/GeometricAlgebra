Cell[BoxData[
 RowBox[{"minPolyt", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"MatrixMinimalPolynomial", "[", 
     RowBox[{
      RowBox[{"inputSymbolic", "*", "t"}], ",", "x"}], "]"}], "//", 
    "Factor"}], "//", "Normal"}]}]], "Input",
 TaggingRules->{},
 CellLabel->"In[67]:=",ExpressionUUID->"cf74b1e5-277c-4b45-a648-4a5ab38042e0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"inputSymbolic", ".", "expSymbolic"}], "-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"ComputeMatrixFunction", "[", 
          RowBox[{"Exp", ",", 
           RowBox[{"t", "*", "inputSymbolic"}], ",", 
           RowBox[{"\"\<MinimalPolynomial\>\"", "->", 
            RowBox[{"Evaluate", "[", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{"x", ",", "#"}], "]"}], "&"}], "[", "minPolyt", 
               "]"}], ")"}], "]"}]}]}], "]"}], ",", "t"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "1"}], "}"}]}], ")"}]}], ")"}], "//", "Together"}],
   "//", "MatrixForm"}]], "Input",
 CellLabel->"In[68]:=",ExpressionUUID->"d1aa4364-95b4-4fba-a411-a5d8e14ecc1c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

