Cell[CellGroupData[{

Cell[TextData[{
 "The characteristic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Chi]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\chi(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "368c7230-cd66-4ec5-8787-19eb0ec6074e"],
 " and the minimal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Mu]", "(", 
         StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mu (x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8c9cfef8-22e7-4bc4-9cac-ac029b474761"],
 " polinomials"
}], "Subsection",ExpressionUUID->"7b1cb0b2-9a94-44aa-80ad-1b207e934867"],

Cell["\<\

Each matrix has a characteristic polynomial\
\>", "Text",ExpressionUUID->"9dbd7b45-db3f-4f8d-82c9-9dcada768954"],

Cell[BoxData[
 RowBox[{"  ", 
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Chi]", 
          StyleBox["A", "TI"]], 
         RowBox[{"(", "\[Lambda]", ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["d", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["d", "TI"], "-", 
              StyleBox["k", "TI"]}], ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], " ", 
         SuperscriptBox["\[Lambda]", 
          StyleBox["k", "TI"]], "."}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\chi_{\\m{A}}(\\lambda)=\\sum_{k=0}^{d} C_{(d-k)}(\\m{A})\\, \\lambda \
^k.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"],
   TraditionalForm]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.942979930941414*^9, 3.942980206656869*^9}, {
   3.9429807769808292`*^9, 3.942980789871134*^9}, {3.942980820850419*^9, 
   3.9429808581022463`*^9}, {3.9429808894353123`*^9, 3.942980949574093*^9}, {
   3.9429809877493553`*^9, 3.94298099693974*^9}, {3.942981065392953*^9, 
   3.942981099566826*^9}, {3.9429811389271183`*^9, 3.942981212984894*^9}, {
   3.9429845039094763`*^9, 3.94298452881292*^9}, {3.9429845912868567`*^9, 
   3.942984614796967*^9}, {3.94298465444168*^9, 3.942984670277622*^9}, {
   3.942984705277025*^9, 3.9429847077550573`*^9}, 3.942984797578898*^9, 
   3.942984870591153*^9, {3.945506988705037*^9, 3.945506999225271*^9}},
 FontSize->16,ExpressionUUID->"fa00e3ed-976b-40a8-890b-ae85e0e5fdaa"],

Cell[TextData[{
 "Characteristic polynomial can be computed by Faddeev-LeVerrier-Souriau \
algorithm. First step returns ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", "1", ")"}]], "(", 
         StyleBox["A", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "C_{(1)}(\\m{A})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3eb94b3-6496-4f12-9c23-88a4abe69b57"],
 ". Every next produces new coefficient  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", 
            StyleBox["k", "TI"], ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            SubscriptBox[
             StyleBox["A", "TI"], 
             RowBox[{"(", 
               StyleBox["k", "TI"], ")"}]], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "C_{(k)}(\\m{A})=\\frac{1}{k}\\langle \\m{A}_{(k)} \\rangle_{0}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a700ba2-8c78-4a48-acef-ffea8092b148"],
 "  and new MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["k", "TI"], "+", "1"}], ")"}]], "\[LongEqual]", 
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{"(", 
                StyleBox["k", "TI"], ")"}]], "-", 
             SubscriptBox[
              StyleBox["C", "TI"], 
              RowBox[{"(", 
                StyleBox["k", "TI"], ")"}]], 
             RowBox[{"(", 
               StyleBox["A", "TI"], ")"}], 
             StyleBox["I", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\m{A}_{(k+1)}=\\m{A}\n\
\\bigl(\\m{A}_{(k)}-C_{(k)}(\\m{A})\\m{I}\\bigr)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8243b66d-9ac1-418f-b36c-301b576dc1b6"],
 "  using the procedure:"
}], "Text",ExpressionUUID->"2ad29c05-7381-4d27-97e6-62e92f024ce1"],

Cell[BoxData[{
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], 
         RowBox[{"(", "1", ")"}]], "\[LongEqual]", 
        StyleBox["A", "TI"], "  ", "\[Rule]  ", 
        SubscriptBox[
         StyleBox["C", "TI"], 
         RowBox[{"(", "1", ")"}]], 
        RowBox[{"(", 
          StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
        FractionBox["1", "1"], 
        SubscriptBox[
         RowBox[{"\[LeftAngleBracket]", 
           SubscriptBox[
            StyleBox["A", "TI"], 
            RowBox[{"(", "1", ")"}]], "\[RightAngleBracket]"}], "0"]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\m{A}_{(1)}=\\m{A}\\quad\\rightarrow\\quad C_{(1)}(\\m{A})=\\frac{1}{1}\
\\langle \\m{A}_{(1)}\\rangle_0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm], "\n", 
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], 
         RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
        StyleBox["A", "TI"], 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             StyleBox["A", "TI"], 
             RowBox[{"(", "1", ")"}]], "-", 
            SubscriptBox[
             StyleBox["C", "TI"], 
             RowBox[{"(", "1", ")"}]], 
            RowBox[{"(", 
              StyleBox["A", "TI"], ")"}], 
            StyleBox["I", "TI"]}], ")"}], "  ", "\[Rule]  ", 
        SubscriptBox[
         StyleBox["C", "TI"], 
         RowBox[{"(", "2", ")"}]], 
        RowBox[{"(", 
          StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
        FractionBox["1", "2"], 
        SubscriptBox[
         RowBox[{"\[LeftAngleBracket]", 
           SubscriptBox[
            StyleBox["A", "TI"], 
            RowBox[{"(", "2", ")"}]], "\[RightAngleBracket]"}], "0"]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\m{A}_{(2)}=\\m{A}\\bigl(\\m{A}_{(1)}-C_{(1)}(\\m{A})\\m{I}\\bigr)\n\
\\quad\\rightarrow\\quad C_{(2)}(\\m{A})=\\frac{1}{2}\\langle \
\\m{A}_{(2)}\\rangle_0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm], "\n", 
 FormBox[
  TemplateBox[<|
   "boxes" -> FormBox["\[VerticalEllipsis]", TraditionalForm], "errors" -> {},
     "input" -> "\\vdots", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm], "\n", 
 FormBox[
  TemplateBox[<|"boxes" -> FormBox[
      RowBox[{
        SubscriptBox[
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           StyleBox["d", "TI"], ")"}]], "\[LongEqual]", 
        StyleBox["A", "TI"], 
        RowBox[{"(", 
          RowBox[{
            SubscriptBox[
             StyleBox["A", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["d", "TI"], "-", "1"}], ")"}]], "-", 
            SubscriptBox[
             StyleBox["C", "TI"], 
             RowBox[{"(", 
               RowBox[{
                 StyleBox["d", "TI"], "-", "1"}], ")"}]], 
            RowBox[{"(", 
              StyleBox["A", "TI"], ")"}], 
            StyleBox["I", "TI"]}], ")"}], "  ", "\[Rule]  ", 
        SubscriptBox[
         StyleBox["C", "TI"], 
         RowBox[{"(", 
           StyleBox["d", "TI"], ")"}]], 
        RowBox[{"(", 
          StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
        FractionBox["1", 
         StyleBox["d", "TI"]], 
        SubscriptBox[
         RowBox[{"\[LeftAngleBracket]", 
           SubscriptBox[
            StyleBox["A", "TI"], 
            RowBox[{"(", 
              StyleBox["d", "TI"], ")"}]], "\[RightAngleBracket]"}], "0"]}], 
      TraditionalForm], "errors" -> {}, "input" -> 
    "\\m{A}_{(d)}=\\m{A}\\bigl(\\m{A}_{(d-1)}-C_{(d-1)}(\\m{A})\\m{I}\\bigr)\n\
\\quad\\rightarrow\\quad C_{(d)}(\\m{A})=\\frac{1}{d}\\langle\n\
\\m{A}_{(d)}\\rangle_0", "state" -> "Boxes"|>,
   "TeXAssistantTemplate"], TraditionalForm]}], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.94298021552468*^9, 3.942980240388297*^9}, {
   3.942980312226103*^9, 3.942980334895337*^9}, {3.9429803757127533`*^9, 
   3.942980487457996*^9}, {3.942980640225395*^9, 3.942980682819338*^9}, {
   3.9429807133879147`*^9, 3.942980765664402*^9}, {3.942984933839058*^9, 
   3.9429849835007477`*^9}, {3.942985050414947*^9, 3.9429850733950243`*^9}, 
   3.942985152391828*^9, 3.945149839149756*^9, {3.945150006441123*^9, 
   3.945150006970458*^9}, {3.945507051965775*^9, 
   3.945507074131238*^9}},ExpressionUUID->"2eca36ca-15ac-4fc0-a3b4-\
764785560121"],

Cell[TextData[{
 "One more step  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["d", "TI"], "+", "1"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(d+1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d73e3571-b271-4bfd-ac9a-cc91359d737b"],
 " yields zero,"
}], "Text",ExpressionUUID->"60b28ee5-b521-437a-84bf-c151c7e8afa5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["d", "TI"], "+", "1"}], ")"}]], "\[LongEqual]", 
         StyleBox["A", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["A", "TI"], 
              RowBox[{"(", 
                StyleBox["d", "TI"], ")"}]], "-", 
             SubscriptBox[
              StyleBox["C", "TI"], 
              RowBox[{"(", 
                StyleBox["d", "TI"], ")"}]], 
             RowBox[{"(", 
               StyleBox["A", "TI"], ")"}], 
             StyleBox["I", "TI"]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}_{(d+1)}=\\m{A}\\bigl(\\m{A}_{(d)}-C_{(d)}(\\m{A})\\m{I}\\bigr)=\
0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], ","}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.942985146843993*^9, 3.942985518902419*^9}, 
   3.943320965592309*^9, {3.945507100140581*^9, 
   3.945507115082478*^9}},ExpressionUUID->"d8b1380c-3538-4ed1-952d-\
ff4c76292b6c"],

Cell[TextData[{
 "This is Cayley-Hamilton theorem.  It claims that if commutative variable  \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b74265fa-03a6-422b-b085-8dff98185028"],
 "  is replaced by multivector/matrix  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63a28791-fffd-404b-93f2-8251e4ce359a"],
 " still get zero"
}], "Text",ExpressionUUID->"5383bc08-6769-4b5d-907d-a584a55ce42b"],

Cell[BoxData[
 RowBox[{"  ", 
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["d", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["k", "TI"]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", 
            RowBox[{
              StyleBox["d", "TI"], "-", 
              StyleBox["k", "TI"]}], ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["d", "TI"]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", "0", ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "+", 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["d", "TI"], "-", "1"}]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", "1", ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "+", "\[CenterEllipsis]", "+", 
         SubscriptBox[
          StyleBox["C", "TI"], 
          RowBox[{"(", 
            StyleBox["d", "TI"], ")"}]], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "\[LongEqual]", "0 ", "."}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{k=0}^{d}  \\m{A}^k \
C_{(d-k)}(\\m{A})=\\m{A}^{d}C_{(0)}(\\m{A})+\\m{A}^{d-1}C_{(1)}(\\m{A})+\\\
cdots + C_{(d)}(\\m{A})= &0\\,.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"],
   TraditionalForm]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.942985146843993*^9, 3.942985518902419*^9}, 
   3.943320965592309*^9, {3.945507124052397*^9, 
   3.945507138340955*^9}},ExpressionUUID->"e17879fc-681f-4d73-a7e3-\
3c78efa4f34e"],

Cell[TextData[{
 "So, a multivector/matrix  power ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["d", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}^d", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc1d2eab-ad24-4800-935f-ddf76a07f02d"],
 " (and all higher ones, of course) can be expressed by   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "0"], ",", 
         StyleBox["A", "TI"], ",", 
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], ",", "\[Ellipsis]", ",", 
         SuperscriptBox[
          StyleBox["A", "TI"], 
          RowBox[{
            StyleBox["d", "TI"], "-", "1"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\m{A}^0,\\m{A},\\m{A}^2,\\ldots,\\m{A}^{d-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d20ed05d-33fb-42bc-a3e8-3cca6441c89e"],
 " only. "
}], "Text",ExpressionUUID->"1ab8525d-dc18-4187-8a61-f4a7681f9c6d"],

Cell["\<\
Conclusion: computation of matrix function requires only the matrix powers up \
to  d-1 \
\>", "Text",
 Background->RGBColor[
  0.98, 0.56, 0.17, 
   0.33],ExpressionUUID->"c33a56c9-86f3-46cb-bc78-d995bf0cde4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"testMatrix", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"3", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "3", ",", "0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "5", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "5"}], "}"}]}], "}"}]}], ")"}], "//",
   "MatrixForm"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"d176f498-6681-42ed-8f92-6aaf16180937"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gaFaddeevLieVerrierSouriauCoefficientsMatrix", "[", 
   RowBox[{"expr_", ",", "n_Integer"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"count", "=", "0"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{"Last", "/@", 
        RowBox[{"NestList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Subtract", "@@", "##"}], ",", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "[", "\n", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", "x", "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"x", ",", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"n", "/", 
                    RowBox[{"(", 
                    RowBox[{"count", "+=", "1"}], ")"}]}], ")"}], "*", 
                  RowBox[{"(", 
                   RowBox[{"1", "/", "n"}], ")"}], "*", 
                  RowBox[{"Tr", "[", "x", "]"}]}]}], "}"}]}], "]"}], "[", 
             RowBox[{"expr", "*", 
              RowBox[{"(", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ")"}]}], "]"}], "]"}], "&"}], 
          ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", "n"}], "]"}]}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{"MatrixQ", "[", "expr", "]"}]}]}]], "Code",
 CellLabel->"In[8]:=",ExpressionUUID->"1905de1d-54bc-4b08-8c78-55389cce9056"],

Cell[BoxData[
 RowBox[{"gaFaddeevLieVerrierSouriauCoefficientsMatrix", "[", 
  RowBox[{"testMatrix", ",", "4"}], "]"}]], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"a8d3ff85-7b95-46d7-ac0b-c8d3e473df48"],

Cell["The trace and the determinant", "Text",ExpressionUUID->"318e7f98-fc1d-44e6-bce4-bdbdb674a393"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Tr", "[", "testMatrix", "]"}], ",", 
   RowBox[{"Det", "[", "testMatrix", "]"}]}], "}"}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"8a9da7c2-97c8-45bb-8477-20956c773b92"],

Cell["\<\
Physicists compute the characteristic polynomial in a slightly different way\
\>", "Text",ExpressionUUID->"606bcdc8-ab3d-4088-97fd-b31ea27bc5a5"],

Cell[BoxData[{
 RowBox[{"fizikuCharPoly", "=", 
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"testMatrix", "-", 
     RowBox[{"\[Lambda]", "*", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"Length", "[", "testMatrix", "]"}], "]"}]}]}], "]"}], "//", 
   "Expand"}]}], "\[IndentingNewLine]", 
 RowBox[{"Factor", "[", "%", "]"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"c6064bb1-159c-40c7-95ed-1dea6e5bd349"],

Cell[BoxData[{
 RowBox[{"minPoly", "=", 
  RowBox[{
   RowBox[{"MatrixMinimalPolynomial", "[", 
    RowBox[{"testMatrix", ",", "x"}], "]"}], "//", "Expand"}]}], "\[IndentingNewLine]", 
 RowBox[{"Factor", "[", "%", "]"}]}], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"c92e12e2-eaf0-4b83-b887-151f5e67a7d3"],

Cell["\<\
Cayley-Hamilton theorem: matrix satisfies it\[CloseCurlyQuote]s own \
characteristic equation\
\>", "Text",ExpressionUUID->"ac4cc4a8-9c55-4dda-87e5-dbed370ad6fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixPolynomialValue", "[", 
   RowBox[{"fizikuCharPoly", ",", "testMatrix", ",", "\[Lambda]"}], "]"}], "//",
   "MatrixForm"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"915f4cfb-de6f-4bbe-9f06-67de6a6397be"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixPolynomialValue", "[", 
   RowBox[{"minPoly", ",", "testMatrix", ",", "x"}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"ddccf123-7160-4642-af4e-5fb047bec371"],

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{"replacementRules", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "i"}], "->", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"testMatrix", ",", "i"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "testMatrix", "]"}]}], "}"}]}], "]"}]}], 
    ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"17c0859f-f198-4831-9370-d926fe89d2db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "/.", 
         RowBox[{"{", 
          RowBox[{"x", "->", "0"}], "}"}]}], ")"}], 
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"Length", "[", "testMatrix", "]"}], "]"}]}], ")"}], "+", 
     RowBox[{"(", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "-", 
         RowBox[{"(", 
          RowBox[{"#", "/.", 
           RowBox[{"{", 
            RowBox[{"x", "->", "0"}], "}"}]}], ")"}]}], "/.", 
        "replacementRules"}], ")"}], ")"}]}], "&"}], "[", 
   RowBox[{"(", 
    RowBox[{"fizikuCharPoly", "/.", 
     RowBox[{"{", 
      RowBox[{"\[Lambda]", "->", "x"}], "}"}]}], ")"}], "]"}], "//", 
  "MatrixForm"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"1b0eb178-e241-460d-ba88-f4e27be84672"],

