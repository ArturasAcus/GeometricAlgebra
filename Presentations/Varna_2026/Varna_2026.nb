Cell["A generalised spectral basis", "Section",ExpressionUUID->"c5b6fc3a-31dc-41d8-80b6-4405495f2b3c"],

Cell["\<\

https://resources.wolframcloud.com/FunctionRepository/resources/\
ComputeMatrixFunction/\
\>", "Text",ExpressionUUID->"42ee7f4e-8361-470b-9653-212a7927b43f"],

Cell[CellGroupData[{

Cell["Definitions", "Subsubsection",ExpressionUUID->"23042fd3-e493-403b-a211-833a29b5cdfb"],

Cell["Compute all matrix power up to given number pow.", "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.953361490282901*^9, 
  3.953361519746644*^9}},ExpressionUUID->"17854967-c7fe-48a1-9ef3-\
ace7537b33ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"allPowersOfMatrix", "[", 
    RowBox[{
     RowBox[{"var_", "->", 
      RowBox[{"mult_", "?", "MatrixQ"}]}], ",", "pow_Integer"}], "]"}], ":=", 
   
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"formalPowers", "=", 
       RowBox[{"var", "^", 
        RowBox[{"(", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Range", "[", 
           RowBox[{"1", ",", 
            RowBox[{"pow", "+", "1"}]}], "]"}], "]"}], ")"}]}]}], "}"}], ",", 
     
     RowBox[{"MapThread", "[", 
      RowBox[{"Rule", ",", 
       RowBox[{"{", 
        RowBox[{"formalPowers", ",", 
         RowBox[{"Nest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Function", "[", 
                   RowBox[{
                    RowBox[{"{", "pfv", "}"}], ",", 
                    RowBox[{"Dot", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "#", "]"}], ",", "pfv"}], "]"}]}], 
                   "]"}], "/@", "#"}], ")"}], ",", 
                RowBox[{"{", 
                 RowBox[{"Last", "[", "#", "]"}], "}"}]}], "}"}], ",", "1"}], 
             "]"}], "&"}], ",", 
           RowBox[{"{", "mult", "}"}], ",", "pow"}], "]"}]}], "}"}]}], 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{3.953373068858042*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"686353b5-fd18-48db-94c3-1df143719028"],

Cell[TextData[{
 "Internal primitive implementation of matrix minimal polynomial. Better use \
resource function ",
 Cell[BoxData[
  RowBox[{"ResourceFunction", "[", "\"\<MatrixMinimalPolynomial\>\"", "]"}]], 
  "Input",
  CellChangeTimes->{{3.860829323846205*^9, 3.860829327307953*^9}, {
   3.860829385749505*^9, 3.860829414112848*^9}},ExpressionUUID->
  "238a1139-5d7e-4388-ae6f-a1aa15c0c1df"],
 " from this repository"
}], "Text",
 TaggingRules->{},
 CellChangeTimes->{{3.953361490282901*^9, 3.953361519746644*^9}, {
  3.9533618681159697`*^9, 3.953361906067894*^9}, {3.9533619412085457`*^9, 
  3.953361955151816*^9}},ExpressionUUID->"ac8850fb-335b-4629-b3a6-\
998538dd2845"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matrixMinimalPolynomialPrimitive", "[", 
   RowBox[{
    RowBox[{"a_List", "?", "MatrixQ"}], ",", "x_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "=", "1"}], ",", 
      RowBox[{"qu", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"mnm", "=", 
       RowBox[{"{", 
        RowBox[{"Flatten", "[", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"Length", "[", "a", "]"}], "]"}], "]"}], "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "qu", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"mnm", ",", 
          RowBox[{"Flatten", "[", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{"a", ",", "n"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"Hope", " ", "that", " ", "Method"}], "->", 
          
          RowBox[{"\"\<OneStepRowReduction\>\"", " ", "will", " ", "work", " ",
            "better", " ", "with", " ", "radicals"}]}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"qu", "=", 
         RowBox[{"NullSpace", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", "mnm", "]"}], ",", 
           RowBox[{"Method", "->", "\"\<OneStepRowReduction\>\""}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"n", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"First", "[", "qu", "]"}], ".", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"x", "^", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}]}], "]"}]}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.95336700971402*^9, 3.9533670136592207`*^9}, {
  3.9533670615303793`*^9, 3.953367062931773*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"0710f33a-410c-41c3-ab2b-561750f6729c"],

Cell["\<\
makeSSum[] is a help functions for qTable[]. The pair of this functions \
implements implements recursive partial function decomposition of \
1/minimalPolynomial.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{3.953373159620779*^9, 
  3.953373351972662*^9},ExpressionUUID->"7ceac02b-a4b6-48e1-a8e4-\
0ca0d74b687f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"makeSSum", "[", 
     RowBox[{
     "sDTable_List", ",", "muDTable_List", ",", "multiplicity_Integer", ",", 
      "previousQs_List", ",", "term_Integer"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sDTable", "[", 
        RowBox[{"[", 
         RowBox[{"1", "+", "term"}], "]"}], "]"}], "-", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"previousQs", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "*", 
          RowBox[{"muDTable", "[", 
           RowBox[{"[", 
            RowBox[{"multiplicity", "+", "k"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "term"}], "}"}]}], "]"}]}], ")"}], "/", 
     RowBox[{"muDTable", "[", 
      RowBox[{"[", "multiplicity", "]"}], "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"qTable", "[", 
    RowBox[{"sDTable_List", ",", "muDTable_List", ",", 
     RowBox[{"{", 
      RowBox[{"root_", ",", "multiplicity_Integer"}], "}"}]}], "]"}], ":=", 
   RowBox[{"Fold", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"makeSSum", "[", 
          RowBox[{
          "sDTable", ",", "muDTable", ",", "multiplicity", ",", "#1", ",", 
           "#2"}], "]"}], ",", "#1"}], "}"}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sDTable", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "/", 
       RowBox[{"muDTable", "[", 
        RowBox[{"[", "multiplicity", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", 
       RowBox[{"multiplicity", "-", "1"}]}], "]"}]}], "]"}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellLabel->"In[29]:=",ExpressionUUID->"c001943c-335c-425f-89b7-bda87dae071b"],

Cell["\<\
recursivePartialFractionDecompose[] uses qTable[] to output partial fraction \
decomposition for each of roots of minimal polynomial.\
\>", "Text",
