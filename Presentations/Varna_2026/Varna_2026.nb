Cell["Take a simple matrix", "Text",ExpressionUUID->"5c78debd-72b9-44cf-89c7-cf2888880700"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ex1M", "=", 
   TagBox[
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{
         RowBox[{"-", "14"}], "-", "\[ImaginaryI]"}], 
        RowBox[{
         RowBox[{"-", "3"}], "-", 
         RowBox[{"5", " ", "\[ImaginaryI]"}]}]},
       {
        RowBox[{
         RowBox[{"-", "15"}], "-", 
         RowBox[{"5", " ", "\[ImaginaryI]"}]}], 
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         RowBox[{"9", " ", "\[ImaginaryI]"}]}]}
      },
      GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.7]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}], "\[NoBreak]", ")"}],
    Function[BoxForm`e$, 
     MatrixForm[BoxForm`e$]]]}], ";"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"58379c80-38ef-471d-b8eb-31d1e675a11d"],

Cell["The absolute value of the determinant is not large", "Text",ExpressionUUID->"1211490c-0c5c-4423-81e3-8bfe5044099f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Det", "[", "ex1M", "]"}], "//", "Abs"}], "//", "N"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"3a5f8854-609a-4d1b-88b7-8285848fed78"],

Cell["\<\
Compute  60 Taylor series terms of Exp function (the function is well behaved)\
\>", "Text",ExpressionUUID->"fafcf5c8-d8e3-4098-a56b-5e9e697383de"],

Cell[BoxData[
 RowBox[{"expSeriesEx1M", "=", 
  RowBox[{"Normal", "[", 
   RowBox[{"Series", "[", 
    RowBox[{
     RowBox[{"Exp", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "60"}], "}"}]}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"e993d831-fed9-48e3-9602-dfaa39ea91ce"],

Cell[TextData[{
 "Make a replacement rules ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9a51c644-ee1e-4b17-b6ee-6ab326165c4b"],
 " to corresponding matrix powers"
}], "Text",ExpressionUUID->"0c652a00-d8f2-49a6-a9de-69387a3bb845"],

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{"replacementRulesM", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "^", "i"}], "->", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"ex1M", ",", "i"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "60"}], "}"}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"f6efc9d4-60e9-481c-b9f6-c51dd7767c88"],

Cell[TextData[{
 "Make increasing set of  sums ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "+", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1+x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52688e59-85cc-4fce-ab04-ddd0bd64563f"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "+", 
         StyleBox["x", "TI"], "+", 
         RowBox[{"(", 
           RowBox[{"1", "/", "2"}], ")"}], 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1+x+(1/2)x^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "805f9d1f-17b9-459f-b4db-4cc05588aff0"],
 ", ..."
}], "Text",ExpressionUUID->"daa3fb41-3c66-47f1-8546-ed28863b9faf"],

Cell[BoxData[
 RowBox[{"Map", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"MatrixForm", "[", 
     RowBox[{"N", "[", "#", "]"}], "]"}], "&"}], ",", 
   RowBox[{"(", 
    RowBox[{"matrixSumData", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "2", "]"}], "+", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Rest", "[", "expSeriesEx1M", "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "k"}], "]"}], "]"}], "/.", 
          "replacementRulesM"}], ")"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "59"}], "}"}]}], "]"}]}], ")"}]}], 
  "]"}]], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"da683f38-8cfa-4808-80bb-426dfe9f1423"],

Cell["\<\
Let\[CloseCurlyQuote]s look how some specific element change (for example in \
