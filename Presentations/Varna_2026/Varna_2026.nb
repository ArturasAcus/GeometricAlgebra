Cell[CellGroupData[{

Cell["Example of superiority of spectral basis method ", "Section",ExpressionUUID->"4d1ee6d2-ea73-4f9c-ae2b-b77b4b3e5cb7"],

Cell["\<\
Take very similar matrix, which looks even simpler than the previous one\
\>", "Text",ExpressionUUID->"8a9b6f27-5f3d-41c2-926c-5bd62bbd8393"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"input", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", 
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "2"}], ",", "0", ",", "2", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "2"}], ",", "4", ",", "2", ",", 
        RowBox[{"-", "2"}], ",", "2", ",", "5", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "0", ",", "0", ",", "2", ",", "4", ",", 
        RowBox[{"-", "3"}], ",", 
        RowBox[{"-", "2"}], ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "2"}], ",", "2", ",", 
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "4"}], ",", "0", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "2"}], ",", "2", ",", 
        RowBox[{"-", "1"}], ",", "0", ",", "2", ",", 
        RowBox[{"-", "2"}], ",", 
        RowBox[{"-", "2"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", 
        RowBox[{"-", "4"}], ",", "1", ",", "2", ",", 
        RowBox[{"-", "2"}], ",", "2", ",", 
        RowBox[{"-", "4"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "0", ",", "0", ",", "2", ",", "0", ",", 
        RowBox[{"-", "4"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", 
        RowBox[{"-", "2"}], ",", "4", ",", 
        RowBox[{"-", "2"}], ",", "4", ",", 
        RowBox[{"-", "4"}], ",", 
        RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ")"}], "//", 
  "MatrixForm"}]], "Input",
 TaggingRules->{},
 CellChangeTimes->{{3.953363381659213*^9, 3.95336339828436*^9}, 
   3.9538830287135687`*^9},
 CellLabel->"In[69]:=",ExpressionUUID->"ce016e5f-111c-4373-804e-908dd238dbcd"],

Cell["\<\
The difference is that minimal polynomial of this matrix is irreducible \
polynomial of high degree  (of degree 6)\
\>", "Text",ExpressionUUID->"fe1aa54c-c257-4cad-a7f6-382642a4c0e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"minPoly", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
      "ResourceFunction", "[", "\"\<MatrixMinimalPolynomial\>\"", "]"}], "[", 
      
      RowBox[{"input", ",", "x"}], "]"}], "//", "Factor"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"MatrixMinimalPolynomial", "[", 
    RowBox[{"input", ",", "x"}], "]"}], "//", "Factor"}]}]], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"ab03625c-b42f-4f82-a12f-a58671329d4a"],

Cell[BoxData[
 RowBox[{"IrreduciblePolynomialQ", "[", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "4743"}], "-", 
    RowBox[{"198", " ", "x"}], "+", 
    RowBox[{"543", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"124", " ", 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{"39", " ", 
     SuperscriptBox["x", "4"]}], "+", 
    RowBox[{"10", " ", 
     SuperscriptBox["x", "5"]}], "+", 
    SuperscriptBox["x", "6"]}], ")"}], "]"}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"fc40da08-12fd-45e8-bc11-9d55b3b66db1"],

Cell["\<\
It means that the roots can\[CloseCurlyQuote]t be expressed in radicals. \
Jordan decomposition is easy, however computation of inverse transformation \
matrix is problematic (takes long time, not attempted here, the result is \
shown below)\
\>", "Text",ExpressionUUID->"847830a0-47d1-45df-ae73-47cac1dfc94b"],

Cell[BoxData[{
 RowBox[{"JordanDecomposition", "[", "input", "]"}], "\[LineSeparator]", 
 RowBox[{"Inverse", "[", 
  RowBox[{"%", "[", 
   RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "Input",
 Evaluatable->False,ExpressionUUID->"b6752176-9a9d-4a71-912b-148dc06ca28c"],

Cell[TextData[{
 "Therefore the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " obtains very long answer and computations take long time"
}], "Text",ExpressionUUID->"aaf046eb-2168-43d0-9750-5f7694b57db6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"answerMma", "=", 
     RowBox[{"MatrixFunction", "[", 
      RowBox[{"Exp", ",", "input"}], "]"}]}], ")"}], "//", "LeafCount"}], "//",
   "AbsoluteTiming"}]], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"197fb682-20da-4794-8860-80d943c894d6"],

Cell[BoxData[
 RowBox[{"answerMma", "//", "ByteCount"}]], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"7c959fb4-0573-456a-b8ff-cbb74d86d7e5"],

Cell["\<\
The spectral basis method obtains the same answer  1000 times faster and \
provides an answer that is 1000 times smaller\
\>", "Text",ExpressionUUID->"ab86ac25-1cf7-4896-b4f9-eea0dbc2a529"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"answerGenSpBasis", "=", 
     RowBox[{"ComputeMatrixFunction", "[", 
      RowBox[{"Exp", ",", "input"}], "]"}]}], ")"}], "//", "LeafCount"}], "//",
   "AbsoluteTiming"}]], "Input",
 CellLabel->"In[74]:=",ExpressionUUID->"fbde4f09-aaee-4dec-8b72-45a98f6f0c72"],

Cell["\<\
Numerical answers are the same (we compare only one arbitrary matrix element, \
since the whole matrix comparison would take too much time)\
\>", "Text",ExpressionUUID->"5f07a03d-b52c-4c58-a865-d11a05ca3b91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"answerMma", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}], "-", 
     RowBox[{"answerGenSpBasis", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", "40"}], "]"}], "//", 
  "AbsoluteTiming"}]], "Input",
 CellLabel->"In[75]:=",ExpressionUUID->"341a75ee-bb50-4e8f-a785-d0ecc173e2a5"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["", "SlideShowNavigationBar",
 CellTags->
  "SlideShowHeader",ExpressionUUID->"22efe97d-cfd4-4871-bacb-7977c6da7a9a"],

Cell[CellGroupData[{

Cell["Examples for multivectors", "Section",ExpressionUUID->"033400ce-bb15-482f-b949-c087662bf3b0"],

Cell["\<\
So far all demonstrations were for matrices. In fact the generalised spectral \
basis formulas were discovered by playing with multivectors. 
Below is the emonstration of the implementation for multivectors.\
\>", "Text",ExpressionUUID->"b128d5c8-bacd-432d-9178-ea447ca55e57"],

Cell[BoxData[
 RowBox[{"Remove", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"4722ae50-dc54-44eb-84c8-8a246ca985c7"],

Cell["Load Geometric algebra package", "Text",ExpressionUUID->"215ca5bc-6b75-4fdb-9786-c7c258979d71"],

Cell[BoxData[
 RowBox[{"NotebookEvaluate", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", 
      RowBox[{"EvaluationNotebook", "[", "]"}], "]"}], ",", "\"\<GA.nb\>\""}],
     "}"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.673770020900804*^9, 3.673770052959599*^9}, {
   3.67377255744574*^9, 3.673772560984225*^9}, {3.673772957194665*^9, 
   3.673772964956344*^9}, {3.673773010571767*^9, 3.673773014511329*^9}, {
   3.673834864366583*^9, 3.673834875805387*^9}, {3.675575949149817*^9, 
   3.67557601523748*^9}, {3.736246092415019*^9, 3.736246093168438*^9}, 
   3.750330997042767*^9, 3.750337192359868*^9, {3.7621497056275187`*^9, 
   3.762149706871374*^9}, {3.767611544913014*^9, 3.76761154631653*^9}, {
   3.76994837313642*^9, 3.769948374363431*^9}, {3.772245450359097*^9, 
   3.772245451407674*^9}, {3.821189448404995*^9, 3.821189449115222*^9}, {
   3.823312634415565*^9, 3.823312635085842*^9}, {3.824539471595636*^9, 
   3.824539472390354*^9}, 3.826338408961995*^9, 3.8263384872396727`*^9, {
   3.829888632118311*^9, 3.829888632973489*^9}, {3.830306061331986*^9, 
   3.830306061927419*^9}, {3.848568423059662*^9, 3.848568423993775*^9}, {
   3.857630232574857*^9, 3.8576302332354918`*^9}, {3.882327166452185*^9, 
   3.882327168592963*^9}, {3.88284791617839*^9, 3.882847916934208*^9}, {
   3.883623929437516*^9, 3.8836239300645313`*^9}, {3.942977271041567*^9, 
   3.9429772726953*^9}},
 CellLabel->"In[77]:=",ExpressionUUID->"fa9c4c21-46c1-4086-bb2e-2215df688255"],

Cell["Define simple algebra", "Text",ExpressionUUID->"9f5a459f-7279-4c3e-b77a-83404d79ce01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", " ", "=", " ", 
   RowBox[{"Cl", "[", 
    RowBox[{"2", ",", " ", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", " ", 
   RowBox[{"Quiet", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.942979460429545*^9, 3.9429794930807667`*^9}, {
  3.94360775131271*^9, 3.9436077520477552`*^9}, {3.9448832545974607`*^9, 
  3.944883256249073*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"2034ccab-e4c8-4aeb-9970-4e1a11c6289b"],

Cell[TextData[{
 "Just for curiosity compute matrix representations. The matrix \
representations ",
 StyleBox["will not be used",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 " neither for computation of polynomials nor for computation of function"
}], "Text",ExpressionUUID->"f6a4693b-66d1-48c3-8ff1-faac093f91ed"],

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"gaDefineMatrixRepresentation", "[", "testAlgebra", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.942979498551868*^9, 3.942979559443737*^9}, {
   3.944886882794961*^9, 3.9448868873133297`*^9}, 3.944886932590898*^9},
 CellLabel->"In[80]:=",ExpressionUUID->"8dcf6427-a7f6-46a6-8796-e2e41db9d61f"],

Cell["\<\
Generate come multivector and its matrix representation to compare the MV and \
it\[CloseCurlyQuote]s matrix representation\
\>", "Text",ExpressionUUID->"ca7d743e-7b30-4097-8d22-2fd6039eb554"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exampleMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaGeneralMultivector", "[", 
   RowBox[{"a", ",", "testAlgebra"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"exampleMVMatrix", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"gaToMatrixRepresentation", "[", 
     RowBox[{"%", ",", "testAlgebra"}], "]"}]}], ")"}], "//", 
  "MatrixForm"}]}], "Input",
 CellChangeTimes->{{3.942979566257011*^9, 3.94297961613196*^9}, {
   3.94298555543312*^9, 3.94298559499806*^9}, 3.944819220553542*^9},
 CellLabel->"In[81]:=",ExpressionUUID->"a2689861-abee-47f2-b135-36a82ca5ac1e"],

Cell["\<\
Generate some multivector for demonstration. We will intentionally use simple \
defective MV (defective MV is generated from given Jordan block)\
\>", "Text",ExpressionUUID->"ab445a2b-5a3b-42f8-b798-f05e5d9e2f62"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exampleMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaRandomNonDiagonalizableMV", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Matrix\>\"", ",", 
       RowBox[{"\"\<JordanForm\>\"", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "3", ",", "0", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "5", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0", ",", "5"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<TransformationMatrix\>\"", 
        "->", "\"\<IdentityMatrix\>\""}]}], "}"}]}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.944883340484228*^9, 3.944883406677903*^9}, {
   3.944883444734818*^9, 3.944883474058958*^9}, {3.9448835210385303`*^9, 
   3.944883623336903*^9}, {3.944883722003171*^9, 3.9448837549434633`*^9}, {
   3.944883897786221*^9, 3.944883905492846*^9}, {3.9448840427439327`*^9, 
   3.944884048851584*^9}, 3.944884769628319*^9, {3.944885048173232*^9, 
   3.944885052316825*^9}, {3.945150468404731*^9, 3.945150499243702*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"e968a053-1279-4722-a3f3-b58d34774395"],

Cell["Compute characteristic polynomial of example MV", "Text",ExpressionUUID->"ace2cee1-f34b-4d47-9bc2-4ae933d8da4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"charPoly", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaCharacteristicPolynomial", "[", 
    RowBox[{
     RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", "x", ",", 
     RowBox[{"Quiet", "->", "False"}], ",", 
     RowBox[{"Method", "->", "\"\<FaddeevLieVerrierSouriau\>\""}]}], "]"}], "//",
    "Factor"}]}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", "%", "]"}]}], "Input",
 CellLabel->"In[84]:=",ExpressionUUID->"46f20cb7-6898-4c51-9742-a2e55a661f39"],

Cell["Compute minimal polynomial of example MV", "Text",ExpressionUUID->"a35f0346-5873-4ad2-8b13-18dd2e744048"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"minPoly", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaMinimalPolynomial", "[", 
    RowBox[{
     RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", "x", ",", 
     RowBox[{"Quiet", "->", "False"}]}], "]"}], "//", "Factor"}]}], "\[IndentingNewLine]", 
 RowBox[{"Expand", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.942985630235476*^9, 3.9429857054032373`*^9}, {
  3.942985793656993*^9, 3.942985890832952*^9}, {3.942985937242716*^9, 
  3.942985942397533*^9}, {3.9436077948854523`*^9, 3.9436078098590937`*^9}, {
  3.943607840674368*^9, 3.943607847993854*^9}, {3.94360790531017*^9, 
  3.943607906362158*^9}, {3.943607950295269*^9, 3.943607951562285*^9}, {
  3.943608267819016*^9, 3.943608285612199*^9}, {3.943608320880734*^9, 
  3.943608340661482*^9}, {3.943608410312944*^9, 3.943608412827814*^9}, {
  3.944884848172675*^9, 3.94488485259756*^9}, {3.945327646546929*^9, 
  3.9453276480270977`*^9}},
 CellLabel->"In[86]:=",ExpressionUUID->"fccd087c-38a2-4959-adf7-28da440193d2"],

Cell["\<\
Note that minimal polynomial is of smaller degree.  Compute exponential of \
example multivector using the minimal polynomial.\
\>", "Text",ExpressionUUID->"3563d2b0-a3ab-4442-afcf-211c5d8277fb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"minPolyFun", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Function", "@@", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"Expand", "[", 
       RowBox[{"minPoly", "[", "testAlgebra", "]"}], "]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expFromMinPoly", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{"Exp", ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<SpectralBasis\>\"", ",", 
       RowBox[{"\"\<MinimalPolynomial\>\"", "->", 
        RowBox[{"minPolyFun", "[", "testAlgebra", "]"}]}], ",", 
       RowBox[{"\"\<VerifyMinimalPolynomial\>\"", "->", "True"}]}], "}"}]}], ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}]}]}], "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"0455274e-51ac-481d-af13-84e15778e255"],

Cell["\<\
Compute the exponential function of the same example multivector using \
characteristic polynomial.\
\>", "Text",ExpressionUUID->"865c344b-0f79-45c2-a9dd-14813b123393"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"charPolyFun", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Function", "@@", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"Expand", "[", 
       RowBox[{"charPoly", "[", "testAlgebra", "]"}], "]"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expFromCharPoly", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{"Exp", ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<SpectralBasis\>\"", ",", 
       RowBox[{"\"\<MinimalPolynomial\>\"", "->", 
        RowBox[{"charPolyFun", "[", "testAlgebra", "]"}]}], ",", 
       RowBox[{"\"\<VerifyMinimalPolynomial\>\"", "->", "True"}]}], "}"}]}], ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}]}]}], "Input",
 CellLabel->"In[90]:=",ExpressionUUID->"5c66df29-957e-4a8a-8d39-df0dd053c78a"],

Cell["Check that both results are the same", "Text",ExpressionUUID->"bfad2d21-4e1b-454c-a5b9-a390c35a3b12"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"expFromCharPoly", "[", "testAlgebra", "]"}], "-", 
   RowBox[{"expFromMinPoly", "[", "testAlgebra", "]"}]}], "//", 
  "Expand"}]], "Input",
 CellLabel->"In[92]:=",ExpressionUUID->"62ba852c-5353-4774-83e1-79f3bdfa47c1"],

Cell["\<\
Compute the exponential function of the same example multivector using \
product of characteristic and minimal polynomial.\
\>", "Text",ExpressionUUID->"1cc5541a-5b6e-48a0-a3c2-ac62f171dc2a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"charTimesMinimalPolyFunction", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Function", "@@", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{"charPoly", "[", "testAlgebra", "]"}], "*", 
       RowBox[{"minPoly", "[", "testAlgebra", "]"}]}], "]"}]}], 
    "}"}]}]}]], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"2df5f9cd-f91d-4b28-a65b-31ac371b8dd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expFromProductPoly", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{"Exp", ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<SpectralBasis\>\"", ",", 
       RowBox[{"\"\<MinimalPolynomial\>\"", "->", 
        RowBox[{"charTimesMinimalPolyFunction", "[", "testAlgebra", "]"}]}], ",", 
       RowBox[{"\"\<VerifyMinimalPolynomial\>\"", "->", "True"}]}], "}"}]}], ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}]}]], "Input",
 CellLabel->"In[94]:=",ExpressionUUID->"09b8ac0d-e6cb-4325-84cf-c7c77d6a9f5b"],

Cell["Check that the result is the same", "Text",ExpressionUUID->"d59ca1ed-ef70-4665-b5e5-af0b06d54d46"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"expFromMinPoly", "[", "testAlgebra", "]"}], "-", 
   RowBox[{"expFromProductPoly", "[", "testAlgebra", "]"}]}], "//", 
  "Expand"}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"3beb4be0-ffa2-44a7-8cda-6b9fb53480d5"],

Cell["Compute different functions of larger algebra. ", "Text",ExpressionUUID->"d827a726-d207-4de3-98c3-862c716a47e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", " ", "=", " ", 
   RowBox[{"Cl", "[", 
    RowBox[{"5", ",", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", " ", 
   RowBox[{"Quiet", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"289ffc50-cdc3-4cbb-bd53-96bc654ba3c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exampleMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaRandomMultivector", "[", "testAlgebra", "]"}]}]], "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"13f0a33a-4192-4d1c-942d-c74e8f5c5c81"],

Cell["\<\
Compute different functions of larger algebra. Compute inverse of MV\
\>", "Text",ExpressionUUID->"11012333-1069-492d-933f-1938809e55ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "^", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}]}], ")"}], "&"}], ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", "\"\<SpectralBasis\>\""}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "]"}]}]], "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"089f3b5f-63f3-4bc5-8d50-1f447d3f1508"],

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"gaPE", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"theInverseMV", "[", "testAlgebra", "]"}], ",", "20"}], "]"}], 
     "\[GeometricProduct]", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", "20"}], "]"}]}], 
    "]"}], ",", "_\[DoubleStruckE]", ",", "Chop"}], "]"}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"5e12f73b-6d90-4ad2-924b-5a9b2f9112ec"],

Cell["Compute square root of MV", "Text",ExpressionUUID->"3fa435f0-9995-4bf7-8020-62f561158638"],

Cell[BoxData[
 RowBox[{
  RowBox[{"theSqrtMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "^", 
       RowBox[{"(", 
        RowBox[{"1", "/", "2"}], ")"}]}], ")"}], "&"}], ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", "\"\<SpectralBasis\>\""}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"04675e63-6f3e-4386-adef-bea1e2885cd0"],

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"gaPE", "[", 
     RowBox[{
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"theSqrtMV", "[", "testAlgebra", "]"}], ",", "20"}], "]"}], "\[GeometricProduct]", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"theSqrtMV", "[", "testAlgebra", "]"}], ",", "20"}], "]"}]}], 
     "]"}], "-", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", "20"}], "]"}]}], ",",
    "_\[DoubleStruckE]", ",", "Chop"}], "]"}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"0051fb14-d88e-4554-970f-6ce40578f973"],

Cell["Compute logarithm of MV", "Text",ExpressionUUID->"985c7a3c-9081-4bcf-a3fe-4dfbeb40fb87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"theLogMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaFunctionOfMV", "[", 
   RowBox[{"Log", ",", 
    RowBox[{"exampleMV", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Method", "->", "\"\<SpectralBasis\>\""}], ",", 
