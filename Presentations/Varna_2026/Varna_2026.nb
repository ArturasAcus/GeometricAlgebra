 CellLabel->
  "In[103]:=",ExpressionUUID->"7bf6b533-1ac5-400b-a6c3-97562797c2bc"],

Cell["\<\
Compute exponent of numerical value of the answer (should expect to get the \
initial MV)\
\>", "Text",ExpressionUUID->"fb9e8524-44c9-4ea1-bea1-ecfca17a6cda"],

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"gaFunctionOfMV", "[", 
    RowBox[{"Exp", ",", 
     RowBox[{"N", "[", 
      RowBox[{
