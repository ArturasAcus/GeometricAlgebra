Cell["\<\
The most important polynomial is the minimal polynomial. Physicists most \
often use characteristic polyniomial\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 Background->RGBColor[
  0.98, 0.56, 0.17, 
   0.33],ExpressionUUID->"dec4989c-b53b-4431-bf18-c9ae8713b137"],

