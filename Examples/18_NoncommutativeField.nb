Cell["\<\
So, we can use as base algebra Cl(2,0) and as coefficient algebra the algebra \
Cl(0,2) (this is preferable since Cl(0,2) is a noncommutative field, \
quaternions) or use  Cl(0,2)  as base Clifford algebra and Cl(2,0) as field. \
We will use the former possibility. First,  we define basis for initial \
Clifford algebra\
\>", "Text",ExpressionUUID->"58ef2369-1113-43cf-b901-1e13c25f4071"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"basisCl40", "=", 
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{
    RowBox[{"Cl", "[", 
     RowBox[{"4", ",", "0"}], "]"}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "]"}]}]], "Input",
 CellLabel->"In[67]:=",
