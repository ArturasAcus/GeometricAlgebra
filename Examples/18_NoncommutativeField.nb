Cell["\<\
How inner product should act in the tensor product basis.  From example \
below, it is clear that emulation of inner product might be possible, though \
not trivial.\
\>", "Text",ExpressionUUID->"b6b6f1ac-66d7-4186-945d-cd7fc962c0f2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"innerProductFromCL", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"#", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "]"}], "&"}], "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ip", "[", "##", "]"}], ",", 
            RowBox[{"InnerProduct", "[", "##", "]"}]}], "}"}], "&"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}]}], "]"}], ",", "1"}], 
      "]"}]}]}], ")"}], "//", "Length"}]], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"e8bf6888-297e-4591-b9c0-2dc94ce11b31"],

