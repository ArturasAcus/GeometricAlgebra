isomorphism.\"\>",
   "EchoLabel"], "  ", "\<\"\"\>"}]], "Echo",ExpressionUUID->"abb06fac-4b55-\
4cc2-ad71-280e815108e0"],

Cell[BoxData[
 RowBox[{
