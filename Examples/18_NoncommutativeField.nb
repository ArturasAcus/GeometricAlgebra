Cell["\<\
How outer product should act in the tensor product basis.  From example \
below, it is clear that emulation of outer product might be possible\
\>", "Text",ExpressionUUID->"2fe8fa8b-521f-4229-96a4-d27b55ca11e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"outerProductFromCL", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"#", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "]"}], "&"}], "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"op", "[", "##", "]"}], ",", 
            RowBox[{"OuterProduct", "[", "##", "]"}]}], "}"}], "&"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}]}], "]"}], ",", "1"}], 
      "]"}]}]}], ")"}], "//", "Length"}]], "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"46fc87ac-c4bd-495a-8073-72a11927abc8"],

Cell[BoxData["256"], "Output",
 CellLabel->
  "Out[176]=",ExpressionUUID->"092bdf48-5946-43d8-8951-9d8b83d61e09"]
}, Open  ]],

