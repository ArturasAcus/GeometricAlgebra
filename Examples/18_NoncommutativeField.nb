 RowBox[{
  TagBox["\<\"Graph type to construct is: \"\>",
   "EchoLabel"], "  ", "\<\"Directed\"\>"}]], "Echo",ExpressionUUID->\
"a7031e52-0816-40e6-b8ff-c75e836c39cb"],

