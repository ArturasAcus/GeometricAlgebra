  "In[162]:=",ExpressionUUID->"3ef7a7e0-7584-4591-88c8-1dc5b9632a6a"],

Cell["\<\
Now apply isomorphisms to test both answers. GP product seems ok. For other \
products the isomorphism should not exist in general\
\>", "Text",ExpressionUUID->"be054050-93f2-44d0-a265-618c00be02d8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"gaPE", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gp2Cl", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
        RowBox[{"gp2TP", "[", "i", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gp3Cl", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
        RowBox[{"gp3TP", "[", "i", "]"}]}]}], "}"}], "]"}], "//", "Expand"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", 
     RowBox[{"Length", "[", "allIsomorphismsFromCl40", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->
  "In[167]:=",ExpressionUUID->"dcc6e3a1-e2d7-4029-90b4-3432455d1521"],

