         RowBox[{"gp2Cl", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
        RowBox[{"gp2TP", "[", "i", "]"}]}], ",", "\[IndentingNewLine]", 
