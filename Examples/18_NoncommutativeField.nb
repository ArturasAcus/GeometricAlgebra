Cell["\<\
We look for all possible isomorphisms (with scalar and pseudoscalar fixed) by \
making specific graphs for Cayley tables.  The gaFindAlgebraIsomorphism[] \
constructs complete graphs of Cayley table. (unfortunately,  already for n=6 \
search for all isomorphism requires so much memory (>4Tb), that computation \
becomes impossible)\
\>", "Text",
 Editable->True,
 TaggingRules->{},
 CellID->1306067065,ExpressionUUID->"bf652664-1fef-432b-bd02-39fcaa70e9aa"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"allIsomorphismsFromCl40", "=", 
  RowBox[{"gaFindAlgebraIsomorphism", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Rest", "[", "basisCl40", "]"}], "->", 
     RowBox[{"Rest", "[", "tensorProductBasis", "]"}]}], ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"13c63ed7-e251-4a59-892b-e0052f642093"],

