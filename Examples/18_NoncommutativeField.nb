Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"outerProductFromCL", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"#", "/.", 
          RowBox[{"allIsomorphismsFromCl40", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "]"}], "&"}], "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Outer", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"op", "[", "##", "]"}], ",", 
            RowBox[{"OuterProduct", "[", "##", "]"}]}], "}"}], "&"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}], ",", 
         RowBox[{"(", 
          RowBox[{"List", "@@", "genMVCl40"}], ")"}]}], "]"}], ",", "1"}], 
      "]"}]}]}], ")"}], "//", "Length"}]], "Input",
