Cell["\<\
Now apply isomorphisms to test both answers. GP product seems ok. For other \
products the isomorphism should not exist in general\
\>", "Text",ExpressionUUID->"fe080205-6e39-4c1c-9111-c0cbab8a6bcb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"gaPE", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gp2Cl", "/.", 
          RowBox[{"allIsomorphismsFromCl13", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
        RowBox[{"gp2TP", "[", "i", "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gp3Cl", "/.", 
          RowBox[{"allIsomorphismsFromCl13", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "-", 
        RowBox[{"gp3TP", "[", "i", "]"}]}]}], "}"}], "]"}], "//", "Expand"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", 
