Cell["\<\
For other product there is no isomorphism, see the subsection\
\>", "Text",ExpressionUUID->"2d80000e-6d52-492e-947b-f54f996de2f1"],

Cell[CellGroupData[{

Cell["\<\
Experiments that show that for other products (outer product, etc) \
isomorphism construction is problematic (field elements needs its own (field) \
grades,etc.)\
\>", "Subsubsection",ExpressionUUID->"d672026a-f81c-44b7-9a95-54b1161fc401"],

Cell[CellGroupData[{

Cell["\<\
Find how grade negate should act on each of term, them how is inner and outer \
product should act in the tensor product basis. Negating of grade 1 acts with \
different isomorphism rules seems very different\
\>", "Text",ExpressionUUID->"b4b07098-28ea-4c40-9a51-e8294caedbb8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"#", ",", 
     RowBox[{"#", "/.", 
      RowBox[{"allIsomorphismsFromCl40", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"#", "/.", 
      RowBox[{"allIsomorphismsFromCl40", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"#", "/.", 
      RowBox[{"allIsomorphismsFromCl40", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], "&"}], "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"gaGradeNegate", "[", 
      RowBox[{"#", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}], "&"}], "/@", 
    RowBox[{"(", 
     RowBox[{"List", "@@", "genMVCl40"}], ")"}]}], ")"}]}]], "Input",
 CellLabel->
  "In[175]:=",ExpressionUUID->"adb85978-f0c6-474d-afe9-2a84b02b8a05"],

