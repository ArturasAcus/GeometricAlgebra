Cell[CellGroupData[{

Cell["Primitive Clifford algebra idempotents", "Subsection",
 CellChangeTimes->{{3.673769332785334*^9, 3.673769392504071*^9}, {
  3.67376947173848*^9, 3.673769497846831*^9}, {3.673769548025817*^9, 
  3.673769569312313*^9}, {3.673857865702308*^9, 3.673857886324916*^9}, {
  3.674805620008209*^9, 3.674805630889899*^9}, {3.674972444087821*^9, 
  3.674972450415997*^9}, {3.682826056202342*^9, 
  3.682826077738312*^9}},ExpressionUUID->"df348e3c-d2fc-4e71-bb88-\
803c902c21dc"],

Cell[TextData[{
 "If square of the multivector (MV) is equal to itself, i. e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["A", "2"], "=", "A"}], TraditionalForm]],ExpressionUUID->
  "69a89ddd-01d2-4322-a4c0-2272f1584a68"],
 " , the MV is said to be idempotent. An idempotent is primitive if it cannot \
be expressed as a sum of\ntwo idempotents whose geometric product is zero. ",
 "\n",
 "\nNumber of primitive idempotents is given by so called Radon-Hurwitz \
numbers"
}], "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
   3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
   3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
   3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
   3.682826354687271*^9}, 3.682826412079501*^9, 3.682826798848708*^9, 
   3.772866882813699*^9},ExpressionUUID->"8d9e6179-1324-485e-8caf-\
239a41465141"],

Cell[CellGroupData[{

Cell["Radon-Hurwitz numbers", "Subsubsection",
 CellChangeTimes->{
  3.682826150943585*^9},ExpressionUUID->"1eb7a76a-aeab-44c1-b55a-\
64626bdae8f2"],

Cell[TextData[{
 "The number of commuting blades in the primitive idempotent (1.37) is given \
by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"q", "-", 
     SubscriptBox["r", 
      RowBox[{"q", "-", "p"}]]}], ")"}], TraditionalForm]],ExpressionUUID->
  "cd18d253-4cbc-4b4b-b551-cffbcae96b17"],
 ",  where   ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"q", "-", "p"}]], TraditionalForm]],ExpressionUUID->
  "38c2e5b6-97cd-450d-b177-14e75f305228"],
 " denotes Radon-Hurwitz numbers. These numbers can be computed as  a series \
coefficients of generating function ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "x", " ", "+", " ", 
       RowBox[{"x", "^", "3"}], " ", "+", " ", 
       RowBox[{"x", "^", "7"}]}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox["x", "8"]}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"7db4c1a1-42b0-4dbc-aac1-90defdca3213"],
 ", the first coefficients being  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "0"], TraditionalForm]],ExpressionUUID->
  "1d44770f-a843-4163-9c02-0e5cb7cb708a"],
 " = 0, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "1"], TraditionalForm]],ExpressionUUID->
  "124665c1-3945-40db-8b87-90192ea5ee8a"],
 " = 1, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "2"], TraditionalForm]],ExpressionUUID->
  "eddbc002-afd2-4bfd-8f9a-0782620bb65b"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "3"], TraditionalForm]],ExpressionUUID->
  "9402c299-4755-4e1b-a6b7-dff698e4d8fc"],
 " = 2, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "4"], TraditionalForm]],ExpressionUUID->
  "e9526fb7-a52d-4cd0-9fb5-ee3cb5451ff8"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "5"], TraditionalForm]],ExpressionUUID->
  "c63aa5bc-6851-412e-810c-7a46294b3aa8"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "6"], TraditionalForm]],ExpressionUUID->
  "f9e86fb7-10ec-4ccc-9378-323347861ab6"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "7"], TraditionalForm]],ExpressionUUID->
  "382e17a6-a421-4744-b7d4-50ee0028acda"],
 " = 3. Other arguments are handled  by recursive relation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"i", "+", "8"}]], TraditionalForm]],ExpressionUUID->
  "c08794a9-7b55-4942-b81c-4f63bd5216d3"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", "i"], TraditionalForm]],ExpressionUUID->
  "55facbae-0052-4dbd-a916-c519a0aac034"],
 " + 4. Radon-Hurwitz numbers with negative indices  can be calculated with \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "53386b6c-bc6f-4193-868f-d2c8263c4eae"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["r", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "8"}]], TraditionalForm]],ExpressionUUID->
  "821f0fed-0e48-4701-b888-f59a0faeee31"],
 "-4 = -1."
}], "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
  3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
  3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
  3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
  3.682826354687271*^9}, {3.68282639106891*^9, 3.682826396248152*^9}, {
