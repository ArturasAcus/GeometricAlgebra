Cell["\<\
Because the algebras with n=1 are semisimple,  only diagonal representations \
are computed! This differs from Shirokov matrices\
\>", "Text",
 CellChangeTimes->{{3.778585822752432*^9, 3.778585914101428*^9}, {
  3.778585995008116*^9, 3.7785860178319387`*^9}, {3.778586102681272*^9, 
