Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"1", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"MatrixForm", ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"gaDefineMatrixRepresentation", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<IdealBasis\>\"", ",", 
       RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
          
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ",", 
       RowBox[{"\"\<gaNonCommutativeMonomialOrder\>\"", 
        "\[Rule]", "\"\<RevLex\>\""}], ",", 
       RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.778557755401621*^9, 3.778557773566482*^9}, {
   3.778557828914915*^9, 3.7785578486620197`*^9}, {3.77855791938021*^9, 
