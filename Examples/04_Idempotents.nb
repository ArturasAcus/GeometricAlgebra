7609379a8a59"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"allIdempotents", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"(", 
   RowBox[{"Union", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"gaOrderedQ", "[", "\"\<InvDeg[Lex]\>\"", "]"}], "[", 
          RowBox[{"#1", ",", "#2"}], "]"}], "&"}]}], "]"}], "&"}], "/@", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"gaPrimitiveIdempotent", "[", 
          RowBox[{
           RowBox[{"Cl", "[", 
            RowBox[{"2", ",", "2"}], "]"}], ",", 
           RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}]}], ",", 
           RowBox[{
           "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
            "\"\<InvDeg[Lex]\>\""}], ",", 
           RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "1", ",", "5"}], "}"}]}], "]"}], ",", "3"}], 
      "]"}]}], "]"}], ")"}]}]], "Input",
 CellChangeTimes->{{3.682837757930411*^9, 3.68283778147934*^9}, {
   3.682837875639744*^9, 3.682837884108555*^9}, {3.733552575612442*^9, 
