Cell[CellGroupData[{

Cell["All idempotents of algebra", "Subsubsection",
 CellChangeTimes->{
  3.682826150943585*^9, {3.682826837311543*^9, 3.682826839111095*^9}, 
   3.682830188185663*^9, {3.682830240892124*^9, 3.682830250841946*^9}, {
   3.682837442789626*^9, 
   3.682837524617723*^9}},ExpressionUUID->"13ae11ad-542a-4d05-9cc9-\
a8b360f06de1"],

Cell["\<\
Lets construct all possible idempotents of Cl[3,1] algebra. The construction \
here is extremely inefficient. The idea is to start construction from \
arbitrary element {i,j,k,l} and drop all which appear more that once\
\>", "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
   3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
   3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
   3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
   3.682826354687271*^9}, 3.682826412079501*^9, 3.682826798848708*^9, {
   3.682837544633935*^9, 3.682837629203423*^9}, {3.682837660518351*^9, 
   3.682837717212771*^9}},ExpressionUUID->"9afd6859-fdc8-441d-ab44-\
75956daa0964"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"gaOrderedQ", "[", "\"\<InvDeg[Lex]\>\"", "]"}], "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], "&"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gaPrimitiveIdempotent", "[", 
        RowBox[{
         RowBox[{"Cl", "[", 
          RowBox[{"2", ",", "2"}], "]"}], ",", 
         RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}]}], ",", 
         RowBox[{"\"\<OutputForm\>\"", "\[Rule]", "\"\<Blades\>\""}], ",", 
         RowBox[{"\"\<gaNonCommutativeMonomialOrder\>\"", 
          "\[Rule]", "\"\<InvDeg[Lex]\>\""}], ",", 
         RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "5"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "5"}], "}"}]}], "]"}], ",", "3"}], 
    "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.778224477506467*^9, 3.7782244804299097`*^9}, {
   3.778589073056336*^9, 3.7785890907422333`*^9}, 3.940767183572938*^9, 
