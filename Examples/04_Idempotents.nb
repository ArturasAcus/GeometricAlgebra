    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<IdealBasis\>\"", ",", 
       RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
