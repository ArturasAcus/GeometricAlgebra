  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"3", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", 
   RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"MatrixForm", ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"gaDefineMatrixRepresentation", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<IdealBasis\>\"", ",", 
       RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
          
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ",", 
       RowBox[{"\"\<gaNonCommutativeMonomialOrder\>\"", 
        "\[Rule]", "\"\<RevLex\>\""}], ",", 
       RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
       RowBox[{"\"\<gaIdealBasisReordering\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "4", ",", "2", ",", "3"}], "}"}]}], ",", 
       RowBox[{"\"\<gaIdealBasisMultipliers\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "I"}], ",", 
          RowBox[{"-", "I"}], ",", "1"}], "}"}]}]}], "}"}]}]}], 
