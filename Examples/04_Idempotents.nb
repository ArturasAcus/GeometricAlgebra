Cell[TextData[{
 "From general element we see from what idempotents our ideal generator must \
be constructed: (from matrix first element (row 1, col 1) we want idempotent \
to include ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[DoubleStruckE]", "1"], ",", " ", 
    SubscriptBox["\[DoubleStruckE]", 
     RowBox[{"2", ",", "3"}]]}], TraditionalForm]],ExpressionUUID->
  "93cbec2d-342d-41b0-b13a-50246384453f"],
 " or/and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckE]", 
    RowBox[{"1", ",", "2", ",", "3"}]], TraditionalForm]],ExpressionUUID->
  "7ec1e6e6-e44e-4880-94a4-60cd6740ca11"],
 " i.\[DoubleStruckE]. can be seen from coefficients) "
}], "Text",
 CellChangeTimes->{{3.733552637161232*^9, 3.733552673511608*^9}, {
  3.733635778173778*^9, 3.733635797534244*^9}, {3.733635845136204*^9, 
  3.733636040868116*^9}},ExpressionUUID->"67d69877-01bc-4c33-b78b-\
a147380ba72d"],

Cell["\<\
The simple primitive  idempotent of  this algebra are: (Check possibilities)\
\>", "Text",
 CellChangeTimes->{{3.733552637161232*^9, 
