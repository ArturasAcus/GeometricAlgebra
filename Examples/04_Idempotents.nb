           "Complexes"}], ",", 
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ",", 
       RowBox[{
        RowBox[{"\"\<\>\"", "CoefficientDomain", "\"\<\>\""}], "\[Rule]", 
        "Complexes"}]}], "}"}]}]}], "]"}]}]}], "Input",
