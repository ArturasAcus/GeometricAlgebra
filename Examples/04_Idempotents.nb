Cell[BoxData[
 RowBox[{"gaPrimitiveIdempotent", "[", 
  RowBox[{
   RowBox[{"Cl", "[", 
    RowBox[{"2", ",", "2"}], "]"}], ",", 
   RowBox[{"\"\<StartingElement\>\"", "\[Rule]", "2"}], ",", 
   RowBox[{"\"\<OutputForm\>\"", "\[Rule]", "\"\<Blades\>\""}], ",", 
   RowBox[{
   "\"\<gaNonCommutativeMonomialOrder\>\"", "->", "\"\<InvDeg[Lex]\>\""}], 
   ",", 
