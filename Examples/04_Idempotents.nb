Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"2", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", 
   RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"MatrixForm", ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"gaDefineMatrixRepresentation", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<IdealBasis\>\"", ",", 
       RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
          
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ",", 
       RowBox[{
       "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", "\"\<RevLex\>\""}],
        ",", 
       RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
       RowBox[{"\"\<gaIdealBasisReordering\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<gaIdealBasisMultipliers\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}]}], "}"}]}]}], 
   "]"}]}]}], "Input",
