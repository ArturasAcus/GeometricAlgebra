Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"CoefficientList", "[", 
  RowBox[{
   RowBox[{"Normal", "[", 
    RowBox[{"Series", "[", 
     RowBox[{
      RowBox[{"x", "*", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "x", "+", 
          RowBox[{"x", "^", "3"}], "+", 
          RowBox[{"x", "^", "7"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "x"}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"x", "^", "8"}]}], ")"}]}], ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "7"}], "}"}]}], "]"}], "]"}], ",", "x"}], 
  "]"}]], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"355bb05a-4482-425b-bfb0-a1f0737b0d1a"],

