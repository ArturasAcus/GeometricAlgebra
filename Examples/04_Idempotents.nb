Cell[CellGroupData[{

Cell["Arbitrary idempotent construction", "Subsubsection",
 CellChangeTimes->{
  3.682826150943585*^9, {3.682826837311543*^9, 3.682826839111095*^9}, 
   3.682830188185663*^9, {3.682830240892124*^9, 3.682830250841946*^9}, {
   3.682837442789626*^9, 
   3.682837485227756*^9}},ExpressionUUID->"db83b327-8e45-4143-906e-\
861bf08e6211"],

Cell["\<\
Sometimes we don\[CloseCurlyQuote]t want to specify predefined order and want \
to select idempotents step by step. Let\[CloseCurlyQuote]s show how to to it \
for Cl[9,1], and compare at the same time correct typo in  the article of \
Rafal Ablamowicz, \[OpenCurlyDoubleQuote]Construction of spinors via Witt \
decomposition and primitive idempotents: a review, p. 121 in 
@book{crumeyrolle1995clifford,
  title={Clifford Algebras and Spinor Structures: A Special Volume Dedicated \
to the Memory of Albert Crumeyrolle (1919--1992)},
  author={Crumeyrolle, A. and Ablamowicz, R. and Lounesto, P.},
  isbn={9780792333661},
  lccn={94044743},
  series={Mathematics and Its Applications},
  url={https://books.google.lt/books?id=DnyUDg483kEC},
  year={1995},
  publisher={Springer}
}\
\>", "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
   3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
   3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
   3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
   3.682826354687271*^9}, 3.682826412079501*^9, 3.682826798848708*^9, {
   3.68283033406231*^9, 3.682830406827341*^9}, {3.682830485056624*^9, 
   3.682830562377465*^9}, {3.68283103540726*^9, 3.68283103911521*^9}, {
   3.682831135974863*^9, 3.682831211183528*^9}, {3.682831254276382*^9, 
   3.682831267790884*^9}, 
   3.8626453368749857`*^9},ExpressionUUID->"4724245e-9091-4219-a33d-\
502b1b56d608"],

Cell[TextData[{
 "The article provides the following idempotents of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"9", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "d551361b-7b51-4eb8-8db6-7fd611b8248d"],
 ": {\[DoubleStruckE][1]\[MediumSpace],\[DoubleStruckE][2,3,4,5]\[MediumSpace]\
,\[DoubleStruckE][4,5,6,7]\[MediumSpace],\[DoubleStruckE][9,10]\[MediumSpace],\
\[DoubleStruckE][2,3,6,8]\[MediumSpace]}. Let\[CloseCurlyQuote]s check if we \
can construct this idempotent. Option \[OpenCurlyDoubleQuote]StartingElement\
\[CloseCurlyDoubleQuote] now is useful. This option select next element in \
each chose step. So, lets start always selecting the first one"
}], "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
   3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
   3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
   3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
   3.682826354687271*^9}, 3.682826412079501*^9, 3.682826798848708*^9, {
   3.682831290749269*^9, 3.682831471453133*^9}, {3.682831510490862*^9, 
   3.682831510509003*^9}, {3.682831576407548*^9, 3.682831576824749*^9}, {
   3.683626879773478*^9, 3.683626898382064*^9}, 
   3.9407671785822*^9},ExpressionUUID->"e36d3133-a0ca-4f2c-94c0-9e4ea7625643"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"primitiveIdempotent", "[", 
   RowBox[{
    RowBox[{"Cl", "[", 
     RowBox[{"9", ",", "1"}], "]"}], ",", "2"}], "]"}], "=", 
  RowBox[{"gaPrimitiveIdempotent", "[", 
   RowBox[{
    RowBox[{"Cl", "[", 
     RowBox[{"9", ",", "1"}], "]"}], ",", 
    RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
     RowBox[{"{", "1", "}"}]}]}], "]"}]}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10000.},
 CellChangeTimes->{
