Cell["\<\
Because the algebras with n=1 are semisimple,  only diagonal representations \
are computed! This differs from Shirokov matrices\
\>", "Text",
 CellChangeTimes->{{3.778585822752432*^9, 3.778585914101428*^9}, {
  3.778585995008116*^9, 3.7785860178319387`*^9}, {3.778586102681272*^9, 
  3.778586114830288*^9}, {3.778586258482258*^9, 
  3.77858626014881*^9}},ExpressionUUID->"2a63d240-7bf7-429e-baf6-\
e5eda39b62e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"1", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{"MatrixForm", ",", "#"}], "]"}], "&"}], "/@", 
  RowBox[{"gaDefineMatrixRepresentation", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<IdealBasis\>\"", ",", 
       RowBox[{"\"\<gaPrimitiveIdempotent\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Automatic", ",", 
          RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}], ",", 
          
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "}"}]}], ",", 
       RowBox[{
       "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", "\"\<RevLex\>\""}],
        ",", 
       RowBox[{"\"\<CoefficientDomain\>\"", "\[Rule]", "Complexes"}]}], 
      "}"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.778557755401621*^9, 3.778557773566482*^9}, {
   3.778557828914915*^9, 3.7785578486620197`*^9}, {3.77855791938021*^9, 
   3.7785579198232317`*^9}, {3.7785579634194603`*^9, 3.77855801406394*^9}, {
