Cell[CellGroupData[{

Cell["Primitive idempotents", "Subsubsection",
 CellChangeTimes->{
  3.682826150943585*^9, {3.682826837311543*^9, 
   3.682826839111095*^9}},ExpressionUUID->"48ed92bc-dd2b-4510-9147-\
05822560eddb"],

Cell[TextData[{
 "Any primitive idempotent P in GA can be expressed as a product of simple \
idempotents of the form p = (1/2) (1 + B), where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "i"], TraditionalForm]],ExpressionUUID->
  "2414ae07-b3ec-47bb-9051-848c5b1e6ffe"],
 " are basis elements of a particular GA that square to one, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["B", "i"], "2"], TraditionalForm]],ExpressionUUID->
  "8f66a15d-02a1-44b7-9e35-57463a360033"],
 " = 1, and different ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "i"], TraditionalForm]],ExpressionUUID->
  "19e1593e-3d3b-4929-806e-9cadb6714e42"],
 " all pairwise commute, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "i"], TraditionalForm]],ExpressionUUID->
  "e8a09e12-682d-47c3-8027-92f86005b28e"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "j"], TraditionalForm]],ExpressionUUID->
  "a0cb1116-c643-48ba-b9a8-549a9bbad1cd"],
 " - ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "j"], TraditionalForm]],ExpressionUUID->
  "6bca2f43-583d-442b-bf70-550c44874702"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["B", "i"], TraditionalForm]],ExpressionUUID->
  "e7fd9bac-a39a-4d0b-88d7-db4a214f4b26"],
 " = 0."
}], "Text",
 CellChangeTimes->{{3.673769371013993*^9, 3.673769372484621*^9}, {
  3.674660788617659*^9, 3.674660794168119*^9}, {3.681017989424097*^9, 
  3.681018049612899*^9}, {3.682826084153598*^9, 3.682826145542103*^9}, {
  3.682826266020441*^9, 3.682826316844478*^9}, {3.682826348538689*^9, 
  3.682826354687271*^9}, {3.68282639106891*^9, 3.682826396248152*^9}, {
  3.682826844789556*^9, 
  3.682826948315154*^9}},ExpressionUUID->"16e8a08e-d48f-48c5-bc25-\
b492c8582551"],

Cell["\<\
Primitive idempotents are nonunique, so we can introduce some ordering. Lets \
calculate primitive idempotents for Clifford algebras up to p=q=9, with base \
elements ordered by inverse degree lexicographically,  \
\[OpenCurlyDoubleQuote]InvDeg[Lex]\[CloseCurlyDoubleQuote] , i.e. prefer \
lowest grade base elements and when grades are equal, prefer \
lexicographically ordered indices\
\>", "Text",ExpressionUUID->"589c6b6b-b3bd-4872-b5ae-4371de93732f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"primitiveIdempotents", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"gaPrimitiveIdempotent", "[", 
     RowBox[{
      RowBox[{"Cl", "[", 
       RowBox[{"i", ",", "j"}], "]"}], ",", 
      RowBox[{"\"\<StartingElement\>\"", "\[Rule]", "1"}], ",", 
      RowBox[{"\"\<OutputForm\>\"", "\[Rule]", "\"\<Blades\>\""}], ",", 
      RowBox[{
      "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
       "\"\<InvDeg[Lex]\>\""}], ",", 
      RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", "9"}], "}"}], ",", 
    RowBox[{"{", 
