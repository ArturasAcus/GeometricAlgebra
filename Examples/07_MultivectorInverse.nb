 RowBox[{
  RowBox[{"equation", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"thePolynomial", "[", "testAlgebra", "]"}], "=", 
       RowBox[{
        RowBox[{"A1", "\[GeometricProduct]", "A1"}], "-", 
        RowBox[{"2", "\[GeometricProduct]", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "-", 
            RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], ")"}], "\[InnerProduct]",
           "A1"}]}], "-", "2"}]}], ")"}], "//", "gaPE"}], ")"}], "/.", 
   RowBox[{
    RowBox[{"\[DoubleStruckE]", "[", 
     RowBox[{"x_", ",", "_"}], "]"}], ":>", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"any", "[", "x", "]"}], "/.", 
      RowBox[{
       RowBox[{"mvDownUp", "[", 
        RowBox[{
         RowBox[{"{", "z__", "}"}], ",", 
         RowBox[{"{", "}"}]}], "]"}], "\[Rule]", "z"}]}], 
     ")"}]}]}]}]], "Input",
