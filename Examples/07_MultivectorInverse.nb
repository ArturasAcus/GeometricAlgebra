Cell[BoxData[
 RowBox[{
  RowBox[{"versorGoodNoMatrixInverse", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"gaReverse", "[", 
     RowBox[{"versorGood", "[", "testAlgebra", "]"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"gaNorm2ReverseSigned", "[", 
       RowBox[{"versorGood", "[", "testAlgebra", "]"}], "]"}], "//", "gaPE"}],
      ")"}]}], "//", "gaPE"}]}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"57408e34-5e2b-4e7d-bccb-7ae39921a984"],

