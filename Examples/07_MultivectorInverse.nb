   3.714983233277006*^9}},ExpressionUUID->"dae8368a-ae0e-4092-b92b-\
4a291ea87408"],

Cell["\<\
Now, let us take an arbitrary multivector, for example, let us start with \
numeric versor, for which we know how to calculate inverse by geometric \
algebra. For symbolic input computation of determinant will take too much \
time.\
\>", "Text",ExpressionUUID->"5d9a45d3-2975-4765-aaa9-1c16bded4f55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"versorGood", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"(", 
   RowBox[{"GeometricProduct", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"gaGeneralMultivector", "[", 
        RowBox[{"s", ",", "testAlgebra", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "/.", 
       RowBox[{
        RowBox[{"s", "[", "_", "]"}], "\[RuleDelayed]", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}]}], ",", 
      RowBox[{"{", "5", "}"}]}], "]"}]}], ")"}]}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"d623a28c-ce2c-4a9c-8924-a33113ec63f1"],

