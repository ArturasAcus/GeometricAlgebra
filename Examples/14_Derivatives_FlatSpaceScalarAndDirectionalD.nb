Cell[CellGroupData[{

Cell["\<\
14. Scalar and directional derivatives in flat space (changes expected)\
\>", "Section",
 CellChangeTimes->{{3.909712385773182*^9, 3.909712394008655*^9}, {
  3.947915383990211*^9, 
  3.947915396661417*^9}},ExpressionUUID->"5639d113-55fb-4da9-b7b9-\
