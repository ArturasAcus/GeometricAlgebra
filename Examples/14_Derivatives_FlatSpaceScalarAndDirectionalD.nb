Cell[CellGroupData[{

Cell[TextData[{
 "Section 11.61:   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             OverscriptBox["\[Del]", "."]}], ")"}], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{
            StyleBox["k", "TI"], "-", "1"}], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["j", "TI"]], 
         StyleBox["a", "TI"], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "-", "1", "-", 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "(a\\cdot\\dot{\\nabla})\\dot{x}^k=\\sum_{j=0}^{k-1}x^jax^{k-1-j}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb04d601-3afe-422f-b7dd-9679b837889e"]
}], "Subsubsection",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 FontFamily->
  "Microsoft Sans \
Serif",ExpressionUUID->"4e8131b5-4822-4d49-8390-47c6dd0b2e73"],

Cell[TextData[{
 "In all tests below only syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["a", "TI"]], 
             StyleBox["x", "TI"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\partial_a x)\\cdot A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef6b6e3c-0b5b-4391-8035-19c5833a6267"],
 "  for directional derivative is tested. The syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         OverscriptBox["\[Del]", "."], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["x", "TI"], "."], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot\\dot{\\nabla}(\\dot{x}\\cdot A_r)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad9e961b-bbfd-4b34-9395-9dad8ff76bfb"],
 " is introduced (in particular the vector derivative ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Del]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41758cd4-3fef-485c-abba-5e5abf0fdba5"],
 ") in next notebook, which is devoted to vector derivatives. Then inner \
product by  a would always yield the same answer. "
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"31a263ef-29d1-4f28-88ff-ab4c08a81a94"],

