Cell[CellGroupData[{

Cell[TextData[{
 "c) Chain rule for scalar derivative  example 10.2d) p. 305, Handbook ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            StyleBox["d", FontSlant -> "Plain"], 
            SuperscriptBox[
             StyleBox["a", "TI"], "2"], 
            RowBox[{"(", 
              StyleBox["t", "TI"], ")"}]}], 
          RowBox[{
            StyleBox["d", FontSlant -> "Plain"], 
            StyleBox["t", "TI"]}]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox[
              RowBox[{
                StyleBox["a", "TI"], "(", 
                StyleBox["t", "TI"], ")"}], 
              RowBox[{
                StyleBox["d", "TI"], 
                StyleBox["t", "TI"]}]], "\[CenterDot]", 
             SubscriptBox["\[Del]", 
              StyleBox["x", "TI"]]}], ")"}], 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], 
         SubscriptBox["|", 
          RowBox[{
            StyleBox["x", "TI"], "\[Rule]", 
            StyleBox["a", "TI"], 
            RowBox[{"(", 
              StyleBox["t", "TI"], ")"}]}]], "\[Congruent]", 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["a", "TI"], "."], "\[CenterDot]", 
             SubscriptBox["\[Del]", 
              StyleBox["x", "TI"]]}], ")"}], 
         SuperscriptBox[
          StyleBox["x", "TI"], "2"], 
         SubscriptBox["|", 
          RowBox[{
            StyleBox["x", "TI"], "\[Rule]", 
            StyleBox["a", "TI"]}]], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["a", "TI"], "."], 
         StyleBox["a", "TI"], "+", 
         StyleBox["a", "TI"], 
         OverscriptBox[
          StyleBox["a", "TI"], "."], "\[LongEqual]", "2", 
         OverscriptBox[
          StyleBox["a", "TI"], "."], 
         UnderscriptBox[
          StyleBox["a", "TI"], "."]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\frac{\\mathrm{d} a^2(t)}{\\mathrm{d} t}=\\big(\\frac{a(t)}{\\matrm{d}\
\nt}\\cdot\\nabla_x \\big)x^2|_{x\\to\n\
a(t)}\\equiv\\big(\\dot{a}\\cdot\\nabla_x\\big)x^2|_{x\\to\n\
a}=\\dot{a}a+a\\dot{a}=2\\dot{a}\\d a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2df16a51-f92d-4804-bcac-cf598404cd3a"]
}], "Subsubsection",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
