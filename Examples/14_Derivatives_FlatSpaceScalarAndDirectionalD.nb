Cell[TextData[{
 "Section 11.61:   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             OverscriptBox["\[Del]", "."]}], ")"}], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["x", "TI"], "."], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "0"}], 
          RowBox[{
            StyleBox["k", "TI"], "-", "1"}], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["j", "TI"]], 
         StyleBox["a", "TI"], 
         SuperscriptBox[
          StyleBox["x", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "-", "1", "-", 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "(a\\cdot\\dot{\\nabla})\\dot{x}^k=\\sum_{j=0}^{k-1}x^jax^{k-1-j}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb04d601-3afe-422f-b7dd-9679b837889e"]
}], "Subsubsection",
