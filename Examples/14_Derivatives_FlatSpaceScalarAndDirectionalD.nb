Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pointVectorName", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"\"\<OrthonormalCl\>\"", "<>", 
    RowBox[{"ToString", "[", 
     RowBox[{"testAlgebra", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", 
    RowBox[{"ToString", "[", 
     RowBox[{"testAlgebra", "[", 
      RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sampleMV", "[", "testAlgebra", "]"}], "=", 
   RowBox[{
    RowBox[{"gaGeneralMultivector", "[", 
     RowBox[{"x", ",", "testAlgebra", ",", 
      RowBox[{"{", "1", "}"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"x", "[", "in_", "]"}], ":>", 
     RowBox[{"ToExpression", "[", 
      RowBox[{"\"\<x\>\"", "<>", 
       RowBox[{"ToString", "[", "in", "]"}]}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"varsNames", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"gaComponentCoefficientList", "[", 
      RowBox[{"sampleMV", "[", "testAlgebra", "]"}], "]"}], ",", "0"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefinePositionVector", "@@", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"pointVectorName", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"sampleMV", "[", "testAlgebra", "]"}], ",", 
         RowBox[{"Element", "[", 
          RowBox[{
           RowBox[{"varsNames", "[", "testAlgebra", "]"}], ",", "Reals"}], 
          "]"}]}], "}"}], "}"}], ",", "$Failed"}], "]"}], ",", 
    RowBox[{"varsNames", "[", "testAlgebra", "]"}], ",", 
    RowBox[{"{", "}"}], ",", 
    RowBox[{"Quiet", "->", "True"}]}], "}"}]}]}], "Input",
 CellLabel->"In[76]:=",ExpressionUUID->"f82fccf5-f558-4afc-bb7d-5d8667c97fcd"],

