Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"lhsInp1", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"gaDirectionalDerivative", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"gaFunctionOfMV", "[", 
         RowBox[{"Exp", ",", 
          RowBox[{"xOPb", "[", "]"}], ",", 
          RowBox[{"Method", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<SpectralBasis\>\"", ",", 
             RowBox[{"\"\<CoefficientDomain\>\"", "->", "Reals"}]}], "}"}]}], 
          ",", 
          RowBox[{"Expand", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"gaPE", "[", "#", "]"}], "]"}], "&"}], ")"}]}], ",", 
          RowBox[{"Quiet", "->", "True"}]}], "]"}], ",", 
        RowBox[{
         RowBox[{"\[DoubleStruckE]", "[", "__", "]"}], "[", "_", "]"}], ",", 
        "Expand"}], "]"}], ",", 
      RowBox[{"a", "[", "]"}]}], "]"}]}], ")"}], "//", "LeafCount"}]], "Input",\

 Evaluatable->False,
