Cell[TextData[{
 "In all tests below only syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["a", "TI"]], 
             StyleBox["x", "TI"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\partial_a x)\\cdot A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e53ac0bd-b6a3-49a4-b942-17e6bd00c908"],
 "  for directional derivative is tested. The syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         OverscriptBox["\[Del]", "."], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["x", "TI"], "."], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot\\dot{\\nabla}(\\dot{x}\\cdot A_r)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c058fb09-0529-4034-8051-c04b19733580"],
 " is introduced (in particular the vector derivative ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Del]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf5a7d54-373d-42fa-a8fb-3d76e7015942"],
 ") in next notebook, which is devoted to vector derivatives. Then inner \
product by  a would always yield the same answer. "
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"6581ae2b-ba55-415f-9d40-14a4c8c2843a"],

Cell[CellGroupData[{

Cell[TextData[{
 "Section 11.54: equivalence  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             OverscriptBox["\[Del]", "."]}], ")"}], 
         OverscriptBox[
          StyleBox["F", "TI"], "."], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["F", "TI"], "."], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             OverscriptBox["\[Del]", "."]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(a\\cdot \\dot{\\nabla}) \\dot{F}(x)=\\dot{F}(x)(a\\cdot \
\\dot{\\nabla})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6845ba5f-b72d-4848-b6f9-9bcb2a7ca97c"]
}], "Subsubsection",
