   RowBox[{
    RowBox[{"gaToDirectionalDerivative", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", "]"}], "\[InnerProduct]", 
       RowBox[{
        RowBox[{"gaMultivectorDerivative", "[", "\"\<t1\>\"", "]"}], "[", 
        RowBox[{"gaReciprocalVectors", "[", "gaRunningCoordinateChart", "]"}],
         "]"}]}], "\[GeometricProduct]", 
      RowBox[{
       RowBox[{"gaDerivativeArgument", "[", "\"\<t1\>\"", "]"}], "[", 
       RowBox[{"F", "[", 
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"a", ",", "gaRunningCoordinateChart"}], "]"}], "]"}], 
       "]"}]}], "]"}], "//", "gaIndexDown"}], "//", "gaPE"}]}]], "Input",
