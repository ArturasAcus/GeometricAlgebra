Cell[TextData[{
 "Example of 2D Polar coordinate system. ",
 StyleBox["Note, ",
  FontColor->RGBColor[1, 0.5, 0]],
 "when working in flat space most of gaDefineCoordinateChart[ ] computed \
properties are trivial. They are only introduced here to reveal general \
approach we will try to implement for computation on general manifolds."
}], "Text",
