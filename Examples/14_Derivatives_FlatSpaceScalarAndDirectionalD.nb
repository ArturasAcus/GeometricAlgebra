Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<SphericalCoordinates4D\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "*", "r", "*", 
          RowBox[{"Cos", "[", "\[CurlyPhi]1", "]"}]}], "+", 
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "*", "r", "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}], "*", 
          RowBox[{"Cos", "[", "\[CurlyPhi]2", "]"}]}], "+", 
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "3", "]"}], "*", "r", "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}], "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]2", "]"}], "*", 
          RowBox[{"Cos", "[", "\[CurlyPhi]3", "]"}]}], "+", 
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "4", "]"}], "*", "r", "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]1", "]"}], "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]2", "]"}], "*", 
          RowBox[{"Sin", "[", "\[CurlyPhi]3", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", ">", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]1", "<", "Pi"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]2", "<", "Pi"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]3", "<", 
           RowBox[{"2", "Pi"}]}], ")"}]}]}], "}"}], "}"}], ",", "$Failed"}], 
    "]"}], ",", 
   RowBox[{"{", 
