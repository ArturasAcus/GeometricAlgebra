Cell[CellGroupData[{

Cell[TextData[{
 "Section 11.60: equivalence  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             OverscriptBox["\[Del]", "."]}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["x", "TI"], "."], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["a", "TI"]], 
             StyleBox["x", "TI"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(a\\cdot\\dot{\\nabla})(\\dot{x}\\cdot A_r)=(\\partial_a x)\\cdot A_r=a\
\\cdot A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0072f15d-c931-4c42-bd32-98e3da553ed3"]
}], "Subsubsection",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 FontFamily->
  "Microsoft Sans \
Serif",ExpressionUUID->"73caea5a-472a-47f6-b038-eab0171d3f10"],

Cell[TextData[{
 "In all tests below only syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[PartialD]", 
              StyleBox["a", "TI"]], 
             StyleBox["x", "TI"]}], ")"}], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\partial_a x)\\cdot A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dfb2d71-ccfd-4298-98b2-50b13ef3f92f"],
 "  for directional derivative is tested. The syntax ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         OverscriptBox["\[Del]", "."], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["x", "TI"], "."], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot\\dot{\\nabla}(\\dot{x}\\cdot A_r)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67a194c3-ca60-41e1-ab29-d2720b13ffa3"],
 " is introduced (in particular the vector derivative ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Del]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\nabla", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0c8f87d-e031-48ac-8067-3fe86108cc69"],
 ") in next notebook, which is devoted to vector derivatives. Then inner \
product by  a would always yield the same answer. "
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"4a0dadf9-afe1-4d53-841f-93c5b809ffd3"],

