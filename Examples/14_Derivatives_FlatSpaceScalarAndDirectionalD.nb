Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{"gaPE", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "[", "]"}], "\[GeometricProduct]", 
            RowBox[{"a1", "[", "]"}]}], ")"}], "\[InnerProduct]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "[", "]"}], "\[GeometricProduct]", 
            RowBox[{"a", "[", "]"}]}], ")"}]}], "\[GeometricProduct]", 
         RowBox[{
          RowBox[{"Sinh", "[", 
           RowBox[{"xOPbMod", "[", "]"}], "]"}], "/", 
          RowBox[{"xOPbMod", "[", "]"}]}]}], "+", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "[", "]"}], "\[GeometricProduct]", 
            RowBox[{"a1", "[", "]"}]}], ")"}], "\[InnerProduct]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"b", "[", "]"}], "\[GeometricProduct]", 
            RowBox[{"a", "[", "]"}]}], ")"}]}], "\[GeometricProduct]", 
         RowBox[{
