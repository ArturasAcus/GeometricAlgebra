Cell[CellGroupData[{

Cell["14. Scalar and directional derivatives in flat space", "Section",
 CellChangeTimes->{{3.909712385773182*^9, 3.909712394008655*^9}, {
  3.947915383990211*^9, 3.947915396661417*^9}, {3.9735606976249743`*^9, 
  3.973560697789214*^9}},ExpressionUUID->"5639d113-55fb-4da9-b7b9-\
186f71daf336"],

Cell[TextData[{
 "Version  ",
 StyleBox["(2025-11-28). Evaluate the notebook interactively cell by cell \
(can choose different coordinate systems).",
  FontSize->16]
}], "Text",
 CellChangeTimes->{{3.9110160882608624`*^9, 3.9110160904528313`*^9}, {
  3.946535706170554*^9, 3.946535712823574*^9}, {3.946606479981455*^9, 
  3.946606480630538*^9}, {3.946691538526425*^9, 3.946691540066251*^9}, {
  3.947736979508074*^9, 3.947736982987924*^9}, {3.947900415726549*^9, 
  3.94790041815661*^9}, {3.973560674979876*^9, 
  3.973560782953043*^9}},ExpressionUUID->"b4c01c39-810b-4f9e-90c8-\
5d28f6cda267"],

Cell["\<\
Note. Since we plan to  go to curved space in the development process we want \
to test that functions can be generalised to more general context. Therefore \
in the initial stage of  development we will  flat and curved coordinate \
system. Then this notebook will be divided to restrict to flat spaces only. \
\>", "Text",
 CellChangeTimes->{{3.8762225617209597`*^9, 3.8762225693981647`*^9}, {
  3.87690204534286*^9, 3.87690204866451*^9}, {3.877140604213121*^9, 
  3.877140606209826*^9}, {3.88785297747027*^9, 3.8878529850008087`*^9}, {
  3.8878618240181093`*^9, 
  3.887862078143811*^9}},ExpressionUUID->"66a62ce9-24aa-49f9-a82d-\
720a203ccbe8"],

Cell[CellGroupData[{

