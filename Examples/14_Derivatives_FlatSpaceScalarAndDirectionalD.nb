Cell[BoxData[
 RowBox[{"gaDefinePositionVector", "[", 
  RowBox[{"\"\<Polar\>\"", ",", 
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Rho]", "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "\[GeometricProduct]", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"\[DoubleStruckE]", "[", 
            RowBox[{"1", ",", "2"}], "]"}], "\[GeometricProduct]", 
           "\[CurlyPhi]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Rho]", ">=", "0"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{"0", "<=", "\[CurlyPhi]", "<", 
           RowBox[{"2", "*", "Pi"}]}], ")"}]}]}], "}"}], "}"}], ",", 
     "False"}], "]"}], ",", 
   RowBox[{"{", 
