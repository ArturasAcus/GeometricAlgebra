Cell[TextData[{
 "Question: Having both formulas ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[Del]", "."], 
         OverscriptBox[
          StyleBox["exp", FontSlant -> "Plain"], "."], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], "\[Wedge]", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\dot{\\nabla}\\dot{\\mathrm{exp}}(x\\wedge b)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe8f9a3c-5a25-4caf-a469-be5bbd1db9df"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[CenterDot]", "\[Del]"}], ")"}], "."], 
         OverscriptBox[
          StyleBox["exp", FontSlant -> "Plain"], "."], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], "\[Wedge]", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(a\\cdot\\dot{\\nabla)\\dot{\\mathrm{exp}}(x\\wedge b)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a11bf77-2ff6-4173-a90e-b6dd50d81f08"],
 "  is it possible using Sobczyk\[CloseCurlyQuote]s definition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[PartialD]", 
          StyleBox["x", "TB"]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             SubscriptBox["\[PartialD]", 
              StyleBox["x", "TB"]]}], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], 
         FractionBox["\[PartialD]", 
          RowBox[{"\[PartialD]", 
            SuperscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["i", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\partial_{\\bf x}=\\sum_{i=1}^n e^i (e_i \\cdot \\partial_{\\bf \
x}})=\\sum_{i=1}^n e^i \\frac{\\partial}{\\partial x^i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "458037cd-b157-4163-a994-4bc7e31c52d6"],
 " that one result can be obtained from the other by using geometric \
product?"
}], "Text",
 Background->RGBColor[
  1, 0.5, 0],ExpressionUUID->"1fd5bcec-74df-4a6a-8684-ad5ccb319be1"],

