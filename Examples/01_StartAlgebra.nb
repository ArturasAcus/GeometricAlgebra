   3.67384748908961*^9, 3.673847491281632*^9}, {3.67385142912274*^9, 
   3.673851598056488*^9}, {3.673853779327727*^9, 3.673853894673892*^9}, {
   3.674572876647315*^9, 3.674572879376561*^9}, {3.681800516421155*^9, 
   3.681800607299685*^9}, {3.681800651589118*^9, 3.681800792305418*^9}, {
   3.682048589637787*^9, 3.682048621707836*^9}, 
   3.775786865181481*^9},ExpressionUUID->"194f53f0-a88a-4367-80fe-\
697a09618bcf"],

