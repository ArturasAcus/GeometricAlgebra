Cell[TextData[{
 "One can work, however, with many algebras simultaneously. If we defined a \
number of different Clifford algebras and then want that e[.. ] input will be \
understood as, say ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", "30"], TraditionalForm]],ExpressionUUID->
  "5f8864aa-7193-4102-a651-a75127f6d288"],
 "  and not ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", "20"], TraditionalForm]],ExpressionUUID->
  "1ae70087-63d4-4027-b647-179d5698c53b"],
 " algebra we should declare explicitly with ",
 StyleBox["gaDefineInput[ ]",
  FontWeight->"Bold"],
 " command"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
   3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
