Cell[TextData[{
 "For example, left contraction takes precedence over outer product. Input \
contractions ",
 StyleBox["as ",
  FontColor->GrayLevel[0]],
 " \[EscapeKey]il\[EscapeKey] and  \[EscapeKey]ir\[EscapeKey], "
}], "Text",
