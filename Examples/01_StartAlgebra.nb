Cell[TextData[{
 "In order to be able to compare lengths of null vectors we define ",
 StyleBox["spinorial",
  FontSlant->"Italic"],
 " norm as sum of squares of coefficients of all coordinates of multivector \
by command ",
 StyleBox["gaNormOfCoefficients[ ]",
  FontWeight->"Bold"]
