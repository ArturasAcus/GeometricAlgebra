Cell[CellGroupData[{

Cell["Product precedences", "Subsection",
 CellChangeTimes->{{3.673769332785334*^9, 3.673769392504071*^9}, {
  3.67376947173848*^9, 3.673769497846831*^9}, {3.673769548025817*^9, 
  3.673769569312313*^9}, {3.673857865702308*^9, 
  3.673857928038078*^9}},ExpressionUUID->"aa15a670-d635-4502-a964-\
59f2a42f5af7"],

Cell["\<\
Literature about geometric algebra introduces three main products: geometric, \
outer and inner. It is always assumed that geometric product has lowest \
precedence. The precedences of the other two in the literature differ. Here \
we will follow convention that inner product has precedence over outer \
product. So  \[DoubleStruckE][2]\[OuterProduct]\[DoubleStruckE][1]\
\[InnerProduct]\[DoubleStruckE][1]=\[DoubleStruckE][2]\[OuterProduct](\
\[DoubleStruckE][1]\[InnerProduct]\[DoubleStruckE][1])\
\>", "Text",
 CellChangeTimes->{{3.531215444705543*^9, 3.531215453183996*^9}, {
   3.531215728886285*^9, 3.531215752489262*^9}, {3.531215819529191*^9, 
