Cell[TextData[{
 "If multivectors consist of sums of basis elements, after their \
multiplication the  product expression is not automatically  expanded. One \
can expand the  expressions with ",
 StyleBox["gaPE[ ]",
  FontWeight->"Bold"],
 " command. For instance, "
}], "Text",
