Cell[TextData[{
 "The versor is the multivector that consists of  geometric product of \
vectors.  When calculating with versors, which  generally are not homogeneous \
blades and have interpretation as GA transformation, their magnitude always \
become real only for geometric product of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["M", "~"], "M"}], TraditionalForm]],ExpressionUUID->
  "c1db05b1-d1a6-48eb-8e67-e39d66d0c63c"],
 ":"
}], "Text",ExpressionUUID->"89462af3-239f-4cf0-83ae-0c5ed8bc2440"],

