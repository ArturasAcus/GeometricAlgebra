Cell[TextData[{
 "Now input e[1,...] is understood as orthonormal base symbol. Indices ",
 StyleBox["should",
  FontSlant->"Italic"],
 " be always given in ",
 StyleBox["INCREASING",
  FontSlant->"Italic"],
 " order. Below we present a bunch of convenient ways to input base elements \
(meaning of upper indices will be considered in other usage examples).  "
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
   3.673770498050648*^9, 3.673770512428942*^9}, {3.673770959266754*^9, 
