Cell[TextData[{
 "We use ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " ",
 StyleBox["$PreRead",
  FontWeight->"Bold"],
 " substitution mechanism for orthogonal base symbol input. The base vector \
can be input typing e[ ...] (the \[ThinSpace]\[OpenCurlyDoubleQuote]e\
\[CloseCurlyDoubleQuote] symbol  can be changed by modifying installation \
options).   Input will always match the algebra assigned to variable ",
 StyleBox["gaRunningAlgebra",
  FontWeight->"Bold"],
 " (almost all package commands begin with gaThenCommandName)"
}], "Text",
 CellChangeTimes->{{3.67376951349532*^9, 3.673769543889651*^9}, {
   3.6737695866194*^9, 3.67376991194879*^9}, {3.673770122069887*^9, 
   3.673770122392071*^9}, {3.674572591634492*^9, 3.674572623829303*^9}, {
   3.674572668022592*^9, 3.674572739665673*^9}, {3.68120058156419*^9, 
   3.681200583939498*^9}, 3.681800456381704*^9, {3.682048293904862*^9, 
   3.68204841202296*^9}, {3.682048454022195*^9, 3.682048569826245*^9}, {
   3.907642175824621*^9, 
   3.907642191804966*^9}},ExpressionUUID->"338f73ef-6ae3-4db7-b71f-\
3e809b1e1297"],

