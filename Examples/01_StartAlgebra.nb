Cell[TextData[{
 "The result is easy to check. Indeed,  if with the standard determinant \
command ",
 StyleBox["Det[ ]",
  FontWeight->"Bold"],
 " is used to  calculate the area of 3\[DoubleStruckE][1,2]-2e[1,4] = \
\[DoubleStruckE][1]\[OuterProduct](3e[2]-2e[4]) we get"
}], "Text",
