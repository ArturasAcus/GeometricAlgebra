Cell[TextData[{
 "The ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " command ",
 StyleBox["Outer[ ] ",
  FontWeight->"Bold"],
 "should not be confused with geometric algebra command ",
 StyleBox["OuterProduct[ ]",
  FontWeight->"Bold"],
 ", denoted as wedge \[Wedge]."
}], "Text",
