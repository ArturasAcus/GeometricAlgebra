Cell[BoxData[{
 RowBox[{
  RowBox[{"gaDefinePositionVector", "[", 
   RowBox[{"\"\<Example45\>\"", ",", 
    RowBox[{"Piecewise", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "+", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "*", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ",", 
          RowBox[{"Element", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", "Reals"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "+", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "-", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "/", "b"}], ")"}], "*", 
            RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ",", 
          RowBox[{"Element", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", "Reals"}], "]"}]}], "}"}]}],
