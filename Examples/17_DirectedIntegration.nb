Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaSameOrientationQ", "[", 
     RowBox[{"originalSpaceForm_", ",", "parametrizationName_String", ",", 
      RowBox[{"primaryAlgebra_Cl", "->", "pullBackAlgebra_Cl"}], ",", 
      RowBox[{"primaryVariables_List", "->", "pullBackVariables_List"}], ",", 
      
      RowBox[{"op", ":", 
       RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], "[", 
    "theCheckPoint_mvPoint", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "theOption", ",", "numberOfPatches", ",", "primaryVectors", ",", 
       "thePatchNameList", ",", "lenghtPatches", ",", 
       "replacementFromParametrizationList", ",", 
       "pointsInParametrizationVariablesAll", ",", 
       "pointsInParametrizationVariables", ",", 
       "formValuesAtGivenPointForEachPatch"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"gaSetNamedOptionValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"gaSameOrientationQ", ",", "#", ",", "theOption"}], "}"}], 
          ",", 
          RowBox[{
           RowBox[{"gaOptionCheck", "[", "testOptionSameOrientationQ", "]"}], 
           "[", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"OptionValue", "[", "#", "]"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"s_Symbol", ",", "y___Rule"}], "}"}], ":>", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"ToString", "[", "s", "]"}], ",", "y"}], "}"}]}], 
              "}"}]}], ")"}], "]"}], ",", 
          RowBox[{"Quiet", "\[Rule]", "True"}]}], "\[IndentingNewLine]", 
         "]"}], "&"}], "/@", 
       RowBox[{"(", 
        RowBox[{"Flatten", "[", 
         RowBox[{"First", "/@", 
          RowBox[{"{", "op", "}"}]}], "]"}], ")"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "]"}], "===", 
         "theOption"}], ",", 
        RowBox[{
         RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"\"\<Quiet\>\"", "/.", 
             RowBox[{"Options", "[", "gaPullBack", "]"}]}], ")"}], "/.", 
           RowBox[{"{", 
            RowBox[{"\"\<Quiet\>\"", "->", "False"}], "}"}]}], ")"}]}]}], 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "check", " ", "if", " ", "parametrization", " ", "is", " ", 
        "defined"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
          "]"}], "===", "gaPositionVector"}], ",", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{
           RowBox[{"gaPullBack", "::", "UndefinedParametrization"}], ",", 
           "parametrizationName"}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "check", " ", "if", " ", "names", " ", "of", " ", "parametrization", "  ",
         "and", " ", "all", " ", "dimensions", " ", "match"}], " ", "*)"}], 
      " ", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
            "[", "\"\<ManifoldName\>\"", "]"}], "=!=", 
           "parametrizationName"}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{"pullBackVariables", "=!=", 
           RowBox[{
            RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
            "[", "\"\<StandardCoordinateNames\>\"", "]"}]}], ")"}], "||", " ", 
         RowBox[{"(", 
          RowBox[{"primaryAlgebra", "=!=", 
           RowBox[{
            RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
            "[", "\"\<GA\>\"", "]"}]}], ")"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"gaPullBack", "::", "DataInconsistency"}], ",", 
          RowBox[{"primaryAlgebra", "->", "pullBackAlgebra"}], ",", 
          RowBox[{"primaryVariables", "->", "pullBackVariables"}], ",", 
          RowBox[{
           RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
           "[", "\"\<StandardCoordinateNames\>\"", "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"numberOfPatches", "=", 
       RowBox[{
        RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
        "[", "\"\<Patches\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"primaryVectors", "=", 
       RowBox[{"gaOrthonormalBasis", "[", 
        RowBox[{"primaryAlgebra", ",", "gaRunningOrdering", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"thePatchNameList", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\"\<Patch\>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}]}], ")"}], "&"}], "/@", 
         RowBox[{"Range", "[", "numberOfPatches", "]"}]}], ")"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"GeometricAlgebra`p`printDetails", "[", 
       RowBox[{
        RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<The primary variables:\>\"", ",", 
            "primaryVariables"}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Parametrization variables:\>\"", ",", 
            "pullBackVariables"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<The parameter assumptions:\>\"", ",", 
            RowBox[{
             RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
             "[", "\"\<ParameterRangeAssumptions\>\"", "]"}]}], "}"}]}], 
         "}"}]}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "see", " ", "example", " ", "p53", " ", "in", " ", "Bachman", " ", "A",
         " ", "Geometric", " ", "Approach", " ", "to", " ", "Differential", " ",
         "Forms", " ", "for", " ", "implementation", " ", "steps"}], " ", 
       "*)"}], " ", "\[IndentingNewLine]", 
      RowBox[{"replacementFromParametrizationList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"Rule", "[", 
           RowBox[{"primaryVariables", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
        
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"gaComponentCoefficientList", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"gaPositionVector", "[", "parametrizationName", "]"}], 
               "[", "#", "]"}], "[", "\"\<PointVector\>\"", "]"}], ",", 
             "primaryVectors", ",", 
             RowBox[{"\"\<FullBasis\>\"", "->", "True"}]}], "]"}], "&"}], "/@",
           "thePatchNameList"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"GeometricAlgebra`p`printDetails", "[", 
       RowBox[{
        RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<The replacement from parametrization list:\>\"", ",", 
           "replacementFromParametrizationList"}], "}"}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "find", " ", "parameters", " ", "that", " ", "correspond", " ", "to", 
         " ", "given", " ", 
         RowBox[{"point", ":", " ", "note"}]}], ",", " ", 
        RowBox[{"we", " ", 
         RowBox[{"don", "'"}], "t", " ", "check", " ", "if", " ", "it", " ", 
         "possible", " ", "to", " ", "find", " ", "them"}], ",", " ", 
        RowBox[{
        "needs", " ", "further", " ", "work", " ", "if", " ", "function", " ",
          "will", " ", "proof", " ", "useful"}]}], " ", "*)"}], " ", 
      "\[IndentingNewLine]", 
      RowBox[{"pointsInParametrizationVariablesAll", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Last", "/@", "#"}], ")"}], "==", 
               RowBox[{"theCheckPoint", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", 
             "pullBackVariables"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"C", "[", "_", "]"}], ":>", "0"}], "}"}]}], ")"}], "&"}],
         "/@", "replacementFromParametrizationList"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GeometricAlgebra`p`printDetails", "[", 
       RowBox[{
        RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<All solutions of parameters :\>\"", ",", 
           "pointsInParametrizationVariablesAll"}], "}"}], "}"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Length", "/@", "pointsInParametrizationVariablesAll"}], ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", ">=", "1"}], "&"}], ")"}]}], "]"}], ",", 
        RowBox[{"pointsInParametrizationVariables", "=", 
         RowBox[{"First", "/@", "pointsInParametrizationVariablesAll"}]}], ",", 
        RowBox[{
         RowBox[{
         "Print", 
          "[", "\"\<Failed to find parameters that matches given point. Not a \
manifold point?\>\"", "]"}], ";", " ", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"GeometricAlgebra`p`printDetails", "[", 
       RowBox[{
        RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          
          RowBox[{"\"\<The parameters (for each patch) that matches the given \
point:\>\"", ",", "pointsInParametrizationVariables"}], "}"}], "}"}]}], "]"}],
       ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "compute", " ", "given", " ", "form", " ", "value", " ", "on", " ", 
         "all", " ", "patches"}], ",", " ", 
        RowBox[{"should", " ", "be", " ", "a", " ", "number", " ", "now"}]}], 
       " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"formValuesAtGivenPointForEachPatch", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"gaDifferentialFormValueOnVectorList", "[", 
          RowBox[{"originalSpaceForm", ",", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"inp", ",", 
               RowBox[{"Dot", "[", 
                RowBox[{"inp", ",", "primaryVectors"}], "]"}]}], "]"}], "/@", 
             
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{"dif", ",", 
                  RowBox[{"D", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"Last", "/@", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], ",", "dif"}], 
                   "]"}]}], "]"}], "/@", 
                RowBox[{"(", 
                 RowBox[{"First", "/@", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "/.", 
               RowBox[{"(", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ")"}]}], ")"}]}], ")"}]}], 
          "]"}], "&"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
          "replacementFromParametrizationList", ",", 
           "pointsInParametrizationVariables"}], "}"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"GeometricAlgebra`p`printDetails", "[", 
       RowBox[{
        RowBox[{"theOption", "[", "\"\<Quiet\>\"", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<Computed form values without expansion :\>\"", ",", 
            "formValuesAtGivenPointForEachPatch"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Computed form values after expansion :\>\"", ",", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", "formValuesAtGivenPointForEachPatch", "]"}],
              "]"}]}], "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"AllTrue", "[", 
       RowBox[{
        RowBox[{"gaPE", "[", "formValuesAtGivenPointForEachPatch", "]"}], ",",
         "Positive"}], "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}]], "Input",
