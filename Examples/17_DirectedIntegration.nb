     RowBox[{"testOptionSameOrientationQ", "[", "\"\<Quiet\>\"", "]"}], 
     "=", "\"\<True|False\>\""}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"actual", " ", "test"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"testOptionSameOrientationQ", "[", 
      RowBox[{"\"\<Quiet\>\"", ",", "val_"}], "]"}], ":=", 
     RowBox[{"BooleanQ", "[", "val", "]"}]}], ";"}], "\[IndentingNewLine]", 
