Cell[BoxData[
 RowBox[{"jootAnswer1", "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"a", ",", "testAlgebra", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], "+", 
        RowBox[{"2", "*", 
         RowBox[{"gaGeneralMultivector", "[", 
          RowBox[{"b", ",", "testAlgebra", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "*", "t"}]}], ")"}], "\[GeometricProduct]", 
      RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "\[GeometricProduct]", 
      RowBox[{"gaFunctionOfMV", "[", 
       RowBox[{"Exp", ",", 
        RowBox[{
         RowBox[{"\[DoubleStruckE]", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], "\[GeometricProduct]", "t"}]}], 
       "]"}]}], "+", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"gaGeneralMultivector", "[", 
          RowBox[{"a", ",", "testAlgebra", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "*", "t"}], "-", 
        RowBox[{"2", "*", 
         RowBox[{"gaGeneralMultivector", "[", 
          RowBox[{"b", ",", "testAlgebra", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}]}], "+", 
        RowBox[{
         RowBox[{"gaGeneralMultivector", "[", 
          RowBox[{"b", ",", "testAlgebra", ",", 
           RowBox[{"{", "1", "}"}]}], "]"}], "*", 
         RowBox[{"t", "^", "2"}]}]}], ")"}], "\[GeometricProduct]", 
      RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "\[GeometricProduct]", 
      RowBox[{"gaFunctionOfMV", "[", 
       RowBox[{"Exp", ",", 
        RowBox[{
         RowBox[{"\[DoubleStruckE]", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", 
           RowBox[{"{", "}"}]}], "]"}], "\[GeometricProduct]", "t"}]}], 
       "]"}]}]}], "//", "gaPE"}], "//", "Expand"}]}]], "Input",
