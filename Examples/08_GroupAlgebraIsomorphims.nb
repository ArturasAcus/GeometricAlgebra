Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], 
              "\[Rule]", "\"\<Pauli[1,2]\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.779776067414673*^9, 3.779776072015008*^9}, 
