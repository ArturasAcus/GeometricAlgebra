   RowBox[{"namesList", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\"\<su\>\"", "<>", 
      RowBox[{"ToString", "[", "i", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"baseMatrixList", "[", "testAlgebra", "]"}], "]"}]}], "}"}]}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"(", 
  RowBox[{
   RowBox[{"nameAndMatrixList", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Thread", "[", 
