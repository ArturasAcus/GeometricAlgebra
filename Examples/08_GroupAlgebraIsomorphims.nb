        RowBox[{"(", 
         RowBox[{
          RowBox[{"\"\<Grades\>\"", "/.", 
           RowBox[{"{", "opts", "}"}]}], "/.", 
          RowBox[{"Options", "[", 
           RowBox[{
           "gaAlgebraMultiplicationTableGraph", ",", "\"\<Grades\>\""}], 
           "]"}]}], ")"}]}], ",", 
       RowBox[{"selectedBE", "=", 
        RowBox[{"gaOrthonormalBasis", "[", "al", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Switch", "[", 
      RowBox[{"grades", ",", "All", ",", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "the", " ", "more", " ", "exact", " ", "way", " ", "would", " ", 
          "be", " ", "to", " ", "use", " ", "generalised", " ", "commented", " ",
           "graphs", " ", "unfortunatelly", " ", "isomorhism", " ", "for", " ",
           "them", " ", "is", " ", "not", " ", 
          RowBox[{"implemented", ".", " ", "All"}], " ", "replacement", " ", 
          "rules", " ", "are", " ", "simplifications"}], ",", " ", "which", ",",
          " ", "hope", ",", " ", 
         RowBox[{
         "will", " ", "not", " ", "spoil", " ", "the", " ", "result"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Graph", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"Flatten", "[", 
          RowBox[{"Outer", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"makeEdge", "[", 
              RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", "selectedBE", ",",
             "selectedBE"}], "]"}], "]"}], "]"}], "]"}], 
       "\[IndentingNewLine]", ",", 
