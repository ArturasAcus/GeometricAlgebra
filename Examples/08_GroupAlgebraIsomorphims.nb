Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaGeneratorMatrixQ", "[", "\"\<sp(n,H)\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"x_", "?", "MatrixQ"}], ",", 
     RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"FreeQ", "[", 
       RowBox[{"x", ",", "\"\<Quaternion\>\""}], "]"}]}], "&&", 
     RowBox[{
      RowBox[{"gaGeneratorMatrixQ", "[", 
       RowBox[{"\"\<sp\>\"", ",", 
        RowBox[{
         RowBox[{"gaExplicitQuaternionicConjugate", "[", "#", "]"}], "&"}]}], 
