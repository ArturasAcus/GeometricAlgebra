Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"evenSubalgebraGraph", "[", "evenAlgebra", "]"}], "=", 
   RowBox[{"gaAlgebraMultiplicationTableGraph", "[", 
    RowBox[{"evenAlgebra", ",", 
     RowBox[{"\"\<Grades\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "4", "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allAlgebraGraph", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"gaAlgebraMultiplicationTableGraph", "[", "testAlgebra", "]"}]}], 
  ";"}], "\n", 
