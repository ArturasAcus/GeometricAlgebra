Cell[BoxData[{
 RowBox[{
  RowBox[{"gaSetLinear", "[", "gaExplicitQuaternionicConjugate", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"gaExplicitQuaternionicConjugate", ",", "Listable"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaExplicitQuaternionicConjugate", "[", "arg_", "]"}], ":=", 
    RowBox[{"arg", "/;", 
     RowBox[{"FreeQ", "[", 
      RowBox[{
       RowBox[{"{", "arg", "}"}], ",", "\"\<Quaternion\>\""}], "]"}]}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"below", " ", "assume"}], ",", " ", 
    RowBox[{
    "quaternion", " ", "products", " ", "already", " ", "gets", " ", 
     "calculated"}], ",", " ", 
    RowBox[{
     RowBox[{"i", ".", "\[DoubleStruckE]", ".", " ", "no"}], " ", "two", " ", 
     "quaternions"}], ",", " ", 
    RowBox[{
    "otherwise", " ", "we", " ", "should", " ", "interchange", " ", 
     "them"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaExplicitQuaternionicConjugate", "[", 
   RowBox[{"arg", ":", 
    RowBox[{"(", 
     RowBox[{
     "_GeometricProduct", "|", "_OuterProduct", "|", "_InnerProduct", "|", 
      "_LeftContract", "|", "_RightContract"}], ")"}]}], "]"}], ":=", 
  RowBox[{"gaExplicitQuaternionicConjugate", "/@", "arg"}]}], "\n", 
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"baseSymbol", "=", 
      RowBox[{
      "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"gaExplicitQuaternionicConjugate", "[", 
       RowBox[{"baseSymbol", "[", 
        RowBox[{"arg_mvDownUp", ",", 
         RowBox[{"Cl", "[", 
          RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", "\"\<Quaternion\>\"",
          ",", "op___"}], "]"}], "]"}], ":=", 
      RowBox[{"-", 
       RowBox[{"baseSymbol", "[", 
        RowBox[{"arg", ",", 
         RowBox[{"Cl", "[", 
          RowBox[{"0", ",", "2", ",", "0"}], "]"}], ",", "\"\<Quaternion\>\"",
          ",", "op"}], "]"}]}]}], ";"}]}], "\[IndentingNewLine]", "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"118f101d-d108-44b5-94b7-97d2bf489f8e"],

