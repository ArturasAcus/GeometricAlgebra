Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"allIsomorphisms", "[", 
   RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "=", 
  RowBox[{"gaFindAlgebraIsomorphism", "[", 
   RowBox[{
    RowBox[{"Rest", "[", 
     RowBox[{"gaPE", "[", "tensorProductBasis", "]"}], "]"}], "\[Rule]", 
    RowBox[{"Rest", "[", 
     RowBox[{"gaOrthonormalBasis", "[", "secondAlgebra", "]"}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"isomorphismRules", "[", 
      RowBox[{
       RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], ",", "n"}], 
      "]"}], "=", 
     RowBox[{
      RowBox[{"allIsomorphisms", "[", 
       RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "[", 
      RowBox[{"[", "n", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"allIsomorphisms", "[", 
        RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], "]"}], "]"}]}], 
     "}"}]}], "]"}], ";", 
  RowBox[{"isomorphismRules", "[", 
   RowBox[{
    RowBox[{"firstAlgebra", "\[Rule]", "secondAlgebra"}], ",", "1"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9670794740254183`*^9, 3.967079480463434*^9}, 
   3.96708919439639*^9, {3.967089595029429*^9, 3.967089595883067*^9}, {
