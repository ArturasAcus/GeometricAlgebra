  3.695124594154427*^9}},ExpressionUUID->"7b1f9008-d94f-4634-8c92-\
0a2456456691"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"generatorJz", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"groupMatrix", "[", "testGroup", "]"}], ",", "\[Alpha]"}], 
      "]"}], ".", 
     RowBox[{"groupInverseMatrix", "[", "testGroup", "]"}]}], "//", 
