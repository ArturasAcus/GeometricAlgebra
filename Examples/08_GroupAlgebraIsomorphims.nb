Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "\[Rule]", "\"\<Complex\>\""}],
              ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], 
              "\[Rule]", "\"\<Antisymmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], 
              "\[Rule]", "\"\<Pauli[3,1]\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<BaseVectorAlgebra\>\"", "\[Rule]", "\[NoBreak]", 
           RowBox[{"Cl", "[", 
            RowBox[{"2", ",", "3", ",", "0"}], "]"}]}], "\[NoBreak]", ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}], ",", 
          RowBox[{"\"\<ReductionOrder\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              TemplateBox[{"1", "1", "0"},
               "Cl",
               DisplayFunction->(SubscriptBox[
                 StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
                 RowBox[{#, ",", #2}]]& ),
               Tooltip->None], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"2", ",", "0", ",", "0"}], "]"}], ",", 
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2", ",", "0"}], "]"}]}], "}"}]}], "}"}]}], 
          ",", 
          RowBox[{"\"\<MatrixOuterProductOrder\>\"", "\[Rule]", "Reverse"}]}],
          "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.779783391004405*^9, 3.779783441209656*^9}, 
   3.931596834519526*^9, {3.9410065125186663`*^9, 3.941006534349931*^9}},
