Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Complex\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "->", "\"\<Symmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], 
              "\[Rule]", "\"\<Pauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.779772842726962*^9, 3.7797728903983994`*^9}, 
   3.9315968203501863`*^9, {3.9410059101307383`*^9, 3.941005912260261*^9}},
