Cell["\<\
Now find isomorphisms between geometric algebras (with respect to geometric \
product, not commutator product)\
\>", "Text",
 CellChangeTimes->{{3.700801669261407*^9, 3.700801734699354*^9}, {
  3.701743356307444*^9, 3.701743357925431*^9}, {3.70175313918302*^9, 
  3.701753143734276*^9}, {3.70175442850438*^9, 3.701754500726277*^9}, {
  3.702097604631666*^9, 3.702097634319112*^9}, {3.7020977852099*^9, 
  3.702097832759142*^9}},ExpressionUUID->"89bd41c2-e5ea-40c2-a5e1-\
e8700307ab4f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"evenSubalgebraGraph", "[", "evenAlgebra", "]"}], "=", 
   RowBox[{"gaAlgebraMultiplicationTableGraph", "[", 
    RowBox[{"evenAlgebra", ",", 
     RowBox[{"\"\<Grades\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", "0", "}"}], ",", 
        RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "4", "}"}], ",", 
        RowBox[{"{", "6", "}"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"allAlgebraGraph", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"gaAlgebraMultiplicationTableGraph", "[", "testAlgebra", "]"}]}], 
  ";"}], "\n", 
 RowBox[{"IsomorphicGraphQ", "[", 
  RowBox[{
   RowBox[{"evenSubalgebraGraph", "[", "evenAlgebra", "]"}], ",", 
   RowBox[{"allAlgebraGraph", "[", "testAlgebra", "]"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.696062470935766*^9, 3.696062473079544*^9}, {
   3.696139534909059*^9, 3.696139584965514*^9}, {3.696169335722079*^9, 
