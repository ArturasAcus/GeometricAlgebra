Cell[BoxData[{
 RowBox[{
  RowBox[{"allIsomorphisms", "[", 
   RowBox[{"evenAlgebra", "->", "testAlgebra"}], "]"}], "=", 
  RowBox[{"FindGraphIsomorphism", "[", 
   RowBox[{
    RowBox[{"evenSubalgebraGraph", "[", "evenAlgebra", "]"}], ",", 
    RowBox[{"allAlgebraGraph", "[", "testAlgebra", "]"}], ",", "All"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"isomorphismRules", "[", 
      RowBox[{
       RowBox[{"evenAlgebra", "->", "testAlgebra"}], ",", "n"}], "]"}], "=", 
     RowBox[{
      RowBox[{"allIsomorphisms", "[", 
       RowBox[{"evenAlgebra", "->", "testAlgebra"}], "]"}], "[", 
      RowBox[{"[", "n", "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"n", ",", "1", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"allIsomorphisms", "[", 
        RowBox[{"evenAlgebra", "->", "testAlgebra"}], "]"}], "]"}]}], "}"}]}],
    "]"}], ";", 
  RowBox[{"isomorphismRules", "[", 
   RowBox[{
