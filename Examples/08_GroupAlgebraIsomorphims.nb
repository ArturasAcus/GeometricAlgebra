Cell[CellGroupData[{

Cell["\<\
 SO(3) parametrization using explicit matrix  (rotation axis positioned by  \
\[CurlyPhi],\[Theta] angles and rotation about the axis by angle \[Omega])\
\>", "Subsubsection",
 CellChangeTimes->{
  3.696306099657721*^9, {3.696306148908106*^9, 3.696306203649579*^9}, {
   3.696585827638599*^9, 3.696585843173498*^9}, {3.696666537591319*^9, 
   3.696666576946863*^9}, {3.696753247540886*^9, 3.696753257187009*^9}, {
   3.696758349526262*^9, 3.696758358696368*^9}, {3.696759122352241*^9, 
   3.696759135290814*^9}, {3.696825454683139*^9, 3.696825487168224*^9}, {
   3.696830463107313*^9, 3.696830543963761*^9}, {3.696830636888944*^9, 
   3.696830698426983*^9}, {3.697172241301635*^9, 
   3.697172242376432*^9}},ExpressionUUID->"8b6cc2fe-5d91-417b-91e9-\
1fcc3477e2e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rotation3DReal", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"r1_", ",", "r2_", ",", "r3_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Omega]_", ",", "\[Theta]_", ",", "\[CurlyPhi]_"}], "}"}]}], 
   "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], ",", 
      RowBox[{"r", "=", 
       RowBox[{"{", 
        RowBox[{"r1", ",", "r2", ",", "r3"}], "}"}]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", "\[Omega]", "]"}], "*", "r"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Cos", "[", "\[Omega]", "]"}]}], ")"}], 
      RowBox[{"Dot", "[", 
       RowBox[{"r", ",", "k"}], "]"}], " ", "*", "k"}], "+", 
     RowBox[{
      RowBox[{"Sin", "[", "\[Omega]", "]"}], " ", 
      RowBox[{"Cross", "[", 
       RowBox[{"k", ",", "r"}], "]"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.696672225296572*^9, 3.696672229669184*^9}, {
   3.696672339678323*^9, 3.696672561158501*^9}, 3.696672598348723*^9},
 CellLabel->"In[63]:=",ExpressionUUID->"0de46536-33ae-4f6a-a86f-11f7b64c6e1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rotMatrix", "[", "\"\<SO(3)\>\"", "]"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"rotation3DReal", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"\[Omega]", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], 
       "]"}], "&"}], "/@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.696830200810221*^9, 3.696830323894926*^9}, {
  3.696830415735062*^9, 3.696830420495525*^9}, {3.696830703070428*^9, 
  3.696830717864881*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"99d2c27c-3c43-4efc-8078-7f31a111ac20"],

Cell["\<\
Test that matrix applied to vector gives the same result as before\
\>", "Text",
