Cell["\<\
Some shortcuts for vectors and bivectors, which will be used for compact \
formula tastings. Note, testAlgebra keyword\
\>", "Text",ExpressionUUID->"0c5f2f49-a4ba-47e8-bb12-71927a5b72d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "vectors", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"a", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"b", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"c", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"d", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"f", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "bivectors", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalA]1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"\[ScriptCapitalA]", ",", "testAlgebra", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalB]1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"\[ScriptCapitalB]", ",", "testAlgebra", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalC]1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"\[ScriptCapitalC]", ",", "testAlgebra", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"general", " ", "multivectors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"A", ",", "testAlgebra"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"B1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"B", ",", "testAlgebra"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"F", ",", "testAlgebra"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"general", " ", "blades"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"A2", "[", "part_Integer", "]"}], ":=", 
     RowBox[{"Take", "[", 
      RowBox[{
       RowBox[{"gaGeneralMultivector", "[", 
        RowBox[{"A", ",", "testAlgebra"}], "]"}], ",", 
       RowBox[{"{", "part", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
