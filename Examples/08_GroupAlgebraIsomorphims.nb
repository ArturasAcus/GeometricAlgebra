Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "\[Rule]", "\"\<Complex\>\""}],
              ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<IPauli[2,3]\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], 
              "\[Rule]", "\"\<Pauli[2,3]\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<ReductionOrder\>\"", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"2", ",", "0", ",", "0"}], "]"}], ",", 
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "2", ",", "0"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              TemplateBox[{"1", "1", "0"},
               "Cl",
               DisplayFunction->(SubscriptBox[
                 StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
                 RowBox[{#, ",", #2}]]& ),
               Tooltip->None], "}"}]}], "}"}]}], ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.779782088006852*^9, 3.779782104881011*^9}, 
