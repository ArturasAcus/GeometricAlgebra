Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaGeneratorMatrixQ", "::", "dimension"}], 
    "=", "\"\<Matrix dimension and signature mismatch.\>\""}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaGeneratorMatrixQ", "[", "su_String", "]"}], "[", 
    RowBox[{
     RowBox[{"x_", "?", "MatrixQ"}], ",", 
     RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"dim", "=", 
         RowBox[{"Dimensions", "[", "x", "]"}]}], ",", "p", ",", "q", ",", 
        "standardSkew", ",", 
        RowBox[{"skewnessPattern", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"gaGeneratorPattern", "/.", 
            RowBox[{"{", "opts", "}"}]}], "/.", 
           RowBox[{"Options", "[", 
            RowBox[{"gaGeneratorMatrixQ", ",", "gaGeneratorPattern"}], 
            "]"}]}], ")"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", ",", "q"}], "}"}], "=", 
        RowBox[{"ToExpression", "[", 
         RowBox[{"StringCases", "[", 
          RowBox[{"su", ",", 
           RowBox[{"a", ":", 
            RowBox[{"DigitCharacter", ".."}]}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "x", "]"}], "===", 
          RowBox[{"p", "+", "q"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"skewnessPattern", "===", "\"\<Automatic\>\""}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"standardSkew", "=", 
             RowBox[{"ArrayFlatten", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"IdentityMatrix", "[", "p", "]"}], ",", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", "q"}], "}"}]}], "]"}]}], "}"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"0", ",", 
                    RowBox[{"{", 
                    RowBox[{"q", ",", "p"}], "}"}]}], "]"}], ",", 
                  RowBox[{"-", 
                   RowBox[{"IdentityMatrix", "[", "q", "]"}]}]}], "}"}]}], 
               "}"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"Print", "[", "\"\<Not yet implemented\>\"", "]"}], 
             ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Union", "[", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Transpose", "[", "x", "]"}], "/.", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Complex", "[", 
                    RowBox[{"a_", ",", "b_"}], "]"}], ":>", 
                   RowBox[{"Complex", "[", 
                    RowBox[{"a", ",", 
                    RowBox[{"-", "b"}]}], "]"}]}], "}"}]}], ")"}], ".", 
               "standardSkew"}], "+", 
              RowBox[{"standardSkew", ".", "x"}]}], "]"}], "]"}], "===", 
           RowBox[{"{", "0", "}"}]}]}], ",", "\[IndentingNewLine]", 
         RowBox[{"Message", "[", 
          RowBox[{"gaGeneratorMatrixQ", "::", "dimension"}], "]"}]}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}], "/;", 
    RowBox[{"StringMatchQ", "[", 
     RowBox[{"su", ",", 
      RowBox[{"StringExpression", "[", 
       RowBox[{"\"\<su(\>\"", ",", 
        RowBox[{"a", ":", 
         RowBox[{"DigitCharacter", ".."}]}], ",", "\"\<,\>\"", ",", 
        RowBox[{"b", ":", 
         RowBox[{"DigitCharacter", ".."}]}], ",", "\"\<)\>\""}], "]"}]}], 
     "]"}]}]}], ";"}]}], "Input",
