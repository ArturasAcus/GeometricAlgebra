  3.702097634319112*^9}},ExpressionUUID->"9433b058-5bff-4b15-aca5-\
0a9c95bab52d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bivectorBase", "[", "evenAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"gaGetMV", "[", 
     RowBox[{
      RowBox[{"gaOrthonormalBasis", "[", "evenAlgebra", "]"}], ",", 
      RowBox[{"{", "2", "}"}]}], "]"}], ",", "0"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"#", "\[GeometricProduct]", "#"}], ")"}], "&"}], "/@", 
  "%"}]}], "Input",
