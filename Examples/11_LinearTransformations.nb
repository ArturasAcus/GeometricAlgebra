             SlotSequence[1]}, {Length[{1, 2, 3}] + 1, 
             Length[{1, 2, 3}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
     Tooltip -> "mvDownUp[{1, 2, 3}, {}]"], 
    TemplateBox[{"2", "1", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
       StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
       RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
   "\[DoubleStruckE]",
