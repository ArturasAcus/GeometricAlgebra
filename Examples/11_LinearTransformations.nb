Cell["\<\
We transform each blade by (a1\[GeometricProduct]MV[#]\[GeometricProduct]b1) \
transformation. This is lhs of unt 6.1\
\>", "Text",
 CellChangeTimes->{{3.796378616795415*^9, 3.796378645955162*^9}, {
  3.796440372389436*^9, 
  3.7964403872278337`*^9}},ExpressionUUID->"d9ba2d65-6a53-486a-8223-\
b3ca67a4fad8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"theTransformedBlade", "[", "testAlgebra", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"gaTransformation", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a1", "\[GeometricProduct]", 
          RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", "a1Inv"}], 
         ")"}], "&"}], "]"}], "[", "#", "]"}], "&"}], "/@", 
    RowBox[{"theBlade", "[", "testAlgebra", "]"}]}]}]}]], "Input",
