Cell[BoxData[
 RowBox[{
  RowBox[{"theTransformedBlade", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"OuterProduct", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gaTransformation", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Alpha]1", "\[GeometricProduct]", 
            RowBox[{
             RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", 
             RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "\[GeometricProduct]", 
            RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
           RowBox[{"\[Alpha]2", "\[GeometricProduct]", 
            RowBox[{
             RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", 
             RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "\[GeometricProduct]", 
            RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
           RowBox[{"\[Alpha]3", "\[GeometricProduct]", 
            RowBox[{
             RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", 
             RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}], "\[GeometricProduct]", 
            RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ")"}], "&"}], 
        "]"}], "[", "#", "]"}], "&"}], "/@", 
     RowBox[{"gaOrthonormalBasis", "[", 
      RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ")"}]}]}]], "Input",
