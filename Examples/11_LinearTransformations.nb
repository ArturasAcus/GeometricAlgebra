Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseTransformation", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}]}], ")"}], 
       RowBox[{
        RowBox[{"gaAdjointTransformation", "[", 
         RowBox[{"gaTransformation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"myRotor", "[", "testAlgebra", "]"}], 
              "\[GeometricProduct]", 
              RowBox[{"MV", "[", "#1", "]"}], "\[GeometricProduct]", 
              RowBox[{"gaReverse", "[", 
               RowBox[{"myRotor", "[", "testAlgebra", "]"}], "]"}]}], ")"}], 
            "&"}], ",", 
           RowBox[{
           "ExtendOutermorphismToBasisElements", "\[Rule]", "True"}]}], "]"}],
          "]"}], "[", 
        RowBox[{"y1", "\[GeometricProduct]", 
         RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}]}], 
      "\[GeometricProduct]", 
      RowBox[{"gaInverse", "[", 
       RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}]}], "//", "gaPE"}], "//",
     "Expand"}], "//", "Together"}]}]], "Input",
 CellChangeTimes->{{3.797242958468152*^9, 3.797242983433304*^9}, {
