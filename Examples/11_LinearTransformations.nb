Cell[TextData[StyleBox["To save formula, extract Sqrt root of determinant of \
transformation",
 FontColor->RGBColor[1, 0, 0]]], "Text",
 CellChangeTimes->{{3.797158921840695*^9, 3.7971589491080103`*^9}, {
  3.7971590292803926`*^9, 3.797159072632703*^9}, {3.797242775880748*^9, 
