  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"(", " ", 
       RowBox[{"x", "\[InnerProduct]", "\[ScriptCapitalB]"}], ")"}]}]}], 
    ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[Alpha]", "4"], "-", 
