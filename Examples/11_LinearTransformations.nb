  RowBox[{"(", 
   RowBox[{
    RowBox[{"gaTME", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{"gaTransformationMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Alpha]1", "\[GeometricProduct]", 
         RowBox[{"x", "[", "1", "]"}], "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
        RowBox[{"\[Alpha]2", "\[GeometricProduct]", 
         RowBox[{"x", "[", "2", "]"}], "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}], "+", 
        RowBox[{"\[Alpha]3", "\[GeometricProduct]", 
         RowBox[{"x", "[", "3", "]"}], "\[GeometricProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], ",", 
       RowBox[{"gaGeneralMultivector", "[", 
        RowBox[{"x", ",", "testAlgebra", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], "//", "gaPE"}]}], ")"}], "//",
   "MatrixForm"}]], "Input",
