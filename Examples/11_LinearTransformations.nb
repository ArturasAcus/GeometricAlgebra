  RowBox[{"theTransformedVector", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaTransformation", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"myRotor", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
         
         RowBox[{"MV", "[", "#1", "]"}], "\[GeometricProduct]", 
         RowBox[{"gaReverse", "[", 
          RowBox[{"myRotor", "[", "testAlgebra", "]"}], "]"}]}], ")"}], "&"}],
