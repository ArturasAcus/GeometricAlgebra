Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseTransformationBad", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "/", 
         RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}]}], ")"}], 
       RowBox[{
        RowBox[{"gaAdjointTransformation", "[", 
         RowBox[{"gaTransformation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"\[Alpha]", "\[GeometricProduct]", 
               RowBox[{"MV", "[", "#", "]"}]}], "+", 
              RowBox[{"\[Beta]", "\[GeometricProduct]", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", "a1"}], 
                ")"}], "\[GeometricProduct]", "b1"}]}], ")"}], "&"}], ",", 
           RowBox[{
           "ExtendOutermorphismToBasisElements", "\[Rule]", "False"}]}], 
          "]"}], "]"}], "[", 
        RowBox[{"x1", "\[GeometricProduct]", 
         RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}]}], 
      "\[GeometricProduct]", 
      RowBox[{"gaInverse", "[", 
       RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}]}], "//", "gaPE"}], "//",
     "Expand"}], "//", "Together"}]}]], "Input",
 CellChangeTimes->{{3.797242958468152*^9, 3.797242983433304*^9}, {
