Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on vector Ok):",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["F", 
      RowBox[{"-", "1"}]], "(", "A", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["F", "*"], "(", 
        RowBox[{"A", " ", "I"}], ")"}], 
       SuperscriptBox["I", 
        RowBox[{"-", "1"}]]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"988f6465-7c73-4fbc-bc79-e99d0d8cc38e"],
 " "
}], "Subsubsection",
