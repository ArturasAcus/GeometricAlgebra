Cell[TextData[{
 "For rhs we need determinant of the transformation. Sign multiplier ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[DoubleStruckE]", "1234"], "2"], TraditionalForm]], 
  "Subsection",ExpressionUUID->"ac3eab3e-1fbc-4f3d-ab97-84c3ea2919a6"],
 " can be written also as ",
 Cell[BoxData[
  FormBox[
