               RowBox[{"\[ScriptCapitalA]1", "\[GeometricProduct]", 
                RowBox[{"MV", "[", "#", "]"}]}], "-", 
               RowBox[{
                RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", 
                "\[ScriptCapitalA]1"}]}], ")"}]}]}], ")"}], "&"}], ",", 
         RowBox[{"ExtendOutermorphismToBasisElements", "\[Rule]", "False"}]}],
         "]"}], "]"}], "[", 
