Cell["\<\
We transform each blade by (a1\[GeometricProduct]MV[#]\[GeometricProduct]b1) \
transformation. This is lhs of unt 6.1\
\>", "Text",
 CellChangeTimes->{{3.796378616795415*^9, 3.796378645955162*^9}, {
  3.796440372389436*^9, 
  3.7964403872278337`*^9}},ExpressionUUID->"3f1bfbe0-fc79-4f1a-91b6-\
9888baaa6176"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"theTransformedBlade", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaTransformation", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Alpha]", "\[GeometricProduct]", "a1", "\[GeometricProduct]", 
         RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", 
         RowBox[{"Simplify", "[", 
          RowBox[{"gaInverse", "[", "a1", "]"}], "]"}]}], ")"}], "&"}], "]"}],
      "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"theBlade", "[", "testAlgebra", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.796123437775001*^9, 3.79612353921728*^9}, {
