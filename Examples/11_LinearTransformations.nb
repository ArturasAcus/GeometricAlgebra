Cell[BoxData[
 RowBox[{
  RowBox[{"theAdjointVector", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaAdjointTransformation", "[", 
    RowBox[{
     RowBox[{"gaTransformation", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", 
          RowBox[{"a1", "\[OuterProduct]", "b1"}], "\[GeometricProduct]", 
          RowBox[{"gaI", "[", "testAlgebra", "]"}]}], ")"}], "&"}], ",", 
       RowBox[{"ExtendOutermorphismToBasisElements", "\[Rule]", "False"}]}], 
      "]"}], ",", 
     RowBox[{"Method", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<SolveAlways\>\"", ",", 
        RowBox[{"\"\<Grades\>\"", "\[Rule]", "All"}]}], "}"}]}]}], "]"}], "[",
    "\[Alpha]", "]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
