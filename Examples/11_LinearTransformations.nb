Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseByFormula", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaI", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"gaAdjointTransformation", "[", 
         RowBox[{"gaTransformation", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\[Alpha]", "\[GeometricProduct]", "a1", "\[GeometricProduct]", 
              RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", "a1"}], 
             ")"}], "&"}], ",", 
           RowBox[{
           "ExtendOutermorphismToBasisElements", "\[Rule]", "True"}]}], "]"}],
          "]"}], "[", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"gaInverse", "[", 
           RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}], "]"}], "\[GeometricProduct]",
          "x1"}], "]"}], ")"}], "/", 
      RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}]}]}], "//", 
    "gaPE"}], "//", "Factor"}]}]], "Input",
