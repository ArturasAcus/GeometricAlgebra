Cell[CellGroupData[{

Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on vector Ok):",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["F", "*"], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", "A", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["I", 
        RowBox[{"-", "1"}]], 
       RowBox[{"F", "(", 
        RowBox[{"A", " ", "I"}], ")"}]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"1c68ad89-8b81-42e7-84ba-b6ee982bd5af"],
 " "
}], "Subsubsection",
 CellChangeTimes->{{3.797130089505917*^9, 3.7971301115448503`*^9}, {
  3.7971481702356977`*^9, 3.797148192880679*^9}, {3.797158849486043*^9, 
  3.7971588714734917`*^9}, {3.797159003318523*^9, 3.797159022236064*^9}, {
