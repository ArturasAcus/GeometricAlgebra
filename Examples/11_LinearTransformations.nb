          RowBox[{"\"\<k2\>\"", "[", "3", "]"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<k3\>\"", "[", "2", "]"}], " ", 
             RowBox[{"\"\<k4\>\"", "[", "1", "]"}]}], "-", 
            RowBox[{
             RowBox[{"\"\<k3\>\"", "[", "1", "]"}], " ", 
             RowBox[{"\"\<k4\>\"", "[", "2", "]"}]}]}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"\"\<k2\>\"", "[", "2", "]"}], " ", 
          RowBox[{"\"\<k3\>\"", "[", "1", "]"}], " ", 
          RowBox[{"\"\<k4\>\"", "[", "3", "]"}]}], "-", 
         RowBox[{
          RowBox[{"\"\<k2\>\"", "[", "1", "]"}], " ", 
          RowBox[{"\"\<k3\>\"", "[", "2", "]"}], " ", 
          RowBox[{"\"\<k4\>\"", "[", "3", "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"\"\<k1\>\"", "[", "2", "]"}], " ", 
       RowBox[{"\"\<k2\>\"", "[", "3", "]"}], " ", 
       RowBox[{"\"\<k3\>\"", "[", "1", "]"}], " ", 
       RowBox[{"\"\<k4\>\"", "[", "4", "]"}]}], "-", 
      RowBox[{
       RowBox[{"\"\<k1\>\"", "[", "1", "]"}], " ", 
       RowBox[{"\"\<k2\>\"", "[", "3", "]"}], " ", 
       RowBox[{"\"\<k3\>\"", "[", "2", "]"}], " ", 
       RowBox[{"\"\<k4\>\"", "[", "4", "]"}]}], "-", 
