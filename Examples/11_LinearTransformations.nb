Cell[CellGroupData[{

Cell[TextData[{
 "Example 6.6: Inverse of rotor :",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["F", 
      RowBox[{"-", "1"}]], "(", "A", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["F", "*"], "(", 
        RowBox[{"A", " ", "I"}], ")"}], 
       SuperscriptBox["I", 
        RowBox[{"-", "1"}]]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"99de21eb-fed6-458d-8ec7-40815e2e8314"],
 " "
}], "Subsubsection",
