     RowBox[{"Cos", "[", 
      RowBox[{"\[CurlyPhi]", "/", "2"}], "]"}], "-", 
     RowBox[{
      RowBox[{"theUnitBivector", "[", "testAlgebra", "]"}], "*", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[CurlyPhi]", "/", "2"}], "]"}]}]}], ")"}]}], ";"}]}], "Input",\

