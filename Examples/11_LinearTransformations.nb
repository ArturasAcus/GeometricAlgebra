Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"(", " ", 
       RowBox[{"x", "\[InnerProduct]", "a"}], ")"}], "b"}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", "(", " ", 
       RowBox[{"x", "\[InnerProduct]", "b"}], ")"}], "a"}]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[Alpha]", "2"], "(", 
    RowBox[{
     SuperscriptBox["\[Alpha]", "2"], "+", 
     RowBox[{"2", 
      RowBox[{"\[Alpha]\[Beta]", "(", 
       RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}], "+", 
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["\[Beta]", "2"], "(", 
       RowBox[{"a", "\[OuterProduct]", "b"}], ")"}], "2"]}], ")"}]}], 
  TraditionalForm]], \
