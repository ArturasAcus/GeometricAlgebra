Cell[CellGroupData[{

Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on vector Ok):",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["F", "*"], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", "A", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["I", 
        RowBox[{"-", "1"}]], 
       RowBox[{"F", "(", 
        RowBox[{"A", " ", "I"}], ")"}]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"1c68ad89-8b81-42e7-84ba-b6ee982bd5af"],
 " "
}], "Subsubsection",
