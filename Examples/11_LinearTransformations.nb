Cell["The rotation transformation in the plane by Pi/3", "Text",ExpressionUUID->"dc5f6114-8795-467d-b218-1386207aee88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mvRp", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[CurlyPhi]", "/", "2"}], "]"}], "+", 
     RowBox[{
