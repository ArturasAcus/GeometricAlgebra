Cell[CellGroupData[{

Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on bivector yields \
",
 StyleBox["WRONG det factor",
  FontColor->RGBColor[1, 0, 0]],
 "):",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["F", 
      RowBox[{"-", "1"}]], "(", "A", ")"}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["F", "*"], "(", 
        RowBox[{"A", " ", "I"}], ")"}], 
       SuperscriptBox["I", 
        RowBox[{"-", "1"}]]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"02b90122-0334-476b-97cd-e36669c6863d"]
}], "Subsubsection",
 CellChangeTimes->{{3.797130089505917*^9, 3.7971301115448503`*^9}, {
  3.7971481702356977`*^9, 3.797148192880679*^9}, {3.797158849486043*^9, 
  3.7971588714734917`*^9}, {3.797159003318523*^9, 3.797159022236064*^9}, {
  3.7972436257045317`*^9, 3.797243708722043*^9}, {3.797243878698*^9, 
  3.797243920475852*^9}, {3.797847930797731*^9, 3.7978479415369387`*^9}, {
