Cell[CellGroupData[{

Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on vector Ok, for \
bivector ",
 StyleBox["wrong det factor",
  FontColor->RGBColor[1, 0, 0]],
 " ): ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["F", 
      RowBox[{"-", "1"}]], "(", "A", ")"}], "=", 
    RowBox[{
     RowBox[{"I", "(", 
      RowBox[{
       SuperscriptBox["F", "*"], "(", 
       RowBox[{
        SuperscriptBox["I", 
         RowBox[{"-", "1"}]], " ", "A"}], " ", ")"}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"38bc99cb-773d-4067-a8c2-88dae41bc2d4"]
}], "Subsubsection",
