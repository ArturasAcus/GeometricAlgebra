Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", " ", "a"}], "\[InnerProduct]", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"b", "\[OuterProduct]", "x"}], ")"}], "b"}]}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", " ", "b"}], "\[InnerProduct]", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"a", "\[OuterProduct]", "x"}], ")"}], "b"}]}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Alpha]", "+", 
      RowBox[{"2", 
       RowBox[{"\[Beta]", "(", 
        RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}]}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Alpha]", "2"], "+", 
      RowBox[{"2", 
       RowBox[{"\[Alpha]\[Beta]", "(", 
        RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}], "+", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[Beta]", "2"], "(", 
        RowBox[{"a", "\[OuterProduct]", "b"}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], \
