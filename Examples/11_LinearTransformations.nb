Cell[TextData[{
 "If we will use ExtendOutermorphismToBasisElements\[Rule]False, then wrong \
common factor arises. ",
 StyleBox["All this depends on how we interpret action on outer product!!!",
  FontColor->RGBColor[1, 0.5, 0]]
}], "Text",
