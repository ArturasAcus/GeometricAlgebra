Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseTransformation", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}]}], ")"}], 
      "\[GeometricProduct]", 
      RowBox[{"gaI", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
      RowBox[{
       RowBox[{"gaAdjointTransformation", "[", 
        RowBox[{"gaTransformation", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Alpha]", "\[GeometricProduct]", 
              RowBox[{"MV", "[", "#", "]"}]}], "+", 
             RowBox[{"\[Beta]", "\[GeometricProduct]", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", "a1"}], 
               ")"}], "\[GeometricProduct]", "b1"}]}], ")"}], "&"}], ",", 
          RowBox[{"ExtendOutermorphismToBasisElements", "\[Rule]", "True"}]}],
          "]"}], "]"}], "[", 
       RowBox[{
        RowBox[{"gaInverse", "[", 
         RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}], "\[GeometricProduct]", 
        RowBox[{"(", 
         RowBox[{"x1", "\[OuterProduct]", "d1"}], ")"}]}], "]"}]}], "//", 
     "gaPE"}], "//", "Expand"}], "//", "Together"}]}]], "Input",
