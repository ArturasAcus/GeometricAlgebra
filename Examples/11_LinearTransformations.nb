Cell[BoxData[
 RowBox[{
  RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"gaTM", "[", "testAlgebra", "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"gaTransformationMatrix", "[", 
        RowBox[{"gaTransformation", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Alpha]", "\[GeometricProduct]", 
             RowBox[{"MV", "[", "#", "]"}]}], "+", 
            RowBox[{"\[Beta]", "\[GeometricProduct]", 
             RowBox[{"a1", "\[InnerProduct]", 
              RowBox[{"(", 
               RowBox[{"b1", "\[OuterProduct]", 
                RowBox[{"MV", "[", "#", "]"}]}], ")"}]}]}], "+", 
            RowBox[{"\[Beta]", "\[GeometricProduct]", 
             RowBox[{"b1", "\[InnerProduct]", 
              RowBox[{"(", 
               RowBox[{"a1", "\[OuterProduct]", 
                RowBox[{"MV", "[", "#", "]"}]}], ")"}]}]}]}], ")"}], "&"}], 
         "]"}], "]"}], "[", 
       RowBox[{"gaOrthonormalBasis", "[", 
        RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "//", "gaPE"}]}], ")"}], "//",
    "MatrixForm"}]}]], "Input",
