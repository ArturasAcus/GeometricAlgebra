    RowBox[{"gaTM", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaTransformationMatrix", "[", 
       RowBox[{"gaTransformation", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Alpha]", "\[GeometricProduct]", 
            RowBox[{"MV", "[", "#", "]"}]}], "+", 
           RowBox[{"a1", "\[GeometricProduct]", 
            RowBox[{
             RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", "b1"}]}]}], 
          ")"}], "&"}], "]"}], "]"}], "[", 
      RowBox[{"gaOrthonormalBasis", "[", 
       RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "//", "gaPE"}]}], ")"}], "//",
   "MatrixForm"}]], "Input",
