Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", "  ", "a"}], "\[InnerProduct]", 
      RowBox[{"(", 
       RowBox[{"b", "\[OuterProduct]", "x"}], ")"}]}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", "  ", "b"}], "\[InnerProduct]", 
      RowBox[{"(", 
       RowBox[{"a", "\[OuterProduct]", "x"}], ")"}]}]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox["\[Alpha]", "2"], "+", 
    RowBox[{"2", 
     RowBox[{"\[Alpha]\[Beta]", "(", 
      RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}], "+", 
    SuperscriptBox[
     RowBox[{
      SuperscriptBox["\[Beta]", "2"], "(", 
      RowBox[{"a", "\[OuterProduct]", "b"}], ")"}], "2"]}]}], 
  TraditionalForm]], \
