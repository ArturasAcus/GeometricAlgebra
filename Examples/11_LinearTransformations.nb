Cell[CellGroupData[{

Cell[TextData[{
 "Inverse of pseudoscalar is linear transformation (test on vector Ok):",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["F", "*"], ")"}], 
      RowBox[{"-", "1"}]], 
     RowBox[{"(", "A", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"F", "(", 
        RowBox[{
         SuperscriptBox["I", 
          RowBox[{"-", "1"}]], "A"}], ")"}]}], ")"}], "/", 
     RowBox[{"det", "(", 
      RowBox[{"F", "(", "A", ")"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"afc38cfb-24b1-479a-b098-8ab06325a2cc"],
 " "
}], "Subsubsection",
 CellChangeTimes->{{3.797130089505917*^9, 3.7971301115448503`*^9}, {
