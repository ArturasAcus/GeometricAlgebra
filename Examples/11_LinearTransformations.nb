  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{"\[Beta]", " ", 
      RowBox[{"(", " ", 
       RowBox[{"x", "\[InnerProduct]", "a"}], ")"}], "b"}]}], ")"}], "=", 
   RowBox[{"\[Alpha]", "(", 
    RowBox[{"\[Alpha]", "+", 
     RowBox[{"\[Beta]", "(", 
      RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}], ")"}]}], 
