Cell[BoxData[
 RowBox[{
  RowBox[{"theBlade", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"OuterProduct", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeneralMultivector", "[", 
       RowBox[{"#", ",", "testAlgebra", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<k\>\"", ",", 
          RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
       RowBox[{"Range", "[", 
        RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
        "]"}]}], ")"}]}], ")"}]}]}]], "Input",
