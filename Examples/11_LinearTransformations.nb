Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"theTransformationMatrix", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaTransformationMatrix", "[", 
       RowBox[{"gaTransformation", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"myRotor", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
           RowBox[{"MV", "[", "#1", "]"}], "\[GeometricProduct]", 
           RowBox[{"gaReverse", "[", 
            RowBox[{"myRotor", "[", "testAlgebra", "]"}], "]"}]}], ")"}], 
         "&"}], "]"}], "]"}], "[", 
      RowBox[{"gaOrthonormalBasis", "[", 
       RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
        RowBox[{"{", "1", "}"}]}], "]"}], "]"}], "//", "gaPE"}]}], ")"}], "//",
   "MatrixForm"}]], "Input",
