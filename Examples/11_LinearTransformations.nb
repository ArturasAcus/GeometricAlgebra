e1f479d8e3ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"Det", "[", 
      RowBox[{"Expand", "[", 
       RowBox[{"gaPE", "[", 
        RowBox[{"theTransformationMatrix", "[", "testAlgebra", "]"}], "]"}], 
       "]"}], "]"}], "//", "Factor"}], "]"}], "//", 
   "PowerExpand"}]}]], "Input",
 CellChangeTimes->{{3.797243027376457*^9, 3.797243055769107*^9}, {
  3.797848524797557*^9, 3.797848527122368*^9}, {3.79853854318193*^9, 
  3.798538558902178*^9}},
 CellLabel->
  "In[793]:=",ExpressionUUID->"e82af44b-ff9a-4cd0-9222-fe1b973aa71d"],

