Cell["\<\
We transform each blade by (\[Alpha]\[GeometricProduct]MV[#]\
\[GeometricProduct]b1) transformation. This is lhs of unt 6.1\
\>", "Text",
 CellChangeTimes->{{3.796378616795415*^9, 3.796378645955162*^9}, {
  3.796440372389436*^9, 3.7964403872278337`*^9}, {3.796441500838808*^9, 
  3.796441504356567*^9}},ExpressionUUID->"a6888dcc-ffe1-4dca-a58c-\
164dac787002"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"theTransformedBlade", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaTransformation", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Alpha]", "\[GeometricProduct]", 
          RowBox[{"MV", "[", "#", "]"}]}], "+", 
         RowBox[{"a1", "\[GeometricProduct]", 
          RowBox[{
           RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", "b1"}]}]}], 
        ")"}], "&"}], "]"}], "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"theBlade", "[", "testAlgebra", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.796123437775001*^9, 3.79612353921728*^9}, {
