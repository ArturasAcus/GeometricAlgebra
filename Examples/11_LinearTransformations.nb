  RowBox[{
   RowBox[{
   "det", "(", "\[ScriptCapitalB]\[ScriptCapitalX]\[ScriptCapitalB]", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", "\[OuterProduct]", "\[ScriptCapitalB]"}], 
       ")"}], "6"]}], "+", 
    RowBox[{"3", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", "\[OuterProduct]", "\[ScriptCapitalB]"}], 
       ")"}], "4"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", "\[InnerProduct]", "\[ScriptCapitalB]"}], 
       ")"}], "2"]}], "-", 
    RowBox[{"3", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", "\[OuterProduct]", "\[ScriptCapitalB]"}], 
       ")"}], "2"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[ScriptCapitalB]", "\[InnerProduct]", "\[ScriptCapitalB]"}], 
       ")"}], "4"]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[ScriptCapitalB]", "\[InnerProduct]", "\[ScriptCapitalB]"}], 
      ")"}], "6"]}]}], 
