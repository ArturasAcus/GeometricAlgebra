Cell[BoxData[
 RowBox[{
  RowBox[{"theTransformedBlade", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"OuterProduct", "@@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"gaTransformation", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"n1", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
           RowBox[{"MV", "[", "#", "]"}], "\[GeometricProduct]", 
           RowBox[{"n1", "[", "testAlgebra", "]"}]}], ")"}], "&"}], "]"}], "[",
        "#", "]"}], "&"}], "/@", 
