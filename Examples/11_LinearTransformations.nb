Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Alpha]", "1"], "(", " ", 
       RowBox[{"x", "\[InnerProduct]", "a"}], ")"}], "a"}], "+", 
     RowBox[{
      SubscriptBox["\[Alpha]", "2"], " ", 
      RowBox[{"(", " ", 
       RowBox[{"x", "\[InnerProduct]", "b"}], ")"}], "b"}], "+", 
     RowBox[{
      SubscriptBox["\[Alpha]", "3"], " ", 
      RowBox[{"(", " ", 
       RowBox[{"x", "\[InnerProduct]", "c"}], ")"}], "c"}]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "q"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"a", "\[OuterProduct]", "b", "\[OuterProduct]", "c"}], ")"}], 
     "2"], 
    SubscriptBox["\[Alpha]", "1"], 
    SubscriptBox["\[Alpha]", "2"], 
    SubscriptBox["\[Alpha]", "3"]}]}], 
