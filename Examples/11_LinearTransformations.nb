Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"det", "(", 
    RowBox[{
     RowBox[{"\[Alpha]", " ", "x"}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", " ", "a"}], "\[InnerProduct]", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"b", "\[OuterProduct]", "x"}], ")"}], "b"}]}], "+", 
     RowBox[{
      RowBox[{"\[Beta]", " ", "b"}], "\[InnerProduct]", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{"a", "\[OuterProduct]", "x"}], ")"}], "b"}]}]}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Alpha]", "+", 
       RowBox[{"2", 
        RowBox[{"\[Beta]", "(", 
         RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}]}], ")"}], "2"], 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Alpha]", "2"], "+", 
      RowBox[{"2", 
       RowBox[{"\[Alpha]\[Beta]", "(", 
        RowBox[{"a", "\[InnerProduct]", "b"}], ")"}]}], "+", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[Beta]", "2"], "(", 
        RowBox[{"a", "\[OuterProduct]", "b"}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], \
"Subsection",ExpressionUUID->"a873e83c-bc32-49bf-bb4f-63ebe4973457"]], \
