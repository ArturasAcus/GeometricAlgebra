Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"theInverseTransformation", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "/", 
        RowBox[{"theDetOfTransformation", "[", "testAlgebra", "]"}]}], ")"}], 
      "\[GeometricProduct]", 
      RowBox[{
       RowBox[{"gaAdjointTransformation", "[", 
        RowBox[{"gaTransformation", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"\[Alpha]", "\[GeometricProduct]", 
              RowBox[{"MV", "[", "#", "]"}]}], "+", 
             RowBox[{"\[Beta]", "\[GeometricProduct]", 
              RowBox[{
               RowBox[{
                RowBox[{"MV", "[", "#", "]"}], "\[InnerProduct]", "b1"}], 
               "\[OuterProduct]", "c1"}]}]}], ")"}], "&"}], ",", 
          RowBox[{"ExtendOutermorphismToBasisElements", "\[Rule]", "True"}]}],
          "]"}], "]"}], "[", 
       RowBox[{"\[ScriptCapitalA]1", "\[GeometricProduct]", 
        RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], 
      "\[GeometricProduct]", 
      RowBox[{"gaInverse", "[", 
       RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}]}], "//", "gaPE"}], "//",
     "Expand"}], "//", "Together"}]}]], "Input",
 CellChangeTimes->{{3.797242958468152*^9, 3.797242983433304*^9}, {
  3.797243069573002*^9, 3.7972431139849463`*^9}, {3.797243307614418*^9, 
