Cell[BoxData[
 RowBox[{
  RowBox[{"nameAndMatrix", "[", "alg_Cl", "]"}], ":=", 
  RowBox[{
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"gaListDefinedElementaryRepresentations", "[", "alg", "]"}], ",", 
        RowBox[{"(", 
         RowBox[{"Row", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"MapAt", "[", 
              RowBox[{"MatrixForm", ",", 
               RowBox[{"gaDefineMatrixRepresentation", "[", 
                RowBox[{"alg", ",", 
                 RowBox[{"Method", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"\"\<TensorProduct\>\"", ",", 
                    RowBox[{"\"\<ElementaryRepresentations\>\"", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{"alg", "->", "#"}], "}"}]}]}], "}"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"All", ",", "2"}], "}"}]}], "]"}], "&"}], "/@", 
            RowBox[{
            "gaListDefinedElementaryRepresentations", "[", "alg", "]"}]}], 
           ")"}]}], ")"}]}], "}"}], "]"}], ",", 
     RowBox[{"TableHeadings", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Representation name\>\"", ",", "Bold"}], "]"}], ",", 
          RowBox[{"Style", "[", 
           RowBox[{"\"\<Representation matrices\>\"", ",", "Bold"}], "]"}]}], 
         "}"}]}], "}"}]}], ",", 
     RowBox[{"TableDirections", "\[Rule]", "Column"}]}], "]"}], "/;", 
   RowBox[{"MemberQ", "[", 
    RowBox[{"GeometricAlgebra`p`elementaryTPAlgebras", ",", "alg"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.682135771276529*^9, 3.682135884032953*^9}, {
  3.748071111198929*^9, 3.748071112319165*^9}, {3.769936102685503*^9, 
  3.769936157242272*^9}, {3.7699362133616743`*^9, 3.769936213945589*^9}, {
  3.939906885008152*^9, 3.939906887564941*^9}, {3.9403017854768467`*^9, 
  3.9403017854801397`*^9}, {3.940301857987529*^9, 3.940301857988956*^9}, {
  3.9690908948798037`*^9, 3.969090904104241*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"5b9b83ae-c7f1-49d0-86a2-429b0c5283b5"],

Cell[TextData[{
 "Nice property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         SubscriptBox["\[DoubleStruckE]", "i"], "2"]}], 
       SuperscriptBox[
        SubscriptBox["x", "i"], "2"]}], ")"}], 
     RowBox[{"n", "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "0e1cdbe1-1dbf-45bd-9f56-19ee0c357003"],
 " =det (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Sum]", "i"], 
    RowBox[{
     SubscriptBox["\[DoubleStruckE]", "i"], 
     SubscriptBox["x", "i"]}]}], TraditionalForm]],ExpressionUUID->
  "fbe5f4fd-c67c-41aa-a445-81c5f7169d2a"],
 ") of Clifford algebra vectors ant their representation matrix determinants \
(see Cl[0,3] -> \[DoubleStruckCapitalH]\[CirclePlus]\[DoubleStruckCapitalH] \
subsection for more detailed explanation)"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
  3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
  3.673770874134313*^9}, {3.673847424440953*^9, 3.673847454297884*^9}, {
  3.67384748908961*^9, 3.673847491281632*^9}, {3.67385142912274*^9, 
  3.673851598056488*^9}, {3.673853419907907*^9, 3.673853572892449*^9}, {
  3.673853707922314*^9, 3.673853752046113*^9}, {3.673932486812709*^9, 
  3.67393254201683*^9}, {3.673954131184186*^9, 3.673954133268568*^9}, {
  3.677510300149822*^9, 3.677510346190731*^9}, {3.677577404678254*^9, 
  3.677577410729652*^9}, {3.678531523284134*^9, 3.678531526628365*^9}, {
  3.678532003096541*^9, 3.678532005369551*^9}, {3.68213474956435*^9, 
  3.682134810504599*^9}, {3.68213966985216*^9, 3.682139716892189*^9}, {
  3.682150689869385*^9, 3.682150704411686*^9}, {3.682319930463917*^9, 
  3.682320041972891*^9}},ExpressionUUID->"441566dd-eb7b-4d36-a18a-\
54536e298966"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "cliffordVectorsDeterminant", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{"onlyClifford", "\[Rule]", "False"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cliffordVectorsDeterminant", "[", 
   RowBox[{"vec_List", ",", 
    RowBox[{"algebra", ":", 
     RowBox[{"(", 
      RowBox[{"_Cl", "|", "_gaTensorProduct"}], ")"}]}], ",", 
    RowBox[{"onlyDifference", ":", 
     RowBox[{"(", 
      RowBox[{"True", "|", "False"}], ")"}]}], ",", "opts___"}], "]"}], ":=", 
  
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cliffordNoMatrixRezult", ",", "matrixDetRezult", ",", " ", 
       RowBox[{"ortBase", "=", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"algebra", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], ",", 
       RowBox[{"theOp", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"onlyClifford", "/.", 
           RowBox[{"{", "opts", "}"}]}], ")"}], "/.", 
         RowBox[{"Options", "[", "cliffordVectorsDeterminant", "]"}]}]}]}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "ortBase", "]"}], "===", "gaOrthonormalBasis"}],
         ",", " ", 
        RowBox[{"ortBase", "=", 
         RowBox[{"gaDefineOrthonormalBasis", "[", 
          RowBox[{"algebra", ",", 
           RowBox[{"\"\<Grades\>\"", "\[Rule]", 
            RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], "]"}], ";", 
      RowBox[{"cliffordNoMatrixRezult", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"-", 
             RowBox[{"GeometricProduct", "[", 
              RowBox[{"#", ",", "#"}], "]"}]}], "&"}], "/@", "ortBase"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"\[FormalX]", "[", "#", "]"}], "^", "2"}], "&"}], "/@", 
            
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "vec", "]"}], "]"}]}], ")"}]}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", 
            RowBox[{"vec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "/", "2"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Not", "[", "theOp", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"matrixDetRezult", "=", 
          RowBox[{"gaDeterminantOfMV", "[", 
           RowBox[{"SparseArray", "[", 
            RowBox[{"Plus", "@@", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"vec", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "*", 
                RowBox[{"\[FormalX]", "[", "i", "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Length", "[", "vec", "]"}]}], "}"}]}], "]"}]}], 
            "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"onlyDifference", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"cliffordNoMatrixRezult", "-", "matrixDetRezult"}], 
             ")"}], "//", "Expand"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"cliffordNoMatrixRezult", "//", "Factor"}], ",", 
             RowBox[{"matrixDetRezult", "//", "Factor"}]}], "}"}]}], "]"}]}], 
        ",", "\[IndentingNewLine]", "cliffordNoMatrixRezult"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}], "/;", 
   RowBox[{
    RowBox[{"Length", "[", "vec", "]"}], ">", "0"}]}]}]}], "Input",
