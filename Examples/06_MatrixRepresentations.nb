Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Complex\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], 
              "\[Rule]", "\"\<Antisymmetric\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<BaseVectorAlgebra\>\"", "\[Rule]", "\[NoBreak]", 
           RowBox[{"Cl", "[", 
            RowBox[{"1", ",", "2", ",", "0"}], "]"}]}], "\[NoBreak]", ",", 
          RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
