Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
     RowBox[{"Last", "/@", 
      RowBox[{"gaDefineMatrixRepresentation", "[", 
       RowBox[{"testAlgebra", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<TensorProduct\>\"", ",", 
           RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"0", ",", "1"}], "]"}], "->", "\"\<Complex\>\""}], ",", 
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "1"}], "]"}], 
               "\[Rule]", "\"\<Antisymmetric\>\""}]}], "}"}]}], ",", 
           RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", "True"}], 
           ",", 
           RowBox[{"\"\<BaseVectorAlgebra\>\"", "\[Rule]", 
            RowBox[{"Cl", "[", 
             RowBox[{"1", ",", "2"}], "]"}]}], ",", 
           RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], 
        ",", 
        RowBox[{"\"\<Grades\>\"", "\[Rule]", 
         RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.778908773116618*^9, 3.778908810991984*^9}, {
