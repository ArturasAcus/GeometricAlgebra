Cell[TextData[{
 "Squares of sparse matrices can be calculated using Dot[ ]. Unfortunately ",
 StyleBox["gaGeometricMatrixProduct[ ]",
  FontWeight->"Bold"],
 " would expand them to dense matrix and it will take much more time to \
multiply"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
