Cell[TextData[{
 "It is clear, that in order to get  2\[Cross]2 matrices, the representation \
of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"0", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "a38d6732-73ae-4250-8f06-918f4be49374"],
 " should be one dimensional (i.e. simply imaginary unit)."
}], "Text",
