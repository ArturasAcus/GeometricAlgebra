  "],ExpressionUUID->"0906f606-344f-4879-a9dd-5a96ef7fc290"],

Cell[TextData[{
 "We see that ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "d0d192c6-9e55-46c3-998b-0fa3f019b0c9"],
 " can be written as a direct product of algebras ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"0", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "efbf152f-4599-49f1-8d4f-38bc12ec9953"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"2", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "f584bd01-2198-45d7-8a81-739f7840724b"],
 ". Then in order to get representation of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "5c56224a-5538-48ee-b165-e646944d6d79"],
 " we can use any combination of representations of these elementary \
algebras"
}], "Text",
