f9b672179613"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"conjugateExplicit", "[", "expr_", "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"expr", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Complex", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
      RowBox[{"Complex", "[", 
       RowBox[{"x", ",", 
        RowBox[{"-", "y"}]}], "]"}]}], "}"}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"conjugateHermiteConjugate", "[", 
   RowBox[{"expr_", "?", "MatrixQ"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Transpose", "[", "expr", "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Complex", "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], ":>", 
      RowBox[{"Complex", "[", 
       RowBox[{"x", ",", 
        RowBox[{"-", "y"}]}], "]"}]}], "}"}]}], ")"}]}]}], "Input",
 CellChangeTimes->{
  3.677574547246463*^9, {3.682406307818047*^9, 3.682406332724255*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"c64b3987-eba0-41fe-804b-b58e6a07f31b"],

