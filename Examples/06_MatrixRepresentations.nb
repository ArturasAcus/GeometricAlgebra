Cell[TextData[{
 "It is easy to see, that all obtained matrices generates representations of \
Cl[2,1]. Indeed Clifford property for base vectors ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    RowBox[{
     SubscriptBox["\[DoubleStruckE]", "i"], 
     SubscriptBox["\[DoubleStruckE]", "j"]}], "+", 
    RowBox[{
     SubscriptBox["\[DoubleStruckE]", "j"], 
     SubscriptBox["\[DoubleStruckE]", "i"]}]}], "=", 
   RowBox[{
    RowBox[{"\[PlusMinus]", "2"}], 
    SubscriptBox["\[Delta]", "ij"]}]}]], "Input",
  CellChangeTimes->{{3.6823952327602*^9, 3.682395278151735*^9}},
  ExpressionUUID->"d7e7c27c-3861-4b35-aad8-dcf88eb3d94c"],
 " are satisfied. "
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
   3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
