Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "->", "\"\<IPauli[3,1]\>\""}], 
             ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "\[Rule]", 
              RowBox[{"{", "\"\<Q[1,2]\>\"", "}"}]}]}], "}"}]}], ",", 
          RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", "True"}]}],
          "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
