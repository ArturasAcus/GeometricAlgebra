Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"1", ",", "1"}], "]"}], 
              "->", "\"\<Antisymmetric\>\""}], ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], 
              "\[Rule]", "\"\<Pauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.7788496890621033`*^9, 3.7788497279092197`*^9}, 
   3.9315959399939013`*^9, {3.94030177050564*^9, 3.94030178561008*^9}, {
