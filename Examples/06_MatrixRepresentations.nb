Cell[BoxData[
 TemplateBox[{
  "gaDefineMatrixRepresentation", "isomorphismIRule", 
   "\"Warning. Imaginary unit replacement \\\"IToRealMatrix\\\" was applied. \
It replaces explicitly elements \[PlusMinus]1 and \[PlusMinus]\[ImaginaryI]. \
For general matrices it will definitely yield wrong result. Please check the \
answer explicitly or don't use \\\"IToRealMatrix\\\" rules!\"", 2, 407, 44, 
   32565077433833162444, "Local", 
