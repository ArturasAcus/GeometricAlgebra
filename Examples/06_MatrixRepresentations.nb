Cell[TextData[{
 "which means, that first we try to factor ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "642c09a6-fcd9-460d-b685-a365865aafa0"],
 "part and only then ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"2", ",", "0"}]], TraditionalForm]],ExpressionUUID->
  "555507fa-c3a3-47c0-bbe0-338bbbc5ba33"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"0", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "6867f1b2-1383-4bdc-b770-1d6c4c8bda5a"],
 " algebras (representations of which are a bit more complicated). In this \
case, however, the result is uniquely determined, so we have no freedom of \
chose."
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQA2IQnV+6VEYz/rVj+LlnyiD65TxHBxD9dCevE4iuVL6a
A6K9fVzyQbSnDN8FPyDt0nHyMogWu6d0A0QrMmeC6Zq3i48EAOkD5w7eBNEV
