Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixPlot", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{"testAlgebra", ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", "True"}]}],
          "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.778911839167679*^9, 3.7789118635571003`*^9}, 
   3.931596006625957*^9, 3.94030183564473*^9},
 CellLabel->
  "In[416]:=",ExpressionUUID->"f1d8ecf6-9ce1-4a10-b2fa-138cdf8c6f2e"],

