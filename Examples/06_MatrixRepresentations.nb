Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"MatrixPlot", "/@", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"vectors", "[", 
      RowBox[{"testAlgebra", ",", "3"}], "]"}], "=", 
     RowBox[{"Last", "/@", 
      RowBox[{"gaDefineMatrixRepresentation", "[", 
       RowBox[{"testAlgebra", ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<TensorProduct\>\"", ",", 
           RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Cl", "[", 
                RowBox[{"1", ",", "0"}], "]"}], "->", "\"\<Diagonal\>\""}], ",", 
              RowBox[{
