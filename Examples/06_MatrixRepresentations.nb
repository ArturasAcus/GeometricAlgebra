Cell["\<\
Because here we see quaternion product, we can reduce them to real matrices \
with \[OpenCurlyDoubleQuote]QuaternionIsomorphismRules\[CloseCurlyDoubleQuote]\
\[Rule]{\[OpenCurlyDoubleQuote]HH2R4\[CloseCurlyDoubleQuote]}\
\>", "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
   3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
   3.673770874134313*^9}, {3.673847424440953*^9, 3.673847454297884*^9}, {
   3.67384748908961*^9, 3.673847491281632*^9}, {3.67385142912274*^9, 
   3.673851598056488*^9}, {3.673853198231991*^9, 3.673853276480684*^9}, {
   3.673853330115768*^9, 3.673853357100738*^9}, {3.673853613532576*^9, 
   3.673853650616628*^9}, {3.673932571048672*^9, 3.673932870007566*^9}, {
   3.673933020665118*^9, 3.673933121360579*^9}, {3.673954643605199*^9, 
   3.673954896081281*^9}, {3.673955211748288*^9, 3.673955219561568*^9}, {
   3.673956177662593*^9, 3.673956281675917*^9}, {3.682140829308854*^9, 
   3.682140856251663*^9}, {3.6823140650543*^9, 3.682314124075637*^9}, {
   3.682397584819105*^9, 3.682397622141051*^9}, {3.682398178477858*^9, 
   3.682398230705533*^9}, 3.722661435950059*^9, 3.722661704634633*^9, 
   3.778828717999758*^9, 
   3.94030183591713*^9},ExpressionUUID->"9d9b41ab-0273-4345-85ad-\
ce12aa265296"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MatrixForm", "/@", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"vectors", "[", 
     RowBox[{"testAlgebra", ",", "2"}], "]"}], "=", 
    RowBox[{"Last", "/@", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"reducedAlgebra", "[", 
        RowBox[{"testAlgebra", ",", "2"}], "]"}], ",", 
       RowBox[{"Method", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Q[1,2]\>\""}], ",", 
             
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<Symmetric\>\""}]}], "}"}]}], ",", 
          RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", 
           RowBox[{"{", "\"\<HH2R4\>\"", "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}]}]], "Input",
 CellChangeTimes->{{3.77882873151787*^9, 3.7788287544209757`*^9}, 
   3.931596032241972*^9, 3.940301786895216*^9, 3.940301835919222*^9},
 CellLabel->
  "In[405]:=",ExpressionUUID->"8adac39f-9f9c-4be9-a2f0-8cc029988d25"],

