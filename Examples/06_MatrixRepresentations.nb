Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{"PauliSpinVectors", "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"Cl", "[", 
        RowBox[{"3", ",", "0"}], "]"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "\[Rule]", "\"\<Complex\>\""}],
              ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], 
              "\[Rule]", "\"\<IPauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsMultipliers\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsReordering\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
