Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"PauliAssociatedVectors", "=", 
    RowBox[{"gaDefineMatrixRepresentation", "[", 
     RowBox[{
      RowBox[{"Cl", "[", 
       RowBox[{"0", ",", "2"}], "]"}], ",", 
      RowBox[{"Method", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<TensorProduct\>\"", ",", 
         RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cl", "[", 
             RowBox[{"0", ",", "2"}], "]"}], "->", "\"\<Pauli[3,1]\>\""}], 
           "}"}]}], ",", 
         RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}]}], 
     "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
