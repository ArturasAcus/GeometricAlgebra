               "\[Rule]", "\"\<Antisymmetric\>\""}]}], "}"}]}], ",", 
           RowBox[{"\"\<QuaternionIsomorphismRules\>\"", "\[Rule]", "True"}], 
           ",", 
           RowBox[{"\"\<BaseVectorAlgebra\>\"", "\[Rule]", 
            RowBox[{"Cl", "[", 
             RowBox[{"1", ",", "2"}], "]"}]}], ",", 
           RowBox[{"\"\<TargetMatrices\>\"", "\[Rule]", "Reals"}]}], "}"}]}], 
        ",", 
        RowBox[{"\"\<Grades\>\"", "\[Rule]", 
         RowBox[{"{", "1", "}"}]}]}], "]"}]}]}], ")"}], ",", 
   RowBox[{"{", 
