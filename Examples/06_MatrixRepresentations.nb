Cell[TextData[{
 "Each name represents some matrix set, from which higher algebra \
representations are built.  Algebra representations are constructed with the \
command ",
 StyleBox["gaAlgebraToMatrixRepresentation[algebra,elementary representation \
names ]",
  FontWeight->"Bold"],
 ". The first argument is the algebra, the second is a list of names of \
representations of all elementary algebras that are needed for construction.  \
For example, in the case of elementary algebra ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"0", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "dc14aba4-de9a-4eae-931d-b1aec64960c9"],
 " representations are either complex 1\[Cross]1 or real 2\[Cross]2  \
matrices"
}], "Text",
 CellChangeTimes->{{3.673770213170585*^9, 3.673770271212688*^9}, {
  3.673770498050648*^9, 3.673770512428942*^9}, {3.67377085466058*^9, 
