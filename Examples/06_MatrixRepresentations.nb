   RowBox[{
    RowBox[{
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"{", "#", "}"}], ",", 
       RowBox[{"#", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Rule", "[", 
           RowBox[{"a_", ",", "b_"}], "]"}], "\[RuleDelayed]", 
          RowBox[{"Rule", "[", 
           RowBox[{
            RowBox[{"-", "a"}], ",", 
            RowBox[{"-", "b"}]}], "]"}]}], "}"}]}]}], "]"}], "&"}], "/@", 
    RowBox[{"fullMatrixBase", "[", 
