Cell[TextData[{
 "e) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["A", "r"], "\[InnerProduct]", 
     SubscriptBox["B", "s"]}], "=", 
