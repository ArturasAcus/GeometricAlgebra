                ")"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"gradeA2", ",", "gradeB2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"a2", ",", "b2"}], "}"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "testAlgebra"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "testAlgebra"}], ")"}]}]}], "}"}]}], "]"}], 
