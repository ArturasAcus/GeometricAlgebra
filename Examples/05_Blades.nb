Cell[TextData[{
 " r>s case, A1 and B1 are general multivectors. We need grade-r and grade-s \
blades only. Take r=3 and s=2, thens s (r-1)=4 and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "1"}], ")"}], 
    RowBox[{"s", "(", 
     RowBox[{"r", "-", "1"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "fe6eeed8-eb7e-4b36-a669-5cb1aa107e02"],
 " = 1"
}], "Text",
