Cell[TextData[{
 "d) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["A", "r"], "\[InnerProduct]", 
     SubscriptBox["B", "s"]}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"s", "(", 
        RowBox[{"r", "-", "1"}], ")"}]], 
      SubscriptBox["B", "s"]}], "\[InnerProduct]", 
     SubscriptBox["A", "r"]}]}], TraditionalForm]],ExpressionUUID->
  "2a22b2c4-57b3-4343-b595-9b409a7538b0"],
