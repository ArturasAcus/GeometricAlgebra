Cell[BoxData[
 RowBox[{
  RowBox[{"differentResults", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a2", "=", 
             RowBox[{"A2", "[", "r", "]"}]}], ",", 
            RowBox[{"b2", "=", 
             RowBox[{"B2", "[", "s", "]"}]}], ",", "gradeA2", ",", 
            "gradeB2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"gradeA2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "a2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeB2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "b2", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"a2", "\[InnerProduct]", "b2"}], "-", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"gradeB2", "*", 
                   RowBox[{"(", 
                    RowBox[{"gradeA2", "-", "1"}], ")"}]}], ")"}]}], "*", 
                "b2"}], "\[InnerProduct]", "a2"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"gradeA2", ",", "gradeB2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"a2", ",", "b2"}], "}"}]}], "}"}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "testAlgebra"}], ")"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"Plus", "@@", "testAlgebra"}], ")"}]}]}], "}"}]}], "]"}], 
      ",", "1"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "___"}], "}"}]}], "]"}]}]], "Input",
