Cell[TextData[{
 "b) inverse of blade ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     SubscriptBox["A", "r"], 
     RowBox[{"-", "1"}]], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r", "(", 
