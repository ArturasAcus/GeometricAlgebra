Cell[CellGroupData[{

Cell[TextData[{
 "f) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "\[OuterProduct]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["A", "r"], "\[GeometricProduct]", 
       SubscriptBox["B", "s"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "\[InnerProduct]", 
        SubscriptBox["A", "r"]}], ")"}], "\[GeometricProduct]", 
      SubscriptBox["B", "s"]}], "+", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "r"], 
       SubscriptBox["A", "r"]}], "\[GeometricProduct]", 
