        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}]}], "]"}], ",", "2"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "___"}], "}"}]}], "]"}]}]], "Input",
