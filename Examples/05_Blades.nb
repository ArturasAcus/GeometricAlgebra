           RowBox[{"gradeA2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "a2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeB2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "b2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeC2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "c2", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"gaPE", "[", 
               RowBox[{
                RowBox[{"a2", "\[OuterProduct]", 
