Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"differentResults", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a2", "=", "a1"}], ",", 
            RowBox[{"b2", "=", 
             RowBox[{"B2", "[", "s", "]"}]}], ",", 
            RowBox[{"c2", "=", 
             RowBox[{"F2", "[", "t", "]"}]}], ",", "gradeA2", ",", "gradeB2", 
            ",", "gradeC2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"gradeA2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "a2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeB2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "b2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeC2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "c2", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Expand", "[", 
              RowBox[{"gaPE", "[", 
               RowBox[{
                RowBox[{"a2", "\[InnerProduct]", 
                 RowBox[{"(", 
                  RowBox[{"b2", "\[GeometricProduct]", "c2"}], ")"}]}], "-", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"a2", "\[OuterProduct]", "b2"}], ")"}], "\[GeometricProduct]",
                  "c2"}], "+", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], "^", 
                   RowBox[{"(", "gradeB2", ")"}]}], "*", "b2"}], "\[GeometricProduct]", 
                 RowBox[{"(", 
                  RowBox[{"a2", "\[OuterProduct]", "c2"}], ")"}]}]}], "]"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"gradeA2", ",", "gradeB2", ",", "gradeC2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"a2", ",", "b2", ",", "c2"}], "}"}]}], "}"}]}]}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "2", ",", 
          RowBox[{
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], "+",
            "1"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}]}], "]"}], ",", "2"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "___"}], "}"}]}], "]"}]}]], "Input",
