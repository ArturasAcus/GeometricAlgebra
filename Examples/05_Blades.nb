Cell[BoxData[
 RowBox[{
  RowBox[{"differentResults", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a2", "=", 
             RowBox[{"A2", "[", "r", "]"}]}], ",", 
            RowBox[{"b2", "=", 
             RowBox[{"B2", "[", "s", "]"}]}], ",", 
            RowBox[{"c2", "=", 
             RowBox[{"F2", "[", "t", "]"}]}], ",", "gradeA2", ",", "gradeB2", 
            ",", "gradeC2"}], "}"}], ",", 
          RowBox[{
           RowBox[{"gradeA2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "a2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeB2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "b2", "]"}], "]"}]}], ";", 
           RowBox[{"gradeC2", "=", 
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", "c2", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
              "a2", "\[OuterProduct]", "b2", "\[OuterProduct]", "c2"}], "-", 
              RowBox[{"gaGetMV", "[", 
               RowBox[{
                RowBox[{
                "a2", "\[GeometricProduct]", "b2", "\[GeometricProduct]", 
                 "c2"}], ",", 
                RowBox[{"{", 
                 RowBox[{"gradeA2", "+", "gradeB2", "+", "gradeC2"}], "}"}]}],
                "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"gradeA2", ",", "gradeB2", ",", "gradeC2"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"a2", ",", "b2", ",", "c2"}], "}"}]}], "}"}]}]}], "]"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "}"}]}], "]"}], ",", "2"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "___"}], "}"}]}], "]"}]}]], "Input",
