Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"gaGradeList", "[", 
            RowBox[{"lA1", "[", 
             RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"First", "[", 
             RowBox[{"gaGradeList", "[", 
              RowBox[{"lB1", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "-", "1"}], 
           ")"}]}], ")"}]}], "*", 
       RowBox[{"lB1", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "\[RightContract]", 
      RowBox[{"lA1", "[", 
       RowBox[{"[", "j", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "lB1", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", 
       RowBox[{"Length", "[", "lA1", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.682925676181833*^9, 3.682925683142771*^9}, {
