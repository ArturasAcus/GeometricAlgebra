       SubscriptBox["A", "r"], 
       SubscriptBox["B", "s"]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"a", "\[LeftContract]", 
          SubscriptBox["A", "r"]}], ")"}], "\[GeometricProduct]", 
