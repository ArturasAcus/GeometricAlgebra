               RowBox[{"a2", "\[InnerProduct]", "b2"}], "\[GeometricProduct]", 
               RowBox[{"gaInverse", "[", 
                RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}]}], "-", 
              RowBox[{"a2", "\[OuterProduct]", 
               RowBox[{"(", 
