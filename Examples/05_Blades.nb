Cell[TextData[{
 "b) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["A", "r"], "\[OuterProduct]", " ", "a"}], ")"}], "\[InnerProduct]",
      "b"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["A", "r"], "\[GeometricProduct]", 
