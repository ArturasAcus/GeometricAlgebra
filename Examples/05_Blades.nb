           RowBox[{"lB1", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], "*", 
         RowBox[{"First", "[", 
          RowBox[{"gaGradeList", "[", 
           RowBox[{"lA1", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "]"}], "]"}]}], ")"}]}], "*", 
      RowBox[{"OuterProduct", "[", 
       RowBox[{
        RowBox[{"lB1", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"lA1", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "lB1", "]"}]}], "}"}], ",", 
