    RowBox[{"a", ",", "testAlgebra"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", "0", "]"}], "->", "2"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "4", "]"}], "->", "3"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "20", "]"}], "->", "5"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "50", "]"}], "->", "7"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "_", "]"}], ":>", "0"}]}], "}"}]}]}]], "Input",
