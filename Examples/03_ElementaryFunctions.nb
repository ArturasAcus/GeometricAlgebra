  RowBox[{"testAlgebra", ",", 
   RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testMV", "[", "testAlgebra", "]"}], "=", 
