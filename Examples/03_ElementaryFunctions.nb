      RowBox[{"Catch", "[", 
       RowBox[{"While", "[", 
        RowBox[{"test", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"test", "=", 
           RowBox[{"SquareFreeQ", "[", 
            RowBox[{"gaMinimalPolynomial", "[", 
             RowBox[{
              RowBox[{"generatedRND", "=", 
               RowBox[{"gaRandomMultivector", "[", 
                RowBox[{"alg", ",", 
