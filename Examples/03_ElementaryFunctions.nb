          RowBox[{
           RowBox[{
            RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
            RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}]}], "+", 
           RowBox[{
            RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
            RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}]}], "-", 
           "1"}], "//", "gaPE"}], ")"}], "//.", 
        RowBox[{"(", 
         RowBox[{"Reverse", "/@", "rules2aPaR"}], ")"}]}], ")"}], "//.", 
