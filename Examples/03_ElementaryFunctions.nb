            RowBox[{"{", 
             RowBox[{"$MachineEpsilon", ">", "x", ">", "0"}], "}"}], ",", 
            RowBox[{"Simplify", "[", 
             RowBox[{"gaExpOfMV", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
