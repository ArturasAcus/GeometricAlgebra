Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rndRules", "[", "testAlgebra", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"#", "->", 
       RowBox[{"RandomInteger", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], "&"}], "/@", 
    RowBox[{"(", 
     RowBox[{"a", "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
          ")"}]}]}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"origMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"a", ",", "testAlgebra"}], "]"}], "/.", 
   RowBox[{"rndRules", "[", "testAlgebra", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logOfMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"gaLogOfMV", "[", 
     RowBox[{
      RowBox[{"origMV", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ")"}], "//", 
   "gaPE"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expOfLogOfMV", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaExpOfMV", "[", 
   RowBox[{"logOfMV", "[", "testAlgebra", "]"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"origMV", "[", "testAlgebra", "]"}], "-", 
    RowBox[{"gaPE", "[", 
     RowBox[{"expOfLogOfMV", "[", "testAlgebra", "]"}], "]"}]}], ",", 
