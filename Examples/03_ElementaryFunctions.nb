Cell[BoxData[
 RowBox[{
  RowBox[{"rules2aSaI", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", 
      RowBox[{"-", "aI"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", "aI"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"a", "[", "1", "]"}], "2"]}], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", 
      RowBox[{"-", "aS"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"a", "[", "1", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", "aS"}]}], 
    "}"}]}], ";", 
  RowBox[{"rules2aPaR", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["aI", 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}]]}]], "\[Rule]", "aPP"}], ",", 
     RowBox[{
      FractionBox[
       SuperscriptBox["aI", "2"], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}], ")"}]}]], "\[Rule]", 
      RowBox[{"aPP", "^", "2"}]}], ",", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}]], 
       SqrtBox["2"]], "\[Rule]", "aRR"}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}], ")"}]}], "\[Rule]", 
      RowBox[{"aRR", "^", "2"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"698c954f-0cc4-4638-ae5c-2681fbff889a"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}]]}], "-", 
   RowBox[{
    FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", " ", "x"}]]}]}]], "Output",
  CellChangeTimes->{3.8199505636180143`*^9},ExpressionUUID->
  "35f03943-6644-41b7-915b-b935b4983797"],
 " and replace imaginary i by pseudoscalar"
}], "Text",ExpressionUUID->"7cfbde4b-c294-4b23-8512-78012bf5ef0c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaPE", "[", 
        RowBox[{
         RowBox[{"gaI", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"gaExpOfMV", "[", 
                RowBox[{"gaPE", "[", 
                 RowBox[{
                  RowBox[{"testMV", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
                  RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"gaExpOfMV", "[", 
               RowBox[{"gaPE", "[", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"testMV", "[", "testAlgebra", "]"}]}], "\[GeometricProduct]", 
                 RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
           "2"}], ")"}]}], "]"}], "//.", "rules2aSaI"}], ")"}], "//.", 
     "rules2aPaR"}], ",", "_\[DoubleStruckE]", ",", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ExpToTrig", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"TrigToExp", "[", "#", "]"}], "]"}], "]"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8638559894222393`*^9, 3.8638560063887463`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"dec11b8f-3e6b-4419-be48-c25774681fa5"],

