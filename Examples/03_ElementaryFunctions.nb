Cell[TextData[{
 "Compare with Mathematica\[CloseCurlyQuote]s internal ",
 StyleBox["MatrixExp[ ]",
  FontWeight->"Bold"],
 " . First, define matrix representation with real/complex entries (the \
algebra Cl[2,4] by default is represented by quaternionic matrices, see \
8-fold table)"
}], "Text",
