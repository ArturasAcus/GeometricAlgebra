      RowBox[{"b", "[", 
       RowBox[{"1", "|", "2", "|", "3", "|", "4", "|", "5", "|", "6"}], "]"}],
       "\[RuleDelayed]", "0"}]}], "}"}]}], ";"}], "\n", 
