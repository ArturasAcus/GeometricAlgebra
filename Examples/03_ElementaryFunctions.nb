Cell["\<\
So, precision of numerical inverse check is very high. Now Tan. Note, that, \
since N is applied before expansion, the exact expressions are converted to \
approximate, since otherwise expansion will take very long.\
\>", "Text",
 CellChangeTimes->{{3.8638570334086*^9, 
  3.8638570344674177`*^9}},ExpressionUUID->"082b945b-3237-40e5-a233-\
812b6566d89b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"tanFormExactRezultNr", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Expand", "[", 
   RowBox[{"gaPE", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaSinOfMVN", "[", "testAlgebra", "]"}], "//", "N"}], ")"}], 
     "\[GeometricProduct]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaCosOfMVInvN", "[", "testAlgebra", "]"}], "//", "N"}], 
      ")"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.863856918343626*^9, 3.8638569259826*^9}},
 CellLabel->
  "In[688]:=",ExpressionUUID->"e40cac14-f288-474b-b3a1-152520e82000"],

