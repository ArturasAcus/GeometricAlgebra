Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rndReplRules", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"b", "[", "0", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "7", "]"}], "\[Rule]", 
      RowBox[{"-", "2"}]}], ",", 
     RowBox[{
      RowBox[{"b", "[", 
       RowBox[{"1", "|", "2", "|", "3", "|", "4", "|", "5", "|", "6"}], "]"}],
       "\[RuleDelayed]", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"orig", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
   RowBox[{
   "rndReplRules", "[", "testAlgebra", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logOfOrig", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"gaPE", "[", 
     RowBox[{"gaLogOfMV", "[", 
      RowBox[{
       RowBox[{"orig", "[", "testAlgebra", "]"}], ",", 
       RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], ",", 
    "_\[DoubleStruckE]", ",", "Simplify"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"logOfOrigFreeMVCF", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{"gaPE", "[", 
      RowBox[{"gaLogOfMV", "[", 
       RowBox[{
        RowBox[{"orig", "[", "testAlgebra", "]"}], ",", 
        RowBox[{"Method", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"gaFormula", "->", "\"\<LowDimension\>\""}]}], "}"}]}], 
        ",", 
        RowBox[{"gaIncludeFreeMV", "\[Rule]", "True"}], ",", 
        RowBox[{"Quiet", "\[Rule]", "False"}]}], "]"}], "]"}], "]"}], ",", 
    "_\[DoubleStruckE]", ",", "FullSimplify"}], "]"}]}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
