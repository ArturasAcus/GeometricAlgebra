Cell["\<\
Check each case separately: simplification and limit can take very long time.\
\
\>", "Text",ExpressionUUID->"c6b7d8d5-73fd-4ed2-8bee-23e832d9dd45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"toExponentiateExpRaw", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"gaExpOfMV", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "/.", 
                RowBox[{
                 RowBox[{"Hold", "[", 
                  RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                 RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
              RowBox[{"generateRandomParameters", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], "//", "gaPE"}], 
          ")"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "/.", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", ":", 
                RowBox[{"(", 
                 RowBox[{"Cos", "|", "Cosh", "|", "Sin", "|", "Sinh"}], 
                 ")"}]}], ")"}], "[", "xx_", "]"}], "\[RuleDelayed]", 
             RowBox[{"Simplify", "[", 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"Apart", "[", 
                 RowBox[{
                  RowBox[{"xx", "/.", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Power", "[", 
                    RowBox[{"z_", ",", 
                    RowBox[{"n", ":", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"1", "/", "2"}], "|", 
                    RowBox[{
                    RowBox[{"-", "1"}], "/", "2"}]}], ")"}]}]}], "]"}], 
                    "\[RuleDelayed]", 
                    RowBox[{"Power", "[", 
                    RowBox[{
                    RowBox[{"Simplify", "[", 
                    RowBox[{"z", ",", 
                    RowBox[{"Assumptions", "\[Rule]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"x", ">", "0"}], ",", 
                    RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}],
                     ",", "n"}], "]"}]}], "}"}]}], ",", 
                  RowBox[{"Trig", "\[Rule]", "True"}]}], "]"}], "]"}], ",", 
               RowBox[{"Assumptions", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"x", ">", "0"}], "&&", 
                  RowBox[{"x", "<", "1"}]}], "}"}]}]}], "]"}]}]}], ")"}], 
          "&"}]}], "]"}], ")"}], "&"}], "/@", 
     RowBox[{"(", 
      RowBox[{"testtableSpec", "[", "testAlgebra", "]"}], ")"}]}]}], ")"}], "//",
   "LeafCount"}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10009.},
 CellChangeTimes->{
  3.863841001939505*^9, {3.863841097516436*^9, 3.863841115126316*^9}, 
   3.863841336359705*^9},
 CellLabel->
  "In[164]:=",ExpressionUUID->"0264c481-b0aa-41c1-9455-05c53cdcae2c"],

