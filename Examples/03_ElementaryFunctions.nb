Cell["\<\
If automatic simplification below will not give 0, then manual investigation \
is necessary, since Mathematica not always can compute the limit without \
help. If that is not the case, then most probably added free MV needs \
correction (is too general)\
\>", "Text",ExpressionUUID->"0982e13e-b97e-47cf-ba39-0451e0fc9b5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"gaPE", "[", 
          RowBox[{"Assuming", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"$MachineEpsilon", ">", "x", ">", "0"}], "}"}], ",", 
            RowBox[{"Simplify", "[", 
             RowBox[{"gaExpOfMV", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "/.", 
                 RowBox[{
                  RowBox[{"Hold", "[", 
                   RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                  RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
               RowBox[{"generateRandomParameters", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
           "]"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"y", ",", 
           RowBox[{"Limit", "[", 
            RowBox[{
             RowBox[{"PowerExpand", "[", 
              RowBox[{"TrigToExp", "[", 
               RowBox[{"Simplify", "[", "y", "]"}], "]"}], "]"}], ",", 
             RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], "]"}]}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "_\[DoubleStruckE]", ",", 
      "Simplify"}], "]"}], ")"}], "&"}], "/@", 
  RowBox[{"testcl01tableSpec", "[", "testAlgebra", "]"}]}]], "Input",
 CellChangeTimes->{{3.8635809591405087`*^9, 3.863580960069734*^9}, 
   3.863580996755735*^9},
 CellLabel->
  "In[436]:=",ExpressionUUID->"287eb27d-2bcb-479b-aac9-904547f4f6b1"],

