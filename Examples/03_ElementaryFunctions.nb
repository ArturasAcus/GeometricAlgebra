 RowBox[{
  RowBox[{"gpSeriesAnswer", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
