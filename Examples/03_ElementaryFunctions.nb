Cell[TextData[{
 "We see that despite the determinant norm is less that ",
 Cell[BoxData[
  FractionBox[
   SqrtBox["7"], "6"]], "Output",
  CellChangeTimes->{3.86358148288124*^9},ExpressionUUID->
  "811b7933-d860-4ccd-8b6c-4f8d1a54ddf8"],
 "<1 , the series don\[CloseCurlyQuote]t converge because determinant itself \
is negative ",
 Cell[BoxData[
  RowBox[{"-", 
   FractionBox["5", "36"]}]], "Output",
  CellChangeTimes->{3.863581457462734*^9},ExpressionUUID->
  "fc99e807-bbe2-48e2-8df8-509d4302f99e"],
 "<0"
}], "Text",
