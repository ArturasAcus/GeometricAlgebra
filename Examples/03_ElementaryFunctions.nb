Cell[CellGroupData[{

Cell["Load main notebook", "Subsection",ExpressionUUID->"38be66f6-bfaf-46a3-bdbb-1fa2cd1350af"],

Cell[TextData[{
 "Load package. ",
 StyleBox["WAIT",
  FontWeight->"Bold"],
 " until evaluation of cell is finished to be sure that no errors were \
produced."
}], "Text",ExpressionUUID->"ecc709ea-5367-4c40-a3f1-49e59033e219"],

Cell[BoxData[
 RowBox[{"NotebookEvaluate", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ParentDirectory", "[", 
      RowBox[{"NotebookDirectory", "[", 
       RowBox[{"EvaluationNotebook", "[", "]"}], "]"}], "]"}], ",", 
     "\"\<GA.nb\>\""}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"a845aa51-1390-4531-a67b-b4137eff02ff"],

Cell[TextData[{
 "Subsection numbers refer to logical units of \
\[OpenCurlyDoubleQuote]Geometric algebra handbook\[CloseCurlyDoubleQuote] (in \
preparation). Algorithms for exact formulas are named as ",
 StyleBox["gaFunctionOfMV[ Function,MV,options]",
  FontWeight->"Bold"],
 ", where ",
 StyleBox["Function",
  FontWeight->"Bold"],
 " can be ",
 StyleBox["Sqrt, Exp, Log, ArcTanh",
  FontWeight->"Bold"],
 " (+other hyperbolic and their inverses), ",
 StyleBox["ArcSin",
  FontWeight->"Bold"],
 " (+other trigonometric and their inverses when they can be defined, i.e in \
Cl(3,0), for example), as well as other elementary and special functions. \
Exact formulas are available for p+q\[LessEqual]3. For higher dimensions only \
series expansions are available."
}], "Text",
 CellChangeTimes->{{3.863223541131052*^9, 3.8632235685855227`*^9}, {
  3.863838876995818*^9, 
  3.863838908435152*^9}},ExpressionUUID->"a1469e2b-4277-4d73-bfe9-\
4bc06f8b396b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Definitions and shortcuts", "Subsection",ExpressionUUID->"9be816cf-d5d7-42bb-b4b7-8758e92f35be"],

Cell["\<\
Some shortcuts for vectors and bivectors, which will be used for compact \
formula tastings. Note, testAlgebra keyword\
\>", "Text",ExpressionUUID->"51c1d839-2ac8-4c21-908b-c23c3e8638bd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "vectors", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"a1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"a", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"b", ",", "testAlgebra", ",", 
       RowBox[{"{", "1", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
