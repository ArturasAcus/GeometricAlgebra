Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"PossibleZeroQ", "::", "ztest1"}], "]"}], ";", 
    RowBox[{
     RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
         "crandRules"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rndReplRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ")"}], 
               "&"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{
                   "gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
                   ")"}]}], "-", "1"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"orig", "=", 
             RowBox[{
              RowBox[{"gaGeneralMultivector", "[", 
               RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
              "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"gaSqrtOfMV", "[", 
            RowBox[{"orig", ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
             RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"logOfOrigFreeMVCF", "=", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{"gaLogOfMV", "[", 
               RowBox[{"orig", ",", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"Automatic", ",", 
                   
                   RowBox[{"\"\<gaFormula\>\"", 
                    "->", "\"\<LowDimension\>\""}]}], "}"}]}], ",", 
                RowBox[{"\"\<gaIncludeFreeMV\>\"", "\[Rule]", "True"}], ",", 
                RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], "]"}]}],
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"crandRules", "=", 
             RowBox[{
             "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
              "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{"gaPE", "[", 
                  RowBox[{
                   RowBox[{"gaExpOfMV", "[", 
                    RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], "]"}], 
                   "-", "orig"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
                 "PossibleZeroQ"}], "]"}], ",", "False"}], "]"}]}]}]}], "}"}],
          ",", 
         RowBox[{"{", "500", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ")"}], "//", "LeafCount"}]], "Input",
