Cell[BoxData[
 RowBox[{
  TagBox["\<\"Partial fraction decomposition {{root_i, \
{p_i===q_i^0,q_i,q^2_i,q^3_i,...}}...} yields\"\>",
   "EchoLabel"], "  ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], 
         RowBox[{"1", "/", "4"}]], " ", 
        SqrtBox["6"]}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], 
            RowBox[{"1", "/", "4"}]], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"6", " ", "\[ImaginaryI]"}]}], ")"}], "+", 
             RowBox[{
              SuperscriptBox[
