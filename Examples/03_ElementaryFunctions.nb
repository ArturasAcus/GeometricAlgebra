Cell[BoxData[
 RowBox[{"(", 
  RowBox[{
   RowBox[{"tanhFormExactRezultNl", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"(", 
    RowBox[{"Expand", "[", 
     RowBox[{"gaPE", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"gaCoshOfMVInvN", "[", "testAlgebra", "]"}], "//", "N"}], 
        ")"}], "\[GeometricProduct]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"gaSinhOfMVN", "[", "testAlgebra", "]"}], "//", "N"}], 
