Cell[TextData[{
 "For the element with magnitude squared negative we see, that the first sum, \
 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"cos", "|", "v", "|", 
    RowBox[{
     RowBox[{"+", 
      OverscriptBox["v", "^"]}], 
     RowBox[{"sin", "[", 
      RowBox[{"|", "v", "|"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "92ff48e5-5460-455e-b4df-1cd4437415ad"],
 " becomes zero. So the identity holds"
}], "Text",ExpressionUUID->"2f86b689-0dff-41a7-9339-f470f84b6d0c"],

