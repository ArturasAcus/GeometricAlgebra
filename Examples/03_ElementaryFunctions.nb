 RowBox[{"toExponentiateExpLim", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", "_\[DoubleStruckE]", ",", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{"Limit", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "//", "PowerExpand"}], "//", "Apart"}], ",", 
          RowBox[{"x", "\[Rule]", "0"}]}], "]"}], "]"}], "&"}]}], "]"}], 
