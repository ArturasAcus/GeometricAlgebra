        RowBox[{"Method", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<CoordinateFree\>\"", ",", 
           RowBox[{"\"\<gaFormula\>\"", "->", " ", "\"\<LowDimension\>\""}]}],
           "}"}]}]}], "]"}], ",", 
