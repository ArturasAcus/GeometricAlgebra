   RowBox[{
    RowBox[{"testMVSimple", "[", "testAlgebra", "]"}], ",", "x"}], "]"}], "//",
   "Factor"}], "\[IndentingNewLine]", 
 RowBox[{"SquareFreeQ", "[", "%", "]"}]}], "Input",
