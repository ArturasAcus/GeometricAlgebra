Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gaCoshOfMVN", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"gaExpOfMV", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
            ")"}], "/.", 
           RowBox[{"rndReplRules", "[", "testAlgebra", "]"}]}], "]"}], "+", 
         RowBox[{"gaExpOfMV", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
