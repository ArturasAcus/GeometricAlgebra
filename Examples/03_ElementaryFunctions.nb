Cell[TextData[{
 "For the element with magnitude squared positive we see that the second and \
third sum (with hyperbolic trigonometric functions),  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"cosh", "|", "v", "|", 
    RowBox[{
     RowBox[{"+", 
      OverscriptBox["v", "^"]}], 
     RowBox[{"sinh", "[", 
      RowBox[{"|", "v", "|"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "b7372cec-4e39-4ee4-bf93-ac1a3812cbc7"],
 " becomes zero. "
}], "Text",ExpressionUUID->"700c5776-49b8-44e3-affe-4de1b68d911d"],

