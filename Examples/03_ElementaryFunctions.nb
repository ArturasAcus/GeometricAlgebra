Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], ",", 
      RowBox[{"lim", "=", "5"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"unrestrictedParamRules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}],
        "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"allC2", ",", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "1"}], "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "2"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParams", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"allC2", ",", 
        RowBox[{"C", "[", 
         RowBox[{"_", ",", "3"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParamsRules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{"restrictedParams", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ceiling", "[", 
                 RowBox[{
                  RowBox[{"Sqrt", "[", 
                   RowBox[{
                    SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "1"}], "]"}], "2"], "+", 
                    SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "2"}], "]"}], "2"]}], "]"}], "+", "1"}],
                  "]"}], ")"}], "/.", "unrestrictedParamRules"}], ",", 
              RowBox[{"2", 
               RowBox[{"lim", "^", "2"}]}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", "restrictedParams"}], ")"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"unrestrictedParamRules", ",", "restrictedParamsRules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[550]:=",ExpressionUUID->"6b229a47-9c9a-495f-8f03-da9e981695a2"],

