Cell[BoxData[
 RowBox[{
  RowBox[{"toExponentiateExpSimplFin", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", "_\[DoubleStruckE]", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{
           RowBox[{"PowerExpand", "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"Numerator", "[", "#", "]"}], ",", 
                RowBox[{"Assumptions", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", ">", "0"}], ",", 
                   RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}], 
              "/", 
              RowBox[{"Simplify", "[", 
               RowBox[{
                RowBox[{"Denominator", "[", "#", "]"}], ",", 
                RowBox[{
                 RowBox[{"Assumptions", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"x", ">", "0"}], ",", 
                    RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}], "&"}]}],
                "]"}]}], ")"}], "]"}], ",", 
           RowBox[{"Assumptions", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"x", ">", "0"}], ",", 
              RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}], 
         "&"}], "[", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Together", "[", "#", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Power", "[", 
             RowBox[{"z_", ",", 
              RowBox[{"n", ":", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "|", 
                 RowBox[{
                  RowBox[{"-", "1"}], "/", "2"}]}], ")"}]}]}], "]"}], 
            "\[RuleDelayed]", 
            RowBox[{"Power", "[", 
             RowBox[{
              RowBox[{"FullSimplify", "[", 
               RowBox[{"z", ",", 
                RowBox[{"Assumptions", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", ">", "0"}], ",", 
                   RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}], 
              ",", "n"}], "]"}]}], "}"}]}], ")"}], "]"}], "&"}]}], "]"}], 
    "&"}], "/@", 
   RowBox[{"toExponentiateExpSimpl", "[", "testAlgebra", "]"}]}]}]], "Input",
 Evaluatable->False,
 CellGroupingRules->{"GroupTogetherGrouping", 10009.},
