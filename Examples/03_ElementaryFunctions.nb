       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"f_", "[", "x_", "]"}], "\[RuleDelayed]", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", "*", "\[Alpha]"}], "]"}], ",", 
             RowBox[{"{", 
