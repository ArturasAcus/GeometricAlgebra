Cell["\<\
Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside \
generateRandomParameters[]\
\>", "Text",ExpressionUUID->"7eddeaf5-b516-417d-99c6-c6fa28f41852"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], ",", 
      RowBox[{"lim", "=", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"#", "->", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}], "/@",
      "allC2"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[663]:=",ExpressionUUID->"21fbaf38-9217-4f08-8c4f-9a463409f7da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"PossibleZeroQ", "::", "ztest1"}], "]"}], ";", 
    RowBox[{
     RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
         "crandRules"}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rndReplRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ")"}], 
               "&"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", "7"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"orig", "=", 
             RowBox[{
              RowBox[{"gaGeneralMultivector", "[", 
               RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
              "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"gaSqrtOfMV", "[", 
            RowBox[{"orig", ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
             RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"logOfOrigFreeMVCF", "=", 
            RowBox[{"Collect", "[", 
             RowBox[{
              RowBox[{"gaPE", "[", 
               RowBox[{"gaLogOfMV", "[", 
                RowBox[{"orig", ",", 
                 RowBox[{"Method", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"Automatic", ",", 
                    
                    RowBox[{"\"\<gaFormula\>\"", 
                    "->", "\"\<LowDimension\>\""}]}], "}"}]}], ",", 
                 RowBox[{"\"\<gaIncludeFreeMV\>\"", "\[Rule]", "True"}], ",", 
                 
                 RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], ",", 
              "_\[DoubleStruckE]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"crandRules", "=", 
             RowBox[{
             "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
              "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{"gaPE", "[", 
                  RowBox[{
                   RowBox[{"gaExpOfMV", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], ",", 
                    "20"}], "]"}], "]"}], "-", 
                   RowBox[{"N", "[", 
                    RowBox[{"orig", ",", "20"}], "]"}]}], "]"}], ",", 
                 "_\[DoubleStruckE]", ",", "PossibleZeroQ"}], "]"}], ",", 
               "False"}], "]"}]}]}]}], "}"}], ",", 
         RowBox[{"{", "500", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ")"}], "//", "LeafCount"}]], "Input",
 CellChangeTimes->{
