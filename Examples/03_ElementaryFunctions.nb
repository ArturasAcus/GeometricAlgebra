 RowBox[{
  RowBox[{
   RowBox[{"Cos", "[", "aPP", "]"}], " ", 
   RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
   RowBox[{"Cosh", "[", 
    RowBox[{"a", "[", "7", "]"}], "]"}], " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"a", "[", "0", "]"}], "]"}]}], "+", 
  RowBox[{
   RowBox[{"Cos", "[", 
    RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
