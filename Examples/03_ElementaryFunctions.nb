Cell["\<\
Since they commute, we can compute cosh inverse: the answer is quite large\
\>", "Text",ExpressionUUID->"37f73ba1-1fcb-44f8-b09e-ef10831586e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gaCosOfMVInv", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"gaInverse", "[", 
     RowBox[{
      RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"Method", "\[Rule]", "\"\<Involutions\>\""}]}], "]"}]}], ")"}], 
  "//", "LeafCount"}]], "Input",
 CellChangeTimes->{{3.863856855637414*^9, 3.863856858083374*^9}, {
  3.9733336987170143`*^9, 3.973333708708825*^9}},
