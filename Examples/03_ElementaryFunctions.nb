 CellLabel->
  "Out[681]=",ExpressionUUID->"755f0d2b-2bab-4a3b-83aa-9390a4b6620d"]
}, Open  ]],

Cell["\<\
Since they commute, we can compute cosh inverse: the answer is quite large\
\>", "Text",ExpressionUUID->"37f73ba1-1fcb-44f8-b09e-ef10831586e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gaCosOfMVInv", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"gaInverse", "[", 
     RowBox[{
      RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"Method", "\[Rule]", "\"\<Involutions\>\""}], ",", 
      RowBox[{"Expand", "\[Rule]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"gaPE", "[", "#", "]"}], "]"}], "&"}], ")"}]}]}], "]"}]}], 
   ")"}], "//", "LeafCount"}]], "Input",
 CellChangeTimes->{{3.863856855637414*^9, 3.863856858083374*^9}},
 CellLabel->
  "In[682]:=",ExpressionUUID->"c358b5cb-b2b8-4f4c-a538-353f845552c9"],

Cell[BoxData["315952"], "Output",
 CellChangeTimes->{3.863856890964563*^9, 3.8865645634727917`*^9, 
  3.927180167225533*^9},
 CellLabel->
  "Out[682]=",ExpressionUUID->"5b983b16-5936-4ea9-9ec9-02b7808c424c"]
}, Open  ]],

Cell["\<\
Check for safety, that it also commutes both with sing and cosh\
\>", "Text",ExpressionUUID->"1a42d9fd-b65f-40e9-a1b1-9a3d3e194dcf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gaCommutatorExpand", "[", 
     RowBox[{"1", "/", "2"}], "]"}], "[", 
    RowBox[{"gaCommutator", "[", 
     RowBox[{
      RowBox[{"gaCosOfMVInv", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}]}], "]"}], 
    "]"}], "//", "gaPE"}], "//", "Expand"}]], "Input",
