Cell[CellGroupData[{

Cell["\<\
Massive test (inactivated, since simplification of specific MV may require \
adaptation in the simplification step)\
\>", "Item",
 CellChangeTimes->{{3.863843541906973*^9, 3.86384354672008*^9}, 
   3.886489592950392*^9, 3.8865621564400587`*^9, {3.88656237537584*^9, 
   3.886562439721387*^9}},ExpressionUUID->"91b71b30-1670-4e93-be63-\
6c2b0ae4ae29"],

Cell["\<\
Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside \
generateRandomParameters[]\
\>", "Text",ExpressionUUID->"6acda467-88cb-445d-bb91-7ca639be33c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"lim", "=", "5"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"unrestrictedParamRules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}],
        "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"allC2", ",", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "1"}], "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "2"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParams", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"allC2", ",", 
        RowBox[{"C", "[", 
         RowBox[{"_", ",", "3"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParamsRules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{"restrictedParams", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ceiling", "[", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "1"}], "]"}], "2"], "+", 
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "2"}], "]"}], "2"]}], "]"}], "]"}], 
                ")"}], "/.", "unrestrictedParamRules"}], ",", 
              RowBox[{"2", "*", 
               RowBox[{"lim", "^", "2"}]}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", "restrictedParams"}], ")"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"unrestrictedParamRules", ",", "restrictedParamsRules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 Evaluatable->False,
 CellLabel->
  "In[172]:=",ExpressionUUID->"363d3137-f6bf-45a2-84cb-07938e7da753"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"PossibleZeroQ", "::", "ztest1"}], "]"}], ";", 
    RowBox[{
     RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
         "crandRules"}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rndReplRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ")"}], 
               "&"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{
                  "gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
                  ")"}]}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"orig", "=", 
             RowBox[{
              RowBox[{"gaGeneralMultivector", "[", 
               RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
              "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"gaSqrtOfMV", "[", 
            RowBox[{"orig", ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
             RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"logOfOrigFreeMVCF", "=", 
            RowBox[{"Collect", "[", 
             RowBox[{
              RowBox[{"gaPE", "[", 
               RowBox[{"gaLogOfMV", "[", 
                RowBox[{"orig", ",", 
                 RowBox[{"Method", "\[Rule]", 
                  RowBox[{"{", 
                   RowBox[{"Automatic", ",", 
                    RowBox[{"gaFormula", "->", "\"\<LowDimension\>\""}]}], 
                   "}"}]}], ",", 
                 RowBox[{"gaIncludeFreeMV", "\[Rule]", "True"}], ",", 
                 RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], ",", 
              "_\[DoubleStruckE]"}], "]"}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"crandRules", "=", 
             RowBox[{
             "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
              "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{"gaPE", "[", 
                  RowBox[{
                   RowBox[{"gaExpOfMV", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], ",", 
                    "20"}], "]"}], "]"}], "-", 
                   RowBox[{"N", "[", 
                    RowBox[{"orig", ",", "20"}], "]"}]}], "]"}], ",", 
                 "_\[DoubleStruckE]", ",", "PossibleZeroQ"}], "]"}], ",", 
               "False"}], "]"}]}]}]}], "}"}], ",", 
         RowBox[{"{", "500", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ")"}], "//", "LeafCount"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{
  3.86384048970854*^9, {3.863840722772736*^9, 3.8638407326101*^9}, {
   3.863840764912805*^9, 3.863840830975337*^9}, 3.863840876471869*^9, 
   3.863842051562831*^9},
 CellLabel->
  "In[183]:=",ExpressionUUID->"81e8b73d-8f82-4355-bb63-99355765659e"],

