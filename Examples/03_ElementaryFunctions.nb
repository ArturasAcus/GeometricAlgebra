Cell[BoxData[
 RowBox[{
  RowBox[{"chappelExp", "[", "exp_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{"exp", ",", 
         RowBox[{"{", "0", "}"}]}], "]"}]}], ",", 
      RowBox[{"v", "=", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{"exp", ",", 
         RowBox[{"{", "1", "}"}]}], "]"}]}], ",", 
      RowBox[{"jw", "=", 
       RowBox[{"gaPE", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "I"}], "*", 
          RowBox[{"gaI", "[", 
           RowBox[{"Cl", "[", 
            RowBox[{"3", ",", "0"}], "]"}], "]"}]}], "\[GeometricProduct]", 
         RowBox[{"gaGetMV", "[", 
          RowBox[{"exp", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}]}], ",", 
      RowBox[{"jt", "=", 
       RowBox[{"gaGetMV", "[", 
        RowBox[{"exp", ",", 
         RowBox[{"{", "3", "}"}]}], "]"}]}], ",", "fModule", ",", 
      "fCapital"}], "}"}], ",", 
    RowBox[{
     RowBox[{"fCapital", "=", 
      RowBox[{"(", 
       RowBox[{"v", "+", "jw"}], ")"}]}], ";", 
     RowBox[{"fModule", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"gaPE", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "v"}], "\[GeometricProduct]", "v"}], "-", 
         RowBox[{"jw", "\[GeometricProduct]", "jw"}], "-", 
         RowBox[{
          RowBox[{"2", "v"}], "\[InnerProduct]", "jw"}]}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Exp", "[", 
