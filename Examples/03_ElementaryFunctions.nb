    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
       RowBox[{"Cosh", "[", 
        RowBox[{"a", "[", "7", "]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "1", "]"}]}], "+", 
            RowBox[{"aRR", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
          RowBox[{"Sin", "[", "aPP", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"aRR", " ", 
             RowBox[{"a", "[", "1", "]"}]}], "-", 
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cos", "[", "aPP", "]"}], " ", 
          RowBox[{"Sinh", "[", "aRR", "]"}]}]}], ")"}]}], "+", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"a", "[", "0", "]"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "aRR"}], " ", 
             RowBox[{"a", "[", "1", "]"}]}], "+", 
            RowBox[{"aPP", " ", 
             RowBox[{"a", "[", "6", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cosh", "[", "aRR", "]"}], " ", 
