Cell[BoxData[
 TemplateBox[{
  "gaToMatrixRepresentation", "NotBottDimension", 
   "\"You are using matrix representation of algebra \
\\!\\(\\*TemplateBox[List[\\\"1\\\", \\\"2\\\", \\\"0\\\"], \\\"Cl\\\", \
Rule[DisplayFunction, Function[SubscriptBox[StyleBox[\\\"Cl\\\", \
List[Rule[FontColor, RGBColor[1.`, 0.6470588235294118`, 0.`]]]], \
RowBox[List[Slot[1], \\\",\\\", Slot[2]]]]]], Rule[Tooltip, None]]\\) that do \
not match dimensions \\!\\(\\*RowBox[{\\\"2\\\"}]\\), listed in Bott \
periodicity table. Conversion to/from matrix representation may need \
adjusting the option \\\"gaFieldFactor\\\" value. These representations are \
inapropriate for non-diagonalizable MVs\"", 2, 202, 23, 32564983112191757108, 
   "Local", "GeometricAlgebra`gaToMatrixRepresentation"},
