Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"gaPE", "[", 
          RowBox[{"Assuming", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"$MachineEpsilon", ">", "x", ">", "0"}], "}"}], ",", 
            RowBox[{"Simplify", "[", 
             RowBox[{"gaExpOfMV", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "/.", 
                 RowBox[{
                  RowBox[{"Hold", "[", 
                   RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                  RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
               RowBox[{"generateRandomParameters", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
           "]"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"y", ",", 
           RowBox[{"Limit", "[", 
            RowBox[{
             RowBox[{"PowerExpand", "[", 
              RowBox[{"TrigToExp", "[", 
               RowBox[{"Simplify", "[", "y", "]"}], "]"}], "]"}], ",", 
             RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], "]"}]}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "_\[DoubleStruckE]", ",", 
      "Simplify"}], "]"}], ")"}], "&"}], "/@", 
  RowBox[{"testtableSpec", "[", "testAlgebra", "]"}]}]], "Input",
