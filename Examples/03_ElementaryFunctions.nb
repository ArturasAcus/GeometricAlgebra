           RowBox[{"1", ",", "expansionOrder"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}], ",", "_\[DoubleStruckE]", ",", 
    RowBox[{
