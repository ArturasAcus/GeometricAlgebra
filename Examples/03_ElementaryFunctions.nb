Cell[BoxData[
 RowBox[{
  RowBox[{"coshFormExactRezultSeries", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"coshFormExactRezultForSeries", "[", "testAlgebra", "]"}], "//.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"f_", "[", "x_", "]"}], "\[RuleDelayed]", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", "*", "\[Alpha]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "0", ",", "expansionOrder"}], "}"}]}], 
            "]"}], "/;", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "Exp", ",", "Sin", ",", "Cos", ",", "Sinh", ",", "Cosh"}], 
              "}"}], ",", "f"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{"E", "^", "p_."}], "\[RuleDelayed]", 
          RowBox[{"Series", "[", 
           RowBox[{
            RowBox[{"Exp", "[", 
             RowBox[{"p", "*", "\[Alpha]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\[Alpha]", ",", "0", ",", "expansionOrder"}], "}"}]}], 
           "]"}]}]}], "}"}]}], ")"}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", "\[Rule]", "1"}], "}"}]}], "//", 
   "Expand"}]}]], "Input",
