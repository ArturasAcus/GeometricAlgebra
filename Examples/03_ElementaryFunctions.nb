         RowBox[{"[", 
          RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}]}], "//.", 
     "rules2aSaI"}], ")"}], "//.", "rules2aPaR"}]}]], "Input",
