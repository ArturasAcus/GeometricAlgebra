Cell["\<\
Check each case separately: simplification and limit can take very long time.\
\
\>", "Text",ExpressionUUID->"c6b7d8d5-73fd-4ed2-8bee-23e832d9dd45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"toExponentiateExpRaw", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"gaExpOfMV", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "/.", 
                RowBox[{
                 RowBox[{"Hold", "[", 
                  RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                 RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
              RowBox[{"generateRandomParameters", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}], "//", "gaPE"}], 
          ")"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"#", "/.", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"y", ":", 
                RowBox[{"(", 
