Cell["\<\
If automatic simplification below will not give 0, then manual investigation \
is necessary, since Mathematica not always can compute the limit without \
help. If that is not the case, then most probably added free MV needs \
correction (is too general)\
\>", "Text",ExpressionUUID->"d250dceb-47e3-41ee-a94d-c9a8785d271a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"gaPE", "[", 
          RowBox[{"Assuming", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"$MachineEpsilon", ">", "x", ">", "0"}], "}"}], ",", 
            RowBox[{"Simplify", "[", 
             RowBox[{"gaExpOfMV", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "/.", 
                 RowBox[{
                  RowBox[{"Hold", "[", 
                   RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                  RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
               RowBox[{"generateRandomParameters", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
           "]"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"y", ",", 
           RowBox[{"Limit", "[", 
            RowBox[{
             RowBox[{"PowerExpand", "[", 
              RowBox[{"TrigToExp", "[", 
               RowBox[{"Simplify", "[", "y", "]"}], "]"}], "]"}], ",", 
             RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], "]"}]}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "_\[DoubleStruckE]", ",", 
      "Simplify"}], "]"}], ")"}], "&"}], "/@", 
  RowBox[{"testtableSpec", "[", "testAlgebra", "]"}]}]], "Input",
 CellChangeTimes->{{3.863675569086636*^9, 3.863675597127048*^9}},
 CellLabel->
  "In[331]:=",ExpressionUUID->"13fe377e-235e-4d4f-ae26-dff8d00cd286"],

