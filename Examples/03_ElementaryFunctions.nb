 RowBox[{
  RowBox[{"expansionOrder", "=", "100"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gpSeriesAnswer", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
