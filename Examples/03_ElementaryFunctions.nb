Cell["Sinh: general case, replace complex expressions to simpler ", "Text",ExpressionUUID->"b5817547-c429-4dac-8744-a5fdee6fdd4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rules2aSaI", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", "aI"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"a", "[", "1", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", "aS"}]}], 
    "}"}]}], ";", 
  RowBox[{"rules2aPaR", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["aI", 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         RowBox[{"aS", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}]]}]], "\[Rule]", "aP"}], ",", 
     RowBox[{
      FractionBox[
       SuperscriptBox["aI", "2"], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"aS", "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}], ")"}]}]], "\[Rule]", 
      RowBox[{"aP", "^", "2"}]}], ",", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{"aS", "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}]], 
       SqrtBox["2"]], "\[Rule]", "aR"}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{"aS", "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}], ")"}]}], "\[Rule]", 
      RowBox[{"aR", "^", "2"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"4d19a889-e6f6-4ed5-bb7c-9dc87ed0ed94"],

