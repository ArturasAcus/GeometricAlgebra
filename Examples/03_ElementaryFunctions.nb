Cell["\<\
If automatic simplification below will not give 0, then manual investigation \
is necessary, since Mathematica not always can compute the limit without \
help. If that is not the case, then most probably added free MV needs \
correction (is too general)\
\>", "Text",ExpressionUUID->"749d6768-d540-44a0-b1a8-90dac1eb0db3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{"Collect", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"gaPE", "[", 
          RowBox[{"Assuming", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"$MachineEpsilon", ">", "x", ">", "0"}], "}"}], ",", 
            RowBox[{"Simplify", "[", 
             RowBox[{"gaExpOfMV", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "/.", 
                 RowBox[{
                  RowBox[{"Hold", "[", 
                   RowBox[{"Log", "[", "0", "]"}], "]"}], "\[Rule]", 
                  RowBox[{"Log", "[", "x", "]"}]}]}], ")"}], "/.", 
               RowBox[{"generateRandomParameters", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}], "]"}]}], 
           "]"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
         RowBox[{"Function", "[", 
          RowBox[{"y", ",", 
           RowBox[{"Limit", "[", 
            RowBox[{
             RowBox[{"PowerExpand", "[", 
              RowBox[{"TrigToExp", "[", 
               RowBox[{"Simplify", "[", "y", "]"}], "]"}], "]"}], ",", 
             RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], "]"}]}], "]"}], "-", 
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "_\[DoubleStruckE]", ",", 
      "Simplify"}], "]"}], ")"}], "&"}], "/@", 
  RowBox[{"testtableSpec", "[", "testAlgebra", "]"}]}]], "Input",
 CellChangeTimes->{{3.863674354528098*^9, 3.863674365981618*^9}},
 CellLabel->
  "In[478]:=",ExpressionUUID->"1a5468be-a960-4f73-997a-648c42e93510"],

