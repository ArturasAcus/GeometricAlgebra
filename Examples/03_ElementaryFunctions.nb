   RowBox[{
    RowBox[{"F1", ":=", 
     RowBox[{"gaGeneralMultivector", "[", 
      RowBox[{"F", ",", "testAlgebra"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaFindNonDiagonalizableMV", "[", "alg_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"test", "=", "True"}], ",", "generatedRND", ",", 
        RowBox[{"i", "=", "1"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Catch", "[", 
       RowBox[{"While", "[", 
        RowBox[{"test", ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"test", "=", 
           RowBox[{"SquareFreeQ", "[", 
            RowBox[{"gaMinimalPolynomial", "[", 
             RowBox[{
              RowBox[{"generatedRND", "=", 
               RowBox[{"gaRandomMultivector", "[", 
                RowBox[{"alg", ",", 
                 RowBox[{"CoefficientFunction", "\[Rule]", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"RandomInteger", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}], "&"}], 
                   ")"}]}]}], "]"}]}], ",", "x"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"ShowStatus", "[", 
           RowBox[{
            RowBox[{"ToString", "[", "test", "]"}], "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"i", "++"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "test"}], ",", 
            RowBox[{"Throw", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"gaComponentCoefficientList", "[", 
                RowBox[{"gaGeneralMultivector", "[", 
                 RowBox[{"a", ",", "alg"}], "]"}], "]"}], "->", 
               RowBox[{
               "gaComponentCoefficientList", "[", "generatedRND", "]"}]}], 
              "]"}], "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
