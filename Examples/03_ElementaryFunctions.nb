     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
        "crandRules"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rndReplRules", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], 
              "&"}], "/@", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"orig", "=", 
            RowBox[{
             RowBox[{"gaGeneralMultivector", "[", 
              RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
             "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"gaSqrtOfMV", "[", 
           RowBox[{"orig", ",", 
            RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
            RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"logOfOrigFreeMVCF", "=", 
