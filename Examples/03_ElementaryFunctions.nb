                    RowBox[{"-", "2"}], ",", "2"}], "}"}], "]"}], "&"}], 
                   ")"}]}]}], "]"}]}], ",", "x"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"showStatus", "[", 
           RowBox[{
            RowBox[{"ToString", "[", "test", "]"}], "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"i", "++"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
          
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "test"}], ",", 
            RowBox[{"Throw", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"gaComponentCoefficientList", "[", 
                RowBox[{"gaGeneralMultivector", "[", 
                 RowBox[{"a", ",", "alg"}], "]"}], "]"}], "->", 
               RowBox[{
               "gaComponentCoefficientList", "[", "generatedRND", "]"}]}], 
              "]"}], "\[IndentingNewLine]", "]"}]}], "]"}]}]}], 
        "\[IndentingNewLine]", "]"}], "]"}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
