       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"f_", "[", "x_", "]"}], "\[RuleDelayed]", 
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"x", "*", "\[Alpha]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Alpha]", ",", "0", ",", "expansionOrder"}], "}"}]}], 
            "]"}], "/;", 
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "Exp", ",", "Sin", ",", "Cos", ",", "Sinh", ",", "Cosh"}], 
              "}"}], ",", "f"}], "]"}]}]}], ",", 
