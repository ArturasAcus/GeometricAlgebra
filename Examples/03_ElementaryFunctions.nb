Cell["\<\
Since they commute, we can compute cosh inverse: the answer is quite large\
\>", "Text",ExpressionUUID->"10b33b4e-9b8d-48fd-aebd-76397dcb23b9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gaCoshOfMVInv", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"gaInverse", "[", 
     RowBox[{
      RowBox[{"gaCoshOfMVSimplified", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"Method", "\[Rule]", "\"\<Involutions\>\""}], ",", 
      RowBox[{"Expand", "\[Rule]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"gaPE", "[", "#", "]"}], "]"}], "&"}], ")"}]}]}], "]"}]}], 
   ")"}], "//", "LeafCount"}]], "Input",
