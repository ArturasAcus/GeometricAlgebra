Cell[CellGroupData[{

Cell["Ordinary trigonometric functions in  Cl(3,0)", "Subsubsection",ExpressionUUID->"4dc7c4be-6587-471a-8c38-d31d5631abfa"],

Cell["\<\
Ordinary trigonometric functions can be defined only for algebras for which \
I^2=-1, i.\[DoubleStruckE]. only for cl(3,0) and isomorphic cl(1,2).\
\>", "Text",ExpressionUUID->"41003f40-bc26-4c44-b595-125a2210a1d0"],

