Cell["\<\
At last tanh series. For tanh it is very important to divide by proper value \
(max coefficient of MV is not enough: it yields nonconvergent series!) \
\>", "Text",
 CellChangeTimes->{
  3.863856262529738*^9},ExpressionUUID->"d3ee576e-3804-4f2c-85d7-\
97d0ea7e1994"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gpSeriesTanhAnswerNC20", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
            ")"}], "/.", 
           RowBox[{"rndReplRules", "[", "testAlgebra", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "20"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.863855901066143*^9, 3.863855909399637*^9}, {
  3.863856277337244*^9, 3.863856298287867*^9}},
 CellLabel->
  "In[762]:=",ExpressionUUID->"4e5458a8-8e8a-4dbe-9572-5a40a7184dc9"],

