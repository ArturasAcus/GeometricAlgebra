Cell["\<\
So, precision of numerical inverse check is very high. Now tanh. Note, that, \
since N is applied before expansion, the exact expressions are converted to \
approximate, since otherwise expansion will take very long.\
\>", "Text",ExpressionUUID->"079024a1-ec6e-455b-9f16-38d12f82b156"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"tanhFormExactRezultNr", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Expand", "[", 
   RowBox[{"gaPE", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaSinhOfMVN", "[", "testAlgebra", "]"}], "//", "N"}], ")"}], 
     "\[GeometricProduct]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaCoshOfMVInvN", "[", "testAlgebra", "]"}], "//", "N"}], 
      ")"}]}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.863855866982758*^9, 3.863855871937467*^9}},
 CellLabel->
