Cell[CellGroupData[{

Cell["Massive test ", "Item",ExpressionUUID->"0e69cf8c-3be8-4a07-b520-a02085b22ee7"],

Cell["\<\
Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside \
generateRandomParameters[]\
\>", "Text",ExpressionUUID->"c02604fe-8979-4430-b0c6-756013e23bf8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"lim", "=", "10"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"unrestrictedParamRules", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", "->", 
         RowBox[{"RandomInteger", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}], 
      "/@", "allC2"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[447]:=",ExpressionUUID->"ac4ff12f-eece-4993-bdbb-f5ec2b6b8c60"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
        "crandRules"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rndReplRules", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], 
              "&"}], "/@", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", "4"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"orig", "=", 
            RowBox[{
             RowBox[{"gaGeneralMultivector", "[", 
