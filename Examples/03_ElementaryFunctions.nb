Cell[CellGroupData[{

Cell["2.39. Exponent of multivector", "Subsection",
 CellChangeTimes->{3.863158964016412*^9, 
  3.863855079298367*^9},ExpressionUUID->"65ee95a4-1278-4af5-8012-\
eb2cdf580275"],

Cell["\<\
For algebras with n\[LessEqual]3 we have option \
\[OpenCurlyDoubleQuote]gaFormula\[CloseCurlyDoubleQuote]->\
\[OpenCurlyDoubleQuote]LowDimension\[CloseCurlyDoubleQuote], which implements \
coordinate and basis free implementations using explicit formulas. Explicit \
\[OpenCurlyDoubleQuote]LowDimension\[CloseCurlyDoubleQuote] formula always \
returns real answers and most important yields answer for nondiagonalizable \
MV without need to compute limiting case. By default when n\[LessEqual]3 we \
use this method. \
\>", "Text",
 CellChangeTimes->{{3.863158970922131*^9, 3.8631592498679237`*^9}, 
   3.9713418420421667`*^9},ExpressionUUID->"a4e56efd-296d-4ae2-b965-\
0649a3dfa2fe"],

