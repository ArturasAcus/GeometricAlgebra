Cell[CellGroupData[{

Cell["Tanh tests", "Subsubsection",ExpressionUUID->"3f3b4cbc-045e-44c1-950f-4c8ddf69b9a3"],

Cell["\<\
First, show that sinh and cosh commutes. In fact ANY two continuous functions \
of the same MV commute, since any finite order expansions contains the same \
MV.  In this particular case this follows also from exponential form.\
\>", "Text",ExpressionUUID->"202e562a-0528-4399-a55b-616f003e287b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"gaSinhOfMVSimplified", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
      RowBox[{"gaCoshOfMVSimplified", "[", "testAlgebra", "]"}]}], "-", 
     RowBox[{
      RowBox[{"gaCoshOfMVSimplified", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
      RowBox[{"gaSinhOfMVSimplified", "[", "testAlgebra", "]"}]}]}], ")"}], "//",
    "gaPE"}], "//", "Expand"}]], "Input",
 CellChangeTimes->{{3.8638557458724937`*^9, 3.863855753658696*^9}},
 CellLabel->
  "In[750]:=",ExpressionUUID->"dfc586c6-0fc5-4cca-9c75-8b846f353086"],

