Cell["\<\
So, we see very good coincidence. Note, however that with even 20 terms only \
3 digits coincide. In order to have 6 coinciding digits we need to take \
nearly 40 series terms\
\>", "Text",ExpressionUUID->"dd7d8563-a84a-498d-a29d-3a78ea2175fe"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gpSeriesTanhAnswerNC40", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tanh", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
            ")"}], "/.", 
           RowBox[{"rndReplRules", "[", "testAlgebra", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "40"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.863855916538589*^9, 3.8638559230741663`*^9}},
 CellLabel->
  "In[763]:=",ExpressionUUID->"a3666858-66a5-4f63-9ad3-769e331cfc2e"],

