Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gpSeriesCoshInvAnswerNC40", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Cosh", "[", "#", "]"}]}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
            ")"}], "/.", 
           RowBox[{"rndReplRules", "[", "testAlgebra", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "40"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
