  RowBox[{"toExponentiateExpSimplFin", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Collect", "[", 
     RowBox[{"#", ",", "_\[DoubleStruckE]", ",", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Together", "[", "#", "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Power", "[", 
             RowBox[{"z_", ",", 
              RowBox[{"n", ":", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "|", 
                 RowBox[{
                  RowBox[{"-", "1"}], "/", "2"}]}], ")"}]}]}], "]"}], "\[RuleDelayed]", 
            RowBox[{"Power", "[", 
             RowBox[{
              RowBox[{"FullSimplify", "[", 
               RowBox[{"z", ",", 
                RowBox[{"Assumptions", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", ">", "0"}], ",", 
                   RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}], 
              ",", "n"}], "]"}]}], "}"}]}], ",", 
         RowBox[{"Assumptions", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", ">", "0"}], ",", 
            RowBox[{"x", "<", "$MachineEpsilon"}]}], "}"}]}]}], "]"}], 
       "&"}]}], "]"}], "&"}], "/@", 
   RowBox[{"toExponentiateExpSimpl", "[", "testAlgebra", "]"}]}]}]], "Input",
 Evaluatable->False,
 CellGroupingRules->{"GroupTogetherGrouping", 10009.},
 CellChangeTimes->{{3.886560677630706*^9, 3.886560692047546*^9}},
