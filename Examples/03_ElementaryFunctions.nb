Cell["\<\
Lastly tan series. For tanh it is very important to divide by proper value \
(max coefficient of MV is not enough: it yields nonconvergent series!)\
\>", "Text",ExpressionUUID->"ca9652d0-3c8a-41a3-8d17-c079faf7683b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"gpSeriesTanAnswerNC20", "[", "testAlgebra", "]"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"gaGeometricProductSeries", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Tan", "[", "#", "]"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"testMV", "[", "testAlgebra", "]"}], "/", "maxCoeff"}], 
            ")"}], "/.", 
           RowBox[{"rndReplRules", "[", "testAlgebra", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "20"}], "}"}]}], "}"}], ",", 
        RowBox[{"Expand", "\[Rule]", "Automatic"}]}], "]"}], "//", "Normal"}],
      "//", "Expand"}]}], ")"}], "//", "N"}]], "Input",
