Cell[CellGroupData[{

Cell["Massive test ", "Item",ExpressionUUID->"ba5eb6c0-e72c-4f43-a572-91fb82fc8cd7"],

Cell[TextData[{
 "Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside ",
 StyleBox["generateRandomParameters[]",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"9d0f6273-35b4-4475-80d3-0acf4c76e4ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], ",", 
      RowBox[{"lim", "=", "10"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"unrestrictedParamRules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}],
        "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"allC2", ",", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "2"}], "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "3"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParams", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"allC2", ",", 
        RowBox[{"C", "[", 
         RowBox[{"_", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParamsRules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{"restrictedParams", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ceiling", "[", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "2"}], "]"}], "2"], "+", 
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "3"}], "]"}], "2"]}], "]"}], "]"}], 
                ")"}], "/.", "unrestrictedParamRules"}], ",", 
              RowBox[{"2", "*", 
               RowBox[{"lim", "^", "2"}]}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", "restrictedParams"}], ")"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"unrestrictedParamRules", ",", "restrictedParamsRules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[446]:=",ExpressionUUID->"2579f07d-ebde-48ad-b00b-cb3e92fab3e3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
        "crandRules"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rndReplRules", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], 
              "&"}], "/@", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"orig", "=", 
            RowBox[{
             RowBox[{"gaGeneralMultivector", "[", 
              RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
             "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"gaSqrtOfMV", "[", 
           RowBox[{"orig", ",", 
            RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
            RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"logOfOrigFreeMVCF", "=", 
           RowBox[{"Expand", "[", 
            RowBox[{"gaPE", "[", 
             RowBox[{"gaLogOfMV", "[", 
              RowBox[{"orig", ",", 
               RowBox[{"Method", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"\"\<Automatic\>\"", ",", 
                  
                  RowBox[{"\"\<gaFormula\>\"", 
                   "->", "\"\<LowDimension\>\""}]}], "}"}]}], ",", 
               RowBox[{"\"\<gaIncludeFreeMV\>\"", "\[Rule]", "True"}], ",", 
               RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"crandRules", "=", 
            RowBox[{
            "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], ";",
            "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
             "]"}], "&&", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"Collect", "[", 
               RowBox[{
                RowBox[{"gaPE", "[", 
                 RowBox[{
                  RowBox[{"gaExpOfMV", "[", 
                   RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], "]"}], "-",
                   "orig"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
                "PossibleZeroQ"}], "]"}], ",", "False"}], "]"}]}]}]}], "}"}], 
        ",", 
        RowBox[{"{", "500", "}"}]}], "]"}]}], "]"}]}], ")"}], "//", 
  "LeafCount"}]], "Input",
 CellChangeTimes->{{3.8635791618247747`*^9, 3.863579256402617*^9}, {
  3.863579721834557*^9, 3.863579724318076*^9}, {3.86358082694164*^9, 
  3.863580834759467*^9}, {3.971341653545602*^9, 3.971341660188404*^9}},
 CellLabel->
  "In[447]:=",ExpressionUUID->"43d5deca-d97d-4837-85dd-bcbc8fe6c93d"],

