Cell[CellGroupData[{

Cell["Tan tests", "Subsubsection",ExpressionUUID->"88473881-9b1b-488a-9658-301f21958f8a"],

Cell["\<\
First, show that sin and cos commutes. In fact ANY two continuous functions \
of the same MV commute, since any finite order expansions contains the same \
MV.  In this particular case this follows also from exponential form.\
\>", "Text",ExpressionUUID->"e9238793-7c64-4683-a022-8125234e1255"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}], 
      "\[GeometricProduct]", 
      RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}]}], "-", 
     RowBox[{
      RowBox[{"gaCosOfMVSimplified", "[", "testAlgebra", "]"}], 
      "\[GeometricProduct]", 
      RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}]}]}], ")"}], "//",
    "gaPE"}], "//", "Expand"}]], "Input",
 CellChangeTimes->{{3.863856819927059*^9, 3.863856826523087*^9}},
 CellLabel->
  "In[680]:=",ExpressionUUID->"7cfa6fd3-713b-47bf-8214-0ab2d5a35bb1"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.863856827653407*^9, 3.886564532857193*^9, 
  3.927180146901248*^9},
 CellLabel->
  "Out[680]=",ExpressionUUID->"6bb5c696-1da8-4399-b4ff-2aeac5fcbb89"]
}, Open  ]],

