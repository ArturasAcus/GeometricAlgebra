Cell[CellGroupData[{

Cell["Massive test ", "Item",ExpressionUUID->"c714f784-9772-45cb-8284-e05a50787014"],

Cell[TextData[{
 "Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside ",
 StyleBox["generateRandomParameters[]",
  FontWeight->"Bold"]
}], "Text",ExpressionUUID->"9f86e602-7021-4862-9cc3-def58f285ff9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"lim", "=", "10"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"unrestrictedParamRules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}],
        "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"allC2", ",", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "2"}], "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "3"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParams", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"allC2", ",", 
        RowBox[{"C", "[", 
         RowBox[{"_", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParamsRules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{"restrictedParams", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ceiling", "[", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "2"}], "]"}], "2"], "+", 
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "3"}], "]"}], "2"]}], "]"}], "]"}], 
                ")"}], "/.", "unrestrictedParamRules"}], ",", 
              RowBox[{"2", "*", 
               RowBox[{"lim", "^", "2"}]}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", "restrictedParams"}], ")"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"unrestrictedParamRules", ",", "restrictedParamsRules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[395]:=",ExpressionUUID->"84bc8cff-20f9-4293-9070-21de4b4a48a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
        "crandRules"}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"rndReplRules", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                RowBox[{"RandomInteger", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], 
              "&"}], "/@", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
           
           RowBox[{"orig", "=", 
            RowBox[{
             RowBox[{"gaGeneralMultivector", "[", 
              RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
             "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"gaSqrtOfMV", "[", 
           RowBox[{"orig", ",", 
            RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
            RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"logOfOrigFreeMVCF", "=", 
           RowBox[{"Expand", "[", 
            RowBox[{"gaPE", "[", 
             RowBox[{"gaLogOfMV", "[", 
              RowBox[{"orig", ",", 
               RowBox[{"Method", "\[Rule]", 
                RowBox[{"{", 
                 RowBox[{"\"\<Automatic\>\"", ",", 
                  RowBox[{"gaFormula", "->", "\"\<LowDimension\>\""}]}], 
                 "}"}]}], ",", 
               RowBox[{"gaIncludeFreeMV", "\[Rule]", "True"}], ",", 
               RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], "]"}]}], 
          ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"crandRules", "=", 
            RowBox[{
            "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], 
           ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
             "]"}], "&&", 
            RowBox[{"FreeQ", "[", 
             RowBox[{
              RowBox[{"Collect", "[", 
               RowBox[{
                RowBox[{"gaPE", "[", 
                 RowBox[{
                  RowBox[{"gaExpOfMV", "[", 
                   RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], "]"}], 
                  "-", "orig"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
                "PossibleZeroQ"}], "]"}], ",", "False"}], "]"}]}]}]}], "}"}], 
        ",", 
        RowBox[{"{", "500", "}"}]}], "]"}]}], "]"}]}], ")"}], "//", 
  "LeafCount"}]], "Input",
 CellChangeTimes->{{3.8635791618247747`*^9, 3.863579256402617*^9}, {
  3.863579721834557*^9, 3.863579724318076*^9}, {3.86358082694164*^9, 
  3.863580834759467*^9}},
 CellLabel->
  "In[396]:=",ExpressionUUID->"addaefa6-155f-49e0-ba1a-ca02659fc408"],

