Cell[BoxData[
 RowBox[{
  RowBox[{"rules2aSaI", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", 
      RowBox[{"-", "aI"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "3", "]"}], " ", 
        RowBox[{"a", "[", "4", "]"}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "2", "]"}], " ", 
        RowBox[{"a", "[", "5", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"a", "[", "1", "]"}], " ", 
        RowBox[{"a", "[", "6", "]"}]}]}], "\[Rule]", "aI"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"a", "[", "1", "]"}], "2"]}], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", 
      RowBox[{"-", "aS"}]}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"a", "[", "1", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "2", "]"}], "2"], "+", 
        SuperscriptBox[
         RowBox[{"a", "[", "3", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "4", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "5", "]"}], "2"], "-", 
        SuperscriptBox[
         RowBox[{"a", "[", "6", "]"}], "2"]}], ")"}], "\[Rule]", "aS"}]}], 
    "}"}]}], ";", 
  RowBox[{"rules2aPaR", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      FractionBox["aI", 
       RowBox[{
        SqrtBox["2"], " ", 
        SqrtBox[
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}]]}]], "\[Rule]", "aPP"}], ",", 
     RowBox[{
      FractionBox[
       SuperscriptBox["aI", "2"], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "aS"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox["aI", "2"], "+", 
            SuperscriptBox["aS", "2"]}]]}], ")"}]}]], "\[Rule]", 
      RowBox[{"aPP", "^", "2"}]}], ",", 
     RowBox[{
      FractionBox[
       SqrtBox[
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}]], 
       SqrtBox["2"]], "\[Rule]", "aRR"}], ",", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "aS"}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox["aI", "2"], "+", 
           SuperscriptBox["aS", "2"]}]]}], ")"}]}], "\[Rule]", 
      RowBox[{"aRR", "^", "2"}]}]}], "}"}]}], ";"}]], "Input",
 CellLabel->
  "In[652]:=",ExpressionUUID->"698c954f-0cc4-4638-ae5c-2681fbff889a"],

Cell[TextData[{
 "Use ",
 Cell[BoxData[
