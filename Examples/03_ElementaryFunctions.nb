Cell[CellGroupData[{

Cell["Massive test ", "Item",ExpressionUUID->"4c46e451-fda6-4f2a-af8a-7174611f8ac7"],

Cell["\<\
Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside \
generateRandomParameters[]\
\>", "Text",ExpressionUUID->"196326e2-6e94-4409-a748-291cd7aa6545"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], 
      ",", 
      RowBox[{"lim", "=", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"#", "->", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}], "/@",
      "allC2"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[608]:=",ExpressionUUID->"3c2891f1-c6e8-4ce0-89ee-46ac84b25cc8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"PossibleZeroQ", "::", "ztest1"}], "]"}], ";", 
    RowBox[{
     RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
         "crandRules"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rndReplRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ")"}], 
               "&"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{
                   "gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
                   ")"}]}], "-", "1"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"orig", "=", 
             RowBox[{
              RowBox[{"gaGeneralMultivector", "[", 
               RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
              "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"gaSqrtOfMV", "[", 
            RowBox[{"orig", ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
             RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"logOfOrigFreeMVCF", "=", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{"gaLogOfMV", "[", 
               RowBox[{"orig", ",", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"Automatic", ",", 
                   RowBox[{"gaFormula", "->", "\"\<LowDimension\>\""}]}], 
                  "}"}]}], ",", 
                RowBox[{"gaIncludeFreeMV", "\[Rule]", "True"}], ",", 
                RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], "]"}]}],
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"crandRules", "=", 
             RowBox[{
             "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
              "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{"gaPE", "[", 
                  RowBox[{
                   RowBox[{"gaExpOfMV", "[", 
                    RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], "]"}], 
                   "-", "orig"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
                 "PossibleZeroQ"}], "]"}], ",", "False"}], "]"}]}]}]}], "}"}],
          ",", 
         RowBox[{"{", "50", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ")"}], "//", "LeafCount"}]], "Input",
 CellChangeTimes->{{3.863674052393681*^9, 3.863674076407147*^9}, 
   3.863674138057994*^9, {3.8636754905*^9, 3.863675502092115*^9}, {
   3.863754468016477*^9, 3.8637544772316628`*^9}, {3.863755138725281*^9, 
   3.8637551440964003`*^9}, {3.8864795566843576`*^9, 3.886479559665039*^9}, {
   3.8864796202080317`*^9, 3.8864796221694527`*^9}},
 CellLabel->
  "In[609]:=",ExpressionUUID->"a0d1fbeb-7ea2-4503-90cc-3418e0e1c086"],

