Cell[CellGroupData[{

Cell["Application to differential equations", "Text",
 FontSize->24,
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"2ec832d8-d17c-480e-829c-80ed1ed7bc59"],

Cell[CellGroupData[{

Cell[TextData[{
 "Example of differential solution ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["d", "2"], 
       RowBox[{"X", "/", 
        SuperscriptBox["dt", "2"]}]}], "+", 
      RowBox[{"A", " ", "\[GeometricProduct]", "X"}]}], "==", "0"}], ",", 
    "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"at", " ", "t"}], "=", 
      RowBox[{
       RowBox[{"0", "   ", "X"}], "=", 
       SubscriptBox["X", "0"]}]}], ";", " ", 
     RowBox[{
      RowBox[{"dX", "/", "dt"}], "=", 
      RowBox[{
       SubscriptBox["X", "0"], "'"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "c393d267-539d-470a-8776-fb847e867efe"]
}], "Subsection",ExpressionUUID->"db1c82ce-35ef-4cab-b619-f9b0cf9ab44b"],

Cell[TextData[{
 "Solution of this equation is known to be ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"X", 
     RowBox[{"(", "t", ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "(", 
       RowBox[{
        SqrtBox["A"], "t"}], ")"}], 
      SubscriptBox["X", "0"]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        SqrtBox["A"], ")"}], 
       RowBox[{"-", "1"}]], 
      RowBox[{"Sin", "(", 
       RowBox[{
        SqrtBox["A"], "t"}], ")"}], 
      RowBox[{
       SubscriptBox["X", "0"], "'"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "50fd6d01-5736-40f6-a607-1e60cd6ab6ea"],
 "  . Checking"
}], "Text",ExpressionUUID->"b41f1419-1e30-4838-a9dd-09d38165ba39"],

