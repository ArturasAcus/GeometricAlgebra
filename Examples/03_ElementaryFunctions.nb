  "]"}]], "Input",
 CellChangeTimes->{{3.863856829512884*^9, 3.863856833278452*^9}},
 CellLabel->
  "In[681]:=",ExpressionUUID->"ea9f95e2-f400-4be7-a4b0-348f015ea248"],

Cell[BoxData["0"], "Output",
