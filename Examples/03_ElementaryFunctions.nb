Cell[CellGroupData[{

Cell["Massive test ", "Item",ExpressionUUID->"d8641956-ad47-475d-a4c6-57326acb63a8"],

Cell["\<\
Generate many random MV and try to find cases where sqrt or exponentiation \
didn\[CloseCurlyQuote]t match. When changing intervals of random \
coefficients, don\[CloseCurlyQuote]t forget to adjust lim=10 var inside \
generateRandomParameters[]\
\>", "Text",ExpressionUUID->"e565b034-62cf-43eb-82e4-ff9567ad735c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomParameters", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"allC2", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"expr", ",", 
          RowBox[{"C", "[", "__", "]"}], ",", "Infinity"}], "]"}], "]"}]}], ",", 
      RowBox[{"lim", "=", "10"}], ",", "unrestrictedParamRules", ",", 
      "restrictedParams", ",", "restrictedParamsRules"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"unrestrictedParamRules", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "->", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "lim"}], ",", "lim"}], "}"}], "]"}]}], ")"}], "&"}],
        "/@", 
       RowBox[{"Cases", "[", 
        RowBox[{"allC2", ",", 
         RowBox[{
          RowBox[{"C", "[", "_", "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "2"}], "]"}], "|", 
          RowBox[{"C", "[", 
           RowBox[{"_", ",", "3"}], "]"}]}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParams", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"allC2", ",", 
        RowBox[{"C", "[", 
         RowBox[{"_", ",", "1"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"restrictedParamsRules", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{"Rule", "[", 
        RowBox[{"restrictedParams", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"RandomInteger", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"Ceiling", "[", 
                 RowBox[{"Sqrt", "[", 
                  RowBox[{
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "2"}], "]"}], "2"], "+", 
                   SuperscriptBox[
                    RowBox[{"C", "[", 
                    RowBox[{"#", ",", "3"}], "]"}], "2"]}], "]"}], "]"}], 
                ")"}], "/.", "unrestrictedParamRules"}], ",", 
              RowBox[{"2", "*", 
               RowBox[{"lim", "^", "2"}]}]}], "}"}], "\[IndentingNewLine]", 
            "]"}], "&"}], "/@", 
          RowBox[{"(", 
           RowBox[{"First", "/@", "restrictedParams"}], ")"}]}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Join", "[", 
      RowBox[{"unrestrictedParamRules", ",", "restrictedParamsRules"}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[684]:=",ExpressionUUID->"becea855-350f-4cf7-9cee-1e2c2beacf9c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Off", "[", 
     RowBox[{"PossibleZeroQ", "::", "ztest1"}], "]"}], ";", 
    RowBox[{
     RowBox[{"testTable", "[", "testAlgebra", "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "rndReplRules", ",", "orig", ",", "logOfOrigFreeMVCF", ",", 
         "crandRules"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"rndReplRules", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"b", "[", "#", "]"}], "\[Rule]", 
                 RowBox[{"RandomInteger", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "5"}], ",", "5"}], "}"}], "]"}]}], ")"}], 
               "&"}], "/@", 
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{
                   "gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
                   ")"}]}], "-", "1"}]}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"orig", "=", 
             RowBox[{
              RowBox[{"gaGeneralMultivector", "[", 
               RowBox[{"b", ",", "testAlgebra"}], "]"}], "/.", 
              "rndReplRules"}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{"gaSqrtOfMV", "[", 
            RowBox[{"orig", ",", 
             RowBox[{"Quiet", "\[Rule]", "True"}], ",", 
             RowBox[{"VerifySolutions", "\[Rule]", "False"}]}], "]"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"logOfOrigFreeMVCF", "=", 
            RowBox[{"Expand", "[", 
             RowBox[{"gaPE", "[", 
              RowBox[{"gaLogOfMV", "[", 
               RowBox[{"orig", ",", 
                RowBox[{"Method", "\[Rule]", 
                 RowBox[{"{", 
                  RowBox[{"Automatic", ",", 
                   
                   RowBox[{"\"\<gaFormula\>\"", 
                    "->", "\"\<LowDimension\>\""}]}], "}"}]}], ",", 
                RowBox[{"\"\<gaIncludeFreeMV\>\"", "\[Rule]", "True"}], ",", 
                RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], "]"}], "]"}]}],
            ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"crandRules", "=", 
             RowBox[{
             "generateRandomParameters", "[", "logOfOrigFreeMVCF", "]"}]}], ";",
             "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"(", "logOfOrigFreeMVCF", ")"}], ",", "_Complex"}], 
              "]"}], "&&", 
             RowBox[{"FreeQ", "[", 
              RowBox[{
               RowBox[{"Collect", "[", 
                RowBox[{
                 RowBox[{"gaPE", "[", 
                  RowBox[{
                   RowBox[{"gaExpOfMV", "[", 
                    RowBox[{"logOfOrigFreeMVCF", "/.", "crandRules"}], "]"}], 
                   "-", "orig"}], "]"}], ",", "_\[DoubleStruckE]", ",", 
                 "PossibleZeroQ"}], "]"}], ",", "False"}], "]"}]}]}]}], "}"}],
          ",", 
         RowBox[{"{", "500", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
      "]"}]}]}], ")"}], "//", "LeafCount"}]], "Input",
 CellChangeTimes->{{3.863674052393681*^9, 3.863674076407147*^9}, 
   3.863674138057994*^9, {3.8636754905*^9, 3.863675502092115*^9}, {
   3.863754468016477*^9, 3.8637544772316628`*^9}, {3.863755138725281*^9, 
   3.8637551440964003`*^9}, 3.86384513741966*^9, {3.9713418085003653`*^9, 
   3.971341810706139*^9}},
 CellLabel->
  "In[685]:=",ExpressionUUID->"aa93a8d1-a64b-42d9-a33d-003a4fa1b778"],

Cell[BoxData["660374"], "Output",
 CellChangeTimes->{{3.863845102268029*^9, 3.863845137274617*^9}, 
   3.863845198417794*^9, 3.88656313844357*^9, 3.9713454083785973`*^9, 
   3.973311991319201*^9},
 CellLabel->
  "Out[685]=",ExpressionUUID->"b9a6bcb8-5b02-4f33-964d-5c4040594253"]
}, Open  ]],

Cell["\<\
Cases where results may not match now must include Log[0]. These have to be \
checked separately. \
\>", "Text",ExpressionUUID->"67fc40f0-911a-4be9-b0b7-0bf16d0a1fc7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"testtableSpec", "[", "testAlgebra", "]"}], "=", 
    RowBox[{"DeleteCases", "[", 
     RowBox[{
      RowBox[{"testTable", "[", "testAlgebra", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"__", ",", "True"}], "}"}]}], "]"}]}], ")"}], "//", 
  "Length"}]], "Input",
 CellChangeTimes->{{3.86367556247538*^9, 3.863675589896472*^9}},
