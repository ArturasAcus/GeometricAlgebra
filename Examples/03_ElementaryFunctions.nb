Cell[CellGroupData[{

Cell["2.40. The role of DeterminantNorm in arbitrary  Cl(p,q)", "Subsection",
 CellChangeTimes->{{3.863574945873857*^9, 3.863574952822707*^9}, {
  3.8635786355442753`*^9, 3.8635786368608418`*^9}, {3.8638551119656887`*^9, 
  3.863855128443336*^9}},ExpressionUUID->"1171b596-8fee-435d-a4a3-\
7653ed63c383"],

Cell["\<\
The gaNormDeterminant plays the role of complex number norm for general MV. \
For example take any algebra, where we can make full analogy with complex \
number. Take scalar and any basis MV which squares to -1. Then this can be \
replaced by complex number. The log series converge only when determinant \
norm of A-1 <1.\
\>", "Text",ExpressionUUID->"14b92e1f-bda0-43fe-ba48-32a76b6b4be6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"1", ",", "5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[276]:=",ExpressionUUID->"ea7fb349-b405-45a8-be2b-cd4a1d5d7e91"],

