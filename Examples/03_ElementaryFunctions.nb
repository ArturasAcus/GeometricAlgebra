Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"gaSinOfMVSimplified", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"Collect", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaPE", "[", 
        RowBox[{
         RowBox[{"gaI", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{
               RowBox[{"gaExpOfMV", "[", 
                RowBox[{"gaPE", "[", 
                 RowBox[{
                  RowBox[{"testMV", "[", "testAlgebra", "]"}], 
                  "\[GeometricProduct]", 
                  RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], 
               "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"gaExpOfMV", "[", 
               RowBox[{"gaPE", "[", 
                RowBox[{
                 RowBox[{"-", 
                  RowBox[{"testMV", "[", "testAlgebra", "]"}]}], 
                 "\[GeometricProduct]", 
                 RowBox[{"gaI", "[", "testAlgebra", "]"}]}], "]"}], "]"}], 
              "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1", ",", "1"}], "]"}], "]"}]}], ")"}], "/", 
           "2"}], ")"}]}], "]"}], "//.", "rules2aSaI"}], ")"}], "//.", 
     "rules2aPaR"}], ",", "_\[DoubleStruckE]", ",", 
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{"ExpToTrig", "[", 
       RowBox[{"Expand", "[", 
        RowBox[{"TrigToExp", "[", "#", "]"}], "]"}], "]"}], "]"}], "&"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8638559894222393`*^9, 3.8638560063887463`*^9}},
 CellLabel->
  "In[653]:=",ExpressionUUID->"dec11b8f-3e6b-4419-be48-c25774681fa5"],

