Cell["Run until get non empty specialCaseRules[testAlgebra]", "Text",
 CellChangeTimes->{{3.863675211286827*^9, 
  3.863675245220654*^9}},ExpressionUUID->"64506958-6073-446b-b4a0-\
fc6035474146"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rndRules", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"#", "->", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "10"}], ",", "10"}], "}"}], "]"}]}], ")"}], "&"}], "/@", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "[", "1", "]"}], ",", 
     RowBox[{"a", "[", "2", "]"}], ",", 
     RowBox[{"a", "[", "3", "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aVB", "[", "testAlgebra", "]"}], "=", 
   RowBox[{
    RowBox[{"gaGeneralMultivector", "[", 
     RowBox[{"a", ",", "testAlgebra", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "/.", 
    RowBox[{"rndRules", "[", "testAlgebra", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mvNorm12T", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"-", 
   RowBox[{"gaPE", "[", 
    RowBox[{
     RowBox[{"aVB", "[", "testAlgebra", "]"}], "\[GeometricProduct]", 
     RowBox[{"gaCliffordConjugate", "[", 
      RowBox[{"aVB", "[", "testAlgebra", "]"}], "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"specialCaseRules", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"Positive", "[", 
     RowBox[{"mvNorm12T", "[", "testAlgebra", "]"}], "]"}], ",", 
    RowBox[{"AppendTo", "[", 
     RowBox[{
      RowBox[{"rndRules", "[", "testAlgebra", "]"}], ",", 
      RowBox[{
       RowBox[{"a", "[", "0", "]"}], "\[Rule]", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"mvNorm12T", "[", "testAlgebra", "]"}], "]"}]}]}], "]"}], ",", 
    RowBox[{"Abort", "[", "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.863675153296543*^9, 3.863675191360188*^9}, {
  3.886479051245802*^9, 3.886479054118287*^9}},
 CellLabel->
  "In[584]:=",ExpressionUUID->"dbac9303-2eb3-4934-952e-177ecdef35e8"],

