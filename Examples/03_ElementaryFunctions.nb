Cell[TextData[{
 "This shows that result of ",
 StyleBox["Sinh[ArcSinh[Sinh[A]]]",
  FontWeight->"Bold"],
 " is the same as of ",
 StyleBox["Sinh[A]",
  FontWeight->"Bold"],
 " (see above). Since internally answer ",
 StyleBox["ansArcSinhSinhSimple1[testAlgebra]",
  FontWeight->"Bold"],
 " takes a bit too long and was inactivated"
}], "Text",
