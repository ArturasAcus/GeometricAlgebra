Cell[TextData[{
 "This shows that result of ",
 StyleBox["Sinh[ArcSinh[Sinh[A]]]",
  FontWeight->"Bold"],
 " is the same as of ",
 StyleBox["Sinh[A]",
  FontWeight->"Bold"],
 " (see above). Since internally answer ",
 StyleBox["ansArcSinhSinhSimple1[testAlgebra]",
  FontWeight->"Bold"],
 " takes a bit too long and was inactivated"
}], "Text",
 CellChangeTimes->{{3.864178258828804*^9, 3.864178275754201*^9}, {
   3.86417831422547*^9, 3.864178332209674*^9}, {3.86417864624408*^9, 
