Cell[TextData[{
 "When signature is mixed we have to check if determinant of MV is not \
negative (since ",
 StyleBox["NormDeterminant[ ]",
  FontWeight->"Bold"],
 " always returns positive number). For negative determinant series don\
\[CloseCurlyQuote]t converge (log don\[CloseCurlyQuote]t exists)"
}], "Text",
