Cell[BoxData[
 RowBox[{
  RowBox[{"gaCollect", "[", 
   RowBox[{"expr_", ",", "patt_", ",", 
    RowBox[{"fun_", ":", "Identity"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"Function", "[", 
     RowBox[{"answ", ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"answ", "===", "$gaCollectFail"}], ",", "expr", ",", 
        RowBox[{"Plus", "@@", 
         RowBox[{"Values", "[", "answ", "]"}]}]}], "]"}]}], "]"}], "[", 
    "\[IndentingNewLine]", 
    RowBox[{"Catch", "[", 
     RowBox[{"AssociationMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"be", "=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"MapAt", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"ax", ",", "\[IndentingNewLine]", 
              RowBox[{"GeometricProduct", "[", 
               RowBox[{
                RowBox[{"GeometricAlgebra`p`singleton", "[", 
                 RowBox[{"Block", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"GeometricAlgebra`p`singleton", "=", "Identity"}],
                     "}"}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"Function", "[", 
                    RowBox[{"te", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"te", ",", 
                    RowBox[{"Except", "[", 
                    RowBox[{"1", ",", "be"}], "]"}]}], "]"}], ",", "te", ",", 
                    
                    RowBox[{
                    RowBox[{"Message", "[", 
                    RowBox[{
                    RowBox[{"gaCollect", "::", "Fail"}], ",", "te"}], "]"}], ";", 
                    RowBox[{"Throw", "[", "$gaCollectFail", "]"}]}]}], 
                    "]"}]}], "]"}], "[", 
                    RowBox[{"Plus", "@@", 
                    RowBox[{"(", 
                    RowBox[{"ax", "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"HoldPattern", "[", 
                    RowBox[{"GeometricProduct", "[", 
                    RowBox[{"any__", ",", "be"}], "]"}], "]"}], ":>", 
                    RowBox[{"fun", "[", 
                    RowBox[{"GeometricProduct", "[", "any", "]"}], "]"}]}], 
                    "}"}]}], ")"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
                 "]"}], ",", "be"}], "]"}]}], "\[IndentingNewLine]", "]"}], ",",
             "#", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "&"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GroupBy", "[", 
        RowBox[{
         RowBox[{"List", "@@", "expr"}], ",", 
         RowBox[{
          RowBox[{"FirstCase", "[", 
           RowBox[{"#", ",", "patt", ",", "1", ",", "Infinity"}], "]"}], 
          "&"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], 
     RowBox[{"(*", " ", 
      RowBox[{"end", " ", "AssociationMap"}], " ", "*)"}], " ", 
     "\[IndentingNewLine]", "]"}], 
    RowBox[{"(*", " ", 
     RowBox[{"end", " ", "Catch"}], " ", "*)"}], " ", "\[IndentingNewLine]", 
    "]"}], "/;", 
   RowBox[{
    RowBox[{"Head", "[", "expr", "]"}], "===", "Plus"}]}]}]], "Input",
