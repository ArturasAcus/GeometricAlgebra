Cell["Test Shirokov rank. Seems the rank approach is wrong! ", "Subsection",
 Editable->True,
 TaggingRules->{},
 CellChangeTimes->{{3.95492955401782*^9, 3.954929556674014*^9}, {
  3.9608885567661457`*^9, 3.960888569559566*^9}, {3.967697895877239*^9, 
