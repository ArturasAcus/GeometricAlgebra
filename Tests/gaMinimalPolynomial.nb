Cell["\<\
Simply check that Shirokov\[CloseCurlyQuote]s formulas yields the same answer \
as our general definition. \
\>", "Text",
 CellChangeTimes->{{3.960948986426673*^9, 3.960949040025896*^9}, 
   3.9676978880201807`*^9},
 CellID->1649723571,ExpressionUUID->"25c3fcab-8218-4bd0-b3d0-0cc05c895574"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rankOfMV", "[", "expr_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[FormalX]", "}"}], ",", 
    RowBox[{"Subtract", "@@", 
     RowBox[{"Exponent", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], ",", 
           RowBox[{"Last", "[", "#", "]"}]}], "}"}], "&"}], "[", 
        RowBox[{"MonomialList", "[", 
         RowBox[{
          RowBox[{"gaMinimalPolynomial", "[", 
           RowBox[{"expr", ",", "\[FormalX]"}], "]"}], ",", 
          RowBox[{"{", "\[FormalX]", "}"}], 
          ",", "\"\<DegreeLexicographic\>\""}], "]"}], "]"}], ",", 
       "\[FormalX]"}], "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.960943470615232*^9, 3.960943477799253*^9}, {
  3.9609435946291447`*^9, 3.960943625939867*^9}, {3.960943700142034*^9, 
