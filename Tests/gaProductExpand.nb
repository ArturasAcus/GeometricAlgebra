Cell["Make replacement rules  for comparison with symbolic answer", "Text",
 CellChangeTimes->{{3.961641845617609*^9, 3.961641878384026*^9}, {
  3.961642436738768*^9, 3.961642450899515*^9}},
 CellID->1592341019,ExpressionUUID->"ae39766f-01d6-44ef-99ed-365b4c4fb4a6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rrtemp", "[", "2", "]"}], "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{"Rule", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"gaComponentCoefficientAndBasisList", "[", 
         RowBox[{"testMVS", "[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"gaComponentCoefficientAndBasisList", "[", 
         RowBox[{"testMV", "[", "2", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"toQRules", "[", 
   RowBox[{"lhs_", "->", "rhs_"}], "]"}], ":=", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{"lhs", "-", "rhs"}], ",", 
        "gaNonCommutativeFieldElementPattern", ",", "takeMe"}], "]"}], ",", 
      "_takeMe", ",", "Infinity"}], "]"}], "/.", 
    RowBox[{
     RowBox[{"takeMe", "[", "any_", "]"}], ":>", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"Equal", "[", 
        RowBox[{"any", ",", "0"}], "]"}], ",", 
       RowBox[{"Variables", "[", "any", "]"}]}], "]"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"numericalCoefficientRules", "[", "2", "]"}], "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"toQRules", "/@", 
    RowBox[{"rrtemp", "[", "2", "]"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9616424563852882`*^9, 3.9616424689942617`*^9}},
 CellLabel->"In[27]:=",
