Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testMVS", "[", "4", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"\[DoubleStruckF]", "[", "1", "]"}], ",", 
          RowBox[{"\[DoubleStruckF]", "[", "2", "]"}], ",", 
          RowBox[{"\[DoubleStruckF]", "[", 
           RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ".", "#"}], ")"}], "&"}], 
     "/@", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<a\>\"", "<>", 
           RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"4", "*", 
          RowBox[{"2", "^", 
           RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}]}], 
         "]"}]}], ",", "4"}], "]"}]}], ")"}], ".", 
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\""}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"testMVSA", "[", "4", "]"}], "=", 
  RowBox[{"gaAssociationRepresentation", "[", 
   RowBox[{
    RowBox[{"testMVS", "[", "3", "]"}], ",", 
    RowBox[{"\"\<FieldToAssociation\>\"", "->", "False"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testMVSAA", "[", "4", "]"}], "=", 
  RowBox[{"gaAssociationRepresentation", "[", 
   RowBox[{
    RowBox[{"testMVS", "[", "3", "]"}], ",", 
    RowBox[{"\"\<FieldToAssociation\>\"", "->", "True"}]}], "]"}]}]}], "Input",\

