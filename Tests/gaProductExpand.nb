 CellID->524772480,ExpressionUUID->"94bff883-b821-4896-9c2d-020503a5a673"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"bs", "=", 
     RowBox[{
     "Symbol", "[", "GeometricAlgebra`p`orthonormalBasisSymbolName", "]"}]}], 
    "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testMV", "[", "2", "]"}], "=", 
    RowBox[{"gaRandomMultivector", "[", 
     RowBox[{"testAlgebra", ",", 
      RowBox[{"\"\<CoefficientFunction\>\"", "->", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"gaRandomMultivector", "[", 
           RowBox[{"Cl", "[", 
            RowBox[{"0", ",", "2"}], "]"}], "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bs", "[", 
             RowBox[{"s_mvDownUp", ",", "al_"}], "]"}], ":>", 
            RowBox[{"bs", "[", 
             RowBox[{"s", ",", "al", ",", "\"\<Quaternion\>\""}], "]"}]}], 
           "}"}]}], "&"}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testMVA", "[", "2", "]"}], "=", 
  RowBox[{"gaAssociationRepresentation", "[", 
   RowBox[{
    RowBox[{"testMV", "[", "2", "]"}], ",", 
    RowBox[{"\"\<FieldToAssociation\>\"", "->", "False"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testMVAA", "[", "2", "]"}], "=", 
  RowBox[{"gaAssociationRepresentation", "[", 
   RowBox[{
    RowBox[{"testMV", "[", "2", "]"}], ",", 
    RowBox[{"\"\<FieldToAssociation\>\"", "->", "True"}]}], "]"}]}]}], "Input",\

