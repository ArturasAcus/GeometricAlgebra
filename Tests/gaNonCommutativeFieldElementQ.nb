 CellID->904125756,ExpressionUUID->"8ad9d452-2e30-4456-a46b-e0afaf4735f7"],

Cell["\<\
DefinitionsCoefficients should belong to different Clifford algebra. \
Multiplication of coefficients is ALWAYS assumed to be GeometricProducts \
(usage of inner and outer products for coefficients at basis elements \
probably is inconsistent, not investigated).\
\>", "Text",
 Editable->True,
 TaggingRules->{},
 CellID->1995874434,ExpressionUUID->"555b2e46-f92b-4449-904f-8fdad3a9619a"],

