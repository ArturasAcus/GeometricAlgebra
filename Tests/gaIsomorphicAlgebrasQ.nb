                RowBox[{"(", 
                 RowBox[{"algBp", "-", "algBq", "+", "1"}], ")"}]}], 
               "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sPlust", "=", 
            RowBox[{"2", "^", 
             RowBox[{"(", "dimAlgA", ")"}]}]}], ";"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"GeometricAlgebra`p`printDetails", "[", 
