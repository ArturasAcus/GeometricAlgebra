   RowBox[{"OptionsPattern", "[", "]"}]}], "]"}]], "Input",
 CellID->1105520150,ExpressionUUID->"ad1a4dc0-d1d3-4582-b5db-254512e7ec0f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"gaIsomorphicAlgebrasQ1", "[", 
    RowBox[{"algA_Cl", ",", "algB_Cl", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fullOrEven", "=", 
        RowBox[{"OptionValue", "[", "\"\<EvenSubalgebra\>\"", "]"}]}], ",", 
       RowBox[{"algAp", "=", 
        RowBox[{"algA", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"algBp", "=", 
        RowBox[{"algB", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"algAq", "=", 
        RowBox[{"algA", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"algBq", "=", 
        RowBox[{"algB", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"dimAlgA", "=", 
        RowBox[{"Plus", "@@", "algA"}]}], ",", 
       RowBox[{"dimAlgB", "=", 
        RowBox[{"Plus", "@@", "algB"}]}], ",", "sPlust", ",", "sMetricScoreA",
        ",", "tMetricScoreA", ",", "sMetricScoreB", ",", "tMetricScoreB", ",", 
       RowBox[{"quiet", "=", 
        RowBox[{"OptionValue", "[", "Quiet", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "if", " ", "vector", " ", "space", " ", "dimensions", " ", "are", " ", 
        "distinct", " ", "then", " ", "return", " ", "False", " ", 
        "immediatelly"}], ",", " ", 
       RowBox[{"else", " ", "sompute", " ", "metric", " ", "scores"}]}], " ", 
      "*)"}], " ", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dimAlgA", "===", "dimAlgB"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"fullOrEven", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"sMetricScoreA", "=", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"dimAlgA", "-", "2"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"dimAlgA", "-", "2"}], ")"}], "/", "2"}], ")"}]}], 
              "*", 
              RowBox[{"Cos", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"Pi", "/", "4"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"algAp", "-", "algAq"}], ")"}]}], "]"}]}]}]}], ";", 
           RowBox[{"sMetricScoreB", "=", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"dimAlgB", "-", "2"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"dimAlgB", "-", "2"}], ")"}], "/", "2"}], ")"}]}], 
              "*", 
              RowBox[{"Cos", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"Pi", "/", "4"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"algBp", "-", "algBq"}], ")"}]}], "]"}]}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"sPlust", "=", 
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"dimAlgA", "-", "1"}], ")"}]}]}], ";"}], 
          "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"sMetricScoreA", "=", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"dimAlgA", "-", "1"}], ")"}]}], "+", 
             RowBox[{
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"dimAlgA", "-", "1"}], ")"}], "/", "2"}], ")"}]}], 
              "*", 
              RowBox[{"Sin", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"Pi", "/", "4"}], ")"}], "*", 
                RowBox[{"(", 
                 RowBox[{"algAp", "-", "algAq", "+", "1"}], ")"}]}], 
               "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"sMetricScoreB", "=", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"dimAlgB", "-", "1"}], ")"}]}], "+", 
             RowBox[{
