Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["a", "TI"], "\[CenterDot]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["b", "TI"], "\[Cross]", 
              StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[Wedge]", 
              StyleBox["b", "TI"], "\[Wedge]", 
              StyleBox["c", "TI"]}], ")"}], 
          SuperscriptBox[
           StyleBox["I", "TI"], "-1"], "\[LongEqual]", "-", 
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[Wedge]", 
              StyleBox["b", "TI"], "\[Wedge]", 
              StyleBox["c", "TI"]}], ")"}], 
          StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "a\\d(b{\\bf\\times} c)=(a\\w b\\w c)I^{-1}=-(a\\w b\\w c)I", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"], ","}], TraditionalForm]],ExpressionUUID->
  "a2128b0e-0324-4c4f-b805-b15014cdbb44"],
 " here ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
