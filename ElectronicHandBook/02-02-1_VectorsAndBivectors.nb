d69829aca136"],

Cell[TextData[{
 " ",
 StyleBox["Trigonometric relations for vectors. ",
  FontSlant->"Italic"],
 "The formulae can be used to generate new relations. For example, adding the \
equations with plus-minus signs from the first line one gets ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
           StyleBox["b", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a\\|b)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cfb9600e-6479-4294-a806-087100337887"],
 ":  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", "sin", 
         StyleBox["a", "TI"], "cos", 
         StyleBox["b", "TI"], "\[LongEqual]", "sin", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "+", 
             StyleBox["b", "TI"]}], ")"}], "+", "sin", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "-", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "2\\sin a\\cos b=\\sin(a+b)+\\sin(a-b)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39adc6a4-4fab-48cc-99f0-aa7ff3f2c4fd"],
 ". If $ this equation reduces to double-vector argument formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"sin", "2", 
         StyleBox["a", "TI"], "\[LongEqual]", "2", "sin", 
         StyleBox["a", "TI"], "cos", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sin 2a=2\\sin a\\cos a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a542a455-634b-4bf1-9743-bc0225d03245"],
 ",  which can be rewritten either as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "sin", "2|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "2", 
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "sin", "|", 
         StyleBox["a", "TI"], "|", "cos", "|", 
         StyleBox["a", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{a}\\sin 2|a|=2\\hat{a}\\sin|a|\\cos|a|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "35bbd6cb-07d4-492c-b79c-e92af0bce331"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a^2>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d26b1ee9-bf84-4a2c-8576-7908c12c8f82"],
 ", or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["sh", FontSlant -> "Plain"], "2|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "2", 
         OverscriptBox[
          StyleBox["a", "TI"], "^"], 
         StyleBox["sh", FontSlant -> "Plain"], "|", 
         StyleBox["a", "TI"], "|", 
         StyleBox["ch", FontSlant -> "Plain"], "|", 
         StyleBox["a", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{a}\\sh 2|a|=2\\hat{a}\\sh|a|\\ch|a|", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f355f195-da84-4ba5-b2e7-60504297857b"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "<", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a^2<0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "989e2117-b547-493c-b016-c7c1133817ee"],
 ". Since the type of the function,  trigonometric or hyperbolic, is \
determined by sign of squared argument the same formulas remain true if the \
vectors are replaced by k-blades or even MVs the  square of which is a scalar."
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"99377fc3-a459-4725-991e-4726ea236640"],

Cell[TextData[{
 " ",
 StyleBox["Hyperbolic relations for vectors. ",
  FontSlant->"Italic"],
 "From relations above one obtains the well-known formulas of scalar argument\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                OverscriptBox[
                 StyleBox["a", "TI"], "^"], "2"], 
               SuperscriptBox[
                StyleBox["sh", FontSlant -> "Plain"], "2"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   StyleBox["ch", FontSlant -> "Plain"], 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]}], ")"}]}], ")"}], ","}], 
             RowBox[{"      ", "if ", 
               SuperscriptBox[
                OverscriptBox[
                 StyleBox["a", "TI"], "^"], "2"], "\[LongEqual]", "-1", 
               ","}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                OverscriptBox[
                 StyleBox["a", "TI"], "^"], "2"], 
               SuperscriptBox["sin", "2"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", "cos", 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]}], ")"}]}], ")"}], ","}], 
             RowBox[{"      ", "if ", 
               SuperscriptBox[
                OverscriptBox[
                 StyleBox["a", "TI"], "^"], "2"], "\[LongEqual]", "+1."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\\hat{a}^2\\sh^2{|a|}=\\frac{1}{2}\\big(1-\\ch(2{|a|})\
\\big),& \\quad\\qquad \\text{if } \\hat{a}^2=-1,\\\\&\n\
\\hat{a}^2\\sin^2{|a|}=\\frac{1}{2}\\big(1-\\cos(2{|a|})\\big),&\\quad\\qquad \
\\text{if } \\hat{a}^2=+1.\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "865aa3f4-bca8-48b7-bc45-752f71ac8d29"],
 "\[LineSeparator]"
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.911279297829646*^9, 3.911279324844771*^9}, {
  3.911279501724227*^9, 3.911279584253166*^9}, {3.911279637179107*^9, 
