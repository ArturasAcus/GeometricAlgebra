Cell[CellGroupData[{

Cell[TextData[{
 " ",
 StyleBox["Universal relations  between trigonometric, hyperbolic and \
exponential functions of MV argument in GA  that follow from series\n\
expansion",
  FontSlant->"Italic"],
 ". \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          
          GridBox[{{"\[Null]", "Trigonometric", "Hyperbolic, exponential"}, {
            "\[Null]", 
             RowBox[{"sin", 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "-", "sin", 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}], 
             RowBox[{
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "-", 
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}]}, {"\[Null]", 
             RowBox[{"cos", 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "cos", 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}], 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox["sin", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "+", 
               SuperscriptBox["cos", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", "1"}], 
             RowBox[{
               SuperscriptBox[
                StyleBox["sh", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "-", 
               SuperscriptBox[
                StyleBox["ch", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", "1"}]}, {
            "\[Null]", 
             RowBox[{"cos", 
               RowBox[{"(", 
                 RowBox[{"2", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               SuperscriptBox["cos", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "-", 
               SuperscriptBox["sin", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "        "}], 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"2", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["ch", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "+", 
               SuperscriptBox[
                StyleBox["sh", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox["sin", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", "cos", 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    StyleBox["A", "TI"]}], ")"}]}], ")"}]}], 
             RowBox[{
               SuperscriptBox[
                StyleBox["sh", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["ch", FontSlant -> "Plain"], 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    StyleBox["A", "TI"]}], ")"}], "-", "1"}], ")"}]}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox["cos", "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", "cos", 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    StyleBox["A", "TI"]}], ")"}]}], ")"}]}], 
             RowBox[{
               SuperscriptBox[
                StyleBox["ch", FontSlant -> "Plain"], "2"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["ch", FontSlant -> "Plain"], 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    StyleBox["A", "TI"]}], ")"}], "+", "1"}], ")"}]}]}, {
            "\[Null]", "\[Null]", 
             RowBox[{
