Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Det", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"a", "[", "k", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j", ",", "m", ",", "n"}], "}"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"b", "[", "k", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j", ",", "m", ",", "n"}], "}"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"c", "[", "k", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j", ",", "m", ",", "n"}], "}"}]}], 
               "}"}]}], "]"}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"d", "[", "k", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j", ",", "m", ",", "n"}], "}"}]}], 
               "}"}]}], "]"}]}], "}"}], "]"}], "]"}], "\[GeometricProduct]", 
        RowBox[{
         RowBox[{"\[DoubleStruckE]", "[", "i", "]"}], "\[OuterProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "j", "]"}], "\[OuterProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "m", "]"}], "\[OuterProduct]", 
         RowBox[{"\[DoubleStruckE]", "[", "n", "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "i", ",", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "j", ",", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "m", ",", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
        "}"}]}], "]"}], "//", "gaPE"}], ")"}]}], ";"}]], "Input",
 CellGroupingRules->{GroupTogetherGrouping, 10001.},
