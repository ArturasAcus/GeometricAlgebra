Cell["\<\
Create a function that calls itself until blade with negative signature will \
be generated\
\>", "Text",ExpressionUUID->"f189e91e-7278-41a3-8fe4-6220ac42fbb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomCoefficientSet", "[", 
   RowBox[{"theAlg_", ",", "coeffRange_List"}], "]"}], ":=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"a", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"b", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}], "->", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"coeffRange", ",", 
      RowBox[{"2", "*", 
       RowBox[{"gaDimensionOfVectorSpace", "[", "theAlg", "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"2d95f0c3-9391-404e-948f-18c3186804d7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateNegativeBlade", "[", 
   RowBox[{"theAlg_", ",", "coeffRange_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tempCoeff", "=", 
      RowBox[{"generateRandomCoefficientSet", "[", 
       RowBox[{"theAlg", ",", "coeffRange"}], "]"}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"gaPE", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a1", "\[OuterProduct]", "b1"}], ")"}], 
            "\[GeometricProduct]", 
            RowBox[{"(", 
             RowBox[{"a1", "\[OuterProduct]", "b1"}], ")"}]}], "]"}], "/.", 
          "tempCoeff"}], ")"}], ">=", "0"}], ",", 
       RowBox[{"tempCoeff", "=", 
        RowBox[{"generateRandomCoefficientSet", "[", 
         RowBox[{"theAlg", ",", "coeffRange"}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "tempCoeff"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
  "In[100]:=",ExpressionUUID->"21371d83-dfa9-482c-bd0e-a7fe223df3bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"coefficientRulesNegative", "=", 
  RowBox[{"generateNegativeBlade", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "20"}], ",", "20"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"negativeSquaredBivector", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a1", "\[OuterProduct]", "b1"}], ")"}], "\[GeometricProduct]", 
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"gaNormReverseAbs", "[", 
         RowBox[{"a1", "\[OuterProduct]", "b1"}], "]"}], ")"}]}], ")"}]}], 
    ")"}], "/.", "coefficientRulesNegative"}]}]}], "Input",
 CellLabel->
  "In[101]:=",ExpressionUUID->"6c24296b-ca35-4b40-8b76-93a8b412917e"],

