Cell["\<\
Even more way out is to program determinant formula given in A. Macdonald,  \
\[CloseCurlyDoubleQuote]Linear and Geometric Algebra\[CloseCurlyDoubleQuote] \
p.157, which utilizes inner product (note reciprocal base vectors, without \
them the formula is not valid for general Cl[p,q] algebras.\
\>", "Text",
 CellGroupingRules->{
  GroupTogetherGrouping, 
   10000.},ExpressionUUID->"e1f83673-932f-434f-9911-88a6f96eb5eb"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", "\[Wedge]", "b"}], "..."}], "\[Wedge]", "z"}], "=", 
   RowBox[{"det", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {"...", "...", "...", "..."},
       {
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]}
      }], "\[NoBreak]", ")"}], " ", 
    StyleBox["I",
     FontWeight->"Bold",
     FontSlant->"Italic"]}]}]}]], "DisplayFormula",
 CellChangeTimes->{
  3.6831281237374787`*^9, {3.683128197472729*^9, 3.6831282928623524`*^9}, {
   3.683128375041707*^9, 3.68312878642068*^9}, {3.683129179353694*^9, 
   3.6831291849564533`*^9}, {3.68334938318907*^9, 
   3.683349434863529*^9}},ExpressionUUID->"5e316976-e03a-4d2a-abfb-\
500e2ecce27f"],

