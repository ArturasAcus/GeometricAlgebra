Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Trigonometric and hyperbolic functions for parallel vectors. ",
  FontSlant->"Italic"],
 "If two vectors a and b are parallel, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\|b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7640357-ce46-4ae1-be7a-bcfd4779ba80"],
 ", then trigonometric and hyperbolic functions can be expressed by functions \
of single arguments.\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"sin", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[PlusMinus]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", "sin", 
               StyleBox["a", "TI"], "cos", 
               StyleBox["b", "TI"], "\[PlusMinus]", "cos", 
               StyleBox["a", "TI"], "sin", 
               StyleBox["b", "TI"], "        "}], 
             RowBox[{"  ", "if ", 
               StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
               StyleBox["b", "TI"], " and ", 
               SuperscriptBox[
                StyleBox["a", "TI"], "2"], ",", 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"], ">", "\[LongEqual]", "<", "0", 
               ","}]}, {"\[Null]", 
             RowBox[{"cos", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[PlusMinus]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", "cos", 
               StyleBox["a", "TI"], "cos", 
               StyleBox["b", "TI"], "\[MinusPlus]", "sin", 
               StyleBox["a", "TI"], "sin", 
               StyleBox["b", "TI"]}], 
             RowBox[{"  ", "if ", 
               StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
               StyleBox["b", "TI"], " and ", 
               SuperscriptBox[
                StyleBox["a", "TI"], "2"], ",", 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"], ">", "\[LongEqual]", "<", "0", 
               ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[PlusMinus]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["a", "TI"], " ", 
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["b", "TI"], "\[PlusMinus]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["a", "TI"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["b", "TI"]}], 
             RowBox[{"  ", "if ", 
               StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
               StyleBox["b", "TI"], " and ", 
               SuperscriptBox[
                StyleBox["a", "TI"], "2"], ",", 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"], ">", "\[LongEqual]", "<", "0", 
               ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[PlusMinus]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["a", "TI"], " ", 
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["b", "TI"], "\[PlusMinus]", 
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["a", "TI"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["b", "TI"]}], 
             RowBox[{"  ", "if ", 
               StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
               StyleBox["b", "TI"], " and ", 
               SuperscriptBox[
                StyleBox["a", "TI"], "2"], ",", 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"], ">", "\[LongEqual]", "<", "0", 
               ","}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n    \\sin(a\\pm b)=\\sin a\\cos b\\pm\\cos a\\sin \
b\\qquad\\qquad&\\quad \\text{if } a\\| b \\text{ and } a^2,b^2 > = < \
0,}\\\\&\n    \\cos(a\\pm b)=\\cos a\\cos b\\mp\\sin a\\sin b&\\quad \
\\text{if } a\\| b \\text{ and } a^2,b^2 > = < 0,} \\\\&\n    \\sh(a\\pm \
b)=\\sh a\\,\\ch b\\pm\\ch a\\,\\sh b&\\quad \\text{if } a\\| b \\text{ and } \
a^2,b^2 > = < 0,}\\\\&\n    \\ch(a\\pm b)=\\ch a\\,\\ch b\\pm\\sh a\\,\\sh b&\
\\quad \\text{if } a\\| b \\text{ and } a^2,b^2 > = < 0,}\\\\\n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce44b516-d369-4688-a7ff-1c3a7793286e"],
 "\[LineSeparator]"
}], "Item",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.911277994344613*^9, 3.911278013642212*^9}, {
   3.911278145628385*^9, 3.911278147996205*^9}, {3.911278216851118*^9, 
   3.911278220325323*^9}, {3.911278296276189*^9, 3.911278306844193*^9}, {
   3.911278986914878*^9, 3.911278992230295*^9}, {3.911279195696149*^9, 
   3.9112792072841263`*^9}, {3.911279763189295*^9, 3.911279820327443*^9}, 
   3.9112800999322863`*^9, {3.911282951343533*^9, 3.911282983473568*^9}, {
