Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["MV argument multiplied by  imaginary unit.  ",
  FontSlant->"Italic"],
 "For real GA",
 StyleBox[".",
  FontSlant->"Italic"],
 "\n \[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"sin", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["i", FontSlant -> "Plain"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["A", "TI"]}], 
             RowBox[{
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["i", FontSlant -> "Plain"], " ", "sin", 
               StyleBox["A", "TI"]}]}, {"\[Null]", 
             RowBox[{"cos", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["A", "TI"]}], 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", "cos", 
               StyleBox["A", "TI"]}]}, {"\[Null]", 
             RowBox[{"tan", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["i", FontSlant -> "Plain"], " ", 
               StyleBox["th", FontSlant -> "Plain"], 
               StyleBox["A", "TI"]}], 
             RowBox[{
               StyleBox["th", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["i", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["i", FontSlant -> "Plain"], " ", "tan", 
               StyleBox["A", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{"\[PlusMinus]", 
                  StyleBox["i", FontSlant -> "Plain"], 
                  StyleBox["A", "TI"]}]], "\[LongEqual]", "cos", 
               StyleBox["A", "TI"], "\[PlusMinus]", 
               StyleBox["i", FontSlant -> "Plain"], " ", "sin", 
               StyleBox["A", "TI"], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{"\[PlusMinus]", 
                  StyleBox["A", "TI"]}]], "\[LongEqual]", "cos", 
               StyleBox["A", "TI"], "\[PlusMinus]", "sin", 
               StyleBox["A", "TI"], ",  ", 
               StyleBox["A", "TI"], "\[Element]", "real GA"}], "\[Null]"}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n\\sin(\\ii\\m{A})=\\ii\\,\\sh\\m{A} \
&\\sh(\\ii\\m{A})=\\ii\\,\\sin\\m{A}\\\\&\n\\cos(\\ii\\m{A})=\\ch\\m{A} \
&\\ch(\\ii\\m{A})=\\cos\\m{A} \\\\&\n\
\\tan(\\ii\\m{A})=\\ii\\,\\mathrm{th}\\m{A} &\\mathrm{th}(\\ii\\m{A})=\\ii\\,\
\\tan\\m{A}\\\\&\n\\ee^{\\pm\\ii\\m{A}}=\\cos\\m{A}\\pm\\ii\\,\\sin\\m{A}\n\
\\ee^{\\pm\\m{A}}=\\cos\\m{A}\\pm\\sin\\m{A},\\quad\\m{A}\\in\\text{real GA}\n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e302639-d860-42a4-a31b-50d8de01e6f5"],
 "\[LineSeparator]"
}], "Item",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.911277994344613*^9, 3.911278013642212*^9}, {
   3.911278145628385*^9, 3.911278147996205*^9}, {3.911278216851118*^9, 
   3.911278220325323*^9}, {3.911278296276189*^9, 3.911278306844193*^9}, {
   3.911278986914878*^9, 3.911278992230295*^9}, {3.911279195696149*^9, 
   3.9112792072841263`*^9}, {3.911279763189295*^9, 3.911279820327443*^9}, 
   3.9112800999322863`*^9, {3.911282951343533*^9, 3.911282983473568*^9}, {
   3.9112835044989767`*^9, 3.911283512327914*^9}, {3.911284058824835*^9, 
   3.9112840660647984`*^9}, {3.9112844645820427`*^9, 
   3.9112844658607388`*^9}, {3.911285427454977*^9, 3.911285431353183*^9}, 
   3.911285501882889*^9, {3.91128555634278*^9, 3.911285561476547*^9}, {
   3.9113536679598227`*^9, 3.911353671703227*^9}, 3.911353701863498*^9, {
   3.911353732809595*^9, 3.91135380665493*^9}, {3.911356197256589*^9, 
   3.911356259605613*^9}, {3.911357372261434*^9, 3.911357409967952*^9}, {
