       RowBox[{"Sin", "[", 
        RowBox[{"|", "\[ScriptCapitalA]", "|"}], "]"}], " ", "if", " ", 
       SuperscriptBox["\[ScriptCapitalA]", "2"]}]}], "<", "0"}]}], ",", " ", 
   RowBox[{"for", " ", 
