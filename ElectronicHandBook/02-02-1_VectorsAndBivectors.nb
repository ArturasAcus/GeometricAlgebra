Cell[CellGroupData[{

Cell["\<\
Test if magnitude of product is a product of magnitudes (abs)\
\>", "SubsubitemParagraph",ExpressionUUID->"73d1628f-400e-4814-9e44-\
37d8729f9f28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generateRandomCoefficientSet", "[", 
   RowBox[{"theAlg_", ",", "coeffRange_List"}], "]"}], ":=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"a", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"b", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}], "->", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"coeffRange", ",", 
      RowBox[{"2", "*", 
       RowBox[{"gaDimensionOfVectorSpace", "[", "theAlg", "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"7e6c4a69-dac9-45e3-9ab6-671d0e8fab8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"coefficientRules", "=", 
  RowBox[{"generateRandomCoefficientSet", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "20"}], ",", "20"}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"magnitudeOfProduct", "=", 
  RowBox[{"gaNormReverseAbs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a1", "\[GeometricProduct]", "b1"}], ")"}], "/.", 
    "coefficientRules"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"productOfMagnitudes", "=", 
  RowBox[{
   RowBox[{"gaNormReverseAbs", "[", 
    RowBox[{"a1", "/.", "coefficientRules"}], "]"}], "*", 
   RowBox[{"gaNormReverseAbs", "[", 
    RowBox[{"b1", "/.", "coefficientRules"}], 
