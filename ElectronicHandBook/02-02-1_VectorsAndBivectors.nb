Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Mixed products of three vectors",
  FontSlant->"Italic"],
 ". The first two expressions define two vectors that lie in  plane ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b\\w c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4ad5740-b601-4e96-889f-008bd8ab1ef9"],
 " and simultaneously  are orthogonal to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1bfe424-94df-45fe-98d8-2eedfaf0dbd5"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "\[Wedge]", 
                    StyleBox["c", "TI"]}], ")"}]}], "\[RightAngleBracket]"}], 
                "1"], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["c", "TI"], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               StyleBox["b", "TI"]}]}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "\[CenterDot]", 
               StyleBox["a", "TI"], "\[LongEqual]", "-", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               StyleBox["b", "TI"], "-", 
               RowBox[{"(", 
