Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", "k", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
