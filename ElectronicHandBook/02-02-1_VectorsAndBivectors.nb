Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of a general vector a",
  FontSlant->"Italic"],
 ". In real algebra  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{p}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0a24848-8da3-4a73-886b-e1472d527cfe"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=p+q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84e0b082-5825-4ccc-ba01-3cc93850d9b4"],
 ", the coefficients ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Alpha]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4813ac42-0fbc-4050-961f-24b3ff890581"],
 " of the vector are real numbers, \[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox["\[Alpha]", "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "\[Ellipsis]", "+", 
         
         SuperscriptBox["\[Alpha]", 
          StyleBox["n", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]], ",  ", 
         SuperscriptBox["\[Alpha]", 
          StyleBox["i", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "a=\\alpha^1\\e{1}+\\alpha^2\\e{2}+\\dots+\\alpha^n\\e{n},\\quad \
\\alpha^i\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97c1d5db-94dc-4351-8962-39a1d498b51c"],
 "\[DoubleStruckCapitalR].\[LineSeparator]\n If algebra is complex then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", 
          StyleBox["i", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^i\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06770fcd-7390-42ea-ae4c-b0bddc7d558d"],
 "\[DoubleStruckCapitalC]. Properties of vector in real GA [",
 StyleBox["2  savybe neteisinga, visada ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\d a=aa", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "7f1fe4b9-a141-481d-9134-5c234060b04e"],
 StyleBox[", bet kokiai signaturai: pataisyti ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "80d2d8e2-293f-4767-94dc-299dfc70217e"],
 " faile ",
 StyleBox["!",
  FontColor->RGBColor[1, 0, 0]],
 "]"
}], "ItemParagraph",ExpressionUUID->"0de30352-882c-4c2f-ac48-c50a0588bd07"],

