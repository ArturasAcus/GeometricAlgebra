                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"]}], ")"}], "2"], "+", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["b", "TI"], 
                    StyleBox["a", "TI"]}], ")"}], "2"], "\[LongEqual]", "2", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["b", "TI"]}], ")"}], "2"], "+", "2", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "\[Wedge]", 
                    StyleBox["b", "TI"]}], ")"}], "2"], "\[LongEqual]", "4", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["b", "TI"]}], ")"}], "2"], "-", "2", 
               SuperscriptBox[
                StyleBox["a", "TI"], "2"], 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["a", "TI"]}], ")"}], 
               StyleBox["a", "TI"]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"], 
                    StyleBox["a", "TI"]}], "\[RightAngleBracket]"}], "1"], 
               "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["a", "TI"], "+", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
               StyleBox["a", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"], 
                    StyleBox["a", "TI"]}], ")"}], "2"], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["a", "TI"], "4"], 
               SuperscriptBox[
                StyleBox["b", "TI"], "2"]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
