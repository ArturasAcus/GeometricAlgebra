\\cos(-\\m{A})=\\cos(\\m{A}) & \\ch(-\\m{A})=\\ch(\\m{A})\\\\&\n\
\\sin^2(\\m{A})+\\cos^2(\\m{A})=1 &\\sh^2(\\m{A})-\\ch^2(\\m{A})=1\\\\&\n\
