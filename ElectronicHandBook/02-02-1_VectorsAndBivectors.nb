Cell[TextData[{
 "Note, Since the ",
 StyleBox["Power[ ]",
  FontWeight->"Bold"],
 " operator is absent  in the geometric product, instead one can use \
copy/paste or ",
 StyleBox["Table[ ]",
  FontWeight->"Bold"],
 " command, or simply % command to construct the powers.\nLHS "
}], "Text",ExpressionUUID->"4c08146c-10e5-485c-82b2-a19fc46028bc"],

