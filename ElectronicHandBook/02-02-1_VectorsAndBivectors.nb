                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"], "-", 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"]}], ")"}]}], 
             "definition of outer (wedge) product"}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
