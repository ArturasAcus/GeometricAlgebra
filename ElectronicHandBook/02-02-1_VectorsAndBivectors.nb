    0}},ExpressionUUID->"2e82cb63-6cb7-4788-a928-2044a6725401"],

Cell[TextData[{
 "\nIn GA, the most important are exponential, trigonometric, hyperbolic and \
logarithmic functions. They are defined via  series. Of them, the MV \
exponential is of special importance in solving MV differential equations. \
More about GA functions see ",
 StyleBox["Chap.~\\ref{ch:genmultivector}. ",
  FontColor->RGBColor[1, 0, 0]],
 "Here and below ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "035d2e00-2d18-4306-b771-8335270eb933"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71d2c1c8-9f43-4a7a-8d53-a9c6bb1807df"],
 " denotes a general MV."
}], "Text",ExpressionUUID->"c90a456b-b647-4db9-b7c5-3613e8df8765"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Exponential, trigonometric, hyperbolic and logarithmic series",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", "1", "+", 
