Cell[TextData[{
 " ",
 StyleBox["Three vector formula",
  FontSlant->"Italic"],
 ". The identity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[Wedge]", 
             StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["b", "TI"]}], ")"}], 
         StyleBox["c", "TI"], "-", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["c", "TI"]}], ")"}], 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\d(b\\w c)=(a\\d b)c-(a\\d c)b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "753f99b6-c4bd-4188-9827-e7e715ae3a21"],
 " is very important in applications. It can be derived in the following way:\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"4", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}]}], 
             RowBox[{"\[LongEqual]", "2", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "\[Wedge]", 
                    StyleBox["c", "TI"]}], ")"}], "-", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "\[Wedge]", 
                    StyleBox["c", "TI"]}], ")"}], 
                   StyleBox["a", "TI"]}], ")"}]}]}, {"\[Null]", "\[Null]", 
             RowBox[{"\[LongEqual]", 
               StyleBox["a", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], "-", 
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], "-", 
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["a", "TI"], "\[LongEqual]", 
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"], 
               StyleBox["c", "TI"], "-", 
               StyleBox["a", "TI"], 
               StyleBox["c", "TI"], 
               StyleBox["b", "TI"], "-", 
               StyleBox["b", "TI"], 
               StyleBox["c", "TI"], 
               StyleBox["a", "TI"], "+", 
               StyleBox["c", "TI"], 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"]}]}, {"\[Null]", "\[Null]", 
             RowBox[{"\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], "+", 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["c", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"], "+", 
                   StyleBox["c", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], 
                   StyleBox["a", "TI"], "+", 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["c", "TI"]}], ")"}], "+", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"], "+", 
                   StyleBox["c", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"]}], ")"}]}]}, {"\[Null]", "\[Null]", 
             RowBox[{"\[LongEqual]", "2", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["b", "TI"]}], ")"}], 
                   StyleBox["c", "TI"], "-", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["c", "TI"]}], ")"}], 
                   StyleBox["b", "TI"], "-", 
                   StyleBox["b", "TI"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["c", "TI"], "\[CenterDot]", 
                    StyleBox["a", "TI"]}], ")"}], "+", 
                   StyleBox["c", "TI"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "\[CenterDot]", 
                    StyleBox["a", "TI"]}], ")"}]}], ")"}]}]}, {
            "\[Null]", "\[Null]", 
             RowBox[{"\[LongEqual]", "4", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["b", "TI"]}], ")"}], 
                   StyleBox["c", "TI"], "-", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["c", "TI"]}], ")"}], 
                   StyleBox["b", "TI"]}], ")"}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n&4a\\d(b\\w c)&=2\\big(a(b\\w c)-(b\\w c)a\\big)\\\\&\n\
&=a(bc-cb)-(bc-cb)a=abc-acb-bca+cba\\\\&\n\
&=(abc+bac)-(acb+cab)-(bca+bac)+(cba+cab)\\\\&\n&=2\\big((a\\d b)c-(a\\d \
c)b-b(c\\d a)+c(b\\d a)\\big)\\\\&\n&=4\\big((a\\d b)c-(a\\d c)b\\big)\n\
\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6eb5033d-096c-489c-81e5-3346ec33eaa9"]
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"59e6092c-9dff-49ea-b48a-f2eaca00506f"]
}, Closed]],

