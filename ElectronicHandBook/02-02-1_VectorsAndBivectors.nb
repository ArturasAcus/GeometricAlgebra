                Take[{
                  SlotSequence[1]}, {Length[{2}] + 1, 
                  Length[{2}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
          Tooltip -> "mvDownUp[{2}, {}]"], 
         TemplateBox[{"3", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
