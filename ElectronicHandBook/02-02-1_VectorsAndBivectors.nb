   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"sin", 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", "-", "sin", 
               StyleBox["a", "TI"]}], 
             RowBox[{"    ", "cos", 
               RowBox[{"(", 
                 RowBox[{"-", 
                   StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", "cos", 
               StyleBox["a", "TI"]}]}, {"\[Null]", 
