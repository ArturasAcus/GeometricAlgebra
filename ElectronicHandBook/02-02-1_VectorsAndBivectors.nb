\\ch(|\\cB|\\hat{\\cB})=\\cos|\\cB|\n&\\sin(|\\cB|\\hat{\\cB})=\\hat{\\cB}\\,\
\\sh|\\cB|\\\\&\n\\sh(|\\cB|\\hat{\\cB})=\\hat{\\cB}\\sin|\\cB|\\qquad\\qquad\
\\qquad\n&\\sin^2(|\\cB|\\hat{\\cB})+\\cos^2(|\\cB|\\hat{\\cB})=1\\\\&\n\
\\cos(|\\cB|\\hat{\\cB})=\\ch|\\cB|\n\
&\\sin^2(|\\cB|\\hat{\\cB})-\\cos^2(|\\cB|\\hat{\\cB})=-\\ch(2|\\cB|)\n\
\\end{aligned}", "state" -> "Boxes"|>,
