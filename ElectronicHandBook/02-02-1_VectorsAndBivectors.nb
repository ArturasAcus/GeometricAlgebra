}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"gaNormReverseAbs", "[", "a1", "]"}], "*", 
     RowBox[{"gaNormReverseAbs", "[", "b1", "]"}], "*", 
     RowBox[{"Sin", "[", "theTheta", "]"}], "*", "squaredBivector"}], "/.", 
