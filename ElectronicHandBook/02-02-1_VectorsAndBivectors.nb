Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"gaNormReverseAbs", "[", "a1", "]"}], "*", 
    RowBox[{"gaNormReverseAbs", "[", "b1", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], "+", 
      RowBox[{"negativeSquaredBivector", "*", 
       RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}]}], ")"}]}], "/.", 
