Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tan", 
         RowBox[{"(", 
           RowBox[{"\[Alpha]", "\[PlusMinus]", 
             OverscriptBox[
              StyleBox["B", "TI"], "^"], "\[Beta]"}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"sin", "2", "\[Alpha]", "\[PlusMinus]", 
            OverscriptBox[
             StyleBox["B", "TI"], "^"], "sin", "2", "\[Beta]"}], 
          RowBox[{"cos", "2", "\[Alpha]", "+", "cos", "2", "\[Beta]"}]], 
         ",  ", "if ", 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["B", "TI"], "^"], "2"], "\[LongEqual]", "1", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\tan(\\alpha\\pm \\hat{\\cB}\\beta)=\\frac{\\sin \
2\\alpha\\pm\\hat{\\cB}\\sin 2\\beta}{\\cos 2\\alpha+\\cos 2\\beta},\\quad \
\\text{if } \\hat{\\cB}^2=1,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c007e441-6cb5-4d70-b2cf-c0157ce210ad"],
