Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Exponential functions of general MV. ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["A", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\magnitude{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e166cc4-60d7-4bce-9123-7fc7d45032cb"],
 " is the MV magnitude (aka norm, ",
 StyleBox["unit~\\ref{norm}",
  FontColor->RGBColor[1, 0, 0]],
 ") and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "\[LongEqual]", 
         FractionBox[
          StyleBox["A", "TI"], 
          TemplateBox[{
            RowBox[{
              StyleBox["A", "TI"]}]}, "Abs"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\hat{\\m{A}}=\\frac{\\m{A}}{\\magnitude{\\m{A}}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce300926-6dd0-4408-b80b-ded65a7be75c"],
 " [",
 StyleBox["ne viskas parodyta, veliau",
  FontColor->RGBColor[1, 0, 0]],
 "]\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{"2", 
                  StyleBox["A", "TI"]}]]}], "\[Null]"}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{"-", 
                  StyleBox["A", "TI"]}]], "\[LongEqual]", "1"}], "\[Null]"}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  SuperscriptBox[
                   StyleBox["e", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]], ")"}], 
                StyleBox["n", "TI"]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["n", "TI"], 
                  StyleBox["A", "TI"]}]]}], 
             RowBox[{
               StyleBox["n", "TI"], "\[Element]", 
               StyleBox["Z", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  SuperscriptBox[
                   StyleBox["e", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"]], ")"}], "-1"], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{"-", 
                  StyleBox["A", "TI"]}]]}], "inverse of exponential"}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}], "+", 
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 StyleBox["A", "TI"], ")"}]}], 
             RowBox[{"if ", 
               StyleBox["A", "TI"], " is general multivector"}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", "cos", "|", 
               StyleBox["A", "TI"], "|", "+", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], "sin", "|", 
               StyleBox["A", "TI"], "|        "}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], " is a scalar", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "<", "0"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], "|", 
               StyleBox["A", "TI"], "|", "+", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], "|", 
               StyleBox["A", "TI"], "|"}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "is a scalar ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], ">", "0"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", "1", "+", 
               StyleBox["A", "TI"]}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "is a scalar ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "\[LongEqual]", "0"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["A", "TI"], "+", 
                  StyleBox["B", "TI"]}]], "\[NotEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["B", "TI"]]}], "in general"}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["A", "TI"], "+", 
                  StyleBox["B", "TI"]}]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["B", "TI"]]}], 
             RowBox[{"if MV ", 
               StyleBox["A", "TI"], " and ", 
               StyleBox["B", "TI"], " commute", ",", 
               StyleBox["A", "TI"], 
               StyleBox["B", "TI"], "\[LongEqual]", 
               StyleBox["B", "TI"], 
               StyleBox["A", "TI"], "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}&\n \\ee^{\\m{A}}\\ee^{\\m{A}}=\\ee^{2\\m{A}}&\\\\&\n\
\\ee^{\\m{A}}\\ee^{-\\m{A}}=1&\\\\&\n\
\\left(\\ee^{\\m{A}}\\right)^n=\\ee^{n\\m{A}}&n\\in Z\\\\&\n  \
\\left(\\ee^{\\m{A}}\\right)^{-1}=\\ee^{-\\m{A}}&\\text{inverse of \
exponential}\\\\&\n  \\ee^{\\m{A}}=\\ch(\\m{A})+\\sh(\\m{A}) &\\text{if \
}\\m{A} \\text{ is general multivector}\\\\&\n  \
\\ee^{\\m{A}}=\\cos|\\m{A}|+\\hat{\\m{A}}\\sin|\\m{A}| \\qquad \
\\qquad&\\text{if } \\m{A}^2 \\text{ is a scalar} \\m{A}^2<0\\\\&\n\
\\ee^{\\m{A}}=\\ch|\\m{A}|+\\hat{\\m{A}}\\,\\sh|\\m{A}| &\\text{if } \\m{A}^2 \
 \\text{is a scalar } \\m{A}^2>0 \\\\&\n\\ee^{\\m{A}}=1+\\m{A}&\\text{if } \
\\m{A}^2 \\text{is a scalar } \\m{A}^2=0\\\\&\n\\ee^{\\m{A}+\\m{B}}\\ne\\ee^{\
\\m{A}}\\ee^{\\m{B}}&\\text{in general} \\\\&\n\
\\ee^{\\m{A}+\\m{B}}=\\ee^{\\m{A}}\\ee^{\\m{B}} &\\text{if MV } \\m{A}\n\
\\text{ and } \\m{B} \\text{ commute}, \\m{A}\\m{B}=\\m{B}\\m{A}.\n\
\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef525c7a-070e-4f49-8b18-b24ba59e12f6"],
 "\[LineSeparator]\[LineSeparator]",
 StyleBox["How to understand and compute a norm ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["A", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "|\\m{A}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "ef8d3557-d60c-4b3a-987d-92097d114541"],
 StyleBox[" of MV, which is not a blade is explained below.",
  Background->RGBColor[0.87, 0.94, 1]],
 "\[LineSeparator]"
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"1321f120-e2f8-4edf-b578-24591fb11f30"],

