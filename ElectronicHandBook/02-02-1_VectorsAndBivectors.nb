Cell[BoxData[
 RowBox[{"randRules", "=", 
  RowBox[{"Join", "[", 
   RowBox[{
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
         "]"}]}], ")"}], "->", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}], 
         "}"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "/@", 
