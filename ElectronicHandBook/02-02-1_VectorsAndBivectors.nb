Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Bivector products and commutators. ",
  FontSlant->"Italic"],
 "GA commutator of bivectors  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cA", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7dcacc0-5f7d-4b67-87fb-7f1fb41dcd2d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5688a117-a851-4b98-a420-b57d29e2b009"],
 " is defined as   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[Cross]", 
         StyleBox["B", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], 
             StyleBox["B", "TI"], "-", 
             StyleBox["B", "TI"], 
             StyleBox["A", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\cA\\times\\cB=\\frac12(\\cA\\cB-\\cB\\cA)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "105cccf4-2570-4c4c-be9e-3fdd5223b38f"],
 "   and should not be confused with  symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Cross]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\bf\\times", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4cc6910-1181-45cf-803c-5182d9ce7633"],
 " for  vector   product (in Mathematica notebook they are indistinguishable)\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], 
               StyleBox["B", "TI"], "\[LongEqual]", 
               StyleBox["A", "TI"], "\[CenterDot]", 
               StyleBox["B", "TI"], "+", 
               StyleBox["A", "TI"], "\[Cross]", 
               StyleBox["B", "TI"], "+", 
               StyleBox["A", "TI"], "\[Wedge]", 
               StyleBox["B", "TI"]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["B", "TI"], 
               StyleBox["A", "TI"], "\[LongEqual]", 
               StyleBox["A", "TI"], "\[CenterDot]", 
               StyleBox["B", "TI"], "-", 
               StyleBox["A", "TI"], "\[Cross]", 
               StyleBox["B", "TI"], "+", 
               StyleBox["A", "TI"], "\[Wedge]", 
               StyleBox["B", "TI"]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[Cross]", 
               StyleBox["B", "TI"], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    StyleBox["A", "TI"], "\[Cross]", 
                    StyleBox["B", "TI"]}], "\[RightAngleBracket]"}], "2"], 
               "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], 
                   StyleBox["B", "TI"], "-", 
                   StyleBox["B", "TI"], 
                   StyleBox["A", "TI"]}], ")"}], "/", "2"}]}, {"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["B", "TI"], 
                   StyleBox["C", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], "\[Cross]", 
                   StyleBox["B", "TI"]}], ")"}], 
               StyleBox["C", "TI"], "+", 
               StyleBox["B", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], "\[Cross]", 
                   StyleBox["C", "TI"]}], ")"}]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["B", "TI"], "\[Cross]", 
                   StyleBox["C", "TI"]}], ")"}], "+", 
               StyleBox["B", "TI"], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["C", "TI"], "\[Cross]", 
                   StyleBox["A", "TI"]}], ")"}], "+", 
               StyleBox["C", "TI"], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], "\[Cross]", 
                   StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", "0"}]}, {
            "\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], "\[Wedge]", 
                   StyleBox["d", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], "\[Wedge]", 
                   StyleBox["d", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], "\[Wedge]", 
                   StyleBox["d", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "  ", "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["d", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[CenterDot]", 
                   StyleBox["d", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "+", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["d", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["d", "TI"]}], ")"}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n&\\cA\\cB=\\cA\\d\\cB+\\cA\\times\\cB+\\cA\\w\\cB\\\\&\n\
\\cB\\cA=\\cA\\d\\cB-\\cA\\times\\cB+\\cA\\w\\cB\\\\&\n\
\\cA\\times\\cB=\\langle\\cA\\times\\cB\\rangle_2=(\\cA\\cB-\\cB\\cA)/2\\\\&\n\
\\cA\\times(\\cB C)=(\\cA\\times\\cB) C+\\cB(\\cA\\times C)\\\\&\n\
\\cA\\times(\\cB\\times C)+\\cB\\times( \
C\\times\\cA)+C\\times(\\cA\\times\\cB)=0\\\\&\n (a \\w b)\\times (c\\w d) = \
(a\\w b) (c\\w d)-(c\\w d)(a\\w b)\n\\quad=(b\\d c)(a\\w d)-(b\\d d)(a\\w \
c)+(a\\d d)(b\\w c)- (a\\d c) (b\\w\nd)\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "07b91f97-0ec0-4191-8afe-5b2d98843d94"],
 "\[LineSeparator]\[LineSeparator]The last expression is the structural \
equation for the Lie algebra of orthogonal group. The next-to-last expression \
is the Jacobi identity."
}], "Item",ExpressionUUID->"5bd97c75-a5f9-4a36-8d3f-29afc57be112"],

