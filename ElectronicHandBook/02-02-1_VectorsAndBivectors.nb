Cell["Elementary  vector and bivector functions", "Section",
 CellChangeTimes->{{3.911278615298444*^9, 3.911278618639914*^9}},
 CounterAssignments->{{"Section", 1}, {"Subsubsection", 0}, {"Item", 34}, {
