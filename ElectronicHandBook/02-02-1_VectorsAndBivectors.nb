                SuperscriptBox[
                 StyleBox["A", "TI"], "5"], "5!"], "-", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["A", "TI"], "7"], "7!"], "+", "\[CenterEllipsis]", 
               ","}], 
             RowBox[{"cos", 
               StyleBox["A", "TI"], "\[LongEqual]", "1", "-", 
