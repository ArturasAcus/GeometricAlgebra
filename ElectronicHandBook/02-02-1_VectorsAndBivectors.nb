Cell[TextData[{
 " Case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[Alpha]", ",", "\[Beta]", "\[Element]"}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\alpha,\\beta\\in", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "\[DoubleStruckCapitalR]", " "}], 
   TraditionalForm]],ExpressionUUID->"a006235b-fc07-4c45-aeb8-7d7d604902cf"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["B", "TI"], "^"], "2"], "\[LongEqual]", "+1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\hat{\\cB}^2=+1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06fde0cc-157d-46fc-a4ca-8947f61ada6c"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"sin", 
               RowBox[{"(", 
                 RowBox[{"\[Alpha]", "\[PlusMinus]", 
                   OverscriptBox[
                    StyleBox["B", "TI"], "^"], "\[Beta]"}], ")"}], 
               "\[LongEqual]", "sin", "\[Alpha]", "cos", "\[Beta]", 
               "\[PlusMinus]", 
               OverscriptBox[
                StyleBox["B", "TI"], "^"], "cos", "\[Alpha]", "sin", 
               "\[Beta]"}]}, {"\[Null]", 
             RowBox[{"cos", 
               RowBox[{"(", 
                 RowBox[{"\[Alpha]", "\[PlusMinus]", 
                   OverscriptBox[
                    StyleBox["B", "TI"], "^"], "\[Beta]"}], ")"}], 
               "\[LongEqual]", "cos", "\[Alpha]", "cos", "\[Beta]", 
               "\[MinusPlus]", 
               OverscriptBox[
                StyleBox["B", "TI"], "^"], "sin", "\[Alpha]", "sin", 
               "\[Beta]"}]}, {"\[Null]", 
             RowBox[{"tan", 
               RowBox[{"(", 
                 RowBox[{"\[Alpha]", "\[PlusMinus]", 
                   OverscriptBox[
                    StyleBox["B", "TI"], "^"], "\[Beta]"}], ")"}], 
               "\[LongEqual]", 
               FractionBox[
                RowBox[{"sin", "2", "\[Alpha]", "\[PlusMinus]", 
                  OverscriptBox[
                   StyleBox["B", "TI"], "^"], "sin", "2", "\[Beta]"}], 
                RowBox[{"cos", "2", "\[Alpha]", "+", "cos", "2", "\[Beta]"}]],
                ",  ", "if ", 
               SuperscriptBox[
                OverscriptBox[
                 StyleBox["B", "TI"], "^"], "2"], "\[LongEqual]", "1", 
               ","}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n \
\\sin(\\alpha\\pm\\hat{\\cB}\\beta)=\\sin\\alpha\\cos\\beta\\pm\\hat{\\cB}\\\
cos\\alpha\\sin\\beta\\\\&\n  \\cos(\\alpha\\pm \
\\hat{\\cB}\\beta)=\\cos\\alpha\\cos\\beta\\mp\\hat{\\cB}\\sin\\alpha\\sin\\\
beta \\\\&\n \\tan(\\alpha\\pm \\hat{\\cB}\\beta)=\\frac{\\sin \
2\\alpha\\pm\\hat{\\cB}\\sin 2\\beta}{\\cos 2\\alpha+\\cos 2\\beta},\\quad \
\\text{if } \\hat{\\cB}^2=1,\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf2a3ab0-457b-4358-b360-a31e07d09d70"]
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
