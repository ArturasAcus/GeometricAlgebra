           RGBColor[
            0.6301652086419534, 0.8601603011396972, 0.42009862068890147`]}], 
         RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
     "\[DoubleStruckE]",
     DisplayFunction:>(StyleBox[
