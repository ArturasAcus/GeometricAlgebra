Cell[TextData[{
 "An angle between vectors can be computed from their inner product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"], 
         TemplateBox[{
           RowBox[{
             StyleBox["b", "TI"]}]}, "Abs"], "cos", "\[CurlyPhi]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a \\d b ={|a|}{|b|} \\cos \\varphi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eeedfa1b-b8c3-40e2-a016-1de9cd021b18"]
}], "Text",
 CellChangeTimes->{{3.913359912574298*^9, 3.9133599379495163`*^9}, {
  3.913360499087006*^9, 3.91336051087941*^9}, {3.913360773566475*^9, 
  3.91336081361205*^9}},ExpressionUUID->"01afbc3a-258b-4eee-ad14-\
d3fc9a5d2789"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"cosPhi", "=", 
  RowBox[{"gaPE", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a1", "\[InnerProduct]", "b1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaNormReverseAbs", "[", "a1", "]"}], "*", 
       RowBox[{"gaNormReverseAbs", "[", "b1", "]"}]}], ")"}]}], "/.", 
    "coefficientRulesNegative"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CurlyPhi]", "=", 
   RowBox[{"ArcCos", "[", "cosPhi", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.913360754057164*^9, 3.913360761137097*^9}, {
   3.9133609038217907`*^9, 3.913361050501926*^9}, 3.913361324992867*^9, 
   3.913361856541219*^9, {3.913367976039433*^9, 3.913368035475723*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"46d980bb-ec21-4ffe-b09d-a067052e2514"],

