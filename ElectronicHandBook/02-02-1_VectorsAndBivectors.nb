                  Length[{1}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
          Tooltip -> "mvDownUp[{1}, {}]"], 
         TemplateBox[{"3", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
            StyleBox[
            "Cl", {FontColor -> 
              RGBColor[
               0.6784313725490198, 0.847058823529412, 0.901960784313726]}], 
