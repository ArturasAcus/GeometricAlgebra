Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 FontWeight->"Bold",
 FontColor->RGBColor[0.6, 0.4, 0.2],
 Background->None,ExpressionUUID->"0d895276-722e-4321-bbb6-bfdaacdf7a1e"],

Cell["\<\
The above identities are very general and applies for any functions \
(non-commutative nature of GA is not important, since single MV always \
commute with itself).\
\>", "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"ab5d0f10-d6f6-4fdf-a4c8-db3a2b821127"]
}, Closed]],

Cell[TextData[{
 " ",
 StyleBox["Exponential of parallel and antiparallel vectors",
  FontSlant->"Italic"],
 ". If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e50a7fb-83d5-4e94-a4e7-0b5bb29b071e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af8fb5ca-bb0e-4061-9831-8e77317f8432"],
 " are parallel vectors, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[DoubleVerticalBar]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\|b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7a6c72d-4986-4a95-87d8-4da9488de04e"],
 ", then the commutator vanishes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             StyleBox["a", "TI"], ",", 
             StyleBox["b", "TI"]}], "]"}], "\[LongEqual]", 
         StyleBox["a", "TI"], 
         StyleBox["b", "TI"], "-", 
         StyleBox["b", "TI"], 
         StyleBox["a", "TI"], "\[LongEqual]", "2", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "[a,b]=ab-ba=2a\\w b=0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7cedbd9-eb19-4746-8e1e-9c4ee3fcf239"],
 ". In this case ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["a", "TI"], "+", 
            StyleBox["b", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["a", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\ee^{a+b}=\\ee^{a}\\ee^{b}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6194aeae-7842-4829-bbd7-a2a43961b00a"],
 ". If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Perpendicular]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\perp b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9710956a-b9d7-4229-bd9e-f0b3f4b954e8"],
 " then the anticommutator is equal to zero ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], 
             StyleBox["b", "TI"], "+", 
             StyleBox["b", "TI"], 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", "2", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(ab+ba)=2a\\d b=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8abe20de-62af-489d-ac3c-a2846a7005f0"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["a", "TI"], "+", 
            StyleBox["b", "TI"]}]], "\[NotEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["a", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["b", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\ee^{a+b}\\ne\\ee^{a}\\ee^{b}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ccab82be-ed59-41b3-bbfe-d9867ea08798"],
 ". The higher order commutators do not vanish as well. The exponential of \
the sum of nonparallel vectors therefore cannot be factored as a product of \
exponentials of individual vectors (see ",
 StyleBox["unit~\\ref{exponentB}",
  FontColor->RGBColor[1, 0, 0]],
 ")."
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"193d5591-e9aa-4488-8498-36edc83f1948"],

Cell[TextData[{
 " ",
 StyleBox["Exponential of bivectors",
  FontSlant->"Italic"],
 ". In 4D and higher dimensional spaces there are planes which do not \
intersect. The bivectors which are represented by such planes do not have \
common indices and the  sum  of bivectors cannot be reduced to a single \
blade. As a result ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["B", "TI"], 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"]}]], ",", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              RowBox[{
                StyleBox["k", "TI"], 
                StyleBox["l", "TI"]}]]}], "]"}], "\[LongEqual]", "0"}], 
