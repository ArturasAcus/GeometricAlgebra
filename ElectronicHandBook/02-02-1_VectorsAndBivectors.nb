Cell[TextData[{
 "In complex GAs, the complex conjugation (denoted by asterisk) of one of \
coefficients  must be included: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[Rule]", 
         StyleBox["a", "TI"], 
         SuperscriptBox[
          StyleBox["a", "TI"], "*"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a^2\\to aa^*", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91c5e820-64a5-4a70-a121-3e590b7965e7"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "*"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox["\[Alpha]", "1"], ")"}], "*"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox["\[Alpha]", "2"], ")"}], "*"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "\[Ellipsis]", "+", 
         
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox["\[Alpha]", 
             StyleBox["n", "TI"]], ")"}], "*"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^*=(\\alpha^1)^*\\e{1}+(\\alpha^2)^*\\e{2}+\\dots+(\\alpha^n)^*\\e{n}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1cf9e06f-d375-47b3-b900-cf9385b43b24"],
 "."
}], "Text",ExpressionUUID->"274cd602-7a1f-4229-b055-e09c9acae70e"],

