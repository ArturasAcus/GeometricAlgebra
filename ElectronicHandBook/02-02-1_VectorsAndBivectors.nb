 StyleBox[" suprantu kaip komutatoriu, aiskintis",
  FontColor->RGBColor[1, 0, 0]],
 "]\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
