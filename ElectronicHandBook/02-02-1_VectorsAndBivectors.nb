               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["a", "TI"]], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"], "+", 
               OverscriptBox[
                StyleBox["a", "TI"], "^"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"]}], 
             RowBox[{"    ", "sin", 
               StyleBox["a", "TI"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["a", "TI"], "^"], "sin", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"]}]}, {"\[Null]", 
             RowBox[{"cos", 
               StyleBox["a", "TI"], "\[LongEqual]", "cos", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"]}], 
             RowBox[{"    ", 
               SuperscriptBox["sin", "2"], 
               StyleBox["a", "TI"], "+", 
               SuperscriptBox["cos", "2"], 
               StyleBox["a", "TI"], "\[LongEqual]", "1"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox["cos", "2"], 
               StyleBox["a", "TI"], "-", 
               SuperscriptBox["sin", "2"], 
               StyleBox["a", "TI"], "\[LongEqual]", "cos", 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]}], ")"}]}], 
             RowBox[{"    ", "2", "sin", 
               StyleBox["a", "TI"], "cos", 
               StyleBox["a", "TI"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["a", "TI"], "^"], "sin", 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]}], ")"}]}]}}, 
           GridBoxAlignment -> {
