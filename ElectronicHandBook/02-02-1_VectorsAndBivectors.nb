 "\t",
 StyleBox["Outer product of two vectors",
  FontSlant->"Italic"],
 ". \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
