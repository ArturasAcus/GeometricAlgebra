Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Relations between trigonometric and hyperbolic functions. ",
  FontSlant->"Italic"],
 "  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", "|", 
         StyleBox["A", "TI"], "|", 
         OverscriptBox[
          StyleBox["A", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}=\\magnitude{\\m{A}}\\hat{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec458720-2fbc-47b7-89f7-b6d7f1f49e18"],
 "  is a general MV, where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["A", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\magnitude{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9430b48-6cc5-48f9-a2fe-c7550eaf5ca1"],
 " is the MV magnitude (aka norm) and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "\[LongEqual]", 
         StyleBox["A", "TI"], "/", "|", 
         StyleBox["A", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{\\m{A}}=\\m{A}/\\magnitude{\\m{A}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b4e4762-abfa-4f1e-b885-36a648f1d6a9"],
 ". ",
 StyleBox["Norm is assumed to be determinant norm in general. ",
  Background->RGBColor[0.87, 0.94, 1]],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{"Function", "  "}], 
             RowBox[{"Case ", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["A", "TI"], "2"], ">", "0"}], "  "}], 
             RowBox[{"Case ", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["A", "TI"], "2"], "<", "0"}]}]}, {"\[Null]", 
             RowBox[{"cos", 
               StyleBox["A", "TI"]}], 
             RowBox[{"\[LongEqual]", "cos", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["A", "TI"]}]}, "Abs"]}], 
             RowBox[{"\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["A", "TI"]}]}, "Abs"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox["cos", "2"], 
               StyleBox["A", "TI"], "-", 
               SuperscriptBox["sin", "2"], 
               StyleBox["A", "TI"], "    "}], 
             RowBox[{"\[LongEqual]", "cos", 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["A", "TI"]}]}, "Abs"]}], ")"}], "    "}], 
             RowBox[{"\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["A", "TI"]}]}, "Abs"]}], ")"}]}]}, {"\[Null]", 
             RowBox[{"2", "sin", 
               StyleBox["A", "TI"], "cos", 
               StyleBox["A", "TI"]}], 
             RowBox[{"\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], "sin", 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["A", "TI"]}]}, "Abs"]}], ")"}]}], 
             RowBox[{"\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], 
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"2", 
                   TemplateBox[{
                    RowBox[{
                    StyleBox["A", "TI"]}]}, "Abs"]}], ")"}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n \\text{Function}\\quad &\\text{Case\\ } \
\\m{A^2>0}\\quad & \\text{Case\\ } \\m{A^2<0} \\\\&\n \\cos \\m{A} &=\\cos {|\
\\m{A}|} & =\\ch {|\\m{A}|} \\\\&\n \\cos^2 \\m{A}-\\sin^2 \\m{A} \\qquad  &=\
\\cos(2{|\\m{A}|} ) \\qquad &=\\ch(2{|\\m{A}|} )\\\\&\n  2\\sin \\m{A}\\cos \
\\m{A}& =\\hat{\\m{A}}\\sin(2{|\\m{A}|} ) &=\\hat{\\m{A}}\\sh(2{|\\m{A}|} ) \n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b0658a2-8697-4746-a176-10f52754611b"],
 "\[LineSeparator]\[LineSeparator]If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", "0  ", "then", "  ", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"\[Null]", 
                 RowBox[{"cos", 
                   StyleBox["A", "TI"], "\[LongEqual]", "1", ",", " and ", 
                   "sin", 
                   StyleBox["A", "TI"], "\[LongEqual]", 
                   StyleBox["A", "TI"], ",    "}]}, {"\[Null]", 
                 RowBox[{
                   StyleBox["ch", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"], "\[LongEqual]", "1", ",  ", "and ", 
                   " ", 
                   StyleBox["sh", FontSlant -> "Plain"], 
                   StyleBox["A", "TI"], "\[LongEqual]", 
                   StyleBox["A", "TI"], "."}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[2.7998999999916003`*^11], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\m{A}^2=0\\quad \\text{then}\\quad \n\\begin{cases}\n\
&\\cos\\m{A}=1,\\text{\\ and\\ }\\sin\\m{A}=\\m{A},\\qquad\\\\\n\
&\\ch\\m{A}=1,\\quad\\text{and\\ } \\ \\sh\\m{A}=\\m{A}.\n \\end{cases}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50ffb499-8d51-4b25-9414-df76395c680c"]
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"1998d07e-7ebf-4816-b22a-126aa2e4b4ff"],

