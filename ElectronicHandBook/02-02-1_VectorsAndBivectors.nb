       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"], "+", 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"], "\[LongEqual]", "2", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               StyleBox["b", "TI"]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"], "-", 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"], "\[LongEqual]", "2", 
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"]}], ")"}], "2"], "-", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["b", "TI"], 
                    StyleBox["a", "TI"]}], ")"}], "2"], "\[LongEqual]", "4", 
               RowBox[{"(", 
