Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"a", "[", "k", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"b", "[", "k", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], "}"}]}], "]"}]}], "}"}], 
       "]"}], "\[GeometricProduct]", 
      RowBox[{
       RowBox[{"\[DoubleStruckE]", "[", "i", "]"}], "\[OuterProduct]", 
       RowBox[{"\[DoubleStruckE]", "[", "j", "]"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", 
       RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "i", ",", 
       RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
