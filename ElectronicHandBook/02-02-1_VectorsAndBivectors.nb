Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Hyperbolic functions of scalar-plus-MV argument",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4b8a84a-f083-4543-a07e-34c027bb0fd8"],
 " is the scalar. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43ee0271-0b78-432b-83ea-6f5edfd0ec60"],
 " is the MV.",
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["sh", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"\[Lambda]", "\[PlusMinus]", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["sh", FontSlant -> "Plain"], "\[Lambda]", 
               StyleBox["ch", FontSlant -> "Plain"], "|", 
               StyleBox["A", "TI"], "|", "\[PlusMinus]", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], 
               StyleBox["ch", FontSlant -> "Plain"], "\[Lambda]", 
               StyleBox["sh", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["A", "TI"]}]}, "Abs"]}], 
             RowBox[{"  ", "if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], ">", "0", ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"\[Lambda]", "\[PlusMinus]", 
                   StyleBox["A", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], "\[Lambda]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["A", "TI"]}]}, "Abs"], "\[PlusMinus]", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], 
               StyleBox["sh", FontSlant -> "Plain"], "\[Lambda]", 
               StyleBox["sh", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["A", "TI"]}]}, "Abs"]}], 
             RowBox[{"  ", "if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], ">", "0", ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["th", FontSlant -> "Plain"], 
               RowBox[{"(", 
                 RowBox[{"\[Lambda]", "\[PlusMinus]", 
