   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Det", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
