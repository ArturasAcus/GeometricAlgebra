Cell[TextData[{
 " ",
 StyleBox["Exponential of bivector in ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8545342f-2ea9-4eda-9912-97e72653b8a4"],
 ". In coordinate form the bivector is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "12"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "13"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "13"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "23"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "23"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\cA=a_{12}\\e{12}+a_{13}\\e{13}+a_{23}\\e{23}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7adfcb2c-92ae-4106-a65b-df9217af4786"],
 ". Its magnitude is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["A", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SubsuperscriptBox[
             StyleBox["a", "TI"], "12", "2"], "+", 
            SubsuperscriptBox[
             StyleBox["a", "TI"], "31", "2"], "+", 
            SubsuperscriptBox[
             StyleBox["a", "TI"], "23", "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\magnitude{A}=\\sqrt{a_{12}^2+a_{31}^2+a_{23}^2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3dd2548c-20f0-4b72-b827-5ed66d03cb24"],
 ". The expanded exponential in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8833e726-1120-4590-b730-215e0738321b"],
 ", i.e., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["A", "TI"]], "\[LongEqual]", "cos", "|", 
         StyleBox["A", "TI"], "|", "+", 
         FractionBox[
          StyleBox["A", "TI"], 
          TemplateBox[{
            RowBox[{
              StyleBox["A", "TI"]}]}, "Abs"]], "sin", "|", 
         StyleBox["A", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\ee^{\\cA}=\\cos|\\cA|+\\frac{\\cA}{|\\cA|}\\sin|\\cA|", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c95a83f7-71d3-4d16-bba4-9a77302f54b5"],
 ". Also, from the last two expressions in the above Table,one finds,\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", "\[Null]", 
             RowBox[{
               StyleBox["sh", FontSlant -> "Plain"], 
               StyleBox["A", "TI"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["A", "TI"]], "-", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    RowBox[{"-", 
                    StyleBox["A", "TI"]}]]}], ")"}], "\[LongEqual]", 
               FractionBox[
                StyleBox["A", "TI"], 
                TemplateBox[{
                  RowBox[{
                    StyleBox["A", "TI"]}]}, "Abs"]], "sin", "|", 
               StyleBox["A", "TI"], "|", ","}]}, {"\[Null]", "\[Null]", 
             RowBox[{
               StyleBox["ch", FontSlant -> "Plain"], 
               StyleBox["A", "TI"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["A", "TI"]], "+", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    RowBox[{"-", 
                    StyleBox["A", "TI"]}]]}], ")"}], "\[LongEqual]", "cos", 
               "|", 
               StyleBox["A", "TI"], "|."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}&\n \
&\\sh\\m{A}=\\frac12(\\ee^{\\m{A}}-\\ee^{-\\m{A}})=\\frac{\\m{A}}{|\\m{A}|}\\\
sin|\\m{A}|,\\\\&\n\
&\\ch\\m{A}=\\frac12(\\ee^{\\m{A}}+\\ee^{-\\m{A}})=\\cos|\\m{A}|.\n\
\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "640a5a70-f965-4c24-883b-fd6b2cf25c5a"]
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.911279297829646*^9, 3.911279324844771*^9}, {
  3.911279501724227*^9, 3.911279584253166*^9}, {3.911279637179107*^9, 
  3.9112796467047663`*^9}},ExpressionUUID->"c2e8efc1-ac6d-4b39-9cc5-\
b052dbda3fbc"],

