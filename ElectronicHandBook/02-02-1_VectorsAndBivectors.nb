 CounterBox["Item"],
 "\t",
 StyleBox["Products of four vectors",
  FontSlant->"Italic"],
 ". [ ",
 StyleBox["ketvirta nuo virsaus neteisinga, jei ",
  FontColor->RGBColor[1, 0, 0]],
