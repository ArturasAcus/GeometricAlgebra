Cell["Or you can do the trick below", "Text",ExpressionUUID->"bd6cff4b-a199-42d1-b31e-0ef6413b000e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"formalExpansion", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Series", "[", 
      RowBox[{
       RowBox[{"Log", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1", ",", "6"}], "}"}]}], "]"}], "//", "Normal"}], 
    ")"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "1"}], ")"}], "^", "n_."}], "\[RuleDelayed]", 
      RowBox[{"GeometricProduct", "@@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "+", 
          RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "-", "1"}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}]}]}], ",", 
     RowBox[{"x", "\[Rule]", 
      RowBox[{
       RowBox[{"\[DoubleStruckE]", "[", "1", "]"}], "+", 
       RowBox[{"\[DoubleStruckE]", "[", "2", "]"}]}]}]}], "}"}]}]}]], "Input",\

 CellLabel->
  "In[915]:=",ExpressionUUID->"4057995e-20fc-4bd0-83d4-f6dc2f4e7126"],

