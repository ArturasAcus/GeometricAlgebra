Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"testAlgebra", "=", 
     RowBox[{"Cl", "[", 
      RowBox[{"i", ",", 
       RowBox[{"4", "-", "i"}]}], "]"}]}], ";", 
    RowBox[{"testAlgebraBase", "=", 
     RowBox[{"gaDefineOrthonormalBasis", "[", "testAlgebra", "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
       "a1", "\[OuterProduct]", "b1", "\[OuterProduct]", "c1", 
        "\[OuterProduct]", "d1"}], ")"}], "//", "gaPE"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
     RowBox[{
      RowBox[{"gaGetMV", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
         "a1", "\[GeometricProduct]", "b1", "\[GeometricProduct]", "c1", 
          "\[GeometricProduct]", "d1"}], ")"}], ",", 
        RowBox[{"{", "4", "}"}]}], "]"}], "//", "gaPE"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"lhs", "[", "testAlgebra", "]"}], "-", 
       RowBox[{"rhs", "[", "testAlgebra", "]"}]}], ")"}], "//", "Expand"}]}], 
   "\[IndentingNewLine]", ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "0", ",", "4"}], "}"}]}], "]"}]], "Input",
 CellLabel->
