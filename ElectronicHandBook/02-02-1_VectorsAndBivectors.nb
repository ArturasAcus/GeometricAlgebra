Cell[TextData[{
 "We can also use different internal representation of multivector, named ",
 StyleBox["\[OpenCurlyDoubleQuote]AccociationRepresentation\
\[CloseCurlyDoubleQuote]",
  FontWeight->"Bold"],
 " (it uses ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " Associations). Note that, using  ",
 StyleBox["\[OpenCurlyDoubleQuote]AccociationRepresentation\
\[CloseCurlyDoubleQuote]",
  FontWeight->"Bold"],
 " we get the same result (see LeafCount) using ",
 StyleBox["CoefficientFunction\[Rule]Identity",
  FontWeight->"Bold"],
 " (that is faster, even with bidirectional conversion procedure)."
}], "Text",
 CellChangeTimes->{
  3.950161587446628*^9, {3.950161652717379*^9, 
   3.950161654766697*^9}},ExpressionUUID->"b2df3f00-4b58-4c04-8004-\
9caad5ea6be5"],

