Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[ScriptCapitalA]", "\[Cross]", "\[ScriptCapitalB]"}], "=", 
   RowBox[{
    RowBox[{"<", 
     RowBox[{"\[ScriptCapitalA]", "\[Cross]", "\[ScriptCapitalB]"}], 
     SubscriptBox[">", "2"]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "\[ScriptCapitalA]", "\[GeometricProduct]", "\[ScriptCapitalB]"}], "-", 
       RowBox[{
       "\[ScriptCapitalB]", "\[GeometricProduct]", "\[ScriptCapitalA]"}]}], 
      ")"}], "/", "2"}]}]}], 
  TraditionalForm]],ExpressionUUID->"a4343feb-fa01-4081-91a3-07a7a23ef267"]], \
"SubsubitemParagraph",
 FontFamily->
  "Microsoft Sans \
Serif",ExpressionUUID->"a3552eb3-e025-4aeb-a0cb-6b397754f2d3"],

Cell[TextData[{
 "Note that the cross  means the GA commutator:  \[ScriptCapitalA]\[Cross]\
\[ScriptCapitalB] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    FractionBox["1", "2"]}], TraditionalForm]],ExpressionUUID->
  "108dc9f8-7fa6-4c28-8fec-b361c5bbed19"],
 "[\[ScriptCapitalA],\[ScriptCapitalB]]"
}], "Text",ExpressionUUID->"51a32026-6f30-4cc5-92e0-19e6480d8196"],

Cell[TextData[{
 "LHS. \n",
 StyleBox["gaCommutator[ A,B]",
  FontWeight->"Bold"],
 " is a command  reserved for a general commutator [A,B] of two, in general,  \
non commuting quantities. A and B must  have the heads, either of orthonormal \
 basis symbol   \[DoubleStruckE][ ], or of a general multivector in the form ",
 StyleBox["MV",
  FontWeight->"Bold"],
 ". The head ",
 StyleBox["MV",
  FontWeight->"Bold"],
 " is not evaluated, except that it may become zero for some specific heads, \
in particular when it represents the basis symbol, For example,"
