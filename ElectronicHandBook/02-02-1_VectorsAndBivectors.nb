Cell[TextData[{
 "In the second case the head ",
 StyleBox["MV",
  FontWeight->"Bold"],
 " remains  reserved for a general multivector and is a noncommutative \
quantity. ",
 StyleBox["gaCommutator[ ]",
  FontWeight->"Bold"],
 " can be expanded with ",
 StyleBox["gaCommutatorExpand[1][expr]",
  FontWeight->"Bold"],
 ", alias of which is",
 StyleBox[" gaCE[1][ ]",
  FontWeight->"Bold"],
 ". The coefficient 1 here means external scalar multiplier, in this case 1. \
For example, "
}], "Text",
