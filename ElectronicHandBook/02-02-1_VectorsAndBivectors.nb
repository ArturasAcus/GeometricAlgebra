Cell["Definitions and shortcuts", "Subsection",ExpressionUUID->"97e6b73f-0944-47b5-b4a2-02c55d8b648f"],

Cell["\<\
Realization of  determinant formula given in A. Macdonald,  \
\[CloseCurlyDoubleQuote]Linear and Geometric Algebra\[CloseCurlyDoubleQuote] \
p.157, which utilizes inner product (note reciprocal basis vectors)\
\>", "Text",ExpressionUUID->"0227fde2-767b-4a1f-8cc8-a08459d2d8bc"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", "\[Wedge]", "b"}], "..."}], "\[Wedge]", "z"}], "=", 
   RowBox[{"det", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {"...", "...", "...", "..."},
       {
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]}
      }], "\[NoBreak]", ")"}], " ", 
    StyleBox["I",
     FontWeight->"Bold",
     FontSlant->"Italic"]}]}]}]], "DisplayFormula",
 CellChangeTimes->{
  3.6831281237374787`*^9, {3.683128197472729*^9, 3.6831282928623524`*^9}, {
   3.683128375041707*^9, 3.68312878642068*^9}, {3.683129179353694*^9, 
   3.6831291849564533`*^9}, {3.68334938318907*^9, 
   3.683349434863529*^9}},ExpressionUUID->"6bebace5-69d9-40c8-b60f-\
bbc1ac1a1cd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"outerProductViaDeterminant", "[", "vecOutProd_OuterProduct", "]"}],
   ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"theAlgebra", "=", 
        RowBox[{"First", "[", 
         RowBox[{"Cases", "[", 
          RowBox[{
           RowBox[{"First", "[", "vecOutProd", "]"}], ",", "_Cl", ",", 
           "Infinity"}], "]"}], "]"}]}], ",", "theBase", ",", "theVectors", 
       ",", "thePseudoscalar", ",", 
       RowBox[{"vecOutProdList", "=", 
        RowBox[{"List", "@@", 
         RowBox[{"(", "vecOutProd", ")"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"theBase", "=", 
       RowBox[{"gaDefineOrthonormalBasis", "[", "theAlgebra", "]"}]}], ";", 
      RowBox[{"theVectors", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"gaIndexUp", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"gaGetMV", "[", 
             RowBox[{"theBase", ",", 
              RowBox[{"{", "1", "}"}]}], "]"}], ",", "0"}], "]"}], "]"}], 
         ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], "\[Rule]", "1"}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"thePseudoscalar", "=", 
       RowBox[{"Last", "[", "theBase", "]"}]}], ";", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gaPE", "[", 
            RowBox[{"InnerProduct", "[", "##", "]"}], "]"}], "&"}], ",", 
          "vecOutProdList", ",", "theVectors"}], "]"}], "]"}], "*", 
       "thePseudoscalar"}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"gaGradeList", "/@", 
       RowBox[{"(", 
        RowBox[{"List", "@@", "vecOutProd"}], ")"}]}], "]"}], "===", 
     RowBox[{"{", 
      RowBox[{"{", "1", "}"}], "}"}]}], "&&", 
    RowBox[{
     RowBox[{"Length", "[", "vecOutProd", "]"}], "===", 
     RowBox[{"(", 
      RowBox[{"Plus", "@@", 
       RowBox[{"First", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"vecOutProd", ",", 
          RowBox[{"Cl", "[", 
           RowBox[{"p_", ",", "q_", ",", "___"}], "]"}], ",", "Infinity"}], 
         "]"}], "]"}]}], ")"}]}]}]}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"a49ed0fb-82c5-4794-8e00-8f18ae6bf30e"],

