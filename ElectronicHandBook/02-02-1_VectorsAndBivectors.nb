               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n\\sin(- a)=-\\sin a&\\qquad \\cos(-a)=\\cos a\\\\&\n\
\\ee^{a}=\\ch{|a|}+\\hat{a}\\,\\sh{|a|} &\\qquad\\sin \
a=\\hat{a}\\sin{|a|}\\\\&\n\\cos a=\\cos{|a|} &\\qquad \
\\sin^2a+\\cos^2a=1\\\\&\n\\cos^2a-\\sin^2a=\\cos(2{|a|}) &\\qquad 2\\sin \
a\\cos a=\\hat{a}\\sin(2{|a|})\\\\\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
