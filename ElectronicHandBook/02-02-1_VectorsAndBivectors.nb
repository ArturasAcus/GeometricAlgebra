Cell[TextData[{
 "RHS, we need a theta angle, which we obtain from area formula, see next \
relation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         RowBox[{
           StyleBox["a", "TI"], "\[Wedge]", 
           StyleBox["b", "TI"]}], "|", "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"], 
         TemplateBox[{
           RowBox[{
             StyleBox["b", "TI"]}]}, "Abs"], 
         StyleBox["abs", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{"sin", "\[Theta]"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\magnitude{a\\w b}={|a|}{|b|}\\mathrm{abs}(\\sin\\theta)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c94395a9-6a0b-478e-aaf5-ef5f3cbd62db"],
 " "
}], "Text",ExpressionUUID->"b03cc6a4-ad61-4693-9766-9f6db7e6c902"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"theArea", "=", 
  RowBox[{"gaNormReverseAbs", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a1", "\[OuterProduct]", "b1"}], ")"}], "/.", 
    "coefficientRules"}], "]"}]}]], "Input",
 CellLabel->
  "In[336]:=",ExpressionUUID->"73f5e459-0aaf-413d-a74c-aa22ef6095e6"],

Cell[BoxData[
 RowBox[{"5", " ", 
  SqrtBox["5453"]}]], "Output",
 CellChangeTimes->{3.950161763458297*^9},
 CellLabel->
  "Out[336]=",ExpressionUUID->"3024e1a8-e9c2-4261-bece-bc2eac10ec19"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"sinTheta", "=", 
  RowBox[{"gaPE", "[", 
   RowBox[{
    RowBox[{"theArea", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"gaNormReverseAbs", "[", "a1", "]"}], "*", 
       RowBox[{"gaNormReverseAbs", "[", "b1", "]"}]}], ")"}]}], "/.", 
    "coefficientRules"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"theTheta", "=", 
   RowBox[{"ArcSin", "[", "sinTheta", "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[337]:=",ExpressionUUID->"f5b5e135-5759-4853-862b-3a1a0fb8697d"],

