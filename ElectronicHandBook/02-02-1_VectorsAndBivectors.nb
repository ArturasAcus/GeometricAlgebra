Cell[CellGroupData[{

Cell[TextData[{
 "Examples of norms applied to bivector. For non blades the neither  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["B", "TI"], "~"], 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\reverse{\\cB}\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9eb8a3a2-b335-42c3-b7a6-215ae43648e0"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cliffordconjugate{\\cB}\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68141c98-9c85-444c-8cdd-007e1067ae63"],
 " produce a scalar, therefore we have to project a scalar part  as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftAngleBracket]", 
         RowBox[{
           OverscriptBox[
            StyleBox["B", "TI"], "~"], 
           StyleBox["B", "TI"]}], "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\langle\\reverse{\\cB}\\cB\\rangle", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ecef6468-d7ea-4329-ab7e-907fbc4ec755"],
 ". Then a norm becomes useless for most of operations. The only useful norm \
for non bladed is a determinant norm"
}], "SubsubitemParagraph",ExpressionUUID->"03c41ce3-08de-48d7-bb4e-\
079d49656664"],

