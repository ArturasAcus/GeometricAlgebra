"SubsubitemParagraph",ExpressionUUID->"e3a8db6b-f1d5-4651-964b-ee0b21cecd41"],

Cell[TextData[{
 "Since all listed properties already ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"were", " ", "checked"}],
    BaseStyle->"Hyperlink",
    ButtonData->{
      FrontEnd`FileName[{$RootDirectory, "home", "acus", "git", "acus", "GA", 
        "ElectronicHandBook"}, 
       "02-01-1_BasicDefinitionsInGeometricAlgebra.nb", CharacterEncoding -> 
       "UTF-8"], "HestenesProduct"}], TraditionalForm]],ExpressionUUID->
  "292093a2-dc37-436a-a934-c75c952d4a2b"],
 ", we only remind that inner products (Hestenes inner product \
\[InnerProduct], left contract \[LeftContract] and right contract \
\[RightContract]) have highest priority, then comes outer product \
\[OuterProduct] and last is geometric product \[GeometricProduct]"
}], "Text",ExpressionUUID->"bcf30d93-962f-43a3-a55c-64decd2ed7be"],

