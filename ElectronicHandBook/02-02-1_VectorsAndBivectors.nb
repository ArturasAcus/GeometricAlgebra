Cell[TextData[{
 "Collinear isotropic vectors, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "84f15eed-2446-4bf8-9c07-7b87fbff9785"],
 " ,  can be compared using ",
 StyleBox["gaNormOfCoefficients[ ]",
  FontWeight->"Bold"],
 " norm, since other norms gives zero"
}], "SubsubitemParagraph",ExpressionUUID->"f4986c47-3869-41a0-a9c3-\
65242217817c"],

