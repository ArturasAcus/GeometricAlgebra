 RowBox[{
  RowBox[{"generateRandomCoefficientSet", "[", 
   RowBox[{"theAlg_", ",", "coeffRange_List"}], "]"}], ":=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"a", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"gaComponentCoefficientList", "[", 
       RowBox[{
        RowBox[{"gaGeneralMultivector", "[", 
         RowBox[{"b", ",", "theAlg", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"theAlg", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}]}], "]"}]}], "]"}], "->", 
    RowBox[{"RandomInteger", "[", 
     RowBox[{"coeffRange", ",", 
      RowBox[{"2", "*", 
       RowBox[{"gaDimensionOfVectorSpace", "[", "theAlg", "]"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
