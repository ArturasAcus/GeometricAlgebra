                    Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], 
                    StyleBox["j", "TI"]], "InlineFormula"], " "}]]}}], 
                    TraditionalForm]]], "]"}], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[Wedge]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]]}], 
             "in a coordinate form as sum of determinants multiplied by \
elementary bivectors"}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"]}], 
             RowBox[{"if vectors are perpendicular", ",  ", 
               StyleBox["a", "TI"], "\[Perpendicular]", 
