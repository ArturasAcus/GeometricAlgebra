Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Exp", "[", "\[ScriptCapitalA]", "]"}], ")"}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"|", "\[ScriptCapitalA]", "|"}], "]"}], "+", 
      RowBox[{
       OverscriptBox["\[ScriptCapitalA]", "^"], 
       RowBox[{"Sinh", "[", 
        RowBox[{"|", "\[ScriptCapitalA]", "|"}], "]"}], " ", "if", " ", 
       SuperscriptBox["\[ScriptCapitalA]", "2"]}]}], ">", "0"}]}], ",", " ", 
   RowBox[{"for", " ", 
    SuperscriptBox["\[ScriptCapitalA]", "2"], "being", " ", "scalar", " "}]}],
   TraditionalForm]], \
"SubitemParagraph",ExpressionUUID->"38d4b619-187e-4d8b-8a7e-3d738f7611f6"]], \
"SubitemParagraph",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.921646542399276*^9, 3.92164654297752*^9}, {
  3.921646843993033*^9, 3.921646858598572*^9}, {3.921647872946781*^9, 
  3.921647912405995*^9}},ExpressionUUID->"6ce82dcb-f868-4d8d-96df-\
9b2596682427"],

Cell["\<\
Will use not series, but general formula for diagonalizable MV. A norm here \
is understood as a determinant norm (see below), i.e.  determinant of MV in \
some fractional power.\
\>", "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"59af06c8-b61f-425c-b7b9-32b686b9ceba"],

Cell["LHS", "Text",
