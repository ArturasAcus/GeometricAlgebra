Cell["\<\
 Numerical values of coefficients at vectors of the assumed algebra\
\>", "Text",
 CellChangeTimes->{{3.683180401095892*^9, 
  3.683180472035495*^9}},ExpressionUUID->"30c3dfd7-1d36-4f6b-962b-\
361599b37548"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numericalCoeffsVec", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", "1", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "2", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "3", "]"}], "\[Rule]", "2"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "4", "]"}], "\[Rule]", "3"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "5", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"a", "[", "6", "]"}], "\[Rule]", 
      RowBox[{"-", "8"}]}], ",", 
     RowBox[{
      RowBox[{"a", "[", "7", "]"}], "\[Rule]", "4"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "1", "]"}], "\[Rule]", "2"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "2", "]"}], "\[Rule]", "5"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "3", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "4", "]"}], "\[Rule]", "1"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "5", "]"}], "\[Rule]", "0"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "6", "]"}], "\[Rule]", "3"}], ",", 
     RowBox[{
      RowBox[{"b", "[", "7", "]"}], "\[Rule]", "5"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{3.683180487638988*^9},
 CellLabel->
  "In[714]:=",ExpressionUUID->"ab7f54c4-4305-4d85-9acc-d6521b59d8a5"],

