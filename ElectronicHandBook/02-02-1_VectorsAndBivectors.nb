Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["The magnitude of a vector.",
  FontSlant->"Italic"],
 " The magnitude (GA literature lacks consensus here: various definitions of \
norm are given in ",
 StyleBox["unit \\ref{norm}",
  FontColor->RGBColor[1, 0, 0]],
 "). The magnitude usually is associated with the hypervolume of a blade \
(length of vector, area of bivector etc.), while the norm is a used in a more \
general sense. It is related with the \[OpenCurlyDoubleQuote]normalization\
\[CloseCurlyDoubleQuote] of a GA object, e.g., of a spinor or isotropic \
vector the magnitude of\nwhich is zero. In the Handbook the symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{".."}]}, "Abs"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\magnitude{..}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46f022d7-914f-48df-9e52-4d0c08262462"],
 " denotes the  magnitude. The absolute value is denoted by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["abs", FontSlant -> "Plain"], "(", "..", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\mathrm{abs}(..)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4660f24-738c-458f-bf22-946438c8aff2"],
 ". function, while the symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["||..||", TraditionalForm], "errors" -> {}, "input" -> 
     "||..||", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb6a6faf-5627-4668-a553-539b10c715e7"],
 " is reserved for more general norm of the vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox["\[Alpha]", "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "\[Ellipsis]", "+", 
         
         SuperscriptBox["\[Alpha]", 
          StyleBox["n", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a=\\alpha^1\\e{1}+\\alpha^2\\e{2}+\\dots+\\alpha^n\\e{n}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "521b6672-81b3-40c1-8f19-a9b34e9ac453"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", 
          StyleBox["i", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^i\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eab66e78-7d9a-460e-87d7-ab0c5188b5f0"],
 "\[DoubleStruckCapitalR], is denoted |a|. It is a positive definite \
scalar,",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[GreaterEqual]", "0"}], TraditionalForm],
      "errors" -> {}, "input" -> " |a|\\ge 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af85e8d9-8cf4-4704-88b9-c6d0a79d737a"],
 ", and is directly related with a square of vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox["\[Epsilon]", 
          StyleBox["a", "TI"]], "|", 
         StyleBox["a", "TI"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "a^2=\\epsilon_a |a|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ad6bd61-b2ed-4dd6-a124-c7a5bfff9e34"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Epsilon]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\epsilon", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50e8149e-1761-470b-9113-a2103629a43c"],
 " is called the signature of vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0201a8fd-87a9-4b85-bf16-8ee5322ea4de"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", 
          StyleBox["a", "TI"]], "\[LongEqual]", "1", 
         StyleBox["i", "TI"], 
         StyleBox["f", "TI"], 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], ">", "0", ";", "\[Epsilon]", 
         "\[LongEqual]", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\epsilon_a=1 if a^2>0; \\epsilon=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95bbbd1f-d155-42f6-96e3-bff0dff2f763"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "619d1d0f-aaef-4ffb-966d-79f813a864e0"],
 "; and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Epsilon]", "\[LongEqual]", "-1", 
         StyleBox["i", "TI"], 
         StyleBox["f", "TI"], 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "<", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\epsilon=-1 if a^2<0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a68b9f3-59eb-4937-94a1-e99b7bae4834"],
 ". The magnitude of zero vector, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc79f430-30e4-4fde-be3b-6ba44b38cb1e"],
 ", is zero ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "|a|=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fcafd81-776a-4e7d-9a17-5ee286a4e007"],
 ". However, when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\ne 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e423caa-b38f-4a96-812e-c9bf48535a12"],
 " but ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "|a|=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "421b5c22-e002-489e-8638-00d433730ecb"],
 ", then a is said to be isotropic vector (aka null vector).  Isotropic \
vector has zero magnitude ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\magnitude{a}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b07ea44-2694-4e1f-b90c-e888a6ada017"],
 ", therefore, cannot be normalized. However, the \[OpenCurlyDoubleQuote]size\
\[CloseCurlyDoubleQuote] of two  isotropic vectors pointing to the same \
direction may be compared by norm ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"||", 
         StyleBox["a", "TI"], "||", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox["\[Alpha]", "1"], ")"}], "2"], "+", 
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox["\[Alpha]", "2"], ")"}], "2"], "+", 
            "\[CenterEllipsis]", "+", 
            SuperscriptBox[
             RowBox[{"(", 
               SuperscriptBox["\[Alpha]", 
                StyleBox["n", "TI"]], ")"}], "2"]}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "||a||=\\sqrt{(\\alpha^1)^2+(\\alpha^2)^2+\\cdots +(\\alpha^n)^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92cd0b1d-1708-4a2c-853d-fe9865260b87"],
 ".  Magnitude of a vector in special cases:"
}], "Item",ExpressionUUID->"31830c24-0a69-4e4e-bc95-b1b5ed040062"],

Cell[TextData[{
 "  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{"abs", "(", 
            RowBox[{
              StyleBox["a", "TI"], "\[CenterDot]", 
              StyleBox["a", "TI"]}], ")"}]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{"abs", "(", 
            SuperscriptBox[
             StyleBox["a", "TI"], "2"], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "|a| =\\sqrt{\\textrm{abs}{(a\\d a)}}=\\sqrt{\\textrm{abs}{(a^2)}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96e75472-5d9a-464d-b211-ce326aff4d5e"],
 "\t\tgeneral vector, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"], ",  ", 
         StyleBox["abs", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["a", "TI"]}], ")"}], "\[GreaterEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "n=p+q,\\quad \\mathrm{abs}{(a\\d a)}\\ge 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b03cf161-7497-47ce-9351-438d458ab884"],
 "  "
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"f793821e-f103-4a5f-9a3b-a328e2fb8aae"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "+", 
         StyleBox["b", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            StyleBox["abs", FontSlant -> "Plain"], "(", 
            RowBox[{"(", 
              RowBox[{
                SuperscriptBox[
                 StyleBox["a", "TI"], "2"], "+", 
                SuperscriptBox[
                 StyleBox["b", "TI"], "2"], "+", "2", 
                StyleBox["a", "TI"], "\[CenterDot]", 
                StyleBox["b", "TI"]}], ")"}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "|a+b|=\\sqrt{\\mathrm{abs}((a^2+b^2+2a\\d b))}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "878464d0-6ddc-48fc-b853-033b5db5c734"],
 "\tsum of vectors"
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"6630d2d5-027b-4fed-961e-3bacff1eea3f"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            OverscriptBox[
             StyleBox["a", "TI"], "~"], 
            StyleBox["a", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["a", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          SuperscriptBox[
           StyleBox["a", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "|a|=\\sqrt{\\reverse{a} a}=\\sqrt{a a}=\\sqrt{a^2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2bf59c6d-ea7d-4239-afc9-b2cfc9da5027"],
 "\t\tvector in Euclidean ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{p}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d928fa6c-82ae-4fc4-bb59-4e0b471b9107"],
 " algebra"
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"0714d2b7-29f6-4194-a85a-140b56a02502"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{"-", 
            OverscriptBox[
             StyleBox["a", "TI"], "~"], 
            StyleBox["a", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{"-", 
            StyleBox["a", "TI"], 
            StyleBox["a", "TI"]}]], "\[LongEqual]", 
         SqrtBox[
          RowBox[{"-", 
            SuperscriptBox[
             StyleBox["a", "TI"], "2"]}]]}], TraditionalForm], "errors" -> {},
      "input" -> "|a|=\\sqrt{-\\reverse{a} a}=\\sqrt{-a a}=\\sqrt{-a^2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab28c945-8115-4919-b333-43622be62b0e"],
 "\tvector in anti-Euclidean ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9dd7d804-1d98-4ac9-b1f4-02e5225653f1"],
 " algebra"
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"655d7c09-0eea-4bdd-881f-cb422255881b"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{
            StyleBox["abs", FontSlant -> "Plain"], "(", 
            RowBox[{
              SuperscriptBox[
               StyleBox["x", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["y", "TI"], "2"], "+", 
              SuperscriptBox[
               StyleBox["z", "TI"], "2"], "-", 
              SuperscriptBox[
               StyleBox["t", "TI"], "2"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "|a|=\\sqrt{\\mathrm{abs}(x^2+y^2+z^2-t^2)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe215627-664e-4761-8665-d9f77ef46931"],
 "\t\tspacetime  vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["x", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         StyleBox["y", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         StyleBox["z", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "+", 
         StyleBox["t", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a=x\\e{1}+y\\e{2}+z\\e{3}+t\\e{4}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95fc15df-c0d9-4b64-85e4-9abe77ee272a"],
 ",   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb1cd058-1791-450d-b4fa-4253c6db2d0e"],
 " algebra"
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"895b3fce-ae60-4776-88cb-e71a96679212"],

Cell[TextData[{
 "\nTo avoid confusion here ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["abs", FontSlant -> "Plain"], "(", "\[Alpha]", ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\mathrm{abs}(\\alpha)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af786d47-99f3-4a0b-b9c9-418249066a8f"],
 " explicitly denotes an absolute value function. The notation will be used \
when the meaning of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{".."}]}, "Abs"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\abs{..}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bcc75602-c704-45db-af57-2e1adb5771cc"],
 " will not be clear from the context."
}], "Text",ExpressionUUID->"5a55fd6e-c991-4256-b99a-84961cbe6f8f"],

