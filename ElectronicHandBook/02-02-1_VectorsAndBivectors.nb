Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"tan", 
         RowBox[{"(", 
           RowBox[{"\[Alpha]", "\[PlusMinus]", "\[Beta]", 
             OverscriptBox[
              StyleBox["B", "TI"], "^"]}], ")"}], "\[LongEqual]", 
         FractionBox[
          RowBox[{"sin", "2", "\[Alpha]", "\[PlusMinus]", 
            OverscriptBox[
             StyleBox["B", "TI"], "^"], 
            StyleBox["sh", FontSlant -> "Plain"], "2", "\[Beta]"}], 
          RowBox[{"cos", "2", "\[Alpha]", "+", 
            StyleBox["ch", FontSlant -> "Plain"], "2", "\[Beta]"}]], "  ", 
         "if ", 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["B", "TI"], "^"], "2"], "\[LongEqual]", "-1", ","}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\tan(\\alpha\\pm \\beta\\hat{\\cB})=\\frac{\\sin \
2\\alpha\\pm\\hat{\\cB}\\sh 2\\beta}{\\cos 2\\alpha+\\ch 2\\beta}\\quad \
