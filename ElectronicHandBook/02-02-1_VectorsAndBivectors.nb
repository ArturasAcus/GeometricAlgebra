Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["MV with property ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", "\[PlusMinus]", "|", 
         StyleBox["A", "TI"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}^2=\\pm|\\m{A}|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5cd3c9d1-4a2d-420d-a297-8a47155c5fb4"],
 StyleBox[". ",
  FontSlant->"Italic"],
 " Such a MV can be represented as a product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "|", 
         StyleBox["A", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}=\\hat{\\m{A}}|\\m{A}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c5d6e6f3-d607-4089-ac9f-ffd5da17e4f7"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["A", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1b6ebc6-f52c-47cc-85ac-e99d01e1bb53"],
 " is a unit MV (i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "^"], "2"], "\[LongEqual]", "\[PlusMinus]", 
         "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{\\m{A}}^2=\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fd8ed67-b464-4ccb-a9a2-1d066963e475"],
 ") and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["A", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "|\\m{A}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "51f7529b-68b2-405d-a673-bc2c265e8e02"],
 " is the determinant of MV (",
 StyleBox["unit~\\ref{Det}",
  FontColor->RGBColor[1, 0, 0]],
 "). If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a2ab3d7-1db2-4a1a-9f41-43fe196a0925"],
 " is a vector, bivector, k-blade or versor, then instead of the determinant \
a simpler formula without zero grade selector may be used, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["A", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["A", "TI"], 
              OverscriptBox[
               StyleBox["A", "TI"], "~"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "|\\m{A}|=\\sqrt{\\abstrue( \\m{A}\\reverse{\\m{A}})}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac559875-f05c-4699-b679-f966806c8fa2"],
 ", since in this case the product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         OverscriptBox[
          StyleBox["A", "TI"], "~"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}\\reverse{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13bc320b-f878-4f23-9978-6534b058a121"],
 " already yields a scalar.\n\nThe square of MV, in general, is a MV. \
However, there exist MVs the square of which gives the scalar,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", "\[PlusMinus]", "|", 
         StyleBox["A", "TI"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}^2=\\pm|\\m{A}|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "391b799e-ff96-4af8-96a5-956630d92e71"],
 " . The MV norm ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["A", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "|\\m{A}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "608c4289-5f93-4c2e-8af7-4fa77bb17578"],
 " in this case is the determinant norm defined in ",
 StyleBox["unit~\\ref{Detnorm}",
  FontColor->RGBColor[1, 0, 0]],
 ". It is defined as the absolute value of a determinant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["D", "TI"], TraditionalForm], "errors" -> {}, "input" -> "D", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b989777-b3e3-481d-a10e-779e95f22f90"],
 " of MV raised to the power ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         RowBox[{"(", 
           SuperscriptBox["2", 
            StyleBox["k", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/(2^k)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "918ba3f7-d2d8-4e9f-8c9f-05e0a5ff0322"],
 ", i.e., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RadicalBox[
        RowBox[{
          StyleBox["abs", FontSlant -> "Plain"], "(", 
          StyleBox["D", "TI"], ")"}], 
        SuperscriptBox["2", 
         StyleBox["k", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sqrt[2^k]{\\mathrm{abs}(D)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e722d5ba-c07e-49b1-ab80-339b52d125ab"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", 
         RowBox[{"[", 
           FractionBox[
            RowBox[{
              StyleBox["p", "TI"], "+", 
              StyleBox["q", "TI"], "+", "1"}], "2"], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> "k=[\\frac{p+q+1}{2}]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e76e0347-c9b8-4016-9a32-5d8346990185"],
 " denotes integer part of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["p", "TI"], "+", 
             StyleBox["q", "TI"], "+", "1"}], ")"}], "/", "2"}], 
       TraditionalForm], "errors" -> {}, "input" -> "(p+q+1)/2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a07b80fb-dc2d-4ffb-ab5b-53fb5128c94a"],
 ". The mentioned property ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", "\[PlusMinus]", "|", 
         StyleBox["A", "TI"], 
         SuperscriptBox["|", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}^2=\\pm|\\m{A}|^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89bda5cb-da14-4352-a398-9aab5959b8cc"],
 " is useful in converting the MV-valued function of MV-argument to a simpler \
scalar function of scalar argument multiplied by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["A", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0beebddc-0d28-48e9-886e-dfbf3cde906c"],
 ". This property is used to express the relations between trigonometric and \
hyperbolic function are presented and transformed to simpler scalar functions \
the argument of which is the norm. [",
 StyleBox["pavyzdys is zemiau perkeltas cia, nes labiau tinka",
  FontColor->RGBColor[1, 0, 0]],
 "]\[LineSeparator]"
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"16c6a762-07d0-493e-9d5c-e672e03cb4f5"],

Cell[TextData[{
 " ",
 StyleBox["MV  norm and property ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", "|", 
         StyleBox["A", "TI"], "|", 
         OverscriptBox[
          StyleBox["A", "TI"], "^"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{A}=\\magnitude{\\m{A}}\\hat{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e58723e-7826-48fd-9c42-88f3a780f4f8"],
 ". Let\[CloseCurlyQuote]s apply  formulas  to numerical MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{"-", 
                 SqrtBox["15"], "+", 
                 SqrtBox["111"]}], ")"}], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "-", "4", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "-", "8", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"], "+", "16", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "12"], "+", "8", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "13"], "+", 
             SqrtBox[
              RowBox[{"6", "(", 
                RowBox[{"21", "+", 
                  SqrtBox["185"]}], ")"}]], " ", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "23"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}=\\frac{1}{2} \\bigl((-\\sqrt{15}+\\sqrt{111}) \\e{1}-4 \
\\e{2}-8\\e{3}+16 \\e{12}+8 \\e{13}+\\sqrt{6 (21+\\sqrt{185})} \
\\,\\e{23}\\bigr)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54a2b602-6647-4659-a6a9-cca97b2e1afb"],
 "  in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7be8b774-0397-4afc-a133-9700ac2e207a"],
 " algebra. The square in this case is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{A}^2=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6f160115-cfe6-4bf2-8a74-4970c42034f6"],
 ". The determinant of matrix representation for this MV   is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["D", "TI"], "\[LongEqual]", "9"}], TraditionalForm], 
     "errors" -> {}, "input" -> "D=9", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be3259a1-8a57-4a38-9a38-0f2b62e2dd6a"],
 " (see ",
 StyleBox["unit~\\ref{Det}",
  FontColor->RGBColor[1, 0, 0]],
 ") and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{
                 StyleBox["p", "TI"], "+", 
                 StyleBox["q", "TI"], "+", "1"}], ")"}], "/", "2"}], "]"}], 
         "\[LongEqual]", 
         RowBox[{"[", 
           FractionBox["4", "2"], "]"}], "\[LongEqual]", "2"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "k=\\bigl[(p+q+1)/2\\bigr]=[\\frac{4}{2}] =2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52ee6798-4d29-48ca-95db-a29b1120be2c"],
 ".   Then, the norm is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["A", "TI"], "|", "\[LongEqual]", 
         SuperscriptBox["9", 
          FractionBox["1", 
           SuperscriptBox["2", "2"]]], "\[LongEqual]", 
         SqrtBox["3"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "|\\m{A}|=9^{\\frac{1}{2^2}}=\\sqrt{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c3abbae-1010-4578-89fa-e170bbe5c612"],
 " and the normalized (unit) MV is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["A", "TI"], "^"], "\[LongEqual]", 
         StyleBox["A", "TI"], "/", "|", 
         StyleBox["A", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{\\m{A}}=\\m{A}/|\\m{A}|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "beab6296-3ba5-46b5-9f5c-1f76ba2fbd9c"],
 " with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["A", "TI"], "^"], "2"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\hat{\\m{A}}^2=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26787079-95e3-41e1-bc21-5784982f8454"],
 ". It should be noted that the conventional formula, namely ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              StyleBox["A", "TI"], 
              OverscriptBox[
               StyleBox["A", "TI"], "~"]}], "\[RightAngleBracket]"}], "0"], 
         "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{"36", "-", "3", 
              SqrtBox["185"], "-", "8", 
              SqrtBox["15"], 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "2"], "+", "8", 
              SqrtBox["111"], 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "2"], "-", "4", 
              SqrtBox[
               RowBox[{"6", "(", 
                 RowBox[{"21", "+", 
                   SqrtBox["185"]}], ")"}]], 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "2"], "-", "4", 
              SqrtBox["15"], 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "3"], "+", "4", 
