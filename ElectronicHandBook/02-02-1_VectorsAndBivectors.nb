Cell[TextData[{
 "Check of  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], 
         StyleBox["b", "TI"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"], 
         TemplateBox[{
           RowBox[{
             StyleBox["b", "TI"]}]}, "Abs"], 
         RowBox[{"(", 
           RowBox[{"cos", "\[CurlyPhi]", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              RowBox[{
                StyleBox["a", "TI"], 
                StyleBox["b", "TI"]}]], "sin", "\[CurlyPhi]"}], ")"}], 
         "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"], 
         TemplateBox[{
           RowBox[{
             StyleBox["b", "TI"]}]}, "Abs"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{"\[CurlyPhi]", 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             RowBox[{
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"]}]]}]], ",  ", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["a", "TI"], 
            StyleBox["b", "TI"]}], "2"], "\[LongEqual]", "-1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "ab={|a|} {|b|}(\\cos\\varphi+\\e{ab}\\sin\\varphi)= \
{|a|}{|b|}\\ee^{\\varphi \\e{ab}},\\quad \\e{ab}^2=-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5975ab3-6807-4a41-bec2-1ea751fea289"]
}], "Text",
 CellChangeTimes->{
  3.913353437050125*^9, {3.913353487322199*^9, 
   3.91335350382202*^9}},ExpressionUUID->"1cea79a8-badb-4eb1-835c-\
f9cce6c82106"],

