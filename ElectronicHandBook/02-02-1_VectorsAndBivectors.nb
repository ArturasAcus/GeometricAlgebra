Cell[TextData[{
 "Generate arbitrary bivector of algebra, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "<", 
            StyleBox["j", "TI"]}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["b", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB=\\sum_{i<j}^n b_{ij}\\e{i}\\w\\e{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3271006-1cb2-43b1-867c-19545bf7e6b2"]
}], "SubsubitemParagraph",ExpressionUUID->"90a538b5-8b59-4a3d-afee-\
