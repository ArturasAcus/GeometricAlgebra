Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of general bivectors, ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cA", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c3fc6e3-3c48-4f06-8542-2cfdb57110cf"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4e51cac-59b4-45c8-95a5-31cf2c09ce32"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["B", "TI"], "\[LongEqual]", 
               UnderoverscriptBox["\[Sum]", 
                RowBox[{
                  StyleBox["i", "TI"], "<", 
                  StyleBox["j", "TI"]}], 
                StyleBox["n", "TI"], LimitsPositioning -> True], 
               SubscriptBox[
                StyleBox["b", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
