                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "2"]}], 
             "notation of outer product"}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               FractionBox["1", "2"], 
