Cell["\<\
Seems that in inline cell  Editable option doesn\[CloseCurlyQuote]t work in \
versions below 14!.  \
\>", "Text",
 CellChangeTimes->{{3.9110099064342*^9, 3.911009951356623*^9}, {
  3.911014116224025*^9, 3.911014125442753*^9}, {3.915598979256643*^9, 
  3.9155990148014593`*^9}},ExpressionUUID->"ddcda14d-5511-4add-8ce9-\
b550465f3e50"],

Cell[BoxData[
 RowBox[{"CreatePalette", "[", 
  RowBox[{"Button", "[", 
   RowBox[{"\"\<Toggle inline cells editable option to false\>\"", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "inlineCells", "}"}], ",", 
      RowBox[{
       RowBox[{"inlineCells", "=", 
        RowBox[{
         RowBox[{"Cells", "/@", 
          RowBox[{"Cells", "@", 
           RowBox[{"InputNotebook", "[", "]"}]}]}], "//", "Flatten"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CurrentValue", "[", 
             RowBox[{"#", ",", "Editable"}], "]"}], "===", "True"}], ",", 
           RowBox[{"SetOptions", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Editable", "->", "False"}]}], "]"}], ",", 
           RowBox[{"SetOptions", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Editable", "->", "True"}]}], "]"}]}], "]"}], "&"}], "/@",
         "inlineCells"}]}]}], "]"}]}], "]"}], "]"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.91100848134296*^9, 3.91100850257568*^9}, {
   3.91100857039575*^9, 3.911008656907335*^9}, 
   3.911009889257887*^9},ExpressionUUID->"d3e9ce9b-d025-4244-8d7a-\
a19be1a921b5"],

Cell[BoxData[
 RowBox[{"CreatePalette", "[", 
  RowBox[{"Button", "[", 
   RowBox[{"\"\<Replace specific cell background by text color \>\"", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "cellsWithBackround", "}"}], ",", 
      RowBox[{
       RowBox[{"cellsWithBackround", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Cells", "[", 
             RowBox[{
              RowBox[{"InputNotebook", "[", "]"}], ",", 
              RowBox[{"CellStyle", "\[Rule]", "\"\<Text\>\""}]}], "]"}], "//",
             "Flatten"}], ")"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"CurrentValue", "[", 
              RowBox[{"#", ",", "Background"}], "]"}], "===", 
             RowBox[{"RGBColor", "[", 
              RowBox[{"0.94", ",", " ", "0.91", ",", " ", "0.88"}], "]"}]}], 
            ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"SetOptions", "[", 
          RowBox[{"#", ",", 
           RowBox[{"FontWeight", "->", "\"\<Bold\>\""}], ",", "\n", " ", 
           RowBox[{"FontColor", "->", 
            RowBox[{"RGBColor", "[", 
             RowBox[{"0.6", ",", " ", "0.4", ",", " ", "0.2"}], "]"}]}], ",", 
           
           RowBox[{"Background", "->", "None"}]}], "]"}], "&"}], "/@", 
        "cellsWithBackround"}]}]}], "]"}]}], "]"}], "]"}]], "Input",
 Evaluatable->False,
 CellLabel->"In[49]:=",ExpressionUUID->"1cbec3aa-dc5f-495c-9b11-12cd3af5a3bf"],

Cell[CellGroupData[{

Cell["\<\
An alternative solution gives curves, not boxes (not acceptable in this case)\
\
\>", "Text",ExpressionUUID->"624ec101-ec6d-4f29-a6a5-c7e2a88acae4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ResourceFunction", "[", "\"\<MaTeXInstall\>\"", "]"}], "[", 
  "]"}]], "Input",
 Evaluatable->False,
 CellLabel->"In[5]:=",ExpressionUUID->"2fb09c46-900c-46f2-a24a-eb3b6386f73d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\\", "lcow"}], " ", "to", " ", "unset", " ", "the", " ", 
    "damage", " ", "done", " ", "below"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Unprotect"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InputAssistant`TeXStringToBoxes", "[", "s_String", "]"}], "/;", 
      RowBox[{"TrueQ", "@", "useMaTeXQ"}]}], "=."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Protect"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "use", " ", "MaTeX", " ", "to", " ", "format", " ", "inline", " ", 
     "TeX"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "@", "\"\<MaTeX`\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"useMaTeXMag", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"useMaTeXBaselineShift", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Unprotect"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InputAssistant`TeXStringToBoxes", "[", "s_String", "]"}], "/;", 
      RowBox[{"TrueQ", "@", "useMaTeXQ"}]}], ":=", 
     RowBox[{"AdjustmentBox", "[", 
      RowBox[{
       RowBox[{"ToBoxes", "@", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"s", ",", 
          RowBox[{"Magnification", "->", "useMaTeXMag"}]}], "]"}]}], ",", 
       RowBox[{"BoxBaselineShift", "->", "useMaTeXBaselineShift"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Protect"}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"useMaTeXQ", "=", "True"}], ";"}], "\n"}]}]], "Input",
 Evaluatable->False,ExpressionUUID->"13f6d102-17b3-4cb8-b1f4-aab444554ca6"],

