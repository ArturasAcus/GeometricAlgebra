  "e800bff5-cb8e-4084-8ed3-3b7a45be455f"],
 " command definitions add them to \
\[OpenCurlyDoubleQuote]Mathematica/13.2.0/SystemFiles/IncludeFiles/",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "534250d6-3f46-4014-85e9-6789ab6aa42a"],
 "Import/latex.tnb\[CloseCurlyDoubleQuote] file! "
}], "Text",
 CellChangeTimes->{
  3.911014114488517*^9},ExpressionUUID->"abeddf21-6278-446b-a19a-\
e49e2c4d2d35"],

Cell["\<\
Here is how one can insert link to pdf file in text cell: first prepare a \
button, then copy/paste it into text cell \
\>", "Text",
 CellChangeTimes->{
  3.911014114488517*^9, {3.915599386861013*^9, 3.9155994559536333`*^9}, {
   3.915599493516995*^9, 3.915599548500143*^9}, {3.91559960044709*^9, 
   3.915599600447197*^9}, {3.915600044741958*^9, 
   3.915600101008199*^9}},ExpressionUUID->"6dd7c383-6d96-4d8a-82b4-\
e9de0959c63b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"url", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", 
       RowBox[{"EvaluationNotebook", "[", "]"}], "]"}], ",", 
      "\"\<BibliographySources\>\"", ",", 
      "\"\<Staples_2011_0c960527d4b2564cbe000000.pdf\>\""}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Button", "[", 
  RowBox[{
   RowBox[{"Style", "[", 
    RowBox[{"\"\<mathematica.pdf\>\"", ",", "\"\<Subsection\>\""}], "]"}], 
   ",", 
   RowBox[{"SystemOpen", "[", "url", "]"}], ",", 
   RowBox[{"Appearance", "->", "\"\<Frameless\>\""}]}], "]"}]}], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.915599091568615*^9, 3.915599104742278*^9}, 
   3.9155991417605762`*^9, {3.9155991757933283`*^9, 3.915599176730831*^9}, {
   3.915599208968953*^9, 3.915599251671525*^9}, {3.915600031705795*^9, 
   3.915600033942299*^9}},ExpressionUUID->"455d11f3-f3c1-4126-8e09-\
b90d38947bbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Button", "[", 
  RowBox[{
   RowBox[{"Style", "[", 
    RowBox[{"\"\<Staples2011.pdf\>\"", ",", "\"\<Author\>\"", ",", 
     RowBox[{"FontColor", "->", "Blue"}]}], "]"}], ",", 
   RowBox[{"SystemOpen", "[", 
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NotebookDirectory", "[", 
        RowBox[{"EvaluationNotebook", "[", "]"}], "]"}], ",", 
       "\"\<BibliographySources\>\"", ",", 
       "\"\<Staples_2011_0c960527d4b2564cbe000000.pdf\>\""}], "}"}], "]"}], 
    "]"}], ",", 
   RowBox[{"Appearance", "->", "\"\<Frameless\>\""}]}], "]"}]], "Input",
 CellChangeTimes->{{3.915599091568615*^9, 3.915599104742278*^9}, 
   3.9155991417605762`*^9, {3.9155991757933283`*^9, 3.915599176730831*^9}, {
   3.915599208968953*^9, 3.915599251671525*^9}, 3.915599382021763*^9, 
   3.915599977511812*^9, {3.915600124059776*^9, 3.91560028362877*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"9c6bcfe8-9a42-4fec-80d1-650596d57d61"],

Cell[BoxData[
 ButtonBox[
  StyleBox["\<\"Staples2011.pdf\"\>", "Author",
   StripOnInput->False,
   FontColor->RGBColor[0, 0, 1]],
  Appearance->"Frameless",
  ButtonFunction:>SystemOpen[
    FileNameJoin[{
      NotebookDirectory[
       EvaluationNotebook[]], "BibliographySources", 
      "Staples_2011_0c960527d4b2564cbe000000.pdf"}]],
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{
  3.915599987739281*^9, {3.915600149387107*^9, 3.915600182460762*^9}, 
   3.915600221200951*^9, {3.915600280754741*^9, 3.915600286154346*^9}, 
   3.951361678949667*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"00fba816-6ade-4031-9abc-d5f4c891dee3"]
}, Open  ]],

Cell[TextData[{
 "Normal text cell with button, which opens pdf  copied inside ",
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Staples2011.pdf\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "BibliographySources", 
       "Staples_2011_0c960527d4b2564cbe000000.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",
  CellChangeTimes->{
   3.915599987739281*^9, {3.915600149387107*^9, 3.915600182460762*^9}, 
    3.915600221200951*^9, {3.915600280754741*^9, 3.915600286154346*^9}},
  ExpressionUUID->"876ef78d-d409-4a42-8521-de43d11442db"]
}], "Text",
 CellChangeTimes->{{3.915599862958138*^9, 3.915599908692737*^9}, 
   3.9155999988470297`*^9, 3.915600082813019*^9, {3.915600303217142*^9, 
   3.915600307056397*^9}},ExpressionUUID->"60415e08-f599-448f-b43a-\
