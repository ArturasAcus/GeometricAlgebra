Cell[CellGroupData[{

Cell["Properties of vectors", "Section",
 CounterAssignments->{{"Section", 1}, {"Subsubsection", 0}, {"Item", 0}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 0}, {
   "SubitemNumbered", 0}, {
   "SubsubitemNumbered", 
    0}},ExpressionUUID->"274b512a-c6ed-48fb-b297-7552e2a96411"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Hierarchy of inner, outer and geometric products",
  FontSlant->"Italic"],
 ". The inner (aka dot) product has precedence over outer (aka wedge) \
product. Both the inner and the outer products have precedence over the\n\
geometric product (GP):\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[CenterDot]", 
               StyleBox["b", "TI"], " ", 
               StyleBox["c", "TI"], "\[Congruent]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["c", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], " ", 
               StyleBox["c", "TI"], "\[Congruent]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["c", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[CenterDot]", 
               StyleBox["b", "TI"], "\[Wedge]", 
               StyleBox["c", "TI"], "\[Congruent]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], "\[Wedge]", 
               StyleBox["c", "TI"], "\[NotEqual]", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n&a\\d b\\, c\\equiv(a\\d b)c,\\\\\n&a\\w b\\, \
c\\equiv(a\\w b)c,\\\\\n&a\\d b\\w c\\equiv (a\\d b)\\w c\\ne a\\d (b\\w c)\n\
\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5fd8bef7-968b-4a26-9d70-e3d0f176bee9"],
 "\[LineSeparator]\[LineSeparator]The geometric and outer products are \
associative,\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["c", "TI"], "\[LongEqual]", 
               StyleBox["a", "TI"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["a", "TI"], 
               StyleBox["b", "TI"], 
               StyleBox["c", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "\[Wedge]", 
               StyleBox["c", "TI"], "\[LongEqual]", 
               StyleBox["a", "TI"], "\[Wedge]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[Wedge]", 
               StyleBox["c", "TI"]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n&(a b) c=a (b c)=a b c,\\\\\n&(a\\w b)\\w c=a\\w (b\\w \
c)=a\\w b\\w c\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e50176c0-f027-4f99-baff-80a32aee8d10"],
 "\[LineSeparator]\[LineSeparator]\nThe inner product is not associative. For \
example ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["B", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(a\\d b)\\d\\cB=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d13b9981-473a-407c-8bb4-607f92b3d5c5"],
 ", since the dot product of scalar and  bivector is always zero. However,  \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[CenterDot]", 
             StyleBox["B", "TI"]}], ")"}], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "a\\d (b\\d\\cB)\\ne 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bad319fc-12f5-41b2-8b7a-839daaf66154"],
 " except the cases when the vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f820f12-7366-46ab-a43c-edb1b8d8291d"],
 " is perpendicular to plane ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5a53b9a2-f991-4c51-8bd6-77b86043b0d6"],
 "."
}], "Item",ExpressionUUID->"51a0a068-2348-4e9c-a5b6-04d75d1b775a"],

