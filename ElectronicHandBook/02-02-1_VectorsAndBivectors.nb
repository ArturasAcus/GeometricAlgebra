  "49ba33c3-4949-4a2b-b1c3-12a2df497183"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}], ")"}], 
                StyleBox["n", "TI"]], "\[LongEqual]", 
               RowBox[{"{", 
                 Cell[
                  BoxData[
                   FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{"|", 
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"], 
                    SuperscriptBox["|", 
                    StyleBox["n", "TI"]]}], "    "}], "InlineFormula"], 
                    " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["if n is even,", "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{"|", 
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"], 
                    SuperscriptBox["|", 
                    RowBox[{
                    StyleBox["n", "TI"], "-", "1"}]], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}], ")"}]}], "    "}], 
                    "InlineFormula"], " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell["if n is odd.", "InlineFormula"], " "}]]}}], 
                    TraditionalForm]]]}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
