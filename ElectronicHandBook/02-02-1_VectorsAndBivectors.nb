Cell[TextData[{
 StyleBox["Exponential of vector",
  FontSlant->"Italic"],
 ". In real GAs, to calculate the exponential of vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "\[Ellipsis]", "+", 
         
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["n", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a=a_1\\e{1}+a_2\\e{2}+\\dots+a_n\\e{n}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "421bb126-f4f6-4aee-89a1-e8193f7a6eaa"],
 " one commonly expands in either trigonometric or hyperbolic functions, \
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["a", "TI"]], "\[LongEqual]", 
               RowBox[{"{", 
                 Cell[
                  BoxData[
                   FormBox[
                    GridBox[{{
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{
                    StyleBox["ch", FontSlant -> "Plain"], "|", 
                    StyleBox["a", "TI"], "|", "+", 
                    FractionBox[
                    StyleBox["a", "TI"], 
                    TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]], 
                    StyleBox["sh", FontSlant -> "Plain"], "|", 
                    StyleBox["a", "TI"], "|"}], " "}], "InlineFormula"], 
                    " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{"if ", 
                    SuperscriptBox[
                    StyleBox["a", "TI"], "2"], ">", "0", ","}], " "}], 
                    "InlineFormula"], " "}]]}, {
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{"cos", "|", 
                    StyleBox["a", "TI"], "|", "+", 
                    FractionBox[
                    StyleBox["a", "TI"], 
                    TemplateBox[{
                    RowBox[{
                    StyleBox["a", "TI"]}]}, "Abs"]], "sin", "|", 
                    StyleBox["a", "TI"], "|"}], " "}], "InlineFormula"], 
                    " "}]], 
                    Cell[
                    TextData[{" ", 
                    Cell[
                    RowBox[{
                    RowBox[{"if ", 
                    SuperscriptBox[
                    StyleBox["a", "TI"], "2"], "<", "0", ","}], " "}], 
                    "InlineFormula"], " "}]]}}], TraditionalForm]]]}]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\\ee^a=\\begin{cases}\n\
{\\ch\\magnitude{a}+\\frac{a}{\\magnitude{a}}\\sh\\magnitude{a}}\\ \
&{\\text{if\\ }a^2>0,}\\ \\\\\n{\\cos\\magnitude{a}+\\frac{a}{\\magnitude{a}}\
\\sin\\magnitude{a}}\\ &{\\text{if\\ }a^2<0,}\\ \n\\end{cases}\\end{aligned}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b62ef28-b1df-48bd-be45-fab8085a9f81"],
 "\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", 
         SqrtBox[
          RowBox[{"abs", "(", 
            SuperscriptBox[
             StyleBox["a", "TI"], "2"], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\magnitude{a}=\\sqrt{\\text{abs}(a^2)}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a5cf7a6-7f8d-4818-9d35-adf91408d1c8"],
 ". The exponential of vector also may be expanded as [",
 StyleBox["Pataisyta, nereikia Piecewise, cia viena formule universali, \
taisyti ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "ea86ddb4-5648-4039-97da-13967be9f971"],
 StyleBox[" fail",
  FontColor->RGBColor[1, 0, 0]],
 "]\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["a", "TI"]], "\[LongEqual]", 
         RowBox[{
           StyleBox["ch", FontSlant -> "Plain"], 
           SqrtBox[
            SuperscriptBox[
             StyleBox["a", "TI"], "2"]], "+", 
           FractionBox[
            StyleBox["a", "TI"], 
            SqrtBox[
             SuperscriptBox[
              StyleBox["a", "TI"], "2"]]], 
           StyleBox["sh", FontSlant -> "Plain"], 
           SqrtBox[
            SuperscriptBox[
             StyleBox["a", "TI"], "2"]]}], " ", 
         RowBox[{"if ", 
           SuperscriptBox[
            StyleBox["a", "TI"], "2"], "<", "0", ",  ", "or", "  ", 
           SuperscriptBox[
            StyleBox["a", "TI"], "2"], ">", "0"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\ee^a=\n{\\ch\\sqrt{a^2}+\\frac{a}{\\sqrt{a^2}}\\sh\\sqrt{a^2}}\\ \
&{\\text{if\\ }a^2<0,\\quad \\text{or}\\quad a^2>0 }", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c63dbd06-20b3-4560-8a86-1e89fe3bc165"]
}], "Subitem",
