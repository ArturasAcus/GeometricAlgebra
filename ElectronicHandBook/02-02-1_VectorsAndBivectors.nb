   SubscriptBox[
    RowBox[{"b1", "\[RightAngleBracket]"}], "2"], TraditionalForm]],
  ExpressionUUID->"4a11eb19-f156-4af8-b8c9-23b57db9de27"],
 " "
}], "Text",
