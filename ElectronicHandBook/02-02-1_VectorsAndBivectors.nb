        InterpretationFunction:>(
         RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
        SyntaxForm->"fish",
        Tooltip->"Cl[3, 0, 0]"], "+", 
       TemplateBox[{
         TemplateBox[{"2"}, "mvDownUp", DisplayFunction :> (StyleBox[
