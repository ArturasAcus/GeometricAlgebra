Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Exponential function of sums of   vectors",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 "|a| is a length of vector a.",
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["a", "TI"], "+", 
                  StyleBox["b", "TI"]}]], "\[LongEqual]", "cos", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"], "+", 
                   StyleBox["b", "TI"]}]}, "Abs"], "+", 
               FractionBox[
                RowBox[{
                  StyleBox["a", "TI"], "+", 
                  StyleBox["b", "TI"]}], 
                TemplateBox[{
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}]}, "Abs"]], "sin", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"], "+", 
                   StyleBox["b", "TI"]}]}, "Abs"], "        "}], 
             RowBox[{"if ", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}], ")"}], "2"], "<", "0"}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["a", "TI"], "+", 
                  StyleBox["b", "TI"]}]], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"], "+", 
                   StyleBox["b", "TI"]}]}, "Abs"], "+", 
               FractionBox[
                RowBox[{
                  StyleBox["a", "TI"], "+", 
                  StyleBox["b", "TI"]}], 
                TemplateBox[{
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}]}, "Abs"]], " ", 
               StyleBox["sh", FontSlant -> "Plain"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"], "+", 
                   StyleBox["b", "TI"]}]}, "Abs"]}], 
             RowBox[{"if ", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}], ")"}], "2"], ">", "0"}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["a", "TI"], "+", 
                  StyleBox["b", "TI"]}]], "\[LongEqual]", "1", "+", 
               StyleBox["a", "TI"], "+", 
               StyleBox["b", "TI"]}], 
             RowBox[{"if ", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "+", 
                    StyleBox["b", "TI"]}], ")"}], "2"], "\[LongEqual]", 
               "0"}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}&\n \
\\ee^{a+b}=\\cos{|a+b|}+\\frac{a+b}{{|a+b|}}\\sin{|a+b|} \\qquad \
\\qquad&\\text{if } (a+b)^2<0 \\\\&\n\
\\ee^{a+b}=\\ch{|a+b|}+\\frac{a+b}{{|a+b|}}\\,\\sh{|a+b|} &\\text{if } \
(a+b)^2>0 \\\\&\n\\ee^{a+b}=1+a+b&\\text{if } (a+b)^2=0 \n\\end{split}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3b83e6be-bfdb-408c-8427-a5e1daea69e8"],
 "\[LineSeparator]"
}], "Item",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.911277994344613*^9, 3.911278013642212*^9}, {
   3.911278145628385*^9, 3.911278147996205*^9}, {3.911278216851118*^9, 
   3.911278220325323*^9}, {3.911278296276189*^9, 3.911278306844193*^9}, {
   3.911278986914878*^9, 3.911278992230295*^9}, {3.911279195696149*^9, 
   3.9112792072841263`*^9}, {3.911279763189295*^9, 3.911279820327443*^9}, 
   3.9112800999322863`*^9, {3.911280456590341*^9, 3.911280486557554*^9}, 
   3.911280631359202*^9},ExpressionUUID->"9d44c89c-433a-40ae-9f3e-\
00a2d24e0343"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.921645248125014*^9, 3.92164524983869*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[0.6, 0.4, 0.2],
 Background->None,ExpressionUUID->"0487904b-b4e4-453f-9480-4fe4b49e8c38"],

Cell[TextData[{
 "The formulas are direct consequences of  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", "cos", "|", 
               StyleBox["A", "TI"], "|", "+", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], "sin", "|", 
               StyleBox["A", "TI"], "|        "}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], " is a scalar", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "<", "0"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], "|", 
               StyleBox["A", "TI"], "|", "+", 
               OverscriptBox[
                StyleBox["A", "TI"], "^"], " ", 
               StyleBox["sh", FontSlant -> "Plain"], "|", 
               StyleBox["A", "TI"], "|"}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "is a scalar ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], ">", "0"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]", "1", "+", 
               StyleBox["A", "TI"]}], 
             RowBox[{"if ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "is a scalar ", 
               SuperscriptBox[
                StyleBox["A", "TI"], "2"], "\[LongEqual]", "0"}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}&\n   \
\\ee^{\\m{A}}=\\cos|\\m{A}|+\\hat{\\m{A}}\\sin|\\m{A}| \\qquad \
\\qquad&\\text{if } \\m{A}^2 \\text{ is a scalar} \\m{A}^2<0\\\\&\n\
\\ee^{\\m{A}}=\\ch|\\m{A}|+\\hat{\\m{A}}\\,\\sh|\\m{A}| &\\text{if } \\m{A}^2 \
 \\text{is a scalar } \\m{A}^2>0 \\\\&\n\\ee^{\\m{A}}=1+\\m{A}&\\text{if } \
\\m{A}^2 \\text{is a scalar } \\m{A}^2=0\n\\end{split}", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e75b151-8f81-4073-98d1-798ab830c9bf"],
 ", which already were checked (even for non blades).\n"
}], "Text",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"7c8b1d44-1b9f-465a-b6cd-64b90b90f817"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Euler-de Moivre formulas with unit 2-blades",
  FontSlant->"Italic"],
 StyleBox[". ",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["B", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{\\cB}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b301a45d-4247-4401-911d-69cb7953de23"],
 " is the unit bivector.",
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                RowBox[{
                  StyleBox["n", "TI"], "\[CurlyPhi]", 
                  OverscriptBox[
                   StyleBox["B", "TI"], "^"]}]], "\[LongEqual]", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{"cos", "\[CurlyPhi]", "+", 
                    OverscriptBox[
                    StyleBox["B", "TI"], "^"], "sin", "\[CurlyPhi]"}], ")"}], 
                
                StyleBox["n", "TI"]], "\[LongEqual]", 
