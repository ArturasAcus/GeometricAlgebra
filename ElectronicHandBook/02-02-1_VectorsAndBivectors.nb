                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&ab+ba=2a\\d b\\\\&\n  ab-ba=2a\\w b\\\\&\n  \
(ab)^2-(ba)^2=4(a\\d b)(a\\w b)\\\\&\n  (ab)^2+(ba)^2=2(a\\d b)^2+2(a\\w \
b)^2=4(a\\d b)^2-2a^2b^2\\\\&\n  a(a\\w b)=(b\\w a)a\\\\&\n  aba=\\langle aba\
\\rangle_1=(a\\d b)a+(a\\w b)\\d a\\\\&\n  (aba)^2=a^4b^2\\end{aligned}", 
     "state" -> "Boxes"|>,
