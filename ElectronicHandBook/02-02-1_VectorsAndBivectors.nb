Cell[TextData[{
 "\nGeometric interpretation of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "517f3e85-7909-48ff-9ff2-c67e0e1d802b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b6bf2c7-a45f-4576-ad84-aef0b15ea295"],
 ": the equivalence under displacement,distinct attitudes,different \
magnitudes and opposite orientations"
}], "Text",ExpressionUUID->"2eab36e1-84d0-4e7c-a2ab-bcca41227554"]
}, Closed]],

Cell[CellGroupData[{

Cell["Computational verification ", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[0.6, 0.4, 0.2],
 Background->None,ExpressionUUID->"c9e881fd-65ca-432d-8a79-6f043051c1b5"],

Cell["\<\
Make sure you evaluated \[OpenCurlyDoubleQuote]Definitions\
\[CloseCurlyDoubleQuote] subsection before. We have to choose some algebra \
and define its orthonormal basis. You can change algebra and redefine basis \
before any computations. \
\>", "Text",ExpressionUUID->"4ffb1d48-bb5c-401c-a815-1337d1ffc169"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"4", ",", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebra", ",", 
   RowBox[{"Quiet", "->", "True"}]}], "]"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"c171ec2f-76da-4a7e-9256-81ad78ac5af3"],

