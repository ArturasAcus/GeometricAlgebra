     "errors" -> {}, "input" -> 
     "\\begin{split}&\n \
\\ee^{\\m{A}}=1+\\frac{\\m{A}}{1!}+\\frac{\\m{A}^2}{2!}+\\cdots+\\frac{\\m{A}^\
n}{n!}+\\cdots,\n&\\\\&\n\
\\sin\\m{A}=\\m{A}-\\frac{\\m{A}^3}{3!}+\\frac{\\m{A}^5}{5!}-\\frac{\\m{A}^7}{\
7!}+\\cdots,\n\
&\\cos\\m{A}=1-\\frac{\\m{A}^2}{2!}+\\frac{\\m{A}^4}{4!}-\\frac{\\m{A}^6}{6!}+\
\\cdots, \\\\&\n\
\\sh\\m{A}=\\m{A}+\\frac{\\m{A}^3}{3!}+\\frac{\\m{A}^5}{5!}+\\frac{\\m{A}^7}{\
7!}+\\cdots,\n&\\ch\\m{A}=1+\\frac{\\m{A}^2}{2!}+\\frac{\\m{A}^4}{4!}+\\frac{\
\\m{A}^6}{6!}+\\cdots,\\\\&\n\
\\log(1+\\m{A})=\\m{A}-\\frac{1}{2}\\m{A}^2+\\frac{1}{3}\\m{A}^3\n-\\cdots, &\
\\qquad-1< |\\m{A}|< 1.\\\\&\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2adebafe-bacb-4bc5-b48f-e1e3cf8320c8"],
 "\[LineSeparator]In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"log", "(", 
         RowBox[{"1", "+", 
           StyleBox["A", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\log(1+\\m{A})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a133b826-d4e1-4ba9-a9c2-1aa207c19b10"],
 " the expansion is around the point ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29a4f01e-b67b-4d6d-b6b5-2f423f75ac2e"],
 ". The series is called the Mercator series."
}], "Item",
