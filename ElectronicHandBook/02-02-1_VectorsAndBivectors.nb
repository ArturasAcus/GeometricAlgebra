Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Relation to vector cross product",
  FontSlant->"Italic"],
 ". ",
 "Relation to vector cross product Symbols ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Cross]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\bf\\times", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "09a12fed-d7d2-4341-b973-17b11ed339a7"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[EmptySmallCircle]", TraditionalForm], 
     "errors" -> {}, "input" -> "\\circ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cf5bc19-e4ac-4f78-acc6-394f7e249a7f"],
 " denote the cross and the scalar product in the standard 3D vectorial \
calculus. Below the star ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Null]", "\[FivePointedStar]"], TraditionalForm], 
     "errors" -> {}, "input" -> "{}^{\\star}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "744e97c7-8b11-4adb-8744-6cb5fdeb7a05"],
 " is the Hodge dual\nand ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["I", "TI"], TraditionalForm], "errors" -> {}, "input" -> "I", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b38750a1-cc7a-4f57-a476-17895d5efddd"],
 " denotes the pseudoscalar of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6385d70f-317d-4b9f-bd21-bde8e06010da"],
 ".",
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", "\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Cross]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{
                 SuperscriptBox["\[Null]", "\[FivePointedStar]"], "(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"]}], ")"}], 
               SuperscriptBox[
                StyleBox["I", "TI"], "-1"]}]}, {"\[Null]", "\[Null]", 
             RowBox[{"|", 
               RowBox[{
                 StyleBox["a", "TI"], "\[Cross]", 
                 StyleBox["b", "TI"]}], "|", "\[LongEqual]", 
               TemplateBox[{
                 RowBox[{
                   StyleBox["a", "TI"]}]}, "Abs"], 
               TemplateBox[{
                 RowBox[{
                   StyleBox["b", "TI"]}]}, "Abs"], "sin", "\[Theta]"}]}, {
            "\[Null]", "\[Null]", 
             RowBox[{"|", 
               RowBox[{
                 StyleBox["a", "TI"], "\[Cross]", 
                 StyleBox["b", "TI"]}], 
               SuperscriptBox["|", "2"], "\[LongEqual]", "|", 
               StyleBox["a", "TI"], 
               SuperscriptBox["|", "2"], "|", 
               StyleBox["b", "TI"], 
               SuperscriptBox["|", "2"], "-", 
               SuperscriptBox[
                RowBox[{"(", 
                  RowBox[{
                    StyleBox["a", "TI"], "\[CenterDot]", 
                    StyleBox["b", "TI"]}], ")"}], "2"]}]}, {
            "\[Null]", "\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Cross]", 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["b", "TI"]}], ")"}], 
               StyleBox["c", "TI"], "+", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               StyleBox["b", "TI"]}]}, {"\[Null]", "\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Cross]", 
                   StyleBox["b", "TI"]}], ")"}], "\[EmptySmallCircle]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], "\[Cross]", 
                   StyleBox["d", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[CenterDot]", 
                   StyleBox["d", "TI"]}], ")"}], "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   StyleBox["d", "TI"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[CenterDot]", 
                   StyleBox["c", "TI"]}], ")"}]}]}, {"\[Null]", "\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Cross]", 
                   StyleBox["b", "TI"]}], ")"}], "\[Cross]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["c", "TI"], "\[Cross]", 
                   StyleBox["d", "TI"]}], ")"}], "\[LongEqual]", "-", 
               RowBox[{"(", 
                 RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["a", "TI"], "\[Wedge]", 
                    StyleBox["c", "TI"], "\[Wedge]", 
                    StyleBox["d", "TI"]}], ")"}], 
                   StyleBox["b", "TI"], "-", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["b", "TI"], "\[Wedge]", 
                    StyleBox["c", "TI"], "\[Wedge]", 
                    StyleBox["d", "TI"]}], ")"}], 
                   StyleBox["a", "TI"]}], ")"}], 
               StyleBox["I", "TI"]}]}, {"\[Null]", "\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[EmptySmallCircle]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["b", "TI"], "\[Cross]", 
                   StyleBox["c", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], 
               SuperscriptBox[
                StyleBox["I", "TI"], "-1"], "\[LongEqual]", "-", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[Wedge]", 
                   StyleBox["b", "TI"], "\[Wedge]", 
                   StyleBox["c", "TI"]}], ")"}], 
               StyleBox["I", "TI"]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[2.7998999999916003`*^11], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}&\n & (a{\\bf\\times} b)={^{\\star}(a\\w b)} =(a\\w \
b)I^{-1}\\\\&\n& \\magnitude{a{\\bf\\times} \
b}={\\magnitude{a}}{\\magnitude{b}}\\sin\\theta\\\\&\n & \
\\magnitude{a{\\bf\\times} b}^2=\\magnitude{a}^2\\magnitude{b}^2-(a\\d b)^2 \
\\\\&\n& a{\\bf\\times}(b{\\bf\\times} c)=-(a\\d b)c+(a\\d c)b\\\\&\n & \
(a{\\bf\\times} b)\\circ(c{\\bf\\times} d)=(a\\d c)(b\\d d)-(a\\d d)(b\\d \
c)\\\\&\n & (a{\\bf\\times} b){\\bf\\times}(c{\\bf\\times} d)\n =-\\big( \
(a\\w c\\w d)b-(b\\w c\\w d)a\\big)I\\\\&\n & a\\circ(b{\\bf\\times} c)=(a\\w \
b\\w c)I^{-1}=-(a\\w b\\w c)I\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1cfae0d0-c78f-4ebc-953f-b698ce166bd8"],
 "\[LineSeparator]\[LineSeparator]The cross product is not associative \
whereas the wedge product is."
}], "Item",ExpressionUUID->"48d2c2c4-8f8b-4d41-a0b4-074f16d895b8"],

