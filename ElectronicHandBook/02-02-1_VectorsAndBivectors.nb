               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n&  (a+b)^n=\\begin{cases}{|a+b|^n}\\qquad &\\text{if \
n is even,} \\\\\n {|a+b|^{n-1} (a+b) }\\qquad&\\text{if  n is odd.}\n\
\\end{cases}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
