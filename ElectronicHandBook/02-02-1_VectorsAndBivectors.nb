Cell[CellGroupData[{

Cell[TextData[{
 " ",
 StyleBox["Square of bivector.\t",
  FontSlant->"Italic"],
 "The cases, when the square of bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "2"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[Wedge]", 
              StyleBox["b", "TI"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\cB^2=(a\\w b)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "930a11c2-1a88-44fc-98d1-7fa191549a28"],
 " is positive, negative, or zero are considered. For Euclidean ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{p}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4f3ee16-c785-420b-b4ca-8239b873c3bc"],
 " and anti-Euclidean ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "47190092-301c-443c-9224-9f2df638af68"],
 " algebras we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"], ">", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a^2b^2>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bddc2fa7-05a4-47f1-8071-8eb8245842f1"],
 ". Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[CenterDot]", 
              StyleBox["b", "TI"]}], ")"}], "2"], "\[LessEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a\\d b)^2\\le a^2b^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa754824-2a08-477d-8f94-59cb0d44ac88"],
 " one has ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "2"], "\[LessEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\cB^2\\le 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef6a5af1-0682-4918-9e27-a7a523b58b82"],
 ". For mixed signature algebras the sign of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["B", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b7c25d42-c2d9-4803-a12a-65225cd90ba4"],
 " may be either positive or negative. The   positive sign is obtained when \
signs of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "a^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "53f86ff4-eae1-45ca-9923-c935f3306e98"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["b", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "b^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9305a02f-6241-4a7c-ac6b-a046ba74863e"],
 " are opposite. For a simple algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{1}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d3baab5-dd2a-432e-913a-e4fdb471bcae"],
 " having mixed signature  the basis vectors satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1", "2"], "\[LongEqual]", 
         "+1", 
         StyleBox["a", "TI"], 
         StyleBox["n", "TI"], 
         StyleBox["d", "TI"], 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2", "2"], "\[LongEqual]", 
         "-1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{1}^2=+1 and \\e{2}^2=-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa9bad5f-e93f-4f63-bdfd-715df417feba"],
 ". If vectors are expanded in components, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a=a^1\\e{1}+a^2\\e{2}", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11cd5d81-45ea-4dbb-866d-5f0e33035b78"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["b", "TI"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "b=b^1\\e{1}+b^2\\e{2}", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5ea1c4b-4c25-41e5-b1b2-2c30b93de97c"],
 ", then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[Wedge]", 
              StyleBox["b", "TI"]}], ")"}], "2"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[CenterDot]", 
              StyleBox["b", "TI"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox[
               StyleBox["a", "TI"], "1"], 
              SuperscriptBox[
               StyleBox["b", "TI"], "1"], "-", 
              SuperscriptBox[
               StyleBox["a", "TI"], "2"], 
              SuperscriptBox[
               StyleBox["b", "TI"], "2"]}], ")"}], "2"], "-", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
                SuperscriptBox[
                 StyleBox["a", "TI"], "1"], ")"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
                SuperscriptBox[
                 StyleBox["a", "TI"], "2"], ")"}], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
                SuperscriptBox[
                 StyleBox["b", "TI"], "1"], ")"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
                SuperscriptBox[
                 StyleBox["b", "TI"], "2"], ")"}], "2"]}], ")"}], 
         "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              SuperscriptBox[
               StyleBox["a", "TI"], "1"], 
              SuperscriptBox[
               StyleBox["b", "TI"], "2"], "-", 
              SuperscriptBox[
               StyleBox["a", "TI"], "2"], 
              SuperscriptBox[
               StyleBox["b", "TI"], "1"]}], ")"}], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(a\\w b)^2=(a\\d \
b)^2-a^2b^2=(a^1b^1-a^2b^2)^2-\\big((a^1)^2-(a^2)^2\\big)\\big((b^1)^2-(b^2)^\
2\\big) =(a^1b^2-a^2b^1)^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "04798971-eb29-4462-ad98-72402a9c3982"],
 ", which is always positive."
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"aa49950b-15c3-4b75-8e20-2674b1fd548e"],

