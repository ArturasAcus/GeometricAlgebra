     RowBox[{"gaCommutator", "[", 
      RowBox[{"\[ScriptCapitalA]1", ",", "\[ScriptCapitalB]1"}], "]"}], "//", 
     
     RowBox[{
      RowBox[{
       RowBox[{"gaCE", "[", 
        RowBox[{"1", "/", "2"}], "]"}], "[", "#", "]"}], "&"}]}], ")"}], "//",
