Cell["LHS", "Text",ExpressionUUID->"886cd1a0-d11a-48d7-8120-8e156def363c"],

Cell["\<\
When a number of factors is expanded expansion time can vary depending on how \
we group expansion coefficients. By default coefficients are expanded  (see \
leaf count)  \
\>", "Text",ExpressionUUID->"8088f790-aaaf-4f55-ba34-b4e712aaeb79"],

