Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\tH",
 StyleBox["omogeneous MV",
  FontSlant->"Italic"],
 ".  The multivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{A}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe1c83d0-369f-4861-ae41-0448349c4026"],
 "  consists of sum of members having the same grade. \[LineSeparator]\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            SubscriptBox[
             StyleBox["i", "TI"], "1"], "<", 
            SubscriptBox[
             StyleBox["i", "TI"], "2"], "<", "\[CenterEllipsis]", "<", 
            SubscriptBox[
             StyleBox["i", "TI"], 
             StyleBox["r", "TI"]]}], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            SubscriptBox[
             StyleBox["i", "TI"], "1"], 
            SubscriptBox[
             StyleBox["i", "TI"], "2"], "\[CenterEllipsis]", 
            SubscriptBox[
             StyleBox["i", "TI"], 
             StyleBox["r", "TI"]]}]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Ellipsis]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["r", "TI"]], ",    ", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\grade{\\m{A}}{r}=\\sum_{i_1<i_2<\\cdots<i_r} a^{i_1i_2\\cdots\n  i_r}\
\\e{1}\\e{2}\\ldots\\e{r},\\qquad \\grade{\\m{A}}{r}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd32f712-4855-4c9a-9fef-4b19c4c4af51"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "r"], "n"], TraditionalForm]],
  ExpressionUUID->"34d9134a-7af9-43d6-9e01-a97725aa2a12"],
 ".\[LineSeparator]\nThe sum  may be or not homogeneous. The bivectors in \
both examples above are of this type. The sum of r-blades is a homogeneous \
grade-r MV if it is reducible to indivisible geometric object ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "de6111f6-3dc4-485c-a60c-f74d40cc1bd9"],
 ". \nFor homogeneous bivector represented by a  sum of two bivectors. The \
class of homogeneous grade-r MVs is includes in the class of r-blades, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "\[SupersetEqual]", 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\grade{\\m{A}}{r}\\supseteq A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "192535cb-7b11-4bb2-811c-6fce74eadee5"],
 ".\n\nThe blade is said to be a isotropic blade (aka null blade) if its \
square is zero. The isotropic blade represents a degenerate hypervolume."
}], "Item",ExpressionUUID->"e510a0e6-0ca1-4757-8ed6-1bcbec34684a"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Blade decomposition and factorization",
  FontSlant->"Italic"],
 ".  The blade (aka simple multivector) can be expanded (decomposed) as a sum \
of totally antisymmetrized GPs of vectors. Inversely, the antisymmetrized sum \
of geometric products (GP) of  vectors can be factorized into a blade. For \
example, if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a, b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5a43001-cc6b-410f-98be-340e0a971d10"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93388ec4-62c3-435f-8624-3215558987f6"],
 " are linearly independent vectors then 2- and 3-blades expressed through GP \
sums are\n\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               FractionBox["1", "2!"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"], "-", 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"]}], ")"}], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[Wedge]", 
               StyleBox["c", "TI"], "\[LongEqual]", 
               FractionBox["1", "3!"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], "+", 
                   StyleBox["c", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["b", "TI"], "+", 
                   StyleBox["b", "TI"], 
                   StyleBox["c", "TI"], 
                   StyleBox["a", "TI"], "-", 
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"], "-", 
                   StyleBox["a", "TI"], 
                   StyleBox["c", "TI"], 
                   StyleBox["b", "TI"], "-", 
                   StyleBox["b", "TI"], 
                   StyleBox["a", "TI"], 
                   StyleBox["c", "TI"]}], ")"}], ",  ", "etc."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n& a\\w b =\\frac{1}{2!}(ab-ba),\\\\\n& a\\w b\\w c \
=\\frac{1}{3!}(abc+cab+bca-cba-acb-bac),\\quad\\text{etc.}\n\\end{split}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "419e092b-2ebe-48b9-8ea9-78e62781d9d1"],
 " \n\nIn practice it is important to recognize whether homogeneous grade-r \
multivector represents an r-blade or not. The scalar and pseudoscalar are \
always blades, because they are the only single elements of that grade. The \
vector is a blade by definition. The same is true for pseudovector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
        RowBox[{
          StyleBox["n", "TI"], "-", "1"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\langle A\\rangle_{n-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9e395d59-2a99-4b0d-975c-021db46ff50c"],
 ", since vector and pseudovector spaces  are Hodge dual. From this follows, \
for example, that individual trivectors and their sums are the blades in 4D \
space but not necessarily in a higher dimensional space. Similarly,  the sums \
of bivectors are blades only in 3D space. In 4D space the sum may not reduce \
to a blade. The square of a blade always yields a scalar. For example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[Wedge]", 
              StyleBox["b", "TI"]}], ")"}], "2"], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["a", "TI"], "\[CenterDot]", 
              StyleBox["b", "TI"]}], ")"}], "2"], "-", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["b", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(a\\w b)^2=(a\\d b)^2-a^2b^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e496bd7-7a24-4bf4-8c8c-bc8fdf4eda7c"],
 " is always a scalar. However, the inverse statement is  valid only for \
bivectors.  For example,   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"6", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{6}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c15d75cb-c30b-4a87-b98b-ab6d051721ff"],
 " trivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "456"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{123}+\\e{456}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f3da0a7-cb6a-4ef0-b5b3-c37167baec53"],
 " is not a blade, despite of the fact that its square is a real number ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"\[LongEqual]", "-2"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(=-2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50eb798c-b90e-4b3e-af9f-0e67e84bc332"],
 ". "
}], "Item",ExpressionUUID->"0ddfdd54-5997-45c4-8f3f-e57642b5a485"],

