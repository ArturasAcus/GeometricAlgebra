Cell[TextData[{
 "Then  construct the sum  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[NotEqual]", "0", ",", 
            StyleBox["s", "TI"], "\[NotEqual]", "0"}], LimitsPositioning -> 
          True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
          RowBox[{
            StyleBox["abs", FontSlant -> "Plain"], "(", 
            RowBox[{
              StyleBox["s", "TI"], "-", 
              StyleBox["r", "TI"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\sum_{r \\ne 0,s \\ne 0}\\langle\\langle\n\\m{A}\\rangle_r\\langle\n\
\\m{B}\\rangle_s \\rangle_{\\mathrm{abs}({s-r})}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3332eeef-032d-41ad-9a78-e4f91b9226dc"],
 ". At the moment we didn\[CloseCurlyQuote]t yet define what geometric \
product of homogeneous multivectors  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\n\\m{A}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "08da54ee-0fe1-4986-a645-9f76c396ff0c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["s", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\n\\m{B}\\rangle_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "31f39b36-59af-4f8d-941c-f5bdb7bf655c"],
 " means, therefore let\[CloseCurlyQuote]s assume it is a \
\[OpenCurlyDoubleQuote]black box\[CloseCurlyDoubleQuote] (it will become \
clear once we will introduce geometric products of basis elements)"
}], "Text",ExpressionUUID->"44e3bf86-95b6-48dd-bb00-66fdca565f14"],

