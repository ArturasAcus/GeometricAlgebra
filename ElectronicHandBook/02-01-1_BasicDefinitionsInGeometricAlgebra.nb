Cell["Choose algebra and generate general MV.  ", "Text",ExpressionUUID->"6c7d75a5-a515-444a-8583-73b4bec96ebb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"3", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"generalMVu", "=", 
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"u", ",", "testAlgebra"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"generalMVv", "=", 
    RowBox[{"gaGeneralMultivector", "[", 
     RowBox[{"v", ",", "testAlgebra"}], "]"}]}], ")"}], "//", 
  "Length"}]}], "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"1c9f3a1b-a568-4a9a-a7d7-b47e0fd19e17"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Basis vectors are stored in \"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{
     TemplateBox[{"3", "2", "0"},
      "Cl",
      DisplayFunction->(SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 0.5019607843137255, 0.]}], 
        RowBox[{#, ",", #2}]]& ),
      Tooltip->None], ",", "\<\"InvDeg[Lex]\"\>"}], "]"}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.950158382364579*^9},ExpressionUUID->"85503536-aa34-45f5-aaf9-\
e105ff30bd95"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Running algebra is: gaRunningAlgebra=\"\>",
   "EchoLabel"], "  ", 
  TemplateBox[{"3", "2", "0"},
   "Cl",
   DisplayFunction->(SubscriptBox[
     StyleBox["Cl", {FontColor -> RGBColor[0., 0.5019607843137255, 0.]}], 
     RowBox[{#, ",", #2}]]& ),
   Tooltip->None]}]], "Echo",
 CellChangeTimes->{
  3.9501583830010757`*^9},ExpressionUUID->"5a4936f2-5d7c-4089-bc93-\
76fc0d778560"],

