Cell[TextData[{
 "are the same as given by formula  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          RowBox[{
            StyleBox["j", "TI"], "-", "1"}]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Wedge]", 
         "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", FontSlant -> "Plain"], "\:030c"], 
          StyleBox["j", "TI"]], "\[Wedge]", "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]], 
         SubsuperscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"], "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{e}_{}^j=(-1)^{j-1}\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}\\wedge\
\\dots\\wedge\\check{\\mathrm{e}_{}}_j\\wedge\\dots\\wedge\\mathrm{e}_{n}E_n^{\
-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68d8cf21-2760-4a64-ae4b-fffb3bcbb1ba"],
 ". First we implement the formula as "
}], "Text",ExpressionUUID->"aabdb08b-dc68-4dec-837d-ca84cff6b266"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eRecip", "[", "j_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "1"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"j", "-", "1"}], ")"}]}], "*", 
    RowBox[{"(", 
     RowBox[{"OuterProduct", "@@", 
      RowBox[{"Drop", "[", 
       RowBox[{
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
          RowBox[{"{", "1", "}"}]}], "]"}], ",", 
        RowBox[{"{", "j", "}"}]}], "]"}]}], ")"}]}], "\[GeometricProduct]", 
   RowBox[{"gaInverse", "[", 
    RowBox[{"gaI", "[", "testAlgebra", "]"}], "]"}]}]}]], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"88772a48-4dc6-4fe8-baec-79a09f52b1d3"],

