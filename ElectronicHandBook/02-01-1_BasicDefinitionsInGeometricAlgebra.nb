Cell[TextData[{
 "Define nonorthonormal primary basis: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], ",  ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], ",  ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "3", "\[Prime]"], "\[LongEqual]", "2", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "e_{1}^{\\prime}=-\\mathrm{e}_{1}-\\mathrm{e}_{2}+\\mathrm{e}_{3},\\quad \
e_{2}^{\\prime}=-\\mathrm{e}_{1}+\\mathrm{e}_{3},\\quad \
e_{3}^{\\prime}=2\\mathrm{e}_{1}+\\mathrm{e}_{2}-\\mathrm{e}_{3}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60e6b6a9-52c3-488e-b2ee-73786f11a0e9"],
 ". To this end we name nonorthonormal basis vectors as p[1],p[2],p[3] and \
(important!) wrap them by generic noncommutative head ",
 StyleBox["MV[]",
  FontWeight->"Bold"],
 ". There are  rules defined how to dealt with this head, however, a number \
of package functions are instructed to handle this case much like the head of \
basis vector ",
 StyleBox["\[DoubleStruckE][]",
  FontWeight->"Bold"],
 ", i.\[DoubleStruckE]. treats  the head as noncommutative quantity."
}], "Text",ExpressionUUID->"23b11bd7-4890-46f2-9c1f-0943125f3e3a"],

