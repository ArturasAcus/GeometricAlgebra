Cell[BoxData[{
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"gaOrderedQ", "[", "\"\<InvDeg[Lex]\>\"", "]"}], "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], "&"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gaPrimitiveIdempotent", "[", 
        RowBox[{"testAlgebra", ",", 
         RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}]}], ",", 
         RowBox[{"OutputForm", "\[Rule]", "\"\<IdempotentFactors\>\""}], ",", 
         
         RowBox[{
         "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
          "\"\<InvDeg[Lex]\>\""}], ",", 
         RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "9"}], "}"}]}], "]"}], ",", "3"}], 
    "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Length", "[", "%", "]"}]}], "Input",
