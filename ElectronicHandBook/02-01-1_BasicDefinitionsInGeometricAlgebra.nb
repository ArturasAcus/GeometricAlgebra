Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Group of idempotents",
  FontSlant->"Italic"],
 ".  If one includes  all possible  plus/minus signs and all elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bbb5095-7853-4fd3-8ccb-26e2ca20f206"],
 " in the primitive idempotent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c0c30bee-d865-4a9d-a8eb-767f284a12eb"],
 " then one obtains a  group of idempotents of the order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "103a0768-4794-4f9a-a93b-81261d2a081b"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7218fc28-3b99-43bb-bc75-7cdbc425de44"],
 " is the number of factors in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f6fc442-fb1d-4b8b-8033-ea9d9e6ef1f7"],
 ". The sum of all elements  in thus generated group always sum up to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1205d535-57e8-4fe5-a7cf-0ae50020ee98"],
 ", i.e. makes a decomposition of unity. The MVs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f6dc9c0-04d3-4a35-be41-b7bd5155f2fa"],
 " in the group may serve as projectors that have split the MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6efb515c-121a-44d7-a9e9-988b4c977bfc"],
 "  into ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57e9b5e0-ff03-4d50-adf4-cc8c91815a3b"],
 " parts  ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["M", "TI"], 
          SubscriptBox[
           StyleBox["P", "TI"], 
           StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
      "\\m{M}\\m{P}_k", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "22c4dcb0-0170-44c2-9b47-824538431cf3"],
 ". The coefficient ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", "2"}], TraditionalForm], "errors" -> {}, "input" -> 
     "1/2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "64fa26d3-fb35-420d-86f5-4c6379604b9d"],
 " must accompany  every idempotent factor, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "(", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["i", "TI"]]]}], ")"}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{1}{2}(1+B_{T_i})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11d05d8f-5e54-421c-a0b7-bd8fbf16f93f"],
 ", the number of which is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["k", "TI"], TraditionalForm], "errors" -> {}, "input" -> "k", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca2ebc8c-67a9-4cde-9fb4-4f1f0ae9131d"],
 ". The elements with opposite signs in the idempotent group, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "(", 
         RowBox[{"1", "+", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["i", "TI"]]]}], ")"}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{1}{2}(1+B_{T_i})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "606f5bdb-3a8e-4e05-9dbf-6fe3e63c36be"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], "(", 
         RowBox[{"1", "-", 
           SubscriptBox[
            StyleBox["B", "TI"], 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["i", "TI"]]]}], ")"}], TraditionalForm], "errors" -> {},
      "input" -> "\\frac{1}{2}(1-B_{T_i})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d414332-5654-453d-87e8-bda53a925860"],
 ", are mutually annihilating."
}], "Item",ExpressionUUID->"2e773470-b3e4-41a0-9399-e4ad73dd6956"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Primitive idempotent group of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "ce2f3498-5194-4416-8bad-d77330850ed1"],
 ". The following primitive idempotent group can be   constructed, \
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               SubsuperscriptBox[
                StyleBox["P", "TI"], 
                SubscriptBox["Cl", 
                 RowBox[{"3", ",", "1"}]], "1"], "\[LongEqual]", 
               FractionBox["1", "4"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
               ","}], 
             RowBox[{"  ", 
               SubsuperscriptBox[
                StyleBox["P", "TI"], 
                SubscriptBox[
                 StyleBox["Cl", "TI"], 
                 RowBox[{"3", ",", "1"}]], "2"], "\[LongEqual]", 
               FractionBox["1", "4"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
               ","}]}, {
             RowBox[{
               SubsuperscriptBox[
                StyleBox["P", "TI"], 
                SubscriptBox["Cl", 
                 RowBox[{"3", ",", "1"}]], "3"], "\[LongEqual]", 
               FractionBox["1", "4"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
               ","}], 
             RowBox[{"  ", 
               SubsuperscriptBox[
                StyleBox["P", "TI"], 
                SubscriptBox["Cl", 
                 RowBox[{"3", ",", "1"}]], "4"], "\[LongEqual]", 
               FractionBox["1", "4"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
               "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\\m{P}_{\\cl{3}{1}}^1= \
\\frac{1}{4}(1+\\e{1})(1+\\e{24}),&\\quad  \\m{P}_{\\textit{Cl}_{3,1}}^2= \
\\frac{1}{4}(1+\\e{1})(1-\\e{24}),\\\\\n\\m{P}_{\\cl{3}{1}}^3=\n\
\\frac{1}{4}(1-\\e{1})(1+\\e{24}),&\\quad\n\\m{P}_{\\cl{3}{1}}^4= \
\\frac{1}{4}(1-\\e{1})(1-\\e{24}).\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2dba480-5943-4fa8-88c0-f5dc32e5d8d7"],
 "\[LineSeparator]\[LineSeparator]It is easy to check that the idempotents in \
the group sum up to unity,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], "+", 
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], "+", 
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], "+", 
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
         "\[LongEqual]", "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{1}{4} (1-\\e{1})(1-\\e{24})+\\frac{1}{4}\n(1-\\e{1})(1+\\e{24})+\
\\frac{1}{4} (1+\\e{1})(1-\\e{24})+\\frac{1}{4}\n(1+\\e{1})(1+\\e{24})=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4869553-0a63-47a4-be9f-6db5ca74ee41"],
 ", The idempotents are mutually annihilating, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"3", ",", "1"}]], "1"], 
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"3", ",", "1"}]], "2"], "\[LongEqual]", 
         FractionBox["1", "16"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"]}], ")"}], 
         "\[LongEqual]", "0"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{3}{1}}^1\n\\m{P}_{\\cl{3}{1}}^2=\\frac{1}{16}\n\
(1+\\e{1})(1+\\e{24})(1+\\e{1})(1-\\e{24})=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d514925f-4482-4eec-9c7d-94fcc783688c"],
 "."
}], "Subitem",ExpressionUUID->"2c1c6b8e-2f9e-4530-bb36-03a861636536"],

