    RowBox[{
     RowBox[{"MV", "[", "a", "]"}], "\[GeometricProduct]", 
     RowBox[{"MV", "[", "b", "]"}]}], "-", 
    RowBox[{
     RowBox[{"MV", "[", "b", "]"}], "\[GeometricProduct]", 
     RowBox[{"MV", "[", "a", "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.9497410444775887`*^9},
 CellLabel->
  "Out[250]=",ExpressionUUID->"834c8a4f-1b62-47c9-aa21-6af8f5edae59"]
}, Closed]],

