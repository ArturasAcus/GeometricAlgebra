 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"lhs", "[", "testAlgebra", "]"}], "-", 
     RowBox[{"rhs", "[", "testAlgebra", "]"}]}], ")"}], "//", "gaPE"}], "//", 
  "Expand"}]], "Input",
 CellChangeTimes->{{3.9119624848173923`*^9, 3.911962486321778*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"09aeac93-3c36-4756-a8a9-3c80d55276c2"],

