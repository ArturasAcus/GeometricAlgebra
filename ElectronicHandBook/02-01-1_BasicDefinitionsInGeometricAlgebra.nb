Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Compound index (multiindex)",
  FontSlant->"Italic"],
 ".  To have a compact notation one introduces a string of indices denoted  \
by a single capital letter ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["k", "TI"], "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox[
              StyleBox["k", "TI"], 
              StyleBox["r", "TI"]]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "K=\\{k_1,\\dots,k_r\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6643d2fc-2e6d-463e-83d2-d948b7e4f2dd"],
 ", where numerical values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["k", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "k_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b166c4c0-80ce-44bf-87ba-95bee60a5548"],
 " are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "k_j=j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0272b277-fc3d-45cd-99a0-e3cf6c9cea90"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["0", TraditionalForm], "errors" -> {}, "input" -> "0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d520467d-f095-4209-9515-669e2f89b884"],
 ". For example, for grade-",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "6"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=6", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4737cbf-ea6f-4ee7-9c65-122f95be5e5b"],
 " let be ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["k", "TI"], "1"], ",", 
             SubscriptBox[
              StyleBox["k", "TI"], "2"], ",", 
             SubscriptBox[
              StyleBox["k", "TI"], "3"], ",", 
             SubscriptBox[
              StyleBox["k", "TI"], "4"], ",", 
             SubscriptBox[
              StyleBox["k", "TI"], "5"], ",", 
             SubscriptBox[
              StyleBox["k", "TI"], "6"]}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0", ",", "4", ",", "5", ",", "0"}], 
           "}"}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "K=\\{k_1,k_2,k_3,k_4,k_5,k_6\\}=\\{1,2,0,4,5,0\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9fc72658-e6f7-43bf-94fa-978eec7bf8da"],
 ". If elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["k", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k_j=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b9d4dcd-c81a-4d36-8e21-f625377ee9f4"],
 " are deleted one will recover a concrete index, in this case ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{"1", ",", "2", ",", "4", ",", "5"}], "}"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\{1,2,4,5\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69f28ebf-cfcf-44d7-be6b-d60d174adbd3"],
 ". Given a string ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9843c338-2637-41f8-9d39-a2d6d23c388f"],
 ", let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["K", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_K=\\e{K}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0fded87-3f14-4146-a1a2-3a8b5b56b902"],
 " be defined by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          SubscriptBox[
           StyleBox["k", "TI"], "1"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          SubscriptBox[
           StyleBox["k", "TI"], "2"]], "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          SubscriptBox[
           StyleBox["k", "TI"], 
           StyleBox["r", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_K=a_{k_1}\\w a_{k_2}\\dots\\w a_{k_r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b9d42ce-c06c-40ed-ad63-1b96f82d9325"],
 ", and similarly for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["K", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a^K", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db56b13c-6f89-4951-8e14-51f5b2b7ad78"],
 ".  In the case when all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["j", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "j_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fea77c74-f31f-4b6f-9f16-0ca56c031da6"],
 " vanish (empty string) we define ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_K=a^K=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c03b0db-3634-4857-9e8d-8f87d58f794b"]
}], "Item",ExpressionUUID->"b9a16864-f8c3-459f-9d76-24cc96788a10"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_K=a^K=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d4ce9501-ebd9-4f89-8cdf-8941b0403c4c"],
 " iff the string ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4967a635-c277-4f3a-9554-41b906b07d4d"],
 " contains at least one index twice."
}], "Subitem",ExpressionUUID->"190576e3-4d59-4662-909d-ca574221a1f4"],

Cell[TextData[{
 "If multiindices ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea3b905c-670d-47f3-be04-caa2fb049ede"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a43da427-35e9-4237-8616-d29bc0ee7d4a"],
 " contain the same elements but in different order then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          StyleBox["p", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["J", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_K=(-1)^pa_J", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "727d9309-2ab4-428f-9986-183ea9f63ca3"],
 " and similarly for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["K", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a^K", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c3bc7e8-976d-462b-b60a-23d28382960a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a12c643-c4a4-436d-a664-f30a1f0ba09c"],
 " is a number of permutations."
}], "Subitem",ExpressionUUID->"b45c0f2a-1bdc-43b3-bcad-71f3c771358a"],

Cell[TextData[{
 "If we have a frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\e{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89cb1028-1321-4811-83b4-4d32e8143953"],
 " then the set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["J", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\e{J}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "589979f6-d3a1-4d22-acda-a9d0b55a761e"],
 " (or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["J", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\e{}^J\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "741b62ae-8f0a-4883-a8ec-cdb6e1fbccc0"],
 "), where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fba40c3-a8b7-4ea4-bf65-3fa1545c3863"],
 " ranges over all increasing  sequence, generates ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "72f41214-711d-446e-894d-7ee6ce128295"],
 ".  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "334f9cf5-932b-4378-b010-82df4d7e43c3"],
 " is an increasing sequences if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["j", "TI"], "1"], "<", 
         SubscriptBox[
          StyleBox["j", "TI"], "2"], "<", "\[Ellipsis]", "<", 
         SubscriptBox[
          StyleBox["j", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "j_1<j_2<\\dots<j_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82af6f4c-80c0-4106-a84f-4acea82ff4e0"],
 ". "
}], "Subitem",ExpressionUUID->"588657eb-37fb-4839-934b-718c1d638e63"],

Cell[TextData[{
 "The multiindex notation is also convenient in programming when ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{
    "different", " ", "ordering", " ", "of", " ", "basis", " ", "elements"}],
    BaseStyle->"Hyperlink",
    ButtonData->"OrderingMain"], TraditionalForm]],ExpressionUUID->
  "b2eca45b-e8df-443f-aebb-9f5606a82484"],
 " is required."
}], "Text",ExpressionUUID->"e178939a-2034-4ecf-9a1d-1e48c5f7cffc"],

Cell[TextData[{
 StyleBox["Multiindexed form of MV",
  FontSlant->"Italic"],
 ". In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e46e389f-33e0-4779-9d8f-cbe7d53d6eb2"],
 " the MV in the multiindex form can be written as \[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               StyleBox["A", "TI"], "\[LongEqual]", 
               UnderscriptBox["\[Sum]", 
                StyleBox["K", "TI"], LimitsPositioning -> True], 
               SubscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["K", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["K", "TI"]], "\[LongEqual] "}], 
             RowBox[{
               UnderscriptBox[
                UnderscriptBox[
                 SubscriptBox[
                  StyleBox["a", "TI"], "0"], "\[UnderBrace]", 
                 LimitsPositioning -> False], "scalar", LimitsPositioning -> 
                False], "+", 
               UnderscriptBox[
                UnderscriptBox[
                 RowBox[{
                   SubscriptBox[
                    StyleBox["a", "TI"], "1"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
                   SubscriptBox[
                    StyleBox["a", "TI"], "2"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
                   SubscriptBox[
                    StyleBox["a", "TI"], "3"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "3"]}], 
                 "\[UnderBrace]", LimitsPositioning -> False], "vector", 
                LimitsPositioning -> False], "+"}], 
             RowBox[{
               UnderscriptBox[
                UnderscriptBox[
                 RowBox[{
                   SubscriptBox[
                    StyleBox["a", "TI"], "12"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
                   SubscriptBox[
                    StyleBox["a", "TI"], "23"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "23"]}], 
                 "\[UnderBrace]", LimitsPositioning -> False], "bivector", 
                LimitsPositioning -> False], "+", 
               UnderscriptBox[
                UnderscriptBox[
                 RowBox[{
                   SubscriptBox[
                    StyleBox["a", "TI"], "123"], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "123"]}], 
                 "\[UnderBrace]", LimitsPositioning -> False], "trivector", 
                LimitsPositioning -> False], " ", ","}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\
\\m{A}=\\sum_Ka_K\\e{K}=\\,&\\underbrace{a_0}_{\\text{scalar}}+\\underbrace{a_\
1\\e{1}+a_2\\e{2}+a_3\\e{3}}_{\\text{vector}}+\n\
&\\underbrace{a_{12}\\e{12}+a_{23}\\e{23}}_{\\text{bivector}}+\n\
\\underbrace{a_{123}\\e{123}}_{\\text{trivector}}\\, ,\\\\\n\\end{split}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "56b9a3e8-9db4-4a73-a063-fc507a99cbc7"],
 "\[LineSeparator]\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["K", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           
           RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "12", ",", "0", 
             ",", "23", ",", "123"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "K=\\{0,1,2,3,12,0,23,123\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3bb9c159-4671-4252-abae-39c330e0b705"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a_K\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7dead18-9e6f-406f-a3ad-01ec7adb46e5"],
 "\[DoubleStruckCapitalR]."
}], "Subitem",ExpressionUUID->"1547eae5-233e-4d93-be41-24e78b27eb9a"],

Cell[TextData[{
 StyleBox["Multiindex delta",
  FontSlant->"Italic"],
 ". In the expression\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["K", "TI"]], "*", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["J", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["J", "TI"], 
          StyleBox["K", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^K*a_J=\\delta^K_J ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87409883-6d06-4803-9f6a-0209bae51b05"],
 " \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Delta]", 
        StyleBox["J", "TI"], 
        StyleBox["K", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta^K_J", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "df8ce207-a4b5-457b-8e3f-e4b1fe52b488"],
 " is zero if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4413c6f2-ab02-4713-818c-11e1bf7f580d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cad2c317-c3da-4786-a5e9-10489a04c952"],
 " have different lengths, or either ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "642582f1-6ded-4fa0-8875-ac1f719b8eab"],
 " or ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5acc3df-bfd0-44b6-b7db-410151854976"],
 " repeats the indices. Also ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Delta]", 
        StyleBox["J", "TI"], 
        StyleBox["K", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta^K_J ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b0118570-a6ea-4940-b0cf-59edb5455dd1"],
 " vanishes if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "25dfa37c-8c1e-4fdf-b8f6-a5cb2d5d733a"],
 " is not the permutation of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c3d8572-8d6f-4f09-84f6-9854dddb47ba"],
 ", otherwise it equals the sign of the permutation that takes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["J", "TI"], TraditionalForm], "errors" -> {}, "input" -> "J", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83e0ab3d-46ae-49be-bd33-e98be928ea1b"],
 " to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["K", "TI"], TraditionalForm], "errors" -> {}, "input" -> "K", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27021432-412b-425f-882c-20a6f64d893e"],
 "."
}], "Subitem",ExpressionUUID->"4a7ebd96-1f09-448f-b486-1191a7866658"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Multiindices for averaging",
  FontSlant->"Italic"],
 ". Let\[CloseCurlyQuote]s decipher the meaning of a multiindex in expression \
 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["A", "TI"], ":", 
            StyleBox["A", "TI"], "\[LongEqual]", 
            SubscriptBox[
             RowBox[{"\[LeftAngleBracket]", 
               StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"]}], 
          LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["A", "TI"], "-1"], 
         StyleBox["U", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["A", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{A:\\m{A}=\\grade{\\m{A}}{2}}\\e{A}^{-1}\\m{U}\\e{A}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d69b368-1342-4212-a116-4c5c3b327e57"],
 " . The condition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], ":", 
         StyleBox["A", "TI"], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "A:\\m{A}=\\grade{\\m{A}}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1aeffa58-6173-44ed-afd0-95e5a5624387"],
 " suggests to take all grade-2 MVs, i.e. the multiindex ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "824a15e3-e859-4b9d-a91a-bbcde6968648"],
 " should run over all basis bivectors. For\nexample, if we take ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "011b9c74-67e1-497c-99fe-1c46f7f13dfd"],
 " algebra, then the multiindex ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> "A", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8add2686-2d17-4292-8637-655579454381"],
 " takes the values from the list ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           RowBox[{"(", 
             RowBox[{"1", ",", "2"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"1", ",", "3"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"1", ",", "4"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"1", ",", "5"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"2", ",", "3"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"2", ",", "4"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"2", ",", "5"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"3", ",", "4"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"3", ",", "5"}], ")"}], ",", 
           RowBox[{"(", 
             RowBox[{"4", ",", "5"}], ")"}]}], "}"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\{(1,2),(1,3),(1,4),(1,5),(2,3),(2,4),(2,5),(3,4),(3,5),(4,5)\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8a84add-8bef-4771-a81e-cb89ba94ffdd"],
 ". The basis element ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["A", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af9adef9-3f1e-4881-ad66-e15a3b745576"],
 " then is understood as the list ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["A", "TI"]], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "12"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "13"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "14"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "15"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "23"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "24"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "25"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "34"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "35"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "45"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{A}=\\{\\e{1 2},\\e{1 3},\\e{1 4},\\e{1 5},\\e{2 3},\\e{2 \
4},\\e{25},\\e{3 4},\\e{3 5},\\e{4 5}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c197e0de-db45-4b10-a380-8393b55b39e3"],
 ". The inverse multiindex bivector then becomes ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["A", "TI"], "-1"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "12"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "13"], ",", 
