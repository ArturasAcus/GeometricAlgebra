Cell[CellGroupData[{

Cell["Idempotents and left ideals", "Section",
 CounterAssignments->{{"Section", 0}, {"Subsubsection", 0}, {"Item", 44}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 0}, {
   "SubitemNumbered", 0}, {
