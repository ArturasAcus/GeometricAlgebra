Cell["\<\
Other grades can be checked in the same way once ensured that maximal grade \
don\[CloseCurlyQuote]t exceed dimension of vector space. \
\>", "Text",ExpressionUUID->"94742d30-baf4-4879-85e4-52c0338e32b9"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t ",
 StyleBox["Scalar product of multivectors",
  FontSlant->"Italic"],
 ".  It is denoted by asterisk and formally is defined as a scalar part of a \
sum over decomposed grades\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "*", 
         StyleBox["B", "TI"], "\[LongEqual]", 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             StyleBox["A", "TI"], 
             StyleBox["B", "TI"]}], "\[RightAngleBracket]"}], ":", 
         "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], ",", 
            StyleBox["s", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}*\\m{B}=\\langle \
\\m{A}\\m{B}\\rangle:=\\sum_{r,s}\\langle\\langle\n\\m{A}\\rangle_r\\langle \
\\m{B}\\rangle_s\\rangle_{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c88cf3a-e13f-4b17-bb0e-ec8255964ba8"],
 ".\n\nSince this product always returns a scalar,  as in the case of \
traditional vector algebra, it is called the scalar product. If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\m{A}\\rangle_r=a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28651e23-a50d-4d1f-b402-d2401dd3ed63"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["s", "TI"]], "\[LongEqual]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\m{B}\\rangle_s=b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7862e4b-1edf-4796-8e06-bbe529b48f5f"],
 " are vectors then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "*", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              StyleBox["a", "TI"], 
              StyleBox["b", "TI"]}], "\[RightAngleBracket]"}], "0"], 
         "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a*b=\\langle ab\\rangle_0=a\\cdot b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8683812f-be90-4eae-951c-6774564389df"],
 "."
}], "Item",
 CellChangeTimes->{
  3.9102349636172113`*^9, {3.910236138403373*^9, 3.910236427351281*^9}, {
   3.910239042527935*^9, 3.910239147663459*^9}},
 CellTags->
  "HestenesProduct",ExpressionUUID->"7a15666c-96e2-48ba-a920-25be0613a42e"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"9cd52ad7-49a1-4106-a030-730164a9861e"],

Cell["\<\
We don\[CloseCurlyQuote]t introduce special command for this operation, since \
the middle formula says that the product is simply a geometric product, from \
which we have to take only a scalar part. \
\>", "Text",ExpressionUUID->"6a0e2b65-5b30-4fce-b915-92af62e3ec30"],

