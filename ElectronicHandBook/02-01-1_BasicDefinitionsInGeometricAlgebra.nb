Cell["Make the above table. ", "Text",ExpressionUUID->"dbbf5042-07ac-40ec-b65e-eac0aad52413"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"FactorTerms", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Identity", "[", "#", "]"}], "/", "#"}], ")"}], "]"}], 
         "]"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"gaGetMV", "[", 
          RowBox[{"generalMV", ",", 
           RowBox[{"{", "theGrade", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"theGrade", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"FactorTerms", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gaReverse", "[", "#", "]"}], "/", "#"}], ")"}], "]"}], 
         "]"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"gaGetMV", "[", 
          RowBox[{"generalMV", ",", 
           RowBox[{"{", "theGrade", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"theGrade", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"FactorTerms", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gaGradeInverse", "[", "#", "]"}], "/", "#"}], ")"}], 
          "]"}], "]"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"gaGetMV", "[", 
          RowBox[{"generalMV", ",", 
           RowBox[{"{", "theGrade", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"theGrade", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Simplify", "[", 
         RowBox[{"FactorTerms", "[", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"gaCliffordConjugate", "[", "#", "]"}], "/", "#"}], ")"}],
           "]"}], "]"}], "&"}], "/@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"gaGetMV", "[", 
          RowBox[{"generalMV", ",", 
           RowBox[{"{", "theGrade", "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"theGrade", ",", "0", ",", "7"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "}"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "->", "\"\<+\>\""}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "->", "\"\<-\>\""}]}], "}"}]}], ",", 
   RowBox[{"TableHeadings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\"\<id\>\"", ",", "\"\<reverse\>\"", ",", "\"\<grade inverse\>\"", 
        ",", "\"\<Clifford conjugate\>\""}], "}"}], ",", 
      RowBox[{"Table", "[", 
       RowBox[{"theGrade", ",", 
        RowBox[{"{", 
         RowBox[{"theGrade", ",", "0", ",", "7"}], "}"}]}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"5352057b-70a6-40ff-80bc-c745f17a0741"],

