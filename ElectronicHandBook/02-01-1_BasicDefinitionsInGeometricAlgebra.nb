Cell[TextData[{
 "Whereas the summation formula  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{
             StyleBox["A", "TI"], 
             StyleBox["B", "TI"]}], "\[RightAngleBracket]"}], ":", 
         "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], ",", 
            StyleBox["s", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\m{A}\\m{B}\\rangle:=\\sum_{r,s}\\langle\\langle\n\
\\m{A}\\rangle_r\\langle \\m{B}\\rangle_s\\rangle_{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "835e8a5c-512e-499a-a2c5-5ee9a7535a17"],
 " can be checked in a similar way as for inner product:"
}], "Text",ExpressionUUID->"1ab1f9c6-b997-4446-8aff-adc4efa07463"],

