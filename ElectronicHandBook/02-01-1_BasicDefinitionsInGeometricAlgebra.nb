  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f40671ed-4c76-4759-82c7-383533d606d3"],
 "  in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "60a6162a-1ee1-4bda-a79d-505ba0ff4f6b"],
 " is produced by two factors: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], "1"]]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], "2"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P=\\frac{1}{2}(1+\\e{T_1})\\frac{1}{2}(1+\\e{T_2})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26b556d4-75cb-4b7d-8d4e-52fa0e0e0c62"],
 ". Thus, we can choose pairs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
