Cell[TextData[{
 "The  diagonal inner product table means that basis is orthogonal. Units on \
the diagonal means it is normalized. Sign of the  basis vector on the \
diagonal represents it\[CloseCurlyQuote]s signature. Therefore, the first \
vector has positive signature (vector numeration starts from 1 and goes till \
value provide by ",
 StyleBox["gaDimensionOfVectorSpace[the algebra]",
  FontWeight->"Bold"],
 "  )"
}], "Text",ExpressionUUID->"34f64ed5-df62-40e0-92d2-dd6062e37d97"],

