Cell[TextData[{
 "To check that we  indeed produced reciprocal frame we check the defining \
relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], "\[Prime]"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"\[Prime]", 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i^\\prime\\cdot e^{\\prime j}=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd780d77-b0af-4aca-98a7-8e7357ea4648"],
 " for new nonorthonormal basis"
}], "Text",ExpressionUUID->"9f4214e7-e04c-4111-b13b-c30377a7e0cb"],

