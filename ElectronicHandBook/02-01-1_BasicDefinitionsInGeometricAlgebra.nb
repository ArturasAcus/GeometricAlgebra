 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"8acfd41d-53de-408d-a549-1ebbc70ce514"],

Cell[CellGroupData[{

Cell["\<\
Define short notations for general multivectors. Since name C in Mathematica \
is reserved for free constants, we will use a letter F instead.\
\>", "Text",ExpressionUUID->"fd6fb667-99a8-429b-a1aa-41ac3c014230"],

