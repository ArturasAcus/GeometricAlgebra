&\\reverse{T}=\\gamma\\e{3}\\e{2}\\e{1}=-\\gamma\\e{1}\\e{2}\\e{3}=-T,\\\\\n\
&(\\reverse{T+a\\cB})=\\reverse{T}+\\reverse{\\cB}\\reverse{a}= -T-\\cB a\n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
