  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["div", FontSlant -> "Plain"], 
         StyleBox["f", "TI"], "\[LongEqual]", 
         OverscriptBox["\[Del]", "."], "\[CenterDot]", 
         OverscriptBox[
          StyleBox["f", "TI"], "."], "\[LongEqual]", 
         FractionBox[
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["f", "TI"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"\[PartialD]", 
            SubscriptBox[
             StyleBox["x", "TI"], 
             StyleBox["i", "TI"]]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{div}\\m{f}=\\dot{\\nabla}\\d\\m{\\dot{f}}=\\frac{\\partial \
