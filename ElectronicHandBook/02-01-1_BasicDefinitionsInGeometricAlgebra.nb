Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Table of primitive idempotents in real ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{p}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "f94f902e-1273-4e56-9ded-9baa191e22a5"],
 StyleBox[" algebras.",
  FontSlant->"Italic"],
 " A system of commuting blades which square to unity allows a direct \
construction of GA primitive idempotents. Explicit representatives\n  of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{p}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7833d22e-7f4d-48c0-8e59-2733143bc1ea"],
 " blades sorted in inverse degree ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"lexicographic", " ", "order"}],
    BaseStyle->"Hyperlink",
    ButtonData->"OrderingMain"], TraditionalForm]],ExpressionUUID->
  "eeafba42-ece1-48ec-b464-4949a63e44ec"],
 " are summarized in the table for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], ",", 
         StyleBox["q", "TI"], "\[LessEqual]", "9"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p,q\\le 9", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5aa64ae1-47b8-4663-b5db-8fe734430960"],
 ". For convenience, the basis vectors that require  more than two-digit \
indices are separated by a small spacing. The blades in the table are not \
unique. The number of them, however, always remains the same, ensuring that \
the primitive idempotent in the table contains exactly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["q", "TI"], "-", 
           SubscriptBox[
            StyleBox["r", "TI"], 
            RowBox[{
              StyleBox["q", "TI"], "-", 
              StyleBox["p", "TI"]}]]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(q-r_{q-p})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e08d2174-fc36-49ed-a4ef-7b126140aace"],
