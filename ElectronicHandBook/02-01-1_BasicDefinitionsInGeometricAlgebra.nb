 RowBox[{"allPartitionsOfFour", "=", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"gaSort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
