Cell[TextData[{
 "First, write down every step of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["det", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], ",", 
             StyleBox["b", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             Cell[
              BoxData[
               FormBox[
                GridBox[{{
                   SubscriptBox[
                    StyleBox["a", "TI"], "1"], 
                   SubscriptBox[
                    StyleBox["b", "TI"], "1"]}, {
                   SubscriptBox[
                    StyleBox["a", "TI"], "2"], 
                   SubscriptBox[
                    StyleBox["b", "TI"], "2"]}}, 
                 GridBoxAlignment -> {
                  "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
                 GridBoxSpacings -> {"Columns" -> {
                    Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                    Offset[0.27999999999999997`]}, "Rows" -> {
                    Offset[0.2], {
                    Offset[0.4]}, 
                    Offset[0.2]}}], TraditionalForm]]]}]}, "Abs"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "a\\wedge b=\\mathrm{det}(a,b)\\mathrm{e}_{12}=\\begin{vmatrix}\n \
a_1&b_1\\\\\n a_2&b_2\\\\\n\\end{vmatrix}\\mathrm{e}_{12}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9a2bfd7b-a02f-4fc2-8b06-bf8400cc9e54"],
 ". "
}], "Text",ExpressionUUID->"eaa5af00-27c2-4e06-902e-d1978cbe876f"],

