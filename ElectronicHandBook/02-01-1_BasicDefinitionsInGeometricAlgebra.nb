Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Non-degenerate and degenerate GAs",
  FontSlant->"Italic"],
 ".   In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{p,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "90b93ac8-feff-458e-b8aa-c57b29d5a314"],
 ", subscripts  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "732979cd-c793-4d33-bc34-e30cb9219fa6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["q", "TI"], TraditionalForm], "errors" -> {}, "input" -> "q", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7bb32b7c-3d4a-46cf-8809-7ee669c9f2f2"],
 " indicate the signature of  GA: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "+1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=+1", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a819f8a8-ff69-4052-b781-3590572c85da"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\dots,p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f23dea99-0e9e-47fb-8a00-f2480a236182"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "-1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=-1", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba88af54-8c86-49ba-a5be-3e5f6c11e01a"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\dots,q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1fced3a-8c6e-47ee-852c-e2aad95a503d"],
 ".  If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3950f80-198d-40d8-8ad4-f495ccc7e022"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\dots,r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dcac252-eac3-4960-857b-f8ed781ba251"],
 " then the algebra is degenerate and denoted  by three indices, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"], ",", 
          StyleBox["r", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{p,q,r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "24ade2ee-1164-44c3-b3d1-7ba6380a2e58"],
 ". The dimension of real vector space then is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"], "+", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=p+q+r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5d2b7d35-a990-4cf7-a047-a289147c638a"],
 ". The pseudoscalar factors into product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["p", "TI"]], 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["q", "TI"]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "A_pB_qC_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a2dcb42-c431-4bc4-95fa-861328cbcee8"],
 ", where the individual factors are pseudoscalars in subspaces with the \
positive, negative and zero signatures. The algebra is non-degenerate if MV \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["p", "TI"]], 
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["q", "TI"]], 
         SubscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "A_pB_qC_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "708a4bee-ffc3-4fea-8d5e-995e049ea70c"],
 " is invertible and this is possible only if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc7d6141-fa2b-4f1e-bc4b-30883d97498f"],
 ".  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Cl", 
          RowBox[{
            StyleBox["p", "TI"], ",", 
            StyleBox["q", "TI"]}]], "\[Congruent]", 
         SubscriptBox["Cl", 
          RowBox[{
            StyleBox["p", "TI"], ",", 
            StyleBox["q", "TI"], ",", "0"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{p,q}\\equiv\\textrm{Cl}_{p,q,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a996d7d-f38b-47cb-91a7-bbe5f4129366"],
 ". The Handbook mainly is concerned with the non-degenerate real GAs only.  ",
 StyleBox["This is because (see Pierre Renaud ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  ButtonBox[
   StyleBox["\<\"Clifford algebras: lecture notes on applications in physics

\"\>", "Author",
    StripOnInput->False,
    FontColor->RGBColor[0, 0, 1]],
   Appearance->"Frameless",
   ButtonFunction:>SystemOpen[
     FileNameJoin[{
       NotebookDirectory[
        EvaluationNotebook[]], "BibliographySources", "Books", 
       "Renaud_TheCliffordalgebrabook2020.pdf"}]],
   Evaluator->Automatic,
   Method->"Preemptive"]], "Output",
  CellChangeTimes->{
   3.915599987739281*^9, {3.915600149387107*^9, 3.915600182460762*^9}, 
    3.915600221200951*^9, {3.915600280754741*^9, 3.915600286154346*^9}},
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "2e44d0e5-125a-42b9-b588-fe9ac1a847d2"],
 StyleBox[" , p. 1) for complex Clifford algebras signature is not important \
(all complex Clifford algebras of same dimension are equivalent), whereas \
signature plays an important  role in real Clifford algebras as well as  in \
physics. ",
  Background->RGBColor[0.87, 0.94, 1]],
 "For algebras with  signature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], ">", "0", ",", 
         StyleBox["q", "TI"], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "p>0, q>0 ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e75ba7e9-d2d2-416c-b83f-d46fa5af13bc"],
 "one can always construct ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "-", "|", 
         StyleBox["p", "TI"], "-", 
         StyleBox["q", "TI"], "|"}], TraditionalForm], "errors" -> {}, 
     "input" -> "n-|p-q|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1892068f-5af7-46c0-ab59-9a5fab737791"],
 " basis vectors which square to zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["r", "TI"], "2"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{r}^2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "efc8c8c4-7669-4848-8d38-2a1399093d9f"],
 " simply by taking linear combinations ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1", "\[Prime]"], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["q", "TI"]], ",", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2", "\[Prime]"], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["q", "TI"]], ",", "\[Ellipsis]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{1}^\\prime=\\mathrm{e}_{1}+\\mathrm{e}_{q}, \
\\mathrm{e}_{2}^\\prime =\\mathrm{e}_{1}-\\mathrm{e}_{q}, \\ldots", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8dc89802-83d3-4d75-aeac-569ccec34b60"],
 ".  In the case ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "\[LongEqual]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p=q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e01d5c25-4325-490a-9263-30a1d106e5c9"],
 " the entire basis can be constructed in this way, and is  called the Witt \
basis. Degenerate GA finds application in graphics (PGA=projective geometric \
algebra). "
}], "Item",
 CellChangeTimes->{{3.911964006052034*^9, 3.911964028348646*^9}, {
   3.921558662590825*^9, 3.921558699752733*^9}, {3.921565531839471*^9, 
