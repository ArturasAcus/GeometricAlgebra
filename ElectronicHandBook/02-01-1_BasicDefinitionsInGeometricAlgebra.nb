    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06dd786c-5725-4494-aff9-61fdb9d3a50b"],
 " are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["a", "TI"], "1"], 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "123"], ",", 
           SubscriptBox[
            StyleBox["a", "TI"], "1"], 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "123"], "+", 
           SubscriptBox[
            StyleBox["a", "TI"], "2"], 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "235"], ",", 
