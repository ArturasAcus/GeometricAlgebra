         Offset[0.4]}, 
        Offset[0.2]}}],
   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{
      "\!\(\*TemplateBox[<|\"boxes\" -> \
FormBox[SuperscriptBox[StyleBox[\"e\", \"TI\"], RowBox[{\"\[Prime]\", \
\"1\"}]], TraditionalForm], \"errors\" -> {}, \"input\" -> \"e^{\\\\prime \
1}\", \"state\" -> \"Boxes\"|>,\"TeXAssistantTemplate\"]\)", 
