Cell[TextData[{
 "7-th formula, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[Wedge]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}], "/", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", 
             StyleBox["r", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "A_r= \\mathrm{e}_{i}( \\mathrm{e}_{}^i\\w A_r)/(n-r)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec8b6288-55a6-4fe2-9b30-9fb6fd836343"]
}], "Text",ExpressionUUID->"b30d87bb-f624-436c-b89a-cde952098760"],

