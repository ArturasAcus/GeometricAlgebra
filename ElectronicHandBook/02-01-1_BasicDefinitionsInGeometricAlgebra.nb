Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"mDim", "-", "1"}], ")"}]}]}], ")"}], "*", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"gaBinomialConjugate", "[", 
        RowBox[{"generalMVu", ",", "inv"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"inv", ",", 
         RowBox[{"Take", "[", 
          RowBox[{"allPartitionsOfFour", ",", 
           RowBox[{"{", 
