Cell[CellGroupData[{

Cell["Inner product", "Section",
 CellChangeTimes->{{3.910234655280381*^9, 3.910234662007681*^9}},
 CounterAssignments->{{"Section", 0}, {"Subsubsection", 0}, {"Item", 7}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 0}, {
   "SubitemNumbered", 0}, {
   "SubsubitemNumbered", 
    0}},ExpressionUUID->"bdc496de-c44e-4075-90f3-2a075432a7e4"],

Cell[TextData[{
 "In GA there are few variations of this product under the names dot product \
(aka Hestenes inner product), left and right product (contraction), and fat \
dot product (aka ",
 StyleBox["Dorst",
  IgnoreSpellCheck->True],
 " inner product, or  fat dot). The inner product lowers the dimension of the \
graded subspace."
}], "Text",
 CellTags->
  "VectorsAndBivectors",ExpressionUUID->"ebd9438f-2526-481b-832a-\
98627de3b1fc"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t  H",
 StyleBox["estenes inner product",
  FontSlant->"Italic"],
 ". Throughout the Handbook, mainly  the dot product introduced by D. \
Hestenes will be used, which can be defined by axioms:"
}], "Item",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"f11be778-2ea9-49f3-ae1f-d81c351fe13d"],

Cell[TextData[{
 " IP1.  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["b", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\cdot b=b\\cdot a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa692002-67e4-4ab1-b7d5-409c2194f501"],
 " ",
 StyleBox["\t(symmetry)", "Subitem"]
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.910231842839506*^9, 3.910231863838695*^9}, {
  3.910235048171838*^9, 
  3.910235077838544*^9}},ExpressionUUID->"1be9832b-d61d-4a70-beb4-\
8034f9299cbf"],

Cell[TextData[{
 " IP2.  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"\[Alpha]", 
             StyleBox["a", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", "\[Alpha]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["b", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(\\alpha a)\\cdot b=\\alpha(a\\cdot b)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "507e963e-aee6-49bb-bc9d-35f73176adb7"],
 " \t",
 StyleBox[" ", "Subitem"],
 "(scalar can be factored out)"
}], "Subitem",
 CellGroupingRules->{
  "GroupTogetherGrouping", 
   10000.},ExpressionUUID->"667a337f-6bb2-440a-ac20-38db13fbc656"],

Cell[TextData[{
 " IP3.  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "+", 
             StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["c", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "+", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(a+b)\\cdot c=a\\cdot b+a\\cdot c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ad3e3fd-adcf-46ab-9781-3ead5b729315"],
 " \t",
 StyleBox[" (distributivity over addition)", "Subitem"]
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.910231842841021*^9, 3.910231863840103*^9}, {
   3.910235125515904*^9, 3.910235128948124*^9}, 
   3.910235219627976*^9},ExpressionUUID->"bbf578e2-eba5-4140-887d-\
333ec63e0cac"],

Cell[TextData[{
 " IP4.  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"], "\[Congruent]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot a\\equiv a^2 \\ne 0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61adbbc4-baf4-4804-a909-605e4239d411"],
 " \t",
 StyleBox[" (sign of ", "Subitem"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "a^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "db8bf456-d45b-4803-8976-143323635f25"],
 StyleBox[" depends on vector space metric)", "Subitem"]
}], "Subitem",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{{3.910231842842245*^9, 3.910231863840797*^9}, {
  3.910235130038937*^9, 3.910235132836776*^9}, {3.910235265493805*^9, 
  3.91023528567647*^9}},ExpressionUUID->"6277661f-be61-45bc-ac7c-\
96832a4e7057"],

Cell[TextData[{
 "Formally the inner product of two multivectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["r", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}=\\sum_r\\langle\\m{A}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28fce35a-04d0-463b-87e9-f0725b8a855b"],
 " and   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          StyleBox["s", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}=\\sum_s\\langle\\m{B}\\rangle_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6941112a-047e-42a4-b1f0-d6d0ce0f63ab"],
 " can be expresses as a sum over all possible differences of their grades\n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[CenterDot]", 
         StyleBox["B", "TI"], ":", "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[NotEqual]", "0", ",", 
            StyleBox["s", "TI"], "\[NotEqual]", "0"}], LimitsPositioning -> 
          True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
          RowBox[{
            StyleBox["abs", FontSlant -> "Plain"], "(", 
            RowBox[{
              StyleBox["s", "TI"], "-", 
              StyleBox["r", "TI"]}], ")"}]], "  ", 
         "(Hestenes) inner product"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\m{A}\\cdot \\m{B}:=\\sum_{r\\ne 0,s\\ne 0}\\langle\\langle\n\
\\m{A}\\rangle_r\\langle\n\
\\m{B}\\rangle_s\\rangle_{\\mathrm{abs}({s-r})}\\quad\\text{(Hestenes) inner \
product}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "744d8631-b6d0-4bb2-bcef-7deda8c263fc"],
 "\nNote that grade-0 elements (scalars) are excluded from this sum since the \
dot product with scalars is treated differently (see contraction operation). \
The dot product is not associative, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["B", "TI"], "\[NotEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[CenterDot]", 
             StyleBox["B", "TI"]}], ")"}], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "0=(a\\cdot b)\\cdot \\mathcal{B}\\ne a\\cdot (b\\cdot\\mathcal{B})\\neq \
0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "671db0ab-68d2-48ef-97b8-800f1578c524"],
 ", for the general vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a,b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb8c1570-8655-4d92-bbe0-31001a15064d"],
 " and bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[Congruent]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathcal{B}\\equiv", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5907af6-bf76-4b90-a077-698a55965477"],
 "\[ScriptCapitalB] (",
 StyleBox["mathcal font not displays properly in ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "e88b0add-aad4-4f43-86b4-08e06a3bb77a"],
 StyleBox[" input",
  FontColor->RGBColor[1, 0, 0]],
 ")."
}], "Text",
