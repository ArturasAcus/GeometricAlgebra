Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of orthonormalized reciprocal basis",
  FontSlant->"Italic"],
 ".  The [",
 StyleBox["Atidziai patikrinti ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "0601b4bc-ef38-4aee-aa07-76d1b4571875"],
 StyleBox[" faila ar visur teisingai naudojama vidine sandauga: daug kur gali \
ki buti ten pakeista geometrine sandauga, kas yra klaida",
  FontColor->RGBColor[1, 0, 0]],
 "] orthonormalized basis is always preferable. A general principle of \
orthogonal design claims that computation errors are minimized if data \
representation is made as orthogonal as possible. In an orthonormal frame the \
reciprocal basis vector may differ only by sign ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PlusMinus]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}=\\pm\\mathrm{e}_{}^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "292f9af2-5894-4a66-8fce-1b972c5b1e04"],
 ". Plus sign is for the basis vectors of positive signature, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "+1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=+1", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39a30748-08a7-4580-bb1c-be5b15467b85"],
 ", and minus sign, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "-1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=-1", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e8d00381-e267-4516-b870-e92ed82995cd"],
 ", in case of negative signature.",
 StyleBox[" ",
  FontColor->RGBColor[1, 0, 0]],
 "The orthogonal reciprocal basis satisfies, "
}], "Item",ExpressionUUID->"2d1abc13-628a-4786-bf19-b7c6594078d7"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Wedge]", 
         "\[CenterEllipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]], ",  "}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "E_n=\\mathrm{e}_{1}\\wedge \\mathrm{e}_{2}\\wedge\\cdots\\wedge \
\\mathrm{e}_{n},\\quad", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5da5c6ef-6096-448f-9d46-870ecf1e33cd"],
 "\t(orthonormal frame in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "c2b395b2-3239-4055-9d07-8d62231e1a42"],
 ")"
}], "Subitem",ExpressionUUID->"d5b48543-24d3-4d26-bd2c-4044ab16453a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          RowBox[{
            StyleBox["j", "TI"], "-", "1"}]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Wedge]", 
         "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", FontSlant -> "Plain"], "\:030c"], 
          StyleBox["j", "TI"]], "\[Wedge]", "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["n", "TI"]], 
         SubsuperscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"], "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{e}_{}^j=(-1)^{j-1}\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}\\wedge\
\\dots\\wedge\\check{\\mathrm{e}_{}}_j\\wedge\\dots\\wedge\\mathrm{e}_{n}E_n^{\
-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a489cad8-3ffd-412c-bf4e-8aa6461a614f"],
 ",\t\t(reciprocal basis)"
}], "Subitem",ExpressionUUID->"9eee2e6f-1668-4ab8-a039-d18910bc4ad5"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]], ",  ", 
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"], "\[LongEqual]", "1", "\[Ellipsis]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot \\mathrm{e}_{}^j=\\delta_i^j,\\quad i,j=1\\dots \
n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9372c30-5382-471d-95f5-9b0ff170edc3"],
 ", \t(orthonormality)"
}], "Subitem",ExpressionUUID->"5a5c6a4c-f750-4707-84a0-f6aca6575968"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot \\mathrm{e}_{}^i=\\mathrm{e}_{}^i\\cdot \
\\mathrm{e}_{i}=\\mathrm{e}_{}^i\\mathrm{e}_{i}=n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7da7a842-687f-4a6d-91c5-aad802ecb1c4"],
 " , \t(summation over repeated indices)"
}], "Subitem",ExpressionUUID->"3d0d1a51-d7d4-4af5-820c-426b557f8880"],

Cell[TextData[{
 "It is clear that in this case the frame  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[Congruent]", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "E_n\\equiv I_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9148c743-ec4f-4bc3-aa32-14c075dd7824"],
 ". The checked term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        OverscriptBox[
         StyleBox["e", FontSlant -> "Plain"], "\:030c"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\check{\\mathrm{e}_{}}_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "709d492c-49d3-46f2-ba23-3d46869e207b"],
 " in the definition of reciprocal basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b61f6a6-8749-4a13-9ba3-32e8743218fe"],
 " indicates that this this term is missing in the product. The standard ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd5ba3c0-3ca6-4835-85af-d12ab4407fc1"],
 " and  constructed reciprocal vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d21e906a-5dd2-4c9d-a5fe-16698f7853e2"],
 " are perpendicular to all remaining vectors, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{}^j=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "116e7592-e711-4ec7-af2a-d11245717df2"],
 ". When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "79436a98-6996-4553-95fa-a881702528c4"],
 " the normalization can be fixed in a standard way by requirement ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{}^i=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95e794f6-afef-4981-8297-056f1cc75e47"],
 " (no summation). The squares and products of basis vectors satisfy (no \
summation),\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[Congruent]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PlusMinus]", "1", ",  ", 
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]], ")"}], "2"], "\[Congruent]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PlusMinus]", "1", ",  ", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}^2\\equiv\\mathrm{e}_{i}\\mathrm{e}_{i}=\\pm 1,\\quad\n  \
  (\\mathrm{e}_{}^i)^2\\equiv\\mathrm{e}_{}^i\\mathrm{e}_{}^i=\\pm 1,\\quad \
\\mathrm{e}_{}^i\\mathrm{e}_{i}=\\mathrm{e}_{i}\\mathrm{e}_{}^i=1,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a0dbc28-082d-49c5-90be-0b9036f553f2"],
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], ",  ", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], ",  ", 
         StyleBox["i", "TI"], "\[NotEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\mathrm{e}_{j}=-\\mathrm{e}_{j}\\mathrm{e}_{i},\\quad \
\\mathrm{e}_{}^i\\mathrm{e}_{}^j=-\\mathrm{e}_{}^j\\mathrm{e}_{}^i,\\quad\n\
i\\ne j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0203e13e-6430-4fbb-b215-1afcd3b5163e"],
 ".\[LineSeparator]\nThe last properties may be combined into expressions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], ",    ", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]], "+", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]], 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\frac12(\\mathrm{e}_{i}\\mathrm{e}_{j}+\\mathrm{e}_{j}\\mathrm{e}_{i})=\
g_{ij},\\qquad \
\\frac12(\\mathrm{e}_{}^i\\mathrm{e}_{}^j+\\mathrm{e}_{}^j\\mathrm{e}_{}^i)=g^\
{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fa94ba2-7ad4-40c0-a3bf-25509d1c8649"],
 ",  where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[PlusMinus]\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij}=\\pm\\delta_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f39c529a-f0ac-4e2b-8e88-04d6c116b910"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g^{ij}=g_{ij}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ccc29b4-6896-4e34-8c25-102b360ffc93"],
 " are the elements of the metric matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["g", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f1577ffb-deee-4daa-b709-540c419ba766"],
 ". The number of basis elements with positive sign of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bce031a3-762d-49bb-8a66-db23533c7028"],
 " is denoted by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2017ae0-2d5d-4304-972d-3dd459ee4988"],
 " and that with the negative sign by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["q", "TI"], TraditionalForm], "errors" -> {}, "input" -> "q", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6dcbff53-9c0d-49fe-b883-1ef047b7bd21"],
 " what echoes in the notation of Clifford algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{p,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b084e940-e1c9-4f5a-a636-280519ec6061"],
 ". The quantity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["p", "TI"], ",", 
           StyleBox["q", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(p,q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "088ca27f-c968-41df-9677-d140f0ee379f"],
 " is called the signature of metric space. Sometimes the same name is \
carried over to quantity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "-", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p-q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a3da5ea-e7d1-4728-a54c-eb7db591f088"],
 ". Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "\[PlusMinus]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}^2=\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7484691e-7951-4275-9448-04d85705e2a5"],
 ", the quantity  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad3a994e-e6b3-45ca-be44-72bff88befff"],
 " is called the  signature of the basis.Note, that in two (standard and \
reciprocal) basis interpretation the primary and reciprocal basis are just \
the two different bases that belong to the same vector space \
\[ScriptCapitalV] :",
 Cell[BoxData[
  GraphicsBox[
   {Thickness[0.0033333333333333335`], 
    {RGBColor[1., 1., 1.], Thickness[0.0016666666666666668`], Opacity[1.], 
     CapForm["Round"], JoinForm["Round"], 
