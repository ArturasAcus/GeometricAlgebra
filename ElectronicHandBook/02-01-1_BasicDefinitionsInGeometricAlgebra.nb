Cell[TextData[{
 "Usually signature means ordered collection of signs of all basis vectors. \
So, for algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{1}{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c34880bf-bb06-4881-a8b8-e0574df92315"],
 " we have p=1 and q=3."
}], "Text",ExpressionUUID->"daa9e457-70fe-4878-9083-01e11e4e76da"]
}, Closed]]
}, Closed]],

