Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t ",
 StyleBox["Linear independence",
  FontSlant->"Italic"],
 ". Let a set of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["V", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           SubscriptBox[
            StyleBox["a", "TI"], 
            StyleBox["i", "TI"]], "}"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "V=\\{a_i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cbbe92ea-0b71-471a-bb10-12400ddf79af"],
 " make up a subspace Span (V) \[Element] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "e7f9649f-e392-4b6d-9676-b5d301f7b04f"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FormBox[
     RowBox[{
      SubscriptBox[
       StyleBox["a", "TI"], 
       StyleBox["i", "TI"]], "\[Element]"}],
     TraditionalForm], 
    SuperscriptBox["\[ScriptCapitalV]", "m"]}], TraditionalForm]],
  ExpressionUUID->"2415865f-540d-4661-9430-b8fb4a5bfcb2"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["m", "TI"], "\[LessEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=1,\\ldots,m\\le n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96e00902-1a75-4495-9c3e-3a2a7d824070"],
 " . If a linear combination ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "1"], 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], "+", 
         SuperscriptBox["\[Alpha]", "2"], 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], "+", "\[Ellipsis]", "+", 
         SuperscriptBox["\[Alpha]", 
          StyleBox["m", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["m", "TI"]], "\[LongEqual]", "0", ",  ", 
         SuperscriptBox["\[Alpha]", 
          StyleBox["i", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\alpha^1 a_1+\\alpha^2 a_2+\\dots +\\alpha^m a_m=0,\\quad \
\\alpha^i\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8eb88188-8f1c-44fe-befb-56258bb81b8b"],
 "\[DoubleStruckCapitalR], \[DoubleStruckCapitalC], \[DoubleStruckCapitalH]\n\
is zero only when all scalars are zeroes, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["\[Alpha]", "1"], "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", "2"], "\[LongEqual]", "\[Ellipsis]", 
         "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", 
          StyleBox["m", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^1=\\alpha^2=\\dots=\\alpha^m=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5821caad-96d4-4e9d-b01f-d86965e2401d"],
 ", then the vectors in the set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{a_i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c3bd228-c76e-42f7-bd62-25484f3c22cc"],
 " are said to be linearly independent."
}], "Item",
 CellChangeTimes->{
  3.9102349636172113`*^9},ExpressionUUID->"c56edad2-0d6c-4fe5-9588-\
ba0809443dc0"],

