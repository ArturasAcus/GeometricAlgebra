Cell[TextData[{
 "Lets construct all possible idempotents of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ffc2687c-658e-4bd1-b682-6198a1ca5fe8"],
 " algebra. The construction here is extremely inefficient. The idea is to \
start construction from arbitrary element {i,j,k,l} and drop all which appear \
more that once. Only suits for small algebras like this"
}], "Text",ExpressionUUID->"9e7345b3-4a7a-4767-a55e-0511061f8298"],

