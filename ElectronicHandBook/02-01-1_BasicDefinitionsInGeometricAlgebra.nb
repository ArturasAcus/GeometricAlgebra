 CellChangeTimes->{3.911971206719018*^9},
 CellLabel->"In[10]:=",ExpressionUUID->"61c43132-aefb-4f3c-b216-d951dc35a8bf"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Reciprocal (dual) frame and basis",
  FontSlant->"Italic"],
 ".  [",
 StyleBox["Atidziai patikrinti ",
  FontColor->RGBColor[1, 0, 0]],
 Cell[BoxData[
  FormBox["TEX", TraditionalForm]],
  FontColor->RGBColor[1, 0, 0],ExpressionUUID->
  "14bf4c17-3adf-47a9-aeb7-094bb5f638d4"],
 StyleBox[" faila ar visur teisingai naudojama vidine sandauga: daug kur gali \
ki buti ten pakeista geometrine sandauga, kas yra klaida",
  FontColor->RGBColor[1, 0, 0]],
 "]This basis is similar to that found in the tensor calculus. The dual ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "*"], TraditionalForm]],ExpressionUUID->
  "0384fb54-7961-4814-b317-f842470bbe60"],
 " and primary ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalV]", TraditionalForm]],ExpressionUUID->
  "83cb45f0-b1ca-4e28-9c5e-a3e7a74b2246"],
 " spaces have the same dimension.  For a given basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["i", "TI"]], "}"}], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\{\\mathrm{e}_{i}\\}\\in", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebda9956-21a1-45da-9dd6-75c867a2234e"],
 Cell[BoxData[
  FormBox["\[ScriptCapitalV]", TraditionalForm]],ExpressionUUID->
  "f209c6f4-d192-43c4-b097-7939e77827e9"],
 ", there exists a dual (reciprocal) basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "*"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{i}^*\\in", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8921f400-e5f6-4ef7-93ab-925e9edeb4e3"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "*"], TraditionalForm]],ExpressionUUID->
  "7f5d6cf7-5ca2-463a-807b-6021ee34e041"],
 " that satisfies the functional dependence ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["j", "TI"]], ")"}], "\[LongEqual]", 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "F(\\mathrm{e}_{j})=\\delta_{ij}\\in", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a2e92f0-b4cd-407f-93f9-bfa1e36c36e3"],
 "\[DoubleStruckCapitalR], where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Delta]", 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "17689548-01d2-4c9e-b8ee-f24d8c5f31c6"],
 " is the Kronecker delta. In a practice, instead of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["F", "TI"], "(", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "F(\\mathrm{e}_{j})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aaa154b4-87bd-43b5-84e0-9de7ecd1e40e"],
 " it is more common to introduce symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f26715bf-25a2-4751-8ade-6ab846decf85"],
 " via product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["j", "TI"]], ")"}], "\[Rule]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^i(\\mathrm{e}_{j})\\to e^{i}\\cdot\\mathrm{e}_{j}=\\delta^i_{j}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a722410-0255-473c-a905-9c0aae980c6f"],
 " within the same primary space \[ScriptCapitalV]. In this interpretation \
the both basis vectors, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4c08c6c-f018-443f-9a26-bffdb6ff191a"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b61dd890-22c7-44ee-8bf7-0f6ddf8e918a"],
 ", are members of the same space \[ScriptCapitalV]. This approach (which is \
slightly less general) makes the  notation as well as interpretation \
considerably simpler. Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^i\\cdot\\mathrm{e}_{j}=\\delta^i_{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce5d2378-be42-4b85-aa0a-21f1334c87ec"],
 ", the basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "743e07d1-8bc1-4d9d-ae3d-c2c736ca22d0"],
 " is called reciprocal. The term \[OpenCurlyDoubleQuote]dual\
\[CloseCurlyDoubleQuote] has a number of different meanings. For example, the \
Hodge dual is defined in the ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"unit", " ", "below"}],
    BaseStyle->"Hyperlink",
    ButtonData->"HodgeDual"], TraditionalForm]],ExpressionUUID->
  "7facba33-1317-4ca4-aa03-5be1635bb584"],
 ".",
 StyleBox["\[LineSeparator]",
  Background->RGBColor[0.87, 0.94, 1]],
 "\nIn a general non-orthonormal frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"], "\[Wedge]", "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "E_n=e_1\\wedge e_2\\wedge\\dots\\wedge e_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "476f77e4-954f-4475-9fcb-9965710a9c8d"],
 "  the basis vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "77581c6c-79fc-422d-84b3-052fa7ee9a89"],
 " by definition are linearly independent. Therefore, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "E_n\\ne 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9059937c-48c7-4dd6-a605-cfe8c349cb81"],
 " and different vectors in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "E_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "759c8351-f0f1-418a-bce2-fa052b77010f"],
 " do not necessarily anticommute. Associated with an arbitrary frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["E", "TI"], 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "E_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01d169dc-45b3-42fa-aff2-de3f27fc9ff8"],
 " is an upper-indexed reciprocal frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], "1"], "\[Wedge]", 
         SuperscriptBox[
          StyleBox["e", "TI"], "2"], "\[Wedge]", "\[Ellipsis]", "\[Wedge]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^1\\wedge e^2\\wedge\\dots\\wedge e^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0247d6a-8266-4465-a016-38550d104255"],
 " the basis vectors of which are  defined by relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]], ",  ", "\[ForAll] ", 
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"], "\[LongEqual]", "1", ",", "\[Ellipsis]", ",", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i\\d e^j=\\delta_i^j,\\quad\\forall\\,  i,j=1,\\ldots, n", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f7620da-cba9-4e1c-932b-38cd91f96742"],
 ". Here the Kronecker  delta ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox["\[Delta]", 
        StyleBox["i", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4b7dc17-71bd-4e8a-a011-4fad6ca0b1fc"],
 " has value ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bc8241c-ba72-4b0a-8d39-63728f47d2bd"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "855a335a-04e0-4ddb-ab26-ac35cd6befe9"],
 " and zero otherwise. Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["i", "TI"]], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], 
              StyleBox["j", "TI"]]}], "}"}], "\[Element]"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\{e_i,e^j\\}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0da47cd4-f3dc-4996-9d30-e990e29995df"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "b9b69b6d-958b-4320-a778-d3e66933a70d"],
 ". one can define their inner product which is symmetric under interchange \
of multipliers: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i\\cdot e^j=e^j\\cdot e_i=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c34dedd-7f50-4ca7-a493-993e8a7b40ef"],
 ". The outer product is antisymmetric, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[Wedge]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^j\\wedge e_i=-e_i\\wedge e^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59c41e80-a626-4c02-9b3a-27531e78e96d"],
 ". Thus, the above relations may be interpreted in two ways: either as \
orthonormalized basis in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "919ea87a-5ae6-44dd-9243-b234a617927d"],
 " (when orthonormalized, as usual we write in roman) that satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot \\mathrm{e}_{}^j=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e002685-5576-4aaf-ab7c-4797a9a34c6e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], ",", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], "}"}], "\[Element]"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\{\\mathrm{e}_{i},\n\\mathrm{e}_{}^j\\}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "38b21a03-bfc2-4b64-89c7-3dac86aa298f"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "d535c0b4-4409-417a-beb8-840b30d551c2"],
 ", or it will be more general to treat ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c76cd017-e0ea-4953-9881-f8465d2f2ac2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4382b2bd-ef3d-4dd6-980e-cb2dc6c0d573"],
 " as belonging to different isomorphic vector spaces ",
 Cell[BoxData[
  FormBox["\[ScriptCapitalV]", TraditionalForm]],ExpressionUUID->
  "ecfa2b26-011f-428c-baf2-a626401a2e5e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "*"], TraditionalForm]],ExpressionUUID->
  "c5db915a-2fc4-47dd-b9ec-9e14e5bde059"],
 " (called dual to each other).  Further in this handbook we will consider ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff7d59ee-26e4-4c17-a860-ed96088f4ff3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10d45680-fe83-4142-a0db-8f068eecd803"],
 " as belonging to the same space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "12dace7c-aa4f-45f2-9000-0eebbc5a6a69"],
 " and index position only indicates which frame primary (index down, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "949777b6-698c-483d-9870-84238aca00fa"],
 " ) or reciprocal (index up, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f519265-da1a-44de-888b-79e8d115ec0f"],
 ") is used.",
 StyleBox[" In general reciprocal basis can be defined for full basis of \
Clifford algebra as well. Of course, in that case the inner product matrix ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["J", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["K", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{J}\\cdot \\mathrm{e}_{}^K", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "bed83141-f58f-412a-bad6-083a74dc64f1"],
 StyleBox[" (where J and K now are multiindices, see below) is not strictly \
diagonal (the matric  is rather sparse, but contains non zero elements beside \
the diagonal ). We want to stress, that while in orthonormal basis one may \
think that one can replace inner product in the definition of the reciprocal \
basis by geometric product and simply compute reciprocal as  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\eup{j}=\\e{i}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "d4831ea9-39ba-41e1-a46e-96fdd20c7e1c"],
 StyleBox[" in nonorthonormal basis there is a big difference. Indeed, \
computation of reciprocal basis in general requires all vectors (since we \
have to ensure that all inner products between different vector vanishes), \
whereas inverse of vector can be computed from single vector (without \
involving other vectors that constitute a vector space basis).  Therefore in \
general basis in order to find reciprocal basis we must provide full vector \
basis. ",
  Background->RGBColor[0.87, 0.94, 1]]
}], "Item",
