         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {OutputFormsDump`HeadedRows, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {{
      "id", "reverse", "grade inverse", 
       "Clifford conjugate"}, {}}]]]], "Output",
 CellChangeTimes->{3.950157323768559*^9, 3.9501583771054707`*^9},
