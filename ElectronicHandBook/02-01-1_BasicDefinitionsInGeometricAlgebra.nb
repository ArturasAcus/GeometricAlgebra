Cell[CellGroupData[{

Cell["Geometric product and multivector", "Section",
 CellChangeTimes->{{3.910234655280381*^9, 3.910234662007681*^9}, {
  3.9102392159867783`*^9, 3.910239218248143*^9}, {3.910248106907792*^9, 
