Cell[TextData[{
 StyleBox["Basis elements ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "12"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d30ad62-771a-4a92-a4c1-80fedd6eae34"],
 StyleBox[" and ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "134"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{134}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "213c32b5-45ae-487f-a893-90e8b484b9a1"],
 StyleBox[" in various orderings",
  FontSlant->"Italic"],
 ".   Given two basis elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "12"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e1fb7fc6-d765-4016-90af-8657fa90aa8c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "134"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{134}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c38183ff-003e-4620-919f-228f90751acc"],
 " let\[CloseCurlyQuote]s  determine their position in all orderings. After \
insertion of zeroes we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "0", ",", "0"}], "}"}], "-", 
         RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "3", ",", "4"}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"0", ",", "2", ",", "-3", ",", "-4"}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{1,2,0,0\\}-\\{1,0,3,4\\}=\\{0,2,-3,-4\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba18b37e-da37-4ce1-ab64-69b4602eb686"],
 ". The first nonzero element in the left most position is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["2", TraditionalForm], "errors" -> {}, "input" -> "2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dcfa6c2-96d9-4d5f-9062-fcbfd83c9035"],
 ". It is positive, therefore in Lex ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox[">", 
          StyleBox["Lex", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}>_\\mathrm{Lex}\\e{134}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bef7c20d-50af-4977-91bd-fcb9135d716e"],
 ". Similarly, for the same reason in InvLex order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox["<", 
          StyleBox["InvLex", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}<_\\mathrm{InvLex}\\e{134}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0107e62-c8c5-438d-b9ee-08587f6311b6"],
 ", because the  right most element ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-4", TraditionalForm], "errors" -> {}, "input" -> 
     "-4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c7a13efe-99f5-48ee-998b-0a347d822bf6"],
 " is negative. For the same reason in RevLex\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox[">", 
          StyleBox["RevLex", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}>_\\mathrm{RevLex}\\e{134}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a1f45a84-8b64-4108-a69b-475b791935a0"],
 ". Finally, for InvRevLex the left most nonzero element is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["2", TraditionalForm], "errors" -> {}, "input" -> "2", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01f11bcb-f1e7-4fe2-9603-ab3ae7e971f7"],
 ", therefore ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox["<", 
          StyleBox["InvRevLex", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}<_\\mathrm{InvRevLex}\\e{134}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2ab0ef5-4653-414b-8698-872a55a673ac"],
 ". It can be checked that in the above given ordered basis the elements \
appear in the correct relative positions. Of course, in Deg[Lex], \
Deg[InvLex], Deg[RevLex] and Deg[InvRevLex] one has ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox["<", 
          StyleBox["Deg[ ]", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}<_\\mathrm{Deg[ ]}\\e{134}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f99d1f38-7961-407b-a291-446b3f9256cb"],
 " and in InvDeg[Lex], InvDeg[InvLex], InvDeg[RevLex] and InvDeg[InvRevLex] \
one has ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], 
         SubscriptBox[">", 
          StyleBox["InvDeg[ ]", FontSlant -> "Plain"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}>_\\mathrm{InvDeg[ ]}\\e{134}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0cd7c59a-6e91-4ca2-88cd-0a66e67cbd33"],
 "."
}], "Subitem",
 CellTags->{
  "PrimitiveIdempcl30", 
   "dotcontraction"},ExpressionUUID->"c164bb48-5269-4d89-b258-2c6c92586d72"]
}, Closed]]
}, Closed]]
},
