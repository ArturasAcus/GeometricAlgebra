Cell[TextData[{
 StyleBox["Frame rotor",
  FontSlant->"Italic"],
 ". [",
 StyleBox["Strictly speaking this example  misleading and should not be \
applied for n>3. To replace by correct version given by Shirokov",
  FontColor->RGBColor[1, 0, 0]],
 "] Suppose in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "a2fb7860-54c7-4819-a17d-ba3f75c2e467"],
 " there are two orthonormal frames, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\e{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "85d9e771-8edf-4851-a645-13f196f54c70"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathbf{f}_i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1a2da8a-9697-475f-8c2b-0aa84a9d71f3"],
 ". Find the rotor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "577a3fbd-536f-4970-9c9e-2e4c3d09ae8b"],
 " (the rotor satisfies the condition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["R", "TI"], "~"], 
         StyleBox["R", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\tilde{\\m{R}}\\m{R}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c00b3a07-5954-4493-b53a-72049142a082"],
 ") that connects these two basis: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["R", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         OverscriptBox[
          StyleBox["R", "TI"], "~"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathbf{f}_i=\\m{R}\\e{i}\\tilde{\\m{R}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19a0c6b6-0ee3-4e41-826e-89e7c7459601"],
 ". For simplicity let\[CloseCurlyQuote]s assume that the rotor may be \
expressed as a sum of scalar and   bivector  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[Tilde]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}\\sim\\e{i}\\wedge \\e{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d49a254e-09b0-47e6-9eff-15aca9195aa3"],
 ", i.e., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "\[Alpha]", "-", "\[Beta]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=\\alpha-\\beta\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "590dc12e-3159-49c0-accd-e9442a1ad926"],
 ", where the constants ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f27f7d53-8295-4506-8198-c90bfc39f8df"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Beta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc8eca0e-924f-4ec1-a59b-8d349bba5f48"],
 " depend on the sign of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["B", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f16c8801-75a2-4e0f-9a98-ba26b95bfc7d"],
 ".  ",
 StyleBox["This is restriction, which means that we assume that a bivector is \
a blades. Therefore we could not hope it will work for n>3. Nonetheless, let\
\[CloseCurlyQuote]s see what we will get under this assumption.",
  Background->RGBColor[0.87, 0.94, 1]],
 "  From given  equations the bivector can be expressed as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["R", "TI"], "-", "\[Alpha]"}], ")"}], "/", "\[Beta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}=(\\m{R}-\\alpha)/\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4af994d1-a4d2-43de-bfee-817071ff0167"],
 ". Using the reversion  we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["B", "TI"], "~"], "\[LongEqual]", "-", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\tilde{\\mathcal{B}}=-\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ff0361f-e623-4a2f-ad81-19219f515a8c"],
 " and  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["R", "TI"], "~"], "\[LongEqual]", "\[Alpha]", "+", 
         StyleBox["B", "TI"], "\[Beta]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tilde{\\m{R}}=\\alpha+\\mathcal{B}\\beta", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6d1fc53-161c-4876-bc5c-faebd105a092"],
 ". \[LeftFloor]e shall assume that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["B", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[Congruent]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{ij}=B^{ij}\\equiv\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4d2c8cc-6432-44fa-a5c6-b0bc8e431b57"],
 ". This means that in 3D the raising or lowering of indices has no effect on \
sign or changes signs of all basis vectors. Then using formulas for scalar ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[Alpha]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Alpha]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}\\alpha\\e{}^i=\\alpha n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32abf87e-6b1a-4152-8852-ff933952569f"],
 " and bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["A", "TI"], "2"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], 
         SubscriptBox[
          StyleBox["A", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\e{i}A_{2}\\e{}^i=(-1)^2(n-4)A_{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be6c7a8d-058f-43eb-a8e7-92ae0a087d19"],
 " we obtain\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         OverscriptBox[
          StyleBox["R", "TI"], "~"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Alpha]", 
         StyleBox["n", "TI"], "+", "\[Beta]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         StyleBox["B", "TI"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Alpha]", 
         StyleBox["n", "TI"], "+", "\[Beta]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], 
         StyleBox["B", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], 
         OverscriptBox[
          StyleBox["R", "TI"], "~"], "+", "4", "\[Alpha]"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\e{i}\\tilde{\\m{R}}\\e{}^i=\\alpha n \
+\\beta\\e{i}\\mathcal{B}\\e{}^i=\\alpha n+\\beta(-1)^{2}(n-4)\\mathcal{B}=\n\
(n-4)\\tilde{\\m{R}} +4\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7e220364-ae5d-48c5-baef-adc5436209f6"],
 ".\[LineSeparator]\[LineSeparator]\nWe now form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["R", "TI"], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], 
             OverscriptBox[
              StyleBox["R", "TI"], "~"]}], ")"}], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["R", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], 
             OverscriptBox[
              StyleBox["R", "TI"], "~"], 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], "+", "4", "\[Alpha]", 
         StyleBox["R", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}_i\\e{}^i=(\\m{R}\\e{i}\\tilde{\\m{R}})\\e{}^i \
=\\m{R}(\\e{i}\\tilde{\\m{R}}\\e{}^i)=(n-4)+4\\alpha\\m{R}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd107775-24e9-4397-bb70-7b7f2ac73c9d"],
 ",  from which follows that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"4", "-", 
             StyleBox["n", "TI"], "+", 
             SubscriptBox[
              StyleBox["f", FontSlant -> "Bold"], 
              StyleBox["i", "TI"]], 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "/", "4", "\[Alpha]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=(4-n+\\mathbf{f}_i\\e{}^i)/4\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "de49efdb-918f-4a8d-b406-86de04b6e69e"],
 ". After normalization, the rotation operator is\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"4", "-", 
            StyleBox["n", "TI"], "+", 
            SubscriptBox[
             StyleBox["f", FontSlant -> "Bold"], 
             StyleBox["i", "TI"]], 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"|4", "-", 
            StyleBox["n", "TI"], "+", 
            SubscriptBox[
             StyleBox["f", FontSlant -> "Bold"], 
             StyleBox["i", "TI"]], 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]], "|"}]], ",  ", "frame rotor", 
         RowBox[{"{", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["i", "TI"]], "}"}], "\[Rule]", 
         RowBox[{"{", 
           SubscriptBox[
            StyleBox["f", "TI"], 
            StyleBox["i", "TI"]], "}"}], " in nD Euclidean space"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=\\frac{4-n+\\mathbf{f}_i\\e{}^i}{|4-n+\\mathbf{f}_i\\e{}^i|}, \
\\quad\\text{frame rotor} \\{\\e{i}\\}\\to\\{\\m{f}_i\\}\\text{\\ in nD \
Euclidean  space}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd2b7334-c249-4a54-a905-d72b8781fdd9"],
 ". \[LineSeparator]\nThe formula is applicable to simple rotors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ede744c-91e3-465b-9edf-b48ed9e15b8c"],
 " represented by a bivector blade, or sum of scalar and bivector. In case of \
3D space,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9b8c155-309f-410e-9b2b-eeb270e72526"],
 ", when all bivectors are the blades the frame rotor formula reads:\
\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{"1", "+", 
            SubscriptBox[
             StyleBox["f", FontSlant -> "Bold"], 
             StyleBox["i", "TI"]], 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]]}], 
          RowBox[{"|1", "+", 
            SubscriptBox[
             StyleBox["f", FontSlant -> "Bold"], 
             StyleBox["i", "TI"]], 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]], "|"}]]}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\m{R}=\\frac{1+\\mathbf{f}_i\\e{}^i}{|1+\\mathbf{f}_i\\e{}^i|}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49d41658-cc5c-477f-b123-3ea2557944f4"],
 ".\n \nIn  3D Euclidean space we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{}^i=\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b73f9877-73d0-46c2-93b6-9a5ca87a618f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}^i=\\mathbf{f}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4b53bab2-3f74-4ef5-9d7a-211e24d2b82b"],
 ". If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[DoubleVerticalBar]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{3}\\|\\mathbf{f}_3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb718c16-8686-4344-9c3f-d12e7fd2bea3"],
 ", the remaining basis vectors lie in the same plane and intersect at angle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4915c1cb-2b88-4a3c-90ae-1a685019056d"],
 ", then\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{"1", "+", 
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[LongEqual]"}], 
             RowBox[{"1", "+", 
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], 
                StyleBox["i", "TI"]], "\[CenterDot]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "+", 
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], 
                StyleBox["i", "TI"]], "\[Wedge]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[LongEqual]", "1", "+", 
               RowBox[{"(", 
                 RowBox[{"1", "+", "cos", "\[Phi]", "+", "cos", "\[Phi]"}], 
                 ")"}]}]}, {"\[Null]", 
             RowBox[{"+", 
               RowBox[{"(", 
                 RowBox[{"0", "+", "sin", "\[Phi]", "+", "sin", "\[Phi]"}], 
                 ")"}], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "\[LongEqual]", 
               "2", 
               RowBox[{"(", 
                 RowBox[{"1", "+", "cos", "\[Phi]", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "12"], "sin", 
                   "\[Phi]"}], ")"}]}]}, {"\[Null]", 
             RowBox[{"\[LongEqual]", "4", "cos", 
               FractionBox["\[Phi]", "2"], 
               RowBox[{"(", 
                 RowBox[{"cos", 
                   FractionBox["\[Phi]", "2"], "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "12"], "sin", 
                   FractionBox["\[Phi]", "2"]}], ")"}], ","}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\
1+\\mathbf{f}_i\\e{}^i=&1+\\mathbf{f}_i\\d\\e{i}+\\mathbf{f}_i\\w\\e{i}=1+(1+\
\\cos\\phi+\\cos\\phi)\\\\\n\
&+(0+\\sin\\phi+\\sin\\phi)\\e{12}=2(1+\\cos\\phi+\\e{12}\\sin\\phi)\\\\\n&=4\
\\cos\\frac{\\phi}{2}(\\cos\\frac{\\phi}{2}+\\e{12}\\sin\\frac{\\phi}{2}),\n\
\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4bacd92d-c6f6-41a9-8dab-b3c193a31464"],
 "\[LineSeparator]\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Phi]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\phi", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36d8ef42-1661-4b76-98ed-b9c54ee542a8"],
 " is the angle between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69da859c-c21a-492a-b9d3-b1223f343dcf"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", FontSlant -> "Bold"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9df84d85-3e9c-4f84-8802-8a86b8601889"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1", ",", "2"}], 
       TraditionalForm], "errors" -> {}, "input" -> "i=1,2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63a26c7a-df5a-40e0-bb85-5d1db56c00f7"],
 ". Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|1", "+", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "|", "\[LongEqual]", "4", "cos", 
         FractionBox["\[Phi]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "|1+\\mathbf{f}_i\\e{i}|=4\\cos\\frac{\\phi}{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f73cccf0-7493-4cf4-985e-ed5a4be393e9"],
 ", we obtain the standard form of the rotor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", "cos", 
         FractionBox["\[Phi]", "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "sin", 
         FractionBox["\[Phi]", "2"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "12"], "\[Phi]", "/", 
            "2"}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=\\cos\\frac{\\phi}{2}+\\e{12}\\sin\\frac{\\phi}{2}=\\mathrm{e}^{\
\\e{12}\\phi/2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "50d0c1d2-b092-4b39-9d06-be634bdf2bbc"],
 ". Note that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12", "2"], "\[LongEqual]", 
         "-1"}], TraditionalForm], "errors" -> {}, "input" -> "\\e{12}^2=-1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e731e88a-94e1-4026-ae16-a48a522ff5bf"],
 " is related with the trigonometric functions. More general case, when the \
rotor is represented by even grade elements, is described below."
}], "Subitem",ExpressionUUID->"0453d9e1-6839-4929-bd88-0c13041edbd6"],

