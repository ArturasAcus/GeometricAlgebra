Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Primitive idempotents of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", "7"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{7}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cda01ed9-cb9f-4825-bd34-6b8a0f2a380d"],
 ". In the case of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", "7"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{7}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "91ce5c74-5af3-42c5-a928-2985a012fbb3"],
 " we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[LongEqual]", 
         StyleBox["q", "TI"], "-", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{
            StyleBox["q", "TI"], "-", 
            StyleBox["p", "TI"]}]], "\[LongEqual]", "7", "-", 
         SubscriptBox[
          StyleBox["r", "TI"], "7"], "\[LongEqual]", "7", "-", "3", 
         "\[LongEqual]", "4"}], TraditionalForm], "errors" -> {}, "input" -> 
     "k=q-r_{q-p}=7-r_7=7-3=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dbf4e961-465e-4223-b663-b44fafdf6007"],
 ". Thus the primitive idempotent consists of 4 factors of type ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}], ",", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]], "2"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{1}{2}(1+\\e{T_i}), \\e{T_i}^2=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03ab773a-c524-4293-9845-bc8ece3cf57c"],
 ". Since all ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3a749c06-1359-45f8-b6a4-b64d159a047f"],
 " must be mutually commuting, we can select, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox[
           StyleBox["A", "TI"], "1"]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "124"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "235"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "346"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "457"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "P_{A_1}=\\frac{1}{2}(1+\\e{124})\\frac{1}{2}(1+\\e{235})\\frac{1}{2}(1+\
\\e{346})\n\\frac{1}{2}(1+\\e{457})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "75722bfb-1f4c-47bf-a802-7bb702e18823"],
 " or  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox[
           StyleBox["B", "TI"], "1"]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "123"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "345"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "146"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "367"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "P_{B_1}=\\frac{1}{2}(1+\\e{123})\\frac{1}{2}(1+\\e{345})\\frac{1}{2}(1+\
\\e{146})\n\\frac{1}{2}(1+\\e{367})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc8849b2-48b6-419e-876b-2705b88e404d"],
 ", etc. Since in this case the algebra is not simple, instead of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"16", "\[Cross]", "16"}], TraditionalForm], "errors" -> {}, 
     "input" -> "16\\times 16", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1dc46fe6-6682-4009-b993-0072e94e3727"],
 " matrices ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SuperscriptBox["2", 
            StyleBox["k", "TI"]], "\[LongEqual]", 
           SuperscriptBox["2", "4"], "\[LongEqual]", "16"}], ")"}], 
       TraditionalForm], "errors" -> {}, "input" -> "(2^k=2^4=16)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d62cfad9-a8c6-4e67-af2c-768f0cdcc373"],
 " we obtain a direct sum of two ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"8", "\[Cross]", "8"}], TraditionalForm], "errors" -> {}, 
     "input" -> "8\\times 8", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "28dfb030-3aab-444e-bcac-bab6383293f9"],
 " matrices, i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"8", "\[Cross]", "8"}], ")"}], "\[CirclePlus]", 
         RowBox[{"(", 
           RowBox[{"8", "\[Cross]", "8"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "(8\\times8)\\oplus(8\\times 8)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d9f4f8c8-88fb-463c-948b-c4b24ae3e42b"],
 "."
}], "Subitem",ExpressionUUID->"cfe9ec4c-bbc6-4054-a2c9-1454ce1055c3"],

