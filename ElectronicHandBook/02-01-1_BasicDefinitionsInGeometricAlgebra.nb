Cell["\<\
Right contraction implementation can be tested in a similar way.\
\>", "Text",ExpressionUUID->"748f00d8-9c5d-42ab-be33-82cd6e969290"],

Cell[TextData[{
 "Test formula  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "\[LeftContract]", 
     RowBox[{"(", 
      RowBox[{"B", "\[LeftContract]", "C"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "\[OuterProduct]", "B"}], ")"}], "\[LeftContract]", 
     "C"}]}], TraditionalForm]],ExpressionUUID->
  "bbed1652-3bfe-473b-bb54-3bbbe7468eac"],
 ". "
}], "Text",ExpressionUUID->"55024a7d-6f12-4cf3-a95c-27941851bb1b"],

