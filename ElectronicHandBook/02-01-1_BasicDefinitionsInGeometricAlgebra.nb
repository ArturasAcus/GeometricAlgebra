Cell[TextData[{
 "Since for unspecified multivector (head ",
 StyleBox["MV[]",
  FontWeight->"Bold"],
 ") there are no defined rules, add some. In particular add a rule which \
\[OpenCurlyDoubleQuote]teaches\[CloseCurlyDoubleQuote] that inner product of \
primary and reciprocal basis vectors are orthonormal, i.e. replace inner \
product of primary and reciprocal vectors by Kronecker delta"
}], "Text",ExpressionUUID->"5066947b-6408-46fa-8156-b27d972eee7c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"primaryAndReciprocalInnerProductRules", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"InnerProduct", "[", 
      RowBox[{
       RowBox[{"MV", "[", 
        RowBox[{"r", "[", "i_", "]"}], "]"}], ",", 
       RowBox[{"MV", "[", 
        RowBox[{"p", "[", "j_", "]"}], "]"}]}], "]"}], ":>", 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"i", ",", "j"}], "]"}]}], ",", 
    RowBox[{
     RowBox[{"InnerProduct", "[", 
      RowBox[{
       RowBox[{"MV", "[", 
        RowBox[{"p", "[", "i_", "]"}], "]"}], ",", 
       RowBox[{"MV", "[", 
        RowBox[{"r", "[", "j_", "]"}], "]"}]}], "]"}], ":>", 
     RowBox[{"KroneckerDelta", "[", 
      RowBox[{"i", ",", "j"}], "]"}]}]}], "}"}]}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"6e9fa183-47a5-4059-bd20-d745028ce746"],

