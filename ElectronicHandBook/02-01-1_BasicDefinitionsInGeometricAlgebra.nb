Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Grade",
  FontSlant->"Italic"],
 ".  The elements of graded vector  space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "642a43ef-c278-4e4a-ad76-569bbb29cbbf"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["m", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True]}], TraditionalForm],
      "errors" -> {}, "input" -> "=\\sum_{m=0}^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ab1ed550-6254-464a-894a-12ede52378fb"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "m"], "n"], TraditionalForm]],
  ExpressionUUID->"c03bc957-44b4-4746-8cde-a0a543a2d7e4"],
 " are constructed from orthonormalized vectors in ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "8a94a387-014f-457b-88ab-1dc32f5d3a17"],
 ". The gradings in GA are established only after the basis vectors in  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "6b07b67b-e306-423d-8078-664e67b7d338"],
 " have been fixed (declared). In space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "4d3cd9cc-8269-4042-82b7-d719d4df1f9a"],
 " the basis  is called standard if it allows to construct all possible outer \
products of all different orthonormalized basis vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03d510bd-9d4f-4eb1-a32f-e357c563d484"],
 ". For example, when  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "m=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5660d260-e6ec-438b-be00-5b5c3faed21e"],
 " the space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "3"], "n"], TraditionalForm]],
  ExpressionUUID->"9652d125-f35e-46bc-be7f-ffe29a4118cd"],
 " consist of all possible products (blades) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}\\e{j}\\e{k}=\\e{i}\\w\\e{j}\\w\\e{k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29d3cc07-395c-4b82-b75e-b6f3af6b869b"],
 ",  where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "\[LessEqual]", 
         StyleBox["i", "TI"], "<", 
         StyleBox["j", "TI"], "<", 
         StyleBox["k", "TI"], "\[LessEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1\\le i<j<k\\le n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "027ef975-4230-49a7-b1cf-58c44557bf13"],
 ". To simplify notation the  combined indices are used, for example, the \
blade ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Element]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\e{1}\\e{2}\\in", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "134b4db0-aa7a-4969-973b-e6da7570bdb6"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"a263b9f8-cc14-4e0e-966f-60a6ddd9a860"],
 " is denoted as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "12"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62abe324-85a7-4acc-9f03-6d07325cae85"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{1}\\e{2}\\e{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef1b868a-234f-4bcd-bd62-8b9075819aba"],
 " as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "123"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{123}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5b40301-2e4f-4450-8063-b10fee87bbec"],
 ", etc. The number of all possible different basis vectors in such products \
is called a grade or MV homogeneous part, and the respective  space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "m"], "n"], TraditionalForm]],
  ExpressionUUID->"1de94224-0a0e-438f-8874-8ce96376d1fb"],
 " is called a grade-m space. Since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["m", "TI"], "\[LessEqual]", 
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "m\\le n=p+q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cca85b4-57a6-4fdd-83ea-76f54b7a90a2"],
 ", the dimension of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "m"], "n"], TraditionalForm]],
  ExpressionUUID->"9779b05d-3b5a-4ae4-bc10-f69d8a1b1ec6"],
 ", i.e. the number of elements in the subspace ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "m"], "n"], TraditionalForm]],
  ExpressionUUID->"e66b4586-9dfd-43b1-b78a-b71b2d135811"],
 " is given by the binomial coefficient ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            StyleBox["n", "TI"], "!"}], 
          RowBox[{
            StyleBox["m", "TI"], "!", 
            RowBox[{"(", 
              RowBox[{
                StyleBox["n", "TI"], "-", 
                StyleBox["m", "TI"]}], ")"}], "!"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "C_m^n=\\frac{n!}{m!(n-m)!}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc311445-f11c-49e5-8392-3ae34a02b5b9"],
 ".The total number of graded elements (including the scalar and basis \
vectors) then is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["m", "TI"], "\[LongEqual]", "0"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubsuperscriptBox[
          StyleBox["C", "TI"], 
          StyleBox["m", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SuperscriptBox["2", 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\sum_{m=0}^n C_m^n=2^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "398b0393-74c1-4880-83de-a58f739987a9"],
 ". Clifford algebra which contains exactly ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        StyleBox["n", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30a89ccf-0da5-45fd-930e-55cc73398311"],
 " basis elements is called universal.  In the Handbook we are interested in \
the universal Clifford algebras only."
}], "Item",ExpressionUUID->"0344ef55-9f1b-4e36-9370-19f4eb2df972"],

Cell[TextData[{
 StyleBox["Graded vector space ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0708570-dd00-4436-ac4b-da63833ff808"],
 ". The standard basis of 4D algebra is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "4"]}], "}"}], 
         "\[Element]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\{\\e{1},\\e{2},\\e{3},\\e{4}\\}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5348a509-f4de-4e5d-b454-97122f47cd63"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "1"], "n"], TraditionalForm]],
  ExpressionUUID->"5c320727-389e-4e8d-b544-823063c65212"],
 ". It consists of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox["2", 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SuperscriptBox["2", "4"], "\[LongEqual]", "16"}], TraditionalForm], 
     "errors" -> {}, "input" -> "2^n=2^4=16", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61e6b32f-c4e1-4f2a-b8a9-16fddd12006d"],
 " elements.\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             SubsuperscriptBox[
              StyleBox["G", "TI"], 
              StyleBox["m", "TI"], 
              StyleBox["n", "TI"]], 
             RowBox[{"    ", "grade"}], "name", "basis elementss", 
             RowBox[{"dimension of ", 
               SubsuperscriptBox[
                StyleBox["C", "TI"], 
                StyleBox["m", "TI"], "4"]}]}, {
             SubsuperscriptBox[
              StyleBox["G", "TI"], "0", "4"], 
             RowBox[{"    ", "0"}], "scalar", "1", "1"}, {
             SubsuperscriptBox[
              StyleBox["G", "TI"], "1", "4"], 
             RowBox[{"    ", "1"}], "vector", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "4"]}], "4"}, {
             SubsuperscriptBox[
              StyleBox["G", "TI"], "2", "4"], 
             RowBox[{"    ", "2"}], "bivector", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "13"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "14"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "23"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "24"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "34"]}], "6"}, {
             SubsuperscriptBox[
              StyleBox["G", "TI"], "3", "4"], 
             RowBox[{"    ", "3"}], "trivector", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "123"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "124"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "134"], ",", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "234"]}], "4"}, {
             SubsuperscriptBox[
              StyleBox["G", "TI"], "4", "4"], 
             RowBox[{"    ", "4"}], "pseudoscalar  ", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1234"], "\[Congruent]", 
               
               StyleBox["I", "TI"]}], "1"}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n G_m^n&\\qquad \
\\text{grade}&\\text{name}&\\text{basis elementss}&\\text{dimension of\\ } \
C_m^4\\\\ \nG_0^4&\\qquad 0&\\text{scalar}& 1&1\\\\\nG_1^4&\\qquad \
1&\\text{vector}&\\e{1}, \\e{2}, \\e{3}, \\e{4}&4\\\\\nG_2^4&\\qquad \
2&\\text{bivector}&\\e{12}, \\e{13}, \\e{14}, \\e{23}, \\e{24}, \\e{34}&6\\\\\
\nG_3^4&\\qquad 3&\\text{trivector}&\\e{123},\\e{124},\\e{134},\\e{234}&4\\\\\
\nG_4^4&\\qquad 4&\\text{pseudoscalar\\quad}& \\e{1234}\\equiv I&1\\\\ \n\
\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f089e997-460b-4d4f-8a17-30c720088361"],
 "\[LineSeparator]"
}], "Subitem",ExpressionUUID->"d56372b7-8f40-41a5-bd5f-525bb7c30fa7"],

