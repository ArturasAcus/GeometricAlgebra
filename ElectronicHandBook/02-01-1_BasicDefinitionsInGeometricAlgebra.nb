Cell[TextData[{
 "14-th formula, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["curl", FontSlant -> "Plain"], 
         StyleBox["f", "TI"], "\[LongEqual]", 
         OverscriptBox["\[Del]", "."], "\[Wedge]", 
         OverscriptBox[
          StyleBox["f", "TI"], "."], "\[LongEqual]", 
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "<", 
            StyleBox["j", "TI"]}], LimitsPositioning -> True], " ", 
         RowBox[{"(", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"], 
              StyleBox["i", "TI"]], " ", 
             SubscriptBox["\[PartialD]", 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["f", "TI"], 
              StyleBox["j", "TI"]], 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}], "-", 
             SubsuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"], 
              StyleBox["j", "TI"]], " ", 
             SubscriptBox["\[PartialD]", 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["f", "TI"], 
              StyleBox["i", "TI"]], 
             RowBox[{"(", 
               StyleBox["x", "TI"], ")"}]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{curl}\\m{f}=\\dot{\\nabla}\\w\\m{\\dot{f}}=\\sum_{i<j}\\,\\\
bigl(\\e{j}^{i}\\,\\partial_if_j(x)-\\e{i}^{j}\\,\\partial_j f_i(x)\\bigr)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be310660-9f48-4a40-9c3d-c5d62354faaa"],
 "  curl of vector function (explanation is postponed)"
}], "Text",ExpressionUUID->"38d148fe-2a8c-478d-be8f-cdeaae213718"],

