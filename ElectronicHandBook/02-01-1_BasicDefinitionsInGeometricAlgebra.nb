Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["General formulae for contractions",
  FontSlant->"Italic"],
 ".  The introduction of two inner products (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftFloor]", "\[Null]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rc", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b152cde5-4352-4f6e-ac33-f43271170b00"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[RightFloor]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\lc", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a78eff1-dbc0-4270-94dd-426429f5078e"],
 ") requires additional rules if used along with the involutions. For \
example, the reversion  flips the contraction symbol to opposite in order to \
keep the correct account of grade ordering, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          RowBox[{"(", 
            StyleBox["A", "TI"], "\[RightFloor]"}], "~"], 
         StyleBox["B", "TI"], ")", "\[LongEqual]", 
         OverscriptBox[
          StyleBox["B", "TI"], "~"], 
         RowBox[{"\[LeftFloor]", 
           OverscriptBox[
            StyleBox["A", "TI"], "~"]}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "(\\reverse{\\m{A}\\lc \\m{B}})=\\reverse{\\m{B}}\\ir\\reverse{\\m{A}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aea933ba-1101-4481-847a-ec384cf3e5c1"],
 ". Otherwise the result may nullify.\[LineSeparator]\nExamples of general MV \
formulas with contraction  [",
 StyleBox["problems with tex box convertion to Mma boxe, neredaguoti tex \
dezes, taisyti/redaguoti  su ctrl E, tiesiog sugeneruotas dezes: ideti \
RowBox[{\[OpenCurlyDoubleQuote]\[LeftFloor]\[CloseCurlyDoubleQuote]}], ",
  FontColor->RGBColor[1, 0, 0]],
 "s]\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], "\[RightFloor]", 
                  StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                False], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               "\[RightFloor]", 
               OverscriptBox[
                StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
               ",    ", 
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], 
                  RowBox[{"\[LeftFloor]"}], 
                  StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                False], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               RowBox[{"\[LeftFloor]"}], 
               OverscriptBox[
                StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
               ","}]}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], "\[RightFloor]", 
                  StyleBox["B", "TI"]}], "~"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"], 
               RowBox[{"\[LeftFloor]"}], 
               OverscriptBox[
                StyleBox["A", "TI"], "~"], ",    ", 
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], 
                  RowBox[{"\[LeftFloor]"}], 
                  StyleBox["B", "TI"]}], "~"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"], "\[RightFloor]", 
               OverscriptBox[
                StyleBox["A", "TI"], "~"], ","}]}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                OverscriptBox[
                 RowBox[{
                   StyleBox["A", "TI"], "\[RightFloor]", 
                   StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                 False], "~"], "\[LongEqual]", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], 
               RowBox[{"\[LeftFloor]"}], 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], ",    ", 
               OverscriptBox[
                OverscriptBox[
                 RowBox[{
                   StyleBox["A", "TI"], 
                   RowBox[{"\[LeftFloor]"}], 
                   StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                 False], "~"], "\[LongEqual]", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], "\[RightFloor]", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[RightFloor]", 
               RowBox[{"(", 
                 StyleBox["B", "TI"], "\[RightFloor]"}], 
               StyleBox["C", "TI"], ")", "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], "\[Wedge]", 
                   StyleBox["B", "TI"]}], ")"}], "\[RightFloor]", 
               StyleBox["C", "TI"], ",    ", 
               StyleBox["A", "TI"], "\[RightFloor]", 
               RowBox[{"("}], 
               StyleBox["B", "TI"], 
               RowBox[{"\[LeftFloor]"}], 
               StyleBox["C", "TI"], 
               RowBox[{")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 StyleBox["A", "TI"], "\[RightFloor]"}], 
               StyleBox["B", "TI"], ")", 
               RowBox[{"\[LeftFloor]"}], 
               StyleBox["C", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[RightFloor]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["A", "TI"], "\[Wedge]", 
                   StyleBox["B", "TI"]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 StyleBox["a", "TI"], "\[RightFloor]"}], 
               StyleBox["A", "TI"], ")", "\[Wedge]", 
               StyleBox["B", "TI"], "+", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               "\[Wedge]", 
               RowBox[{"(", 
                 StyleBox["a", "TI"], "\[RightFloor]"}], 
               StyleBox["B", "TI"], ")", ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[RightFloor]", 
               StyleBox["A", "TI"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   StyleBox["A", "TI"], "-", 
                   OverscriptBox[
                    StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], 
                   StyleBox["a", "TI"]}], ")"}], ",    ", 
               StyleBox["A", "TI"], 
               RowBox[{"\[LeftFloor]"}], 
               StyleBox["a", "TI"], "\[LongEqual]", "-", 
               StyleBox["a", "TI"], "\[RightFloor]", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\
&\\gradeinverse{\\m{A}\\lc\\m{B}}=\\gradeinverse{\\m{A}}\\lc\\gradeinverse{\\\
m{B}},\\qquad\n\
\\gradeinverse{\\m{A}(\"rightcontract\")\\m{B}}=\\gradeinverse{\\m{A}}(\"\
rightcontract\")\\gradeinverse{\\m{B}},\\\\\n\
&\\reverse{\\m{A}\\lc\\m{B}}=\\reverse{\\m{B}}(\"rightcontract\")\\reverse{\\\
m{A}},\\qquad\n\
\\reverse{\\m{A}(\"rightcontract\")\\m{B}}=\\reverse{\\m{B}}\\lc\\reverse{\\m{\
A}},\\\\\n&\\cliffordconjugate{\\m{A}\\lc\\m{B}}=\\cliffordconjugate{\\m{B}}(\
\"rightcontract\")\\cliffordconjugate{\\m{A}}\n,\\qquad \
\\cliffordconjugate{\\m{A}(\"rightcontract\")\\m{B}}=\\cliffordconjugate{\\m{\
B}}\\lc\\cliffordconjugate{\\m{A}},\\\\\n\
&\\m{A}\\lc(\\m{B}\\lc\\m{C})=(\\m{A}\\w\\m{B})\\lc\\m{C},\\qquad\\m{A}\\lc(\\\
m{B}(\"rightcontract\")\\m{C})=(\\m{A}\\lc\\m{B})(\"rightcontract\")\\m{C},\\\
\\\n&a\\lc(\\m{A}\\w\\m{B})=(a\\lc\\m{A})\\w\\m{B}+\\gradeinverse{\\m{A}}\\w(\
a\\lc\\m{B}), \\\\\n\
&a\\lc\\m{A}=\\frac{1}{2}(a\\m{A}-\\gradeinverse{\\m{A}}a),\\qquad\n \
\\m{A}(\"rightcontract\") a=-a\\lc\\gradeinverse{\\m{A}}.\n\\end{aligned}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5c02b43-1582-4d20-8cf8-cc6192d56c47"],
 "\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], ",", 
         StyleBox["B", "TI"], ",", 
         StyleBox["C", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}, \\m{B}, \\m{C}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "46e6ab01-fe4b-48fe-a677-a8302f0e85bd"],
 " are general MVs and a is the vector."
}], "Item",
 CellChangeTimes->{{3.9503164334583387`*^9, 
  3.9503165109789543`*^9}},ExpressionUUID->"7156d7a3-c5d5-491a-a554-\
346aecefe482"],

