Cell[BoxData[
 RowBox[{"indexSetForn3", "=", 
  RowBox[{"Take", "[", 
   RowBox[{"allPartitionsOfFour", ",", 
    RowBox[{"2", "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"IntegerPart", "[", 
        RowBox[{"Log", "[", 
         RowBox[{"2", ",", 
          RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], 
         "]"}], "]"}], "+", "1"}], ")"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[158]:=",ExpressionUUID->"7e27530e-89ab-4674-9ce7-c2d95c3c2edd"],

