Cell[TextData[{
 "Lets construct all possible idempotents of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea956c52-92a0-438c-8fd1-5ea24c82ee71"],
 " algebra. The construction here is extremely inefficient. The idea is to \
start construction from arbitrary element {i,j,k,l} and drop all which appear \
more that once. Only suits for small algebras. In general range of each index \
should not exceed number of elements that square to one. Usually we have \
repetitions, therefore, for example in this case it is enough to limit range \
to 6 (you can verify, that we get the same answer if instead of 6 we put 9 as \
an upper range) "
}], "Text",ExpressionUUID->"13443e87-7ffc-467b-8d04-d87c1f56e953"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numberOfElementsThatSquareToOne", "=", 
  RowBox[{"Length", "[", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GeometricProduct", "[", 
        RowBox[{"#", "\[GeometricProduct]", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\""}], "]"}], ",", 
        "1"}], "]"}]}], ",", "1"}], "]"}], "]"}]}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"4fa009d4-3dd2-4404-8a90-70665dff7921"],

Cell[BoxData["9"], "Output",
 CellChangeTimes->{3.95015965249854*^9},
 CellLabel->
  "Out[114]=",ExpressionUUID->"d41ae8dd-be13-46f0-8283-42e1e8b1886c"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Union", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sort", "[", 
     RowBox[{"#", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"gaOrderedQ", "[", "\"\<InvDeg[Lex]\>\"", "]"}], "[", 
        RowBox[{"#1", ",", "#2"}], "]"}], "&"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"gaPrimitiveIdempotent", "[", 
        RowBox[{"testAlgebra", ",", 
         RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "}"}]}], ",", 
         RowBox[{"OutputForm", "\[Rule]", "\"\<Blades\>\""}], ",", 
         RowBox[{
         "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
          "\"\<InvDeg[Lex]\>\""}], ",", 
         RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", "9"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "1", ",", "9"}], "}"}]}], "]"}], ",", "3"}], 
    "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "Length"}]}], "Input",
 CellChangeTimes->{{3.9501596548586187`*^9, 3.9501596656072197`*^9}},
 CellLabel->
  "In[115]:=",ExpressionUUID->"67d4370d-51a0-467a-9d0e-5c1c27a8202e"],

