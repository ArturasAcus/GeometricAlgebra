Cell["\<\
There exists similar formula of  determinant given in A. Macdonald,  \
\[CloseCurlyDoubleQuote]Linear and Geometric Algebra\[CloseCurlyDoubleQuote] \
p.157, which utilizes inner product (note reciprocal basis vectors)\
\>", "Text",ExpressionUUID->"7f421518-0cb9-4378-af75-e064907cd247"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"a", "\[Wedge]", "b"}], "..."}], "\[Wedge]", "z"}], "=", 
   RowBox[{"det", 
    RowBox[{"(", "\[NoBreak]", GridBox[{
       {
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"a", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"b", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]},
       {"...", "...", "...", "..."},
       {
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "1"]}], 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "2"]}], "...", 
        RowBox[{"z", "\[InnerProduct]", 
         SuperscriptBox["\[DoubleStruckE]", "n"]}]}
      }], "\[NoBreak]", ")"}], " ", 
    StyleBox["I",
     FontWeight->"Bold",
     FontSlant->"Italic"]}]}]}]], "DisplayFormula",
 CellChangeTimes->{
  3.683128123737479*^9, {3.683128197472729*^9, 3.683128292862354*^9}, {
   3.683128375041707*^9, 3.68312878642068*^9}, {3.683129179353694*^9, 
   3.683129184956455*^9}, {3.68334938318907*^9, 
   3.683349434863529*^9}},ExpressionUUID->"c607c4e2-9f2c-4095-b3a1-\
ebf9ba94e076"],

Cell["\<\
Let\[CloseCurlyQuote]s check this formula for a bit larger algebra. Since \
symbolic expressions will become quite large (though easily computable), we \
will check it numerically \
\>", "Text",ExpressionUUID->"35dbb9e8-3f3d-4fbc-8b3e-e96deb22a004"],

