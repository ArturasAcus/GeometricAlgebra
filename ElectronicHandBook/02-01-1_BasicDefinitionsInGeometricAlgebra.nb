Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Reversion.",
  FontSlant->"Italic"],
 "  It reverses the order of vectors in GP, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          RowBox[{
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "1"], 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "2"], 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "3"]}], "~"], 
         "\[Congruent]", 
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", FontSlant -> "Plain"], "~"], "123"], "\[LongEqual]", 
         
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "321"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\reverse{\\e{1}\\e{2}\\e{3}}\\equiv\\reverse{\\e{}}_{123}=\\e{321}=\\e{\
3}\\e{2}\\e{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59bc633c-8850-477a-9ab3-d2d76beb2384"],
 ", and, therefore, the reversion is an anti-involution. ",
 StyleBox["In the literature, instead of tilde the dagger symbol ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Dagger]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\dagger", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "90ae4619-d586-41f0-a407-6e2f74648b07"],
 StyleBox[" is\nused sometimes. In the Handbook, the dagger symbol is \
preserved for complex GAs.",
  Background->RGBColor[0.87, 0.94, 1]],
 "\n\nProperties of reversion",
 StyleBox["[pakeista blade-> homogeneus grade-r]",
  FontColor->RGBColor[1, 0, 0]],
 "\n\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox["\[Lambda]", "~"], "\[LongEqual]", "\[Lambda]", 
               ",  ", 
               OverscriptBox[
                StyleBox["a", "TI"], "~"], "\[LongEqual]", 
               StyleBox["a", "TI"]}], 
             "scalar, vector is invariant to reversion,"}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 OverscriptBox[
                  RowBox[{
                    StyleBox["a", "TI"], 
                    StyleBox["b", "TI"], 
                    StyleBox["c", "TI"], "\[CenterEllipsis]", 
                    StyleBox["z", "TI"]}], "~"], ")"}], "\[LongEqual]", 
               StyleBox["z", "TI"], "\[CenterEllipsis]", 
               StyleBox["c", "TI"], 
               StyleBox["b", "TI"], 
               StyleBox["a", "TI"]}], 
             "action on GP of vectors reverses the order,"}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                SubscriptBox[
                 StyleBox["A", "TI"], 
                 StyleBox["r", "TI"]], "~"], "\[LongEqual]", 
               SuperscriptBox[
                RowBox[{"(", "-1", ")"}], 
                RowBox[{
                  StyleBox["r", "TI"], 
                  RowBox[{"(", 
                    RowBox[{
                    StyleBox["r", "TI"], "-", "1"}], ")"}], "/", "2"}]], 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]]}], 
             "action on homogeneous grade\[Hyphen]r multivector, "}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                SubscriptBox[
                 RowBox[{"\[LeftAngleBracket]", 
                   StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                 StyleBox["r", "TI"]], "~"], "\[Rule]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  OverscriptBox[
                   StyleBox["A", "TI"], "~"], "\[RightAngleBracket]"}], 
                StyleBox["r", "TI"]]}], "action on grade filter,"}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], "+", 
                  StyleBox["B", "TI"]}], "~"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "~"], "+", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"]}], "action on a sum of MVs,"}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], "\[Wedge]", 
                  StyleBox["B", "TI"]}], "~"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"], "\[Wedge]", 
               OverscriptBox[
                StyleBox["A", "TI"], "~"]}], 
             "action on outer product of MVs,"}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], 
                  StyleBox["B", "TI"]}], "~"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"], 
               OverscriptBox[
                StyleBox["A", "TI"], "~"]}], 
             "action on geometric product of MVs,"}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    OverscriptBox[
                    StyleBox["A", "TI"], "~"], 
                    OverscriptBox[
                    StyleBox["B", "TI"], "~"]}], "\[RightAngleBracket]"}], 
                "0"], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    StyleBox["A", "TI"], 
                    StyleBox["B", "TI"]}], "\[RightAngleBracket]"}], "0"]}], 
             " property for scalar part."}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n&\\reverse{\\lambda}=\\lambda,\\quad \\reverse{a}=a &\
\\text{scalar, vector is invariant to reversion,}\\\\\n&(\\reverse{abc\\cdots \
z})=z\\cdots cba  & \\text{action on GP of vectors reverses the order,}\\\\&\n\
\\reverse{A_r}=(-1)^{r(r-1)/2}A_r& \\text{action on homogeneous grade-r \
multivector, }\\\\&\n  \
\\reverse{\\grade{\\m{A}}{r}}\\rightarrow\\grade{\\reverse{\\m{A}}}{r} \
&\\text{action on grade filter,}\\\\&\n\\reverse{\\m{A}+\\m{B}}= \
\\reverse{\\m{A}}+\\reverse{\\m{B}}& \\text{action on a sum of MVs,}\\\\&\n\
\\reverse{\\m{A}\\w \\m{B}}=\\reverse{\\m{B}}\\w\\reverse{\\m{A}}& \
\\text{action on outer product of MVs,}\\\\&\n\
\\reverse{\\m{A}\\m{B}}=\\reverse{\\m{B}}\\reverse{\\m{A}} & \\text{action on \
geometric product of MVs,}\\\\&\n\
\\grade{\\reverse{\\m{A}}\\reverse{\\m{B}}}{0}=\\grade{\\m{A}\\m{B}}{0}&\\\
text{\nproperty for scalar part.}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dd2338b-82ea-4b2d-89b6-5bbe2904e8d3"],
 "\[LineSeparator]\nIn real Euclidean  GA ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["n", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{n}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1fed2e8d-d80d-48b1-9244-d599606b113a"],
 ", the reversion is an analogue of a matrix transposition. In complex \
Euclidean GA it is analogue of Hermitian conjugation of a matrix. In \
non-Euclidean vector spaces the matrix transposition (and Hermitian \
conjugation) requires some additional GA conjugations (see explicit formulas \
below)."
}], "Item",
 CellTags->
  "ReversionMain",ExpressionUUID->"a37167cb-1619-4368-be5a-77c726cba612"],

