Cell[TextData[{
 "Important! When dealing with orthonormal basis, we of course in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i\\cdot e^j=e^j\\cdot e_i=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "81d68851-e529-493b-b127-cfc59defeb74"],
 " can replace inner product by geometric product:   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[EmptySmallCircle]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[EmptySmallCircle]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i \\circ e^j=e^j\\circ e_i=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3fbb79c7-e0df-43af-80cc-a231e949a00e"],
 ". However, in nonorthonormal basis this is not valid and you will get \
different answers if you replace inner product by geometric one! Always keep \
in mind that primary and reciprocal vectors are related by inner product,  \
and the relation is then valid for  arbitrary basis of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
