    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30839cdc-4ff2-40ac-b22e-03ee2bc09636"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{0,3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "704f3de2-5697-4082-8406-9c155a8a2d5e"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
