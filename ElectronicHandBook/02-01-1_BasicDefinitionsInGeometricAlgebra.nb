Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Scalar part or trace of MV via conjugation",
  FontSlant->"Italic"],
 ".  The conjugation Table  allows to express the scalar part ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\m{U}\\rangle_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44caef57-8b99-4016-a5f0-968cf34f117b"],
 " of MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["U", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5e86598-692e-4412-9b3c-4e3507e68d58"],
 " via elementary conjugations as\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], 
         "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox["2", 
           StyleBox["m", "TI"]]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["U", "TI"], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "1"]], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "2"]], "+", "\[Ellipsis]", 
             "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "12"]], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "13"]], "+", "\[Ellipsis]", 
             "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", 
               RowBox[{"123", "\[Ellipsis]", 
                 StyleBox["m", "TI"]}]]]}], ")"}], ",  ", 
         StyleBox["m", "TI"], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["log", "2"], 
             StyleBox["n", "TI"]}], "]"}], "+", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\langle \
\\m{U}\\rangle_0=\\frac{1}{2^m}(\\m{U}+\\m{U}^{\\vartriangle_1}+\\m{U}^{\\\
vartriangle_2}+\\dots+\\m{U}^{\\vartriangle_{12}}+\n\
\\m{U}^{\\vartriangle_{13}}+\\dots+\\m{U}^{\\vartriangle_{123\\dots\n\
m}}),\\quad m=[\\log_2 n]+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdbe6a85-0733-4c9d-ba45-a05e185a2742"],
 ",\[LineSeparator]\n where the square brackets over the logarithm  indicate \
the integer part   of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["log", "2"], 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\log_2 n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f841873-40eb-46b2-b535-a689b0bc2495"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=p+q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f0d14db-6c11-4974-80b6-ef53fd58102a"],
 ". In particular, the formula gives\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], 
         "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"\[Null]", 
                 RowBox[{
                   FractionBox["1", "2"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["U", "TI"], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "1"]]}], ")"}], 
                   "\[LongEqual]", 
                   FractionBox["1", "2"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["U", "TI"], "+", 
                    OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False]}], ")"}], "  ", " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "1", ","}]}, {
                "\[Null]", 
                 RowBox[{
                   FractionBox["1", "4"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["U", "TI"], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "1"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "2"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "12"]]}], ")"}], 
                   "\[LongEqual]", 
                   FractionBox["1", "4"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["U", "TI"], "+", 
                    OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], "+", 
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "+", 
                    OverscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], "~"]}], ")"}], "  ", " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "2", ",", "3", 
                   ","}]}, {"\[Null]", 
                 RowBox[{
                   FractionBox["1", "8"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["U", "TI"], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "1"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "2"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "12"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "13"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "23"]], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "123"]]}], ")"}], "  ",
                    " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "4", ",", "5", ",", 
                   "6", ",", "7."}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\langle\\m{U}\\rangle_0=\n\\begin{cases}\n\
&\\frac12(\\m{U}+\\m{U}^{\\vartriangle_1})=\\frac12(\\m{U}+\\gradeinverse{\\m{\
U}})\\quad\\text{\\ if\\ } n=1,\\\\\n\
&\\frac14(\\m{U}+\\m{U}^{\\vartriangle_1}+\\m{U}^{\\vartriangle_2}+\\m{U}^{\\\
vartriangle_{12}})\n \
=\\frac14(\\m{U}+\\gradeinverse{\\m{U}}+\\reverse{\\m{U}}+\\cliffordconjugate{\
\\m{U}})\\quad \\text{\\ if\\ } n=2,3,\\\\\n  \
&\\frac18(\\m{U}+\\m{U}^{\\vartriangle_1}+\\m{U}^{\\vartriangle_2}+\\m{U}^{\\\
vartriangle_{12}}+\n  \
\\m{U}^{\\vartriangle_3}+\\m{U}^{\\vartriangle_{13}}+\\m{U}^{\\vartriangle_{\
23}}+\\m{U}^{\\vartriangle_{123}})\\quad \\text{\\ if\\ } n=4,5,6,7.\n\
\\end{cases}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "afa624ca-18b3-4d08-bc5b-a73e58ce4162"],
 "\n\nThe first three coincide with the main conjugations: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Null]", "1"], "\[Congruent]", 
         OverscriptBox["..", "\[Cap]", LimitsPositioning -> False], " ", ", ",
          "2", "\[Congruent]", 
         OverscriptBox["..", "~"], " ", ", ", 
         SubscriptBox["\[LongEqual]", "1"], "2", "\[Congruent]", 
         OverscriptBox[
          OverscriptBox["..", "\[Cap]", LimitsPositioning -> False], "~"], 
         " "}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\vartriangle_1\\equiv\\gradeinverse{..}\\,,\\, \
\\vartriangle_2\\equiv\\reverse{..}\\,,\\, \\vartriangle_{12}=\\vartriangle_1\
\\vartriangle_2\\equiv\\cliffordconjugate{..}\\,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f250ccfe-8373-4eb1-aea6-46213d60f81c"],
 ". The scalar part ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{U}\\rangle_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "972964c8-7daa-4dcf-87ca-ec6ee3da1b73"],
 " is related to MV trace by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Tr", 
         RowBox[{"(", 
           StyleBox["U", "TI"], ")"}], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox["2", 
           StyleBox["m", "TI"]]], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{Tr}(\\m{U})=\\frac{1}{2^m}\\langle\\m{U}\\rangle_0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63c69d5c-3f8b-430d-9b0b-7145af26b768"],
 "."
}], "Subitem",ExpressionUUID->"db7897e8-c9bb-4f98-9d27-36a139c8f913"],

