Cell[TextData[{
 "Inner product  (the symbol again differ from Mathematica\[CloseCurlyQuote]s \
default ",
 StyleBox["Dot[]",
  FontWeight->"Bold"],
 " ).  It can be conveniently entered as  \[EscapeKey]ip\[EscapeKey], [",
 StyleBox["mnemonic: first letters of product name (i)nner (p)roduct",
  Background->RGBColor[0.87, 0.94, 1]],
 "]  or one can use full command name ",
 StyleBox["InnerProduct[ ]",
  FontWeight->"Bold"],
 ". For example,  outer product of two random multivectors can be computed \
as"
}], "Text",ExpressionUUID->"2cec7e5e-2211-4187-b4b3-ec28561bb80f"],

