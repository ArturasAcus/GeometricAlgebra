Cell[TextData[{
 "Expansion of vector (grade-1 element). Test of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["j", "TI"]], 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], 
                  StyleBox["j", "TI"]]}], ")"}]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], 
             SubsuperscriptBox["\[Delta]", 
              StyleBox["j", "TI"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["a", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{e}_{i}(\\mathrm{e}_{}^i\\cdot \
a)=\\mathrm{e}_{i}(\\mathrm{e}_{}^i\\cdot\n\
(a^j\\mathrm{e}_{j}))=\\mathrm{e}_{i}(a^j\\delta_j^i)=a^i\\mathrm{e}_{i}= a=\n\
r\\langle a\\rangle_r,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54718b7c-d93b-45fe-b301-4e4e566cf062"],
 " for ",
