Cell[TextData[{
 "Property ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"A", "\[LeftContract]", 
     RowBox[{"(", 
      RowBox[{"B", "\[LeftContract]", "C"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"A", "\[OuterProduct]", "B"}], ")"}], "\[LeftContract]", 
     "C"}]}], TraditionalForm]],ExpressionUUID->
  "b7c633e5-0d56-4345-9298-452f0dedb469"],
 " . Often we will wrap intermediate expressions with ",
