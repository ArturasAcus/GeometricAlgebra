Cell[BoxData[
 RowBox[{"CreatePalette", "[", 
  RowBox[{"Button", "[", 
   RowBox[{"\"\<Toggle inline cells editable option to false\>\"", ",", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "inlineCells", "}"}], ",", 
      RowBox[{
       RowBox[{"inlineCells", "=", 
        RowBox[{
         RowBox[{"Cells", "/@", 
          RowBox[{"Cells", "@", 
           RowBox[{"InputNotebook", "[", "]"}]}]}], "//", "Flatten"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CurrentValue", "[", 
             RowBox[{"#", ",", "Editable"}], "]"}], "===", "True"}], ",", 
           RowBox[{"SetOptions", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Editable", "->", "False"}]}], "]"}], ",", 
           RowBox[{"SetOptions", "[", 
            RowBox[{"#", ",", 
             RowBox[{"Editable", "->", "True"}]}], "]"}]}], "]"}], "&"}], "/@",
         "inlineCells"}]}]}], "]"}]}], "]"}], "]"}]], "Input",
 Evaluatable->False,
 CellChangeTimes->{{3.91100848134296*^9, 3.91100850257568*^9}, {
   3.91100857039575*^9, 3.911008656907335*^9}, 
   3.911009889257887*^9},ExpressionUUID->"4d3abada-7716-4f03-90d7-\
03e486a9b509"],

