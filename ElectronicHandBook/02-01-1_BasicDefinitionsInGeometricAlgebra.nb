Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Clifford conjugation.",
  FontSlant->"Italic"],
 "  It is a combination of the grade inversion and reversion. Because under \
grade inversion  the order of arguments  changes the operation is the \
anti-involution.\[LineSeparator]\nProperties of Clifford conjugation\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox[
                OverscriptBox[
                "\[Lambda]", "\[Cap]", LimitsPositioning -> False], "~"], 
               "\[LongEqual]", "\[Lambda]", ",    ", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["a", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], "\[LongEqual]", "-", 
               StyleBox["a", "TI"]}], 
             RowBox[{"    ", "scalar, vector", ","}]}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                OverscriptBox[
                 SubscriptBox[
                  StyleBox["A", "TI"], 
                  StyleBox["r", "TI"]], "\[Cap]", LimitsPositioning -> False],
                 "~"], "\[LongEqual]", 
               SuperscriptBox[
                RowBox[{"(", "-1", ")"}], 
                FractionBox[
                 RowBox[{
                   StyleBox["r", "TI"], "(", 
                   RowBox[{
                    StyleBox["r", "TI"], "+", "1"}], ")"}], "2"]], 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]], "    "}], 
             RowBox[{"action on homogeneous grade\[Hyphen]r MV", ","}]}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                OverscriptBox[
                 SubscriptBox[
                  RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                  StyleBox["r", "TI"]], "\[Cap]", LimitsPositioning -> False],
                 "~"], "\[LongEqual]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    OverscriptBox[
                    OverscriptBox[
                    StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], "~"], "  "}], "\[RightAngleBracket]"}], 
                StyleBox["r", "TI"]]}], 
             RowBox[{"grade filter", ","}]}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 OverscriptBox[
                  OverscriptBox[
                   RowBox[{
                    StyleBox["A", "TI"], "+", 
                    StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                   False], "~"], ")"}], "\[LongEqual]", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], "+", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"]}], " action on a sum of MVs,"}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 OverscriptBox[
                  OverscriptBox[
                   RowBox[{
                    StyleBox["A", "TI"], 
                    StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                   False], "~"], ")"}], "\[LongEqual]", 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"], 
               OverscriptBox[
                OverscriptBox[
                 StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
                "~"]}], "action on product of MVs."}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n&\\cliffordconjugate{\\lambda}=\\lambda,\\qquad \
\\cliffordconjugate{a}=-a&\\qquad \\text{scalar,  vector},\\\\\n\
&\\cliffordconjugate{A_r}=(-1)^{\\frac{r(r+1)}{2}}A_r\\qquad& \\text{action \
on homogeneous grade-r MV}, \\\\\n  \
&\\cliffordconjugate{\\grade{A}{r}}=\\grade{\\cliffordconjugate{A}\\,\\,}{r}  \
&\\text{grade filter},\\\\\n&(\\cliffordconjugate{\\m{A}+\\m{B}})= \
\\cliffordconjugate{\\m{A}}+\\cliffordconjugate{\\m{B}}&\\text{ action on a \
sum of MVs,}\\\\\n&  (\\cliffordconjugate{\\m{A} \
\\m{B}})=\\cliffordconjugate{\\m{B}}\\cliffordconjugate{\\m{A}}& \
\\text{action on product of   MVs.}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "294f3dc9-e395-4f75-ba0a-afec61d84032"],
 "\[LineSeparator]\nFor example, if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "T=\\e{1}\\e{2}\\e{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ffa89a29-10df-4d50-9b89-1ee9e79dd6ac"],
 " then the Clifford conjugation is calculated as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["T", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", 
         StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cliffordconjugate{T}=(-\\e{3})(-\\e{2})(-\\e{1})=\\e{1}\\e{2}\\e{3}=\
T", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "255382cb-7218-4db0-9393-eaceb9e25997"],
 ".  In the future we will not distinguish the involution from \
anti-involution, and all of them will be called collectively the \
involutions."
}], "Item",ExpressionUUID->"f7f9f1e1-30d7-426e-bb6e-75b4749fe25f"],

