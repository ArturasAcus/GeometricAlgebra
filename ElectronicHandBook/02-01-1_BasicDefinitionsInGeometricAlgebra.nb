                StyleBox["e", FontSlant -> "Plain"], "45"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "45"], " ", "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n  \
\\sum_{A:\\m{A}=\\grade{\\m{A}}{2}}\\e{A}^{-1}\\m{U}\\e{A}=&\n  -\\e{1 \
2}\\m{U}\\e{1 2}+\\e{1 3}\\m{U}\\e{1 3}+\\e{1 4}\\m{U}\\e{1 4}+\\e{1 5}\\m{U}\
\\e{1 5}+\\e{2 3}\\m{U}\\e{2 3}\\\\[-5pt]\n  &  +\\e{2 4}\\m{U}\\e{2 4}+\\e{2 \
5}\\m{U}\\e{2 5}-\\e{3 4}\\m{U}\\e{3 4}-\\e{3 5}\\m{U}\\e{3 5}-\\e{4 5}\\m{U}\
\\e{4 5}\\,.\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e9d79e08-43c1-4809-bbb5-5f22d4c2a218"],
 "\n\nOf course, in general, the multi-index is not restricted to a fixed \
grade but also may include the sets of grades having different lengths."
}], "Subitem",ExpressionUUID->"2d071ced-2ad6-48ac-b8bd-e5eb3cd17e77"],

