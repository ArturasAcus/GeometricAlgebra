Cell[BoxData[
 RowBox[{
  RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"a", ",", "testAlgebra", ",", 
     RowBox[{"{", "1", "}"}]}], "]"}], "\[InnerProduct]", 
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"b", ",", "testAlgebra", ",", 
     RowBox[{"{", "1", "}"}]}], "]"}]}]}]], "Input",
