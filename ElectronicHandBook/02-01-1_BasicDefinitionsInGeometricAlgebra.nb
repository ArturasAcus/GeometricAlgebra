Cell[TextData[{
 "Most general involutions can be computed with  ",
 StyleBox["gaGradeNegate[mv, gradesToNegate_List]",
  FontWeight->"Bold"],
 ". For example ",
 StyleBox["gaReverse[ ]",
  FontWeight->"Bold"],
 " is (grades that are absent are ignored, since they don\[CloseCurlyQuote]t \
present in the expression)"
}], "Text",ExpressionUUID->"77122fc5-e93c-47c2-8c4e-810da097a1b3"],

