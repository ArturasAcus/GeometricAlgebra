Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Primitive idempotents of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"4", ",", "5"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{4}{5}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ac33df6-8afe-4ba5-a7d0-4b97c5fcab6c"],
 ".  Radon-Hurwitz number ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{"5", "-", "4"}]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r_{5-4}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ef75dca-019c-438b-8352-ea1ab5a9d938"],
 " for the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"4", ",", "5"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{4}{5}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1129d5e0-371b-4977-9979-8718e1a7d9a9"],
 " imply that the primitive idempotent of the algebra consists of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["q", "TI"], "-", 
             SubscriptBox[
              StyleBox["r", "TI"], 
              RowBox[{
                StyleBox["q", "TI"], "-", 
                StyleBox["p", "TI"]}]]}], ")"}], "\[LongEqual]", "5", "-", 
         SubscriptBox[
          StyleBox["r", "TI"], 
          RowBox[{"5", "-", "4"}]], "\[LongEqual]", "5", "-", "1", 
         "\[LongEqual]", "4"}], TraditionalForm], "errors" -> {}, "input" -> 
     "(q-r_{q-p})=5-r_{5-4}=5-1=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd719ead-abb5-4430-af06-a093489b7477"],
 " factors that are related with four blades ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bd4e1d0a-df6d-4010-8564-da8a0bfd04e7"],
 " as described in",
 Cell[BoxData[
  FormBox[
   ButtonBox["Table",
    BaseStyle->"Hyperlink",
    ButtonData->"TableOfIdempotents"], TraditionalForm]],ExpressionUUID->
  "56193b6e-e841-436b-ae2d-9810b3a43d3e"],
 ". They may be  arranged in the inverse degree ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"lexicographic", " ", "order"}],
    BaseStyle->"Hyperlink",
    ButtonData->"OrderingMain"], TraditionalForm]],ExpressionUUID->
  "2fbea059-f4b7-4df6-9d37-f6fdd125fcec"],
 " in the idempotent  ",
 Cell[BoxData[
  FormBox[
   ButtonBox["Table",
    BaseStyle->"Hyperlink",
    ButtonData->"TableOfIdempotents"], TraditionalForm]],ExpressionUUID->
  "ee1f5534-b7a9-4e7f-a2f2-b09a901d5d30"],
 ", namely, in the order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "25"], ",", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "36"], ",", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "47"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{1},\\e{25},\\e{36},\\e{47}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fe6451df-7676-4962-b2cf-8d1df8903c45"],
 ". The primitive idempotent constructed from these blades is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"4", ",", "5"}]]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "25"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "36"]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "47"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{4}{5}}={\\frac{1}{2}}(1+ \\e{1}){\\frac{1}{2}}(1+ \
\\e{25}){\\frac{1}{2}}(1+ \\e{36}){\\frac{1}{2}}(1+ \\e{47})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ceb53958-a88c-4738-8e0c-3becc044e26f"],
 "."
}], "Subitem",ExpressionUUID->"e1c540b6-791b-4f52-b3b1-4afbbede826a"],

