Cell[TextData[{
 "Since orthonormality relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]], ",  ", 
         StyleBox["i", "TI"], ",", 
         StyleBox["j", "TI"], "\[LongEqual]", "1", "\[Ellipsis]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot \\mathrm{e}_{}^j=\\delta_i^j,\\quad i,j=1\\dots \
n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad8d3451-bd5f-4b1f-9e9a-a4e1bf698541"],
 " was already checked before,  we check only the summation formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot \\mathrm{e}_{}^i=\\mathrm{e}_{}^i\\cdot \
\\mathrm{e}_{i}=\\mathrm{e}_{}^i\\mathrm{e}_{i}=n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bafa631-4f89-4313-aecb-9480582606da"],
 " "
}], "Text",ExpressionUUID->"0228d55e-8551-4e42-970d-97009c8aad19"],

