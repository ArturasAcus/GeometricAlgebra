Cell[TextData[{
 "Since many functions are not optimized for large algebras like ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"9", ",", "6"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{9}{6}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6dd744f-c6b8-42cb-8dc6-715779b95295"],
 ", for computation of table we simply select representatives of all grades. \
From the above code we see that in general there are 32768 basis elements, \
from which we select representatives at basis elements ",
 StyleBox["representativeBasisElements",
  FontWeight->"Bold"],
 ", (obtained by grouping basis by grades). Then construct general element \
using ",
 StyleBox["gaGetMV[generalMV, {\[DoubleStruckE][1,2,3...]}]",
  FontWeight->"Bold"],
 ", which takes elements at listed basis elements."
}], "Text",ExpressionUUID->"9003b7b3-0e04-459e-9bcc-8e3e128bd8ba"],

Cell["\<\
