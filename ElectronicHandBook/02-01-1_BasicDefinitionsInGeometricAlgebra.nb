Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Zero divisor",
  FontSlant->"Italic"],
 ".  If the product of two MV\[CloseCurlyQuote]s ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67963149-ff08-447d-b35b-4868fc43767d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f492a5dd-fe99-4dc3-af34-7c3e10581af3"],
 " is equal to zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         StyleBox["B", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{A}\\m{B}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3c35ac1-7ece-4ea0-afb3-e7c610853bc8"],
 ", and neither ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "faac5e12-eb8e-46ed-ac0d-3a5686e89536"],
 " nor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc5da590-7662-4085-a150-6f251b73032e"],
 " is zero then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c7f52bb-619a-49bc-9e8e-e9513300ba95"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e70c0b59-0787-4bf7-a33c-1cf6944b0a84"],
 " are said to be zero divisors. Zero divisor has no inverse.  Simple \
idempotents ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "\[PlusMinus]", 
              SubscriptBox[
               StyleBox["B", "TI"], 
               SubscriptBox[
                StyleBox["T", "TI"], 
                StyleBox["i", "TI"]]]}], ")"}], "2"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"1", "\[PlusMinus]", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(1\\pm B_{T_i})^2=(1\\pm\nB_{T_i})\\ne 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41bd3fff-16c9-42b6-89d9-a6e828ac6ca6"],
 " are zero divisors, since they satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "(1+\nB_{T_i})(1- B_{T_i})=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b868e886-0bbb-43b5-9b7d-059e79d6be7c"],
 "."
}], "Item",ExpressionUUID->"d1f6a1b0-250a-4795-8df0-3274937e649c"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Zero divisors of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "4104b1d9-f08e-414e-8ad6-1303888d3f31"],
 ".   In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e510982e-e5eb-4e4b-a6c0-94117df9c4df"],
 " algebra the MVs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}=\\frac{1}{2}(1-\\e{3})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "207db71f-8a05-48f4-b002-bf1c745c66a9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}=\\frac{1}{2}(1+\\e{3})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ebe6c91-aa51-4bae-9859-8038657b4dc5"],
 " are zero divisors, since their product is zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         StyleBox["B", "TI"], "\[LongEqual]", 
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", "1", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "1", "-",
          "1", "\[LongEqual]", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\m{A}\\m{B}=\\frac{1}{4}(1-\\e{3})(1+\\e{3})=1-\\e{3}\\e{3}=1-1=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0377bcd6-32eb-4b2d-9f8c-e3831d565b06"],
 ". These elements also are idempotents: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}^2=\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b55d24af-6565-466e-a04b-c4bcb7d69108"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "2"], "\[LongEqual]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}^2=\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a9b5084-c7c0-4542-b978-8c82fc08691a"],
 "."
}], "Subitem",
 CellTags->
  "PrimitiveIdempcl30",ExpressionUUID->"1daac272-945a-4e51-b08f-8d2911ae10a0"],

