Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Adding more GP properties to vector",
  FontSlant->"Italic"],
 ".  This section is misleading and is not included in an electronic version. \
The main problem of extending geometric multiplication to vectors only is \
that it will not  make a closed space, therefore, strictly speaking it is not \
mathematically valid. "
}], "Item",ExpressionUUID->"5ada8e26-1e44-4460-a85b-102596940649"],

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\tG",
 StyleBox["raded vector space and multivector",
  FontSlant->"Italic"],
 ".  Geometric objects characterized by oriented lengths, areas, volumes, \
etc. are totally different objects in a sense that they lie in disjointed \
subspaces ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "i"], "n"], TraditionalForm]],
  ExpressionUUID->"06235a0f-1fd9-4b2f-bfa5-78d4c012c393"],
 " characterized by grade ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["i", "TI"], TraditionalForm], "errors" -> {}, "input" -> "i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2c8f1f4e-f0de-4e7d-bc60-7ea258f44aca"],
 ". When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "i=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "416d0327-a1db-4ce4-8e3f-a11106614c13"],
 ", we have the vector subspace, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b4dc756-7d0b-4d56-9f26-0688885feeb4"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "1"], "n"], TraditionalForm]],
  ExpressionUUID->"f121a589-9703-48d0-af8c-d9d8796649ce"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Congruent]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\equiv", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95b34c2c-0244-4b79-9c3f-4b9fe383109a"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "44b0eca5-3f48-41ff-8afe-7b5642abd2b9"],
 ". When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "i=2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3a75f80-aa4e-4486-b2a7-70b1b3ccaa41"],
 ", we have the bivector subspace, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\wedge b\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3b0ead1-a566-415a-a862-479d657c9121"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"339ece2d-ff74-4a32-8546-6568ebf8d306"],
 ". When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "i=3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a25e26f-0ecc-4323-8abc-f8b7c63bc457"],
 ", we have the trivector subspace, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\wedge b\\wedge c\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36a5dcaa-e4b8-478e-b801-be6671308d75"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "3"], "n"], TraditionalForm]],
  ExpressionUUID->"d46ca7df-594c-4c52-ad66-627282006cd9"],
 ". Finally, when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c1dcded-957c-43f7-b162-28402cfdb965"],
 " we have the pseudoscalar subspace, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["n", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "I_n\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8077c5eb-e478-4161-9e82-1874e3b81b59"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "n"], "n"], TraditionalForm]],
  ExpressionUUID->"20bece37-a451-429f-a3a8-ff08579401ec"],
 ". If a scalar subspace ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76d502cc-6f49-49b9-881e-90ee683e09cd"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "0"], "n"], TraditionalForm]],
  ExpressionUUID->"af125e5d-cb58-4d01-81a6-551c8281c749"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Congruent]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\equiv", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1ac7da6-1ae6-400f-aab1-04fd573ad355"],
 "\[DoubleStruckCapitalR] is added, the formal sum of listed subspaces makes \
a larger and closed space, called the graded vector space, \n",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "d6707818-70fb-40a4-bb98-34689e623e61"],
 "=",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "0"], "n"], TraditionalForm]],
  ExpressionUUID->"8dacaadc-f13b-4af4-859b-95927910cfc8"],
 "+",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "1"], "n"], TraditionalForm]],
  ExpressionUUID->"194e8ad5-108a-4cf0-b133-d2905eacdd66"],
 "+",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"08065836-e859-412b-a0e1-f8598e217d95"],
 "+",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "3"], "n"], TraditionalForm]],
  ExpressionUUID->"0546ab8a-cfcf-4857-b2b4-ea042c553534"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"+", "\[Ellipsis]", "+"}], TraditionalForm], "errors" -> {}, 
     "input" -> "+\\dots+", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c64aa09-eeea-45d4-8fc1-5fddaacefac9"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "n"], "n"], TraditionalForm]],
  ExpressionUUID->"4005cb4a-eada-4b18-86d1-7f11a059f3b2"],
 ". Since the geometric objects of different subspaces do not mix up and, if \
needed, can be isolated by grade selector, they can be formally added to form \
a new object called the multivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{M}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5778ebf5-e537-4444-919b-e949107f9e1b"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "1aab2784-f398-46db-92ec-a111730f286c"],
 ". Thus, the graded vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "cbe72a93-318c-4d6b-b4d5-720b702a1cd2"],
 " consists  of multivectors (MVs):  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         StyleBox["s", "TI"], "+", 
         StyleBox["a", "TI"], "+", 
         StyleBox["B", "TI"], "+", 
         StyleBox["T", "TI"], "+", "\[Ellipsis]", "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "0"], "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "1"], "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "2"], "+", 
         "\[CenterEllipsis]", "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}=s+a+\\mathcal{B}+T+\\dots+I_n \
=\\langle\\m{M}\\rangle_{0}+\\langle\\m{M}\\rangle_{1}+\\langle\\m{M}\\rangle_\
{2}+\\cdots +\\langle\\m{M}\\rangle_{n}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0c01a202-07e6-47a4-9d99-dca2d7b3a645"],
 ". In a concrete case, some grades in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f3f7593-abf7-434c-9e80-0df5f9c362a3"],
 " may be missing. Extraction of components from the MV  is realized by grade \
selection operator, or grade-r filter, which is denoted by symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["M", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{M}\\rangle_{r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abf6f122-6d50-4cf2-9a99-2c8b8871d47c"],
 ". Two MVs, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["v", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["B", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["T", "TI"], "1"], "+", "\[Ellipsis]", "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          SubscriptBox[
           StyleBox["n", "TI"], "1"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{M}_1=s_1+v_1+\\mathcal{B}_1+T_1+\\dots+I_{n_1}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "34402f06-32b7-4d70-8afc-cc82a2f8f2c8"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["M", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["v", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["B", "TI"], "2"], "+", 
         SubscriptBox[
          StyleBox["T", "TI"], "2"], "+", "\[Ellipsis]", "+", 
         SubscriptBox[
          StyleBox["I", "TI"], 
          SubscriptBox[
           StyleBox["n", "TI"], "2"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{M}_2=s_2+v_2+\\mathcal{B}_2+T_2+\\dots+I_{n_2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef2b1d94-c9f5-4854-a81a-441f12afcb5e"],
 ",  are equal if all terms in respective subspaces are equal, i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["s", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["s", "TI"], "2"], ",", 
         SubscriptBox[
          StyleBox["v", "TI"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["v", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "s_1=s_2, v_1=v_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82a84a8f-6619-413c-93fb-0f5ae20d165c"],
 ", etc. The MV is equal to zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{M}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0219e7d-3cab-4ad5-92c3-a42893c31871"],
 ", if all its constituent elements are equal to zero: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["s", "TI"], "\[LongEqual]", "0", ",", 
         StyleBox["v", "TI"], "\[LongEqual]", "0", ",", 
         StyleBox["B", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "s=0, v=0, \\mathcal{B}=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc33a061-8e97-4500-950c-235bb31d4215"],
 " etc."
}], "Item",
 CellChangeTimes->{{3.9119627374784203`*^9, 
  3.911962747427667*^9}},ExpressionUUID->"fd6ff949-3798-480d-bd5d-\
edb3f7a714d7"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of geometric product",
  FontSlant->"Italic"],
 ".  The GA properties of vectors V0-V8 can be generalized to MVs.  The GP of \
two MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "41a3fea8-be58-4bcd-9917-7eb632eed0a6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "044c819d-639e-4d9b-8dc3-696f1099d0a1"],
 " is written as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         StyleBox["B", "TI"], "\[Congruent]", 
         StyleBox["A", "TI"], "\[EmptySmallCircle]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}\\m{B}\\equiv \\m{A}\\circ\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ade1be1c-c6fc-4e64-bad8-38c63cfceb15"],
 " . It is non-commutative, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], 
         StyleBox["B", "TI"], "\[NotEqual]", 
         StyleBox["B", "TI"], 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}\\m{B}\\ne\\m{B}\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14c1b6ce-1c52-4a66-87a1-671487137e0b"],
 ". Under GP the separate subspaces ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "i"], "n"], TraditionalForm]],
  ExpressionUUID->"8fde2f79-9d03-4f08-8b36-c74a6dad9342"],
