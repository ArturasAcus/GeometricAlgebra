Cell[TextData[{
 "8-th formula, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], 
          StyleBox["r", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "2", 
             StyleBox["r", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}A_r\\mathrm{e}_{}^i=(-1)^r(n-2r)A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b49c57ca-e61c-47fc-a06a-ffdea680097c"]
