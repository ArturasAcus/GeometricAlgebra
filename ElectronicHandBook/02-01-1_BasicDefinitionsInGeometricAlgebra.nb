Cell[TextData[{
 "For example test  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{
             OverscriptBox[
              StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], "+", 
             OverscriptBox[
              StyleBox["U", "TI"], "~"], "+", 
             OverscriptBox[
              OverscriptBox[
               StyleBox["U", "TI"], "~"], "\[Cap]", LimitsPositioning -> 
              False], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
             SuperscriptBox[
              OverscriptBox[
               StyleBox["U", "TI"], "^"], 
              SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
             SuperscriptBox[
              OverscriptBox[
               StyleBox["U", "TI"], "~"], 
              SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
             SuperscriptBox[
