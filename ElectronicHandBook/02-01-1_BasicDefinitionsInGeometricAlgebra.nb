Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Tensor-like notation",
  FontSlant->"Italic"],
 ". Kronecker delta definition  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"1", 
                 RowBox[{"  ", "if", 
                   StyleBox["i", "TI"], "\[LongEqual]", 
                   StyleBox["j", "TI"]}]}, {"0", 
                 RowBox[{"  ", " if", 
                   StyleBox["i", "TI"], "\[NotEqual]", 
                   StyleBox["j", "TI"]}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\delta_{ij}=\\begin{cases}1& \\quad \\text{if} i=j \\\\ 0 &\\quad \
\\text{ if} i\\neq j\\end{cases}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b799645a-dfff-49de-b08d-03cdefa46deb"],
 ". Alternating tensor definition ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Epsilon]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"]}]], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"1", 
                 RowBox[{"  ", "if", " ", 
                   RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"], 
                    StyleBox["k", "TI"]}], " is a cyclic permutation of ", 
                   "123"}]}, {"-1", 
                 RowBox[{"  ", " is a anticyclic permutation of ", "123"}]}, {
                "0", 
                 RowBox[{"  ", " otherwise"}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\varepsilon_{ijk}=\\begin{cases}1& \\quad \\text{if}\\ {ijk} \\text{\\ \
is a cyclic permutation of\\ }123 \\\\ -1 &\\quad \\text{\\ is a anticyclic \
permutation of\\ }123\\\\ 0 &\\quad \\text{\\ otherwise}\\end{cases}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "45bcc88a-6a7e-468f-9f3b-611ade066798"],
 ". So that in the tensor notation  the cross product of basis vectors in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{3,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7420f0cd-d062-48c0-bba0-9e869ab5b270"],
 " GA may be written as:\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Epsilon]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], 
            StyleBox["k", "TI"]}]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\fattimes\\mathrm{e}_{j}=\\varepsilon_{ijk}\\mathrm{e}_{\
k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "887e8cb5-fdc6-4d3e-b54c-5d5110c77353"],
 " \t\t(cross product in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{3,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0864388b-0022-4a1a-abd6-46fea67cfc11"],
 " )\[LineSeparator]\nThe cross product of two vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff7b658e-87eb-4127-a358-a4e379cb9376"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8be4f7a-9e2d-4b1d-93ee-ffc1d14359ca"],
 " then is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Cross]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox["\[Epsilon]", 
              RowBox[{
                StyleBox["i", "TI"], 
                StyleBox["j", "TI"], 
                StyleBox["k", "TI"]}]], 
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["b", "TI"], 
              StyleBox["j", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a{\\bf \\times} b=(\\varepsilon_{ijk}a_ib_j)\\mathrm{e}_{k}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92632f04-15bd-4ecd-81cb-d543e4ec1adc"],
 " "
}], "Item",ExpressionUUID->"0c96adde-ad5d-4d1f-9003-560773f2beb8"],

