 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"5ab08492-5a42-4a6a-9bb8-608ff4082496"],

Cell[CellGroupData[{

Cell["Choose algebra and generate general MV.  ", "Text",ExpressionUUID->"c46517d4-adba-4837-9264-f2afed376e71"],

Cell[CellGroupData[{

