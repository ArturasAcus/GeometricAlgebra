Cell[TextData[{
 "we can compute vector derivative (in this case differentiation argument was \
not specified, therefore we have operator). ",
 StyleBox["gaDE[]",
  FontWeight->"Bold"],
 " (like ",
 StyleBox["gaPE[]",
  FontWeight->"Bold"],
 " for algebra) expands it in terms of directional derivative"
}], "Text",ExpressionUUID->"36429e2c-9193-4cb1-965f-275c51b9f1f6"],

