Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Full list of idempotents of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "6ceb409e-0bd5-428d-8ca8-aeb9d9d5f4eb"],
 ". The ",
 Cell[BoxData[
  FormBox[
   ButtonBox["Example",
    BaseStyle->"Hyperlink",
    ButtonData->"e1e2e3"], TraditionalForm]],ExpressionUUID->
  "da570b5d-ef63-41b5-8588-2bd8f962eb0a"],
 " shows that in Euclidean  algebra ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6ce0464-c58a-41e2-b961-328da24db029"],
 " three different idempotents appear. The choice of non-interacting \
subspaces  depends on additional assumptions. For example, in physics the \
spin quantization axis usually is assumed to be parallel to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "3"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f1ea00d-acf5-4f7f-8688-fbfbfff09d5f"],
 ", then instead of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"3", ",", "0"}]]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{3}{0}}=\\frac{1}{2}(1+\\e{1})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b5d70b3a-c4b8-462c-9ceb-6dac28b5339d"],
 ", as given in the primitives idempotent  table, it is preferable to select ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"3", ",", "0"}]]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}]}], 
