        AutoSpacing -> False, FontTracking -> "Condensed"]& ),
     InterpretationFunction:>(
      RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
     SyntaxForm->"fish",
     Tooltip->"Cl[2, 3, 0]"]}], ",", 
   RowBox[{"-", 
    TemplateBox[{
      TemplateBox[{"5"}, "mvDownUp", DisplayFunction :> (StyleBox[
         RowBox[{
           AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
         FontTracking -> "Condensed", AutoSpacing -> False]& ), 
       InterpretationFunction :> (ReleaseHold[
         RowBox[{"mvDownUp", "@@", 
           MakeExpression[{
             Take[{
               SlotSequence[1]}, 
              Length[{5}]], 
             Take[{
               SlotSequence[1]}, {Length[{5}] + 1, 
               Length[{5}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
       Tooltip -> "mvDownUp[{5}, {}]"], 
      TemplateBox[{"2", "3", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
         StyleBox["Cl", {FontColor -> RGBColor[0., 1., 1.]}], 
         RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
     "\[DoubleStruckE]",
     DisplayFunction:>(StyleBox[
       RowBox[{
         StyleBox["\[DoubleStruckE]", FontColor -> RGBColor[0., 1., 1.]], #}],
        AutoSpacing -> False, FontTracking -> "Condensed"]& ),
     InterpretationFunction:>(
