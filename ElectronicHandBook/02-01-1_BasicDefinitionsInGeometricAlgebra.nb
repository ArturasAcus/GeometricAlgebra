Cell[TextData[{
 StyleBox["Reversion example.",
  FontSlant->"Italic"],
 " If applied to  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "\[Alpha]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
         StyleBox["B", "TI"], "\[LongEqual]", "\[Beta]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a=\\alpha\\e{1}, \\cB=\\beta\\e{1}\\e{3}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b233ac1c-7485-4882-8dde-5ace8127e5b7"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", "\[Gamma]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "T=\\gamma\\e{1}\\e{2}\\e{3}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6d03c366-377f-45a0-9edb-e871072889ab"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", ",", "\[Beta]", ",", "\[Gamma]", "\[Element]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha,\\beta,\\gamma\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f10e1fce-694c-4620-bd42-070a679a410c"],
 "\[DoubleStruckCapitalR], the reversion may change or not the sign of the \
r-vector, \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox[
                StyleBox["a", "TI"], "~"], "\[LongEqual]", "\[Alpha]", 
               SubscriptBox[
                OverscriptBox[
                 StyleBox["e", FontSlant -> "Plain"], "~"], "1"], 
               "\[LongEqual]", "\[Alpha]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
               StyleBox["a", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                StyleBox["B", "TI"], "~"], "\[LongEqual]", "\[Beta]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
               "-", 
               StyleBox["B", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                StyleBox["T", "TI"], "~"], "\[LongEqual]", "\[Gamma]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
               "-", "\[Gamma]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", 
               "-", 
               StyleBox["T", "TI"], ","}]}, {"\[Null]", 
             RowBox[{
               RowBox[{"(", 
                 OverscriptBox[
                  RowBox[{
                    StyleBox["T", "TI"], "+", 
                    StyleBox["a", "TI"], 
                    StyleBox["B", "TI"]}], "~"], ")"}], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["T", "TI"], "~"], "+", 
               OverscriptBox[
                StyleBox["B", "TI"], "~"], 
               OverscriptBox[
                StyleBox["a", "TI"], "~"], "\[LongEqual]", "-", 
               StyleBox["T", "TI"], "-", 
               StyleBox["B", "TI"], 
               StyleBox["a", "TI"]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
