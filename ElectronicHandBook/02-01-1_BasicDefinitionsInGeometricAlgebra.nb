Cell["\<\
It is easy to verify that signatures of basis vectors agrees with the algebra \
signature. To this end we multiply each vector by itself\
\>", "Text",
 CellChangeTimes->{{3.911964079148862*^9, 3.911964395663423*^9}, {
  3.91196445157487*^9, 
  3.911964476201081*^9}},ExpressionUUID->"a4d18b71-54c0-4b5e-b197-\
784213d5867a"],

