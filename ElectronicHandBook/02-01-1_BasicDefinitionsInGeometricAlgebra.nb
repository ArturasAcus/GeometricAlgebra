Cell[BoxData[
 RowBox[{"primaryNonorthonormalViaPrimaryOrthonormalRules", "=", 
  RowBox[{"Thread", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MV", "[", 
       RowBox[{"p", "[", "1", "]"}], "]"}], ",", 
      RowBox[{"MV", "[", 
       RowBox[{"p", "[", "2", "]"}], "]"}], ",", 
      RowBox[{"MV", "[", 
       RowBox[{"p", "[", "3", "]"}], "]"}]}], "}"}], "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "-", 
       RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "+", 
       RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
       RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}], ",", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{"\[DoubleStruckE]", "[", "1", "]"}]}], "+", 
       RowBox[{"\[DoubleStruckE]", "[", "2", "]"}], "-", 
       RowBox[{"\[DoubleStruckE]", "[", "3", "]"}]}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"55f289aa-b0e7-45a7-9760-30b3a81b5401"],

