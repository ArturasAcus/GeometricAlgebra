Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\\", "lcow"}], " ", "to", " ", "unset", " ", "the", " ", 
    "damage", " ", "done", " ", "below"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Unprotect"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InputAssistant`TeXStringToBoxes", "[", "s_String", "]"}], "/;", 
      RowBox[{"TrueQ", "@", "useMaTeXQ"}]}], "=."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Protect"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "use", " ", "MaTeX", " ", "to", " ", "format", " ", "inline", " ", 
     "TeX"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Needs", "@", "\"\<MaTeX`\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"useMaTeXMag", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"useMaTeXBaselineShift", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Unprotect"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"InputAssistant`TeXStringToBoxes", "[", "s_String", "]"}], "/;", 
      RowBox[{"TrueQ", "@", "useMaTeXQ"}]}], ":=", 
     RowBox[{"AdjustmentBox", "[", 
      RowBox[{
       RowBox[{"ToBoxes", "@", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"s", ",", 
          RowBox[{"Magnification", "->", "useMaTeXMag"}]}], "]"}]}], ",", 
       RowBox[{"BoxBaselineShift", "->", "useMaTeXBaselineShift"}]}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"InputAssistant`TeXStringToBoxes", "//", "Protect"}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"useMaTeXQ", "=", "True"}], ";"}], "\n"}]}]], "Input",
 Evaluatable->False,ExpressionUUID->"7dda4ac8-9c77-416b-b64d-9cdcb358f521"],

