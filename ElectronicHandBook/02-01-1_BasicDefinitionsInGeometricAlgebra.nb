Cell[TextData[{
 StyleBox["Isotropic blade.",
  FontSlant->"Italic"],
 "  In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{1}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fdbae2ee-c9b3-457f-a5ab-dc8912004b1a"],
 " the squares of  bivectors  are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12", "2"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "13", "2"], "\[LongEqual]", 
         "1"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{12}^2=\\e{13}^2=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "005e616a-ea5f-4e0a-928f-86d5884aae34"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "23", "2"], "\[LongEqual]", 
         "-1"}], TraditionalForm], "errors" -> {}, "input" -> "\\e{23}^2=-1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d006b42e-9408-4eb5-8f57-a80228df6f00"],
 ". The square of a blade is the scalar ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", "\[Alpha]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "+", "\[Beta]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "23"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\cB=\\alpha\\e{12}+\\beta\\e{23}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "caf67941-0aab-4de6-8141-617045e0b89e"],
 ", is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "2"], "\[LongEqual]", 
         SuperscriptBox["\[Alpha]", "2"], "-", 
         SuperscriptBox["\[Beta]", "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cB^2=\\alpha^2-\\beta^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3440722-baf6-4013-9c67-a8f24a9bf39c"],
 " from which follows that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cB", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dc381478-2236-4602-bb72-0307450522c1"],
 " is the isotropic bivector (aka null bivector) if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", "\[LongEqual]", "\[PlusMinus]\[Beta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\alpha=\\pm\\beta", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "031f6e43-151d-4dd6-a466-bda713207837"],
 ".  The vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "a=-\\e{1}+\\e{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0de17784-109f-48c4-8f59-781ce6e1f615"],
 " is isotropic too, since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", "1", "-",
          "1", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a^2=(-\\e{1}+\\e{2})(-\\e{1}+\\e{2})=\\e{1}\\e{1}+\\e{2}\\e{2}-\\e{1}\\\
e{2}-\\e{2}\\e{1}=1-1-\\e{12}+\\e{12}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac21df3e-5590-48bc-8f9d-5b583cb486b0"],
 ". Because ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["a", "TI"], "|", "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\magnitude{a}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7728c0d-01b0-4164-9b65-881621820e46"],
 ", the inverse of the isotropic vector does not exist."
}], "Subitem",ExpressionUUID->"4cb261c7-afbf-466e-8e01-b46ceb9a0226"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Duality of graded vector space  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "r"], "n"], TraditionalForm]],
  ExpressionUUID->"e209f42b-21a1-482f-b32b-8835ca601521"],
 ".  Figure  illustrates the duality property of graded vector space ",
 StyleBox[" ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "r"], "n"], TraditionalForm]],
  ExpressionUUID->"7519647a-d90c-4cbf-88af-edc8ce6ce1dd"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LessEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "r\\le n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "891eb83d-40b5-418f-aeb6-75263375e32c"],
 ".  The scalar has a partner, or dual scalar which is called  the \
pseudoscalar. "
}], "Item",
 CellTags->"HodgeDual",ExpressionUUID->"06067961-5d3e-4408-9dec-76b8a69523d4"],

