Cell[TextData[{
 "Check rotor averaging formula   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         OverscriptBox[
          StyleBox["R", "TI"], "~"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Alpha]", 
         StyleBox["n", "TI"], "+", "\[Beta]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         StyleBox["B", "TI"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[Alpha]", 
         StyleBox["n", "TI"], "+", "\[Beta]", 
         SuperscriptBox[
          RowBox[{"(", "-1", ")"}], "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], 
         StyleBox["B", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["n", "TI"], "-", "4"}], ")"}], 
         OverscriptBox[
          StyleBox["R", "TI"], "~"], "+", "4", "\[Alpha]"}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "\\e{i}\\tilde{\\m{R}}\\e{}^i=\\alpha n \
+\\beta\\e{i}\\mathcal{B}\\e{}^i=\\alpha n+\\beta(-1)^{2}(n-4)\\mathcal{B}=\n\
(n-4)\\tilde{\\m{R}} +4\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a8f4694f-667a-445e-b0f6-2146c4f3bedb"],
 "."
}], "Text",ExpressionUUID->"66c203a9-0e51-46de-b55d-95d332c4eadf"],

