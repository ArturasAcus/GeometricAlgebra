              StyleBox["e", FontSlant -> "Plain"], "35"], ",", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "45"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{A}^{-1}=\\{-\\e{1 2},\\e{1 3},\\e{1 4},\\e{1 5},\\e{23},\\e{2 \
4},\\e{2 5},-\\e{3 4},-\\e{3 5},-\\e{4 5}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7cd880ba-b4e6-448c-a0b1-1824ee4114f4"],
 ". The whole sum in the explicit form, therefore is understood as\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               UnderscriptBox["\[Sum]", 
                RowBox[{
                  StyleBox["A", "TI"], ":", 
                  StyleBox["A", "TI"], "\[LongEqual]", 
                  SubscriptBox[
                   RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"]}], 
                LimitsPositioning -> True], 
               SubsuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"], "-1"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["A", "TI"]], "\[LongEqual]"}], 
             RowBox[{"-", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "13"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "13"], "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "14"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "14"], "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "15"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "15"], "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "23"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "23"]}]}, {"\[Null]", 
             RowBox[{"+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "24"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "24"], "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "25"], 
               StyleBox["U", "TI"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "25"], "-", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "34"], 
               StyleBox["U", "TI"], 
