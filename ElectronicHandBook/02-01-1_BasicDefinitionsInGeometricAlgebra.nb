Cell[TextData[{
 "To check that we  indeed produced reciprocal frame we check the defining \
relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"], "\[Prime]"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"\[Prime]", 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i^\\prime\\cdot e^{\\prime j}=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b4c83e94-ab44-49df-8b73-a44ddc78e924"],
 " for new nonorthonormal basis"
}], "Text",ExpressionUUID->"8b182285-2636-40a2-af0d-75f009ef32c6"],

