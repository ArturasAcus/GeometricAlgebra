      "], {{0., 0.}, {1., 1.}}, {0, 255},
      ColorFunction->GrayLevel], {{{416.16, 0.}, {0., -212.4}}, {0., 212.4}}]},
   AspectRatio->Automatic,
   ImageSize->{828., 431.},
   PlotRange->{{0., 416.16}, {0., 212.4}}]], "Input",ExpressionUUID->
  "f20250a0-3c23-45a2-992a-196fcd71405f"],
 "\[LineSeparator]\[LineSeparator]Conjugation symbols (left column) and their \
action on blades ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\m{U}\\rangle_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "645a827b-7b16-4c04-9732-6a8292cc2665"],
 "  represented by numbers in the upper row. The plus and minus signs \
indicate that the action of conjugation symbol on the blade has either  no \
effect or changes its sign to.\[LineSeparator]\nThe square blocks in the \
Table contain the identity ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["id", TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathop{\\textrm{id}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7cd542e2-3ea4-4ccc-874a-5b89184f9c17"],
 ",  the involutions ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[EmptyUpTriangle]", 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\triangle_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "784b5788-d489-4dad-8e0c-8a8a748c54b1"],
 " and their products. The blocks consist of sets of involution  that are \
closed under multiplication of lines, or columns, i.e., in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{"4", "\[Cross]", "4"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(4\\times4)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "676d9d1c-1aea-4ee8-bc6a-150234048d6d"],
 " block, the row  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "12"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"+", "-", "-+"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_{12}=\\{+ - - +\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a159858a-1ffd-4392-a739-c41e1fbf51c9"],
 " multiplied by row ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "1"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"+", "-", "+-"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_{1}=\\{+ -+ -\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fc374bc9-73c1-4d11-9970-f480c6e4e42d"],
 " gives ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "2"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{"+", "+", "--"}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_{2}=\\{+ + - -\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "77983cb1-68c0-4453-9eb6-36614410d565"],
 ". Thus, the  product can be written as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "12"], 
         SubscriptBox["\[EmptyUpTriangle]", "1"], "\[LongEqual]", 
         SubscriptBox["\[EmptyUpTriangle]", "1"], 
         SubscriptBox["\[EmptyUpTriangle]", "12"], "\[LongEqual]", 
         SubscriptBox["\[EmptyUpTriangle]", "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\triangle_{12} \\triangle_{1}=\\triangle_1 \
\\triangle_{12}=\\triangle_{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2160ba9e-63b1-4079-b3d3-0dca9f3c11fe"],
 ". Similar multiplication rule holds for columns. The blocks may be \
interpreted as involution matrices since after normalization their squares  \
give} unit matrices. If needed,  the blocked structure may be continued in \
the horizontal and vertical directions. ",
 StyleBox["Note that the arrangement of signs in the table mimics the \
structure of Hadamard matrices. A Hadamard matrix is a square matrix \
containing only ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "05c5a4b5-8325-463e-9a76-f321cac7ba36"],
 StyleBox[" and",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-1", TraditionalForm], "errors" -> {}, "input" -> 
     " -1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "8c9202e4-4e43-4b8e-8be7-2c9b83b0ac4a"],
 StyleBox[" such that when any two columns or rows are placed side by side, \
half the adjacent cells have the same sign and half the opposite.",
  Background->RGBColor[0.87, 0.94, 1]],
 "\n\nIn the above  conjugation Table, the operators ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "0"], "\[LongEqual]", "id"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\triangle_0=\\text{id}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4920eb5c-ddff-4510-a554-86dc71b5dde1"],
 ", reversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[EmptyUpTriangle]", "1"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "39c6d02f-b80c-42f8-af61-2a1c96e9a314"],
 ", grade inversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[EmptyUpTriangle]", "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0aa806cb-84e1-4999-b609-5cb43880adf1"],
 ", and Clifford conjugation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[EmptyUpTriangle]", "12"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\triangle_{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "29c42fe1-33b5-4055-a2be-c9cd43ec078c"],
 " represent the fundamental conjugations. It should be noted that contrary \
to four main involutions, in general, we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["U", "TI"], 
              StyleBox["V", "TI"]}], ")"}], 
          SubscriptBox["\[EmptyUpTriangle]", 
           StyleBox["j", "TI"]]], "\[NotEqual]", 
         SuperscriptBox[
          StyleBox["U", "TI"], 
          SubscriptBox["\[EmptyUpTriangle]", 
           StyleBox["j", "TI"]]], 
         SuperscriptBox[
          StyleBox["V", "TI"], 
          SubscriptBox["\[EmptyUpTriangle]", 
           StyleBox["j", "TI"]]], "\[NotEqual]", 
         SuperscriptBox[
          StyleBox["V", "TI"], 
          SubscriptBox["\[EmptyUpTriangle]", 
           StyleBox["j", "TI"]]], 
         SuperscriptBox[
          StyleBox["U", "TI"], 
          SubscriptBox["\[EmptyUpTriangle]", 
           StyleBox["j", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\m{U}\\m{V})^{\\triangle_j}\\neq \\m{U}^{\\triangle_j} \
\\m{V}^{\\triangle_j}\\neq \\m{V}^{\\triangle_j} \\m{U}^{\\triangle_j}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "779395b3-f8f7-4955-9dfc-aa6d455fc68a"],
 " , i.e., the conjugation symbols are not distributive if  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], "\[GreaterEqual]", "3"}], TraditionalForm], 
     "errors" -> {}, "input" -> "k\\ge 3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "610dafd5-47f6-4f62-beb2-c0bedcb5cac2"],
 ".  The extended set of conjugations may be used to find the determinant of \
general MV and to solve Sylvester equation."
}], "Item",
 CellTags->
  "TableOfTriangeInvolutions",ExpressionUUID->"80477018-c505-4c64-855b-\
1c91e42196b6"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 CellChangeTimes->{{3.911962275030588*^9, 3.911962275710309*^9}},
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"474ed50c-53fe-411d-83de-280a548be451"],

Cell[CellGroupData[{

Cell[TextData[{
 "Choose algebra and generate general MV.  First we check that first two \
Shirokov\[CloseCurlyQuote]s triangle involutions (here named as ",
 StyleBox["gaBinomialConjugate[ ]",
  FontWeight->"Bold"],
 ") are the same as grade inverse and reverse, whereas Clifford conjugate is \
their combination"
}], "Text",ExpressionUUID->"0ca74ef1-a095-461f-818e-e85806954810"],

