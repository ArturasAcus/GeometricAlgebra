Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Grade negation",
  FontSlant->"Italic"],
 ".  Formally the negated ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["r", "TI"], TraditionalForm], "errors" -> {}, "input" -> "r", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eff9ae2f-a0f4-4027-9e4c-2a4836884c20"],
 " grade can be expressed by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["U", "TI"], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], "\[LongEqual]", 
         StyleBox["U", "TI"], "-", "2", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}_{\\bar r}=\\m{U}-2\\langle \\m{U}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b01b52ea-7caf-4e3c-99ce-75729bcf307b"],
 ", or in case of two negated indices (double negation) by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox[
             StyleBox["r", "TI"], "_"], ",", 
            OverscriptBox[
             StyleBox["s", "TI"], "_"]}]], "\[LongEqual]", 
         StyleBox["U", "TI"], "-", "2", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "-", "2", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["s", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}_{\\bar r,\\bar s}=\\m{U}-2\\langle \\m{U}\\rangle_r-2\\langle \
\\m{U}\\rangle_s", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52e9676c-fbd9-4c6b-8e37-5477dd0b142c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{U}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1564f4b2-c223-4343-a94e-2666ff649b2b"],
 " denotes grade-r projection (aka grade-r filter) of MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["U", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86e50036-c4e1-4360-927f-0e7a89e6b0bc"],
 ". It is similar to barred conjugation but with opposite sign. However, the \
grade negation is more general since it allows to control signs of individual \
grades. The following properties are evident from the definition of \
grade-negation operation:\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            SubscriptBox[
             StyleBox["U", "TI"], 
             OverscriptBox[
              StyleBox["p", "TI"], "_"]], ")"}], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox[
             StyleBox["p", "TI"], "_"], ",", 
            OverscriptBox[
             StyleBox["r", "TI"], "_"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox[
             StyleBox["r", "TI"], "_"], ",", 
            OverscriptBox[
             StyleBox["p", "TI"], "_"]}]], ",    ", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox[
             StyleBox["r", "TI"], "_"], ",", 
            OverscriptBox[
             StyleBox["r", "TI"], "_"]}]], "\[LongEqual]", 
         StyleBox["U", "TI"], ",    ", 
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["U", "TI"], "+", 
              StyleBox["V", "TI"]}], ")"}], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], "+", 
         SubscriptBox[
          StyleBox["V", "TI"], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "(\\m{U}_{\\bar p})_{\\bar r}=\\m{U}_{{\\bar\np},{\\bar \
r}}=\\m{U}_{{\\bar r},{\\bar p}},\\qquad \\m{U}_{{\\bar\nr},{\\bar \
r}}=\\m{U},\\qquad(\\m{U}+\\m{V})_{\\bar r}=\\m{U}_{\\bar\nr}+\\m{V}_{\\bar \
r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d731cec-a3ea-4b93-b7f4-21c2c750367d"],
 " .\[LineSeparator]\n However, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"(", 
            RowBox[{
              StyleBox["U", "TI"], 
              StyleBox["V", "TI"]}], ")"}], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], "\[NotEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]], 
         SubscriptBox[
          StyleBox["V", "TI"], 
          OverscriptBox[
           StyleBox["r", "TI"], "_"]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\m{UV})_{\\bar r}\\ne \\m{U}_{\\bar r}\\m{V}_{\\bar r}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "486851ed-4ea2-481a-aebf-15e7bc663e91"],
 ". If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["U", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "52c01237-86fa-4293-a358-37757e8f8252"],
 " does not contain grade-r elements then negation returns the same MV.  The \
main involutions, i.e. reversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["U", "TI"], "~"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\reverse{\\m{U}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a32b3d5f-4bd0-472a-87e6-02d83a1e0f57"],
 ", grade inversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], 
       TraditionalForm], "errors" -> {}, "input" -> "\\gradeinverse{\\m{U}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "122c6f4f-e7ad-4e39-b0a3-fd5633cd668f"],
 ", and Clifford conjugation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         "\[LongEqual]", 
         OverscriptBox[
          OverscriptBox[
           StyleBox["U", "TI"], "~"], "\[Cap]", LimitsPositioning -> False]}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\cliffordconjugate{\\m{U}}=\\gradeinverse{\\reverse{\\m{U}}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f2c85eb5-e28c-45ff-8d06-1575bd693c0c"],
 ", in terms of negation can be written as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["U", "TI"], "~"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox["2", "_"], ",", 
            OverscriptBox["3", "_"], ",", 
            OverscriptBox["6", "_"], ",", 
            OverscriptBox["7", "_"], ",", 
            OverscriptBox["10", "_"], ",", 
            OverscriptBox["11", "_"], "\[Ellipsis]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\reverse{\\m{U}}=\\m{U}_{{\\bar 2},{\\bar 3},{\\bar 6},{\\bar \
7},{\\bar {10}},{\\bar {11}}\\dots}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb5fa3a2-aaf3-4ec1-95de-6736bf1d4974"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox["1", "_"], ",", 
            OverscriptBox["3", "_"], ",", 
            OverscriptBox["5", "_"], ",", 
            OverscriptBox["7", "_"], ",", 
            OverscriptBox["9", "_"], ",", 
            OverscriptBox["11", "_"], "\[Ellipsis]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gradeinverse{\\m{U}}=\\m{U}_{{\\bar 1},{\\bar 3},{\\bar 5},{\\bar \
7},{\\bar {9}},{\\bar {11}}\\dots}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13ac3713-72f1-4533-978e-28d94f00e9fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["U", "TI"], 
          RowBox[{
            OverscriptBox["1", "_"], ",", 
            OverscriptBox["2", "_"], ",", 
            OverscriptBox["5", "_"], ",", 
            OverscriptBox["6", "_"], ",", 
            OverscriptBox["9", "_"], ",", 
            OverscriptBox["10", "_"], "\[Ellipsis]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\cliffordconjugate{\\m{U}}=\\m{U}_{{\\bar 1},{\\bar 2},{\\bar \
5},{\\bar 6},{\\bar {9}},{\\bar {10}}\\dots}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bc792c43-4d72-435a-9409-ef907b4e7f80"],
 ", respectively. In general, the negation is more versatile conjugation \
operation."
}], "Item",ExpressionUUID->"b519472c-fecd-444b-922e-f3788be16653"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
