          StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], ",", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\e{}^{1}=\\e{1}, \\e{}^{2}=\\e{2}, \\e{}^{3}=-\\e{3}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "37be8ee0-3c14-4cf3-b664-b70723228515"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"], "\[LongEqual]", "-", 
