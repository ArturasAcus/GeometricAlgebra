Cell[TextData[{
 StyleBox["Non-orthogonal reciprocal basis",
  FontSlant->"Italic"],
 ". An arbitrary (non-normalized and non-orthogonal) basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{e_i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "499279be-3faa-4d31-b59e-86a8dd781c50"],
 " and its reciprocal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{e^i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba5cf90e-5275-4922-8545-a68ac053d872"],
 " may be expressed through the standard orthonormalized (printed in roman) \
basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "55e4c117-6679-4616-8ede-32e648ac8da5"],
 ". For example, if the following relations hold ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", "TI"], "1"], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], "2"], ",", 
             SubscriptBox[
              StyleBox["e", "TI"], "3"]}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], ", ", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", "2", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"], ", ", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{e_1,e_2,e_3\\}=\\{\\mathrm{e}_{1},\\ \
\\mathrm{e}_{1}+2\\mathrm{e}_{3},\\ \
\\mathrm{e}_{1}+\\mathrm{e}_{2}+\\mathrm{e}_{3}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ddedb4c-b43b-4bad-a9fa-861e8920bdbf"],
 ", then according to the above description the reciprocal basis in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{3,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06316572-0907-4564-bb5c-fb90a9226ece"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", "TI"], "1"], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], "2"], ",", 
             SuperscriptBox[
              StyleBox["e", "TI"], "3"]}], "}"}], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], "/", 
             "2", ", ", 
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "3"], "-", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], "/", 
             "2", ", ", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{e^1,e^2,e^3\\}= \
\\{\\mathrm{e}_{1}-(\\mathrm{e}_{2}+\\mathrm{e}_{3})/2,\\ \
(\\mathrm{e}_{3}-\\mathrm{e}_{2})/2,\\ \\mathrm{e}_{2}\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6b0f659-6f75-49f7-b2c9-94062f6d61bb"],
 ". They satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
