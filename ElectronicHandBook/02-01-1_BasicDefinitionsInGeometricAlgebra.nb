    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c98c7ac-6351-4005-ad6d-b6040097bb9a"],
 "  divergence of vector function "
}], "Text",ExpressionUUID->"37a505da-a45b-4a38-af05-c12102fdfe2d"],

