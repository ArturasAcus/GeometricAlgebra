Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Grade inversion (aka parity involution).",
  FontSlant->"Italic"],
 "  It changes sign of all basis vectors to opposite, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", FontSlant -> "Plain"], "\[Cap]", LimitsPositioning -> 
           False], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gradeinverse{\\e{}}_i=-\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1482ceb-704f-461d-bccf-7bace457d1ad"],
 ". The grade inversion does not change order of its arguments, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          RowBox[{
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "1"], 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "2"], 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "3"]}], "\[Cap]", 
          LimitsPositioning -> False], "\[Rule]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\gradeinverse{\\e{1}\\e{2}\\e{3}}\\to(-\\e{1})(-\\e{2})(-\\e{3})=-\\e{\
1}\\e{2}\\e{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15203917-366e-41ec-a301-5300f314e2f1"],
 ",therefore, it is true involution (not anti-involution) with the \
properties: ",
 StyleBox["[pakeista blade-> homogeneus grade-r]",
  FontColor->RGBColor[1, 0, 0]],
 "\n\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox[
                StyleBox["a", "TI"], "\[Cap]", LimitsPositioning -> False], 
               "\[LongEqual]", "-", 
               StyleBox["a", "TI"], ",    ", 
               OverscriptBox[
               "\[Lambda]", "\[Cap]", LimitsPositioning -> False], 
               "\[LongEqual]", "\[Lambda]"}], 
             "vector changes sign; scalar is invariant,"}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                SubscriptBox[
                 StyleBox["A", "TI"], 
                 StyleBox["r", "TI"]], "\[Cap]", LimitsPositioning -> False], 
               "\[LongEqual]", 
               SuperscriptBox[
                RowBox[{"(", "-1", ")"}], 
                StyleBox["r", "TI"]], 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]]}], 
             "action on homogeneous grade\[Hyphen]r MV,"}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                SubscriptBox[
                 RowBox[{"\[LeftAngleBracket]", 
                   StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                 StyleBox["r", "TI"]], "\[Cap]", LimitsPositioning -> False], 
               "\[Rule]", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    OverscriptBox[
                    StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], " "}], "\[RightAngleBracket]"}], 
                StyleBox["r", "TI"]]}], 
             "inversion does not change the grade, "}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], "+", 
                  StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                False], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               "+", 
               OverscriptBox[
                StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False]}], 
             "action on a sum of MVs,"}, {"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["A", "TI"], 
                  StyleBox["B", "TI"]}], "\[Cap]", LimitsPositioning -> 
                False], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
               OverscriptBox[
                StyleBox["B", "TI"], "\[Cap]", LimitsPositioning -> False]}], 
             "action on GP of MVs."}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\
&\\gradeinverse{a}=-a,\\qquad\\gradeinverse{\\lambda}=\\lambda& \\text{vector \
changes sign; scalar is invariant,}\\\\\n&\\gradeinverse{A_r}=(-1)^{r}A_r& \
\\text{action on homogeneous grade-r MV,}\\\\\n \
&\\gradeinverse{\\grade{\\m{A}}{r}}\\rightarrow\\grade{\\gradeinverse{\\m{A}}\
\\,}{r} &\\text{inversion does not change the grade, }\\\\\n\
&\\gradeinverse{\\m{A}+\\m{B}}= \
\\gradeinverse{\\m{A}}+\\gradeinverse{\\m{B}}&\\text{action on a sum of MVs,}\
\\\\\n &\\gradeinverse{\\m{A} \
\\m{B}}=\\gradeinverse{\\m{A}}\\gradeinverse{\\m{B}}&\\text{action on GP of\n \
 MVs.}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8f862d6-d31c-43d4-ad62-711030254ee7"],
 "\n\nThe grade inversion may be applied to eliminate the factors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", "-1", ")"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "(-1)^r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "465d3d2f-a4e7-4ac7-972b-9c4160ab352d"],
 " in expressions that hold blades. For example, \[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               StyleBox["a", "TI"], "\[CenterDot]", 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]]}], 
             RowBox[{"\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], "-", 
                   SuperscriptBox[
                    RowBox[{"(", "-1", ")"}], 
                    StyleBox["r", "TI"]], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], 
                   StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], "-", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], 
                    StyleBox["r", "TI"]], 
                   StyleBox["a", "TI"]}], ")"}], ","}]}, {
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]]}], 
             RowBox[{"\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], "+", 
                   SuperscriptBox[
                    RowBox[{"(", "-1", ")"}], 
                    StyleBox["r", "TI"]], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], 
                   StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]], "+", 
                   SubscriptBox[
                    OverscriptBox[
                    StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], 
                    StyleBox["r", "TI"]], 
                   StyleBox["a", "TI"]}], ")"}], "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{align}\na\\d\n\
A_r&=\\frac{1}{2}\\Big(aA_r-(-1)^rA_ra\\Big)=\\frac{1}{2}\\Big(aA_r-\\\
gradeinverse{A}_r\na\\Big),\\\\\na\\w\nA_r&=\\frac{1}{2}\\Big(aA_r+(-1)^rA_ra\
\\Big)=\\frac{1}{2}\\Big(aA_r+\\gradeinverse{A}_r\na\\Big).\\end{align}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7dcb1e65-a6a0-4039-b0ad-1dd50e446d67"]
}], "Item",ExpressionUUID->"512e6393-aad3-4e2b-ab45-bf3b4add2940"],

