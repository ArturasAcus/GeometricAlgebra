Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t  ",
 StyleBox["Frame and basis",
  FontSlant->"Italic"],
 ". A finite set of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["i", "TI"]], "}"}], "\[Congruent]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], ",", "\[Ellipsis]", 
             ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["n", "TI"]]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\{\\mathrm{e}_i\\}\\equiv\\{\\mathrm{e}_1,\\mathrm{e}_2,\\ldots,\\\
mathrm{e}_n\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5b504af-9b4f-4fbd-9364-6e18d82517cb"],
 " that are linearly independent and span all vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalV]", "n"], TraditionalForm]],
  ExpressionUUID->"649707fc-574b-4197-bc46-bb7566295ccb"],
 " is called the frame (aka basis) and written as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", "TI"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", "TI"], "2"], "\[Wedge]", "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["n", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "E_n=e_1\\wedge e_2\\wedge\\dots\\wedge e_n\\ne 0", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "190eefed-5204-4818-82cd-c05bfa56005b"],
 ". The wedge symbol \[OuterProduct] denotes the outer product operation. The \
frame carries the same information as a linearly independent combination of \
vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "2"], ",", "\[Ellipsis]", 
           ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["n", "TI"]]}], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_1,\\mathrm{e}_2,\\ldots,\\mathrm{e}_n\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eaee16d0-7d19-4a3e-b2df-64d133a77290"],
 " although the condition\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["E", "TI"], 
          StyleBox["n", "TI"]], "\[NotEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "E_n \\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4cdd912-b3a1-4d03-ab03-aa6698380788"],
 " is easier to apply in calculations. If the set ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "2"], ",", "\[Ellipsis]", 
           ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["n", "TI"]]}], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_1,\\mathrm{e}_2,\\ldots,\\mathrm{e}_n\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5c923f89-a0f5-4964-83cc-382f132d5682"],
 "  is orthonormalized, it is called the orthonormal basis. Usually, a set of \
orthonormalized basis vectors in Mathematica notebooks is written in double \
struck font (enter as  \[EscapeKey]ds\[EscapeKey]) ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"{", 
     SubscriptBox["\[DoubleStruckE]", "i"], "}"}], "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["\[DoubleStruckE]", "1"], ",", 
      SubscriptBox["\[DoubleStruckE]", "2"], ",", "...", ",", 
      SubscriptBox["\[DoubleStruckE]", "n"]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"cdb38887-77db-4ab0-a54e-8f4b5c0e79a2"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Element]", TraditionalForm], "errors" -> {}, 
     "input" -> "\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f655692-0732-48e4-8bde-dc8a069efb09"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "cb40bcea-bc66-433f-ae26-4ca6dcb7dc6c"],
 ". In the handbook, the terms frame and basis are used interchangeably. The \
elements of orthonormal basis (aka elements of orthonormal frame) satisfy \
orthogonality condition: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{j}=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "405290bf-7d2c-4020-8a7c-67cc3fcb7afd"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[NotEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i\\ne j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c192a48-54f8-45b5-98c7-50735a8d5abf"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "\[PlusMinus]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{i}=\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e5da6fe3-6b40-4d4a-ac7d-1f0da2ecd690"],
 ", where plus/minus sign depends on vector space metric. The plus sign \
corresponds to positive signature, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LessEqual]", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i \\le p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ec46328-2ec7-4522-8b2c-229fa0a7f4f4"],
 ", and the minus sign corresponds to negative signature, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "<", 
         StyleBox["i", "TI"], "\[LessEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"], "\[LongEqual]", 
         StyleBox["n", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p < i \\le p + q = n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f09ce3c8-c8de-4a46-89bb-27f4e7fe38a0"],
 " of considered GA (geometric algebra) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Cl", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Cl}_{p,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6476438-f24f-42c9-a55f-4defcf01a9be"],
 ". The center dot \[InnerProduct] is called the inner product.\n"
}], "Item",
 CellChangeTimes->{{3.910231736570443*^9, 
  3.910231743614933*^9}},ExpressionUUID->"d3f6d812-5b95-443f-8d75-\
bc5eaba04da8"],

