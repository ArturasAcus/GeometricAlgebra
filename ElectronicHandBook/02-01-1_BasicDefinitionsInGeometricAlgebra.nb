&\\qquad\\qquad \\text{inner product of vectors $a$ and $b$} \\\\\n&a\\w \
b=a^ib^j\\mathrm{e}_{i}\\w\\mathrm{e}_{j} &\\qquad\\qquad\\text{outer \
product} \\\\&\n\\mathcal{B}=a\\w b=\\frac{1}{2} \\mathrm{e}_{i}( \
\\mathrm{e}_{}^i\\d \\mathcal{B})&\\qquad\\qquad\\mathcal{B}\\text{\\ is the \
bivector}\\\\& A_r= \\mathrm{e}_{i}( \\mathrm{e}_{}^i\\d \
A_r)/r&\\qquad\\qquad A_r\\text{\\ is the grade-$r$ blade }\\\\ \
&a=(a\\d\\mathrm{e}_{i})\\mathrm{e}_{i}&\\qquad\\qquad\\text{component \
decomposition of vector} \\\\&A_r= \\mathrm{e}_{i}( \\mathrm{e}_{}^i\\w \
A_r)/(n-r)&\\quad  \\\\\n&\\mathrm{e}_{i}A_r\\mathrm{e}_{}^i=(-1)^r(n-2r)A_r&\
\\quad  \\\\& \
\\m{f}(a)=a^i\\m{f}(\\mathrm{e}_{i})=a^if_j(\\mathrm{e}_{i})\\mathrm{e}_{}^j \
&\\qquad\\qquad \\text{linearity and vector form}\\\\\n& \
\\m{f}^*(a)=\\mathrm{e}_{} \
^ia\\d\\m{f}(\\mathrm{e}_{i})&\\qquad\\qquad\\text{adjoint}\\\\\n& \
\\m{f}(b)\\d c=\\m{f}(\\mathrm{e}_{k})\\d \\mathrm{e}_{l} b^kc^l\\ \
&\\qquad\\qquad\\m{f}(b)\\text{\\ is the function of vector\\ \
}b\\\\&\\nabla\\equiv\\nabla_x=\\mathrm{e}_{}^i\\frac{\\partial}{\\partial\n\
x^i}\\equiv\\mathrm{e}_{}^i\\partial_{i}\n&\\qquad\\qquad\\text{vector \
derivative or del \
operator}\\\\&\\mathrm{div}\\m{f}=\\dot{\\nabla}\\d\\m{\\dot{f}}=\\frac{\\\
partial f_i}{\\partial x_i}  &\\qquad\\qquad\\text{divergence of vector \
func.}\\m{f}(x) \\\\\n\
&\\mathrm{curl}\\m{f}=\\dot{\\nabla}\\w\\m{\\dot{f}}=\\sum_{i<j}\\,\\bigl(\\e{\
j}^{i}\\,\\partial_if_j(x)-\\e{i}^{j}\\,\\partial_j \
f_i(x)\\bigr)&\\qquad\\qquad\\text{curl of vector function \
}\\m{f}=\\m{f}(x)\\\\\n\
&\\mathrm{grad}\\beta=\\mathrm{e}_{}^i\\partial_i\\beta & \
\\qquad\\qquad\\text{gradient of scalar func. } \\beta=\\beta(x)\n \
\\end{aligned}", "state" -> "Boxes"|>,
