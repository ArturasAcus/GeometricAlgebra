Cell[TextData[{
 "Indeed we see, that grade-4 term appear.  For bivectors ",
 StyleBox["gaNormCliffordConjugateAbs[]",
  FontWeight->"Bold"],
 "  norm is more useful since it yields the same sign as square of bivector \
(for Euclidean space).  "
}], "Text",ExpressionUUID->"1cc7ef7f-f0d4-4110-b16a-512fed659488"],

