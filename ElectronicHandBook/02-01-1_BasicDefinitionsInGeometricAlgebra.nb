     RowBox[{"-", 
      FractionBox["1", "2"]}], ",", 
     RowBox[{"-", 
      FractionBox["1", "2"]}], ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.949644266870096*^9, 3.949740842478033*^9},
