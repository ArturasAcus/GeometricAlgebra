Cell[BoxData[
 RowBox[{"numberOfElementsThatSquareToOne", "=", 
  RowBox[{"Length", "[", 
   RowBox[{"Cases", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"GeometricProduct", "[", 
        RowBox[{"#", "\[GeometricProduct]", "#"}], "]"}], "&"}], "/@", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"gaOrthonormalBasis", "[", 
         RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\""}], "]"}], ",", 
        "1"}], "]"}]}], ",", "1"}], "]"}], "]"}]}]], "Input",
 CellLabel->"In[95]:=",ExpressionUUID->"dc533d96-1544-491b-b3ad-910752642a5e"],

