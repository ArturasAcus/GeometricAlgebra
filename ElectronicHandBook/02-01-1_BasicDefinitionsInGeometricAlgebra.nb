    "\[DoubleStruckE]",
    DisplayFunction:>(StyleBox[
      RowBox[{
        StyleBox["\[DoubleStruckE]", FontColor -> RGBColor[0., 1., 1.]], #}], 
      AutoSpacing -> False, FontTracking -> "Condensed"]& ),
    InterpretationFunction:>(
     RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
    SyntaxForm->"fish",
    Tooltip->"Cl[2, 3, 0]"], ",", 
   TemplateBox[{
