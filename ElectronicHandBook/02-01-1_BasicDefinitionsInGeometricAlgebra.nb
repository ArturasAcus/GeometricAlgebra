Cell[TextData[{
 "Construct sum  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], ",", 
            StyleBox["s", "TI"]}], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
          RowBox[{
            StyleBox["s", "TI"], "-", 
            StyleBox["r", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\sum_{r,s}\\langle\\langle\n\\m{A}\\rangle_r\\langle\n\\m{B}\\rangle_s \
\\rangle_{s-r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e4922dcc-5be7-47d2-b38b-fc0a0ef6b28d"],
 ". To this end first determine all grades of both multivectors using command \
",
 StyleBox["gaGradeList[MV]",
  FontWeight->"Bold"],
 ", which returns all grades of multivector MV."
}], "Text",ExpressionUUID->"6c2b4998-1fd1-428e-962f-1e9e6e69d834"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gradesOfA", "=", 
   RowBox[{"gaGradeList", "[", "A1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gradesOfB", "=", 
  RowBox[{"gaGradeList", "[", "B1", "]"}]}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"0cf6e581-3e7b-4bc3-be3f-d3f9a230f4ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5", ",", "6", ",", "7"}],
   "}"}]], "Output",
 CellChangeTimes->{3.950160361432988*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"3e98ad25-ebdd-4eb6-8249-bd3d5e0645fb"]
}, Closed]],

Cell[TextData[{
 "Then  construct the sum. Note that projectors with negative grades, for \
example, ",
 StyleBox["gaGetMV[any ,{-2}]",
  FontWeight->"Bold"],
 " we replace to zero (we intentionally don\[CloseCurlyQuote]t not add  \
automatic rule for negative grades, since appearance of negative grades may \
reveal possible bugs in the code)"
}], "Text",ExpressionUUID->"df500af0-4f85-43a0-9465-7350ffc7a46e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"gaGetMV", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"gaGetMV", "[", 
         RowBox[{"A1", ",", 
          RowBox[{"{", "grA", "}"}]}], "]"}], "\[GeometricProduct]", 
        RowBox[{"gaGetMV", "[", 
         RowBox[{"B1", ",", 
          RowBox[{"{", "grB", "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"grB", "-", "grA"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"grA", ",", "gradesOfA"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"grB", ",", "gradesOfB"}], "}"}]}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"gaGetMV", "[", 
      RowBox[{"_", ",", 
       RowBox[{"{", 
        RowBox[{"_", "?", "Negative"}], "}"}]}], "]"}], ":>", "0"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"answerOfLeftContractDefinitionBySum", "=", 
    RowBox[{"gaPE", "[", "%", "]"}]}], ")"}], "//", "LeafCount"}]}], "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"4cb9ad20-7176-4eb1-ade9-700b42f0bf6a"],

Cell[BoxData["18512"], "Output",
 CellChangeTimes->{3.950160364542433*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"3f0c1493-c6a3-4eee-a0db-f5c0eeaf8976"]
}, Closed]],

