    RowBox[{"a", ",", "testAlgebra"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bMV", "=", 
   RowBox[{"gaGeneralMultivector", "[", 
    RowBox[{"b", ",", "testAlgebra"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"gradesOfA", "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"gaGradeList", "[", "aMV", "]"}], ",", "0"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"gradesOfB", "=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"gaGradeList", "[", "bMV", "]"}], ",", "0"}], "]"}]}]}], "Input",
 CellLabel->"In[73]:=",ExpressionUUID->"8bb74c3d-c732-4050-9d85-5cebd4da51a7"],

