      "outerProductViaDeterminant"}], "}"}], "]"}], ";"}]], "Input",
 CellLabel->
  "In[188]:=",ExpressionUUID->"69c2dca8-fe41-4168-9e43-7b13a4268ac7"]
}, Closed]]
