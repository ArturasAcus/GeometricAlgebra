Cell[TextData[{
 "Now we will construct sum  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         UnderscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["r", "TI"], "\[NotEqual]", "0", ",", 
            StyleBox["s", "TI"], "\[NotEqual]", "0"}], LimitsPositioning -> 
          True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["r", "TI"]], 
              SubscriptBox[
               RowBox[{"\[LeftAngleBracket]", 
                 StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
               StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
          RowBox[{
            StyleBox["abs", FontSlant -> "Plain"], "(", 
            RowBox[{
              StyleBox["s", "TI"], "-", 
              StyleBox["r", "TI"]}], ")"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\sum_{r \\ne 0,s \\ne 0}\\langle\\langle\n\\m{A}\\rangle_r\\langle\n\
\\m{B}\\rangle_s \\rangle_{\\mathrm{abs}({s-r})}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19ec8f77-c595-4efb-956f-fe051ba24a0e"],
 ". To this end first determine all grades of both multivectors using command \
",
 StyleBox["gaGradeList[MV]",
  FontWeight->"Bold"],
 ", which returns all grades of multivector MV and delete a scalar grade (we \
assume that after removing a scalar lists are not empty, otherwise an inner \
product will turn to zero)."
}], "Text",ExpressionUUID->"b84bd5aa-cc02-415f-b9ba-9f1ba779560c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"aMV", "=", 
