   RowBox[{"testAlgebra", ",", 
    RowBox[{"\"\<StartingElement\>\"", "\[Rule]", "3"}], ",", 
    RowBox[{
    "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
     "\"\<InvDeg[Lex]\>\""}], ",", 
    RowBox[{"\"\<OutputForm\>\"", "\[Rule]", "\"\<IdempotentFactors\>\""}], 
    ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"idempotentE3Minus", "=", 
  RowBox[{"idempotentE3Plus", "/.", 
