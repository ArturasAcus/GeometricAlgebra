Cell[TextData[{
 "In order to use ",
 StyleBox["gaToMatrixRepresentation[] ",
  FontWeight->"Bold"],
 "(which converts MV to matrix representation) we have to define full \
representation (the option above \[OpenCurlyDoubleQuote]",
 StyleBox["Grades\[CloseCurlyDoubleQuote]\[Rule]{1}",
  FontWeight->"Bold"],
 " computed only representation of basis vectors, for details see ",
 StyleBox["\\ref{matrixrepresentations}",
  FontColor->RGBColor[1, 0, 0]],
 "). If  we chose ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb21453a-846c-4f1c-b9e8-0e7859de744e"],
 " , which is represented by Pauli matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          OverscriptBox[
           StyleBox["e", "TI"], "^"], "2"], "\[LongEqual]", 
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"0", 
                 RowBox[{"-", 
                   StyleBox["i", FontSlant -> "Plain"]}]}, {
                 StyleBox["i", FontSlant -> "Plain"], "0"}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{e}_{2}=\\left[\\begin{matrix}0&-\\ii\\\\\\ii&0\\end{matrix}\\\
right]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6da2d9e3-5dd4-413b-bd02-930a3916b747"],
 " then"
}], "Text",
 CellChangeTimes->{{3.93159555814789*^9, 
  3.931595566726115*^9}},ExpressionUUID->"288caa6a-a93a-4fea-bb34-\
326ae21dfa96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MapAt", "[", 
  RowBox[{"MatrixForm", ",", 
   RowBox[{"(", 
    RowBox[{"PauliSpinVectors", "=", 
     RowBox[{"gaDefineMatrixRepresentation", "[", 
      RowBox[{
       RowBox[{"Cl", "[", 
        RowBox[{"3", ",", "0"}], "]"}], ",", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<TensorProduct\>\"", ",", 
          RowBox[{"\"\<ElementaryRepresentations\>\"", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"0", ",", "1"}], "]"}], "\[Rule]", "\"\<Complex\>\""}],
              ",", 
             RowBox[{
              RowBox[{"Cl", "[", 
               RowBox[{"2", ",", "0"}], "]"}], "\[Rule]", 
              "\"\<IPauli[1,2]\>\""}]}], "}"}]}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsMultipliers\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", "1", "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"\"\<BasisVectorsReordering\>\"", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3", ",", "2"}], "}"}]}], ",", 
       RowBox[{"\"\<Grades\>\"", "\[Rule]", 
        RowBox[{"{", "1", "}"}]}]}], "]"}]}], ")"}], ",", 
   RowBox[{"{", 
    RowBox[{"All", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.677574799322069*^9, 3.677574811933105*^9}, {
   3.677578647837334*^9, 3.677578671885544*^9}, {3.678028494572981*^9, 
   3.678028516841118*^9}, {3.678029912810376*^9, 3.678029921308562*^9}, {
   3.678371572804096*^9, 3.678371574644581*^9}, {3.778816962077201*^9, 
   3.778817036681988*^9}, {3.7788170742110662`*^9, 3.77881708915711*^9}, {
   3.82195428379673*^9, 3.821954349053075*^9}, {3.8219543802515793`*^9, 
