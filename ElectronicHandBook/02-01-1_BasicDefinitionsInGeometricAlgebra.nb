Cell[TextData[{
 "Overbar conjugation can be computed using more general  ",
 StyleBox["gaGradeNegate[mv, gradesToNegate_List]",
  FontWeight->"Bold"],
 ",  described below, which negates all grades given in the list ",
 StyleBox[" gradesToNegate",
  FontWeight->"Bold"],
 ". Therefore removing from the list zero we would implement overbar \
conjugation. In fact overbar conjugation is already  implemented as ",
 StyleBox["gaNonZeroGradeInverse[ ]",
  FontWeight->"Bold"],
 " command"
}], "Text",ExpressionUUID->"7c425e02-eb97-40a9-9aec-42c34dcd6165"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gaGradeNegate", "[", 
  RowBox[{"generalMVu", ",", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"gaGradeList", "[", "generalMVu", "]"}], ",", "0"}], "]"}]}], 
