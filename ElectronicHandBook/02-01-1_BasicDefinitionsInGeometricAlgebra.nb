Cell[TextData[{
 "Check that both computed results indeed agree (we often need to expand both \
sides, since ",
 StyleBox["gaPE[]",
  FontWeight->"Bold"],
 " command  expands only geometric, outer and inner product). We note that \
internal implementation don\[CloseCurlyQuote]t use this clumsy summation \
formula."
}], "Text",ExpressionUUID->"4bc94535-8d6b-4e86-aa16-f21162172941"],

