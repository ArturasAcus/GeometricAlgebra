Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of primitive and orthogonal  idempotents",
  FontSlant->"Italic"],
 ".   Any primitive idempotent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19fe6899-f203-4015-bc0a-d33892e7f21e"],
 " can be expressed as a product of simple idempotents of the form  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> " \\frac{1}{2}(1+B_{T_i}),", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f9a3072-c5a6-4ab0-907f-244822a5334b"],
 " \[LineSeparator]\n  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{
             StyleBox["p", "TI"], ",", 
             StyleBox["q", "TI"]}]]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], "1"]]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], "2"]]}], ")"}], "\[CenterEllipsis]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["k", "TI"]]]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{p}{q}}={\\frac{1}{2}}\\big(1+ \
B_{T_1}\\big){\\frac{1}{2}}\\big(1+ \
B_{T_2}\\big)\\cdots{\\frac{1}{2}}\\big(1+ B_{T_k}\\big),", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "70fe4051-0f5a-4682-b60c-c368904d1bc3"],
 "\[LineSeparator]\[LineSeparator]\n where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2b972c06-19f6-482f-bbdc-38dd353c59e6"],
 " is a basis element of GA that squares to unity, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]], "2"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "B_{T_i}^2=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ea64738-0d4f-4406-98f0-99a098b1c809"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99b95fcb-18a0-4827-b2d1-e3ab8898233e"],
 " denotes a multi-index. Different ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ccdddd3-eced-4cf6-83c4-8c6b7eabcd17"],
 "\[CloseCurlyQuote]s pairwise commute, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]]], 
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["j", "TI"]]], "-", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["j", "TI"]]], 
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]]], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{T_i}B_{T_j}-B_{T_j}B_{T_i}=0", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7202fd17-f4cb-4835-ba45-153b244b1262"],
 ". Two simple idempotents with opposite\nsigns of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c19c2c8-3fe5-4f1e-9f18-ac418ee49ab8"],
 ", namely, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "+"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_{+}=\\frac{1}{2}(1+B_{T_i})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b6c1109a-d36e-496b-9d9e-cd2ef6b8d7d3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "-"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["i", "TI"]]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_{-}=\\frac{1}{2}(1-B_{T_i})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "21cb46f6-b8bc-4475-aeae-b793e81f8106"],
 ", are orthogonal, i.e., their GP is zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "+"], 
         SubscriptBox[
          StyleBox["p", "TI"], "-"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "-"], 
         SubscriptBox[
          StyleBox["p", "TI"], "+"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_{+}p_{-}=p_{-}p_{+}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ffae9d8-ff18-41c2-907a-30e04f63ef8e"],
 ". Since the sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["p", "TI"], "+"], "+", 
         SubscriptBox[
          StyleBox["p", "TI"], "-"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "p_{+}+p_{-}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4024999b-7783-4337-8689-0d30d2d266ca"],
 ", its terms ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], "+"], TraditionalForm], "errors" -> {}, "input" -> 
     "p_{+}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e194e67c-2cac-46e5-a836-6542008f4028"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], "-"], TraditionalForm], "errors" -> {}, "input" -> 
     "p_{-}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "17ecb08e-113d-4a81-b9d2-0d385a2d7f54"],
 " are complementary projectors. Then, the  sum of projections ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         SubscriptBox[
          StyleBox["p", "TI"], "+"], 
         StyleBox["a", "TI"], 
         StyleBox["n", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["M", "TI"], 
         SubscriptBox[
          StyleBox["p", "TI"], "-"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{M} p_{+} and \\m{M} p_{-}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d33d9752-3bad-43be-ac40-d1a0edc7a84c"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "425dee75-5d35-4488-9c6c-32f23c14675b"],
 " is a MV, returns the initial MV, i.e., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         SubscriptBox[
          StyleBox["p", "TI"], "+"], "+", 
         StyleBox["M", "TI"], 
         SubscriptBox[
          StyleBox["p", "TI"], "-"], "\[LongEqual]", 
         StyleBox["M", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["p", "TI"], "+"], "+", 
             SubscriptBox[
              StyleBox["p", "TI"], "-"]}], ")"}], "\[LongEqual]", 
         StyleBox["M", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}p_{+}+\\m{M}p_{-}=\\m{M}(p_{+}+p_{-})=\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b7d954b-a347-4060-ada2-ccb17889a99a"],
 ". Multiplication by idempotent from the left and right, in general, yields \
different projections, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         SubscriptBox[
          StyleBox["p", "TI"], "\[PlusMinus]"], "\[NotEqual]", 
         SubscriptBox[
          StyleBox["p", "TI"], "\[PlusMinus]"], 
         StyleBox["M", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}p_{\\pm}\\ne p_{\\pm}\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef7c2a0b-eab4-4dd3-9c27-8c271aecf644"],
 "."
}], "Item",ExpressionUUID->"a75d24f9-28ef-4fad-bce2-acb490a86d00"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Primitive idempotent of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"8", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{8}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "0b8c234e-97a4-4a36-984e-df85a95b40c5"],
 ". The multivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"8", ",", "0"}]]], "\[LongEqual]", 
         FractionBox["1", "16"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2345"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "4567"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{8}{0}}=\\frac{1}{16}(1+\\e{1})(1+\\e{2345})(1+\\e{4567})(1+\
\\e{2468})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4445cba2-dfd4-468a-821d-930bd53677b3"],
 " is a primitive idempotent. It is a product of four simple idempotents, for \
example ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox["1", "2"], "(", 
              RowBox[{"1", "+", 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], ")"}], 
          "2"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\big(\\frac{1}{2}(1+\\e{1})\\big)^2=\\frac{1}{2}(1+\\e{1})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9c3abc29-42f2-4210-87a7-818fc66a18a3"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox["1", "2"], "(", 
              RowBox[{"1", "+", 
                SubscriptBox[
                 StyleBox["e", FontSlant -> "Plain"], "2345"]}], ")"}], ")"}],
           "2"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2345"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\big(\\frac{1}{2}(1+\\e{2345})\\big)^2=\\frac{1}{2}(1+\\e{2345})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ebd74270-6abb-455a-a136-26f09572bfd3"],
 " etc. All ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd380d74-144c-4418-a1d4-4da1ef15b8a0"],
 " mutually commute. For example, the commutator of the 4-blades ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], "1"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2345"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{T_1}=\\e{2345}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cca4a185-f25d-44d3-b4ba-a13204977927"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], "2"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4567"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "B_{T_2}=\\e{4567}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d0e19317-8f10-4752-9864-d42e6989c80c"],
 " is zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"[", 
           RowBox[{
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], "1"]], ",", 
             SubscriptBox[
              StyleBox["B", "TI"], 
              SubscriptBox[
               StyleBox["T", "TI"], "2"]]}], "]"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "[B_{T_1},B_{T_2}]=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "816003e6-666a-425e-bb17-ea4b4b666a51"],
 ". Any combination of simple idempotents constructed from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PlusMinus]", 
         SubscriptBox[
          StyleBox["B", "TI"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\pm B_{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92565c6f-b8dd-47ec-a53b-a4842ea9e7fb"],
 " blades is idempotent too, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{
              FractionBox["1", "4"], 
              RowBox[{"(", 
                RowBox[{"1", "+", 
                  SubscriptBox[
                   StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
              RowBox[{"(", 
                RowBox[{"1", "+", 
                  SubscriptBox[
                   StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}]}], 
            ")"}], "2"], "\[LongEqual]", 
         FractionBox["1", "16"], 
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], "(", 
             RowBox[{"1", "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}], ")"}], 
         
         RowBox[{"(", 
           RowBox[{
             RowBox[{"(", 
               RowBox[{"1", "+", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], "(", 
             RowBox[{"1", "+", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}], ")"}], 
         "\[LongEqual]", 
         FractionBox["1", "16"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], "2"], 
         SuperscriptBox[
          RowBox[{"(", 
            RowBox[{"1", "+", 
              SubscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}], "2"], 
         "\[LongEqual]", 
         FractionBox["1", "4"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\big(\\frac{1}{4}(1+\\e{1})(1+\\e{2468})\\big)^2= \
\\frac{1}{16}\\big((1+\\e{1})(1+\\e{2468})\\big)\\big((1+\\e{1})(1+\\e{2468})\
\\big)= \\frac{1}{16}(1+\\e{1})^2(1+\\e{2468})^2=\\frac{1}{4}(1+\\e{1})(1+\\e{\
2468})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fdca326d-64fa-494b-9997-18fbbd9d662b"],
 ". ",
 StyleBox["[",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["pataisyta indekso klaida",
  FontColor->RGBColor[1, 0, 0]],
 StyleBox["]",
  FontColor->RGBColor[1, 0, 0]]
}], "Subitem",ExpressionUUID->"71c97231-bb80-450d-8d67-edffc7a8111b"],

