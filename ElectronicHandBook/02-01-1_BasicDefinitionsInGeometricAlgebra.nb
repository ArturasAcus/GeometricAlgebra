Cell[CellGroupData[{

Cell["Outer product", "Section",
 CellChangeTimes->{{3.910234655280381*^9, 3.910234662007681*^9}, {
  3.9102392159867783`*^9, 3.910239218248143*^9}},
 CounterAssignments->{{"Section", 0}, {"Subsubsection", 0}, {"Item", 11}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 0}, {
   "SubitemNumbered", 0}, {
   "SubsubitemNumbered", 
    0}},ExpressionUUID->"d7d09913-83fe-4dba-a28f-f7c9f5e4c5f0"],

Cell[TextData[{
 "The outer product, also called wedge and sometimes Grassmann product, \
allows to construct the oriented surface, oriented volume and hypervolume \
from the vectors in the n-dimensional vector space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "n"], TraditionalForm]],ExpressionUUID->
  "b58f7454-1efa-4a5d-832c-260df3d90d70"],
 ". These oriented objects make up, respectively, grade-m subspaces ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"edd80089-242f-4886-bac3-04cbd99fcfe1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "3"], "n"], TraditionalForm]],
  ExpressionUUID->"9075391f-2ce0-4cf8-b202-37aa18138bcb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "4"], "n"], TraditionalForm]],
  ExpressionUUID->"166de0b3-4e19-4333-9d6c-3c774400bf21"],
 ",...,",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "n"], "n"], TraditionalForm]],
  ExpressionUUID->"51688969-c015-4083-8ab2-73a2be671cb6"],
 " and are characterized by two internal orientations which depending on a \
nature of the object may be named as plus-minus, up-down, \
clockwise-anticlockwise, right-left etc."
}], "Text",
 CellChangeTimes->{{3.910239232111906*^9, 3.910239234972002*^9}, {
  3.910239295394642*^9, 3.910239432961037*^9}, {3.910239533204032*^9, 
  3.910239562881537*^9}},ExpressionUUID->"fcd51984-8617-4da2-9674-\
3cf745052463"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Outer product properties",
  FontSlant->"Italic"],
 ". The outer product space ",
