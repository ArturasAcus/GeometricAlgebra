Cell[CellGroupData[{

Cell["Involutions and conjugation", "Section",
 CounterAssignments->{{"Section", 0}, {"Subsubsection", 0}, {"Item", 34}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 43}, {
   "SubitemNumbered", 0}, {
   "SubsubitemNumbered", 
    0}},ExpressionUUID->"e777c6ef-dd66-4543-8a2b-a9eda2fa2149"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Main GA involutions.",
  FontSlant->"Italic"],
 "  The (anti-)involution (aka (anti-)involutory function) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed021f04-613e-4d03-a92e-2c115a2d54d4"],
 ", satisfies the equation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["f", "TI"], "(", 
             StyleBox["x", "TI"], ")"}], ")"}], "\[LongEqual]", 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "f(f(x))=x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5371cb4d-c242-43a9-b00e-f2e066505b77"],
 ", i.e.,  the operation applied twice returns the initial argument. In other \
words, operation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["f", "TI"], TraditionalForm], "errors" -> {}, "input" -> "f ",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cea17f60-54de-4cb1-aac3-ee5b95794869"],
 " is its own   inverse. In GA there are four main or fundamental  \
(anti-)involutions: identity id",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         StyleBox["A", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(\\m{A})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "78be63b2-4daa-42df-a62f-cc63e1085418"],
 ",  reversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["A", "TI"], "~"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\reverse{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4cb94ad-5d5c-4c01-8fd0-31b57f84f6b3"],
 ", grade inversion ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], 
       TraditionalForm], "errors" -> {}, "input" -> "\\gradeinverse{\\m{A}}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "474ee09a-04eb-4942-b7bc-c9de44218d89"],
 ", and Clifford conjugation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        OverscriptBox[
         StyleBox["A", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\cliffordconjugate{\\m{A}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "57c5f62e-8a5a-45b8-98fa-749663a1bbee"],
 ". The identity involution (id),  as the name implies, leaves the MV \
unchanged: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["id", FontSlant -> "Plain"], 
         RowBox[{"(", 
           StyleBox["A", "TI"], ")"}], "\[LongEqual]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{id}(\\m{A})= \\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8eeeb65f-4131-4110-b349-b0021eded665"],
 ". The properties of other involutions are discussed below.  The listed four \
main involutions constitute a group of four also called F. Klein group that \
is isomorphic to physical space (aka Galileo space) symmetry group ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{"1", ",", 
           StyleBox["P", "TI"], ",", 
           StyleBox["T", "TI"], ",", 
           StyleBox["P", "TI"], 
           StyleBox["T", "TI"]}], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{1,P,T,PT\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1586f738-cac2-40bd-9d99-3c3f724d20c0"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["P", "TI"], TraditionalForm], "errors" -> {}, "input" -> "P", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d996fc6d-b545-42d7-b368-402e3af8e077"],
 " is the space inversion (aka parity), ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> "T", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92ebd526-2f63-4847-ac97-6a7208494ff4"],
 " is the time reversal and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], 
         StyleBox["T", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "PT", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b4704a4-0aaa-4ff9-adc2-54b4d02e1114"],
 " is their combination. When the algebra dimension is not large the listed \
main involutions suffice to do all calculations. Actually, if needed, as the ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"Table", " ", "shows"}],
    BaseStyle->"Hyperlink",
    ButtonData->"TableOfTriangeInvolutions"], TraditionalForm]],
  ExpressionUUID->"d50f8450-1906-486d-b881-9962fa4d80ad"],
 ", the main involutions may be extended  to grade-7 including. The main \
involutions remain in higher dimensions too, however, for grades ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["k", "TI"], ">", "7"}], TraditionalForm], "errors" -> {}, 
     "input" -> "k>7", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd22b188-a2d9-4cb6-83cc-8f384d224506"],
 " new involutions appear (see the Table)."
}], "Item",ExpressionUUID->"d41a0d1a-1460-4531-8f18-6dbee0dd3b43"],

