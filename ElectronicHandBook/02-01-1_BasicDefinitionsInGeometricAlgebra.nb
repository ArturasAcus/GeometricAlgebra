Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Left and right contraction in!",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63069fd3-ce5e-4aa8-8262-4759c522a2c1"],
 ".   Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "1"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e64e79c2-b41a-4566-99e8-66dd699e8990"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0bb87f11-047f-4d78-b6af-296571eb9c3f"],
 " be basis vectors of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{2}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1aaadafc-4ad0-408b-aee2-48e490b473c1"],
 ". Then, calculation of the same product using the dot product and the left \
and  right contractions give different \
results\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{"(", 
               RowBox[{
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], "2"]}], ")"}], 
             RowBox[{"\[CenterDot]", 
               RowBox[{"(", 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
                   SubscriptBox[
