Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Relation to determinants",
  FontSlant->"Italic"],
 ". The outer products of two, three and more vectors are closely related to \
the determinant of a square matrix. For example,\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["det", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], ",", 
             StyleBox["b", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             Cell[
              BoxData[
               FormBox[
                GridBox[{{
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["a", "TI"], "1"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], "1"], "InlineFormula"], " "}]]}, {
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["a", "TI"], "2"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], "2"], "InlineFormula"], " "}]]}}], 
                TraditionalForm]]]}]}, "Abs"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], ","}], TraditionalForm],
      "errors" -> {}, "input" -> 
     "a\\wedge b=\\mathrm{det}(a,b)\\mathrm{e}_{12}=\\begin{vmatrix}\n \
a_1&b_1\\\\\n a_2&b_2\\\\\n\\end{vmatrix}\\mathrm{e}_{12},", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb2af822-a209-4c33-b6ff-1646113edaf6"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[LongEqual]", "det", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], ",", 
             StyleBox["b", "TI"], ",", 
             StyleBox["c", "TI"]}], ")"}], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             Cell[
              BoxData[
               FormBox[
                GridBox[{{
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["a", "TI"], "1"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], "1"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["c", "TI"], "1"], "InlineFormula"], " "}]]}, {
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["a", "TI"], "2"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], "2"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["c", "TI"], "2"], "InlineFormula"], " "}]]}, {
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["a", "TI"], "3"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["b", "TI"], "3"], "InlineFormula"], " "}]], 
                   Cell[
                    TextData[{" ", 
                    Cell[
                    SubscriptBox[
                    StyleBox["c", "TI"], "3"], "InlineFormula"], " "}]]}}], 
                TraditionalForm]]]}]}, "Abs"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], ",  ", 
         RowBox[{"etc", ","}]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b\\wedge c=\\textrm{det}(a,b,c)\\mathrm{e}_{123}=\n\
\\begin{vmatrix}\n a_1&b_1&c_1\\\\\n a_2&b_2&c_2\\\\\n a_3&b_3&c_3\\\\\n\
\\end{vmatrix}\\mathrm{e}_{123},\\quad\\textrm{etc,}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0d7e1e15-ad2f-47e2-ade7-3699db841bcd"],
 "\n\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox[
          StyleBox["b", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i, b_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6728fcfd-d972-4c03-84bd-9fe4a2ac2e42"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["c", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "c_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a813dbbd-af85-444e-8b85-6a980610224e"],
 " are vector coordinates (scalars) in an arbitrary orthonormal basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c0da0b4-cd5c-494e-aad6-0bcef5f77d2e"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "\[Congruent]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{12}\\equiv\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4d98be23-79f9-4317-919c-69893537eca7"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "\[Congruent]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{123}\\equiv\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}\\wedge\\\
mathrm{e}_{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c4edc8a-c3c4-43b7-af72-089256357777"],
 " are, respectively, the basis bivector (aka grade-2 basis vector) and basis \
trivector (aka grade-3 basis vector). The outer product increases the \
dimension of the graded subspace with respect to that of multipliers.\n\n\
Grade-r vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{"123", "\[Ellipsis]", 
            StyleBox["r", "TI"]}]], "\[Congruent]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[Wedge]", 
         "\[Ellipsis]", "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{123\\dots\n\
r}\\equiv\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}\\wedge\\dots\\wedge\\mathrm{e}_\
{r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1c99854-e221-4578-8796-e91b171f5929"],
 " is an example of a homogeneous MV, which is called the blade. When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[LongEqual]", "2"}], TraditionalForm], 
     "errors" -> {}, "input" -> "r=2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa8ecbd8-3a1b-4bd8-a575-963766f774c8"],
 " we have the bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11ffd753-ab15-4677-a5a7-6fa8ba6cd9c2"],
 " which is  the blade. The sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{1}\\wedge\\mathrm{e}_{2}+\\mathrm{e}_{3}\\wedge\\mathrm{e}_\
{4}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a19c7a87-98e4-4d4b-99e2-ccbd3946b886"],
 " is a bivector too. However, the latter is inhomogeneous MV and therefore \
not the blade. Geometrically it represents two nonintersecting planes. Both \
the homogeneous and inhomogeneous bivectors can be selected by grade-2  \
projector usually denoted as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{A}\\rangle_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bdfcaa59-a4e0-4b9f-b4a8-5472c87c3140"],
 " from the MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1e9ce94-2829-43d8-9447-4d5fb7759c25"],
 "."
}], "Item",ExpressionUUID->"7a0ae216-a23f-4a97-a33c-6ae00a2f36ab"],

