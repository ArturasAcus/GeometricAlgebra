Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Index raising and lowering rule",
  FontSlant->"Italic"],
 ".  In orthonormal basis, when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\e{1}\\cdot\\e{j}=\\delta_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30299a53-9279-41e4-a4e5-ce3764a92162"],
 ", the metric matrix consists of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PlusMinus]", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2cbf33dc-753b-477c-8583-f36862a6dc62"],
 "\[CloseCurlyQuote]s only. In this case the projections of vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "22a9065a-6cbe-41aa-96f6-389ce3005fd4"],
 " onto initial basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4f7934f6-220a-40a2-916c-02faab31c292"],
 " and reciprocal basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{}^i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d66b0453-535a-4699-b91b-21563d3cf19f"],
 " are\neither equal or differ by sign only. This property allows to \
introduce a simple rule for alteration  between both orthonormal basis.\
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{e}_{i}=\\mathrm{e}_{}^i,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4026682-cca7-45f5-8add-d9172084e999"],
 " if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_ {i}^2=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a497f39f-1b79-4584-80da-b8db48dd7b3a"],
 ",\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{i}=-\\mathrm{e}_{}^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5e2a8758-3815-4008-9796-75ea9d5f4aca"],
 ", if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "-1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\mathrm{e}_{i}^2=-1", "state" -> "Boxes"|>,
    
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bb2832ab-c1ba-4c6e-95de-56cfd21fc35a"],
 ".\t(index raising/lowering rule)\[LineSeparator]\nThe rule can be extended \
to blades by applying it to every individual basis vector in the blade. For \
example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{123}=\\mathrm{e}_{1}\\mathrm{e}_{2}\\mathrm{e}_{3}=\\\
mathrm{e}_{}^1\\mathrm{e}_{}^2\\mathrm{e}_{}^3", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c149d9ea-b892-4fd7-a77c-c2661fc6762f"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{3,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d5f26055-b28b-421c-8a2c-af85ce477908"],
 "  and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{1,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "838af308-5539-4f7c-8710-5d39318f3bf4"],
 ", whereas  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "\[LongEqual]", "-", 
