                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["j", "TI"]], 
                   SuperscriptBox[
                    StyleBox["f", "TI"], 
                    StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["i", "TI"]], "\[Wedge]", 
