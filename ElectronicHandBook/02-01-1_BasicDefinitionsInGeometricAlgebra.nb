Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Left and right contractions in 3D algebras",
  FontSlant->"Italic"],
 ".   Let\[CloseCurlyQuote]s  imitate the action of left and right \
contractions for general MVs\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["a", "TI"], "0"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "1"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "3"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "12"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "13"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "23"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "23"], "+", 
               SubscriptBox[
                StyleBox["a", "TI"], "123"], 
               SubscriptBox[
                StyleBox["I", "TI"], "3"], ","}]}, {"\[Null]", 
             RowBox[{
               StyleBox["B", "TI"], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["b", "TI"], "0"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "1"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "3"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "3"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "12"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "13"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "23"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "23"], "+", 
               SubscriptBox[
                StyleBox["b", "TI"], "123"], 
               SubscriptBox[
                StyleBox["I", "TI"], "3"]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\
&\\m{A}=a_0+a_1\\e{1}+a_2\\e{2}+a_3\\e{3}+a_{12}\\e{12}+a_{13}\\e{12}+a_{23}\\\
e{23}+a_{123}I_3,\\\\\n\
&\\m{B}=b_0+b_1\\e{1}+b_2\\e{2}+b_3\\e{3}+b_{12}\\e{12}+b_{13}\\e{12}+b_{23}\\\
e{23}+b_{123}I_3\\\\\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd6fe4af-c4ea-4ac6-9a1d-c87ae1f83b37"],
 "\[LineSeparator]\nusing grade selectors. For this purpose it is enough to \
expand formulas provided above. Introducing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}_i=\\langle\\m{A}\\rangle_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f6e1221e-1138-47fd-9484-3c4593afb9a3"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["B", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}_i=\\langle\\m{B}\\rangle_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10cd063c-2c6c-435d-8962-88418b1c94a1"],
 " we have\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               StyleBox["A", "TI"], "\[RightFloor]", 
               StyleBox["B", "TI"], "\[LongEqual] "}], 
             RowBox[{
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "0"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "0"]}], "\[RightAngleBracket]"}], 
                "0"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "0"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "1"]}], "\[RightAngleBracket]"}], 
                "1"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "0"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "2"]}], "\[RightAngleBracket]"}], 
                "2"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "0"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "3"]}], "\[RightAngleBracket]"}], 
                "3"], "+"}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "1"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "1"]}], "\[RightAngleBracket]"}], 
                "0"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "1"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "2"]}], "\[RightAngleBracket]"}], 
                "1"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "1"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "3"]}], "\[RightAngleBracket]"}], 
                "2"], "+"}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "2"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "2"]}], "\[RightAngleBracket]"}], 
                "0"], "+", 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "2"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "3"]}], "\[RightAngleBracket]"}], 
                "1"], "+"}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    StyleBox["A", "TI"], "3"], 
                    SubscriptBox[
                    StyleBox["B", "TI"], "3"]}], "\[RightAngleBracket]"}], 
                "0"], "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
