Cell[TextData[{
 "To check that this trick  indeed produced reciprocal frame we check the \
defining relation ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e_i\\cdot e^j=e^j\\cdot e_i=\\delta_i^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c6b09f7-e1dc-4120-b64c-52cf753fed60"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.911964079148862*^9, 3.911964395663423*^9}, {
  3.91196445157487*^9, 3.911964476201081*^9}, {3.91196885985618*^9, 
