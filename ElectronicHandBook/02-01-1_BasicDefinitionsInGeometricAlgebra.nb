Cell[TextData[{
 "3) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          UnderscriptBox[
           UnderscriptBox[
            RowBox[{
              StyleBox["U", "TI"], "\[CenterEllipsis]", 
              StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
            False], 
           StyleBox["k", "TI"], LimitsPositioning -> False], "_"], 
         UnderscriptBox[
          UnderscriptBox[
           RowBox[{
             StyleBox["U", "TI"], "\[CenterEllipsis]", 
             StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
           False], 
          StyleBox["t", "TI"], LimitsPositioning -> False], 
         OverscriptBox[
          UnderscriptBox[
           UnderscriptBox[
            RowBox[{
              StyleBox["U", "TI"], "\[CenterEllipsis]", 
              StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
            False], 
           StyleBox["s", "TI"], LimitsPositioning -> False], "_"], 
         "\[LongEqual]", 
         UnderscriptBox[
          UnderscriptBox[
           RowBox[{
             StyleBox["U", "TI"], "\[CenterEllipsis]", 
             StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
           False], 
          StyleBox["t", "TI"], LimitsPositioning -> False], 
         OverscriptBox[
          UnderscriptBox[
           UnderscriptBox[
            RowBox[{
              StyleBox["U", "TI"], "\[CenterEllipsis]", 
              StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
            False], 
           StyleBox["k", "TI"], LimitsPositioning -> False], "_"], " ", 
         OverscriptBox[
          UnderscriptBox[
           UnderscriptBox[
            RowBox[{
              StyleBox["U", "TI"], "\[CenterEllipsis]", 
              StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
            False], 
           StyleBox["s", "TI"], LimitsPositioning -> False], "_"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{k}}\n\\underbrace{\\m{U}\
\\cdots \\m{U}}_{t}\n\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{s}}\n =\n\
\\underbrace{\\m{U}\\cdots \\m{U}}_{t}\n\\overline{\\underbrace{\\m{U}\\cdots \
\\m{U}}_{k}}\\\n\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{s}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98f045b7-c465-4aae-b1bf-6aaea70e62ac"],
 " , commutation. Since here we have product of many MVs we will save a lot \
of time if we will work with numerical MV. Lets generate one."
}], "Text",ExpressionUUID->"eb8b5e8e-86ef-4af4-b460-d2e27d86f16e"],

