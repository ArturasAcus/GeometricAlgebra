Cell[BoxData[
 RowBox[{
  RowBox[{"outerProductViaDeterminant", "[", "vecOutProd_OuterProduct", "]"}],
   ":=", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"theAlgebra", "=", 
        RowBox[{"gaGetAlgebra", "[", 
         RowBox[{"First", "[", "vecOutProd", "]"}], "]"}]}], ",", "theBasis", 
       ",", "theReciprocalVectors", ",", 
       RowBox[{"vecOutProdList", "=", 
        RowBox[{"List", "@@", 
         RowBox[{"(", "vecOutProd", ")"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"theBasis", "=", 
       RowBox[{"gaDefineOrthonormalBasis", "[", 
        RowBox[{"theAlgebra", ",", 
         RowBox[{
         "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
          "\"\<InvDeg[Lex]\>\""}], ",", 
         RowBox[{"\"\<Grades\>\"", "\[Rule]", 
          RowBox[{"{", "1", "}"}]}]}], "]"}]}], ";", 
      RowBox[{"theReciprocalVectors", "=", 
       RowBox[{"theBasis", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"mvDownUp", "[", 
           RowBox[{"di_List", ",", "ui_List"}], "]"}], ":>", 
          RowBox[{"mvDownUp", "[", 
           RowBox[{"ui", ",", "di"}], "]"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Det", "[", 
        RowBox[{"Outer", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"gaPE", "[", 
            RowBox[{"InnerProduct", "[", "##", "]"}], "]"}], "&"}], ",", 
          "vecOutProdList", ",", "theReciprocalVectors"}], "]"}], "]"}], "*", 
       
       RowBox[{"gaI", "[", "theAlgebra", "]"}]}]}]}], "]"}], "/;", 
   RowBox[{
    RowBox[{
     RowBox[{"Union", "[", 
      RowBox[{"gaGradeList", "/@", 
       RowBox[{"(", 
        RowBox[{"List", "@@", "vecOutProd"}], ")"}]}], "]"}], "===", 
     RowBox[{"{", 
      RowBox[{"{", "1", "}"}], "}"}]}], "&&", 
    RowBox[{
     RowBox[{"Length", "[", "vecOutProd", "]"}], "===", 
     RowBox[{"(", 
      RowBox[{"Plus", "@@", 
       RowBox[{"First", "[", 
        RowBox[{"Cases", "[", 
         RowBox[{"vecOutProd", ",", 
          RowBox[{"Cl", "[", 
           RowBox[{"p_", ",", "q_", ",", "___"}], "]"}], ",", "Infinity"}], 
         "]"}], "]"}]}], ")"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.911963874459859*^9, 3.911963921167461*^9}, {
  3.931595488990437*^9, 3.9315954936271677`*^9}, {3.949644145208558*^9, 
  3.949644148173768*^9}},
 CellLabel->
  "In[186]:=",ExpressionUUID->"1d281a64-5868-48ea-88dc-bc25fb1829aa"],

