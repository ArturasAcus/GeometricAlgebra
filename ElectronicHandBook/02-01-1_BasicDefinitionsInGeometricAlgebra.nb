Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Main involutions, periodicity of four.",
  FontSlant->"Italic"],
 "  The action of four standard involutions on a general MV exhibits a \
repetitive pattern. The periodicity is summarized in the following table \
which is a part of a more extensive  table below.\[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             Cell[
              TextData[{" ", 
                Cell["grade", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["0", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["1", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["2", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["3", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["4", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["5", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["6", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["7", "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell[
                 StyleBox["id", FontSlant -> "Plain"], "InlineFormula"], 
                " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell["reverse", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell["grade inverse", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]]}, {
             Cell[
              TextData[{" ", 
                Cell["Clifford conjugate", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["-", "InlineFormula"], " "}]], 
             Cell[
              TextData[{" ", 
                Cell["+", "InlineFormula"], " "}]]}}], TraditionalForm]]], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\\text{grade} & 0 & 1 & 2 & 3 & 4 & 5 & 6 & 7}\\\\\n\
\\mathrm{id} &+&+&+&+&+&+&+&+\\\\\n\\text{reverse} &+&+&-&-&+&+&-&-\\\\\n\
\\text{grade inverse} &+&-&+&-&+&-&+&-\\\\\n\\text{Clifford conjugate} \
&+&-&-&+&+&-&-&+\\\\\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b8833d8-ca4c-4b48-9312-e10fc5caeac4"],
 "\[LineSeparator]\[LineSeparator]Main conjugations. The plus and minus signs \
indicate that the action of conjugation  on the blade has either  no effect \
or changes its sign to opposite, for example reverse acts on bivector as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          SubscriptBox[
           RowBox[{"\[LeftAngleBracket]", 
             StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"], "~"], 
         "\[Rule]", "-", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["A", "TI"], "\[RightAngleBracket]"}], "2"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\reverse{\\grade{\\m{A}}{2}}\\to-\\grade{\\m{A}}{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6b035491-ce7a-4b8e-a2d7-135976ea15d6"],
 " ."
}], "Item",ExpressionUUID->"ed9e4bfd-d0d1-4a66-a10a-c180e3d6f689"],

