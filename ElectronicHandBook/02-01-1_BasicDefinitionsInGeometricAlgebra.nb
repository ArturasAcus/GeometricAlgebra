     "errors" -> {}, "input" -> 
     "\\begin{split}\na\\w \
b&=(a^i\\e{i})\\w(b^j\\e{j})=(a^i\\e{i})\\w(b_j\\e{}^j)\n \
=a^ib_j\\e{i}\\w\\e{}^j=a^ib^j\\e{i}\\w\\e{j}=a_ib_j\\e{i}\\w\\e{j},\\\\\n \
\\mathrm{div}\\m{f}&=\\dot{\\nabla}\\d\\m{\\dot{f}}=\\e{}^i\\d\\frac{\\\
partial(\\e{j}f^j)}{\\partial x^i}=\n\\e{}^i\\d\\e{j}\\frac{\\partial \
f^j}{\\partial x^i}=\\delta^i_j\\frac{\\partial f^j}{\\partial x^i}\n=\\frac{\
\\partial f^i}{\\partial x^i}=\\frac{\\partial f_i}{\\partial x_i},\\\\\n\
\\mathrm{curl}\\m{f}&=\\dot{\\nabla}\\w\\m{\\dot{f}}=\\left(\\e{}^i\\frac{\\\
partial}{\\partial x^i}\\right)\\w\\left(\\e{j}f^j\\right)=\n\
(\\e{}^i\\w\\e{j})\\frac{\\partial f^j}{\\partial x^i}\n\\end{split}", 
