Cell["\<\
To test first three formulas of trace, let\[CloseCurlyQuote]s again generate \
partitions of four\
\>", "Text",ExpressionUUID->"b7ef52c1-457a-4e0c-85df-9bfa16a8cfd4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"allPartitionsOfFour", "=", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"gaSort", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\[DoubleStruckE]", "[", 
          RowBox[{
           RowBox[{"mvDownUp", "[", 
            RowBox[{"#", ",", 
             RowBox[{"{", "}"}]}], "]"}], ",", "testAlgebra"}], "]"}], "&"}], 
        "/@", 
        RowBox[{"(", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", "All"}], 
          "]"}], ")"}]}], ",", "\"\<RevLex\>\""}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[DoubleStruckE]", "[", 
        RowBox[{
         RowBox[{"mvDownUp", "[", 
          RowBox[{"idown_List", ",", 
           RowBox[{"{", "}"}]}], "]"}], ",", "testAlgebra"}], "]"}], ":>", 
       "idown"}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"1", "->", 
      RowBox[{"{", "0", "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[151]:=",ExpressionUUID->"35dc09e2-f8dc-4af2-bd61-9b9616157924"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "0", "}"}], ",", 
   RowBox[{"{", "1", "}"}], ",", 
   RowBox[{"{", "2", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}], ",", 
   RowBox[{"{", "3", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}], ",", 
   RowBox[{"{", "4", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.949910239593306*^9, 3.950157400380995*^9, 
  3.950158381229845*^9},
 CellLabel->
  "Out[151]=",ExpressionUUID->"0d41ba12-5460-4ae1-a1dd-d12100ff9338"]
}, Closed]],

Cell["For n=9 we have ", "Text",ExpressionUUID->"8961e70c-dcdb-475c-b6d3-32061c56c869"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mDim", "=", 
  RowBox[{
   RowBox[{"IntegerPart", "[", 
    RowBox[{"Log", "[", 
     RowBox[{"2", ",", 
      RowBox[{"gaDimensionOfVectorSpace", "[", "testAlgebra", "]"}]}], "]"}], 
    "]"}], "+", "1"}]}]], "Input",
