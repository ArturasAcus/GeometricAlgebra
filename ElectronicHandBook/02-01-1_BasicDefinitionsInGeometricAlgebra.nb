Cell[TextData[{
 StyleBox["Homogeneous MV parts.",
  FontSlant->"Italic"],
 " The general grade-1 elements (vector) in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "344fcb34-d0c0-459d-aecc-2ec520c9d817"],
 " algebra are\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "1"], 
         "\[Congruent]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "\[LongEqual]", "1"}], "4", 
          LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              StyleBox["M", "TI"], 
              SuperscriptBox[
               StyleBox["e", FontSlant -> "Plain"], 
               StyleBox["i", "TI"]]}], "\[RightAngleBracket]"}], "0"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SuperscriptBox[
          StyleBox["a", "TI"], "3"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "+", 
         SuperscriptBox[
          StyleBox["a", "TI"], "4"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     " \\grade{\\m{M}}{1}\\equiv \
a=\\sum_{i=1}^4\\langle\\m{M\\e{}^i}\\rangle_0\\e{i}=a^1\\e{1}+a^2\\e{2}+a^3\\\
e{3}+a^4\\e{4}, ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "80404eb3-3f44-416c-a502-710040da5ac1"],
 "\[LineSeparator]\nwhere ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "a^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf12e265-7c82-4ab8-891d-459cd807e788"],
 " real numbers (coordinates). The general grade-2 element (bivector) is a \
sum of elementary bivectors \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "2"], 
         "\[Congruent]", "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], "<", 
            StyleBox["j", "TI"]}], "4", LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              StyleBox["M", "TI"], 
              SuperscriptBox[
               StyleBox["e", FontSlant -> "Plain"], 
               RowBox[{
                 StyleBox["j", "TI"], " ", 
                 StyleBox["i", "TI"]}]]}], "\[RightAngleBracket]"}], "0"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["b", "TI"], "12"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "13"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "13"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "14"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "14"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "23"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "23"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "24"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "24"], "+", 
         SuperscriptBox[
          StyleBox["b", "TI"], "34"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "34"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\grade{\\m{M}}{2}\\equiv\\cB=\\sum_{i<j}^4\\langle\\m{M\\e{}^{\\textit{\
j\\,i}}}\\rangle_0\\e{ij}=b^{12}\\e{12}+b^{13} \\e{13}+b^{14}\\e{14}+\nb^{23}\
\\e{23}+b^{24}\\e{24}+b^{34}\\e{34}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "090ae4d3-bdea-49bf-9c45-23390e1f36ae"],
 ",\[LineSeparator]\[LineSeparator]where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["b", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "b^{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7203119f-8e0d-4aff-b8c6-0aef319460bd"],
 " are again the real numbers. Similarly, the grade-3  multivector \
(trivector) is \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "3"], 
         "\[Congruent]", 
         StyleBox["T", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["t", "TI"], "123"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "+", 
         SuperscriptBox[
          StyleBox["t", "TI"], "124"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "124"], "+", 
         SuperscriptBox[
          StyleBox["t", "TI"], "133"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "134"], "+", 
         SuperscriptBox[
          StyleBox["t", "TI"], "234"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "234"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\grade{\\m{M}}{3}\\equiv \
T=t^{123}\\e{123}+t^{124}\\e{124}+t^{133}\\e{134}+t^{234}\\e{234}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "954be3ed-855d-42c4-9b71-fa8b1db6b0f5"],
 ". \[LineSeparator]\nThe pseudoscalar always consist of a single member, \
\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "4"], 
         "\[Congruent]", 
         StyleBox["I", "TI"], "\[LongEqual]", "\[Alpha] ", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\grade{\\m{M}}{4}\\equiv I=\\alpha\\,\\e{1}\\e{2}\\e{3}\\e{4}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "13c8b973-75d3-4aa7-8f80-7b327dc3939f"],
 ".\[LineSeparator]\[LineSeparator]The individual MV coefficients, for \
example,  can be selected from MV or in this case from  trivector  by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "124"], "\[LongEqual]", 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"T", 
             SuperscriptBox[
              OverscriptBox[
               StyleBox["e", FontSlant -> "Plain"], "~"], "124"]}], 
           "\[RightAngleBracket]"}], "\[LongEqual]", 
         RowBox[{"\[LeftAngleBracket]", 
           RowBox[{"T", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "421"]}], 
           "\[RightAngleBracket]"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "a^{124}=\\langle\\text{T}\\reverse{\\e{}}^{124}\\rangle=\\langle\\text{\
T}\\e{}^{421}\\rangle", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3d8b7ca-b62f-42ce-946f-d772b4dc30d0"],
 ", where it is understood that the  basis elements in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", FontSlant -> "Plain"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{T}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dae999eb-aeab-4690-8c94-e1cb09fd7690"],
 " have lower indices."
}], "Subitem",ExpressionUUID->"e40ce2a9-329b-4bc6-81e5-02cb32786ac0"],

