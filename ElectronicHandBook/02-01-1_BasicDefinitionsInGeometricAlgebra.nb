Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Barred (Clifford) conjugation.",
  FontSlant->"Italic"],
 "  It changes signs of all blades except that before the scalar. Marked by \
bar, the conjugation is defined by \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["U", "TI"], "_"], ":", "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], "-", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["k", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["k", "TI"]], "\[LongEqual]", "2", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], "-", 
         StyleBox["U", "TI"], ",    ", 
         StyleBox["U", "TI"], "\[Element]", 
         SubscriptBox["Cl", 
          RowBox[{
            StyleBox["p", "TI"], ",", 
            StyleBox["q", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\overline{\\m{U}}:=\\grade{\\m{U}}{0}-\\sum_{k=1}^n  \
\\grade{\\m{U}}{k}=2\\grade{\\m{U}}{0}-\\m{U},\n\\qquad \\m{U}\\in\\cl{p}{q}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3ba7aa2-0894-4019-a448-c43f3b7fd4c7"],
 ".\n\nThe barred  conjugation (or simply the conjugation)  has the following \
properties:\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["U", "TI"], 
                  StyleBox["V", "TI"]}], "_"], 
               StyleBox["U", "TI"], "\[LongEqual]", 
               StyleBox["U", "TI"], 
               OverscriptBox[
                RowBox[{
                  StyleBox["V", "TI"], 
                  StyleBox["U", "TI"]}], "_"]}], "argument shifting"}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                RowBox[{
                  StyleBox["U", "TI"], 
                  OverscriptBox[
                   StyleBox["V", "TI"], "_"]}], "_"], "\[LongEqual]", 
               OverscriptBox[
                StyleBox["U", "TI"], "_"], 
               RowBox[{"(", 
                 RowBox[{
                   OverscriptBox[
                    StyleBox["V", "TI"], "_"], "+", 
                   StyleBox["V", "TI"]}], ")"}], "-", 
               OverscriptBox[
                RowBox[{
                  StyleBox["U", "TI"], 
                  StyleBox["V", "TI"]}], "_"]}], "one level flattening"}, {
            "\[Null]", 
             RowBox[{
               OverscriptBox[
                UnderscriptBox[
                 UnderscriptBox[
                  RowBox[{
                    StyleBox["U", "TI"], "\[CenterEllipsis]", 
                    StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                  False], 
                 StyleBox["k", "TI"], LimitsPositioning -> False], "_"], 
               UnderscriptBox[
                UnderscriptBox[
                 RowBox[{
                   StyleBox["U", "TI"], "\[CenterEllipsis]", 
                   StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                 False], 
                StyleBox["t", "TI"], LimitsPositioning -> False], 
               OverscriptBox[
                UnderscriptBox[
                 UnderscriptBox[
                  RowBox[{
                    StyleBox["U", "TI"], "\[CenterEllipsis]", 
                    StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                  False], 
                 StyleBox["s", "TI"], LimitsPositioning -> False], "_"], 
               "\[LongEqual]", 
               UnderscriptBox[
                UnderscriptBox[
                 RowBox[{
                   StyleBox["U", "TI"], "\[CenterEllipsis]", 
                   StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                 False], 
                StyleBox["t", "TI"], LimitsPositioning -> False], 
               OverscriptBox[
                UnderscriptBox[
                 UnderscriptBox[
                  RowBox[{
                    StyleBox["U", "TI"], "\[CenterEllipsis]", 
                    StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                  False], 
                 StyleBox["k", "TI"], LimitsPositioning -> False], "_"], " ", 
               
               OverscriptBox[
                UnderscriptBox[
                 UnderscriptBox[
                  RowBox[{
                    StyleBox["U", "TI"], "\[CenterEllipsis]", 
                    StyleBox["U", "TI"]}], "\[UnderBrace]", LimitsPositioning -> 
                  False], 
                 StyleBox["s", "TI"], LimitsPositioning -> False], "_"], 
               "        "}], "commutation"}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n&\\bar{\\m{UV}}\\m{U}=\\m{U}\\bar{\\m{VU}}& \
\\text{argument shifting}\\\\&\n\
\\overline{\\m{U}{\\bar{\\m{V}}}}=\\bar{\\m{U}}(\\bar{\\m{V}}+\\m{V})-\\bar{\\\
m{U V}}& \\text{one level flattening}\\\\&\n\
\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{k}}\n\
\\underbrace{\\m{U}\\cdots \\m{U}}_{t}\n\\overline{\\underbrace{\\m{U}\\cdots \
\\m{U}}_{s}}\n =\n\\underbrace{\\m{U}\\cdots \\m{U}}_{t}\n\
\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{k}}\\\n\
\\overline{\\underbrace{\\m{U}\\cdots \\m{U}}_{s}}\\qquad\\qquad& \
\\text{commutation}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d29c8ba3-37c4-41de-9ad0-d272697c8397"],
 "\[LineSeparator]\nThe last property demonstrates that multiple products of \
any number of given  MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["U", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "849dfa54-2c2f-40ff-a16a-d37972ae7845"],
 " and its conjugated copies can be reordered at the same level. The above \
given properties ensure that canonical order can be defined for an arbitrary \
combination of MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["U", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{U}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eab9e200-26e2-49ab-b180-8a1dd2e2181f"],
 " and its conjugate. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["U", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\overline{\\m{U}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "870c3edc-b43c-4e53-af8f-8edd9dbb7bc7"],
 " can be expressed in terms of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "1"], "\[Congruent]", "\[Cap]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\triangle_1\\equiv\\frown", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6376c3be-72ff-4301-943c-cec9a7006ac4"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "2"], "\[Congruent]", 
         "\[Tilde]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\triangle_2\\equiv\\sim", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "24b19cbe-c45f-4cd9-b8fd-ea0cb83e3996"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[EmptyUpTriangle]", "3"], ",", "\[Ellipsis]", ",", 
         SubscriptBox["\[EmptyUpTriangle]", 
          StyleBox["m", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\triangle_3, \\ldots, \\triangle_m", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4fff48bf-add8-4664-a182-b4aa8c2720ac"],
 " in the following form: [",
 StyleBox["konkrecios formules buvo  klaidingos, bendra irgi",
  FontColor->RGBColor[1, 0, 0]],
 "]\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["U", "TI"], "_"], "\[LongEqual]", "2", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], "-", 
         StyleBox["U", "TI"], "\[LongEqual]", 
         FractionBox["1", 
          SuperscriptBox["2", 
           RowBox[{"(", 
             RowBox[{
               StyleBox["m", "TI"], "-", "1"}], ")"}]]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["U", "TI"], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "1"]], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "2"]], "+", "\[Ellipsis]", 
             "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "12"]], "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", "13"]], "+", "\[Ellipsis]", 
             "+", 
             SuperscriptBox[
              StyleBox["U", "TI"], 
              SubscriptBox["\[EmptyUpTriangle]", 
               RowBox[{"123", "\[Ellipsis]", 
                 StyleBox["m", "TI"]}]]]}], ")"}], "-", 
         StyleBox["U", "TI"], ",    ", 
         StyleBox["m", "TI"], "\[LongEqual]", 
         RowBox[{"[", 
           RowBox[{
             SubscriptBox["log", "2"], 
             StyleBox["n", "TI"]}], "]"}], "+", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\overline{\\m{U}}=2\\grade{\\m{U}}{0}-\\m{U}=\\frac{1}{2^(m-1)}(\\m{U}+\
\\m{U}^{\\vartriangle_1}+\\m{U}^{\\vartriangle_2}+\\dots+\\m{U}^{\\\
vartriangle_{12}}+\n\
\\m{U}^{\\vartriangle_{13}}+\\dots+\\m{U}^{\\vartriangle_{123\\dots\nm}}) \
-\\m{U},\\qquad\nm=[\\log_2 n]+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4569923a-3220-40f5-b5d5-c2b868ba17a4"],
 ". \[LineSeparator]\[LineSeparator]In particular,  \[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["U", "TI"], "_"], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{"\[Null]", 
                 RowBox[{
                   OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], ",", " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "1", ","}], 
                 RowBox[{"  ", " complex and hyperbolic numbers"}]}, {
                "\[Null]", 
                 RowBox[{
                   FractionBox["1", "2"], 
                   RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], "+", 
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "+", 
                    OverscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "\[Cap]", LimitsPositioning -> 
                    False], "-", 
                    StyleBox["U", "TI"]}], ")"}], ",", " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "2", ",", "3", ","}], 
                 
                 RowBox[{"  ", "quaternions and 3D algebras"}]}, {"\[Null]", 
                 RowBox[{
                   FractionBox["1", "4"], 
                   RowBox[{"(", 
                    RowBox[{
                    OverscriptBox[
                    StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> 
                    False], "+", 
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "+", 
                    OverscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "\[Cap]", LimitsPositioning -> 
                    False], "+", 
                    SuperscriptBox[
                    StyleBox["U", "TI"], 
                    SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "^"], 
                    SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
                    SuperscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], 
                    SubscriptBox["\[EmptyUpTriangle]", "3"]], "+", 
                    SuperscriptBox[
                    OverscriptBox[
                    OverscriptBox[
                    StyleBox["U", "TI"], "~"], "\[Cap]", LimitsPositioning -> 
                    False], 
                    SubscriptBox["\[EmptyUpTriangle]", "3"]]}], ")"}], "-", 
                   StyleBox["U", "TI"], ","}], 
                 RowBox[{"  ", " if ", 
                   StyleBox["n", "TI"], "\[LongEqual]", "4", ",", "5", ",", 
                   "6", ",", "7"}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\overline{\\m{U}}=\\begin{cases}\n&\\gradeinverse{\\m{U}},\\text{\\ if\
\\ } n=1,&\\quad\\text{\\  complex and hyperbolic numbers}\\\\\n\
&\\frac12(\\gradeinverse{\\m{U}}+\\reverse{\\m{U}}+\\gradeinverse{\\reverse{\\\
m{U}}}-\\m{U}),\\text{\\ if\\ } n=2, 3,&\\quad\\text{quaternions and 3D \
algebras}\\\\\n\
&\\frac14(\\gradeinverse{\\m{U}}+\\reverse{\\m{U}}+\\gradeinverse{\\reverse{\\\
m{U}}}+\n\\m{U}^{\\triangle_3}+\\hat{\\m{U}}^{\\triangle_3}+\\reverse{\\m{U}}^\
{\\triangle_3}+\\gradeinverse{\\reverse{\\m{U}}}^{\\triangle_3})-\\m{U},&\n\
\\quad\\text{\\ if\\ } n=4, 5, 6, 7\n    \\end{cases}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "98f587b2-a9b2-4cea-b05a-29dc09e44007"],
 "\[LineSeparator]\[LineSeparator]In terms of main involutions, in 1D and 2D \
algebras the Clifford conjugation used in the Handbook  gives the same result \
as overbar, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         "\[LongEqual]", 
         OverscriptBox[
          StyleBox["U", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cliffordconjugate{\\m{U}}=\\bar{\\m{U}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43487817-fb4d-4f66-81d9-2db57e57681b"],
 ". However, in 3D algebras ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          OverscriptBox[
           StyleBox["U", "TI"], "\[Cap]", LimitsPositioning -> False], "~"], 
         "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "0"], "-", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "1"], "-", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "2"], "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["U", "TI"], "\[RightAngleBracket]"}], "3"], 
         "\[NotEqual]", 
         OverscriptBox[
          StyleBox["U", "TI"], "_"]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\cliffordconjugate{\\m{U}}=\\langle\\m{U}\\rangle_0-\\langle\\m{U}\\\
rangle_1-\\langle\\m{U}\\rangle_2+\\langle\\m{U}\\rangle_3 \\ne \
\\bar{\\m{U}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b8674e3-4ddf-4f27-b1d3-a672ad369ff7"],
 ". Therefore, in 3D and higher algebras one must make clear distinction what \
is meant by term the Clifford conjugation."
}], "Item",ExpressionUUID->"3f1d5334-e145-4cef-9562-5f042dc7816c"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
