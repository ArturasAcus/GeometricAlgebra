    0}},ExpressionUUID->"7debd0fe-8094-4c03-9b4f-671449f9885c"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Idempotent",
  FontSlant->"Italic"],
 ".  If the square of MV is equal to itself, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}^2=\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49eec2a1-ff5c-4072-95b7-da82ba25fc13"],
 ", the MV is said to be idempotent. Two idempotents ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "1"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cc26b737-2dc1-4df4-81d1-b26392f815ce"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["A", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c1c6b6ed-dbee-43a4-adfa-88aec0ebf0ae"],
 " are orthogonal if ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], "1"], 
         SubscriptBox[
          StyleBox["A", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["A", "TI"], "2"], 
         SubscriptBox[
          StyleBox["A", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{A}_1\\m{A}_2=\\m{A}_2\\m{A}_1=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd51b1f8-b3bc-4f5c-8ed1-dc39edfd671c"],
 ". An idempotent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c2b62a31-ea93-41ec-afe9-b70a960abd2b"],
 "  is primitive, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[Congruent]", 
         StyleBox["P", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}\\equiv\\m{P}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5953cd40-d642-40ad-ba0b-a147d16bcbc2"],
 ", if it cannot be expressed as a sum of two other idempotents ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["A", "TI"], "2"], "\[NotEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{A}_1+\\m{A}_2\\neq 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "95238298-0504-4f65-ab9e-c7a3ec8592f2"],
 "  whose GP is zero. In the following  only the primitive idempotents are \
pursued."
}], "Item",
 CellTags->
  "idempotents",ExpressionUUID->"3e7ca866-7a4a-447a-bc0b-ae36fd1d8d26"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Primitive idempotents of ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a6b5e24-cc75-452e-8e19-6d03f82fd455"],
 ". In this algebra the primitive idempotents are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "\[PlusMinus]"}]], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "\[PlusMinus]", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["k", "TI"]]}], ")"}], ",  ", 
         StyleBox["k", "TI"], "\[LongEqual]", "1", ",", "2", ",", "3"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{k\\pm}=\\frac{1}{2}\\big(1\\pm\\e{k}\\big), \\quad k=1,2,3", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "189d9348-ba03-414e-aa08-1ce2242a6422"],
 ". They satisfy",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "\[PlusMinus]"}], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "\[PlusMinus]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> " \\m{P}_{k\\pm}^2=\\m{P}_{k\\pm}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "016ace5e-5a7d-42b6-be50-908f37766546"],
 ". The sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "+"}]], "+", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "-"}]], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{k+}+\\m{P}_{k-}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ed55e96c-479a-4bf4-8e69-79fcd0af87e4"],
 " is the trivial idempotent. The idempotents  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["P", "TI"], 
        RowBox[{
          StyleBox["k", "TI"], "-"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{P}_{k-}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e46e9a81-2162-448b-84d5-8e08617d42f1"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["P", "TI"], "-", 
         RowBox[{
           StyleBox["k", "TI"], "+"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{P}-{k+}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fda32645-e770-42cc-bcba-a1d27dd5825e"],
 " are orthogonal ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "+"}]], 
         SubscriptBox[
          StyleBox["P", "TI"], 
          RowBox[{
            StyleBox["k", "TI"], "-"}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{k+}\\m{P}_{k-}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "87993e78-9cb6-4b8d-8474-10a803ea5dfa"],
 "."
}], "Subitem",
 CellTags->
  "PrimitiveIdempcl30",ExpressionUUID->"e02759e2-b74b-4faa-b380-5b0f0663e812"],

