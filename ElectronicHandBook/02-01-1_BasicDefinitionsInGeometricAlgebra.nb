   AspectRatio->Automatic,
   ImageSize->{122., 82.},
   PlotRange->{{0., 122.}, {0., 82.}}]], "Output",ExpressionUUID->
  "6c8f692a-d617-4f7f-9f70-abbd5b5ba905"],
 "\[LineSeparator]The area of parallelograms ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "94d02e7d-87b0-4302-9ffd-3d359ae62f37"],
 "and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b\\wedge a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0cf2bad-9076-4373-8bad-08d5073182bb"],
 " in (a) and (b), and volumes of parallelepipeds ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b\\wedge c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b14463af-101e-4f92-b394-c68c488dc1a9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[LongEqual]", "-", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b\\wedge a\\wedge c=-a\\wedge b\\wedge c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e30d91b3-f9e2-4d70-8416-10b25b9664e3"],
 " in (c) and (d) have the same magnitudes but the opposite orientations."
}], "Text",
 CellTags->
  "fig:bitrivec",ExpressionUUID->"e9bbecad-b6d8-41f9-b88d-bfb9e839d3fc"],

Cell[TextData[{
 " ",
 StyleBox["Oriented length or vector",
  FontSlant->"Italic"],
 ". This is the simplest oriented object that starts up all outer product \
procedures to work. Geometrically the vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "be98ee61-7f0b-48ed-a8ad-a0d0a8105a32"],
 " is characterized as a segment of line of length ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["abs", FontSlant -> "Plain"], 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{abs}{a}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8dfe267c-577c-459d-9b6d-bfcca2d35ddb"],
 " called the vector magnitude (aka vector length, vector norm) and direction \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[LongEqual]", 
         StyleBox["a", "TI"], "/", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat{a}=a/{|a|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1ac03f50-e261-46f1-982f-a2bd3093ed8b"],
 " called the unit vector, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["abs", FontSlant -> "Plain"], 
         OverscriptBox[
          StyleBox["a", "TI"], "^"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{abs}{\\hat{a}}=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2640920c-e9cc-4f8c-b6e2-c66879ab6908"],
 " ",
 "(for general definition, including mixed signature GAs, see ",
 Cell[BoxData[
  FormBox[
   ButtonBox["below",
    BaseStyle->"Hyperlink",
    ButtonData->"MagnitudeMain"], TraditionalForm]],ExpressionUUID->
  "cef624e2-8d53-49b7-ae06-dfacd7e6876c"],
 ")",
 ". The vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "819a7ca2-f0e9-462e-b7eb-6c257d852c1a"],
 " has two orientations, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"+", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "+a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "067c1db2-7cf7-44ab-b155-a0f66b88afdc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "-a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c757d33-27a2-494b-b9d0-f975a8323e7a"],
 ". In the following,  by term \[OpenCurlyDoubleQuote]orientation\
\[CloseCurlyDoubleQuote] we mean the internal orientation, whereas \
orientation in space (aka relative orientation) with respect to a given frame \
will be referred to as an attitude."
}], "Subitem",ExpressionUUID->"e5489bd2-d839-45db-b1f6-50eb89c762cf"],

Cell[TextData[{
 " ",
 StyleBox["Oriented area or bivector",
  FontSlant->"Italic"],
 ". The bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fbc2cb30-d6d3-46fe-a4eb-dfd1fd0f46c3"],
 " is an oriented segment of a plane that is usually drawn in a form of \
parallelogram from two nonparallel vectors and written as an outer product, \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}=a\\wedge b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "40cd99a1-25a7-4af9-a88f-a473c4db6999"],
 " (see Fig above). The parallelograms ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ea39c156-e934-4a7f-97f0-fd18b32801a4"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["a", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "b\\wedge a", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4e2bf2a2-b5a9-4c47-b3a0-75997786a961"],
 " have opposite orientations (axiom OP1). The oriented area inclosed by \
circle (or any closed and nonintersecting curve) represents the bivector too. \
The orientation can be designated by clockwise/anticlockwise arcs, or by \
painting the opposite surfaces in different colors. The enclosed area is \
characterized  by magnitude ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["abs", FontSlant -> "Plain"], 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{abs}{\\mathcal{B}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5ed414df-9d89-4a54-ad6b-e9b1280d66db"],
 " of the bivector while the internal orientation by a sign of  unit bivector \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["B", "TI"], "^"], "\[LongEqual]", "\[PlusMinus]", 
         StyleBox["B", "TI"], "/", 
         TemplateBox[{
           RowBox[{
             StyleBox["B", "TI"]}]}, "Abs"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\hat{\\mathcal{B}}=\\pm\\mathcal{B}/{|\\mathcal{B}|}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b13c0867-4835-439b-9f7c-837928c6448c"],
 ". The concrete expressions for magnitudes in different GAs are given  ",
 Cell[BoxData[
  FormBox[
   ButtonBox["below",
    BaseStyle->"Hyperlink",
    ButtonData->"MagnitudeMain"], TraditionalForm]],ExpressionUUID->
  "892641cf-ca25-4204-92ee-19fde955dc94"],
 ".\n\nThe area carries no information about its location in the bivector \
space ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"f5ad22c0-eab4-4af3-ba9b-c9656438d487"],
 ". Therefore, the exact shape is of no importance and is dictated by \
convenience arguments only. Two bivectors of the same magnitude and \
orientation (both inner and relative) are considered to be equal. In ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "2"], "n"], TraditionalForm]],
  ExpressionUUID->"aba0925e-8fbb-4304-a250-ec2119870a16"],
 " space the bivector can be decomposed into coordinates projected onto ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1e5203f7-4591-4924-b301-a75368369790"],
 " elementary planes) which are called Pl",
 StyleBox["\[UDoubleDot]",
  FontSlant->"Italic"],
 "cker (or Grassmann) coordinates. Area of zero size ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SubscriptBox[
          StyleBox["B", "TI"], "0"], "|", "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "|\\mathcal{B}_0|=0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e0382b92-97a9-49d1-90b8-6f9fd048b1ea"],
 " (axiom OP2) has no orientation. Multiplication by scalar (axiom OP3) \
changes the magnitude of the area, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3064b9bb-6483-4f76-9080-fee6091fd0be"],
 " which is parallel to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fb38899c-4109-4f33-a81a-26c893bac6b2"],
 " with the  magnitude being ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3fbe2f5e-fc72-4aa8-88b9-44cf501363fd"],
 " times larger ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         TemplateBox[{
           RowBox[{"\[Alpha]", 
             StyleBox["B", "TI"]}]}, "Abs"], "\[LongEqual]", "\[Alpha]", 
         TemplateBox[{
           RowBox[{
             StyleBox["B", "TI"]}]}, "Abs"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "{|\\alpha\\mathcal{B}|}=\\alpha{|\\mathcal{B}|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fdbf2062-0463-49fb-9321-e5e36b6370d5"],
 ". The new orientation depends on sign of the scalar. If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], "1"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}_1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3e330e5-6c54-482e-bbb4-77c769235476"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["B", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathcal{B}_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "acadd7e3-1d4e-4af1-bb46-06f556eaced5"],
 " are two planes then their sum gives a third plane ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["B", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["B", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathcal{B}=\\mathcal{B}_1+\\mathcal{B}_2", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63283941-69cc-4f47-943c-61ff2d3c8cdd"],
 " that belongs to the same space of oriented planes, (see above Figs). In \
dimension four or higher, two nonparallel planes may not intersect. In such a \
case simple graphical representation of sum of oriented planes is not \
possible."
}], "Subitem",ExpressionUUID->"3a687998-8de8-4b92-8e1b-2281130c2e7b"],

Cell[TextData[{
 StyleBox["Oriented volume or trivector",
  FontSlant->"Italic"],
 ".The oriented (aka directed) volume ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["T", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{T}=a\\wedge b\\wedge c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "171e241b-d937-4cc9-8a0b-ce2f06425bc0"],
 " is constructed by three linearly independent vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a, b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "26088ea1-91d9-4782-bd11-3beddce85ad1"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ef70b0ee-69a3-49e6-97c5-bfc6c43ad200"],
 " and may have two opposite orientations, (see Figs). A sphere with arrows \
pointing inside and outside also represents the oriented volume (see\nFigs), \
in this case in spherical coordinates. The volumes having different signs \
(orientations) may be added to give, for example, zero volume having zero \
size and no orientation. The trivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["T", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{T}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f3975915-aa77-4993-830f-15d5b49cf88f"],
 " can be multiplied by scalar that will change the volume or the \
orientation, or both. According\nto axiom OP1 the swapping of two adjacent \
vectors changes the orientation: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[LongEqual]", "-", 
         StyleBox["b", "TI"], "\[Wedge]", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[LongEqual]", "-", 
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["c", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b\\wedge c=-b\\wedge a\\wedge c=-a\\wedge c\\wedge b", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4dd5cd3-154b-426a-9546-2ae3867addfb"],
 ". The magnitude ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["T", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "{|\\m{T}|}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b8108aa-285a-4589-8259-231361810a16"],
 " may be interpreted as a volume of the cube, sphere or parallelepiped (see \
Figs)."
}], "Subitem",
 CellChangeTimes->{
  3.9102349636172113`*^9, {3.910240358984709*^9, 3.910240450698489*^9}, {
   3.910240487461269*^9, 3.910240519226472*^9}, 3.910240553246453*^9, {
   3.910241994198477*^9, 
   3.910242185626867*^9}},ExpressionUUID->"37750dcd-7ae0-4534-8f2a-\
e39234d73581"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"0dd6f364-56a9-4456-9e5c-cf53a50171e3"],

Cell[CellGroupData[{

Cell["Unit vector is a vector divided by its length", "Text",ExpressionUUID->"c60c5ac1-f1c6-4b20-ba4c-d8405896719e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"4", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefineOrthonormalBasis", "[", "testAlgebra", "]"}]}], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"a63a1805-729d-4934-8384-2e87028fb40c"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Running algebra is: gaRunningAlgebra=\"\>",
   "EchoLabel"], "  ", 
  TemplateBox[{"4", "0", "0"},
   "Cl",
   DisplayFunction->(SubscriptBox[
     StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
     RowBox[{#, ",", #2}]]& ),
   Tooltip->None]}]], "Echo",
 CellChangeTimes->{
  3.949644058417356*^9},ExpressionUUID->"33df8666-1ce8-4a25-a1aa-\
19ee1ca84497"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   TemplateBox[{
     TemplateBox[{"1"}, "mvDownUp", DisplayFunction :> (StyleBox[
        RowBox[{
          AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
        FontTracking -> "Condensed", AutoSpacing -> False]& ), 
      InterpretationFunction :> (ReleaseHold[
        RowBox[{"mvDownUp", "@@", 
          MakeExpression[{
            Take[{
              SlotSequence[1]}, 
             Length[{1}]], 
            Take[{
              SlotSequence[1]}, {Length[{1}] + 1, 
              Length[{1}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
      Tooltip -> "mvDownUp[{1}, {}]"], 
     TemplateBox[{"4", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
        RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
    "\[DoubleStruckE]",
    DisplayFunction:>(StyleBox[
      RowBox[{
        StyleBox["\[DoubleStruckE]", FontColor -> RGBColor[0., 1., 0.]], #}], 
      AutoSpacing -> False, FontTracking -> "Condensed"]& ),
    InterpretationFunction:>(
     RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
    SyntaxForm->"fish",
    Tooltip->"Cl[4, 0, 0]"], ",", 
   TemplateBox[{
     TemplateBox[{"2"}, "mvDownUp", DisplayFunction :> (StyleBox[
        RowBox[{
          AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
        FontTracking -> "Condensed", AutoSpacing -> False]& ), 
      InterpretationFunction :> (ReleaseHold[
        RowBox[{"mvDownUp", "@@", 
          MakeExpression[{
            Take[{
              SlotSequence[1]}, 
             Length[{2}]], 
            Take[{
              SlotSequence[1]}, {Length[{2}] + 1, 
              Length[{2}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
      Tooltip -> "mvDownUp[{2}, {}]"], 
     TemplateBox[{"4", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
        RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
    "\[DoubleStruckE]",
    DisplayFunction:>(StyleBox[
      RowBox[{
        StyleBox["\[DoubleStruckE]", FontColor -> RGBColor[0., 1., 0.]], #}], 
      AutoSpacing -> False, FontTracking -> "Condensed"]& ),
    InterpretationFunction:>(
     RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
    SyntaxForm->"fish",
    Tooltip->"Cl[4, 0, 0]"], ",", 
   TemplateBox[{
     TemplateBox[{"3"}, "mvDownUp", DisplayFunction :> (StyleBox[
        RowBox[{
          AdjustmentBox[#, BoxBaselineShift -> 1]}], FontSize -> Small, 
        FontTracking -> "Condensed", AutoSpacing -> False]& ), 
      InterpretationFunction :> (ReleaseHold[
        RowBox[{"mvDownUp", "@@", 
          MakeExpression[{
            Take[{
              SlotSequence[1]}, 
             Length[{3}]], 
            Take[{
              SlotSequence[1]}, {Length[{3}] + 1, 
              Length[{3}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish", 
      Tooltip -> "mvDownUp[{3}, {}]"], 
     TemplateBox[{"4", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
        RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
    "\[DoubleStruckE]",
    DisplayFunction:>(StyleBox[
      RowBox[{
        StyleBox["\[DoubleStruckE]", FontColor -> RGBColor[0., 1., 0.]], #}], 
      AutoSpacing -> False, FontTracking -> "Condensed"]& ),
    InterpretationFunction:>(
     RowBox[{"\[DoubleStruckE]", "[", #, ",", #2, "]"}]& ),
    SyntaxForm->"fish",
