Cell[TextData[{
 "The idempotent ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          SubscriptBox["Cl", 
           RowBox[{"8", ",", "0"}]]], "\[LongEqual]", 
         FractionBox["1", "16"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2345"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "4567"]}], ")"}], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2468"]}], ")"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{P}_{\\cl{8}{0}}=\\frac{1}{16}(1+\\e{1})(1+\\e{2345})(1+\\e{4567})(1+\
\\e{2468})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4406ba37-7f7a-4218-bfc5-2cba0f0d0a1b"],
 " can be constructed by adjusting ",
 StyleBox["StartElement",
  FontWeight->"Bold"],
 " option step by step once basis elements that we want appear in the \
idempotent:"
}], "Text",ExpressionUUID->"69a4f8bc-3d88-4464-b870-bad4a0a0df5a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"idempotent80", "=", 
  RowBox[{"gaPrimitiveIdempotent", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"\"\<StartingElement\>\"", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "16", ",", "2"}], "}"}]}], ",", 
    RowBox[{
    "\"\<gaNonCommutativeMonomialOrder\>\"", "\[Rule]", 
     "\"\<InvDeg[Lex]\>\""}], ",", 
    RowBox[{"\"\<OutputForm\>\"", "\[Rule]", "\"\<IdempotentFactors\>\""}], 
    ",", 
    RowBox[{"Quiet", "\[Rule]", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.950159528315974*^9, 3.9501595374285088`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"4f5693e9-6e4f-44e7-8703-d1b18124afdb"],

