Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Decomposition of MV in grades",
  FontSlant->"Italic"],
 ".  Multivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{M}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b2dce765-0e85-47c1-a988-59066c177f34"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalG]", "n"], TraditionalForm]],ExpressionUUID->
  "e6d429f4-02f5-44fe-93e6-23e6786034d4"],
 " can be decomposed uniquely into a sum of different grades,   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "0"], "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "1"], "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "2"], "+", 
         "\[CenterEllipsis]", "+", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}= \\grade{\\m{M}}{0}+\\grade{\\m{M}}{1}+\\grade{\\m{M}}{2}+\\\
cdots +\\grade{\\m{M}}{n}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "092df4f1-37d1-4afc-a868-5cf3cbd362ca"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["k", "TI"]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\grade{\\m{M}}{k}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d2da21bd-fd89-4841-95a0-6dba74ece72d"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "k"], "n"], TraditionalForm]],
  ExpressionUUID->"6227afd2-1c57-431b-b7f0-8fedde469ca9"],
 " is a grade-k multivector. The bracket ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftAngleBracket]", "..", "\[RightAngleBracket]"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\langle..\\rangle", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "329e549b-5a94-4741-b5f1-569d3521695a"],
 " is called grade selector (aka grade filter, grade projector). ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["M", "TI"], "\[RightAngleBracket]"}], "0"], 
       TraditionalForm], "errors" -> {}, "input" -> "\\grade{\\m{M}}{0}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "918b4fda-b980-4dfa-99d4-d4e9533a4e39"],
 " is the scalar. The zero subscript frequently is omitted, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "\[Null]"], 
         "\[Congruent]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\grade{\\m{M}}{{}}\\equiv\\grade{\\m{M}}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4ce5256c-cd49-407b-9456-c8885659063f"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["M", "TI"], "\[RightAngleBracket]"}], "1"], 
       TraditionalForm], "errors" -> {}, "input" -> "\\grade{\\m{M}}{1}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f12d4d7-d24d-4636-8968-325d14ef80f4"],
 " is grade-1 MV (vector). ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["M", "TI"], "\[RightAngleBracket]"}], "2"], 
       TraditionalForm], "errors" -> {}, "input" -> "\\grade{\\m{M}}{2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c22d8784-ed49-4674-9cbb-dd6761e8f1a8"],
 " is grade-2 MV (bivector).  Then,  trivector, quadvector, pentavector, \
hexavector, septavector, octavector, etc follow. The largest grade element ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["M", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["n", "TI"]], "\[Congruent]", "\[Alpha]", 
         StyleBox["I", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\grade{\\m{M}}{n}\\equiv \\alpha I", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1941394b-91f8-4cce-b8e3-9393f46524a8"],
 " is called a pseudoscalar, where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["I", "TI"], TraditionalForm], "errors" -> {}, "input" -> "I", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9b31948-b500-48a3-a6a9-31b155cfea37"],
 " denotes the basis pseudoscalar and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Alpha]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2ef9b726-fc19-47ca-9e1d-5f634686f35a"],
 " is the scalar coefficient.\[LineSeparator]\nA grade-k element in MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["M", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{M}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c8ab16ab-d218-4664-b865-e2a188c4dd70"],
 " can be selected if the following property ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], "\[Ellipsis]", 
            StyleBox["k", "TI"]}]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["k", "TI"], "\[Ellipsis]", 
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{ij\\dots k}\\e{}^{k\\dots ji}=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f7a18a47-e8a7-4ef1-a9ef-08afdf84bfa1"],
 "  is used. Then, the scalar coefficient  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"], "\[Ellipsis]", 
          StyleBox["k", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "a^{ij\\dots k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "074d67b1-2f45-4a1e-bad0-bb43f752a301"],
 " at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"], "\[Ellipsis]", 
          StyleBox["k", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{ij\\dots k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b40d9f2f-ffda-470c-9c95-e477fe580c49"],
 " can be extracted from a resulting  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["M", "TI"], 
         StyleBox["V", "TI"], 
         SuperscriptBox[
          StyleBox["M", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "MV \\m{M}^\\prime", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1574078f-e8bd-4f71-bd3e-ff302b81e6cc"],
 " by multiplying it by\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["k", "TI"], "\[Ellipsis]", 
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{
            StyleBox["i", "TI"], " ", 
            StyleBox["j", "TI"], "\[Ellipsis]", 
            StyleBox["k", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\e{}^{k\\dots ji}=\\reverse{\\e{}}^{i\\,j\\dots k}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dfa8eaf7-dffc-4e32-af7f-421f94335456"],
 ", i.e. the coefficient ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["a", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"], "\[Ellipsis]", 
          StyleBox["k", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "a^{ij\\dots k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e11ead9-6350-4494-a563-8ecc19da477a"],
 " is selected by scalar filter, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"], "\[Ellipsis]", 
            StyleBox["k", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            SuperscriptBox[
             StyleBox["M", "TI"], "\[Prime]"], "\[RightAngleBracket]"}], "0"],
          "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            RowBox[{
              StyleBox["M", "TI"], 
              SuperscriptBox[
               StyleBox["e", FontSlant -> "Plain"], 
               RowBox[{
                 StyleBox["k", "TI"], "\[Ellipsis]", 
                 StyleBox["j", "TI"], 
                 StyleBox["i", "TI"]}]]}], "\[RightAngleBracket]"}], "0"]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a^{ij\\dots\n\
k}=\\langle\\m{M^\\prime}\\rangle_0=\\langle\\m{M}\\reverse{\\e{}}^{k\\dots\n \
 ji}\\rangle_0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a86658ff-a5d3-423f-a5dc-cbc44a969d4f"],
 "."
