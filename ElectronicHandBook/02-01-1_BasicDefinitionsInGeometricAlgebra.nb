}, Closed]],

Cell["Transformation which diagonalize a metric can be computed ", "Text",ExpressionUUID->"90fd3aa8-7ec0-4464-948a-7b2fa9b461a3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"metricPrimaryTrasf", ",", "metricJF"}], "}"}], "=", 
  RowBox[{"JordanDecomposition", "[", "metricPrimary", "]"}]}]], "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"d25b738e-8b2f-4ee4-a072-b933d6643385"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SqrtBox["3"]}]]}], ",", 
       FractionBox["1", 
        RowBox[{"1", "+", 
         SqrtBox["3"]}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       FractionBox[
        RowBox[{
         RowBox[{"-", "2"}], "+", 
         SqrtBox["3"]}], 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SqrtBox["3"]}]], ",", 
       FractionBox[
        RowBox[{"2", "+", 
         SqrtBox["3"]}], 
        RowBox[{"1", "+", 
         SqrtBox["3"]}]]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"4", "-", 
        RowBox[{"2", " ", 
         SqrtBox["3"]}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"2", "+", 
          SqrtBox["3"]}], ")"}]}]}], "}"}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9496442668989277`*^9, 3.94974084262486*^9},
 CellLabel->
  "Out[208]=",ExpressionUUID->"86df0c84-55a3-47a5-9a8e-ca3350134559"]
}, Closed]],

