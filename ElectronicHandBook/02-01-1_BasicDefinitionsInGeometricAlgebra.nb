Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Inner and outer products with scalar",
  FontSlant->"Italic"],
 ". For multiplication of vector and bivector by scalar ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Lambda]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "dd6cdaba-3355-4934-88ff-2f3c37e4fd8f"],
 " the following rules hold:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Lambda]", "\[CenterDot]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", "\[Lambda]", "\[LongEqual]", 
         "0", ","}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda\\cdot a=a\\cdot\\lambda =0,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "93804c1d-e3ac-4dcd-afa7-48fc671a84ed"],
 "\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Lambda]", "\[Wedge]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[Wedge]", "\[Lambda]", "\[LongEqual]", 
         "\[Lambda]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[Lambda]", ","}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\lambda\\wedge a=a\\wedge\\lambda =\\lambda a=a\\lambda,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66458be9-9bdb-4742-8024-af0628c5bdb2"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Lambda]", "\[CenterDot]", 
         StyleBox["B", "TI"], "\[LongEqual]", 
         StyleBox["B", "TI"], "\[CenterDot]", "\[Lambda]", "\[LongEqual]", 
         "0", ","}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\lambda\\cdot \\mathcal{B}=\\mathcal{B}\\cdot\\lambda =0,", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36f3847e-d511-45e4-ac34-13672fc1e3c8"],
 "\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Lambda]", "\[Wedge]", 
         StyleBox["B", "TI"], "\[LongEqual]", 
         StyleBox["B", "TI"], "\[Wedge]", "\[Lambda]", "\[LongEqual]", 
         "\[Lambda]", 
         StyleBox["B", "TI"], "\[LongEqual]", 
         StyleBox["B", "TI"], "\[Lambda]"}], TraditionalForm], "errors" -> {},
      "input" -> 
     "\\lambda\\wedge\\mathcal{B}=\\mathcal{B}\\wedge\\lambda \
=\\lambda\\mathcal{B}=\\mathcal{B}\\lambda", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7a05efc-4805-4656-baba-404c46e18566"],
 ".\[LineSeparator]\[LineSeparator]These formulas are generalized to any ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[GreaterEqual]", "0"}], TraditionalForm], 
