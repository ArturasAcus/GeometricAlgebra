    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f4572d55-bae1-48cd-a142-77d0c105fba6"],
 " where the sign depends on GA signature. In the following we shall take the \
 ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
