             Length[{2, 3, 4}]], 
            Take[{
              SlotSequence[1]}, {Length[{2, 3, 4}] + 1, 
              Length[{2, 3, 4}]}]}, StandardForm]}]]& ), SyntaxForm -> "fish",
       Tooltip -> "mvDownUp[{2, 3, 4}, {}]"], 
     TemplateBox[{"4", "0", "0"}, "Cl", DisplayFunction -> (SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
        RowBox[{#, ",", #2}]]& ), Tooltip -> None]},
    "\[DoubleStruckE]",
