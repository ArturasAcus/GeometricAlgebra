Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Properties of expansion in reciprocal frame",
  FontSlant->"Italic"],
 ".  In the space spanned by frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "34ca2db1-e9f2-4b26-b35c-bf001fc19a49"],
 "  one has the following expansions of  a general vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e602e526-37d5-43cd-94c6-ac630fe8283f"],
 " and bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[Wedge]", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\wedge b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1581aa76-1531-42cc-b691-dee3288c44d7"],
 ",\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             StyleBox["a", "TI"]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             RowBox[{"(", 
               RowBox[{
                 SuperscriptBox[
                  StyleBox["a", "TI"], 
                  StyleBox["j", "TI"]], 
                 SubscriptBox[
                  StyleBox["e", FontSlant -> "Plain"], 
                  StyleBox["j", "TI"]]}], ")"}]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], 
             SubsuperscriptBox["\[Delta]", 
              StyleBox["j", "TI"], 
              StyleBox["i", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["a", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], ","}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{e}_{i}(\\mathrm{e}_{}^i\\cdot \
a)=\\mathrm{e}_{i}(\\mathrm{e}_{}^i\\cdot\n\
