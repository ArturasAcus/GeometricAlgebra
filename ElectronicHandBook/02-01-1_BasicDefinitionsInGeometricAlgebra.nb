     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0119412e-7865-4a07-8671-b9b41b370ba3"],
 ".\n\nThe equations on the right-hand side can be obtained by solving the \
left-hand side equations with respect to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "02fc8268-3116-4e2c-88ee-d46e682f3bc8"],
 ". One can check that in the primed frame ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], 
         SuperscriptBox["\[Null]", 
          RowBox[{"\[Prime]", "1"}]], "\[CenterDot]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "e{}^{\\prime 1} \\d \
e_{1}^{\\prime}=(\\mathrm{e}_{}^{1}-\\mathrm{e}_{}^{2}+\\mathrm{e}_{}^{3})\\d \
(-\\mathrm{e}_{1}-\\mathrm{e}_{2}+\\mathrm{e}_{3})=-\\mathrm{e}_{}^1\\d\\\
mathrm{e}_{1}+\\mathrm{e}_{}^2\\d\\mathrm{e}_{2}+\\mathrm{e}_{}^3\\d\\mathrm{\
e}_{3}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8af6ddfe-0e69-46e8-b290-d14b024af286"],
 ". \nSimilarly, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], 
         SuperscriptBox["\[Null]", 
          RowBox[{"\[Prime]", "2"}]], "\[CenterDot]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "e{}^{\\prime\n2} \\d \
e_{2}^{\\prime}=(\\mathrm{e}_{}^{2}+\\mathrm{e}_{}^{3})\\d (-\\mathrm{e}_{1}+\
\\mathrm{e}_{3})=\\mathrm{e}_{}^3\\d\\mathrm{e}_{3}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c2f6401-164d-43e9-a01d-2be44e913a64"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], 
         SuperscriptBox["\[Null]", 
          RowBox[{"\[Prime]", "3"}]], "\[CenterDot]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "3", "\[Prime]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"2", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", "2", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "e{}^{\\prime 3}\\d \n\
e_{3}^{\\prime}=(\\mathrm{e}_{}^{1}+\\mathrm{e}_{}^{3})\\d(2\\mathrm{e}_{1}+\\\
mathrm{e}_{2}-\\mathrm{e}_{3})=\n2\\mathrm{e}_{}^1\\d \
\\mathrm{e}_{1}-\\mathrm{e}_{}^3\\d \\mathrm{e}_{3}=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c10a860-1ba1-4a88-a547-dc21f9f43d62"],
 ". If indices are different the products are equal zero, for example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], 
         SuperscriptBox["\[Null]", 
          RowBox[{"\[Prime]", "1"}]], "\[CenterDot]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "e{}^{\\prime 1}\\d \n\
e_{2}^{\\prime}=(\\mathrm{e}_{}^{1}-\\mathrm{e}_{}^{2}+\\mathrm{e}_{}^{3})\\d \
(-\\mathrm{e}_{1}+\\mathrm{e}_{3})=\n-\\mathrm{e}_{}^1\\d \
\\mathrm{e}_{1}+\\mathrm{e}_{}^3\\d\\mathrm{e}_{3}=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "918ccc55-97f6-4511-b19b-0a48c0fa51c8"],
 ", etc. In a similar way one can check that,  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["e", "TI"], 
         SuperscriptBox["\[Null]", 
          RowBox[{"\[Prime]", "1"}]], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"\[Prime]", "1"}]], "\[NotEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "e{}^{\\prime  1} \\d e^{\\prime 1}\\neq 1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e30297f4-f2c8-4134-bc36-4e70e09d5996"],
 ", etc. Thus, we have constructed the primary and reciprocal (dashed) basis \
in terms of orthonormal basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "2"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "3"]}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{\\mathrm{e}_{1},\\mathrm{e}_{2},\\mathrm{e}_{3}\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "456eb6d4-4183-4e68-96ba-38ff1757246d"],
 ". Note that the dashed basis is neither normalized nor orthogonal."
}], "Subitem",ExpressionUUID->"9a3c2b0d-9cea-4c2f-aea5-f12553126060"],

