   RowBox[{"Cl", "[", 
    RowBox[{"9", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
