                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["j", "TI"]]}], ")"}], 
               FractionBox[
                RowBox[{"\[PartialD]", 
                  SuperscriptBox[
                   StyleBox["f", "TI"], 
                   StyleBox["j", "TI"]]}], 
                RowBox[{"\[PartialD]", 
                  SuperscriptBox[
                   StyleBox["x", "TI"], 
                   StyleBox["i", "TI"]]}]]}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
