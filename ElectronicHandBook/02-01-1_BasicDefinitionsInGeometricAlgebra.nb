Cell[TextData[{
 "Definition of inner product for vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], 
             StyleBox["b", "TI"], "+", 
             StyleBox["b", "TI"], 
             StyleBox["a", "TI"]}], ")"}], ","}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot b=\\frac{1}{2}\\big(ab+ba\\big),", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "03fe731e-f8fe-4734-bb08-c550047b86c3"]
}], "Text",
 CellChangeTimes->{{3.911962330263737*^9, 
  3.911962357165742*^9}},ExpressionUUID->"3c97c715-ca1d-497b-aff0-\
04966e0bdeef"],

