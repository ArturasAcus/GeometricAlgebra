Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Pl\[UDoubleDot]cker relation.",
  FontSlant->"Italic"],
 "  The given homogeneous r-grade MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
        StyleBox["r", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle\\m{B}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5271bf73-8a07-4c55-8f1f-289b3b9c6bd0"],
 " is a blade if and only if it satisfies the  Pl",
 "\[UDoubleDot]",
 "cker relation, which in GA has the form:\n\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["A", "TI"], "\[CenterDot]", 
             SubscriptBox[
              RowBox[{"\[LeftAngleBracket]", 
                StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
              StyleBox["r", "TI"]]}], ")"}], "\[Wedge]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]], "\[LongEqual]", "0", ",  ", 
         "for all (r\[Hyphen]1)\[Hyphen]grade MVs ", 
         StyleBox["A", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\m{A}\\d\\langle\\m{B}\\rangle_r)\\w\\langle\\m{B}\\rangle_r =0,\n \
\\quad \\text{for all  (r-1)-grade MVs }\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6d73268-5eec-41e2-9644-622f664666af"],
 ".\n \nThe conditions for a grade-r MV ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         SubscriptBox[
          RowBox[{"\[LeftAngleBracket]", 
            StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}=\\langle\\m{B}\\rangle_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cf549d69-ef70-4b5e-8f5a-1cdf185552ce"],
 " to be factorizable, i.e. expressed in a form of outer products, also can \
be written in a different way: \n\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "2"], "\[LongEqual]", 
         StyleBox["B", "TI"], "\[CenterDot]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}^2=\\m{B}\\d\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ab7485e-7863-40d2-b813-92dc1ec067fb"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         StyleBox["B", "TI"], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\m{B}\\e{i}\\m{B}\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "82eafbfb-7d0d-4bc0-bbec-ce53ba86b64e"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    SubscriptBox["\[ScriptCapitalG]", "1"], "n"], TraditionalForm]],
  ExpressionUUID->"ec7a1fd9-5848-4eed-ad05-c8076be0d48a"],
 "  is a vector for all   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "67ff49a4-2694-498a-8808-f6f5a82b8b9d"],
 ".\n\nwhere the both conditions must be satisfied simultaneously. The \
algorithm for factorization of a blade in a form of outer product is \
presented later in the textbook."
}], "Item",ExpressionUUID->"b972492a-631a-4b57-87ea-d662c9e5e174"],

