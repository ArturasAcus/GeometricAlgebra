Cell[TextData[{
 "You can collect coefficients at the same basis vector with ",
 StyleBox["Collect[ ..., _\[DoubleStruckE]]",
  FontWeight->"Bold"],
 ". Note double struck e. In typical input you just type the letter \
\[OpenCurlyDoubleQuote]e\[CloseCurlyDoubleQuote] and it will be automatically \
converted into double struck letter. This however does not happen in patterns \
and in order to match more complicated patterns we will have to use FullForm \
of basis object representation"
}], "Text",ExpressionUUID->"72f7cfd0-cea2-412b-af12-7f435040518a"],

