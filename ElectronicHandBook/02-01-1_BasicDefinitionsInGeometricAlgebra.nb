Cell["\<\
So, we need triangle involutions with index 4 at most, Indeed\
\>", "Text",ExpressionUUID->"f497f623-8d7b-4e81-a414-da1efe0b7ca8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"lhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{"gaGetMV", "[", 
   RowBox[{"generalMV", ",", 
    RowBox[{"{", "0", "}"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"85e8e403-6d11-4a2d-b530-5f8bc1e3f463"],

Cell[BoxData[
 RowBox[{"a", "[", "0", "]"}]], "Output",
 CellChangeTimes->{3.949910246608561*^9, 3.950157404171052*^9, 
  3.950158381316018*^9},
 CellLabel->
  "Out[153]=",ExpressionUUID->"d28d0fa1-8613-4b7f-b835-0ccae90eccaf"]
}, Closed]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rhs", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"2", "^", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"IntegerPart", "[", 
         RowBox[{"Log", "[", 
          RowBox[{"2", ",", 
