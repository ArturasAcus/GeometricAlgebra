Cell[TextData[{
 StyleBox["Relations between standard ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{i}\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "f6b79b7a-8e8a-4f4e-a9bb-0ae57a2af9ce"],
 StyleBox[" and reciprocal  ",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "}"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\{\\mathrm{e}_{}^i\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->
  "9625bbd5-c40f-410b-9d21-d59d83609860"],
 StyleBox[" frames in nD orthonormal vector space",
  FontSlant->"Italic"],
 ". Summation over identical upper-lower indices is meant.\n ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], "\[LongEqual]", 
               "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["n", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["n", "TI"]], "\[LongEqual]", "1"}], 
             
             RowBox[{"        ", 
               "initial\[Hyphen]reciprocal basis vector relations"}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               StyleBox["n", "TI"]}], 
             RowBox[{"        ", 
               StyleBox["n", "TI"], " is the dimension of vector space"}]}, {
            "\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["j", "TI"], 
                StyleBox["i", "TI"]]}], 
             RowBox[{"        ", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", "1", " if ", 
               StyleBox["i", "TI"], "\[LongEqual]", 
               StyleBox["j", "TI"], ",  ", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", "0", " if ", 
               StyleBox["i", "TI"], "\[NotEqual]", 
               StyleBox["j", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[CenterDot]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[CenterDot]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["j", "TI"], 
                StyleBox["i", "TI"]]}], 
             RowBox[{"        ", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["j", "TI"], 
                StyleBox["i", "TI"]], " ", "is the Kronecker delta"}]}, {
            "\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[CenterDot]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SubscriptBox["\[PlusMinus]\[Delta]", 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["j", "TI"]}]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["j", "TI"]}]]}], 
             RowBox[{"        ", "metric tensor", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "\[Cross]", 
                   StyleBox["n", "TI"]}], ")"}], "matrix"}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[CenterDot]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["j", "TI"]}]]}], 
             RowBox[{"        ", "inverse metric tensor", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["n", "TI"], "\[Cross]", 
                   StyleBox["n", "TI"]}], ")"}], "matrix"}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[Wedge]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[Wedge]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]]}], 
             RowBox[{"        ", 
               StyleBox["i", "TI"], "\[NotEqual]", 
               StyleBox["j", "TI"]}]}, {"\[Null]", 
             RowBox[{
               SuperscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["k", "TI"]}]], 
               SubscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["k", "TI"], 
                  StyleBox["j", "TI"]}]], "\[LongEqual]", 
               SubsuperscriptBox["\[Delta]", 
                StyleBox["j", "TI"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               OverscriptBox["1", "^"]}], 
             RowBox[{"        ", "unit matrix"}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]]}], 
             RowBox[{"        ", "vector expansion in coordinates"}]}, {
            "\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]], ",  ", 
               SuperscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["j", "TI"]], "\[LongEqual]", 
               StyleBox["a", "TI"], "\[CenterDot]", 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]]}], 
             
             RowBox[{"        ", 
               "vector coordinates, Einstein convention interpretation \
ready"}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TB"], "\[Cross]", 
               StyleBox["b", "TB"], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   SubscriptBox["\[Epsilon]", 
                    RowBox[{
                    StyleBox["i", "TI"], 
                    StyleBox["j", "TI"], 
                    StyleBox["k", "TI"]}]], 
                   SubscriptBox[
                    StyleBox["a", "TI"], 
                    StyleBox["i", "TI"]], 
                   SubscriptBox[
                    StyleBox["b", "TI"], 
                    StyleBox["l", "TI"]]}], ")"}], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["k", "TI"]]}], 
             RowBox[{"        ", "cross product, 3D Euclidean only"}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{aligned}\n\
&\\eup{1}\\mathrm{e}_{1}=\\eup{2}\\mathrm{e}_{2}=\\dotsm=\\eup{n}\\mathrm{e}_{\
n}=1&\\qquad\\qquad \\text{initial-reciprocal basis vector relations} \\\\\n \
&\\eup{i}\\mathrm{e}_{i}=\\mathrm{e}_{i}\\eup{i}=n &\\qquad \\qquad  n\\text{ \
is the dimension of vector space}\\\\&\\eup{i}\\mathrm{e}_{j}=\\delta_j^i \
&\\qquad\\qquad \\eup{i}\\mathrm{e}_{j}=1 \\text{\\ if\\ } i=j,\\quad\\eup{i}\
\\mathrm{e}_{j}=0 \\text{\\ if\\ } i\\ne \
j\\\\&\\mathrm{e}_{}^i\\d\\mathrm{e}_{j}=\\mathrm{e}_{i}\\d\\eup{j}=\\delta_{\
j}^i &\\qquad\\qquad\\delta_j^i\\ \\text{is the Kronecker delta} \\\\& \
\\mathrm{e}_{i}\\d\\mathrm{e}_{j}=\\pm\\delta_{ij}=g_{ij}&\\qquad\\qquad \
\\text{metric tensor} (n\\times \
n)\\text{matrix}\\\\&\\mathrm{e}_{}^i\\d\\mathrm{e}_{}^j=g^{ij}& \
\\qquad\\qquad \\text{inverse metric tensor} (n\\times \
n)\\text{matrix}\\\\&\\mathrm{e}_{i}\\w\\mathrm{e}_{j}=\\mathrm{e}_{}^i\\w\\\
mathrm{e}_{}^j &\\qquad \\qquad  i\\ne j\\\\&\n\
g^{ik}g_{kj}=\\delta_j^i=\\hat{1} &\\qquad \\qquad \\text{unit \
matrix}\\\\&a=a^i\\mathrm{e}_{i}=a_i\\eup{i}&\\qquad\\qquad\\text{vector \
expansion in coordinates}\\\\&\na_j=a\\d\\mathrm{e}_{j},\\quad \
a^j=a\\d\\eup{j} & \\qquad\\qquad\\text{vector coordinates, Einstein \
convention interpretation ready} \\\\&\n{\\bf a}\\times{\\bf \
b}=(\\varepsilon_{ijk}a_ib_l)\\mathrm{e}_{k}&\\qquad \\qquad \\text{cross \
product, 3D Euclidean only}\n\\end{aligned}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f02f4b13-deb9-4b0f-bc26-48c96fc33872"]
}], "Subitem",ExpressionUUID->"7b580d94-c5fc-4ca3-8605-f0461a5684d8"],

Cell[TextData[{
 StyleBox["Useful tensor-like formulas expressed in initial and reciprocal \
frames",
  FontSlant->"Italic"],
 ". ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], ",", 
         StyleBox["b", "TI"], ",", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a,b,c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83c7950c-2ebd-4bcc-87ce-2bb3e65a1a34"],
 " are the vectors. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           StyleBox["a", "TI"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         StyleBox["f", "TI"], 
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            StyleBox["i", "TI"]], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\m{f}(a)=a^i\\m{f}(\\mathrm{e}_{i})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c6444cff-975b-4b1c-871a-03e97a17ef5a"],
 " is a linear vector-valued function of vector argument, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a=a^i\\mathrm{e}_{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a3e7b3be-d8f3-4c32-b9cb-aa42f9bd2a2e"],
 ".\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[CenterDot]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["b", "TI"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["a", "TI"], "1"], 
               SubscriptBox[
                StyleBox["b", "TI"], 
                StyleBox["i", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SubscriptBox[
                StyleBox["b", "TI"], 
                StyleBox["j", "TI"]], 
               SuperscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["j", "TI"]}]], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["b", "TI"], 
                StyleBox["j", "TI"]], 
               SubscriptBox[
                StyleBox["g", "TI"], 
                RowBox[{
                  StyleBox["i", "TI"], 
                  StyleBox["j", "TI"]}]]}], 
             RowBox[{"        ", 
               RowBox[{"inner product of vectors ", 
                 Cell[
                  StyleBox["a", "TI"], "InlineFormula"], " and ", 
                 Cell[
                  StyleBox["b", "TI"], "InlineFormula"]}]}]}, {"\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               SuperscriptBox[
                StyleBox["a", "TI"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["b", "TI"], 
                StyleBox["j", "TI"]], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], "\[Wedge]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["j", "TI"]]}], 
             RowBox[{"        ", "outer product"}]}, {"\[Null]", 
             RowBox[{
               StyleBox["B", "TI"], "\[LongEqual]", 
               StyleBox["a", "TI"], "\[Wedge]", 
               StyleBox["b", "TI"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["i", "TI"]], "\[CenterDot]", 
                   StyleBox["B", "TI"]}], ")"}]}], 
             RowBox[{"        ", 
               StyleBox["B", "TI"], " is the bivector"}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
               RowBox[{"(", 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["i", "TI"]], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["A", "TI"], 
                    StyleBox["r", "TI"]]}], ")"}], "/", 
               StyleBox["r", "TI"]}], 
             RowBox[{"        ", 
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]], 
               RowBox[{" is the grade\[Hyphen]", 
                 Cell[
                  StyleBox["r", "TI"], "InlineFormula"], " blade "}]}]}, {
            "\[Null]", 
             RowBox[{
               StyleBox["a", "TI"], "\[LongEqual]", 
               RowBox[{"(", 
                 RowBox[{
                   StyleBox["a", "TI"], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    StyleBox["i", "TI"]]}], ")"}], 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]]}], 
             RowBox[{"        ", "component decomposition of vector"}]}, {
            "\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["A", "TI"], 
                StyleBox["r", "TI"]], "\[LongEqual]", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]], 
