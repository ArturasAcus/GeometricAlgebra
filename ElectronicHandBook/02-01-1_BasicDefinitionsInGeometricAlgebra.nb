Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Linear combination of vectors",
  FontSlant->"Italic"],
 ". Let ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["a", "TI"], ",", 
          StyleBox["b", "TI"], ",", 
          StyleBox["c", "TI"], "\[Ellipsis]", "\[Element]"}], 
        TraditionalForm], "errors" -> {}, "input" -> "$a,b,c\\ldots\\in$", 
      "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "\[ScriptCapitalV]"}], TraditionalForm]],
  ExpressionUUID->"97751682-e42c-45bf-9cd2-67b17b72163b"],
 ". The linear combination of vectors  is the expression of a form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Alpha]", 
         StyleBox["a", "TI"], "+", "\[Beta]", 
         StyleBox["b", "TI"], "+", "\[Gamma]", 
         StyleBox["c", "TI"], "+", "\[CenterEllipsis]", ";    ", "\[Alpha]", 
         ",", "\[Beta]", ",", "\[Gamma]", ",", "\[Ellipsis]", "\[Element]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha a+\\beta b+\\gamma c+\\cdots;\\qquad \
\\alpha,\\beta,\\gamma,\\dots\\in", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "16f7e260-c9f8-452a-8f26-0d9ddfd83c21"],
 "\[DoubleStruckCapitalR] (real numbers) or \[DoubleStruckCapitalC] (complex \
numbers) or \[DoubleStruckCapitalH] (quaternions).  For example, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"2", 
         StyleBox["a", "TI"], "+", "3", 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "2 a + 3 b", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ac0dd569-2c44-45eb-88e3-1851bc87b474"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"3", 
         StyleBox["a", "TI"], "+", "0", 
         StyleBox["c", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "3 a + 0 c", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e05e605d-a023-411f-a235-6492b288d25a"],
 " represent two different linear combinations of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9724671-a132-418c-b786-ec6528614597"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89ebf2e6-07db-44bd-9db9-0ba4c87b2f0f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
