    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "004a1d9f-b2a8-48e6-8867-880161ae7f77"],
 ".  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{12}=-\\mathrm{e}_{1}\\mathrm{e}_{}^{2}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "883858f9-1d6f-4d8b-b727-1040c0e9dfe1"],
 " in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{1,2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96132514-d22c-477e-b365-a32e95f3e0a9"],
 ". Using the index rule the vector in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{p,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "503b9216-0cb7-4858-b271-d787b0b16453"],
 " can be written compactly in a form of  relativistic algebra, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["p", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "+", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1", "+", 
            StyleBox["p", "TI"]}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1"}], 
          StyleBox["p", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "+", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["j", "TI"], "\[LongEqual]", "1", "+", 
            StyleBox["p", "TI"]}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         RowBox[{"(", 
           RowBox[{"-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a=a_i\\mathrm{e}_{}^i=\\sum_{j=1}^p a_j\\mathrm{e}_{}^j+\\sum_{j=1+p}^n \
a_j\\mathrm{e}_{}^j=\n\\sum_{j=1}^p a^j\\mathrm{e}_{j}+\\sum_{j=1+p}^n \
a^j(-\\mathrm{e}_{j})= a^i\\mathrm{e}_{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb818ec9-065a-41c2-82e1-8b82ba0d071b"],
 ",  where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_j=a\\cdot\\mathrm{e}_{j} ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c9e50ac-13d9-45ad-8e3f-1651c86a76ad"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^j=a \\cdot\\mathrm{e}_{}^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "653fc4dd-3f62-4036-87cd-291d94bbadf5"],
 " are the scalars. By comparing expansion coefficients in different basis \
one see that  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_j=a^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6ced0271-a806-40dc-a049-f3c1d777dd6a"],
 "  for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "\[LessEqual]", 
         StyleBox["j", "TI"], "\[LessEqual]", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1\\le j\\le p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aa2e5a1a-1e1d-4342-8fe4-213a79386ce7"],
 " and   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_j=-a^j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1909f00-e59e-44b8-b743-24cef0066797"],
 "  for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "+", "1", "\[LessEqual]", 
         StyleBox["j", "TI"], "\[LessEqual]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "p+1\\le j\\le q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ee1f7722-ed52-45a8-ac8d-dc19f9344b88"],
 ".  The square of the vector (in orthonormal basis) then is\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^2=a\\d a=(a_i\\mathrm{e}_{}^i)\\d(a^j\\mathrm{e}_{j})=a_i\n\
a^j(\\mathrm{e}_{}^i\\d\\mathrm{e}_{j})=a_i a^j\\delta_j^i=a_ia^i=a^ia_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "96342d78-597a-47ea-8e47-697cbc845ff2"],
 " or, alternatively, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "\[LongEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["a", "TI"], "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["i", "TI"]], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["a", "TI"], 
              StyleBox["j", "TI"]], 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["j", "TI"]]}], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^2=a\\d a=(a^i\\mathrm{e}_{i})\\d(a^j\\mathrm{e}_{j})=a^i\n\
a^j(\\mathrm{e}_{i}\\d\\mathrm{e}_{j})=a^i a^j g_{i j}=a_ja^j=a^ia_i", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "420e481c-e92e-4da8-a728-88ff9a29fa0c"],
 ". \[LineSeparator]\[LineSeparator]In ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\textrm{Cl}_{p,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11220b64-b88c-45eb-978f-9ad94f24f685"],
 " algebras ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i=a^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68c4fffd-6de9-46ce-9477-edd841ed7672"],
 " whereas in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{0,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ec3c1092-c937-445d-9ce6-3f5b0abc3719"],
 " algebras ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i=-a^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6da44723-ece7-4677-9c0c-a2180e9673b6"],
 " (the sign comes from rising of basis vectors). Therefore, the square of \
the vector in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\textrm{Cl}_{p,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a394e9f-4e3b-45f0-a6c2-fb2802213d31"],
 "  is always a positive and in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{0,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a2bcad80-a241-46a9-b168-74f70b00193b"],
 "  negative number. Similarly to tensor calculus it is possible to raise the \
lower index, or vice versa, with a help of  metric matrix : ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["j", "TI"]], 
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a^j a_i=g^{ij}a_ja_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bf21079e-ad2e-4a91-8fcc-4239d3168315"],
 " (where again matrix elements are computed by multiplying basis vectors) . \
Since in a case of orthonormal basis the metric matrix is diagonal and \
consists of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PlusMinus]", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "027ea9f8-d78c-44a7-ad62-a58fc63d1403"],
 "\[CloseCurlyQuote]s, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox["\[PlusMinus]\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g^{ij}=\\pm\\delta_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "33903096-032c-4744-a110-aee96d43d072"],
 ",  summation over repeated index provides the correct signs in front of \
respective coefficients. ",
 StyleBox["We stress once more, that rules like  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i=a^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "d0643f32-0bd2-4100-b324-00cdf5f3dd99"],
 StyleBox[" for  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", "0"}]], TraditionalForm], "errors" -> {}, 
     "input" -> "\\textrm{Cl}_{p,0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "7f554e8f-61a1-45f4-aea2-91c0319246c0"],
 StyleBox[" algebras and   ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SuperscriptBox[
          StyleBox["a", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a_i=-a^i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "dd77ef58-ccf8-4f6e-b64f-07d3e2799450"],
 StyleBox["  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{0,q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "81ab6ea2-87eb-4796-9d76-b3e48f45cdc8"],
 StyleBox[" algebras are due rising/lowering  of indices of  basis vectors \
and Einstein summation convention, since index position for a scalar quantity \
(a coefficient) make no sense. ",
  Background->RGBColor[0.87, 0.94, 1]]
}], "Item",ExpressionUUID->"fbf3e3b1-331e-4b2e-b8fa-49877db45122"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"07fb1c8e-0f7b-4aa4-9643-f3e803b86fac"],

Cell[CellGroupData[{

Cell["\<\
Here we repeat index index how index lowering/rising works. For Euclidean \
algebras  coefficients in primary and reciprocal basis are the same\
\>", "Text",ExpressionUUID->"c3c582a3-3c15-4283-9741-00da3ce1e7fe"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebraEuclid", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"3", ",", "0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"gaDefineOrthonormalBasis", "[", 
  RowBox[{"testAlgebraEuclid", ",", 
   RowBox[{"Quiet", "->", "False"}]}], "]"}]}], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"41c74ee1-2f48-4b72-8767-7c24e90e05e8"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Basis vectors are stored in \"\>",
   "EchoLabel"], "  ", 
  TagBox[
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{
     TemplateBox[{"3", "0", "0"},
      "Cl",
      DisplayFunction->(SubscriptBox[
        StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
        RowBox[{#, ",", #2}]]& ),
      Tooltip->None], ",", "\<\"InvDeg[Lex]\"\>"}], "]"}],
   HoldForm]}]], "Echo",
 CellChangeTimes->{
  3.9497402766290913`*^9},ExpressionUUID->"c6432b56-0985-447a-8a1d-\
e67f20f7c73e"],

Cell[BoxData[
 RowBox[{
  TagBox["\<\"Running algebra is: gaRunningAlgebra=\"\>",
   "EchoLabel"], "  ", 
  TemplateBox[{"3", "0", "0"},
   "Cl",
   DisplayFunction->(SubscriptBox[
     StyleBox["Cl", {FontColor -> RGBColor[0., 1., 0.]}], 
     RowBox[{#, ",", #2}]]& ),
