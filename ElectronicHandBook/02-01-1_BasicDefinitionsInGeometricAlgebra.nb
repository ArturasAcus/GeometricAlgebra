Cell["\<\
Higher gaBinomialConjugate[ ] are required for algebras with n>=4. Since we \
test graded up to grade=15,  vector space dimension should be 15 or greater. \
\
\>", "Text",ExpressionUUID->"2a7593b8-b31b-4826-97ca-95df41360634"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
    RowBox[{"9", ",", "6"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Quiet", "->", "False"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"generalMV", "=", 
    RowBox[{"gaGeneralMultivector", "[", 
     RowBox[{"a", ",", "testAlgebra"}], "]"}]}], ")"}], "//", 
  "Length"}], "\[IndentingNewLine]", 
 RowBox[{"representativeBasisElements", "=", 
  RowBox[{"First", "/@", 
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"testAlgebra", ",", "\"\<InvDeg[Lex]\>\"", ",", 
     RowBox[{"GroupBy", "\[Rule]", "\"\<Grade\>\""}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"generalMVGradeRepresentatives", "=", 
  RowBox[{
   RowBox[{"gaGetMV", "[", 
    RowBox[{"generalMV", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], "+", 
   RowBox[{"gaGetMV", "[", 
    RowBox[{"generalMV", ",", 
     RowBox[{"Rest", "[", "representativeBasisElements", "]"}]}], 
    "]"}]}]}]}], "Input",
 CellLabel->
  "In[133]:=",ExpressionUUID->"bfe6b83f-8229-4c18-8629-686a5f8341d1"],

