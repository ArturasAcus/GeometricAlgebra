Cell[TextData[{
 StyleBox["Expansion of homogeneous trivector",
  FontSlant->"Italic"],
 ". Let\[CloseCurlyQuote]s check the  MV expansion formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], 
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["A", "TI"], 
              StyleBox["r", "TI"]]}], ")"}], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         SubscriptBox[
          StyleBox["A", "TI"], 
          StyleBox["r", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{i}(\\e{}^i\\d A_r)=r A_r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f0bee99f-1404-4fd3-b5f5-b623c03f28db"],
 " for a homogeneous trivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["A", "TI"], "3"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["a", "TI"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "123"], "+", 
         SubscriptBox[
          StyleBox["a", "TI"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "235"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "A_3=a_1 \\e{123} +a_2\\e{235}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b114eb75-a074-46fb-bb02-1c2c27d5042c"],
 " in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"2", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{2,3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4af7aa04-e2eb-4129-879c-84dc27703212"],
 " . The reciprocal basis vectors in this algebra are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
