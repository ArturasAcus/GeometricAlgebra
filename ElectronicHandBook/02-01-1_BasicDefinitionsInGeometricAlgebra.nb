Cell[TextData[{
 StyleBox["Boost",
  FontSlant->"Italic"],
 ". [",
 StyleBox["From above calculations we see that that the formula might be \
applied only to blades. General considerations are wrong here. To replace by \
correct version of Shirokov, may leave as an example of incorrect logic?",
  FontColor->RGBColor[1, 0, 0]],
 "] In 4D space, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", "4"}], TraditionalForm], 
     "errors" -> {}, "input" -> "n=4", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "438f8672-cd71-4d87-a39b-147fe054acde"],
 ", the next-to-last  rotor formula in above example simplifies to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         FractionBox[
          RowBox[{
            SubscriptBox[
             StyleBox["f", FontSlant -> "Bold"], 
             StyleBox["i", "TI"]], 
            SuperscriptBox[
             StyleBox["e", FontSlant -> "Plain"], 
             StyleBox["i", "TI"]]}], 
          TemplateBox[{
            RowBox[{
              SubscriptBox[
               StyleBox["f", FontSlant -> "Bold"], 
               StyleBox["i", "TI"]], 
              SuperscriptBox[
               StyleBox["e", FontSlant -> "Plain"], 
               StyleBox["i", "TI"]]}]}, "Abs"]]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\m{R}=\\frac{\\mathbf{f}_i\\e{}^i}{|\\mathbf{f}_i\\e{}^i|}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af4ddbe2-821c-4ff7-ab78-1b166d1ab9aa"],
 ". Let us take the relativistic ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "3"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{Cl}_{1,3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6c9dfef8-97c2-4f62-82df-b6d607862817"],
 "  algebra, where squares of the basis vectors are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1", "2"], "\[LongEqual]", 
         "1"}], TraditionalForm], "errors" -> {}, "input" -> "\\e{1}^2=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f455f596-30d3-45f1-af89-400bad67251b"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "-1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\e{i}^2=-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3003a2e3-fb72-4666-ba68-f58733abf5f8"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "2", ",", "3", ",", "4"}], 
       TraditionalForm], "errors" -> {}, "input" -> "i=2,3,4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5861d4bc-68ac-4bf2-b6e4-7773fb6d2a65"],
 ". Lowering of the indices then yields, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{}^1=\\e{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4a0932bc-b46c-48f6-9d6e-9e2568e50d63"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{}^i=-\\e{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7235340f-c6c9-4a51-8c0d-3b75018f64dd"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", "2", ",", "3", ",", "4"}], 
       TraditionalForm], "errors" -> {}, "input" -> "i=2,3,4", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "01e7a886-d4ed-4c85-8ac5-557b9902f39a"],
 ". To simplify calculations let us assume that two of the axes of the new \
basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["f", FontSlant -> "Bold"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9dd05fcd-e57c-4345-b09c-0680f26db5d9"],
 " remain parallel, i.e., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "3"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathbf{f}_3=\\e{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9f4cdd3-55f3-4652-87a1-c6a852215099"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "4"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathbf{f}_4=\\e{4}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "711e3fd8-8b47-4d82-93b0-df4ca48544c1"],
 ". Then \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "3"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "-", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "4"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "1"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "2"], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "1", "+", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}_i\\e{}^i=\\mathbf{f}_1\\e{1}-\\mathbf{f}_2\\e{2}-\\mathbf{f}\
_3\\e{3}-\\mathbf{f}_4\\e{4}=\\mathbf{f}_1\\e{1}-\\mathbf{f}_2\\e{2}+1+1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0dcdd0e6-5741-42aa-a66b-77dd53315384"],
 ". \[LineSeparator]\[LineSeparator]To proceed further we need a relation \
between ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["f", FontSlant -> "Bold"], "1"], ",", 
           SubscriptBox[
            StyleBox["f", FontSlant -> "Bold"], "2"]}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{\\mathbf{f}_1,\\mathbf{f}_2\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2e88c0c0-51bb-444e-b0fa-584da1392e56"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "2"]}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\{\\e{1},\\e{2}\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8a21291d-3402-423c-82bb-a81edcae0f56"],
 ". Since now ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "12", "2"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "334f46bc-a258-4a82-b3eb-e4b5aef2be65"],
 " is positive, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "12", "2"], "\[LongEqual]", 
         "-", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1", "2"], 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2", "2"], "\[LongEqual]", "-", 
         RowBox[{"(", "+1", ")"}], 
         RowBox[{"(", "-1", ")"}], "\[LongEqual]", "+1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}^2=-\\e{1}^2\\e{2}^2=-(+1)(-1)=+1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "399b7638-f454-475d-8e22-872979b95f7c"],
 ", the \[OpenCurlyDoubleQuote]rotation\[CloseCurlyDoubleQuote] from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], "2"]}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\{\\e{1},\\e{2}\\} ", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f24be571-4f05-4f0a-a509-ae15e226fec4"],
 "to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["f", FontSlant -> "Bold"], "1"], ",", 
           SubscriptBox[
            StyleBox["f", FontSlant -> "Bold"], "2"]}], "}"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\{\\mathbf{f}_1,\\mathbf{f}_2\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63ed4d06-a2b1-491d-b445-31d40ce0e013"],
 " must be done with the hyperbolic \
functions,\[LineSeparator]\[LineSeparator] ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], "1"], "\[LongEqual]", 
               StyleBox["ch", FontSlant -> "Plain"], "\[Phi] ", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
               StyleBox["sh", FontSlant -> "Plain"], "\[Phi] ", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], ",  ", 
               SubsuperscriptBox[
                StyleBox["f", FontSlant -> "Bold"], "1", "2"], "\[LongEqual]",
                "+1", ","}]}, {"\[Null]", 
             RowBox[{
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], "2"], "\[LongEqual]", 
               StyleBox["sh", FontSlant -> "Plain"], "\[Phi] ", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
               StyleBox["ch", FontSlant -> "Plain"], "\[Phi] ", 
               SubscriptBox[
                StyleBox["e", FontSlant -> "Plain"], "2"], ",    ", 
               SubsuperscriptBox[
                StyleBox["f", FontSlant -> "Bold"], "2", "2"], "\[LongEqual]",
                "-1."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\
&\\mathbf{f}_1=\\mathrm{ch}\\phi\\,\\e{1}+\\mathrm{sh}\\phi\\,\\e{2},\\quad \
\\mathbf{f}_1^2=+1,\\\\\n\
&\\mathbf{f}_2=\\mathrm{sh}\\phi\\,\\e{1}+\\mathrm{ch}\\phi\\,\\e{2},\\qquad \
\\mathbf{f}_2^2=-1.\\\\\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e98ed316-5218-463b-8b24-1f798fb2cbe2"],
 "  \[LineSeparator]\nThe new basis remains orthogonal, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "1"], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], "2"], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathbf{f}_1\\d\\mathbf{f}_2=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e7acf521-83eb-48aa-abc1-50958fc30294"],
 ". After insertion into rotor formula one finds \[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               SubscriptBox[
                StyleBox["f", FontSlant -> "Bold"], 
                StyleBox["i", "TI"]], 
               SuperscriptBox[
                StyleBox["e", FontSlant -> "Plain"], 
                StyleBox["i", "TI"]]}], 
             RowBox[{"\[LongEqual]", "2", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   StyleBox["ch", FontSlant -> "Plain"], "\[Phi]", "-", 
                   StyleBox["sh", FontSlant -> "Plain"], "\[Phi] ", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "12"]}], ")"}]}]}, {
            "\[Null]", 
             RowBox[{"\[LongEqual]", "2", 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    SuperscriptBox[
                    StyleBox["ch", FontSlant -> "Plain"], "2"], 
                    FractionBox["\[Phi]", "2"], "-", "1"}], ")"}], "-", 
                   RowBox[{"(", 
                    RowBox[{"2", 
                    StyleBox["sh", FontSlant -> "Plain"], 
                    FractionBox["\[Phi]", "2"], 
                    StyleBox["ch", FontSlant -> "Plain"], 
                    FractionBox["\[Phi]", "2"]}], ")"}], 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "12"]}], ")"}], 
               "\[LongEqual]", "4", 
               StyleBox["ch", FontSlant -> "Plain"], 
               SuperscriptBox[
                FractionBox["\[Phi]", "2"], 
                RowBox[{"-", 
                  SubscriptBox[
                   StyleBox["e", FontSlant -> "Plain"], "12"], "\[Phi]", "/", 
                  "2"}]], "."}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n\
\\mathbf{f}_i\\e{}^i&=2(1+\\ch\\phi-\\sh\\phi\\,\\e{12})\\\\\n\
&=2\\big(1+(2\\ch^2\\frac{\\phi}{2}-1)-(2\\sh\\frac{\\phi}{2}\\ch\\frac{\\phi}\
{2})\\e{12}\\big)=\n4\\ch\\frac{\\phi}{2}\\ee^{-\\e{12}\\phi/2}.\\end{split}",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "36d2c513-522f-4a1b-b5df-d04986957edd"],
 "\[LineSeparator]\[LineSeparator]After normalization this yields the rotor \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "/", "|", 
         SubscriptBox[
          StyleBox["f", FontSlant -> "Bold"], 
          StyleBox["i", "TI"]], 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "|", "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{"-", 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "12"], "\[Phi]", "/", 
            "2"}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=\\mathbf{f}_i\\e{}^i/|\\mathbf{f}_i\\e{}^i|=\\ee^{-\\e{12}\\phi/\
2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "78ca4694-0070-4018-be92-1f692bb88b82"],
 ", which is called the relativistic boost in ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], "12"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{12}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0e8262c4-831d-4204-9ffb-d9d07793323a"],
 " time-space plane. After boost, i.e. \[OpenCurlyDoubleQuote]rotation\
\[CloseCurlyDoubleQuote]  in time-space plane by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["R", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          RowBox[{"-", 
            SubscriptBox[
             StyleBox["e", FontSlant -> "Plain"], "12"], "\[Phi]", "/", 
            "2"}]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{R}=\\ee^{-\\e{12}\\phi/2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "06f3087d-9ff1-45f0-a52a-61f8bd81f2bd"],
 "  the inertial system acquires the\nvelocity. In other words the Lorentz \
transformation in GA is related to the boost transformation in 4-vector \
Minkowski space."
}], "Subitem",ExpressionUUID->"21a12cda-88b4-4959-b096-ba5c69d49812"]
}, Closed]],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Metric in GA",
  FontSlant->"Italic"],
 ".  The metric can be introduced either by defining the so-called quadratic \
form, or using the vector inner product.  The metric is encoded in GA symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{p}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92718601-6318-4655-a331-c2b699f4ca12"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["p", "TI"], TraditionalForm], "errors" -> {}, "input" -> "p", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7f48fdba-b599-4fa7-b4aa-7521e59ba05d"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["q", "TI"], TraditionalForm], "errors" -> {}, "input" -> "q", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2a2d6aed-90d0-43dc-a38b-d1b91e279598"],
 " indicate the number of basis vectors with the positive and negative \
signature, respectively. The GA signature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["p", "TI"], ",", 
           StyleBox["q", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(p,q)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "14bfba40-5e57-42de-84dc-74427d819d54"],
 " is an invariant quantity, i.e. independent of chosen basis. The metric \
matrix and its inverse expressed by inner product are \[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["g", "TI"], "^"], "\[Congruent]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 RowBox[{
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"]}], 
                 "\[Ellipsis]"}, {
                 RowBox[{
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], 
                 RowBox[{
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "\[CenterDot]", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"]}], "\[Null]"}, {
                "\[VerticalEllipsis]", "\[Null]", "\[DescendingEllipsis]"}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}\\equiv g_{ij}=\\begin{bmatrix}\n\
\\e{1}\\d\\e{1}&\\e{1}\\d\\e{2}&\\dots\\\\\n\
\\e{2}\\d\\e{1}&\\e{2}\\d\\e{2}&\\\\\n\\vdots& &\\ddots\\\\\n\\end{bmatrix}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce144c25-7ec9-4406-ac7e-d5a097f9809d"],
 "\t, \t",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], "-1"], "\[Congruent]", 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         RowBox[{"[", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"], "\[CenterDot]", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"]}], 
                 "\[Ellipsis]"}, {
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "\[CenterDot]", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "1"]}], 
                 RowBox[{
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"], "\[CenterDot]", 
                   SuperscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], "2"]}], "\[Null]"}, {
                "\[VerticalEllipsis]", "\[Null]", "\[DescendingEllipsis]"}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]], "]"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}^{-1}\\equiv g^{ij}=\\begin{bmatrix}\n\
\\e{}^{1}\\d\\e{}^{1}&\\e{}^1\\d\\e{}^{2}&\\dots\\\\\n\
\\e{}^{2}\\d\\e{}^{1}&\\e{}^{2}\\d\\e{}^{2}&\\\\\n\\vdots& &\\ddots\\\\\n\
\\end{bmatrix}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8d819a01-9601-48ad-81a1-10bd64116c79"],
 "\[LineSeparator]\nwhich satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij}=g_{ji}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0b8ba11d-87fe-46be-af73-4313a1497ce5"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["g", "TI"], "^"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["g", "TI"], "^"], "-1"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]], "\[LongEqual]", 
         OverscriptBox["1", "^"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}\\hat{g}^{-1}=g_{ij}g^{ji}=\\hat{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a18c5073-4929-46e6-97e9-e8bcef478025"],
 ".  In the tensor calculus, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "19c5d4be-b84f-4281-a7cc-d1d8df69585d"],
 " is called the covariant metric tensor.  In orthonormalized frame the both \
matrices, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["g", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1a3ced1b-1863-4ca6-9933-5043076eb96f"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        OverscriptBox[
         StyleBox["g", "TI"], "^"], "-1"], TraditionalForm], "errors" -> {}, 
     "input" -> "\\hat{g}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0247ecdb-68ee-4959-9ca3-174e3a981f6e"],
 ", are diagonal and consist of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[PlusMinus]", "1"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\pm 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "014efc3b-e2ec-4435-a430-689bd9842a94"],
 ". In the Euclidean space, the metric is positive since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "+1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\e{i}\\d\\e{i}=\\e{i}^2=+1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1020e2b4-ffa6-433a-ade7-458a7f14b898"],
 " for all basis vectors. In the anti-Euclidean space it is completely \
negative since ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"], "2"], "\[LongEqual]", "-1"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\e{i}\\d\\e{i}=\\e{i}^2=-1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a1f77690-a1ed-41e1-8627-973ea4ab20c8"],
 ". In the mixed metric space the sign of diagonal elements is positive and \
negative. ",
 StyleBox["Once again, we stress that when mathematicians dealt with two \
different spaces ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   RowBox[{"primary", " ", "\[ScriptCapitalV]"}], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "c39eb633-8c8b-4e8f-8204-b59a1a6981e0"],
 StyleBox[" and dual ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ScriptCapitalV]", "*"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "5181adf1-a475-4f0c-924f-39b237f02b30"],
 StyleBox["   the relation ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}], "-1"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "g^{ij}=g_{ij}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "92dba9bc-f672-4a71-849c-6906ae169542"],
 StyleBox["  between dual space metric  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "54fcc1f3-5a7d-4c66-9024-9ea430588ff4"],
 StyleBox["  and primary space  metric tensor  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}], "-1"], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "07f3c168-6ec4-40aa-adbe-2fe0405184a0"],
 StyleBox[" can only be understood in numerical sense (numbers of matrix \
elements are equal). It does not mean that ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "g^{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "ee63dc20-e749-4c57-957c-3fd242af42e7"],
 StyleBox[" and  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubsuperscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}], "-1"], TraditionalForm], "errors" -> {}, 
     "input" -> "g_{ij}^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "e3c2c7ef-be08-435b-8cd8-09db8a6d4e95"],
 StyleBox[" tensors \[OpenCurlyDoubleQuote]live\[CloseCurlyDoubleQuote] in \
the same space. \n",
  Background->RGBColor[0.87, 0.94, 1]],
 "\nAlternatively, the metric  can be introduced by quadratic form defined on \
vectors. It determines a scalar function that maps the pairs of linearly \
independent vectors onto scalar function. This allows to construct ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["n", "TI"], "\[Cross]", 
           StyleBox["n", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(n\\times n)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9d7d4fc7-0250-45b2-9685-5b4c240302bd"],
 " real symmetric matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["g", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "411f9bd2-ada6-46b0-90d6-3b5239e6cac7"],
 " the elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["g", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "g_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3c22defd-6d44-4b7f-89c9-80f3c4a21bc8"],
 " of which determine quadratic form formula ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "1"], ",", "\[Ellipsis]", ",", 
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]]}], ")"}], "\[LongEqual]", 
         UnderoverscriptBox["\[Sum]", 
          RowBox[{
            StyleBox["i", "TI"], ",", 
            StyleBox["j", "TI"]}], 
          StyleBox["n", "TI"], LimitsPositioning -> True], 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["i", "TI"]], 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["j", "TI"]], ",  ", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["g", "TI"], 
          RowBox[{
            StyleBox["j", "TI"], 
            StyleBox["i", "TI"]}]], "\[Element]"}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "Q(x_1,\\dots ,x_n)=\\sum_{i,j}^ng_{ij}x_ix_j,\\quad g_{ij}=g_{ji}\\in", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2efdc392-136a-4034-bf42-0ca5307d0961"],
 "\[DoubleStruckCapitalR]. If the  coordinates ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9207dca-1822-422e-a807-c3572280cb34"],
 " are represented by a column vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TB"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bf x", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a687ae10-9521-47b0-b94a-1a3f1e11085b"],
 ", then the quadratic form can be rewritten compactly as ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["Q", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TB"], ")"}], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TB"], "T"], 
         OverscriptBox[
          StyleBox["g", "TI"], "^"], 
         StyleBox["x", "TB"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "Q({\\bf x})={\\bf x}^{\\textrm{T}}\\hat{g}{\\bf x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9b3c136d-684d-4c06-9010-d751251e856e"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["T", TraditionalForm], "errors" -> {}, "input" -> 
     "\\textrm{T}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d10b5641-e7bf-48a4-b3c4-58b0e754e62f"],
 " (transpose) turns a column  into row. The  real symmetric matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["g", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{g}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "806d108f-d1e4-4c63-bc80-6c2288e6ed82"],
 " always can be transformed into diagonal form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox["\[CapitalLambda]", "^"], "\[LongEqual]", 
         OverscriptBox[
          StyleBox["S", "TI"], "^"], 
         OverscriptBox[
          StyleBox["g", "TI"], "^"], 
         SuperscriptBox[
          OverscriptBox[
           StyleBox["S", "TI"], "^"], "T"], "\[LongEqual]", "diag", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox["\[Lambda]", "1"], ",", 
             SubscriptBox["\[Lambda]", "2"], ",", "\[Ellipsis]", ",", 
             SubscriptBox["\[Lambda]", 
              StyleBox["n", "TI"]]}], "}"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\hat{\\Lambda}=\\hat{S}\\hat{g}\\hat{S}^{\\textrm{T}}=\\textrm{diag}\\{\
\\lambda_1,\\lambda_2,\\dots,\\lambda_n\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49cdc373-dfe9-4bee-9c25-061d2a5b05ad"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["S", "TI"], "^"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\hat{S}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "404b64b7-6209-4134-a337-9175c96a96c2"],
 " is an orthogonal matrix. The matrix ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox["\[CapitalLambda]", "^"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\hat{\\Lambda}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "54987f57-7a5c-478c-8f67-1ed3bd2608f8"],
 "  can be normalized to elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0", ",", "1", ","}], TraditionalForm], "errors" -> {}, 
     "input" -> "0, 1,", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c054ee77-3b25-42fb-94d9-66be841d9fb6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["-1", TraditionalForm], "errors" -> {}, "input" -> 
     "-1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "65676ad5-121d-4f54-b586-3b0569270f1f"],
 "on the diagonal. The number of plus and minus units, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "+"], "\[LongEqual]", 
         StyleBox["p", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n_{+}=p", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "abc79751-3665-41e6-b073-dffb076af90c"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "-"], "\[LongEqual]", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n_{-}=q", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "af99cd2a-0d08-40e6-b12a-fb62eef02c6b"],
 ", correspond to positive and negative signatures, while the zeroes, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["n", "TI"], "0"], "\[LongEqual]", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n_{0}=r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "091a4339-d2a0-475b-99e0-fd3e78ece45d"],
 ", render the null basis vectors. The dimension of thus obtained  metric \
matrix is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"], "+", 
         StyleBox["r", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "n=p+q+r", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce91ab2b-9adb-4357-8fb7-1e246cdd087b"],
 ". The  GA in which  some of basis vectors square to zero is called \
degenerate and  denoted by symbol ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["Cl", FontSlant -> "Plain"], 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"], ",", 
          StyleBox["r", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{Cl}_{p,q,r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "995c87a5-f993-475f-91d8-781811085f2e"],
 ".  "
}], "Item",ExpressionUUID->"0dc498b4-a155-4072-9f99-fd2e50c78d73"],

