Cell[BoxData[{
 RowBox[{
  RowBox[{"matrixRepresentationRules", "[", 
   RowBox[{"testAlgebra", ",", "1"}], "]"}], "=", 
  RowBox[{"gaDefineMatrixRepresentation", "[", 
   RowBox[{"testAlgebra", ",", 
    RowBox[{"Method", "\[Rule]", 
     RowBox[{"{", "\"\<TensorProduct\>\"", "}"}]}], ",", 
    RowBox[{"\"\<Grades\>\"", "\[Rule]", 
