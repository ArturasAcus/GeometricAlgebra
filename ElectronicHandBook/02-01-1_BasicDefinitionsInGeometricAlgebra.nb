   RowBox[{"Cl", "[", 
    RowBox[{"2", ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"gaDefineOrthonormalBasis", "[", "testAlgebra", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"generalMV", "=", 
  RowBox[{"gaGeneralMultivector", "[", 
   RowBox[{"a", ",", "testAlgebra"}], "]"}]}]}], "Input",
 CellLabel->
  "In[126]:=",ExpressionUUID->"cf73138c-4bc7-4090-9be5-933c8ee808bc"],

