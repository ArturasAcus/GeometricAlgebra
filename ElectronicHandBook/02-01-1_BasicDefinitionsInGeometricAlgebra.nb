Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\tIdempotents and ideals.  If ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         RowBox[{
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            SubscriptBox[
             StyleBox["T", "TI"], "1"]], ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            SubscriptBox[
             StyleBox["T", "TI"], "2"]], ",", "\[Ellipsis]", ",", 
           SubscriptBox[
            StyleBox["e", FontSlant -> "Plain"], 
            SubscriptBox[
             StyleBox["T", "TI"], 
             StyleBox["k", "TI"]]]}], "}"}], TraditionalForm], "errors" -> {},
      "input" -> "\\{\\e{T_1},\\e{T_2},\\dots,\\e{T_k}\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5b696b88-31d3-4440-8ab7-12edee29dd47"],
 " is a set of commuting GA elements that square to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["1", TraditionalForm], "errors" -> {}, "input" -> "1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c94ea7fe-e66a-48c5-ba70-edde11ef320a"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          SubscriptBox[
           StyleBox["T", "TI"], 
           StyleBox["i", "TI"]], "2"], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\e{T_i}^2=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1868992f-2c74-4680-935e-bd9007f3cacd"],
 " (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["T", "TI"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "T_k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59c09d28-7ff7-4d4a-85ca-1325fb045333"],
 " denotes a multi-index), then allowing the signs of the elements ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        SubscriptBox[
         StyleBox["T", "TI"], 
         StyleBox["i", "TI"]]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{T_i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3459538-cc31-4e8b-a95f-188370d2f81c"],
 " in the product\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], "1"]]}], ")"}], 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], "2"]]}], ")"}], "\[CenterEllipsis]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              SubscriptBox[
               StyleBox["T", "TI"], 
               StyleBox["k", "TI"]]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "P_1=\\frac{1}{2}(1+\\e{T_1})\\frac{1}{2}(1+\\e{T_2})\\cdots \
\\frac{1}{2}(1+\\e{T_k})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6f94b474-14c9-4ff1-8f00-508ffb75cf22"],
 "\[LineSeparator]\nto vary independently, i.e., \[LineSeparator]\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{
             RowBox[{
               SubscriptBox[
                StyleBox["P", "TI"], "2"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "1"]]}], ")"}], 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "2"]]}], ")"}], "\[CenterEllipsis]", 
               
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], 
                    StyleBox["k", "TI"]]]}], ")"}], ","}]}, {
             RowBox[{
               SubscriptBox[
                StyleBox["P", "TI"], "3"], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "1"]]}], ")"}], 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "2"]]}], ")"}], "\[CenterEllipsis]", 
               
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "+", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], 
                    StyleBox["k", "TI"]]]}], ")"}], ","}]}, {
             RowBox[{"\[CenterEllipsis]\[CenterEllipsis]", ","}]}, {
             RowBox[{
               SubscriptBox[
                StyleBox["P", "TI"], 
                SuperscriptBox["2", 
                 StyleBox["k", "TI"]]], "\[LongEqual]", 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "1"]]}], ")"}], 
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], "2"]]}], ")"}], "\[CenterEllipsis]", 
               
               FractionBox["1", "2"], 
               RowBox[{"(", 
                 RowBox[{"1", "-", 
                   SubscriptBox[
                    StyleBox["e", FontSlant -> "Plain"], 
                    SubscriptBox[
                    StyleBox["T", "TI"], 
                    StyleBox["k", "TI"]]]}], ")"}], ","}]}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{matrix}\n\
P_2=\\frac{1}{2}(1-\\e{T_1})\\frac{1}{2}(1+\\e{T_2})\\cdots\n\
\\frac{1}{2}(1+\\e{T_k}),\\\\\n\
P_3=\\frac{1}{2}(1+\\e{T_1})\\frac{1}{2}(1-\\e{T_2})\\cdots\n\
\\frac{1}{2}(1+\\e{T_k}),\\\\\n\\cdots\\fill\\cdots,\\\\\n\
P_{2^k}=\\frac{1}{2}(1-\\e{T_1})\\frac{1}{2}(1-\\e{T_2})\\cdots\n\
\\frac{1}{2}(1-\\e{T_k}),\n\\end{matrix}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "86a33c00-f843-42cc-ade5-ac41a6f61a17"],
 "\[LineSeparator]\none obtains ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e208bb4c-f185-46db-a5ea-1fe3f3a7a759"],
 " idempotents which are mutually annihilating and sum up to unity, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "+", "\[CenterEllipsis]", "+", 
         SubscriptBox[
          StyleBox["P", "TI"], 
          SuperscriptBox["2", 
           StyleBox["k", "TI"]]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_1+P_2+\\cdots +P_{2^k}=1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a0d199bb-61fd-4151-ad7a-1ba063cac8b7"],
 ". Then it is said that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{
          StyleBox["p", "TI"], ",", 
          StyleBox["q", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{p}{q}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "828fae31-fc82-4031-a46b-a4e68a879ae4"],
 " algebra decomposes into a direct sum of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cab4159c-6b41-41d1-aa0c-f0f477aaac77"],
 " ideals. By construction used, each of the ideals has dimension ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["2", 
        RowBox[{
          StyleBox["n", "TI"], "-", 
          StyleBox["k", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "2^{n-k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "00f61485-8f28-43f8-858e-90870447702f"],
 ". For real algebras the above maximal product of non-annihilating and \
commuting idempotents, which square to one, yields a set of minimal left \
ideals ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           SubscriptBox[
            StyleBox["P", "TI"], 
            StyleBox["i", "TI"]], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           SubscriptBox["Cl", 
            RowBox[{
              StyleBox["p", "TI"], ",", 
              StyleBox["q", "TI"]}]], "}"}], 
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cI(P_i)=\\{\\cl{p}{q}\\}P_i", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "236f69dd-4ef5-42ce-8ffa-e033fde1f831"],
 " at fixed  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "\[LessEqual]", 
         StyleBox["i", "TI"], "\[LessEqual]", 
         StyleBox["n", "TI"], "-", 
         StyleBox["k", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "1\\le i\\le n-k", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d7dfc8a0-2035-44c6-ba2a-23931a68ebfb"],
 ". More on ideal applications see sections ",
 StyleBox["\\ref{realGAspinors} and \\ref{complexGAspinors} in \
Chapt.~\\ref{spinorsMVrepresentation}",
  FontColor->RGBColor[1, 0, 0]],
 ".\n"
}], "Item",ExpressionUUID->"7f1c4856-ee35-4ca9-a7e2-8ae1fe5d102e"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Idempotents of low dimensional algebras.",
  FontSlant->"Italic"],
 " Clifford algebras ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "110c26c9-1df6-41ad-a379-daf75e291ba2"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"0", ",", "2"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{0}{2}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "561fe146-b3e0-4c5b-80dc-b841125c8ace"],
 " are the division rings. Their idempotent therefore is trivial, i.e.  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_1=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9016b0f6-d74a-43a5-8443-e011a35ae8e6"],
 "  (there is no vector that squares to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["+1", TraditionalForm], "errors" -> {}, "input" -> 
     "+1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fa9be63d-6cea-4229-a5d3-cf441637bf17"],
 ").  For algebras (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"1", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{1}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0db61f7c-ecac-4d2b-8982-7b4ad7c40949"],
 "), (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Cl", 
          RowBox[{"2", ",", "0"}]], ",", 
         SubscriptBox["Cl", 
          RowBox[{"1", ",", "1"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{2}{0},\\cl{1}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99930c84-99d8-4d47-b810-a7b7d799cbd7"],
 "), (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Cl", 
          RowBox[{"3", ",", "0"}]], ",", 
         SubscriptBox["Cl", 
          RowBox[{"1", ",", "2"}]], ",", 
         SubscriptBox["Cl", 
          RowBox[{"0", ",", "3"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{3}{0},\\cl{1}{2},\\cl{0}{3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d37aa5ed-7518-41cf-b249-541610515984"],
 ") and (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["Cl", 
          RowBox[{"4", ",", "0"}]], ",", 
         SubscriptBox["Cl", 
          RowBox[{"1", ",", "3"}]], ",", 
         SubscriptBox["Cl", 
          RowBox[{"4", ",", "0"}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cl{4}{0},\\cl{1}{3},\\cl{4}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "643822a4-db70-4d39-87e6-196a71d24750"],
 ") only single  element ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["T", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\e{T}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5bd329c9-c1a3-42e9-8e9f-9e514f15aaa7"],
 " appear in the product (see also ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"respective", " ", "Table"}],
    BaseStyle->"Hyperlink",
    ButtonData->"TableOfIdempotents"], TraditionalForm]],ExpressionUUID->
  "5771ca37-bd60-4abf-aeb4-12ac1ee027fa"],
 "). Then, the primitive mutually annihilating (orthogonal) idempotents are \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "+", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["T", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_1=\\frac{1}{2}(1+\\e{T})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "907c364d-bdbe-48be-a413-cf77a86cb2ae"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", 
         FractionBox["1", "2"], 
         RowBox[{"(", 
           RowBox[{"1", "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["T", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_2=\\frac{1}{2}(1-\\e{T})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7c538380-7304-4de7-b2b0-af5f79e5dc3e"],
 " which satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "+", 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_1+P_2=1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8ddcc14a-2491-4c71-8ad5-b4a73790a258"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], 
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "P_1P_2=P_2P_1=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "166d5888-2e22-44c9-9496-b6264ab384a3"],
 ". The dimension of the spinor space (number of spinor projections) is, \
therefore, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"dim", 
         RowBox[{"{", 
           SubscriptBox["Cl", 
            RowBox[{
              StyleBox["p", "TI"], ",", 
              StyleBox["q", "TI"]}]], "}"}], 
         SubscriptBox[
          StyleBox["P", "TI"], "1"], "\[LongEqual]", "dim", 
         RowBox[{"{", 
           SubscriptBox["Cl", 
            RowBox[{
              StyleBox["p", "TI"], ",", 
              StyleBox["q", "TI"]}]], "}"}], 
         SubscriptBox[
          StyleBox["P", "TI"], "2"], "\[LongEqual]", 
         FractionBox["1", "2"], "dim", 
         RowBox[{"{", 
           SubscriptBox["Cl", 
            RowBox[{
              StyleBox["p", "TI"], ",", 
              StyleBox["q", "TI"]}]], "}"}], "\[LongEqual]", 
         SuperscriptBox["2", 
          RowBox[{
            StyleBox["n", "TI"], "-", "1"}]], ",    ", 
         StyleBox["n", "TI"], "\[LongEqual]", 
         StyleBox["p", "TI"], "+", 
         StyleBox["q", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{dim}\\{\\cl{p}{q}\\}P_1=\\text{dim}\\{\\cl{p}{q}\\}P_2=\n\
\\frac{1}{2}\\text{dim}\\{\\cl{p}{q}\\}=2^{n-1}, \\qquad n=p+q", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1297ba48-eda1-4dc6-85fc-f2b5f7bbe1d2"],
 "."
}], "Subitem",ExpressionUUID->"c808ca0c-fe05-4cbb-87ca-8419b533697f"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"63d714ad-d2f9-406a-ad16-12f1157fe04b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Choose algebra and test what number of primitive idempotents each algebra \
(till ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"9", ",", "9"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{9}{9}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5902d280-a74e-4e36-9778-bb90827bf7dc"],
 ")  has with undocumented function"
}], "Text",ExpressionUUID->"d039dfdc-661d-4112-848b-ebf07508ad38"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"numberOfPrimitiveIdempotents", "=", 
  RowBox[{"TableForm", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"GeometricAlgebra`p`numberOfPrimitiveIdempotents", "[", 
       RowBox[{"Cl", "[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "9"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "0", ",", "9"}], "}"}]}], "]"}], ",", 
    RowBox[{"TableHeadings", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<i=\>\"", ",", 
           RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "9"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<j=\>\"", ",", 
           RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "9"}], "]"}]}]}], "}"}]}]}], "]"}]}]], "Input",
 CellLabel->
  "In[118]:=",ExpressionUUID->"7e42314b-81a1-4f08-b5e5-86971e0f60ff"],

