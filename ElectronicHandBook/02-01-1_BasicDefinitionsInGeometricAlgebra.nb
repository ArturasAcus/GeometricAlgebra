Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["The upper/lower index notation",
  FontSlant->"Italic"],
 ".  This section is duplication of already described subject and is omitted \
from electronic supplement. Only example is included."
}], "Item",ExpressionUUID->"c264528d-66b1-443c-8b16-59aa085545f6"],

Cell[TextData[{
 " ",
 StyleBox["Example of non-orthogonal reciprocal basis",
  FontSlant->"Italic"],
 ".  Let ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "1"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], ",", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "B=\\{\\mathrm{e}_{1},\\mathrm{e}_{2},\\mathrm{e}_{3}\\}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "daf31776-6ff4-454b-b917-3c77352e609b"],
 " be the standard orthonormal basis vectors and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["B", "TI"], "\[Prime]"], "\[LongEqual]", 
         RowBox[{"{", 
           RowBox[{
             SubsuperscriptBox[
              StyleBox["e", "TI"], "1", "\[Prime]"], ",", 
             SubsuperscriptBox[
              StyleBox["e", "TI"], "2", "\[Prime]"], ",", 
             SubsuperscriptBox[
              StyleBox["e", "TI"], "3", "\[Prime]"]}], "}"}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "B^{\\prime}=\\{e_{1}^{\\prime},e_{2}^{\\prime},e_{3}^{\\prime}\\}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a478a8f7-5f1c-4262-a06b-953c01095e1c"],
 " be general non-orthonormal  vectors. The orthonormal basis satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[PlusMinus]\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{j}=\\pm\\delta_{ij}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ce1c106d-45fa-4778-8026-f01c05b5442f"],
 ".  Let the both basis vectors be connected by relations: ",
 StyleBox["[Cia Handbooke kazkas visai negerai: butent ten sumaisyta \
geometrine ir vidine sandaugos!!!]",
  FontColor->RGBColor[1, 0, 0]],
 "\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], ",  ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], "\[LongEqual]", "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], ",  ", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "3", "\[Prime]"], "\[LongEqual]", "2", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "e_{1}^{\\prime}=-\\mathrm{e}_{1}-\\mathrm{e}_{2}+\\mathrm{e}_{3},\\quad \
e_{2}^{\\prime}=-\\mathrm{e}_{1}+\\mathrm{e}_{3},\\quad \
e_{3}^{\\prime}=2\\mathrm{e}_{1}+\\mathrm{e}_{2}-\\mathrm{e}_{3}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5da941f2-7493-4f0f-97ca-5af4ebd7d057"],
 ".\[LineSeparator]\nThe both basis must satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^i\\cdot\\mathrm{e}_{j}=\\delta^i_j ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f61a7cea-5831-4ed7-8726-a687ea7c0a57"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{"\[Prime]", 
            StyleBox["i", "TI"]}]], "\[CenterDot]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], 
          StyleBox["j", "TI"], "\[Prime]"], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{\\prime i}\\cdot e_{j}^{\\prime}=\\delta^i_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "59d1f52b-500c-4045-a816-60984e588b4f"],
 ", where down and up index positions relate the primary and  reciprocal \
frames. The standard basis automatically satisfies ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubsuperscriptBox["\[Delta]", 
          StyleBox["j", "TI"], 
          StyleBox["i", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^i\\cdot\\mathrm{e}_{j}=\\delta^i_j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "518db75e-9d1a-4067-a349-243a1d64ae9c"],
 ". \[LeftFloor]e look for how to express ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["i", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "e^{i}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b67da10-3e0f-4976-ba52-732d485529f5"],
 " in terms of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["j", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{}^{j}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5da9ffa5-966f-48b2-90f6-5af75556e7e8"],
 ".  First of all, note that the above system can be solved with respect to \
basis ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> "B", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d3d02112-2982-48c8-8a78-2e6e96056011"],
 ",\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "+", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "3", "\[Prime]"], ",  ", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "\[LongEqual]", "-", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "+", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], ",  ", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[LongEqual]", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "1", "\[Prime]"], "+", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "2", "\[Prime]"], "+", 
         SubsuperscriptBox[
          StyleBox["e", "TI"], "3", "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\mathrm{e}_{1}=e_{1}^{\\prime}+e_{3}^{\\prime},\\quad \
\\mathrm{e}_{2}=-e_{1}^{\\prime}+e_{2}^{\\prime},\\quad \
\\mathrm{e}_{3}=e_{1}^{\\prime}+e_{2}^{\\prime}+e_{3}^{\\prime}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e20091a5-fc7d-4235-be2c-dce187277659"],
 ".\[LineSeparator]\nSince ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> "B", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "66b2da5f-5730-4aaf-840a-cf2aa0a60c81"],
 " is orthonormal we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["j", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", 
         SubscriptBox["\[PlusMinus]\[Delta]", 
          RowBox[{
            StyleBox["i", "TI"], 
            StyleBox["j", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\mathrm{e}_{i}\\cdot\\mathrm{e}_{j}=\\mathrm{e}_{j}\\d\\mathrm{e}_{i}=\
\\pm\\delta_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a4bbaeeb-0fbc-468e-9da4-4340fa542883"],
 ". \[LeftFloor]hen ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["i", "TI"], "\[LongEqual]", 
         StyleBox["j", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "i=j", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "49423749-d1cf-44ea-86dc-e29cd0eec87f"],
 " the reciprocal vector satisfy ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{}^i\\d\\mathrm{e}_{i}=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71470917-24a0-4747-b3a0-dd31b19c9feb"],
 " (no summation in this particular case). Then after multiplication of both \
sides of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[CenterDot]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["i", "TI"]], "\[LongEqual]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\mathrm{e}_{}^i\\d\\mathrm{e}_{i}=1", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63102dc2-0175-411a-bbac-52397b66972c"],
 " by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["e", FontSlant -> "Plain"], 
        StyleBox["k", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\mathrm{e}_{k}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cb39db14-d2fb-45c7-ad18-1594ae98a9a2"],
 " we have  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SuperscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]], "\[CenterDot]", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], 
              StyleBox["i", "TI"]]}], ")"}], 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]], "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], 
          StyleBox["k", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "(\\mathrm{e}_{}^i\\d\\mathrm{e}_{i})\\mathrm{e}_{k}=\\mathrm{e}_{k}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2d8c74fd-0db6-4474-a4fe-c9206eda1a06"],
 " (no summation over i). In general, for orthonormal basis we have ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
