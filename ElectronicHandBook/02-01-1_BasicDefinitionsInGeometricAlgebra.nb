Cell["\<\
Symmetrization in two arguments. In short, first we make all permutations of \
set of vectors. Then  each permutation is multiplied by signature and set is \
converted to geometric product. At last add all terms and multiply by proper \
factor.\
\>", "Text",ExpressionUUID->"218cfcb1-3505-4b86-ac68-fc44bcedcb61"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"setOfVectors", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MV", "[", "a", "]"}], ",", 
     RowBox[{"MV", "[", "b", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhsRaw", "[", "testAlgebra", "]"}], "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"1", "/", 
     RowBox[{"Factorial", "[", 
      RowBox[{"Length", "[", "setOfVectors", "]"}], "]"}]}], ")"}], 
   RowBox[{"Plus", "@@", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Signature", "[", "#", "]"}], "*", 
         RowBox[{"(", 
          RowBox[{"GeometricProduct", "@@", "#"}], ")"}]}], ")"}], "&"}], "/@", 
      RowBox[{"Permutations", "[", "setOfVectors", "]"}]}], 
     ")"}]}]}]}]}], "Input",
 CellLabel->
  "In[249]:=",ExpressionUUID->"187592fc-b7db-4a7f-87aa-9dbc5eef3de4"],

