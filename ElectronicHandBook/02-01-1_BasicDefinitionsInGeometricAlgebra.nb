Cell[CellGroupData[{

Cell["Left-right GA product. Ordering of basis elements", "Section",
 CounterAssignments->{{"Section", 0}, {"Subsubsection", 0}, {"Item", 52}, {
   "Subitem", 0}, {"Subsubitem", 0}, {"ItemNumbered", 0}, {
   "SubitemNumbered", 0}, {
   "SubsubitemNumbered", 
    0}},ExpressionUUID->"39709779-4b2b-4535-93c9-8647d610c793"],

Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t",
 StyleBox["Left and right GA product",
  FontSlant->"Italic"],
 ".  The contraction is an alternative to the inner (dot) product, where  the \
inner product is replaced by two contraction operators (left and right \
contractions) that do\nnot require ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{
     RowBox[{"exceptional", " ", "rules", " ", "in", " ", "the", " ", "MV"}], 
     "-", 
     RowBox[{"scalar", " ", "product"}]}],
    BaseStyle->"Hyperlink",
    ButtonData->"inoutbyscalar"], TraditionalForm]],ExpressionUUID->
  "d36fd759-f571-40ee-8487-8b1209eb7a0a"],
 ". \[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       Cell[
        BoxData[
         FormBox[
          GridBox[{{"\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[RightFloor]", 
               StyleBox["B", "TI"], ":", "\[LongEqual]", 
               UnderscriptBox["\[Sum]", 
                RowBox[{
                  StyleBox["r", "TI"], ",", 
                  StyleBox["s", "TI"]}], LimitsPositioning -> True], 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["r", "TI"]], 
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
                RowBox[{
                  StyleBox["s", "TI"], "-", 
                  StyleBox["r", "TI"]}]]}], "Left contraction (onto)"}, {
            "\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], 
               RowBox[{"\[LeftFloor]", 
                 RowBox[{
                   StyleBox["B", "TI"], ":", "\[LongEqual]", 
                   UnderscriptBox["\[Sum]", 
                    RowBox[{
                    StyleBox["r", "TI"], ",", 
                    StyleBox["s", "TI"]}], LimitsPositioning -> True], 
                   SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    RowBox[{
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["r", "TI"]], 
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
                    RowBox[{
                    StyleBox["r", "TI"], "-", 
                    StyleBox["s", "TI"]}]]}]}]}], "Right contraction (to)"}, {
            "\[Null]", 
             RowBox[{
               StyleBox["A", "TI"], "\[Bullet]", 
               StyleBox["B", "TI"], ":", "\[LongEqual]", 
               UnderscriptBox["\[Sum]", 
                RowBox[{
                  StyleBox["r", "TI"], ",", 
                  StyleBox["s", "TI"]}], LimitsPositioning -> True], 
               SubscriptBox[
                RowBox[{"\[LeftAngleBracket]", 
                  RowBox[{
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["A", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["r", "TI"]], 
                    SubscriptBox[
                    RowBox[{"\[LeftAngleBracket]", 
                    StyleBox["B", "TI"], "\[RightAngleBracket]"}], 
                    StyleBox["s", "TI"]]}], "\[RightAngleBracket]"}], 
                TemplateBox[{
                  RowBox[{
                    RowBox[{
                    StyleBox["s", "TI"], "-", 
                    StyleBox["r", "TI"]}]}]}, "Abs"]]}], "Fat dot product"}}, 
           GridBoxAlignment -> {
            "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
           GridBoxSpacings -> {"Columns" -> {
               Offset[0.27999999999999997`], {
                Offset[0.]}, 
               Offset[0.27999999999999997`]}, "Rows" -> {
               Offset[0.2], {
                Offset[0.4]}, 
               Offset[0.2]}}], TraditionalForm]]], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\begin{split}\n&\\m{A}\\lc \
\\m{B}:=\\sum_{r,s}\\grade{\\grade{\\m{A}}{r}\\grade{\\m{B}}{s}}{s-r}&\\text{\
Left contraction (onto)}\\\\\n&\\m{A}\\rc \\m{B}:=\\sum_{r,s}\\grade{\\grade{\
\\m{A}}{r}\\grade{\\m{B}}{s}}{r-s}&\\text{Right contraction (to)}\\\\\n\
&\\m{A}\\bullet \\m{B}:=\n\
\\sum_{r,s}\\grade{\\grade{\\m{A}}{r}\\grade{\\m{B}}{s}}{\\abs{s-r}}&\\text{\
Fat\ndot product}\\\\\n\\end{split}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "925549bc-8ef8-447c-8dc8-7f8c958d3522"],
 "\[LineSeparator]\nIn the last line  the fat dot product was defined too. It \
can be used to link  the left and right contractions to the scalar product \
defined refereed above,\[LineSeparator]\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[RightFloor]", 
         StyleBox["B", "TI"], "+", 
         StyleBox["A", "TI"], 
         RowBox[{"\[LeftFloor]", 
           RowBox[{
             StyleBox["B", "TI"], "\[LongEqual]", 
             StyleBox["A", "TI"], "\[Bullet]", 
             StyleBox["B", "TI"], "+", 
             StyleBox["A", "TI"], "*", 
             StyleBox["B", "TI"]}]}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "\\m{A}\\lc \\m{B}+\\m{A}\\rc \\m{B}=\\m{A}\\bullet \
\\m{B}+\\m{A}*\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "10535084-ce24-4030-9fcb-2fff036b4b14"],
 ".\[LineSeparator]\nThe summation in above first two definitions take place \
for positive or zero grade differences only. If the difference is negative \
then the contraction is set to zero. The inner product with the fat dot is \
similar to small dot inner product, but allows zero differences, i.e., no \
exceptions in  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["s", "TI"], "-", 
         StyleBox["r", "TI"], "|", "\[GreaterEqual]", "0"}], TraditionalForm],
      "errors" -> {}, "input" -> "|s-r|\\ge0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b598618e-640d-4363-ad43-267fe9df205b"],
 " are required (compare with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    ButtonBox["",
     BaseStyle->"Hyperlink",
     ButtonData->"HestenesProduct"], "Hestenes", 
    ButtonBox[" ",
     BaseStyle->"Hyperlink",
     ButtonData->"HestenesProduct"], 
    ButtonBox["product",
     BaseStyle->"Hyperlink",
     ButtonData->"HestenesProduct"]}], TraditionalForm]],ExpressionUUID->
  "a2210636-bf72-432b-9bf3-0ce224ba98ef"],
 ").\n\nAdditional and very important property which makes the contractions \
different from the dot product is \n\[LineSeparator]\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{
           RowBox[{"(", 
             RowBox[{
               StyleBox["A", "TI"], "\[Wedge]", 
               StyleBox["B", "TI"]}], ")"}], "\[RightFloor]", 
           StyleBox["C", "TI"]}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 RowBox[{
                   StyleBox["A", "TI"], 
                   StyleBox["\[RightFloor]", "TI"], 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["B", "TI"], 
                    StyleBox["\[RightFloor]", "TI"], 
                    StyleBox["C", "TI"]}], ")"}], "    "}], 
                 RowBox[{"if", "  ", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["A", "TI"], "\[Wedge]", 
                    StyleBox["B", "TI"]}], ")"}], "\[SubsetEqual]", 
                   StyleBox["C", "TI"], ","}]}, {"0    ", 
                 RowBox[{"if", "  ", 
                   RowBox[{"(", 
                    RowBox[{
                    StyleBox["A", "TI"], "\[Wedge]", 
                    StyleBox["B", "TI"]}], ")"}], "\[Superset]", 
                   StyleBox["C", "TI"]}]}}, 
               GridBoxAlignment -> {
                "Columns" -> {Right, {Left}}, "Rows" -> {{Baseline}}}, 
               GridBoxSpacings -> {"Columns" -> {
                   Offset[0.27999999999999997`], {
                    Offset[0.]}, 
                   Offset[0.27999999999999997`]}, "Rows" -> {
                   Offset[0.2], {
                    Offset[0.4]}, 
                   Offset[0.2]}}], TraditionalForm]]]}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "{(\\m{A}\\w\\m{B}){\\lc}\\m{C}}=\\begin{cases}\\m{A}ll (\\m{B}ll\\m{C})\
\\qquad & \\textrm{if}\\quad(\\m{A}\\w\\m{B})\\subseteq\\m{C}, \\\\ 0\\qquad \
&\\textrm{if}\\quad(\\m{A}\\w\\m{B})\\supset\\m{C}\\end{cases}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a90628e3-7180-4f1c-839a-34ced890fd90"],
 "\[LineSeparator]\nIn essence the above formula  says that the contraction \
as a scalar multiplication  can be done with parts ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["A", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3bbd10aa-439c-4a0a-a9eb-fbf79e94e7d6"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["B", "TI"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1465264-b5df-4d61-a7b2-9f42562bf30b"],
 "  individually, or as a whole ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["A", "TI"], "\[Wedge]", 
         StyleBox["B", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\m{A}\\w\\m{B}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "905bc9b2-7397-4173-93ba-6caf5d9effb4"],
 " (due to linearity). Unfortunately, the Hestenes product inner product does \
not possess similar property. For example,",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[Wedge]", 
             StyleBox["b", "TI"]}], ")"}], "\[CenterDot]", 
         StyleBox["C", "TI"], "\[NotEqual]", 
         StyleBox["a", "TI"], "\[CenterDot]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["b", "TI"], "\[CenterDot]", 
             StyleBox["C", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> " (a\\w b)\\d\\m{C}\\neq a\\d (b\\d\\m{C})", "state" -> 
