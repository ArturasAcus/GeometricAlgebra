Cell[TextData[{
 "Below is a check from Lounesto \[OpenCurlyDoubleQuote]Counter examples in \
Clifford algebras\[CloseCurlyDoubleQuote], which demonstrates that in the \
geometric product of two multivectors  one cannot move Clifford conjugation \
from one factor to the other. He uses ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"3", ",", "1"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{3}{1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ba9781e0-0a4d-4f74-b9d1-b9de6430926d"],
 " algebra"
}], "Text",ExpressionUUID->"e7f741ba-6359-406a-9899-58b9a94c0ba1"],

