   PlotRange->{{0., 137.}, {0., 97.}}]], "Input",ExpressionUUID->
  "04423c1d-5d8a-4e37-94be-0fc337ef38c6"],
 ". This means that the sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "1"], "+", 
           SubscriptBox[
            StyleBox["B", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\cB_1+\\cB_2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e42365c-d0e5-4a4e-a977-09661b2a9237"],
 " can be represented as an outer product of vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "2"], "-", 
             SubscriptBox[
              StyleBox["e", FontSlant -> "Plain"], "3"]}], ")"}], 
         "\[LongEqual]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\e{1}\\w(\\e{2}-\\e{3})=\\e{1}\\w\\e{2}+\\e{3}\\w\\e{1}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8c97f18-8aa3-4ee5-93e5-64299414bb45"],
 " and, therefore, is the blade. Thus, the sum ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           SubscriptBox[
            StyleBox["B", "TI"], "1"], "+", 
           SubscriptBox[
            StyleBox["B", "TI"], "2"]}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(\\cB_1+\\cB_2)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9782a2c5-6cba-4475-80ab-11acf41b1b79"],
 ", in fact, is  a single oriented plane and represents a homogeneous MV. ",
 StyleBox["In general bivectors (as well as higher grade homogeneous MV), \
which are not blades can\[CloseCurlyQuote]t be added. For example,  ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{1}\\w\\e{2}+\\e{3}\\w\\e{4}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "bd185a65-5d1d-4308-a8da-d7b3c1db6ecc"],
 StyleBox["in ",
  Background->RGBColor[0.87, 0.94, 1]],
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["Cl", 
        RowBox[{"4", ",", "0"}]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\cl{4}{0}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],
  Background->RGBColor[0.87, 0.94, 1],ExpressionUUID->
  "d00ba1a7-dc28-4c39-b730-c45dfccdb8eb"],
 StyleBox[" can\[CloseCurlyQuote]t be expressed as single plane.",
  Background->RGBColor[0.87, 0.94, 1]]
}], "Subitem",
 CellChangeTimes->{{3.921558376768979*^9, 3.921558462398656*^9}, {
  3.921558497315082*^9, 
  3.921558592564845*^9}},ExpressionUUID->"e1e0303f-56e5-407f-940b-\
0f3f08c39e76"],

Cell[TextData[{
 StyleBox["The bivector that is not a blade.",
  FontSlant->"Italic"],
 " In 4-dimensional space the bivector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["B", "TI"], "\[LongEqual]", "\[Alpha]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"], "+", "\[Beta]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\cB=\\alpha\\e{1}\\w\\e{2}+\\beta\\e{3}\\w\\e{4}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1c9d865c-2864-4969-98be-eeecd4bed109"],
 " is a grade-2 element of selector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        RowBox[{"\[LeftAngleBracket]", 
          StyleBox["M", "TI"], "\[RightAngleBracket]"}], "2"], 
       TraditionalForm], "errors" -> {}, "input" -> "\\grade{\\m{M}}{2}", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "893cd3b1-c189-46aa-8aca-cf227fce7b0b"],
 ". The elementary bivectors have no common indices and therefore their sun \
is not a blade. Indeed, the bivectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "1"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "2"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{1}\\w\\e{2} ", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b306967b-93bc-4981-b328-7aa6be1225d5"],
 "and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "3"], "\[Wedge]", 
         SubscriptBox[
          StyleBox["e", FontSlant -> "Plain"], "4"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\e{3}\\w\\e{4}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "2c9b5c63-97c8-4b3e-bcab-aa9922f6fa76"],
 " belong to two non-intersecting subspaces and, therefore, cannot be reduced \
to a single blade, i.e. to a single outer product of two basis vectors."
}], "Subitem",ExpressionUUID->"567dd21a-4a66-498d-8754-ad764d6b9a6b"],

