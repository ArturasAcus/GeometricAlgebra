Cell[CellGroupData[{

Cell["\<\
Choose algebra and verify computations of above example. The computations are \
very similar to what we did in previous example only in a slightly different \
fashion\
\>", "Text",ExpressionUUID->"86f67a3f-6518-4875-b432-66f26f8ca954"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"testAlgebra", "=", 
   RowBox[{"Cl", "[", 
