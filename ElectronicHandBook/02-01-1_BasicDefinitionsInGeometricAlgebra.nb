Cell[CellGroupData[{

Cell[TextData[{
 
 CounterBox["Section"],
 ".",
 
 CounterBox["Item"],
 "\t ",
 StyleBox["Magnitude, parallel and orthogonal vectors",
  FontSlant->"Italic"],
 ".   The magnitude (aka norm) ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       TemplateBox[{
         RowBox[{
           StyleBox["a", "TI"]}]}, "Abs"], TraditionalForm], "errors" -> {}, 
     "input" -> "|a|", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "843ac90d-dcaf-4af3-b0ec-89445c581c34"],
 " of a vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0a2e9221-cc36-4d4f-8568-298c8318c8eb"],
 " in terms of inner product can be written as a square root of absolute \
value of the inner product ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         SuperscriptBox[
          StyleBox["a", "TI"], "2"], "|", "\[LongEqual]", 
         StyleBox["abs", FontSlant -> "Plain"], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["a", "TI"], "\[CenterDot]", 
             StyleBox["a", "TI"]}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "|a^2|=\\mathrm{abs}{(a\\cdot\na)}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6e850adc-8ebd-41f7-892a-600afee97e4a"],
 ".  Two nonzero vectors ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aee519c1-9bbd-417d-90c7-8ae6987d50cc"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1f50410f-3b77-48ac-b7cb-05f2e66306a7"],
 " are said to be orthogonal if their inner product is zero, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "a\\cdot b=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "02915fc6-3b13-40f9-8c9b-d1447fb06aa2"],
 ". A set of vectors is orthogonal if every vector in the set is mutually \
orthogonal to every other vector in the set. If vectors are parallel their \
inner product is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         StyleBox["abs", FontSlant -> "Plain"], 
         StyleBox["a", "TI"], 
         StyleBox["abs", FontSlant -> "Plain"], 
         StyleBox["b", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "a\\cdot b=\\mathrm{abs}{a}\\mathrm{abs}{b}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8b1ee051-a3b6-4f8d-b653-3a200aec7777"],
 ". If vectors have arbitrary orientations then ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["a", "TI"], "\[CenterDot]", 
         StyleBox["b", "TI"], "\[LongEqual]", 
         TemplateBox[{
           RowBox[{
             StyleBox["a", "TI"]}]}, "Abs"], 
         TemplateBox[{
           RowBox[{
             StyleBox["b", "TI"]}]}, "Abs"], "cos", "\[Theta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "a\\cdot b={|a|}{|b|}\\cos\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "488c4125-65bd-4fc9-8bde-b329b489dce7"],
 ", where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bff5e874-8339-4fae-ac15-ce02e64244d1"],
 " is the angle measured from vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["a", "TI"], TraditionalForm], "errors" -> {}, "input" -> "a", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "30c08279-bbf2-45f3-9fe3-a3e46d1bb0d8"],
 " to vector ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["b", "TI"], TraditionalForm], "errors" -> {}, "input" -> "b", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "92c81f34-6acb-40e8-8f7e-579aa738ab11"],
 ". More formulae with the inner products are presented in chapter ",
 Cell[BoxData[
  FormBox[
   ButtonBox[
    RowBox[{"Vectors", " ", "and", " ", "Bivectors"}],
    BaseStyle->"Hyperlink",
    ButtonData->{
      FrontEnd`FileName[{$RootDirectory, "home", "acus", "git", "acus", "GA", 
        "ElectronicHandBook"}, "02-02-1_VectorsAndBivectors.nb", 
       CharacterEncoding -> "UTF-8"], "VectorsAndBivectors"}], 
   TraditionalForm]],ExpressionUUID->"ceb0d165-dcd3-4a22-b0ed-8ba657c790da"],
 StyleBox[".",
  FontColor->RGBColor[1, 0, 0]]
}], "Item",ExpressionUUID->"6c1939cb-9ef2-4cd5-b7aa-1893442d49c3"],

Cell[CellGroupData[{

Cell["Computational verification", "ItemParagraph",
 FontWeight->"Bold",
 FontColor->RGBColor[
  0.6, 0.4, 0.2],ExpressionUUID->"202ee0d9-e95f-4564-a4ec-ef9f165d533c"],

Cell[TextData[{
 "Various magnitudes are computed with ",
 StyleBox["gaNorm*",
  FontWeight->"Bold"],
 " commands. For vector both  ",
 StyleBox["gaNormCliffordConjugateAbs[]",
  FontWeight->"Bold"],
 ", ",
 StyleBox["gaNormReverseAbs[]",
  FontWeight->"Bold"],
 " yields the same answers. Note, that when working with symbolic \
coefficients ",
 StyleBox["Abs[ ] ",
  FontWeight->"Bold"],
 " function is not applied (it complicates symbolic simplifications a lot and \
user can always wrap if there is a need). There also are corresponding norms \
squared in particular ",
 StyleBox["gaNorm2reverseSigned[ ]",
  FontWeight->"Bold"],
 " and ",
 StyleBox["gaNorm2CliffordConjugateSigned[ ]",
  FontWeight->"Bold"],
 ", form which square root is not attempted."
}], "Text",ExpressionUUID->"dcd18259-8ee1-4c38-8019-f089378bb51e"],

