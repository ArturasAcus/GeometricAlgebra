Cell[TextData[{
 "2022-11-26, we removed ",
 StyleBox["gaCliffordConjugate[ ]",
  FontWeight->"Bold"],
 " rule for geometric product of MV.  This rule was not valid as a counter \
example below shows."
}], "Text",
