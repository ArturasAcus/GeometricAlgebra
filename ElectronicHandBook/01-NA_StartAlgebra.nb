Cell[TextData[{
 "If we don\[CloseCurlyQuote]t want absolute value and square root, then  ",
 StyleBox["gaNorm2ReverseSigned[ ]",
  FontWeight->"Bold"],
 " can be used. Note, that in general ",
 StyleBox["gaNorm2ReverseSigned[ ]",
  FontWeight->"Bold"],
 " returns multivector, not scalar. So it is not norm in strict sense."
}], "Text",ExpressionUUID->"f950e196-02a0-4d39-aabe-fc3d44991ffc"],

