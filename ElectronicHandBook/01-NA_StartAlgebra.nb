Cell[TextData[{
 "More complete list of relevant",
 StyleBox[" geometric algebra operations (listed in order of their \
precedences) are  ",
  FontColor->GrayLevel[0]],
 StyleBox["NonCommutativeMultiply[ ] ",
  FontWeight->"Bold"],
 "(**, highest), ",
 StyleBox["Times[ ]",
  FontWeight->"Bold"],
 " (*, Space), ",
 StyleBox["RightContract[ ]",
  FontWeight->"Bold"],
 " (",
 StyleBox["\[RightContract]",
  FontWeight->"Bold"],
 "), ",
 StyleBox["LeftContract[ ] ",
  FontWeight->"Bold"],
 "(",
 StyleBox["\[LeftContract]",
  FontWeight->"Bold"],
 "), ",
 StyleBox["InnerProduct[ ]",
  FontWeight->"Bold"],
 " (",
 StyleBox["\[InnerProduct]",
  FontWeight->"Bold"],
 "), ",
 StyleBox["DorstPruduct[ ]",
  FontWeight->"Bold"],
 " (\[DorstProduct]), ",
 StyleBox["OuterProduct[ ]",
  FontWeight->"Bold"],
 " (\[OuterProduct], sometimes has bad representation in default ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " text cells, should look as \[Wedge], input cells with default ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " font are ok.), ",
 StyleBox["GeometricProduct[ ]",
  FontWeight->"Bold"],
 "(\[GeometricProduct]), ",
 StyleBox["Plus[ ]",
  FontWeight->"Bold"],
 " (lowest)."
}], "Text",
