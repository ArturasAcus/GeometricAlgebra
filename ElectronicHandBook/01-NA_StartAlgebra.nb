          RowBox[{"\[DoubleStruckF]", "[", 
           RowBox[{"1", ",", "2"}], "]"}]}], "}"}], ".", "#"}], ")"}], "&"}], 
     "/@", 
     RowBox[{"Partition", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"ToExpression", "[", 
          RowBox[{"\"\<s\>\"", "<>", 
           RowBox[{"ToString", "[", "#", "]"}]}], "]"}], "&"}], "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"4", "*", 
          RowBox[{"2", "^", 
           RowBox[{
           "gaDimensionOfVectorSpace", "[", "gaRunningAlgebra", "]"}]}]}], 
         "]"}]}], ",", "4"}], "]"}]}], ")"}], ".", 
   RowBox[{"gaOrthonormalBasis", "[", 
    RowBox[{"gaRunningAlgebra", ",", "\"\<InvDeg[Lex]\>\""}], 
