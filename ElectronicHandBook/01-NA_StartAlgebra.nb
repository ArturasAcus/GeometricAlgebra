Cell[TextData[{
 "Note, that before  input cell \[ScriptCapitalA]1N=3\[DoubleStruckE][1,2]-2\
\[DoubleStruckE][1,4] we issued the command ",
 StyleBox["gaDefineInput[Cl[1,3]]",
  FontWeight->"Bold"],
 ", which changed working algebra to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", "13"], TraditionalForm]],ExpressionUUID->
  "e7bf778e-3e28-4606-adc3-781f08cce0cd"],
 ". Otherwise the base elements \[DoubleStruckE][1,2],... we input would be \
assumed to be part of last working algebra, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", 
    RowBox[{"3", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "eba2a8f8-6a98-4af9-a64e-e3a288044991"],
 " elements. This was the algebra we defined with ",
 Cell[BoxData[
  RowBox[{"gaDefineOrthonormalBasis", "[", 
   RowBox[{"Cl", "[", 
    RowBox[{"3", ",", "1"}], "]"}], "]"}]], "Input",
  CellChangeTimes->{{3.674981501795437*^9, 3.674981506251995*^9}},
  ExpressionUUID->"7f10365a-177c-4e75-a5b7-d99ef3b96ee7"],
 " to illustrate Lounesto\[CloseCurlyQuote]s counter example."
}], "Text",
 CellChangeTimes->{{3.531215444705543*^9, 3.531215453183996*^9}, {
   3.531215728886285*^9, 3.531215752489262*^9}, {3.531215819529191*^9, 
