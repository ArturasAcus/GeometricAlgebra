Cell[CellGroupData[{

Cell["\<\
Magnitude, or norm which is obtained by multiplying by Clifford conjugated \
multivector and (in general) taking the scalar part\
\>", "Subsubsection",
 CellChangeTimes->{{3.674792212375785*^9, 3.674792256060421*^9}, {
  3.67479609663272*^9, 3.674796102452956*^9}, {3.776672444686502*^9, 
