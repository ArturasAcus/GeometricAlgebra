Cell[TextData[{
 "To  see how multiple product expression was spitted into pair wise product \
expansion use  \[OpenCurlyDoubleQuote]InactivateProductPairExpand\
\[CloseCurlyDoubleQuote]->True option.  The second argument of ",
 StyleBox["gaProductPairExpansion[#1,{CoefficientFunction,Quiet,MaxIterations}\
]",
  FontWeight->"Bold"],
 " (see options \[OpenCurlyDoubleQuote]CoefficientFunction\
\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]Quiet\[CloseCurlyDoubleQuote] and \
\[OpenCurlyDoubleQuote]MaxIterations\[CloseCurlyDoubleQuote] of  ",
 StyleBox["gaProductPairExpand[ ]",
  FontWeight->"Bold"],
 ")."
}], "Text",
