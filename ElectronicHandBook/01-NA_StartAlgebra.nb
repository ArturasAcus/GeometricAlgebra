Cell[TextData[{
 "Note that basis elements now have different color. One can get projections \
of desired grade using ",
 StyleBox["gaGetMV[ ]",
  FontWeight->"Bold"],
 " command. For example, general vector and bivector of algebra can be \
obtained, respectively, as"
}], "Text",
