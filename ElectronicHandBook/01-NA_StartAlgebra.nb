Cell[CellGroupData[{

Cell["\<\
Magnitude, or norm which is obtained by multiplying by reversed multivector \
and (in general) taking the scalar part\
\>", "Subsubsection",
 CellChangeTimes->{{3.674792212375785*^9, 3.674792256060421*^9}, {
  3.67479609663272*^9, 3.674796102452956*^9}, {3.776672444686502*^9, 
  3.776672528846683*^9}},ExpressionUUID->"da066d19-cd84-493a-93bf-\
4e383d620c8b"],

Cell[TextData[{
 " The magnitude is defined as a square root of absolute value of scalar part \
of geometric product of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    OverscriptBox["M", "~"], "M"}], TraditionalForm]],ExpressionUUID->
  "19a7d696-d531-494e-bfe3-cd9875c52852"],
 ", i.e. of multivector and reversed multivector. For example, for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Cl", "12"], TraditionalForm]],ExpressionUUID->
  "e75c594c-85a7-42e2-8a06-565e91e80460"],
 "vector we have"
}], "Text",
